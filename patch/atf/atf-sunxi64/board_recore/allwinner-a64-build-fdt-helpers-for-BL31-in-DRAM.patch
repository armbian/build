From e49141237a161a678aeffde933a01324fe1e219a Mon Sep 17 00:00:00 2001
From: Elias Bakken <elias@iagent.no>
Date: Sun, 27 Sep 2026 16:38:58 +0200
Subject: [PATCH] allwinner: a64: build the fdt helpers needed for BL31 in DRAM

With SUNXI_BL31_IN_DRAM=1, sunxi_prepare_dtb() reserves BL31's memory
in the device tree with fdt_add_reserved_memory(). That needs
fdt_wrappers.c and libfdt's fdt_addresses.c, which the H616 platform
builds but the A64 platform does not, so the A64 build fails to link.

Add them to the A64 BL31 sources.

Signed-off-by: Elias Bakken <elias@iagent.no>
---
 plat/allwinner/sun50i_a64/platform.mk | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/plat/allwinner/sun50i_a64/platform.mk b/plat/allwinner/sun50i_a64/platform.mk
index cced7f0..b192a6c 100644
--- a/plat/allwinner/sun50i_a64/platform.mk
+++ b/plat/allwinner/sun50i_a64/platform.mk
@@ -12,7 +12,9 @@ SUNXI_AMEND_DTB		:=	1
 include plat/allwinner/common/allwinner-common.mk
 
 BL31_SOURCES		+=	drivers/allwinner/axp/axp803.c		\
-				drivers/allwinner/sunxi_rsb.c
+				drivers/allwinner/sunxi_rsb.c		\
+				common/fdt_wrappers.c			\
+				lib/libfdt/fdt_addresses.c
 
 FDT_ASSUME_MASK := "(ASSUME_LATEST | ASSUME_NO_ROLLBACK | ASSUME_LIBFDT_ORDER)"
 $(eval $(call add_define,FDT_ASSUME_MASK))
-- 
