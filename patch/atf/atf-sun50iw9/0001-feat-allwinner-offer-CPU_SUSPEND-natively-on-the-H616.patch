+++ b/plat/allwinner/sun50i_h616/sunxi_idle_states.c
@@ -6,6 +6,26 @@
 
 #include <sunxi_private.h>
 
+/*
+ * Only a core power-down state is implemented: the CPUIDLE hardware block
+ * gates a core when it enters WFI with its CORE_CLOSE flag set, and powers it
+ * back up (resetting into BL31) once the GIC has an interrupt pending for it.
+ * The block also has a voting mechanism that allows the whole cluster to be
+ * powered off, but no cluster state is implemented here, so the cluster, its
+ * L2 cache and the GIC stay on.
+ *
+ * The latencies are the TF-A round trip (SMC, L1 clean, CPUIDLE power-down
+ * sequence, reset into the warm boot path, context restore). The residency
+ * is set conservatively; the vendor firmware advertises 3.57 ms.
+ */
 const struct psci_cpu_idle_state sunxi_idle_states[] = {
+	{
+		.name			= "cpu-sleep",
+		.power_state		= 0x00010003,
+		.local_timer_stop	= true,
+		.entry_latency_us	= 100,
+		.exit_latency_us	= 150,
+		.min_residency_us	= 4000
+	},
 	{}
 };
