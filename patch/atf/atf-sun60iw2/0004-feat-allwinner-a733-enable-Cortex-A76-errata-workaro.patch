From eadd435bf0239e7f7d4fb9c84ec700dc59470b69 Mon Sep 17 00:00:00 2001
From: Alastair D'Silva <alastair@d-silva.org>
Date: Thu, 17 Sep 2026 10:13:00 +1000
Subject: [PATCH 4/6] feat(allwinner): a733: enable Cortex-A76 errata
 workarounds

The Allwinner A733 features two Cortex-A76 performance cores alongside
six Cortex-A55 efficiency cores in a single DynamIQ cluster.

Enable applicable Cortex-A76 silicon errata workarounds (branch predictor,
TLB invalidation, memory barrier, and cache coherence mitigations) to
prevent CPU stalls and instruction faults under multi-core workloads.

Signed-off-by: Alastair D'Silva <alastair@d-silva.org>
---
 plat/allwinner/sun60i_a733/platform.mk | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/plat/allwinner/sun60i_a733/platform.mk b/plat/allwinner/sun60i_a733/platform.mk
index f7df5667bc..677c3c6582 100644
--- a/plat/allwinner/sun60i_a733/platform.mk
+++ b/plat/allwinner/sun60i_a733/platform.mk
@@ -22,6 +22,18 @@ include plat/allwinner/common/allwinner-common.mk
 include plat/allwinner/common/allwinner-common-a55.mk
 
 BL31_SOURCES		+=	lib/cpus/${ARCH}/cortex_a76.S
+ERRATA_A76_1073348	:=	1
+ERRATA_A76_1130799	:=	1
+ERRATA_A76_1165522	:=	1
+ERRATA_A76_1220197	:=	1
+ERRATA_A76_1257314	:=	1
+ERRATA_A76_1262606	:=	1
+ERRATA_A76_1262888	:=	1
+ERRATA_A76_1275112	:=	1
+ERRATA_A76_1286807	:=	1
+ERRATA_A76_1791580	:=	1
+ERRATA_A76_1868343	:=	1
+ERRATA_A76_1946160	:=	1
 
 # The Cortex-A76 has no 32-bit state to save
 CTX_INCLUDE_AARCH32_REGS	:=	0
