From c855bcc8dbde17a5b20bd0182dead79df0951fc1 Mon Sep 17 00:00:00 2001
From: Alastair D'Silva <alastair@d-silva.org>
Date: Thu, 17 Sep 2026 10:12:00 +1000
Subject: [PATCH 3/6] feat(allwinner): a733: enlarge per-core stack to 4KB

The Allwinner A733 features an 8-core CPU cluster (2x Cortex-A76 and
6x Cortex-A55). The default platform stack allocation divides a single
4 KB page among all cores (0x1000 / PLATFORM_CORE_COUNT = 512 bytes
per core), which is tight for multi-core exception handling and PSCI
power management routines.

Since BL31 runs in DRAM with generous memory headroom, allocate a
dedicated 4 KB stack per core.

Signed-off-by: Alastair D'Silva <alastair@d-silva.org>
---
 plat/allwinner/common/include/platform_def.h | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/plat/allwinner/common/include/platform_def.h b/plat/allwinner/common/include/platform_def.h
index 80cd6e4b06..e64b7ec6ae 100644
--- a/plat/allwinner/common/include/platform_def.h
+++ b/plat/allwinner/common/include/platform_def.h
@@ -82,7 +82,12 @@
 
 #define PLATFORM_CLUSTER_COUNT		U(1)
 #define PLATFORM_CORE_COUNT		SUNXI_CPU_COUNT
+
+#ifdef PLAT_sun60i_a733
+#define PLATFORM_STACK_SIZE		0x1000
+#else
 #define PLATFORM_STACK_SIZE		(0x1000 / PLATFORM_CORE_COUNT)
+#endif
 
 #ifndef SPD_none
 #ifndef BL32_BASE
