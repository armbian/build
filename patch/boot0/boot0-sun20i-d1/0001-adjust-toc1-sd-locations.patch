Subject: [PATCH] boot0: move TOC1 slots before the root partition

Keep both TOC1 slots below the ext4 partition at 4 MiB.

--- a/include/spare_head.h
+++ b/include/spare_head.h
@@ -62,8 +62,8 @@
 #define BOOT0_EMMC3_BACKUP_START_ADDR           (512)
 
 
-#define UBOOT_START_SECTOR_IN_SDMMC             (32800)
-#define UBOOT_BACKUP_START_SECTOR_IN_SDMMC      (24576)
+#define UBOOT_START_SECTOR_IN_SDMMC             (4096)
+#define UBOOT_BACKUP_START_SECTOR_IN_SDMMC      (512)
 
 
 #define SUNXI_NORMAL_MODE                            0
