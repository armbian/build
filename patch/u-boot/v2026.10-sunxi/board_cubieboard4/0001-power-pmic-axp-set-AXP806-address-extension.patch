From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Igor Pecovnik <igor@armbian.com>
Date: Mon, 19 Oct 2026 14:35:01 +0200
Subject: [PATCH] power: pmic: axp: set AXP806 address extension

An AXP806 in slave mode ignores all registers until the register
address extension matches. On the Cubieboard4, all reads fail with -EIO.
Program the extension in probe, as Linux does.

Signed-off-by: Igor Pecovnik <igor@armbian.com>
Assisted-by: Claude Opus 5.5
---
 drivers/power/pmic/axp.c | 25 +++++++++++++++++++++++++
 1 file changed, 25 insertions(+)

diff --git a/drivers/power/pmic/axp.c b/drivers/power/pmic/axp.c
index 7d8348b076..d7712bcac3 100644
--- a/drivers/power/pmic/axp.c
+++ b/drivers/power/pmic/axp.c
@@ -82,6 +82,30 @@ static int axp_pmic_bind(struct udevice *dev)
 	return 0;
 }
 
+#define AXP806_REG_ADDR_EXT			0xff
+#define AXP806_REG_ADDR_EXT_ADDR_MASTER_MODE	0
+#define AXP806_REG_ADDR_EXT_ADDR_SLAVE_MODE	BIT(4)
+
+static int axp_pmic_probe(struct udevice *dev)
+{
+	u8 addr_ext;
+
+	if (dev_get_driver_data(dev) != AXP806_ID)
+		return 0;
+
+	/*
+	 * In slave mode, the AXP806 ignores all other registers until the
+	 * register address extension matches. Program it as Linux does.
+	 */
+	if (dev_read_bool(dev, "x-powers,master-mode") ||
+	    dev_read_bool(dev, "x-powers,self-working-mode"))
+		addr_ext = AXP806_REG_ADDR_EXT_ADDR_MASTER_MODE;
+	else
+		addr_ext = AXP806_REG_ADDR_EXT_ADDR_SLAVE_MODE;
+
+	return pmic_reg_write(dev, AXP806_REG_ADDR_EXT, addr_ext);
+}
+
 static const struct udevice_id axp_pmic_ids[] = {
 	{ .compatible = "x-powers,axp152", .data = AXP152_ID },
 	{ .compatible = "x-powers,axp202", .data = AXP202_ID },
@@ -104,5 +128,6 @@ U_BOOT_DRIVER(axp_pmic) = {
 	.id		= UCLASS_PMIC,
 	.of_match	= axp_pmic_ids,
 	.bind		= axp_pmic_bind,
+	.probe		= axp_pmic_probe,
 	.ops		= &axp_pmic_ops,
 };
