From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Igor Pecovnik <igor@armbian.com>
Date: Mon, 19 Oct 2026 14:35:01 +0200
Subject: [PATCH] clk: sunxi: a80: add GMAC and USB clocks

Add the GMAC and USB bus gates, the GMAC reset, and the USB clock and
reset block (sun9i-a80-usb-clks).

Signed-off-by: Igor Pecovnik <igor@armbian.com>
Assisted-by: Claude Opus 5.5
---
 drivers/clk/sunxi/clk_a80.c   | 39 +++++++++++++++++++++++++++++++++++
 drivers/clk/sunxi/clk_sunxi.c |  3 +++
 2 files changed, 42 insertions(+)

diff --git a/drivers/clk/sunxi/clk_a80.c b/drivers/clk/sunxi/clk_a80.c
index 091aaeee98..e81406ae9a 100644
--- a/drivers/clk/sunxi/clk_a80.c
+++ b/drivers/clk/sunxi/clk_a80.c
@@ -10,6 +10,8 @@
 #include <clk/sunxi.h>
 #include <dt-bindings/clock/sun9i-a80-ccu.h>
 #include <dt-bindings/reset/sun9i-a80-ccu.h>
+#include <dt-bindings/clock/sun9i-a80-usb.h>
+#include <dt-bindings/reset/sun9i-a80-usb.h>
 #include <linux/bitops.h>
 
 static const struct ccu_clk_gate a80_gates[] = {
@@ -23,6 +25,8 @@ static const struct ccu_clk_gate a80_gates[] = {
 	[CLK_SPI3]		= GATE(0x43c, BIT(31)),
 
 	[CLK_BUS_MMC]		= GATE(0x580, BIT(8)),
+	[CLK_BUS_USB]		= GATE(0x584, BIT(1)),
+	[CLK_BUS_GMAC]		= GATE(0x584, BIT(17)),
 	[CLK_BUS_NAND0]		= GATE(0x580, BIT(13)),
 	[CLK_BUS_NAND1]		= GATE(0x580, BIT(12)),
 	[CLK_BUS_SPI0]		= GATE(0x580, BIT(20)),
@@ -47,6 +51,7 @@ static const struct ccu_clk_gate a80_gates[] = {
 
 static const struct ccu_reset a80_resets[] = {
 	[RST_BUS_MMC]		= RESET(0x5a0, BIT(8)),
+	[RST_BUS_GMAC]		= RESET(0x5a4, BIT(17)),
 	[RST_BUS_NAND0]		= RESET(0x5a0, BIT(13)),
 	[RST_BUS_NAND1]		= RESET(0x5a0, BIT(12)),
 	[RST_BUS_SPI0]		= RESET(0x5a0, BIT(20)),
@@ -94,3 +99,37 @@ const struct ccu_desc a80_mmc_clk_desc = {
 	.num_gates = ARRAY_SIZE(a80_mmc_gates),
 	.num_resets = ARRAY_SIZE(a80_mmc_resets),
 };
+
+static const struct ccu_clk_gate a80_usb_gates[] = {
+	[CLK_BUS_HCI0]		= GATE(0x0, BIT(1)),
+	[CLK_USB_OHCI0]		= GATE(0x0, BIT(2)),
+	[CLK_BUS_HCI1]		= GATE(0x0, BIT(3)),
+	[CLK_BUS_HCI2]		= GATE(0x0, BIT(5)),
+	[CLK_USB_OHCI2]		= GATE(0x0, BIT(6)),
+
+	[CLK_USB0_PHY]		= GATE(0x4, BIT(1)),
+	[CLK_USB1_HSIC]		= GATE(0x4, BIT(2)),
+	[CLK_USB1_PHY]		= GATE(0x4, BIT(3)),
+	[CLK_USB2_HSIC]		= GATE(0x4, BIT(4)),
+	[CLK_USB2_PHY]		= GATE(0x4, BIT(5)),
+	[CLK_USB_HSIC]		= GATE(0x4, BIT(10)),
+};
+
+static const struct ccu_reset a80_usb_resets[] = {
+	[RST_USB0_HCI]		= RESET(0x0, BIT(17)),
+	[RST_USB1_HCI]		= RESET(0x0, BIT(18)),
+	[RST_USB2_HCI]		= RESET(0x0, BIT(19)),
+
+	[RST_USB0_PHY]		= RESET(0x4, BIT(17)),
+	[RST_USB1_HSIC]		= RESET(0x4, BIT(18)),
+	[RST_USB1_PHY]		= RESET(0x4, BIT(19)),
+	[RST_USB2_HSIC]		= RESET(0x4, BIT(20)),
+	[RST_USB2_PHY]		= RESET(0x4, BIT(21)),
+};
+
+const struct ccu_desc a80_usb_clk_desc = {
+	.gates = a80_usb_gates,
+	.resets = a80_usb_resets,
+	.num_gates = ARRAY_SIZE(a80_usb_gates),
+	.num_resets = ARRAY_SIZE(a80_usb_resets),
+};
diff --git a/drivers/clk/sunxi/clk_sunxi.c b/drivers/clk/sunxi/clk_sunxi.c
index 046d5d1605..2324472724 100644
--- a/drivers/clk/sunxi/clk_sunxi.c
+++ b/drivers/clk/sunxi/clk_sunxi.c
@@ -116,6 +116,7 @@ extern const struct ccu_desc a31_r_ccu_desc;
 extern const struct ccu_desc a64_ccu_desc;
 extern const struct ccu_desc a80_ccu_desc;
 extern const struct ccu_desc a80_mmc_clk_desc;
+extern const struct ccu_desc a80_usb_clk_desc;
 extern const struct ccu_desc a83t_ccu_desc;
 extern const struct ccu_desc d1_ccu_desc;
 extern const struct ccu_desc f1c100s_ccu_desc;
@@ -185,6 +186,8 @@ static const struct udevice_id sunxi_clk_ids[] = {
 	  .data = (ulong)&a80_ccu_desc },
 	{ .compatible = "allwinner,sun9i-a80-mmc-config-clk",
 	  .data = (ulong)&a80_mmc_clk_desc },
+	{ .compatible = "allwinner,sun9i-a80-usb-clks",
+	  .data = (ulong)&a80_usb_clk_desc },
 #endif
 #ifdef CONFIG_CLK_SUN50I_A64
 	{ .compatible = "allwinner,sun50i-a64-ccu",
-- 
2.53.0

