From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Igor Pecovnik <igor@armbian.com>
Date: Mon, 19 Oct 2026 14:35:01 +0200
Subject: [PATCH] sunxi: Cubieboard4: enable Ethernet, USB and Bluetooth
 address

Enable the GMAC, the AXP regulators and USB host. The onboard hub sits on
USB1. PH14 switches VBUS of the back ports, PH15 of the front ports.

The AP6330 Bluetooth part ships with a default address, so Linux leaves
it unconfigured. Set a unique address from the SID.

Signed-off-by: Igor Pecovnik <igor@armbian.com>
Assisted-by: Claude Opus 5.5
---
 .../arm/dts/sun9i-a80-cubieboard4-u-boot.dtsi | 53 +++++++++++++++++++
 configs/Cubieboard4_defconfig                 | 22 ++++++++
 2 files changed, 75 insertions(+)
 create mode 100644 arch/arm/dts/sun9i-a80-cubieboard4-u-boot.dtsi

diff --git a/arch/arm/dts/sun9i-a80-cubieboard4-u-boot.dtsi b/arch/arm/dts/sun9i-a80-cubieboard4-u-boot.dtsi
new file mode 100644
index 0000000000..1c89aca7a1
--- /dev/null
+++ b/arch/arm/dts/sun9i-a80-cubieboard4-u-boot.dtsi
@@ -0,0 +1,53 @@
+// SPDX-License-Identifier: GPL-2.0+ OR MIT
+
+#include "sunxi-u-boot.dtsi"
+
+/*
+ * USB1 and USB3 host. The onboard hub sits on USB1. PH14 switches VBUS of
+ * the back ports, PH15 of the front ports. USB3 has no VBUS switch.
+ */
+/ {
+	reg_usb1_vbus: usb1-vbus {
+		compatible = "regulator-fixed";
+		regulator-name = "usb1-vbus";
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+		enable-active-high;
+		gpio = <&pio 7 14 GPIO_ACTIVE_HIGH>; /* PH14 */
+	};
+
+	reg_usb1_vbus_front: usb1-vbus-front {
+		compatible = "regulator-fixed";
+		regulator-name = "usb1-vbus-front";
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+		regulator-always-on;
+		enable-active-high;
+		gpio = <&pio 7 15 GPIO_ACTIVE_HIGH>; /* PH15 */
+	};
+};
+
+&ehci0 {
+	status = "okay";
+};
+
+&ehci2 {
+	status = "okay";
+};
+
+&ohci0 {
+	status = "okay";
+};
+
+&ohci2 {
+	status = "okay";
+};
+
+&usbphy1 {
+	phy-supply = <&reg_usb1_vbus>;
+	status = "okay";
+};
+
+&usbphy3 {
+	status = "okay";
+};
diff --git a/configs/Cubieboard4_defconfig b/configs/Cubieboard4_defconfig
index 4807fa2eff..4b528e9814 100644
--- a/configs/Cubieboard4_defconfig
+++ b/configs/Cubieboard4_defconfig
@@ -10,3 +10,25 @@ CONFIG_SYS_I2C_SUN8I_RSB=y
 CONFIG_REGULATOR_AXP_DRIVEVBUS=y
 CONFIG_REGULATOR_AXP_USB_POWER=y
 CONFIG_AXP809_POWER=y
+CONFIG_ETH_DESIGNWARE=y
+CONFIG_SUN7I_GMAC=y
+CONFIG_RGMII=y
+CONFIG_PHY_REALTEK=y
+CONFIG_DM_REGULATOR=y
+CONFIG_REGULATOR_AXP=y
+CONFIG_CMD_REGULATOR=y
+CONFIG_CMD_PMIC=y
+CONFIG_CMD_CLK=y
+CONFIG_GMAC_TX_DELAY=5
+CONFIG_USB=y
+CONFIG_USB_EHCI_HCD=y
+CONFIG_USB_EHCI_GENERIC=y
+CONFIG_USB_OHCI_HCD=y
+CONFIG_USB_OHCI_GENERIC=y
+CONFIG_USB_STORAGE=y
+CONFIG_USB_KEYBOARD=y
+CONFIG_USB_HOST_ETHER=y
+CONFIG_USB_ETHER_ASIX=y
+CONFIG_USB_ETHER_RTL8152=y
+CONFIG_CMD_USB=y
+CONFIG_BLUETOOTH_DT_DEVICE_FIXUP="brcm,bcm4330-bt"
-- 
