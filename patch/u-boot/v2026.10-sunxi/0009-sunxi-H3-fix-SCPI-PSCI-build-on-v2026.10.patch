From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Igor Pecovnik <igor@armbian.com>
Date: Tue, 20 Oct 2026 12:24:42 +0200
Subject: [PATCH] sunxi: H3: fix SCPI PSCI build on v2026.10

Build the resume shim with an explicit rule, in ARM state.
Use register offsets instead of the removed cpucfg.h struct.
Drop the local read_mpidr(). asm/system.h provides it.

Assisted-by: Claude Opus 5.5
Signed-off-by: Igor Pecovnik <igor@armbian.com>
---
 Makefile                             |  9 ++++++---
 arch/arm/cpu/armv7/sunxi/psci-scpi.c | 27 +++++++++------------------
 2 files changed, 15 insertions(+), 21 deletions(-)

diff --git a/Makefile b/Makefile
index 66d676785c..c49a61bf01 100644
--- a/Makefile
+++ b/Makefile
@@ -1306,16 +1306,19 @@ INPUTS-y += u-boot-resume.img
 
 MKIMAGEFLAGS_u-boot-resume.img := -B 0x400 -T sunxi_egon
 
-u-boot-resume.img: u-boot-resume.bin
+u-boot-resume.img: u-boot-resume.bin FORCE
 	$(call if_changed,mkimage)
 
 OBJCOPYFLAGS_u-boot-resume.bin := -O binary
 
-u-boot-resume.bin: u-boot-resume.o
+u-boot-resume.bin: u-boot-resume.o FORCE
 	$(call if_changed,objcopy)
 
+u-boot-resume.o: u-boot-resume.S
+	$(Q)$(CC) $(KBUILD_AFLAGS) -marm -c -o $@ $<
+
 u-boot-resume.S: u-boot
-	@sed -En 's/(0x[[:xdigit:]]+) +psci_cpu_entry/ldr pc, =\1/p' $<.map > $@
+	@{ echo .arm; sed -En 's/(0x[[:xdigit:]]+) +psci_cpu_entry/ldr pc, =\1/p' $<.map; } > $@
 endif
 
 INPUTS-$(CONFIG_X86) += u-boot-x86-start16.bin u-boot-x86-reset16.bin \
diff --git a/arch/arm/cpu/armv7/sunxi/psci-scpi.c b/arch/arm/cpu/armv7/sunxi/psci-scpi.c
index fea51eb456..639a18a32b 100644
--- a/arch/arm/cpu/armv7/sunxi/psci-scpi.c
+++ b/arch/arm/cpu/armv7/sunxi/psci-scpi.c
@@ -4,9 +4,8 @@
  * Copyright (C) 2018-2021 Samuel Holland <samuel@sholland.org>
  */
 
-#include <common.h>
+#include <config.h>
 #include <asm/arch/cpu.h>
-#include <asm/arch/cpucfg.h>
 #include <asm/armv7.h>
 #include <asm/gic.h>
 #include <asm/io.h>
@@ -25,6 +24,10 @@
 #define MPIDR_AFFLVL1(mpidr)	(mpidr >> 8 & 0xf)
 
 #define SCPI_SHMEM_BASE		0x0004be00
+#define SUNXI_SUPER_STANDBY_FLAG	0x1a0
+#define SUNXI_PRIV0			0x1a4
+#define SUNXI_PRIV1			0x1a8
+
 #define SCPI_SHMEM		((struct scpi_shmem *)SCPI_SHMEM_BASE)
 
 #define SCPI_RX_CHANNEL		1
@@ -108,15 +111,6 @@ static bool __secure_data gic_dist_init;
 
 static u32 __secure_data lock;
 
-static inline u32 __secure read_mpidr(void)
-{
-	u32 val;
-
-	asm volatile ("mrc p15, 0, %0, c0, c0, 5" : "=r" (val));
-
-	return val;
-}
-
 static void __secure scpi_begin_command(void)
 {
 	u32 mpidr = read_mpidr();
@@ -393,16 +387,13 @@ static void __secure sunxi_set_entry_address(void *entry)
 #else
 static void __secure sunxi_set_entry_address(void *entry)
 {
-	struct sunxi_cpucfg_reg *cpucfg =
-		(struct sunxi_cpucfg_reg *)SUNXI_CPUCFG_BASE;
-
-	writel((u32)entry, &cpucfg->priv0);
+	writel((u32)entry, SUNXI_CPUCFG_BASE + SUNXI_PRIV0);
 
 #ifdef CONFIG_MACH_SUN8I_H3
 	/* Redirect CPU 0 to the secure monitor via the resume shim. */
-	writel(0x16aaefe8, &cpucfg->super_standy_flag);
-	writel(0xaa16efe8, &cpucfg->super_standy_flag);
-	writel(CONFIG_SUNXI_RESUME_BASE, &cpucfg->priv1);
+	writel(0x16aaefe8, SUNXI_CPUCFG_BASE + SUNXI_SUPER_STANDBY_FLAG);
+	writel(0xaa16efe8, SUNXI_CPUCFG_BASE + SUNXI_SUPER_STANDBY_FLAG);
+	writel(CONFIG_SUNXI_RESUME_BASE, SUNXI_CPUCFG_BASE + SUNXI_PRIV1);
 #endif
 }
 #endif
