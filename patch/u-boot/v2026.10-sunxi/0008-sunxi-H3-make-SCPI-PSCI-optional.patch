From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Igor Pecovnik <igor@armbian.com>
Date: Tue, 20 Oct 2026 12:21:01 +0200
Subject: [PATCH] sunxi: H3: make SCPI PSCI optional

Add SUNXI_SCPI_PSCI. Only boards that build SCP firmware use the SCPI
PSCI path, SPL FIT loading and the resume shim. Other H3 boards keep
the native PSCI code.

Assisted-by: Claude Opus 5.5
Signed-off-by: Igor Pecovnik <igor@armbian.com>
---
 Makefile                          |  4 ++--
 arch/arm/cpu/armv7/Kconfig        |  2 +-
 arch/arm/cpu/armv7/sunxi/Makefile |  2 +-
 arch/arm/cpu/armv7/sunxi/psci.c   |  4 ++--
 arch/arm/mach-sunxi/Kconfig       | 14 ++++++++++++--
 5 files changed, 18 insertions(+), 8 deletions(-)

diff --git a/Makefile b/Makefile
index af453fcf2d..66d676785c 100644
--- a/Makefile
+++ b/Makefile
@@ -1301,8 +1301,8 @@ ifeq ($(CONFIG_ARCH_ROCKCHIP)_$(CONFIG_SPL_FRAMEWORK),y_)
 INPUTS-y += u-boot.img
 endif
 
-ifeq ($(CONFIG_MACH_SUN8I_H3)$(CONFIG_ARMV7_PSCI),yy)
-INPUTS-$(CONFIG_ARMV7_PSCI) += u-boot-resume.img
+ifeq ($(CONFIG_SUNXI_SCPI_PSCI),y)
+INPUTS-y += u-boot-resume.img
 
 MKIMAGEFLAGS_u-boot-resume.img := -B 0x400 -T sunxi_egon
 
diff --git a/arch/arm/cpu/armv7/Kconfig b/arch/arm/cpu/armv7/Kconfig
index efaf53e536..e39f44836c 100644
--- a/arch/arm/cpu/armv7/Kconfig
+++ b/arch/arm/cpu/armv7/Kconfig
@@ -87,7 +87,7 @@ config ARMV7_PSCI
 choice
 	prompt "Supported PSCI version"
 	depends on ARMV7_PSCI
-	default ARMV7_PSCI_1_1 if MACH_SUN8I_H3
+	default ARMV7_PSCI_1_1 if SUNXI_SCPI_PSCI
 	default ARMV7_PSCI_0_1 if ARCH_SUNXI
 	default ARMV7_PSCI_1_0
 	help
diff --git a/arch/arm/cpu/armv7/sunxi/Makefile b/arch/arm/cpu/armv7/sunxi/Makefile
index 4b8368b773..e759a53129 100644
--- a/arch/arm/cpu/armv7/sunxi/Makefile
+++ b/arch/arm/cpu/armv7/sunxi/Makefile
@@ -13,7 +13,7 @@ obj-$(CONFIG_MACH_SUN6I)	+= sram.o
 obj-$(CONFIG_MACH_SUN8I)	+= sram.o
 
 ifndef CONFIG_XPL_BUILD
-ifdef CONFIG_MACH_SUN8I_H3
+ifdef CONFIG_SUNXI_SCPI_PSCI
 obj-$(CONFIG_ARMV7_PSCI)	+= psci-scpi.o
 else
 obj-$(CONFIG_ARMV7_PSCI)	+= psci.o
diff --git a/arch/arm/cpu/armv7/sunxi/psci.c b/arch/arm/cpu/armv7/sunxi/psci.c
index 367c45a259..fa8d16aa7e 100644
--- a/arch/arm/cpu/armv7/sunxi/psci.c
+++ b/arch/arm/cpu/armv7/sunxi/psci.c
@@ -335,7 +335,7 @@ int __secure psci_cpu_on(u32 __always_unused unused, u32 mpidr, u32 pc,
 	/* Lock CPU (Disable external debug access) */
 	sunxi_cpu_set_locking(cpu, true);
 
-	if (IS_ENABLED(CONFIG_MACH_SUN8I_H3) && cpu == 0) {
+	if (CONFIG_SUNXI_RESUME_BASE && cpu == 0) {
 		/* Save registers that will be clobbered by the BROM. */
 		cpu_clk = readl(&ccu->cpu_axi_cfg);
 		bus_clk = readl(&ccu->ahb1_apb1_div);
@@ -350,7 +350,7 @@ int __secure psci_cpu_on(u32 __always_unused unused, u32 mpidr, u32 pc,
 	/* De-assert reset on target CPU */
 	sunxi_cpu_set_reset(cpu, false);
 
-	if (IS_ENABLED(CONFIG_MACH_SUN8I_H3) && cpu == 0) {
+	if (CONFIG_SUNXI_RESUME_BASE && cpu == 0) {
 		/* Spin until the BROM has clobbered the clock registers. */
 		while (readl(&ccu->ahb1_apb1_div) != 0x00001100);
 
diff --git a/arch/arm/mach-sunxi/Kconfig b/arch/arm/mach-sunxi/Kconfig
index 6d23dabb04..877d523714 100644
--- a/arch/arm/mach-sunxi/Kconfig
+++ b/arch/arm/mach-sunxi/Kconfig
@@ -276,14 +276,24 @@ config SUNXI_BL31_BASE
 
 config SUNXI_RESUME_BASE
 	hex
-	default 0x00047c00 if MACH_SUN8I_H3
+	default 0x00047c00 if SUNXI_SCPI_PSCI
 	default 0x0
 	help
 	  Address where the resume shim is loaded, or zero if it is not used.
 
+config SUNXI_SCPI_PSCI
+	bool "Delegate PSCI to SCP firmware"
+	depends on MACH_SUN8I_H3 && ARMV7_PSCI
+	select SPL_LOAD_FIT if SPL
+	select REMOTEPROC_SUN6I_AR100
+	help
+	  Load SCP firmware (Crust) to the AR100 and forward PSCI calls to it
+	  over SCPI. This adds system suspend. CPU power control then needs
+	  the SCP firmware, so enable this only when scp.bin is built.
+
 config SUNXI_SCP_BASE
 	hex
-	default 0x00048000 if MACH_SUN8I_H3
+	default 0x00048000 if SUNXI_SCPI_PSCI
 	default 0x00050000 if MACH_SUN50I || MACH_SUN50I_H5
 	default 0x00114000 if MACH_SUN50I_H6
 	default 0x0
