From 4ace938ea459d889b6c1cbf029b4c48f3791a77d Mon Sep 17 00:00:00 2001
From: Igor Pecovnik <igor@armbian.com>
Date: Fri, 16 Oct 2026 21:02:14 +0200
Subject: [PATCH] arm: rtd129x: clean the data cache before turning it off

With the BPI-W2 DRAM setup in the eMMC boot area, the loader starts
U-Boot with the MMU and the data cache on. dcache_disable() turns the
cache off first, so the CPU fetches code that is not in DRAM yet and
U-Boot hangs in arch_cpu_init().

Clean the data cache before dcache_disable().

Signed-off-by: Igor Pecovnik <igor@armbian.com>
---
 arch/arm/mach-rtd129x/soc.c | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/arch/arm/mach-rtd129x/soc.c b/arch/arm/mach-rtd129x/soc.c
index b0497dfce8..6c0f59960c 100644
--- a/arch/arm/mach-rtd129x/soc.c
+++ b/arch/arm/mach-rtd129x/soc.c
@@ -61,8 +61,14 @@ struct mm_region *mem_map = rtd129x_mem_map;
  */
 int arch_cpu_init(void)
 {
-	if (get_sctlr() & CR_M)
+	/*
+	 * This image may still be in the data cache. dcache_disable() turns
+	 * the cache off before it cleans it, so clean it first.
+	 */
+	if (get_sctlr() & CR_M) {
+		flush_dcache_all();
 		dcache_disable();
+	}
 
 	return 0;
 }
-- 
