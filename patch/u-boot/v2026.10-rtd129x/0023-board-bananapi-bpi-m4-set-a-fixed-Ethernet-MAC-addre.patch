From 35e755765c50382d6de7120cbd1d4f3b8ca90aba Mon Sep 17 00:00:00 2001
From: Igor Pecovnik <igor@armbian.com>
Date: Thu, 22 Oct 2026 12:04:25 +0200
Subject: [PATCH] board: bananapi: bpi-m4: set a fixed Ethernet MAC address

The board has no factory MAC address, so Linux uses a random one on
every boot. Derive a fixed address from the eMMC CID.

Assisted-by: Claude Opus 5.5
Signed-off-by: Igor Pecovnik <igor@armbian.com>
---
 board/bananapi/bpi-m4/bpi-m4.c | 29 +++++++++++++++++++++++++++++
 configs/bananapi-m4_defconfig  |  1 +
 2 files changed, 30 insertions(+)

diff --git a/board/bananapi/bpi-m4/bpi-m4.c b/board/bananapi/bpi-m4/bpi-m4.c
index 5d594ebc04..241f125efd 100644
--- a/board/bananapi/bpi-m4/bpi-m4.c
+++ b/board/bananapi/bpi-m4/bpi-m4.c
@@ -3,9 +3,12 @@
  * Banana Pi BPI-M4 (Realtek RTD1395)
  */
 
+#include <fdt_support.h>
 #include <init.h>
+#include <mmc.h>
 #include <asm/io.h>
 #include <linux/bitops.h>
+#include <u-boot/crc.h>
 
 #define ISO_PINMUX_GPIO12	0x9804e004
 #define  GPIO12_13_FUNC		GENMASK(3, 0)
@@ -41,3 +44,29 @@ int board_init(void)
 
 	return 0;
 }
+
+/*
+ * The board has no factory MAC address. Derive a fixed, locally administered
+ * one from the CID of the on-board eMMC, so the address survives reboots.
+ */
+int ft_board_setup(void *blob, struct bd_info *bd)
+{
+	struct mmc *mmc = find_mmc_device(1);
+	const char *path = fdt_get_alias(blob, "ethernet0");
+	u8 mac[6];
+	u32 h;
+
+	if (!path || !mmc || mmc_init(mmc))
+		return 0;
+
+	h = crc32(0, (const u8 *)mmc->cid, sizeof(mmc->cid));
+	mac[0] = 0x02;
+	mac[1] = h >> 24;
+	mac[2] = h >> 16;
+	mac[3] = h >> 8;
+	mac[4] = h;
+	mac[5] = crc32(h, (const u8 *)mmc->cid, sizeof(mmc->cid));
+
+	return fdt_find_and_setprop(blob, path, "local-mac-address", mac,
+				    sizeof(mac), 1);
+}
diff --git a/configs/bananapi-m4_defconfig b/configs/bananapi-m4_defconfig
index 2cd60c5dbb..30c3ec9b33 100644
--- a/configs/bananapi-m4_defconfig
+++ b/configs/bananapi-m4_defconfig
@@ -20,3 +20,4 @@ CONFIG_MMC_RTD129X=y
 CONFIG_DEBUG_UART_SHIFT=2
 CONFIG_DEBUG_UART_SKIP_INIT=y
 CONFIG_SYS_NS16550=y
+CONFIG_OF_BOARD_SETUP=y
-- 
