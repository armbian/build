From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Igor Pecovnik <igor@armbian.com>
Date: Mon, 12 Oct 2026 19:49:13 +0200
Subject: [PATCH 03/13] rtd129x: bring up the secondary CPUs for Linux

The boot ROM starts the secondary cores at EL3 and jumps to the address
in 0x9801aa44. Power them up as the BSP does and send them to a stub
that sets up their GIC registers, drops to EL2 and waits on a RAM
spin-table release address. The device tree passed to Linux gets
enable-method "spin-table" with that address, and the spin loop is
reserved.

Tested on the BPI-W2: Linux brings up all 4 CPUs.

Signed-off-by: Igor Pecovnik <igor@armbian.com>
---
 arch/arm/Kconfig               |  2 +
 arch/arm/mach-rtd129x/Makefile |  1 +
 arch/arm/mach-rtd129x/smp.S    | 41 +++++++++++++++++
 arch/arm/mach-rtd129x/soc.c    | 80 ++++++++++++++++++++++++++++++++++
 include/configs/rtd129x.h      |  4 ++
 5 files changed, 128 insertions(+)
 create mode 100644 arch/arm/mach-rtd129x/smp.S

diff --git a/arch/arm/Kconfig b/arch/arm/Kconfig
index 62ac7e282d..f557f9dd0c 100644
--- a/arch/arm/Kconfig
+++ b/arch/arm/Kconfig
@@ -1099,6 +1099,8 @@ config ARCH_OWL
 config ARCH_RTD129X
 	bool "Realtek RTD1295/RTD1296 SoCs"
 	select ARM64
+	select GICV2
+	select OF_SYSTEM_SETUP
 	select DM
 	select DM_SERIAL
 	select OF_CONTROL
diff --git a/arch/arm/mach-rtd129x/Makefile b/arch/arm/mach-rtd129x/Makefile
index aa1026bf7d..1f80edfe0c 100644
--- a/arch/arm/mach-rtd129x/Makefile
+++ b/arch/arm/mach-rtd129x/Makefile
@@ -1,3 +1,4 @@
 # SPDX-License-Identifier: GPL-2.0+
 
 obj-y += soc.o
+obj-y += smp.o
diff --git a/arch/arm/mach-rtd129x/smp.S b/arch/arm/mach-rtd129x/smp.S
new file mode 100644
index 0000000000..4053a0b0c6
--- /dev/null
+++ b/arch/arm/mach-rtd129x/smp.S
@@ -0,0 +1,41 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+/*
+ * Secondary CPUs on the Realtek RTD129x.
+ *
+ * The boot ROM parks the secondary cores at EL3 until 0x9801aa44 holds an
+ * address. Linux cannot run at EL3, so U-Boot releases them here first:
+ * each core sets up its banked GIC registers for the non-secure side,
+ * drops to EL2 and waits on rtd129x_release_addr, the cpu-release-addr
+ * of the standard spin-table method.
+ */
+
+#include <config.h>
+#include <linux/linkage.h>
+
+ENTRY(rtd129x_secondary_entry)
+	ldr	x0, =GICD_BASE
+	ldr	x1, =GICC_BASE
+	bl	gic_init_secure_percpu
+	adr	x4, rtd129x_secondary_el2
+	mov	x5, #1				/* ES_TO_AARCH64 */
+	bl	armv8_switch_to_el2
+ENDPROC(rtd129x_secondary_entry)
+
+	/* Only this part runs once Linux owns the memory; it is reserved. */
+	.align	12
+.globl rtd129x_spin_begin
+rtd129x_spin_begin:
+rtd129x_secondary_el2:
+	wfe
+	ldr	x0, rtd129x_release_addr
+	cbz	x0, rtd129x_secondary_el2
+	br	x0
+
+	.align	3
+.globl rtd129x_release_addr
+rtd129x_release_addr:
+	.quad	0
+
+	.align	12
+.globl rtd129x_spin_end
+rtd129x_spin_end:
diff --git a/arch/arm/mach-rtd129x/soc.c b/arch/arm/mach-rtd129x/soc.c
index 104c5f70f6..14529f0ba8 100644
--- a/arch/arm/mach-rtd129x/soc.c
+++ b/arch/arm/mach-rtd129x/soc.c
@@ -7,6 +7,7 @@
  */
 
 #include <cpu_func.h>
+#include <fdt_support.h>
 #include <fdtdec.h>
 #include <init.h>
 #include <asm/armv8/mmu.h>
@@ -33,6 +34,14 @@ static struct mm_region rtd129x_mem_map[] = {
 		.attrs = PTE_BLOCK_MEMTYPE(MT_DEVICE_NGNRNE) |
 			 PTE_BLOCK_NON_SHARE |
 			 PTE_BLOCK_PXN | PTE_BLOCK_UXN
+	}, {
+		/* GIC-400 */
+		.virt = 0xff010000UL,
+		.phys = 0xff010000UL,
+		.size = 0x00010000UL,
+		.attrs = PTE_BLOCK_MEMTYPE(MT_DEVICE_NGNRNE) |
+			 PTE_BLOCK_NON_SHARE |
+			 PTE_BLOCK_PXN | PTE_BLOCK_UXN
 	}, {
 		/* List terminator */
 		0,
@@ -88,3 +97,74 @@ void reset_cpu(void)
 	while (1)
 		;
 }
+
+/*
+ * Secondary CPUs. The boot ROM parks them at EL3 until CPU_RELEASE_ADDR holds
+ * an address; smp.S takes them to EL2 and parks them on a spin-table release
+ * address in RAM, which is what Linux is told to use.
+ */
+#define CPU_RELEASE_ADDR	0x9801aa44
+
+extern char rtd129x_secondary_entry[];
+extern char rtd129x_spin_begin[], rtd129x_spin_end[];
+extern u64 rtd129x_release_addr;
+
+static void rtd129x_release_secondaries(void)
+{
+	static bool released;
+
+	if (released)
+		return;
+
+	rtd129x_release_addr = 0;
+	/* the cores run with caches off */
+	flush_dcache_range((ulong)rtd129x_secondary_entry,
+			   (ulong)rtd129x_spin_end);
+
+	/*
+	 * Power the secondary cores up, as the BSP's bootup_slave_cpu() does.
+	 * They start in the boot ROM, which jumps to CPU_RELEASE_ADDR once it
+	 * holds an address. The BSP clears it again so they wait for the
+	 * kernel; here they go straight to rtd129x_secondary_entry.
+	 */
+	writel((ulong)rtd129x_secondary_entry, CPU_RELEASE_ADDR);
+	asm volatile("dsb sy" : : : "memory");
+	writel(0x00010000, 0x9801d104);
+	writel(0x03ffff00, 0x9801d530);
+	writel(0x011f3bff, 0x9801d100);
+	writel(0x0f1f3bff, 0x9801d100);
+	asm volatile("dsb sy\n\tsev" : : : "memory");
+	released = true;
+}
+
+int ft_system_setup(void *blob, struct bd_info *bd)
+{
+	int cpus, node, ret;
+
+	cpus = fdt_path_offset(blob, "/cpus");
+	if (cpus < 0)
+		return 0;
+
+	fdt_for_each_subnode(node, blob, cpus) {
+		const char *type = fdt_getprop(blob, node, "device_type", NULL);
+
+		if (!type || strcmp(type, "cpu"))
+			continue;
+		ret = fdt_setprop_string(blob, node, "enable-method",
+					 "spin-table");
+		if (!ret)
+			ret = fdt_setprop_u64(blob, node, "cpu-release-addr",
+					      (ulong)&rtd129x_release_addr);
+		if (ret)
+			return ret;
+	}
+
+	ret = fdt_add_mem_rsv(blob, (ulong)rtd129x_spin_begin,
+			      rtd129x_spin_end - rtd129x_spin_begin);
+	if (ret)
+		return ret;
+
+	rtd129x_release_secondaries();
+
+	return 0;
+}
diff --git a/include/configs/rtd129x.h b/include/configs/rtd129x.h
index b3896e211a..b2e67e30c9 100644
--- a/include/configs/rtd129x.h
+++ b/include/configs/rtd129x.h
@@ -9,4 +9,8 @@
 #define CFG_SYS_INIT_RAM_ADDR	0x0e000000
 #define CFG_SYS_INIT_RAM_SIZE	0x00100000
 
+/* GIC-400 */
+#define GICD_BASE		0xff011000
+#define GICC_BASE		0xff012000
+
 #endif
