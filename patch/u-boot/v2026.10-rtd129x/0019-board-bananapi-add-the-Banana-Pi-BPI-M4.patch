diff --git a/arch/arm/dts/rtd1395-bananapi-m4.dts b/arch/arm/dts/rtd1395-bananapi-m4.dts
new file mode 100644
index 0000000000..49b46d2b11
--- /dev/null
+++ b/arch/arm/dts/rtd1395-bananapi-m4.dts
@@ -0,0 +1,92 @@
+// SPDX-License-Identifier: (GPL-2.0-or-later OR BSD-2-Clause)
+/*
+ * Banana Pi BPI-M4 (Realtek RTD1395), minimal U-Boot device tree.
+ */
+
+/dts-v1/;
+
+/ {
+	compatible = "bananapi,bpi-m4", "realtek,rtd1395";
+	model = "Banana Pi BPI-M4";
+	#address-cells = <1>;
+	#size-cells = <1>;
+
+	aliases {
+		serial0 = &uart0;
+		mmc0 = &sdmmc;
+		mmc1 = &emmc;
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+	};
+
+	cpus {
+		#address-cells = <2>;
+		#size-cells = <0>;
+
+		cpu@0 {
+			device_type = "cpu";
+			compatible = "arm,cortex-a53";
+			reg = <0x0 0x0>;
+		};
+	};
+
+	/* The first 0x2f000 bytes are boot ROM. */
+	memory@2f000 {
+		device_type = "memory";
+		reg = <0x2f000 0x7ffd1000>;
+	};
+
+	timer {
+		compatible = "arm,armv8-timer";
+	};
+
+	soc {
+		compatible = "simple-bus";
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges;
+
+		crt: syscon@98000000 {
+			compatible = "syscon";
+			reg = <0x98000000 0x1000>;
+			bootph-all;
+		};
+
+		/* the bus bridge */
+		sb2: syscon@9801a000 {
+			compatible = "syscon";
+			reg = <0x9801a000 0x1000>;
+		};
+
+		sdmmc: mmc@98010400 {
+			compatible = "realtek,rtd1395-sdmmc";
+			/* The boot firmware sets up the pins and the card power. */
+			reg = <0x98010400 0x200>;
+			realtek,crt = <&crt>;
+			bus-width = <4>;
+		};
+
+		/* The boot firmware sets up the eMMC pins. */
+		emmc: mmc@98012000 {
+			compatible = "realtek,rtd1395-emmc";
+			reg = <0x98012000 0x600>;
+			realtek,crt = <&crt>;
+			realtek,sb2 = <&sb2>;
+			bus-width = <8>;
+			non-removable;
+		};
+
+		uart0: serial@98007800 {
+			compatible = "snps,dw-apb-uart";
+			reg = <0x98007800 0x400>;
+			reg-shift = <2>;
+			reg-io-width = <4>;
+			clock-frequency = <27000000>;
+			/* keep the baud rate the Realtek bootcode set up */
+			skip-init;
+			bootph-all;
+		};
+	};
+};
