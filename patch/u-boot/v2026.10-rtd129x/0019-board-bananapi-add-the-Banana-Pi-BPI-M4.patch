diff --git a/board/bananapi/bpi-m4/bpi-m4.c b/board/bananapi/bpi-m4/bpi-m4.c
new file mode 100644
index 0000000000..91304bba5f
--- /dev/null
+++ b/board/bananapi/bpi-m4/bpi-m4.c
@@ -0,0 +1,34 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Banana Pi BPI-M4 (Realtek RTD1395)
+ */
+
+#include <init.h>
+#include <asm/io.h>
+#include <linux/bitops.h>
+
+#define ISO_PINMUX_GPIO12	0x9804e004
+#define  GPIO12_13_FUNC		GENMASK(3, 0)
+#define  GPIO12_13_I2C0		0x5
+#define ISO_PINMUX_PROB		0x9804e014
+#define  PROB_0_FUNC		GENMASK(11, 10)
+
+/* The status LED is on prob_0 (ISO GPIO 52). The boot firmware muxes it to p2s. */
+static void bpi_m4_status_led(void)
+{
+	clrbits_le32(ISO_PINMUX_PROB, PROB_0_FUNC);
+}
+
+/* The PMIC bus: ISO GPIO 12 and 13 to i2c0. The boot firmware leaves them GPIOs. */
+static void bpi_m4_i2c0_pins(void)
+{
+	clrsetbits_le32(ISO_PINMUX_GPIO12, GPIO12_13_FUNC, GPIO12_13_I2C0);
+}
+
+int board_init(void)
+{
+	bpi_m4_status_led();
+	bpi_m4_i2c0_pins();
+
+	return 0;
+}
diff --git a/board/bananapi/bpi-m4/bpi-m4.env b/board/bananapi/bpi-m4/bpi-m4.env
new file mode 100644
index 0000000000..ea6ad3620e
--- /dev/null
+++ b/board/bananapi/bpi-m4/bpi-m4.env
@@ -0,0 +1,12 @@
+/*
+ * Linux reserves most of the low 512 MiB (firmware, heaps, TEE): load
+ * everything at 0x1a200000 - 0x1fc00000 or above 0x20000000.
+ */
+scriptaddr=0x1fe00000
+pxefile_addr_r=0x1fd00000
+fdt_addr_r=0x20000000
+kernel_addr_r=0x20200000
+kernel_comp_addr_r=0x38000000
+kernel_comp_size=0x4000000
+ramdisk_addr_r=0x30000000
+fdtfile=realtek/rtd1395-bpi-m4.dtb
