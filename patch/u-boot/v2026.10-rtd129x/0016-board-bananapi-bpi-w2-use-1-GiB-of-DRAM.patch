From 5aa2a7ce5e77ecab9eeadc2714fda2a73f6a856b Mon Sep 17 00:00:00 2001
From: Igor Pecovnik <igor@armbian.com>
Date: Sat, 17 Oct 2026 16:31:54 +0200
Subject: [PATCH] board: bananapi: bpi-w2: use 1 GiB of DRAM

The eMMC boot area sets up one of the two DRAM controllers. The upper
1 GiB then aliases the lower 1 GiB, and Linux corrupts its own memory
under load. Report 1 GiB until the boot area sets up both controllers.

Signed-off-by: Igor Pecovnik <igor@armbian.com>
---
 arch/arm/dts/rtd1296-bananapi-w2.dts | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/arch/arm/dts/rtd1296-bananapi-w2.dts b/arch/arm/dts/rtd1296-bananapi-w2.dts
index 89a39fd170..3b72a12f28 100644
--- a/arch/arm/dts/rtd1296-bananapi-w2.dts
+++ b/arch/arm/dts/rtd1296-bananapi-w2.dts
@@ -32,10 +32,14 @@
 		};
 	};
 
-	/* The first 0x1f000 bytes are boot ROM. */
+	/*
+	 * The first 0x1f000 bytes are boot ROM. The board has 2 GiB, but the
+	 * eMMC boot area sets up one DRAM controller, so the upper 1 GiB
+	 * aliases the lower one. Use 1 GiB only.
+	 */
 	memory@1f000 {
 		device_type = "memory";
-		reg = <0x1f000 0x7ffe1000>;
+		reg = <0x1f000 0x3ffe1000>;
 	};
 
 	timer {
-- 
2.53.0

