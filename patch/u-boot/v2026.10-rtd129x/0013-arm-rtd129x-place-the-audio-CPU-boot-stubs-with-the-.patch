From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Igor Pecovnik <igor@armbian.com>
Date: Tue, 13 Oct 2026 20:10:34 +0200
Subject: [PATCH 13/13] arm: rtd129x: place the audio CPU boot stubs with the
 MD engine

Without the vendor U-Boot before it, the audio CPU never ran its
firmware: its boot stubs were missing. They belong in the first 0x2100
bytes of DRAM, which the ARM side cannot write; it sees the boot ROM
there. Copy them in place with the MD (memory DMA) engine, as the
vendor U-Boot does, and set the jump address that the audio CPU's ROM
reads. Sync the SB2 bridge before the audio CPU starts.

Signed-off-by: Igor Pecovnik <igor@armbian.com>
---
 arch/arm/mach-rtd129x/acpu.c       | 98 +++++++++++++++++++++++++++++-
 arch/arm/mach-rtd129x/acpu_stubs.h | 95 +++++++++++++++++++++++++++++
 2 files changed, 192 insertions(+), 1 deletion(-)
 create mode 100644 arch/arm/mach-rtd129x/acpu_stubs.h

diff --git a/arch/arm/mach-rtd129x/acpu.c b/arch/arm/mach-rtd129x/acpu.c
index ef223c9e17..0988e32f25 100644
--- a/arch/arm/mach-rtd129x/acpu.c
+++ b/arch/arm/mach-rtd129x/acpu.c
@@ -6,16 +6,24 @@
  *
  * The firmware finds its settings in an IPC block at 0x1f000, in big
  * endian. The block holds garbage at power-on.
+ *
+ * The audio CPU boots from small stubs in the first 0x2100 bytes of DRAM.
+ * The ARM side sees the boot ROM there, not the DRAM: only the MD (memory
+ * DMA) engine can put the stubs in place.
  */
 
 #include <command.h>
+#include <malloc.h>
 #include <cpu_func.h>
 #include <string.h>
+#include <time.h>
 #include <vsprintf.h>
 #include <asm/byteorder.h>
+#include <asm/cache.h>
 #include <asm/io.h>
 #include <linux/bitops.h>
 #include <linux/delay.h>
+#include <linux/errno.h>
 
 #define IPC_BASE		0x1f000
 #define IPC_SIZE		0x1000
@@ -31,11 +39,91 @@
 #define CRT_CLOCK_ENABLE2	0x98000010
 #define  CLK_EN_ACPU		BIT(4)
 
+#define SB2_SYNC		0x9801a020
 #define UART0_BASE		0x98007800
+
+/* MD engine: a queue of copy commands */
+#define MD_KMQ_CNTL		0x9800b060
+#define  KMQ_GO			0x7
+#define  KMQ_STOP		0x6
+#define  KMQ_IDLE		BIT(3)
+#define MD_KMQ_INT_STATUS	0x9800b064
+#define  KMQ_INT_CLEAR		0x3e
+#define  KMQ_INT_ERRORS		(BIT(1) | BIT(2))
+#define MD_KMQBASE		0x9800b06c
+#define MD_KMQLIMIT		0x9800b070
+#define MD_KMQRDPTR		0x9800b074
+#define MD_KMQWRPTR		0x9800b078
+#define MD_CMD_COPY		5
+
+/* Read by the audio CPU's boot ROM, not a register */
+#define ACPU_JUMP_ADDR		0x58007080
 #define ACPU_BOOT		0x00002000
 #define KSEG0			0x80000000	/* cached, on the ACPU */
 #define KSEG1			0xa0000000	/* uncached */
 
+#include "acpu_stubs.h"
+
+static const struct {
+	ulong dst;
+	const u8 *data;
+	u32 len;
+} acpu_stubs[] = {
+	{ 0x0080, acpu_exc_redirect, sizeof(acpu_exc_redirect) },
+	{ 0x0100, acpu_exc_dispatch, sizeof(acpu_exc_dispatch) },
+	{ 0x1500, acpu_isr_video, sizeof(acpu_isr_video) },
+	{ 0x1900, acpu_ros_boot_vector, sizeof(acpu_ros_boot_vector) },
+	{ 0x2000, acpu_a_entry, sizeof(acpu_a_entry) },
+};
+
+/* Copy the stubs in place with the MD engine */
+static int acpu_put_stubs(void)
+{
+	const int n = ARRAY_SIZE(acpu_stubs);
+	u32 *cmd;
+	int i, ret = 0;
+	ulong start;
+
+	cmd = memalign(ARCH_DMA_MINALIGN, n * 4 * sizeof(u32));
+	if (!cmd)
+		return -ENOMEM;
+	for (i = 0; i < n; i++) {
+		cmd[i * 4] = MD_CMD_COPY;
+		cmd[i * 4 + 1] = acpu_stubs[i].dst;
+		cmd[i * 4 + 2] = (ulong)acpu_stubs[i].data;
+		cmd[i * 4 + 3] = acpu_stubs[i].len;
+	}
+	flush_dcache_all();
+	writel(0, (void *)SB2_SYNC);
+	dsb();
+
+	writel(KMQ_STOP, (void *)MD_KMQ_CNTL);
+	writel(KMQ_INT_CLEAR, (void *)MD_KMQ_INT_STATUS);
+	writel((ulong)cmd, (void *)MD_KMQBASE);
+	writel((ulong)cmd, (void *)MD_KMQRDPTR);
+	writel((ulong)cmd + n * 4 * sizeof(u32), (void *)MD_KMQWRPTR);
+	writel((ulong)cmd + (n + 1) * 4 * sizeof(u32), (void *)MD_KMQLIMIT);
+	writel(KMQ_GO, (void *)MD_KMQ_CNTL);
+
+	/* done once the engine has read every command and is idle again */
+	start = get_timer(0);
+	while (readl((void *)MD_KMQRDPTR) != readl((void *)MD_KMQWRPTR) ||
+	       !(readl((void *)MD_KMQ_CNTL) & KMQ_IDLE)) {
+		if (get_timer(start) > 100)
+			break;
+	}
+	if (readl((void *)MD_KMQRDPTR) != readl((void *)MD_KMQWRPTR) ||
+	    !(readl((void *)MD_KMQ_CNTL) & KMQ_IDLE) ||
+	    readl((void *)MD_KMQ_INT_STATUS) & KMQ_INT_ERRORS) {
+		printf("ACPU: MD copy failed, status %08x %08x\n",
+		       readl((void *)MD_KMQ_CNTL),
+		       readl((void *)MD_KMQ_INT_STATUS));
+		ret = -EIO;
+	}
+	free(cmd);
+	return ret;
+}
+
 static void ipc_write(unsigned int off, u32 val)
 {
 	writel(cpu_to_be32(val), (void *)(uintptr_t)(IPC_BASE + off));
@@ -55,6 +143,12 @@ static int do_acpu(struct cmd_tbl *cmdtp, int flag, int argc,
 		return CMD_RET_FAILURE;
 	}
 
+	if (acpu_put_stubs()) {
+		printf("ACPU: cannot place the boot stubs\n");
+		return CMD_RET_FAILURE;
+	}
+	writel(cpu_to_be32(ACPU_BOOT | KSEG1), (void *)ACPU_JUMP_ADDR);
+
 	memset((void *)IPC_BASE, 0, IPC_SIZE);
 	ipc_write(IPC_UART, UART0_BASE | 0xc0000000);
 	ipc_write(IPC_VO_STD, IPC_BASE + IPC_VO_RESOLUTION);
@@ -63,8 +157,10 @@ static int do_acpu(struct cmd_tbl *cmdtp, int flag, int argc,
 	ipc_write(IPC_OFFSET, IPC_BASE);
 	ipc_write(IPC_MAGIC, 0x16803001);
 
-	/* The ACPU reads DDR, not our cache */
+	/* The ACPU reads DDR: not our cache, nor the bus bridge's buffer */
 	flush_dcache_all();
+	writel(0, (void *)SB2_SYNC);
+	dsb();
 
 	writel(ACPU_BOOT | KSEG1, (void *)ISO_RESERVED_USE_3);
 	setbits_le32((void *)CRT_CLOCK_ENABLE2, CLK_EN_ACPU);
