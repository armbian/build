From 9934642b3f06dd1a284997944883c06f8eabadf0 Mon Sep 17 00:00:00 2001
From: Igor Pecovnik <igor@armbian.com>
Date: Sat, 17 Oct 2026 17:01:11 +0200
Subject: [PATCH 16/17] arm: rtd129x: use 1 GiB of DRAM with one DRAM
 controller

The BPI-W2 has two DRAM controllers. Its eMMC boot area sets up only one,
and the upper 1 GiB then aliases the lower 1 GiB. Linux corrupts its own
memory under load. Read DC_SYS_MISC and limit DRAM to 1 GiB when only one
controller is enabled. SD boots set up both and keep 2 GiB.

Signed-off-by: Igor Pecovnik <igor@armbian.com>
---
 arch/arm/mach-rtd129x/soc.c | 29 +++++++++++++++++++++++++++--
 1 file changed, 27 insertions(+), 2 deletions(-)

diff --git a/arch/arm/mach-rtd129x/soc.c b/arch/arm/mach-rtd129x/soc.c
index b0497dfce8..8b40ce0359 100644
--- a/arch/arm/mach-rtd129x/soc.c
+++ b/arch/arm/mach-rtd129x/soc.c
@@ -7,6 +7,7 @@
  */
 
 #include <cpu_func.h>
+#include <linux/sizes.h>
 #include <env.h>
 #include <fdt_support.h>
 #include <fdtdec.h>
@@ -67,14 +68,38 @@ int arch_cpu_init(void)
 	return 0;
 }
 
+/*
+ * The board DT has the full DRAM, on two controllers. The eMMC boot area
+ * of the BPI-W2 sets up one controller only: the upper 1 GiB then aliases
+ * the lower 1 GiB. Use 1 GiB in that case.
+ */
+#define DC_SYS_MISC		0x98008004
+#define  TWO_DCSYS_EN		BIT(0)
+
+static bool rtd129x_one_dc(void)
+{
+	return !(readl(DC_SYS_MISC) & TWO_DCSYS_EN);
+}
+
 int dram_init(void)
 {
-	return fdtdec_setup_mem_size_base();
+	int ret = fdtdec_setup_mem_size_base();
+
+	if (!ret && rtd129x_one_dc() && gd->ram_base + gd->ram_size > SZ_1G)
+		gd->ram_size = SZ_1G - gd->ram_base;
+
+	return ret;
 }
 
 int dram_init_banksize(void)
 {
-	return fdtdec_setup_memory_banksize();
+	int ret = fdtdec_setup_memory_banksize();
+
+	if (!ret && rtd129x_one_dc() &&
+	    gd->dram[0].start + gd->dram[0].size > SZ_1G)
+		gd->dram[0].size = SZ_1G - gd->dram[0].start;
+
+	return ret;
 }
 
 int print_cpuinfo(void)
