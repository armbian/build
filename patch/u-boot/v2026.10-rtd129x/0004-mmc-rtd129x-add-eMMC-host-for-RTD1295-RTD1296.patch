 drivers/mmc/dw_mmc.c                 |  28 +++-
 drivers/mmc/rtd129x_dw_mmc.c         | 231 +++++++++++++++++++++++++++
 include/dwmmc.h                      |   6 +
 8 files changed, 285 insertions(+), 7 deletions(-)
 create mode 100644 drivers/mmc/rtd129x_dw_mmc.c

