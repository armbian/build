From d3dafe22c70838053e4312fe24d2ac3921708a3a Mon Sep 17 00:00:00 2001
From: Igor Pecovnik <igor@armbian.com>
Date: Thu, 22 Oct 2026 11:59:36 +0200
Subject: [PATCH] board: bananapi: bpi-m4: turn on the Ethernet LEDs

The Ethernet LEDs sit on ISO GPIO 14 and 15. Select their LED
function, as the BSP device tree does.

Assisted-by: Claude Opus 5.5
Signed-off-by: Igor Pecovnik <igor@armbian.com>
---
 board/bananapi/bpi-m4/bpi-m4.c | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/board/bananapi/bpi-m4/bpi-m4.c b/board/bananapi/bpi-m4/bpi-m4.c
index 91304bba5f..5d594ebc04 100644
--- a/board/bananapi/bpi-m4/bpi-m4.c
+++ b/board/bananapi/bpi-m4/bpi-m4.c
@@ -10,6 +10,8 @@
 #define ISO_PINMUX_GPIO12	0x9804e004
 #define  GPIO12_13_FUNC		GENMASK(3, 0)
 #define  GPIO12_13_I2C0		0x5
+#define  GPIO14_15_FUNC		GENMASK(7, 4)
+#define  GPIO14_15_ETN_LED	0x50
 #define ISO_PINMUX_PROB		0x9804e014
 #define  PROB_0_FUNC		GENMASK(11, 10)
 
@@ -25,10 +27,17 @@ static void bpi_m4_i2c0_pins(void)
 	clrsetbits_le32(ISO_PINMUX_GPIO12, GPIO12_13_FUNC, GPIO12_13_I2C0);
 }
 
+/* The Ethernet LEDs (jack, and the blue one below the M.2 slot): ISO GPIO 14 and 15. */
+static void bpi_m4_etn_leds(void)
+{
+	clrsetbits_le32(ISO_PINMUX_GPIO12, GPIO14_15_FUNC, GPIO14_15_ETN_LED);
+}
+
 int board_init(void)
 {
 	bpi_m4_status_led();
 	bpi_m4_i2c0_pins();
+	bpi_m4_etn_leds();
 
 	return 0;
 }
