From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Igor Pecovnik <igor@armbian.com>
Date: Tue, 13 Oct 2026 14:58:29 +0200
Subject: [PATCH 11/13] arm: rtd129x: wait for the secondary CPUs before Linux

Keep the boot ROM release register at the U-Boot address until each
secondary core has reached the hold code, then clear it. Ignore that
address in the hold loop. Drain the SB2 bridge after the core marks
are cleared, or the cleared values reach DDR after the marks.

Signed-off-by: Igor Pecovnik <igor@armbian.com>
---
 arch/arm/mach-rtd129x/smp.S | 15 ++++++++++++++-
 arch/arm/mach-rtd129x/soc.c | 30 ++++++++++++++++++++++++++++++
 2 files changed, 44 insertions(+), 1 deletion(-)

diff --git a/arch/arm/mach-rtd129x/smp.S b/arch/arm/mach-rtd129x/smp.S
index 6a74064d35..c6a0ff889f 100644
--- a/arch/arm/mach-rtd129x/smp.S
+++ b/arch/arm/mach-rtd129x/smp.S
@@ -14,6 +14,8 @@
 #include <linux/linkage.h>
 
 #define CPU_RELEASE_ADDR	0x9801aa44
+/* each core sets its word here once it holds; see soc.c */
+#define CPU_ARRIVED		0xfe000
 
 ENTRY(save_boot_params)
 	mrs	x0, mpidr_el1
@@ -24,8 +26,15 @@ ENTRY(save_boot_params)
 	str	wzr, [x1]
 	b	save_boot_params_ret
 
+	/* tell CPU 0 this core is here */
+1:	and	x0, x0, #0xff
+	ldr	x1, =CPU_ARRIVED
+	mov	w2, #1
+	str	w2, [x1, x0, lsl #2]
+	dsb	sy
+
 	/* the per-core setup that U-Boot's start code does for CPU 0 */
-1:	ldr	x0, =CONFIG_COUNTER_FREQUENCY
+	ldr	x0, =CONFIG_COUNTER_FREQUENCY
 	msr	cntfrq_el0, x0
 	mrs	x0, S3_1_c15_c2_1		/* CPUECTLR_EL1 */
 	orr	x0, x0, #0x40			/* SMPEN: coherency */
@@ -47,7 +56,11 @@ ENDPROC(save_boot_params)
 
 rtd129x_secondary_el2:
 	ldr	x1, =CPU_RELEASE_ADDR
+	ldr	w3, =CONFIG_TEXT_BASE
 2:	wfe
 	ldr	w0, [x1]
 	cbz	w0, 2b
+	/* still the power-up address: not released yet */
+	cmp	w0, w3
+	b.eq	2b
 	br	x0
diff --git a/arch/arm/mach-rtd129x/soc.c b/arch/arm/mach-rtd129x/soc.c
index 4ef51b65c5..b0497dfce8 100644
--- a/arch/arm/mach-rtd129x/soc.c
+++ b/arch/arm/mach-rtd129x/soc.c
@@ -11,7 +11,10 @@
 #include <fdt_support.h>
 #include <fdtdec.h>
 #include <init.h>
+#include <string.h>
+#include <time.h>
 #include <asm/armv8/mmu.h>
+#include <asm/cache.h>
 #include <asm/global_data.h>
 #include <asm/io.h>
 #include <linux/bitops.h>
@@ -120,6 +123,10 @@ void reset_cpu(void)
 /* the U-Boot image the secondary cores run from; Linux must keep off it */
 #define SECONDARY_CODE		0x20000
 #define SECONDARY_CODE_SIZE	0xe0000
+/* smp.S sets a word per core here once the core holds */
+#define CPU_ARRIVED		0xfe000
+#define NR_CPUS_RTD129X		4
+#define SB2_SYNC		0x9801a020
 
 static void rtd129x_release_secondaries(void)
 {
@@ -132,11 +139,34 @@ static void rtd129x_release_secondaries(void)
 	 * Power the secondary cores up, as the BSP's bootup_slave_cpu() does
 	 * on revision B00 and later.
 	 */
+	u32 *arrived = (u32 *)CPU_ARRIVED;
+	ulong start;
+	int cpu;
+
+	memset(arrived, 0, NR_CPUS_RTD129X * sizeof(*arrived));
+	flush_dcache_range(CPU_ARRIVED, CPU_ARRIVED + ARCH_DMA_MINALIGN);
+	/* drain the bus bridge, or the zeros land after the cores' marks */
+	writel(0, SB2_SYNC);
+	dsb();
 	writel(SECONDARY_CODE, CPU_RELEASE_ADDR);
 	writel(0x00010000, 0x9801d104);
 	writel(0x03ffff00, 0x9801d530);
 	writel(0x011f3bff, 0x9801d100);
 	writel(0x0f1f3bff, 0x9801d100);
+
+	/*
+	 * Keep the address until every core is in smp.S. Booted from eMMC,
+	 * they take longer to get there than from the SD card.
+	 */
+	start = get_timer(0);
+	for (cpu = 1; cpu < NR_CPUS_RTD129X; cpu++) {
+		do {
+			invalidate_dcache_range(CPU_ARRIVED,
+						CPU_ARRIVED + ARCH_DMA_MINALIGN);
+		} while (!readl(&arrived[cpu]) && get_timer(start) < 1000);
+		if (!readl(&arrived[cpu]))
+			printf("CPU%d did not start\n", cpu);
+	}
 	writel(0, CPU_RELEASE_ADDR);
 	released = true;
 }
