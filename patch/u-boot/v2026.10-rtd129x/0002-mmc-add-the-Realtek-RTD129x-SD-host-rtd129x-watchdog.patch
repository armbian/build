From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Igor Pecovnik <igor@armbian.com>
Date: Mon, 12 Oct 2026 19:37:58 +0200
Subject: [PATCH 02/13] mmc: add the Realtek RTD129x SD host; rtd129x: watchdog
 reset

The SD host is the Realtek card reader core, memory-mapped into the SoC.
Polled, DMA through a bounce buffer, 4-bit at 25 MHz. Ported from the
Linux driver by JalenLin (BPI-W2-linux).

reset_cpu() restarts through the ISO watchdog.

Tested on the BPI-W2: reads FAT and ext4 from SD at 7.5 MiB/s and boots
Armbian with booti.

Signed-off-by: Igor Pecovnik <igor@armbian.com>
---
 arch/arm/dts/rtd1296-bananapi-w2.dts |  15 +
 arch/arm/mach-rtd129x/soc.c          |  25 +-
 configs/bananapi-w2_defconfig        |  21 +-
 drivers/mmc/Kconfig                  |   7 +
 drivers/mmc/Makefile                 |   1 +
 drivers/mmc/rtd129x_sdmmc.c          | 627 +++++++++++++++++++++++++++
 6 files changed, 686 insertions(+), 10 deletions(-)
 create mode 100644 drivers/mmc/rtd129x_sdmmc.c

diff --git a/arch/arm/dts/rtd1296-bananapi-w2.dts b/arch/arm/dts/rtd1296-bananapi-w2.dts
index 2006e06605..b2caa80a72 100644
--- a/arch/arm/dts/rtd1296-bananapi-w2.dts
+++ b/arch/arm/dts/rtd1296-bananapi-w2.dts
@@ -13,6 +13,7 @@
 
 	aliases {
 		serial0 = &uart0;
+		mmc0 = &sdmmc;
 	};
 
 	chosen {
@@ -46,6 +47,20 @@
 		#size-cells = <1>;
 		ranges;
 
+		crt: syscon@98000000 {
+			compatible = "syscon";
+			reg = <0x98000000 0x1000>;
+			bootph-all;
+		};
+
+		sdmmc: mmc@98010400 {
+			compatible = "realtek,rtd1295-sdmmc";
+			/* the card reader core, then its pads */
+			reg = <0x98010400 0x200>, <0x98012600 0x40>;
+			realtek,crt = <&crt>;
+			bus-width = <4>;
+		};
+
 		uart0: serial@98007800 {
 			compatible = "snps,dw-apb-uart";
 			reg = <0x98007800 0x400>;
diff --git a/arch/arm/mach-rtd129x/soc.c b/arch/arm/mach-rtd129x/soc.c
index d9b9577249..104c5f70f6 100644
--- a/arch/arm/mach-rtd129x/soc.c
+++ b/arch/arm/mach-rtd129x/soc.c
@@ -11,6 +11,8 @@
 #include <init.h>
 #include <asm/armv8/mmu.h>
 #include <asm/global_data.h>
+#include <asm/io.h>
+#include <linux/bitops.h>
 #include <asm/system.h>
 
 DECLARE_GLOBAL_DATA_PTR;
@@ -59,9 +61,30 @@ int print_cpuinfo(void)
 	return 0;
 }
 
+/*
+ * Restart through the ISO watchdog, as Realtek's kernel does: it fires after
+ * 0x800000 ticks of the 27 MHz clock, ~310 ms, and holds reset as long.
+ */
+#define RTD129X_WDT		0x98007680
+#define  WDT_TCWCR		0x00
+#define   TCWCR_WDEN_MASK	0xff
+#define   TCWCR_WDEN_DISABLED	0xa5
+#define   TCWCR_WDEN_ENABLED	0xff
+#define  WDT_TCWTR		0x04
+#define   TCWTR_WDCLR		BIT(0)
+#define  WDT_TCWOV		0x0c
+#define  WDT_TCWRSTB_CNT	0x40
+
 void reset_cpu(void)
 {
-	/* TODO: restart through the RTD119x/RTD129x watchdog */
+	void __iomem *wdt = (void __iomem *)RTD129X_WDT;
+
+	clrsetbits_le32(wdt + WDT_TCWCR, TCWCR_WDEN_MASK, TCWCR_WDEN_DISABLED);
+	writel(0x00800000, wdt + WDT_TCWRSTB_CNT);
+	writel(TCWTR_WDCLR, wdt + WDT_TCWTR);
+	writel(0x00800000, wdt + WDT_TCWOV);
+	clrsetbits_le32(wdt + WDT_TCWCR, TCWCR_WDEN_MASK, TCWCR_WDEN_ENABLED);
+
 	while (1)
 		;
 }
