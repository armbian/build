From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Igor Pecovnik <igor@armbian.com>
Date: Mon, 12 Oct 2026 21:07:45 +0200
Subject: [PATCH 05/13] board: bananapi: bpi-w2: boot Armbian with standard
 boot

Boot without help from the vendor U-Boot. Standard boot finds boot.scr
on the SD card or the eMMC.

Build for 0x20000, where the vendor loader puts U-Boot from the SD
card. Make U-Boot position independent, so it also runs when loaded
elsewhere. Load the kernel, DTB and initrd above the memory that Linux
reserves for the firmware.

Signed-off-by: Igor Pecovnik <igor@armbian.com>
---
 arch/arm/mach-rtd129x/Kconfig    |  2 +-
 board/bananapi/bpi-w2/bpi-w2.env | 12 ++++++++++++
 configs/bananapi-w2_defconfig    | 11 ++++-------
 include/configs/rtd129x.h        |  2 +-
 4 files changed, 18 insertions(+), 9 deletions(-)
 create mode 100644 board/bananapi/bpi-w2/bpi-w2.env

diff --git a/arch/arm/mach-rtd129x/Kconfig b/arch/arm/mach-rtd129x/Kconfig
index fab1c76dba..bc80c1688c 100644
--- a/arch/arm/mach-rtd129x/Kconfig
+++ b/arch/arm/mach-rtd129x/Kconfig
@@ -1,7 +1,7 @@
 if ARCH_RTD129X
 
 config TEXT_BASE
-	default 0x10000000
+	default 0x20000
 
 config SYS_CONFIG_NAME
 	default "rtd129x"
diff --git a/board/bananapi/bpi-w2/bpi-w2.env b/board/bananapi/bpi-w2/bpi-w2.env
new file mode 100644
index 0000000000..62c22ddd0a
--- /dev/null
+++ b/board/bananapi/bpi-w2/bpi-w2.env
@@ -0,0 +1,12 @@
+/*
+ * Linux reserves most of the low 512 MiB (firmware, heaps, TEE): load
+ * everything at 0x1a200000 - 0x1fc00000 or above 0x20000000.
+ */
+scriptaddr=0x1fe00000
+pxefile_addr_r=0x1fd00000
+fdt_addr_r=0x20000000
+kernel_addr_r=0x20200000
+kernel_comp_addr_r=0x30000000
+kernel_comp_size=0x4000000
+ramdisk_addr_r=0x40000000
+fdtfile=realtek/rtd1296-bananapi-w2.dtb
diff --git a/configs/bananapi-w2_defconfig b/configs/bananapi-w2_defconfig
index 1dc85f83e2..3c3a27f0f5 100644
--- a/configs/bananapi-w2_defconfig
+++ b/configs/bananapi-w2_defconfig
@@ -1,24 +1,21 @@
 CONFIG_ARM=y
 CONFIG_COUNTER_FREQUENCY=27000000
+CONFIG_POSITION_INDEPENDENT=y
 CONFIG_ARCH_RTD129X=y
 CONFIG_NR_DRAM_BANKS=1
 CONFIG_DEFAULT_DEVICE_TREE="rtd1296-bananapi-w2"
+CONFIG_OF_LIBFDT_OVERLAY=y
 CONFIG_SYS_LOAD_ADDR=0x3000000
 CONFIG_DEBUG_UART_BASE=0x98007800
 CONFIG_DEBUG_UART_CLOCK=27000000
 CONFIG_IDENT_STRING=" BPI-W2"
 CONFIG_DEBUG_UART=y
-CONFIG_SUPPORT_RAW_INITRD=y
+CONFIG_BOOTSTD_DEFAULTS=y
 CONFIG_CMD_MMC=y
-CONFIG_CMD_PART=y
-CONFIG_CMD_EXT4=y
-CONFIG_CMD_FAT=y
-CONFIG_CMD_FS_GENERIC=y
-CONFIG_EFI_PARTITION=y
 # CONFIG_NET is not set
+CONFIG_MMC_RTD129X_DW=y
 CONFIG_MMC_RTD129X=y
 CONFIG_DEBUG_UART_SHIFT=2
 CONFIG_DEBUG_UART_ANNOUNCE=y
 CONFIG_DEBUG_UART_SKIP_INIT=y
 CONFIG_SYS_NS16550=y
-CONFIG_MMC_RTD129X_DW=y
diff --git a/include/configs/rtd129x.h b/include/configs/rtd129x.h
index b2e67e30c9..facb371191 100644
--- a/include/configs/rtd129x.h
+++ b/include/configs/rtd129x.h
@@ -5,7 +5,7 @@
 
 #define CFG_SYS_SDRAM_BASE	0x0
 
-/* Early stack, below TEXT_BASE and clear of the audio firmware at 0x0f900000 */
+/* Early stack, clear of the audio firmware at 0x0f900000 */
 #define CFG_SYS_INIT_RAM_ADDR	0x0e000000
 #define CFG_SYS_INIT_RAM_SIZE	0x00100000
 
