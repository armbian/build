From bb0716d2bcc883de110c6f1fda3e63df4a7b872f Mon Sep 17 00:00:00 2001
From: Igor Pecovnik <igor@armbian.com>
Date: Thu, 22 Oct 2026 11:19:14 +0200
Subject: [PATCH] arm: rtd129x: open the RTD1395 eMMC controller to Linux

The RTD1395 eMMC controller is secure-only after reset.
Linux runs non-secure and reads 0xdeaddead from it.
Open the controller before the kernel starts.

Assisted-by: Claude Opus 5.5
Signed-off-by: Igor Pecovnik <igor@armbian.com>
---
 arch/arm/mach-rtd129x/soc.c | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/arch/arm/mach-rtd129x/soc.c b/arch/arm/mach-rtd129x/soc.c
index 4cfd6f7cd4..f288eee2b0 100644
--- a/arch/arm/mach-rtd129x/soc.c
+++ b/arch/arm/mach-rtd129x/soc.c
@@ -188,6 +188,8 @@ void reset_cpu(void)
 #define CPU_ARRIVED		0xfe000
 #define NR_CPUS_RTD129X		4
 #define SB2_SYNC		0x9801a020
+/* not in the vendor headers; 1 lets the non-secure world reach the eMMC */
+#define RTD1395_EMMC_NS_ACCESS	0x980124d4
 
 static void rtd129x_release_secondaries(void)
 {
@@ -265,6 +267,10 @@ int ft_system_setup(void *blob, struct bd_info *bd)
 	if (ret)
 		return ret;
 
+	/* the RTD1395 eMMC controller is secure-only until opened */
+	if (IS_ENABLED(CONFIG_RTD1395))
+		writel(1, RTD1395_EMMC_NS_ACCESS);
+
 	rtd129x_release_secondaries();
 
 	return 0;
-- 
