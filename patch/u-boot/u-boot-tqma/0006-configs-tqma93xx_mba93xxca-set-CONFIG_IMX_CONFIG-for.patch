From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Martin Schmiedel <Martin.Schmiedel@tq-group.com>
Date: Wed, 24 Jun 2026 13:08:58 +0200
Subject: configs: tqma93xx_mba93xxca: set CONFIG_IMX_CONFIG for Armbian
 mkimage

The Armbian build environment ships an older mkimage that does not
support IMAGE_VERSION 2 cfgout auto-generation. Without an explicit
CONFIG_IMX_CONFIG, mkimage falls back to auto-generating a cfgout with
IMAGE_VERSION 2, which it cannot process, and the build fails.

Set CONFIG_IMX_CONFIG to arch/arm/mach-imx/imx9/imximage.cfg so
mkimage uses the explicit SOC_TYPE/CONTAINER format instead.
---
 configs/tqma93xx_mba93xxca_defconfig     | 1 +
 configs/tqma93xx_mba93xxca_ecc_defconfig | 1 +
 configs/tqma93xx_mba93xxca_uuu_defconfig | 1 +
 3 files changed, 3 insertions(+)

diff --git a/configs/tqma93xx_mba93xxca_defconfig b/configs/tqma93xx_mba93xxca_defconfig
index 111111111111..222222222222 100644
--- a/configs/tqma93xx_mba93xxca_defconfig
+++ b/configs/tqma93xx_mba93xxca_defconfig
@@ -10,6 +10,7 @@ CONFIG_SF_DEFAULT_SPEED=60000000
 CONFIG_ENV_SIZE=0x10000
 CONFIG_ENV_OFFSET=0x400000
 CONFIG_ENV_SECT_SIZE=0x10000
+CONFIG_IMX_CONFIG="arch/arm/mach-imx/imx9/imximage.cfg"
 CONFIG_DEFAULT_DEVICE_TREE="imx93-tqma9352-mba93xxca"
 CONFIG_SPL_TEXT_BASE=0x2049A000
 CONFIG_TARGET_TQMA93XX=y
diff --git a/configs/tqma93xx_mba93xxca_ecc_defconfig b/configs/tqma93xx_mba93xxca_ecc_defconfig
index 111111111111..222222222222 100644
--- a/configs/tqma93xx_mba93xxca_ecc_defconfig
+++ b/configs/tqma93xx_mba93xxca_ecc_defconfig
@@ -10,6 +10,7 @@ CONFIG_SF_DEFAULT_SPEED=60000000
 CONFIG_ENV_SIZE=0x10000
 CONFIG_ENV_OFFSET=0x400000
 CONFIG_ENV_SECT_SIZE=0x10000
+CONFIG_IMX_CONFIG="arch/arm/mach-imx/imx9/imximage.cfg"
 CONFIG_DEFAULT_DEVICE_TREE="imx93-tqma9352-mba93xxca"
 CONFIG_SPL_TEXT_BASE=0x2049A000
 CONFIG_TARGET_TQMA93XX=y
diff --git a/configs/tqma93xx_mba93xxca_uuu_defconfig b/configs/tqma93xx_mba93xxca_uuu_defconfig
index 111111111111..222222222222 100644
--- a/configs/tqma93xx_mba93xxca_uuu_defconfig
+++ b/configs/tqma93xx_mba93xxca_uuu_defconfig
@@ -8,6 +8,7 @@ CONFIG_SPL_LIBGENERIC_SUPPORT=y
 CONFIG_NR_DRAM_BANKS=2
 CONFIG_SF_DEFAULT_SPEED=60000000
 CONFIG_ENV_SIZE=0x10000
+CONFIG_IMX_CONFIG="arch/arm/mach-imx/imx9/imximage.cfg"
 CONFIG_DEFAULT_DEVICE_TREE="imx93-tqma9352-mba93xxca"
 CONFIG_SPL_TEXT_BASE=0x2049A000
 CONFIG_TARGET_TQMA93XX=y
-- 
Armbian

