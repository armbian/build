Makefile: drop -ansi from cpp_cfg and cpp_lds

U-Boot 2015.07 preprocesses include/config.h into u-boot.cfg, and the
board linker script into u-boot.lds, with -ansi (= ISO C90). The
Spreadtrum board headers use C++ style comments, so GCC rejects them:

  include/configs/ums512_1h10.h:29:1: error: C++ style comments are not
      allowed in ISO C90
  make: *** [Makefile:961: u-boot.cfg] Error 1

There are 20 such comments in the ums512_1h10 header alone, so fixing
the headers is whack-a-mole; -ansi is the actual problem. Both rules are
preprocessor-only invocations (-x assembler-with-cpp -P -dM -E) whose job
is to collect #defines, so the language standard is irrelevant to their
output - the only thing -ansi changes here is that it makes // fatal.

Upstream U-Boot dropped -ansi from these rules for the same reason; this
backports that to the vendor tree. Fixing cpp_lds at the same time avoids
hitting the identical failure on u-boot.lds right after u-boot.cfg.

Signed-off-by: crackerjacques <jack@supremeoverlordjabs.co>

diff --git a/Makefile b/Makefile
index 3fe39cd..7caf35e 100644
--- a/Makefile
+++ b/Makefile
@@ -924,7 +924,7 @@ endif
 
 # Create a file containing the configuration options the image was built with
 quiet_cmd_cpp_cfg = CFG     $@
-cmd_cpp_cfg = $(CPP) -Wp,-MD,$(depfile) $(cpp_flags) $(LDPPFLAGS) -ansi \
+cmd_cpp_cfg = $(CPP) -Wp,-MD,$(depfile) $(cpp_flags) $(LDPPFLAGS) \
 	-DDO_DEPS_ONLY -D__ASSEMBLY__ -x assembler-with-cpp -P -dM -E -o $@ $<
 
 MKIMAGEFLAGS_u-boot.img = -A $(ARCH) -T firmware -C none -O u-boot \
@@ -1299,7 +1299,7 @@ depend dep:
 
 # ---------------------------------------------------------------------------
 quiet_cmd_cpp_lds = LDS     $@
-cmd_cpp_lds = $(CPP) -Wp,-MD,$(depfile) $(cpp_flags) $(LDPPFLAGS) -ansi \
+cmd_cpp_lds = $(CPP) -Wp,-MD,$(depfile) $(cpp_flags) $(LDPPFLAGS) \
 		-D__ASSEMBLY__ -x assembler-with-cpp -P -o $@ $<
 
 u-boot.lds: $(LDSCRIPT) prepare FORCE
