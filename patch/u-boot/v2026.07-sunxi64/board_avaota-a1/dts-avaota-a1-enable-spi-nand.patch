From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Juan Sanchez Fuentes <juanesf91@gmail.com>
Date: Sat, 15 Aug 2026 12:00:00 +0000
Subject: [PATCH] dts: avaota-a1: enable SPI0 with on-board SPI NAND

 Enable SPI0 and its on-board Winbond W25N01GV SPI NAND child node.
 No pinctrl-0 here: the A523 pinctrl table in U-Boot only supports SPI0
 on Port C (pinmux 4), and the Port J pins (PJ20-PJ26, pinmux 5) are
 muxed by sunxi_board_init() instead.

Signed-off-by: Juan Sanchez Fuentes <juanesf91@gmail.com>
Assisted-by: opencode:deepseek-v4-flash-free
---
 dts/upstream/src/arm64/allwinner/sun55i-t527-avaota-a1.dts | 16 ++++++++++++++++
 1 file changed, 16 insertions(+)

diff --git a/dts/upstream/src/arm64/allwinner/sun55i-t527-avaota-a1.dts b/dts/upstream/src/arm64/allwinner/sun55i-t527-avaota-a1.dts
index f74e587a6c52f78404b63941fc5438b5c91199a8..f6b248442f2bd21c80176269d82ce77893886a61 100644
--- a/dts/upstream/src/arm64/allwinner/sun55i-t527-avaota-a1.dts
+++ b/dts/upstream/src/arm64/allwinner/sun55i-t527-avaota-a1.dts
@@ -365,6 +365,22 @@
 	assigned-clock-rates = <32768>;
 };
 
+/*
+ * SPI0 is wired to the on-board SPI NAND (Winbond W25N01GV) on Port J.
+ * No pinctrl-0 here: the A523 pinctrl table in U-Boot only supports SPI0
+ * on Port C (pinmux 4), and the Port J pins (PJ20-PJ26, pinmux 5) are
+ * muxed by sunxi_board_init() instead.
+ */
+&spi0 {
+	status = "okay";
+
+	nand@0 {
+		compatible = "spi-nand";
+		reg = <0>;
+		spi-max-frequency = <100000000>;
+	};
+};
+
 &uart0 {
 	pinctrl-names = "default";
 	pinctrl-0 = <&uart0_pb_pins>;
-- 
Armbian
