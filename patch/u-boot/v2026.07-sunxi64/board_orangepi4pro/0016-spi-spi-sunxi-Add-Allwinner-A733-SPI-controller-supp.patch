From ba1a8f1eb72bac257e46eab1704e3a5e4888ffc6 Mon Sep 17 00:00:00 2001
From: Alastair D'Silva <alastair@d-silva.org>
Date: Tue, 8 Sep 2026 11:02:09 +1000
Subject: [PATCH 16/23] spi: spi-sunxi: Add Allwinner A733 SPI controller
 support

Add compatible 'allwinner,sun60i-a733-spi' to sun4i_spi_ids to support
onboard SPI-NOR flash.

Signed-off-by: Alastair D'Silva <alastair@d-silva.org>
Assisted-by: Antigravity <antigravity@google.com>
---
 drivers/spi/spi-sunxi.c                           |  4 ++++
 dts/upstream/src/arm64/allwinner/sun60i-a733.dtsi | 13 +++++++++++++
 2 files changed, 17 insertions(+)

diff --git a/drivers/spi/spi-sunxi.c b/drivers/spi/spi-sunxi.c
index e00532a371b..b030c51acb4 100644
--- a/drivers/spi/spi-sunxi.c
+++ b/drivers/spi/spi-sunxi.c
@@ -587,6 +587,10 @@ static const struct udevice_id sun4i_spi_ids[] = {
 	  .compatible = "allwinner,sun50i-r329-spi",
 	  .data = (ulong)&sun50i_r329_spi_variant,
 	},
+	{
+	  .compatible = "allwinner,sun60i-a733-spi",
+	  .data = (ulong)&sun50i_r329_spi_variant,
+	},
 	{ /* sentinel */ }
 };
 
diff --git a/dts/upstream/src/arm64/allwinner/sun60i-a733.dtsi b/dts/upstream/src/arm64/allwinner/sun60i-a733.dtsi
index 73b32fe347f..18360f945d5 100644
--- a/dts/upstream/src/arm64/allwinner/sun60i-a733.dtsi
+++ b/dts/upstream/src/arm64/allwinner/sun60i-a733.dtsi
@@ -410,5 +410,18 @@
 			status = "disabled";
 		};
 
+		spi0: spi@2540000 {
+			compatible = "allwinner,sun60i-a733-spi",
+				     "allwinner,sun50i-r329-spi";
+			reg = <0x02540000 0x1000>;
+			interrupts = <GIC_SPI 26 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&ccu CLK_BUS_SPI0>, <&ccu CLK_SPI0>;
+			clock-names = "ahb", "mod";
+			resets = <&ccu RST_BUS_SPI0>;
+			#address-cells = <1>;
+			#size-cells = <0>;
+			status = "disabled";
+		};
+
 	};
 };
