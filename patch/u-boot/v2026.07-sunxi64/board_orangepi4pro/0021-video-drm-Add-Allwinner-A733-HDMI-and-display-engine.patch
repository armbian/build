+	OVL_TYPE_VI,
+	OVL_TYPE_UI,
+};
+
+union ovl_v_attctl_reg {
+	u32 dwval;
+	struct {
+		u32 en:1;
+		u32 alpha_mode:2;
+		u32 res0:1;
+		u32 fcolor_en:1;
+		u32 res1:3;
+		u32 fmt:5;
