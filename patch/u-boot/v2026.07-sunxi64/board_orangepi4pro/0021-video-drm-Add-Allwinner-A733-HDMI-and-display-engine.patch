+		if (displl_clk)
+			tcon_lcd_dsi_clk_source(hwtcon->id, 0);
+		if (tcon_lvds_cfg(&hwtcon->tcon_lcd, lvds_para) != 0) { /* the final param is rcq related */
+			DRM_ERROR("lcd cfg fail!\n");
+			return -1;
