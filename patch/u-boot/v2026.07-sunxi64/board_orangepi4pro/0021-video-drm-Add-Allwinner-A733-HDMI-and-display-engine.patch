+#define PHY_I2CM_INT_DONE_INTERRUPT_MASK            0x00000002
+#define PHY_I2CM_INT_DONE_MASK_MASK                 0x00000004
+#define PHY_I2CM_INT_DONE_POL_MASK                  0x00000008
+
+/**
