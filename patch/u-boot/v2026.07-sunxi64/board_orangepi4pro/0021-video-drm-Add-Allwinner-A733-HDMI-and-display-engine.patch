+	} bits;
+};
+
+union ovl_u_pitch_reg {
+	u32 dwval;
+	struct {
+		u32 pitch:32;
+	} bits;
+};
+
+union ovl_u_laddr_reg {
+	u32 dwval;
+	struct {
+		u32 laddr:32;
+	} bits;
+};
+
+union ovl_u_fcolor_reg {
+	u32 dwval;
+	struct {
+		u32 b:8;
+		u32 g:8;
+		u32 r:8;
+		u32 alpha:8;
+	} bits;
