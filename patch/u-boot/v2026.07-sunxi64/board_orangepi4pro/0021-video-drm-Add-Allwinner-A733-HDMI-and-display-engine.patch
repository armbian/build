+ * @bits: [7:0] Data MSB (datai[15:8]) read from register pointed by phy_i2cm_address[7:0]
+ */
+#define PHY_I2CM_DATAI_1        0x00003024
+#define PHY_I2CM_DATAI_1_DATAI_MASK                 0x000000FF
+
+/**
