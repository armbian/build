+const struct de_bld_desc *get_bld_dsc(struct module_create_info *info)
+{
+	int i, j;
+	for (i = 0; i < ARRAY_SIZE(de_version); i++) {
+		if (de_version[i]->version == info->de_version) {
+			for (j = 0; j < de_version[i]->bld_cnt; j++) {
