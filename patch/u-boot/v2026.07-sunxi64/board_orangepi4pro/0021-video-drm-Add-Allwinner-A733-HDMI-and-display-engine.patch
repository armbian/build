+static inline int get_de_output_display_cnt(struct udevice *dev)
+{
+	struct device_node *port;
+	int i = 0;
+
+	while (true) {
+		port = sunxi_of_graph_get_port_by_id(dev_ofnode(dev), i);
+		if (!port)
+			break;
+		i++;
+		of_node_put(port);
+	};
+	return i;
+}
