+		u32 pipe0_en:1;
+		u32 pipe1_en:1;
+		u32 pipe2_en:1;
+		u32 pipe3_en:1;
+		u32 pipe4_en:1;
+		u32 pipe5_en:1;
+		u32 res1:18;
+	} bits;
+};
+
+union bld_fcolor_reg {
+	u32 dwval;
+	struct {
+		u32 blue:8;
+		u32 green:8;
+		u32 red:8;
+		u32 alpha:8;
+	} bits;
+};
+
+union bld_size_reg {
+	u32 dwval;
+	struct {
+		u32 width:13;
+		u32 res0:3;
+		u32 height:13;
+		u32 res1:3;
+	} bits;
+};
+
+union bld_coord_reg {
+	u32 dwval;
+	struct {
+		u32 xcoord:16;
+		u32 ycoord:16;
+	} bits;
+};
+
+union bld_rout_ctl_reg {
+	u32 dwval;
+	struct {
+		u32 pipe0_rout:4;
+		u32 pipe1_rout:4;
+		u32 pipe2_rout:4;
+		u32 pipe3_rout:4;
+		u32 pipe4_rout:4;
+		u32 pipe5_rout:4;
+		u32 res0:8;
+	} bits;
+};
+
+union bld_premul_ctl_reg {
+	u32 dwval;
+	struct {
+		u32 pipe0_is_premul:1;
+		u32 pipe1_is_premul:1;
+		u32 pipe2_is_premul:1;
+		u32 pipe3_is_premul:1;
+		u32 pipe4_is_premul:1;
+		u32 pipe5_is_premul:1;
+		u32 res0:26;
+	} bits;
