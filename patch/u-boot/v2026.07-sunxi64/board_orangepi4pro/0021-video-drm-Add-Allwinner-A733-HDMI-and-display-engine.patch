+	.disable    = _sunxi_drm_hdmi_disable,
+	.detect     = _sunxi_drm_hdmi_detect,
+	.mode_valid = _sunxi_drm_hdmi_mode_valid,
+	.get_timing = _sunxi_drm_hdmi_get_modes,
