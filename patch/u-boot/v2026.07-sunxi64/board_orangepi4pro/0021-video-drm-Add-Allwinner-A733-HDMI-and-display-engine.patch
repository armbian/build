+ * @bits: [7:0] Data LSB (datao[7:0]) to be written on register pointed by phy_i2cm_address [7:0]
+ */
+#define PHY_I2CM_DATAO_0        0x00003023
+#define PHY_I2CM_DATAO_0_DATAO_MASK                 0x000000FF
+
+/**
