+int drm_add_edid_modes(struct sunxi_drm_connector *connector, struct edid *edid);
+int drm_add_override_edid_modes(struct sunxi_drm_connector *connector);
+
+u8 drm_match_cea_mode(const struct drm_display_mode *to_match);
+bool drm_detect_hdmi_monitor(struct edid *edid);
+bool drm_detect_monitor_audio(struct edid *edid);
+enum hdmi_quantization_range
+drm_default_rgb_quant_range(const struct drm_display_mode *mode);
+int drm_add_modes_noedid(struct sunxi_drm_connector *connector,
+			 int hdisplay, int vdisplay);
+void drm_set_preferred_mode(struct sunxi_drm_connector *connector,
+			    int hpref, int vpref);
+
+int drm_edid_header_is_valid(const u8 *raw_edid);
+bool drm_edid_block_valid(u8 *raw_edid, int block, bool print_bad_edid,
+			  bool *edid_corrupt);
+bool drm_edid_is_valid(struct edid *edid);
+void drm_edid_get_monitor_name(struct edid *edid, char *name,
+			       int buflen);
+struct drm_display_mode *drm_mode_find_dmt(int hsize, int vsize, int fresh,
+					   bool rb);
+struct drm_display_mode *
+drm_display_mode_from_cea_vic(u8 video_code);
+const u8 *drm_find_edid_extension(const struct edid *edid,
+				  int ext_id, int *ext_index);
+int cea_db_offsets(const u8 *cea, int *start, int *end);
+
+#endif /* __DRM_EDID_H__ */
