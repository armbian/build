+		return sunxi_tcon_hdmi_mode_init(tcon_dev);
+	case INTERFACE_DSI:
+		return sunxi_tcon_dsi_mode_init(tcon_dev);
+	case INTERFACE_LVDS:
+		return sunxi_tcon_lvds_mode_init(tcon_dev);
+	case INTERFACE_RGB:
