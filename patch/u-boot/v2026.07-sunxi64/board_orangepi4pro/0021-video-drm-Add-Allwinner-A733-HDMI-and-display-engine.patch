+#ifndef _DE_OVL_H_
+#define _DE_OVL_H_
+
+#include "de_base.h"
+#include "de_channel.h"
+
+enum ovl_premul {
+	DE_OVL_PREMUL_NON_TO_NON = 0,
+	DE_OVL_PREMUL_NON_TO_EXC = 1,
+	DE_OVL_PREMUL_HAS_PREMUL = 2,
+};
+
+struct de_ovl_handle {
+	struct module_create_info cinfo;
