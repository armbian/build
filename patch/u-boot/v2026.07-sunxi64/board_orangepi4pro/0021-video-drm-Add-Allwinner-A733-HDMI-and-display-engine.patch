index 00000000000..7fcc00d96fe
--- /dev/null
+++ b/include/drm/drm_dp_helper.h
@@ -0,0 +1,1231 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+/*
+ * Copyright © 2008 Keith Packard
+ *
+ * Permission to use, copy, modify, distribute, and sell this software and its
