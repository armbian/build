+bool channel_format_mod_supported(struct de_channel_handle *hdl, uint32_t format, uint64_t modifier)
+{
+	if (modifier == DRM_FORMAT_MOD_LINEAR)
+		return true;
+	if (hdl->private->afbd)
+		return de_afbc_format_mod_supported(hdl->private->afbd, format, modifier);
+	return false;
