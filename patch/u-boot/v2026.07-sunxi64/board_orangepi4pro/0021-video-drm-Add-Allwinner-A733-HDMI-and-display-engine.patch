+	{ DRM_FORMAT_ABGR1555, 0, {5, 5, 5, 1}, {0, 4} },
+	{ DRM_FORMAT_RGBA5551, 0, {5, 5, 5, 1}, {0, 4} },
+	{ DRM_FORMAT_BGRA5551, 0, {5, 5, 5, 1}, {0, 4} },
