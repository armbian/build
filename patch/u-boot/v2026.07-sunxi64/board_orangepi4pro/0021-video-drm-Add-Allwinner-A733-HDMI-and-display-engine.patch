+// YUV4:2:0 16x16 layout1 split AFBC compress stream
+#define SUNXI_YUV_AFBC_MOD                                                              \
+	DRM_FORMAT_MOD_ARM_AFBC(AFBC_FORMAT_MOD_BLOCK_SIZE_16x16 | AFBC_FORMAT_MOD_SPARSE | \
+							AFBC_FORMAT_MOD_SPLIT)
