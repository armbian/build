+struct display_state *display_state_get_by_crtc(struct sunxi_drm_crtc *crtc)
+{
+	struct display_state *state;
+
+	if (!crtc) {
+		return NULL;
+	}
+
+	sunxi_drm_for_each_display(state, crtc->drm) {
+		if (state->crtc_state.crtc == crtc) {
+			return state;
+		}
+	}
+	return NULL;
+}
