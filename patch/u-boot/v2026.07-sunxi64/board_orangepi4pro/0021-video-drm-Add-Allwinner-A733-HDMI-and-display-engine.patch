+#define PHY_I2CM_FS_SCL_HCNT_1_ADDR     0x0000302F
+#define PHY_I2CM_FS_SCL_HCNT_1_ADDR_I2CMP_FS_SCL_HCNT1_MASK     0x000000FF
+
+/**
