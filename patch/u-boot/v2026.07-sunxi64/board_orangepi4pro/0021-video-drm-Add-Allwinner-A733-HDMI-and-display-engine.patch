+/**
+ * @desc: sound hdmi audio enable
+ * @enable: 1 - enable hdmi audio
+ *          0 - disable hdmi audio
+ * @channel:
+ * @return: 0 - success
+ *         -1 - failed
+ */
+static s32 _sunxi_drv_audio_enable(u8 enable, u8 channel)
+{
