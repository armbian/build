+
+#include <linux/types.h>
+
+union bld_en_ctl_reg {
+	u32 dwval;
+	struct {
+		u32 pipe0_fcolor_en:1;
+		u32 pipe1_fcolor_en:1;
+		u32 pipe2_fcolor_en:1;
+		u32 pipe3_fcolor_en:1;
+		u32 pipe4_fcolor_en:1;
+		u32 pipe5_fcolor_en:1;
