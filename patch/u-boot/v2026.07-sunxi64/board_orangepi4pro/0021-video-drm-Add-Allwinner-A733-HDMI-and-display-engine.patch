new file mode 100644
index 00000000000..c79bfc3baaf
--- /dev/null
+++ b/drivers/video/drm/sunxi_drm_panel.h
@@ -0,0 +1,114 @@
+/*
+ * sunxi_drm_panel.h
+ *
+ * Copyright (c) 2007-2024 Allwinnertech Co., Ltd.
+ * Author: zhengxiaobin <zhengxiaobin@allwinnertech.com>
+ *
