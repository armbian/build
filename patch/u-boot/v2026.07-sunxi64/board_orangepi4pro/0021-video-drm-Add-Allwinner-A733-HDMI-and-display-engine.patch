+		state->logo = load_file(bmp_name, "boot-resource");
+	}
+
+	if (!state->logo) {
+		DRM_ERROR("Can not load %s file!\n", bmp_name);
+		return -1;
+	}
+
+	/*DRM_INFO("Load file :%s size:%u addr:0x%lx\n", bmp_name, state->logo->file_size, (ulong)state->logo->file_addr);*/
+
+	return 0;
+}
