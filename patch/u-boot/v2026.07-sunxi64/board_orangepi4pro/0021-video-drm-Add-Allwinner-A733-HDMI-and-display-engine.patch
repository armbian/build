+	u32 dwval;
+	struct {
+		u32 en:1;
+		u32 res0:29;
+		u32 reset:1;
+		u32 bist:1;
+	} bits;
+};
+
+union gsu_status_reg {
+	u32 dwval;
+	struct {
+		u32 res0:4;
+		u32 busy:1;
+		u32 res1:11;
+		u32 line_cnt:12;
+		u32 res2:4;
+	} bits;
+};
+
+union gsu_field_ctl_reg {
+	u32 dwval;
+	struct {
+		u32 vphase_en:1;
+		u32 res0:3;
+		u32 filed_reverse:1;
+		u32 sync_reverse:1;
+		u32 res1:26;
+	} bits;
+};
+
+union gsu_bist_reg {
+	u32 dwval;
+	struct {
+		u32 bits_en:1;
+		u32 res0:15;
+		u32 bist_sel:5;
+		u32 res1:11;
+	} bits;
+};
+
+union gsu_scale_mode_reg {
+	u32 dwval;
+	struct {
+		u32 mode:2;
+		u32 res0:30;
+	} bits;
+};
+
+union gsu_size_reg {
+	u32 dwval;
+	struct {
+		u32 width:13;
+		u32 res0:3;
+		u32 height:13;
+		u32 res1:3;
+	} bits;
+};
+
+union gsu_glb_alpha_reg {
+	u32 dwval;
+	struct {
+		u32 alpha:8;
+		u32 res0:24;
+	} bits;
+};
+
+#define GSU_STEP_VALID_START_BIT 2
+#define GSU_STEP_FRAC_BITWIDTH 18
+#define GSU_STEP_FIXED_BITWIDTH 5
+union gsu_step_reg {
+	u32 dwval;
+	struct {
+		u32 res0:GSU_STEP_VALID_START_BIT;
+		u32 frac:GSU_STEP_FRAC_BITWIDTH;
+		u32 fixed:GSU_STEP_FIXED_BITWIDTH;
+		u32 res1:7;
+	} bits;
+};
+
+#define GSU_PHASE_VALID_START_BIT 2
+#define GSU_PHASE_RRAC_BITWIDTH 18
+#define GSU_PHASE_FIXED_BITWIDTH 4
+union gsu_phase_reg {
+	u32 dwval;
+	struct {
+		u32 res0:GSU_PHASE_VALID_START_BIT;
+		u32 frac:GSU_PHASE_RRAC_BITWIDTH;
+		u32 fixed:GSU_PHASE_FIXED_BITWIDTH;
+		u32 res1:8;
+	} bits;
+};
+
+union gsu_filter_hcoef_reg {
+	u32 dwval;
+	struct {
+		u32 coeff0:8;
+		u32 coeff1:8;
+		u32 coeff2:8;
+		u32 coeff3:8;
+	} bits;
+};
+
+struct gsu_reg {
+	union gsu_ctl_reg ctl;
+	u32 res0;
+	union gsu_status_reg status;
+	union gsu_field_ctl_reg field_ctl;
+	union gsu_bist_reg bist;
+	u32 res1[11];
+	union gsu_size_reg out_size;
+	//union gsu_glb_alpha_reg glb_alpha;
+	u32 res2[15];
+	union gsu_size_reg in_size;
+	u32 res3;
+	union gsu_step_reg hstep;
+	union gsu_step_reg vstep;
+	union gsu_phase_reg hphase;
+	u32 res4;
+	union gsu_phase_reg vphase0;
+	union gsu_phase_reg vphase1;
+	u32 res5[88];
+	union gsu_filter_hcoef_reg hcoeff[16];
+};
+/* *************************** gsu ******************************* */
+
+#endif /* #ifndef _DE_SCALER_TYPE_H_ */
