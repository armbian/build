+int sunxi_de_get_wb_status(struct sunxi_drm_wb *drm_wb)
+{
+	int status = 0;
+	status = de_wb_eink_get_status(drm_wb->hw_wb->wb_hdl);
+	de_wb_eink_interrupt_clear(drm_wb->hw_wb->wb_hdl);
+	return status;
+}
