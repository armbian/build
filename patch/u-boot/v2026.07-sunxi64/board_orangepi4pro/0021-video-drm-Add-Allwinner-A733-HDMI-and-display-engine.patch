+	u32 reg_blk_num;
+	union {
+		struct de_reg_block fbd_atw_v_blks[FBD_ATW_V_REG_BLK_NUM];
+		struct de_reg_block fbd_u_blks[FBD_U_REG_BLK_NUM];
+		struct de_reg_block reg_blks[FBD_ATW_MAX_REG_BLK_NUM];
+	};
+	enum fbd_atw_type type;
+};
