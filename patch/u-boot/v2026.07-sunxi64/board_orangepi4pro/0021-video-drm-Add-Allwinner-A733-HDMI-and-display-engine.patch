+	n += sprintf(buf + n, "[scdc]\n");
+	data = sunxi_hdmi_scdc_read(SCDC_TMDS_CONFIG);
+	status = sunxi_hdmi_scdc_read(SCDC_SCRAMBLER_STATUS) & SCDC_SCRAMBLING_STATUS;
