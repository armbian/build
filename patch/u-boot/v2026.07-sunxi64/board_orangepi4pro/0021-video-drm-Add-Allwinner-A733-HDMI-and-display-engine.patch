+	if (priv->reg_blks[blk_id].rcq_hd) {
+		priv->reg_blks[blk_id].rcq_hd->dirty.dwval = dirty;
+	} else {
+		DRM_ERROR("rcq_head is null ! blk_id=%d\n",
+			 blk_id);
