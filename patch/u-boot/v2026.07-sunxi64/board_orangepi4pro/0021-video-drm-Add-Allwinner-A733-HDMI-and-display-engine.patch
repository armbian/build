+
+iec_params_t iec_word_length[] = {
+	{{.sample_size = 16}, 0x2},
+	{{.sample_size = 17}, 0xC},
+	{{.sample_size = 18}, 0x4},
+	{{.sample_size = 19}, 0x8},
+	{{.sample_size = 20}, 0x3},
+	{{.sample_size = 21}, 0xD},
+	{{.sample_size = 22}, 0x5},
