+#include <linux/bug.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/**
+ * struct drm_printer - drm output "stream"
+ *
+ * Do not use struct members directly.  Use drm_printer_seq_file(),
+ * drm_printer_info(), etc to initialize.  And drm_printf() for output.
+ */
+struct drm_printer {
