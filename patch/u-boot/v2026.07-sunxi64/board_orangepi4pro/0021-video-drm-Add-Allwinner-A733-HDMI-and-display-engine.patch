+int aw_phy_write(u8 addr, void *data)
+{
+	u8 *value = (u8 *)data;
+	if (!value) {
+		hdmi_err("check write point value is null\n");
+		return -1;
+	}
+	*((u8 *)((void *)aw_phy_addr + addr)) = *value;
+	return 0;
+}
