+struct fbd_u_reg {
+	union fbd_u_ctl_reg fbd_ctl;
+	union fbd_u_fmt_seq_reg fbd_fmt_seq;
+	union fbd_u_img_size_reg fbd_img_size;
+	union fbd_u_blk_size_reg fbd_blk_size;
