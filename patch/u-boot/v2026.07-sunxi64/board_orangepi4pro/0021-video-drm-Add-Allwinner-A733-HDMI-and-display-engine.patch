+// RGB/RGBA 32x8 layout3 split AFBC compress stream
+#define SUNXI_RGB_AFBC_MOD                                                             \
+	DRM_FORMAT_MOD_ARM_AFBC(AFBC_FORMAT_MOD_BLOCK_SIZE_32x8 | AFBC_FORMAT_MOD_SPARSE | \
+							AFBC_FORMAT_MOD_YTR | AFBC_FORMAT_MOD_SPLIT)
