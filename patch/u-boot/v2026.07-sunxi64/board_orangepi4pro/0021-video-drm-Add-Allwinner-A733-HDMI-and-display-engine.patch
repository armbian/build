+	union bld_colorkey_cfg0_reg colorkey_cfg0;
+	union bld_colorkey_cfg1_reg colorkey_cfg1;
+	u32 res2;
+	union bld_colorkey_max_reg colorkey_max[5];
+	u32 res3[3];
+	union bld_colorkey_min_reg colorkey_min[5];
+	u32 res4[2];
+	union bld_out_color_ctl_reg out_ctl;
+
+};
