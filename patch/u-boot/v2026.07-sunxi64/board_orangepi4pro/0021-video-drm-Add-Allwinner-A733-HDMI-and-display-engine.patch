+
+	if (ofnode_read_u32(np_to_ofnode(disp0_output_ep), "reg", &id)) {
+		DRM_ERROR("%s:Get reg fail!\n", __func__);
+		goto OUT;
+	}
+
+	DRM_INFO("[SUNXI-TCON] %s %d\n", __FUNCTION__, id);
+OUT:
+	of_node_put(tcon_in_disp0_ep);
+	of_node_put(disp0_output_ep);
+	return id;
+}
