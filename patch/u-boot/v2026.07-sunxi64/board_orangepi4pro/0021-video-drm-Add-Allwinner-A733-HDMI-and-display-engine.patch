+static struct aw_phy_params *_aw_phy_get_configs(u32 pClk, dw_color_depth_t color,
+		dw_pixel_repetition_t pixel)
+{
+	int i = 0;
+
+	for (i = 0; aw_phy[i].clock != 0; i++) {
+
+		pClk = _aw_phy_get_freq(pClk);
+
+		if ((pClk == aw_phy[i].clock) &&
+				(color == aw_phy[i].color) &&
+				(pixel == aw_phy[i].pixel)) {
+			return &(aw_phy[i]);
+		}
+	}
+	hdmi_inf("EEROR: do not get phy_config\n");
+
+	return NULL;
+}
