From e60efe5e9e3ee39af01b5e3e5b8b8ae9b709cc08 Mon Sep 17 00:00:00 2001
From: Alastair D'Silva <alastair@d-silva.org>
Date: Tue, 8 Sep 2026 11:02:10 +1000
Subject: [PATCH 19/23] board: sunxi: orangepi_4_pro: Enable Tier 1 and 2
 peripherals and board autostart

Enable all Tier 1 and Tier 2 peripherals in defconfig, configure late board init
(CCU/SPC un-gating, PMIC rails, CPU temp display), and enable board DTS nodes.

Signed-off-by: Alastair D'Silva <alastair@d-silva.org>
Assisted-by: Antigravity <antigravity@google.com>
---
 board/sunxi/board.c                           | 42 +++++++++++++++
 configs/orangepi_4_pro_defconfig              | 36 +++++++++++++
 .../allwinner/sun60i-a733-orangepi-4-pro.dts  | 51 +++++++++++++++++++
 3 files changed, 129 insertions(+)

diff --git a/board/sunxi/board.c b/board/sunxi/board.c
index f5718d1f6e6..424533dd7e0 100644
--- a/board/sunxi/board.c
+++ b/board/sunxi/board.c
@@ -50,6 +50,12 @@
 #include <spl.h>
 #include <sy8106a.h>
 #include <asm/setup.h>
+#if CONFIG_IS_ENABLED(DM_REGULATOR)
+#include <power/regulator.h>
+#endif
+#if CONFIG_IS_ENABLED(DM_THERMAL)
+#include <thermal.h>
+#endif
 
 DECLARE_GLOBAL_DATA_PTR;
 
@@ -1166,12 +1172,48 @@ int misc_init_r(void)
 	return 0;
 }
 
+#include <linux/arm-smccc.h>
+
 int board_late_init(void)
 {
 #ifdef CONFIG_USB_ETHER
 	usb_ether_init();
 #endif
 
+#if defined(CONFIG_MACH_SUN60I_A733)
+	/* Unlock Non-Secure access to CCMU clock registers and SPC ports */
+	struct arm_smccc_res smc_res;
+	int spc_idx;
+
+	/* CCMU_SEC_SWITCH_REG: unlock MBUS, BUS, PLL clock registers */
+	arm_smccc_smc(0xC000FF06, 0x02003F00, 0x00000007, 0, 0, 0, 0, 0, &smc_res);
+
+	/* SPC_SETTING_REGs: enable non-secure access to all 24 master ports */
+	for (spc_idx = 0; spc_idx <= 0x5C; spc_idx += 4)
+		arm_smccc_smc(0xC000FF06, 0x02054000 + spc_idx, 0xFFFFFFFF, 0, 0, 0, 0, 0, &smc_res);
+
+#if CONFIG_IS_ENABLED(DM_REGULATOR)
+	/* Ensure all critical PMIC rails are active */
+	struct udevice *reg;
+	regulator_autoset_by_name("vcc-pk", &reg);
+	regulator_autoset_by_name("vcc-pj", &reg);
+	regulator_autoset_by_name("vcc-1v8-audio", &reg);
+	regulator_autoset_by_name("vcc-ephy", &reg);
+	regulator_autoset_by_name("vcc-gmac-io", &reg);
+#endif
+
+#if CONFIG_IS_ENABLED(DM_THERMAL)
+	/* Read and display CPU temperature */
+	struct udevice *thermal_dev;
+	int temp;
+
+	if (!uclass_first_device_err(UCLASS_THERMAL, &thermal_dev)) {
+		if (!thermal_get_temp(thermal_dev, &temp))
+			printf("CPU Temperature: %d C\n", temp / 1000);
+	}
+#endif
+#endif
+
 	return 0;
 }
 
