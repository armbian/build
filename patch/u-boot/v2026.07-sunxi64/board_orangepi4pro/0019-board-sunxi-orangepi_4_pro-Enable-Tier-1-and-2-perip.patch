+CONFIG_REGULATOR_AXP=y
+CONFIG_CMD_I2C=y
+CONFIG_CMD_PMIC=y
+CONFIG_CMD_REGULATOR=y
+CONFIG_DM_RNG=y
+CONFIG_RNG_SUN8I_CE=y
+CONFIG_CMD_RNG=y
+CONFIG_KASLR_SEED=y
+CONFIG_DM_THERMAL=y
+CONFIG_SUN8I_THERMAL=y
+CONFIG_CMD_TEMPERATURE=y
+CONFIG_ADC=y
+CONFIG_ADC_SUN20I=y
+CONFIG_CMD_ADC=y
+CONFIG_SPI=y
+CONFIG_DM_SPI=y
