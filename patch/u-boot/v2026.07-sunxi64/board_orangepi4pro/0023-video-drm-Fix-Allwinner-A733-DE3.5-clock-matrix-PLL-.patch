--- a/configs/orangepi_4_pro_defconfig
+++ b/configs/orangepi_4_pro_defconfig
@@ -127,5 +127,5 @@ CONFIG_BMP=y
 CONFIG_BMP_16BPP=y
 CONFIG_BMP_24BPP=y
 CONFIG_BMP_32BPP=y
