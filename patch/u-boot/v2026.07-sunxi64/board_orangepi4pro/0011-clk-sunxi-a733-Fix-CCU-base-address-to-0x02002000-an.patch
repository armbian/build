From b08e450cd24bd2c46fcad9a66dcc31e836a501ed Mon Sep 17 00:00:00 2001
From: Alastair D'Silva <alastair@d-silva.org>
Date: Tue, 8 Sep 2026 11:02:08 +1000
Subject: [PATCH 11/23] clk: sunxi: a733: Fix CCU base address to 0x02002000
 and enable peripheral clocks

The Allwinner A733 (sun60iw2) CCU block is physically located at
0x02002000 (size 0x2000), rather than the legacy A523 0x02001000 base.
Update the CCU device tree node to reflect the correct base address.

In addition, add gates and resets for THS, GPADC, LRADC, CE, and SPI0/1
in clk_a733.c, and R_PWM in clk_a733_r.c.

Signed-off-by: Alastair D'Silva <alastair@d-silva.org>
Assisted-by: Antigravity <antigravity@google.com>
---
 drivers/clk/sunxi/clk_a733.c                      | 11 +++++++++++
 drivers/clk/sunxi/clk_a733_r.c                    |  3 +++
 dts/upstream/src/arm64/allwinner/sun60i-a733.dtsi |  5 +++--
 3 files changed, 17 insertions(+), 2 deletions(-)

diff --git a/drivers/clk/sunxi/clk_a733.c b/drivers/clk/sunxi/clk_a733.c
index 0f9b6c4a4ae..1b38e47514b 100644
--- a/drivers/clk/sunxi/clk_a733.c
+++ b/drivers/clk/sunxi/clk_a733.c
@@ -55,6 +55,12 @@ static struct ccu_clk_gate a733_gates[] = {
 	[CLK_USB0_DEVICE]	= GATE(0x2304, BIT(8)),
 	[CLK_USB1]		= GATE(0x230c, BIT(0)),
 	[CLK_USB1_EHCI]		= GATE(0x230c, BIT(4)),
+	[CLK_GPADC0_24M]	= GATE(0x0fc0, BIT(31)),
+	[CLK_GPADC0]		= GATE(0x0fc4, BIT(0)),
+	[CLK_THS0]		= GATE(0x0fe4, BIT(0)),
+	[CLK_LRADC]		= GATE(0x1024, BIT(0)),
+	[CLK_CE]		= GATE(0x0ac0, BIT(31)),
+	[CLK_BUS_CE]		= GATE(0x0ac4, BIT(0)),
 };
 
 static struct ccu_reset a733_resets[] = {
@@ -78,6 +84,11 @@ static struct ccu_reset a733_resets[] = {
 	[RST_BUS_SPI0]		= RESET(0x0f04, BIT(16)),
 	[RST_BUS_SPI1]		= RESET(0x0f0c, BIT(16)),
 
+	[RST_BUS_CE]		= RESET(0x0ac4, BIT(16)),
+	[RST_BUS_GPADC0]	= RESET(0x0fc4, BIT(16)),
+	[RST_BUS_THS0]		= RESET(0x0fe4, BIT(16)),
+	[RST_BUS_LRADC]		= RESET(0x1024, BIT(16)),
+
 	[RST_BUS_GMAC0]		= RESET(0x141c, BIT(16)),
 	[RST_BUS_GMAC1]		= RESET(0x142c, BIT(16)),
 
diff --git a/drivers/clk/sunxi/clk_a733_r.c b/drivers/clk/sunxi/clk_a733_r.c
index 3e396e4edd1..446a50a73b1 100644
--- a/drivers/clk/sunxi/clk_a733_r.c
+++ b/drivers/clk/sunxi/clk_a733_r.c
@@ -21,6 +21,8 @@ static struct ccu_clk_gate a733_r_gates[] = {
 	[CLK_R_TWI1]		= GATE(0x19c, BIT(1)),
 	[CLK_R_UART0]		= GATE(0x18c, BIT(0)),
 	[CLK_R_SPI]		= GATE(0x1ac, BIT(0)),
+	[CLK_R_BUS_PWM]		= GATE(0x13c, BIT(0)),
+	[CLK_R_PWM]		= GATE(0x130, BIT(31)),
 };
 
 static struct ccu_reset a733_r_resets[] = {
@@ -28,6 +30,7 @@ static struct ccu_reset a733_r_resets[] = {
 	[RST_BUS_R_TWI1]	= RESET(0x19c, BIT(17)),
 	[RST_BUS_R_UART0]	= RESET(0x18c, BIT(16)),
 	[RST_BUS_R_SPI]		= RESET(0x1ac, BIT(16)),
+	[RST_BUS_R_PWM]		= RESET(0x13c, BIT(16)),
 };
 
 const struct ccu_desc a733_r_ccu_desc = {
diff --git a/dts/upstream/src/arm64/allwinner/sun60i-a733.dtsi b/dts/upstream/src/arm64/allwinner/sun60i-a733.dtsi
index 47d34d1f79b..97284524d2b 100644
--- a/dts/upstream/src/arm64/allwinner/sun60i-a733.dtsi
+++ b/dts/upstream/src/arm64/allwinner/sun60i-a733.dtsi
@@ -156,9 +156,9 @@
 			};
 		};
 
-		ccu: clock-controller@2001000 {
+		ccu: clock-controller@2002000 {
 			compatible = "allwinner,sun60i-a733-ccu";
-			reg = <0x02001000 0x3000>;
+			reg = <0x02002000 0x2000>;
 			clocks = <&osc24M>;
 			clock-names = "hosc";
 			#clock-cells = <1>;
@@ -374,5 +374,6 @@
 			max-link-speed = <3>;
 			status = "disabled";
 		};
+
 	};
 };
-- 
2.53.0

