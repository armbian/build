From cacfbbc6cf9f98e92adfcca55d0a7dd4ca684202 Mon Sep 17 00:00:00 2001
From: Alastair D'Silva <alastair@d-silva.org>
Date: Tue, 8 Sep 2026 11:02:09 +1000
Subject: [PATCH 12/23] power: pmic: axp: Add support for AXP8191 PMIC and
 regulators

Add AXP8191 PMIC ID, compatible string ("x-powers,axp8191"), and regulator
definitions for dc1sw1, dc1sw2, bldo1, bldo2, bldo4, and dldo1.

Signed-off-by: Alastair D'Silva <alastair@d-silva.org>
Assisted-by: Antigravity <antigravity@google.com>
---
 drivers/power/pmic/axp.c                |  1 +
 drivers/power/regulator/axp_regulator.c | 11 +++++++++++
 include/axp_pmic.h                      |  1 +
 3 files changed, 13 insertions(+)

diff --git a/drivers/power/pmic/axp.c b/drivers/power/pmic/axp.c
index 7d8348b0769..8f9f215abf9 100644
--- a/drivers/power/pmic/axp.c
+++ b/drivers/power/pmic/axp.c
@@ -96,6 +96,7 @@ static const struct udevice_id axp_pmic_ids[] = {
 	{ .compatible = "x-powers,axp809", .data = AXP809_ID },
 	{ .compatible = "x-powers,axp813", .data = AXP813_ID },
 	{ .compatible = "x-powers,axp318w", .data = AXP318_ID },
+	{ .compatible = "x-powers,axp8191", .data = AXP8191_ID },
 	{ }
 };
 
diff --git a/drivers/power/regulator/axp_regulator.c b/drivers/power/regulator/axp_regulator.c
index 16d3a8f7f90..558efe91345 100644
--- a/drivers/power/regulator/axp_regulator.c
+++ b/drivers/power/regulator/axp_regulator.c
@@ -360,6 +360,16 @@ static const struct axp_regulator_plat axp813_regulators[] = {
 	{ }
 };
 
+static const struct axp_regulator_plat axp8191_regulators[] = {
+	{ "dc1sw1", 0x11, BIT(3),   NA,   NA,   NA,   NA,  NA, NA },
+	{ "dc1sw2", 0x11, BIT(4),   NA,   NA,   NA,   NA,  NA, NA },
+	{ "bldo1",  0x20, BIT(6), 0x2a, 0x1f,  500, 3500, 100, NA },
+	{ "bldo2",  0x20, BIT(7), 0x2b, 0x1f,  500, 3500, 100, NA },
+	{ "bldo4",  0x21, BIT(1), 0x2d, 0x1f,  500, 3500, 100, NA },
+	{ "dldo1",  0x21, BIT(4), 0x32, 0x1f,  500, 3500, 100, NA },
+	{ }
+};
+
 static const struct axp_regulator_plat *const axp_regulators[] = {
 	[AXP152_ID]	= axp152_regulators,
 	[AXP202_ID]	= axp20x_regulators,
@@ -374,6 +384,7 @@ static const struct axp_regulator_plat *const axp_regulators[] = {
 	[AXP806_ID]	= axp806_regulators,
 	[AXP809_ID]	= axp809_regulators,
 	[AXP813_ID]	= axp813_regulators,
+	[AXP8191_ID]	= axp8191_regulators,
 };
 
 static int axp_regulator_bind(struct udevice *dev)
diff --git a/include/axp_pmic.h b/include/axp_pmic.h
index 2f547da74c2..a024b062c17 100644
--- a/include/axp_pmic.h
+++ b/include/axp_pmic.h
@@ -40,6 +40,7 @@ enum {
 	AXP809_ID,
 	AXP813_ID,
 	AXP318_ID,
+	AXP8191_ID,
 };
 
 int axp_set_dcdc1(unsigned int mvolt);
-- 
2.53.0

