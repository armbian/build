new file mode 100644
index 00000000000..fd7f5367b75
--- /dev/null
+++ b/arch/arm/dts/rk3566-eltay-rm66-u-boot.dtsi
@@ -0,0 +1,10 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+
+#include "rk356x-u-boot.dtsi"
+
+&sfc {
+	flash@0 {
+		bootph-pre-ram;
+		bootph-some-ram;
+	};
+};
diff --git a/arch/arm/mach-rockchip/rk3568/Kconfig b/arch/arm/mach-rockchip/rk3568/Kconfig
index 2730220a18e..a303d20d6ee 100644
--- a/arch/arm/mach-rockchip/rk3568/Kconfig
+++ b/arch/arm/mach-rockchip/rk3568/Kconfig
@@ -16,6 +16,13 @@ config TARGET_ANBERNIC_RGXX3_RK3566
 	  and RG503. The correct device tree name will automatically
 	  be selected by the bootloader.
 
+config TARGET_ELTAY_RM66_RK3566
+	bool "ELRON ELTAY RM66"
+	help
+	  ELRON ELTAY RM66 compute module based on the Rockchip RK3566 SoC.
+	  The U-Boot control device tree contains only module and boot-critical
+	  hardware; Linux selects the carrier device tree separately.
+
 config TARGET_ODROID_M1_RK3568
 	bool "ODROID-M1"
 	help
@@ -72,6 +79,7 @@ config SYS_SOC
 
 source "board/rockchip/evb_rk3568/Kconfig"
 source "board/anbernic/rgxx3_rk3566/Kconfig"
+source "board/elron/eltay-rm66-rk3566/Kconfig"
 source "board/hardkernel/odroid_m1/Kconfig"
 source "board/hardkernel/odroid_m1s/Kconfig"
 source "board/pine64/quartz64_rk3566/Kconfig"
diff --git a/board/elron/eltay-rm66-rk3566/Kconfig b/board/elron/eltay-rm66-rk3566/Kconfig
new file mode 100644
index 00000000000..c007a3c2b50
--- /dev/null
+++ b/board/elron/eltay-rm66-rk3566/Kconfig
@@ -0,0 +1,12 @@
+if TARGET_ELTAY_RM66_RK3566
