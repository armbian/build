From: lukaszsobala <lsobala1@gmail.com>
Date: Sat, 3 Oct 2026 12:00:00 +0000
Subject: rk3566-orangepi-3b: boot from NVMe or SATA on the M.2 slot

combphy2 serves the M.2 slot as PCIe or as SATA. One image now boots
both. PCIe probes first. On link failure, AHCI uses the PHY in SATA mode.

Keep vcc3v3_pcie30 on: the PCIe error path otherwise switches it off.
---
 arch/arm/dts/rk3566-orangepi-3b-u-boot.dtsi | 14 ++++++++++++++
 configs/orangepi-3b-rk3566_defconfig        |  1 +
 2 files changed, 15 insertions(+)

diff --git a/arch/arm/dts/rk3566-orangepi-3b-u-boot.dtsi b/arch/arm/dts/rk3566-orangepi-3b-u-boot.dtsi
index 3c40de8..ebe6dad 100644
--- a/arch/arm/dts/rk3566-orangepi-3b-u-boot.dtsi
+++ b/arch/arm/dts/rk3566-orangepi-3b-u-boot.dtsi
@@ -18,3 +18,17 @@
 	regulator-boot-on;
 	regulator-init-microvolt = <900000>;
 };
+
+/*
+ * combphy2 serves PCIe 2.0 x1 or SATA2 on the M.2 slot. PCIe probes
+ * first. On link failure it releases the PHY, and AHCI takes it.
+ */
+&sata2 {
+	status = "okay";
+};
+
+/* PCIe disables this supply on link failure. SATA needs it on. */
+&vcc3v3_pcie30 {
+	regulator-always-on;
+	regulator-boot-on;
+};
diff --git a/configs/orangepi-3b-rk3566_defconfig b/configs/orangepi-3b-rk3566_defconfig
index 3c727b8..fb79bed 100644
--- a/configs/orangepi-3b-rk3566_defconfig
+++ b/configs/orangepi-3b-rk3566_defconfig
@@ -54,6 +54,7 @@ CONFIG_SPL_REGMAP=y
 CONFIG_SPL_SYSCON=y
 CONFIG_SCSI_AHCI=y
 CONFIG_AHCI_PCI=y
+CONFIG_DWC_AHCI=y
 CONFIG_SPL_CLK=y
 CONFIG_ROCKCHIP_GPIO=y
 CONFIG_SYS_I2C_ROCKCHIP=y
