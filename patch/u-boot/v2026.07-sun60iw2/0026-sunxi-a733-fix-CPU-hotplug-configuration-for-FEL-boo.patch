From f4e7350d7e2e7d5bfff7932bfeb2614b43e2e33f Mon Sep 17 00:00:00 2001
From: Antigravity <antigravity@google.com>
Date: Mon, 21 Sep 2026 00:00:00 +1000
Subject: [PATCH 26/29] sunxi: a733: fix CPU hotplug configuration for FEL boot

Add A733 to the list of NCAT2 SOCs that use the NCAT2-style CPUCFG
hotplug registers (SUNXI_R_CPUCFG_BASE + 0x1c0) so it can successfully
return to FEL mode after SPL execution.

Also, add A733 to the boot0.h GIC state save conditionals.

Signed-off-by: Antigravity <antigravity@google.com>
---
 arch/arm/cpu/armv8/fel_utils.S          | 4 ++--
 arch/arm/include/asm/arch-sunxi/boot0.h | 2 +-
 2 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/arch/arm/cpu/armv8/fel_utils.S b/arch/arm/cpu/armv8/fel_utils.S
index ccddfaaf04c..6034dff01dd 100644
--- a/arch/arm/cpu/armv8/fel_utils.S
+++ b/arch/arm/cpu/armv8/fel_utils.S
@@ -42,7 +42,7 @@ ENTRY(return_to_fel)
 
 	ldr	w0, =0xfa50392f		// CPU hotplug magic
 #if defined(CONFIG_MACH_SUN50I_H616) || defined(CONFIG_MACH_SUN50I_A133) || \
-    defined(CONFIG_MACH_SUN55I_A523)
+    defined(CONFIG_MACH_SUN55I_A523) || defined(CONFIG_MACH_SUN60I_A733)
 	ldr	w2, =(SUNXI_R_CPUCFG_BASE + 0x1c0)
 	str	w0, [x2], #0x4
 #elif defined(CONFIG_MACH_SUN50I_H6)
@@ -82,7 +82,7 @@ back_in_32:
 	.word	0xe590100c	// ldr	r1, [r0, #12]
 	.word	0xee011f10	// mcr	15, 0, r1, cr1, cr0, {0}  ; SCTLR
 	.word	0xf57ff06f	// isb
-#ifdef CONFIG_MACH_SUN55I_A523
+#if defined(CONFIG_MACH_SUN55I_A523) || defined(CONFIG_MACH_SUN60I_A733)
 	.word	0xe5901018	// ldr  r1, [r0, #24]
 	.word	0xee041f16	// mcr  15, 0, r1, cr4, cr6, {0}; ICC_PMR
 	.word	0xe590101c	// ldr  r1, [r0, #28]
diff --git a/arch/arm/include/asm/arch-sunxi/boot0.h b/arch/arm/include/asm/arch-sunxi/boot0.h
index d79aea97a40..76811ce6171 100644
--- a/arch/arm/include/asm/arch-sunxi/boot0.h
+++ b/arch/arm/include/asm/arch-sunxi/boot0.h
@@ -32,7 +32,7 @@
 	.word	0xe580e00c	// str     lr, [r0, #12]
 	.word	0xee1cef10	// mrc     15, 0, lr, cr12, cr0, {0}
 	.word	0xe580e010	// str     lr, [r0, #16]
-#ifdef CONFIG_MACH_SUN55I_A523
+#if defined(CONFIG_MACH_SUN55I_A523) || defined(CONFIG_MACH_SUN60I_A733)
 	.word	0xee1cefbc	// mrc     15, 0, lr, cr12, cr12, {5}
 	.word	0xe31e0001	// tst     lr, #1
 	.word	0x0a000003	// beq     cc <start32+0x48>
-- 
