+		/* Validate accumulated aperture across both swap groups */
+		u32 ret = pmu_cal_handler_select((u32)(uintptr_t)buf_a);
+		if (ret != 0)
+			return (u8)ret;
+
+		ret = pmu_cal_handler_select((u32)(uintptr_t)buf_b);
+		if (ret != 0)
+			return (u8)ret;
