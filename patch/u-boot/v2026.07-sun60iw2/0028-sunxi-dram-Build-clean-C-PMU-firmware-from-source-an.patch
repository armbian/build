+u32 pmu_dq_swap_query(u32 r0, u32 r1)
+{
+    u8 boundary = dmem_read8(PMU_DMEM_RANK_BOUNDARY);
+    u8 mask = dmem_read8(PMU_DMEM_DQ_SWAP_MASK);
+    u32 bit_val = r1 & 1;
