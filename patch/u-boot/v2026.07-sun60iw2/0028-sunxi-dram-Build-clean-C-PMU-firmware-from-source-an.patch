+        volatile u8 *entry = (volatile u8 *)(PMU_DMEM_DQ_PIN_MAP_BASE + dbyte * 18);
+        entry[0] = 0; /* Identity mapped mask */
+        entry[1] = 0; /* Remapped pin count */
