+		{ 0x0002f059, 3 },
+		{ 0x0001ffb5, 0 },
+		{ 0x0001f0b5, 1 },
+		{ 0x0001f0b3, 0 },
+		{ 0x0001f0b4, 0 },
+		{ 0x0001f0b0, 0x30 },
+		{ 0x0007f060, 1 },
+		{ 0x0007f065, 511 },
+		{ 0x0007ff26, 0 },
+		{ 0x0007ff27, 0 },
+		{ 0x0001f0b1, 386 },
+		{ 0x0001ffaa, 2048 },
+		{ 0x0001ffbe, 0 },
+		{ 0x0001f0be, 1 },
