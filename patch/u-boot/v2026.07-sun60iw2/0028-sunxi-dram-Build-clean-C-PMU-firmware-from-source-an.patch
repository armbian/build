+    u8 target_val = struct_ptr[131];
+    s32 edge = 0;
+
+    if (step_shift > 0) {
+        edge = 0;
+        if (cur_step >= 0) {
+            for (s32 k = cur_step; k >= 0; k--) {
+                u8 lower = struct_ptr[k * 2 + 0];
+                u8 upper = struct_ptr[k * 2 + 1];
+                if (upper < target_val || target_val < lower) {
+                    edge = k;
+                    break;
+                }
+            }
+        }
+    } else {
+        edge = 0;
+        if (cur_step <= 0x3f) {
+            for (s32 k = cur_step; k < 0x40; k++) {
+                u8 lower = struct_ptr[k * 2 + 0];
+                u8 upper = struct_ptr[k * 2 + 1];
+                if (upper < target_val || target_val < lower) {
+                    edge = k;
+                    break;
+                }
