+				s32 delta = (s8)pin_ptr[130] - (s8)target_buf[130];
+				ret = pmu_window_margin_diff_calc(target_buf, pin_ptr, target_buf, delta, 0);
+				if (ret != 0)
+					return (u8)ret;
+			}
+		}
