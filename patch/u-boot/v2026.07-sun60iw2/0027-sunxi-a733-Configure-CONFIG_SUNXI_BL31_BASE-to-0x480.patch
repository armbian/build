From da2ce83b0e9804295079bf0f81c6101d28325aed Mon Sep 17 00:00:00 2001
From: Alastair D'Silva <alastair@d-silva.org>
Date: Sun, 27 Sep 2026 17:39:53 +1000
Subject: [PATCH 27/29] sunxi: a733: Configure CONFIG_SUNXI_BL31_BASE to
 0x48000000 for A733 TF-A

---
 arch/arm/mach-sunxi/Kconfig | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/arch/arm/mach-sunxi/Kconfig b/arch/arm/mach-sunxi/Kconfig
index 4875253f1b6..db8d83fa389 100644
--- a/arch/arm/mach-sunxi/Kconfig
+++ b/arch/arm/mach-sunxi/Kconfig
@@ -269,7 +269,8 @@ config SUNXI_BL31_BASE
 	default 0x00044000 if MACH_SUN50I || MACH_SUN50I_H5
 	default 0x40000000 if MACH_SUN50I_H616
 	default 0x00104000 if SUN50I_GEN_H6
-	default 0x00054000 if MACH_SUN55I_A523 || MACH_SUN60I_A733
+	default 0x48000000 if MACH_SUN60I_A733
+	default 0x00054000 if MACH_SUN55I_A523
 	default 0x0
 	help
 	  Address where BL31 (TF-A) is loaded, or zero if BL31 is not used.
-- 
2.53.0

