rockchip: start RockUSB with UMS fallback on the Lyra Ultra USER key

Recognize the RK3506 ADC node by compatible. Schedule RockUSB through
preboot instead of resetting, then try UMS when the command sequence
continues after RockUSB returns. Ctrl-C may abort the sequence; UMS is
also available manually with ums 0 mmc 0.

diff --git a/arch/arm/mach-rockchip/boot_mode.c b/arch/arm/mach-rockchip/boot_mode.c
--- a/arch/arm/mach-rockchip/boot_mode.c
+++ b/arch/arm/mach-rockchip/boot_mode.c
@@ -51,7 +51,8 @@
 
 	ret = -ENODEV;
 	uclass_foreach_dev(dev, uc) {
-		if (!strncmp(dev->name, "saradc", 6)) {
+		if (!strncmp(dev->name, "saradc", 6) ||
+		    device_is_compatible(dev, "rockchip,rk3506-saradc")) {
 			ret = adc_channel_single_shot(dev->name, 1, &val);
 			break;
 		}
@@ -88,7 +89,10 @@
 	void *reg = (void *)CONFIG_ROCKCHIP_BOOT_MODE_REG;
 	int boot_mode = readl(reg);
 
-	rockchip_dnl_mode_check();
+	if (rockchip_dnl_key_pressed()) {
+		writel(BOOT_NORMAL, reg);
+		return env_set("preboot", "setenv preboot; rockusb 0 mmc 0; ums 0 mmc 0");
+	}
 
 	boot_mode = readl(reg);
 	debug("%s: boot mode 0x%08x\n", __func__, boot_mode);
