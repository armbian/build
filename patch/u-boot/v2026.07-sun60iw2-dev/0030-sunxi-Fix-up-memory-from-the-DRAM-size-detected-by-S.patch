From 8a2a190b5024f8125d9d823ce1fdb956792e4e0c Mon Sep 17 00:00:00 2001
From: Juanesf <juanesf91@users.noreply.github.com>
Date: Sun, 8 Nov 2026 18:44:51 -0300
Subject: [PATCH] sunxi: Fix up /memory from the DRAM size detected by SPL

Boards such as the Allwinner A733 family are shipped with different
amounts of LPDDR5. Add an optional Kconfig option that replaces the
/memory node of the control device tree with the size detected by the
SPL, so that a single device tree can be used for all memory variants.

Signed-off-by: Juanesf <juanesf91@users.noreply.github.com>
---
 arch/arm/mach-sunxi/Kconfig | 9 +++++++++
 board/sunxi/board.c         | 4 ++++
 2 files changed, 13 insertions(+)

diff --git a/arch/arm/mach-sunxi/Kconfig b/arch/arm/mach-sunxi/Kconfig
index e173d914..fa009a27 100644
--- a/arch/arm/mach-sunxi/Kconfig
+++ b/arch/arm/mach-sunxi/Kconfig
@@ -1405,6 +1405,15 @@ config SPL_SUNXI_LED_STATUS_ACTIVE_HIGH
 
 endif # SPL_SUNXI_LED_STATUS
 
+config SUNXI_FDT_FIXUP_MEMORY
+	bool "Fix up the /memory node from the detected DRAM size"
+	depends on OF_BOARD_SETUP
+	help
+	  Replace the /memory node of the control device tree with the DRAM
+	  size detected by the SPL. This allows a single device tree to be
+	  used on boards that are shipped with different memory sizes, such
+	  as the Allwinner A733 boards.
+
 source "board/sunxi/Kconfig"
 
 endif
diff --git a/board/sunxi/board.c b/board/sunxi/board.c
index 94c7a696..4007264f 100644
--- a/board/sunxi/board.c
+++ b/board/sunxi/board.c
@@ -1344,6 +1344,10 @@ int ft_board_setup(void *blob, struct bd_info *bd)
 	bluetooth_dt_fixup(blob);
 	board_dt_fixup(blob);
 
+#ifdef CONFIG_SUNXI_FDT_FIXUP_MEMORY
+	fdt_fixup_memory(blob, PHYS_SDRAM_0, gd->ram_size);
+#endif
+
 #ifdef CONFIG_VIDEO_DT_SIMPLEFB
 	r = sunxi_simplefb_setup(blob);
 	if (r)
-- 
2.53.0

