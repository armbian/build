From 6aef718a19fccc815d1d1b3cd56cc6ff75dd33ed Mon Sep 17 00:00:00 2001
From: Alastair D'Silva <alastair@d-silva.org>
Date: Tue, 8 Sep 2026 11:02:09 +1000
Subject: [PATCH 19/29] rng: sun8i_ce: Add Allwinner Crypto Engine (CE) TRNG
 driver

Add UCLASS_RNG driver for the hardware True Random Number Generator (TRNG)
in the Allwinner Crypto Engine. Use the CE v5 protocol on A523 and A733.
Keep the Linux H616 layout and control sequence on H616.

Signed-off-by: Alastair D'Silva <alastair@d-silva.org>
Assisted-by: Antigravity <antigravity@google.com>
---
 drivers/rng/Kconfig                           |   7 +
 drivers/rng/Makefile                          |   1 +
 drivers/rng/sun8i_ce_rng.c                    | 354 ++++++++++++++++++++++
 .../src/arm64/allwinner/sun60i-a733.dtsi      | 12 ++
 4 files changed, 374 insertions(+)
 create mode 100644 drivers/rng/sun8i_ce_rng.c

diff --git a/drivers/rng/Kconfig b/drivers/rng/Kconfig
index 19b2b707677..b62fd02ab9c 100644
--- a/drivers/rng/Kconfig
+++ b/drivers/rng/Kconfig
@@ -133,4 +133,11 @@ config RNG_EXYNOS
 	  case the LDFW (Loadable Firmware) has to be loaded first, as it
 	  actually implements TRNG SMC calls.
 
+config RNG_SUN8I_CE
+	bool "Allwinner Crypto Engine TRNG support"
+	depends on DM_RNG && ARCH_SUNXI
+	help
+	  Enable support for True Random Number Generator (TRNG) in the
+	  Allwinner Crypto Engine (CE) on H616, A523 and A733. CE v5 is used on A523 and A733.
+
 endif
diff --git a/drivers/rng/Makefile b/drivers/rng/Makefile
index 30c58272d41..8fe66e1a43c 100644
--- a/drivers/rng/Makefile
+++ b/drivers/rng/Makefile
@@ -19,3 +19,4 @@ obj-$(CONFIG_TPM_RNG) += tpm_rng.o
 obj-$(CONFIG_RNG_JH7110) += jh7110_rng.o
 obj-$(CONFIG_RNG_TURRIS_RWTM) += turris_rwtm_rng.o
 obj-$(CONFIG_RNG_EXYNOS) += exynos-trng.o
+obj-$(CONFIG_RNG_SUN8I_CE) += sun8i_ce_rng.o
diff --git a/drivers/rng/sun8i_ce_rng.c b/drivers/rng/sun8i_ce_rng.c
new file mode 100644
index 00000000000..3d8d0269853
--- /dev/null
+++ b/drivers/rng/sun8i_ce_rng.c
@@ -0,0 +1,354 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Copyright (C) 2026 Antigravity
+ * Allwinner Crypto Engine (CE) TRNG driver for U-Boot (UCLASS_RNG)
+ */
+
+#include <errno.h>
+#include <log.h>
+#include <linux/types.h>
+#include <clk.h>
+#include <dm.h>
+#include <dm/device_compat.h>
+#include <linux/bitops.h>
+#include <linux/build_bug.h>
+#include <rng.h>
+#include <reset.h>
+#include <asm/cache.h>
+#include <asm/io.h>
+#include <linux/delay.h>
+#include <time.h>
+
+/* Legacy CE registers and descriptor, used on H616. */
+#define CE_TDQ			0x00
+#define CE_CTR			0x04
+#define CE_ICR			0x08
+#define CE_ISR			0x0c
+#define CE_TLR			0x10
+#define CE_ESR			0x18
+
+#define CE_ALG_TRNG_V2		0x1c
+#define CE_COMM_INT		BIT(31)
+
+#define CE_RNG_FLOW		3
+#define CE_ESR_FLOW_SHIFT(flow)	((flow) * 8)
+
+#define CE_MAX_SG 8
+
+struct ce_sg {
+	u32 addr;
+	u32 len;
+} __packed;
+
+struct ce_task {
+	u32 t_id;
+	u32 t_common_ctl;
+	u32 t_sym_ctl;
+	u32 t_asym_ctl;
+	u32 t_key;
+	u32 t_iv;
+	u32 t_ctr;
+	u32 t_dlen;
+	struct ce_sg t_src[CE_MAX_SG];
+	struct ce_sg t_dst[CE_MAX_SG];
+	u32 next;
+	u32 reserved[3];
+} __packed __aligned(64);
+
+/* CE v5 registers and descriptor, used on A523 and A733. */
+#define CE_REG_TSK1		0x04
+#define CE_REG_ERR		0x18
+#define CE_REG_LPC		0xd0
+
+#define CE_V5_RNG_FLOW		2
+#define CE_V5_ISR_FLOW_MASK(flow) (GENMASK(1, 0) << ((flow) * 2))
+#define CE_V5_ICR_FLOW_EN(flow)	BIT(flow)
+#define CE_V5_ERR_FLOW_MASK(flow) (GENMASK(7, 0) << ((flow) * 8))
+#define CE_V5_TLR_HASH_RBG_START BIT(10)
+
+#define CE_V5_COMM_LPKG		BIT(12)
+#define CE_V5_COMM_IE		BIT(16)
+#define CE_V5_CMD_HASH_SHA256	3
+#define CE_V5_CMD_RNG_TRNG	2
+#define CE_V5_CMD_RNG_SHIFT	8
+
+#define CE_V5_CHUNK_BYTES	32
+#define CE_V5_TIMEOUT_MS	100
+
+struct ce_v5_sg {
+	u8 src_addr[5];
+	u8 dst_addr[5];
+	u8 pad[2];
+	u32 src_len;
+	u32 dst_len;
+} __packed;
+
+struct ce_v5_task {
+	u32 comm_ctl;
+	u32 main_cmd;
+	u8 data_len[5];
+	u8 key_addr[5];
+	u8 iv_addr[5];
+	u8 pad;
+	struct ce_v5_sg sg[CE_MAX_SG];
+	u8 next_sg_addr[5];
+	u8 next_task_addr[5];
+	u8 pad2[2];
+	u32 reserved[3];
+} __packed;
+
+static_assert(sizeof(struct ce_v5_sg) == 20);
+static_assert(sizeof(struct ce_v5_task) == 208);
+
+struct sun8i_ce_rng_data {
+	bool ce_v5;
+	bool has_lpc;
+};
+
+struct sun8i_ce_rng_priv {
+	void __iomem *base;
+	struct clk bus_clk;
+	struct clk mod_clk;
+	struct clk ram_clk;
+	struct clk trng_clk;
+	struct reset_ctl reset;
+	const struct sun8i_ce_rng_data *data;
+	union {
+		struct ce_task legacy;
+		struct ce_v5_task v5;
+	} task;
+};
+
+static void ce_v5_set_addr40(u8 dst[5], u64 addr)
+{
+	dst[0] = addr & 0xff;
+	dst[1] = (addr >> 8) & 0xff;
+	dst[2] = (addr >> 16) & 0xff;
+	dst[3] = (addr >> 24) & 0xff;
+	dst[4] = (addr >> 32) & 0xff;
+}
+
+static int sun8i_ce_rng_read_h616(struct udevice *dev,
+				  struct sun8i_ce_rng_priv *priv,
+				  void *data, size_t len)
+{
+	u8 *dst = data;
+	static u8 rng_buf[64] __aligned(64);
+
+	while (len > 0) {
+		size_t chunk = min_t(size_t, len, 32);
+		ulong start;
+		u32 esr;
+		/* H616 CE encodes DMA addresses in words. */
+		u32 task_addr = (u32)(uintptr_t)&priv->task.legacy / 4;
+		u32 buf_addr = (u32)(uintptr_t)rng_buf / 4;
+
+		memset(&priv->task.legacy, 0, sizeof(priv->task.legacy));
+		priv->task.legacy.t_id = CE_RNG_FLOW;
+		priv->task.legacy.t_common_ctl = CE_ALG_TRNG_V2 | CE_COMM_INT;
+		priv->task.legacy.t_dlen = 32; /* 32 bytes */
+		priv->task.legacy.t_dst[0].addr = buf_addr;
+		priv->task.legacy.t_dst[0].len = 32 / 4; /* word count */
+
+		/* Flush cache */
+		flush_dcache_range((uintptr_t)&priv->task.legacy,
+				   (uintptr_t)&priv->task.legacy +
+				   sizeof(priv->task.legacy));
+		invalidate_dcache_range((uintptr_t)rng_buf,
+					(uintptr_t)rng_buf + 64);
+
+		/* Clear TRNG flow interrupt status */
+		writel(BIT(CE_RNG_FLOW), priv->base + CE_ISR);
+
+		/* Set task descriptor queue address */
+		writel(task_addr, priv->base + CE_TDQ);
+
+		/* Enable task: TLR = 1 | (common_ctl & 0x7f) << 8 */
+		writel(1 | ((CE_ALG_TRNG_V2 & 0x7f) << 8), priv->base + CE_TLR);
+
+		/* Poll for completion */
+		start = get_timer(0);
+		while (!(readl(priv->base + CE_ISR) & BIT(CE_RNG_FLOW))) {
+			if (get_timer(start) > 50) { /* 50ms timeout */
+				writel(0, priv->base + CE_TLR);
+				return -ETIMEDOUT;
+			}
+			udelay(10);
+		}
+
+		/* Clear interrupt */
+		writel(BIT(CE_RNG_FLOW), priv->base + CE_ISR);
+
+		/* Reject a failed task before using its output. */
+		esr = readl(priv->base + CE_ESR) >> CE_ESR_FLOW_SHIFT(CE_RNG_FLOW);
+		esr &= 0xff;
+		if (esr) {
+			dev_err(dev, "CE error status: 0x%x\n", esr);
+			return -EIO;
+		}
+
+		invalidate_dcache_range((uintptr_t)rng_buf,
+					(uintptr_t)rng_buf + 64);
+
+		memcpy(dst, rng_buf, chunk);
+		dst += chunk;
+		len -= chunk;
+	}
+
+	return 0;
+}
+
+static int sun8i_ce_rng_read_v5(struct udevice *dev,
+				struct sun8i_ce_rng_priv *priv,
+				void *data, size_t len)
+{
+	u8 *dst = data;
+	static u8 rng_buf[64] __aligned(64);
+	u32 isr_mask = CE_V5_ISR_FLOW_MASK(CE_V5_RNG_FLOW);
+	u32 icr_en = CE_V5_ICR_FLOW_EN(CE_V5_RNG_FLOW);
+
+	while (len > 0) {
+		size_t chunk = min_t(size_t, len, CE_V5_CHUNK_BYTES);
+		struct ce_v5_task *task = &priv->task.v5;
+		u64 task_addr = (u64)(uintptr_t)task;
+		u64 buf_addr = (u64)(uintptr_t)rng_buf;
+		u32 esr;
+		ulong start;
+
+		memset(task, 0, sizeof(*task));
+		task->comm_ctl = CE_V5_RNG_FLOW | CE_V5_COMM_LPKG |
+				 CE_V5_COMM_IE;
+		task->main_cmd = CE_V5_CMD_HASH_SHA256 |
+				 (CE_V5_CMD_RNG_TRNG << CE_V5_CMD_RNG_SHIFT);
+		ce_v5_set_addr40(task->sg[0].dst_addr, buf_addr);
+		task->sg[0].dst_len = CE_V5_CHUNK_BYTES;
+
+		flush_dcache_range((uintptr_t)task,
+				   (uintptr_t)&priv->task +
+				   sizeof(priv->task));
+		flush_dcache_range((uintptr_t)rng_buf,
+				   (uintptr_t)rng_buf + 64);
+
+		writel(isr_mask, priv->base + CE_ISR);
+		writel(readl(priv->base + CE_ICR) | icr_en, priv->base + CE_ICR);
+		writel((u32)task_addr, priv->base + CE_TDQ);
+		writel((u32)(task_addr >> 32), priv->base + CE_REG_TSK1);
+		writel(CE_V5_TLR_HASH_RBG_START, priv->base + CE_TLR);
+
+		start = get_timer(0);
+		while (!(readl(priv->base + CE_ISR) & isr_mask)) {
+			if (get_timer(start) > CE_V5_TIMEOUT_MS) {
+				writel(readl(priv->base + CE_ICR) & ~icr_en,
+				       priv->base + CE_ICR);
+				writel(0, priv->base + CE_TLR);
+				writel(0, priv->base + CE_TDQ);
+				writel(0, priv->base + CE_REG_TSK1);
+				return -ETIMEDOUT;
+			}
+			udelay(10);
+		}
+
+		writel(readl(priv->base + CE_ICR) & ~icr_en,
+		       priv->base + CE_ICR);
+
+		esr = readl(priv->base + CE_REG_ERR) &
+		      CE_V5_ERR_FLOW_MASK(CE_V5_RNG_FLOW);
+		if (esr) {
+			dev_err(dev, "CE v5 error status: 0x%x\n", esr);
+			return -EIO;
+		}
+
+		invalidate_dcache_range((uintptr_t)rng_buf,
+					(uintptr_t)rng_buf + 64);
+
+		memcpy(dst, rng_buf, chunk);
+		dst += chunk;
+		len -= chunk;
+	}
+
+	return 0;
+}
+
+static int sun8i_ce_rng_read(struct udevice *dev, void *data, size_t len)
+{
+	struct sun8i_ce_rng_priv *priv = dev_get_priv(dev);
+
+	if (priv->data->ce_v5)
+		return sun8i_ce_rng_read_v5(dev, priv, data, len);
+
+	return sun8i_ce_rng_read_h616(dev, priv, data, len);
+}
+
+static int sun8i_ce_rng_probe(struct udevice *dev)
+{
+	struct sun8i_ce_rng_priv *priv = dev_get_priv(dev);
+	int ret;
+
+	priv->data = (void *)dev_get_driver_data(dev);
+	if (!priv->data)
+		return -EINVAL;
+
+	priv->base = dev_read_addr_ptr(dev);
+	if (!priv->base)
+		return -EINVAL;
+
+	ret = clk_get_by_name(dev, "bus", &priv->bus_clk);
+	if (!ret)
+		clk_enable(&priv->bus_clk);
+
+	ret = clk_get_by_name(dev, "mod", &priv->mod_clk);
+	if (!ret)
+		clk_enable(&priv->mod_clk);
+
+	ret = clk_get_by_name(dev, "ram", &priv->ram_clk);
+	if (!ret)
+		clk_enable(&priv->ram_clk);
+
+	ret = clk_get_by_name(dev, "trng", &priv->trng_clk);
+	if (!ret)
+		clk_enable(&priv->trng_clk);
+
+	ret = reset_get_by_index(dev, 0, &priv->reset);
+	if (!ret)
+		reset_deassert(&priv->reset);
+
+	if (priv->data->has_lpc)
+		writel(readl(priv->base + CE_REG_LPC) | BIT(1),
+		       priv->base + CE_REG_LPC);
+
+	return 0;
+}
+
+static const struct dm_rng_ops sun8i_ce_rng_ops = {
+	.read = sun8i_ce_rng_read,
+};
+
+static const struct sun8i_ce_rng_data sun8i_ce_rng_a733_data = {
+	.ce_v5 = true,
+	.has_lpc = true,
+};
+
+static const struct sun8i_ce_rng_data sun8i_ce_rng_a523_data = {
+	.ce_v5 = true,
+};
+
+static const struct sun8i_ce_rng_data sun8i_ce_rng_h616_data = { };
+
+static const struct udevice_id sun8i_ce_rng_ids[] = {
+	{ .compatible = "allwinner,sun60i-a733-crypto",
+	  .data = (ulong)&sun8i_ce_rng_a733_data },
+	{ .compatible = "allwinner,sun55i-a523-crypto",
+	  .data = (ulong)&sun8i_ce_rng_a523_data },
+	{ .compatible = "allwinner,sun50i-h616-crypto",
+	  .data = (ulong)&sun8i_ce_rng_h616_data },
+	{ }
+};
+
+U_BOOT_DRIVER(sun8i_ce_rng) = {
+	.name      = "sun8i_ce_rng",
+	.id        = UCLASS_RNG,
+	.of_match  = sun8i_ce_rng_ids,
+	.ops       = &sun8i_ce_rng_ops,
+	.probe     = sun8i_ce_rng_probe,
+	.priv_auto = sizeof(struct sun8i_ce_rng_priv),
+};
diff --git a/dts/upstream/src/arm64/allwinner/sun60i-a733.dtsi b/dts/upstream/src/arm64/allwinner/sun60i-a733.dtsi
index 18360f945d5..891c2842c50 100644
--- a/dts/upstream/src/arm64/allwinner/sun60i-a733.dtsi
+++ b/dts/upstream/src/arm64/allwinner/sun60i-a733.dtsi
@@ -423,5 +423,17 @@
 			status = "disabled";
 		};
 
+		ce: crypto@4603000 {
+			compatible = "allwinner,sun60i-a733-crypto",
+				     "allwinner,sun55i-a523-crypto";
+			reg = <0x04603000 0x1000>;
+			interrupts = <GIC_SPI 168 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&ccu CLK_BUS_CE>, <&ccu CLK_CE>,
+				 <&ccu CLK_MBUS_CE>, <&ccu CLK_CE_SYS>;
+			clock-names = "bus", "mod", "ram", "trng";
+			resets = <&ccu RST_BUS_CE>;
+			status = "disabled";
+		};
+
 	};
 };
