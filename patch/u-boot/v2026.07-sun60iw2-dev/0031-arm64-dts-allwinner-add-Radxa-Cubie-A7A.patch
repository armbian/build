From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Juanesf <juanesf91@users.noreply.github.com>
Date: Sun, 9 Nov 2026 00:00:00 +0000
Subject: [PATCH] arm64: dts: allwinner: add Radxa Cubie A7A defconfig

Add the U-Boot defconfig for the Radxa Cubie A7A (Allwinner A733).

Signed-off-by: Juanesf <juanesf91@users.noreply.github.com>
---
diff --git a/configs/radxa_cubie_a7a_defconfig b/configs/radxa_cubie_a7a_defconfig
new file mode 100644
index 00000000..0783172d
--- /dev/null
+++ b/configs/radxa_cubie_a7a_defconfig
@@ -0,0 +1,111 @@
+CONFIG_ARM=y
+CONFIG_ARCH_SUNXI=y
+CONFIG_DEFAULT_DEVICE_TREE="allwinner/sun60i-a733-radxa-a7a"
+CONFIG_SPL=y
+CONFIG_ARMV8_SPL_EXCEPTION_VECTORS=y
+CONFIG_SPL_SPI_SUNXI=y
+CONFIG_SPL_MAX_SIZE=0x48000
+CONFIG_SPL_STACK=0x98000
+CONFIG_MACH_SUN60I_A733=y
+CONFIG_SUNXI_DRAM_A733_LPDDR5=y
+CONFIG_DRAM_SUNXI_DX_ODT=0x07070707
+CONFIG_DRAM_SUNXI_DX_DRI=0x0d0d0d0d
+CONFIG_DRAM_SUNXI_CA_DRI=0x0e0e
+CONFIG_DRAM_SUNXI_ODT_EN=0x84848484
+CONFIG_DRAM_SUNXI_TPR0=0x80808080
+CONFIG_DRAM_SUNXI_TPR1=0x06060606
+CONFIG_DRAM_SUNXI_TPR2=0x5f090503
+CONFIG_DRAM_SUNXI_TPR3=0x0
+CONFIG_DRAM_SUNXI_TPR6=0x38000000
+CONFIG_DRAM_SUNXI_TPR10=0x802f3333
+CONFIG_DRAM_SUNXI_TPR11=0xc6c4c2c0
+CONFIG_DRAM_SUNXI_TPR12=0x3a373233
+CONFIG_DRAM_SUNXI_TPR13=0x0
+CONFIG_DRAM_SUNXI_TPR14=0x0
+CONFIG_SUNXI_FDT_FIXUP_MEMORY=y
+CONFIG_MMC_SUNXI_SLOT_EXTRA=2
+CONFIG_SUPPORT_EMMC_BOOT=y
+CONFIG_R_I2C_ENABLE=y
+CONFIG_SPL_I2C=y
+CONFIG_SPL_SYS_I2C_LEGACY=y
+CONFIG_SYS_I2C_MVTWSI=y
+CONFIG_SYS_I2C_SLAVE=0x7f
+CONFIG_SYS_I2C_SPEED=400000
+CONFIG_USB=y
+CONFIG_DM_USB=y
+CONFIG_USB_STORAGE=y
+CONFIG_USB_KEYBOARD=y
+CONFIG_USB_HOST=y
+CONFIG_USB_EHCI_HCD=y
+CONFIG_USB_EHCI_GENERIC=y
+CONFIG_USB_OHCI_HCD=y
+CONFIG_USB_OHCI_GENERIC=y
+CONFIG_USB_XHCI_HCD=y
+CONFIG_USB_XHCI_DWC3=y
+CONFIG_USB_DWC3=y
+CONFIG_USB_DWC3_GENERIC=y
+CONFIG_PHY_SUN4I_USB=y
+CONFIG_DM_REGULATOR=y
+CONFIG_DM_REGULATOR_FIXED=y
+CONFIG_CMD_USB=y
+CONFIG_DM_MDIO=y
+CONFIG_DM_ETH_PHY=y
+CONFIG_DWC_ETH_QOS=y
+CONFIG_DWC_ETH_QOS_SUNXI=y
+CONFIG_RGMII=y
+CONFIG_PHY_MOTORCOMM=y
+CONFIG_PHY_GIGE=y
+CONFIG_CMD_MII=y
+CONFIG_CMD_MDIO=y
+CONFIG_CMD_PING=y
+CONFIG_CMD_DHCP=y
+CONFIG_NET_RANDOM_ETHADDR=y
+CONFIG_CMD_PART=y
+CONFIG_DOS_PARTITION=y
+CONFIG_EFI_PARTITION=y
+CONFIG_PARTITION_UUIDS=y
+CONFIG_CMD_FAT=y
+CONFIG_CMD_EXT4=y
+CONFIG_FS_FAT=y
+CONFIG_FS_EXT4=y
+CONFIG_PCI=y
+CONFIG_DM_PCI=y
+CONFIG_PCIE_DW_SUNXI=y
+CONFIG_NVME=y
+CONFIG_NVME_PCI=y
+CONFIG_CMD_PCI=y
+CONFIG_CMD_NVME=y
+CONFIG_DM_I2C=y
+CONFIG_CMD_I2C=y
+CONFIG_DM_THERMAL=y
+CONFIG_SUN8I_THERMAL=y
+CONFIG_CMD_TEMPERATURE=y
+CONFIG_ADC=y
+CONFIG_ADC_SUN20I=y
+CONFIG_CMD_ADC=y
+CONFIG_SPI=y
