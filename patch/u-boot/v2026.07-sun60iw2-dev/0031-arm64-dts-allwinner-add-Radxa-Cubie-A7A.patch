diff --git a/dts/upstream/src/arm64/allwinner/sun60i-a733-radxa-a7a.dts b/dts/upstream/src/arm64/allwinner/sun60i-a733-radxa-a7a.dts
new file mode 100644
index 00000000..f17f32a0
--- /dev/null
+++ b/dts/upstream/src/arm64/allwinner/sun60i-a733-radxa-a7a.dts
@@ -0,0 +1,231 @@
+// SPDX-License-Identifier: (GPL-2.0-only OR MIT)
+/*
+ * Copyright (C) 2026 Radxa Computer Co., Ltd.
+ */
+
+/dts-v1/;
+
+#include "sun60i-a733.dtsi"
+
+#include <dt-bindings/gpio/gpio.h>
+
+/ {
+	model = "Radxa Cubie A7A";
+	compatible = "radxa,cubie-a7a", "allwinner,sun60i-a733";
+
+	aliases {
+		ethernet0 = &gmac0;
+		serial0 = &uart0;
+		mmc0 = &mmc0;
+		mmc2 = &mmc2;
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+	};
+
+	reg_vcc5v: vcc5v {
+		/* board wide 5V supply from the USB-C connector */
+		compatible = "regulator-fixed";
+		regulator-name = "vcc-5v";
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+		regulator-always-on;
+	};
+
+	reg_usb0_vbus: usb0-vbus {
+		compatible = "regulator-fixed";
+		regulator-name = "usb0-vbus";
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+		vin-supply = <&reg_vcc5v>;
+		gpio = <&r_pio 0 2 GPIO_ACTIVE_HIGH>;	/* PL2 */
+		enable-active-high;
+	};
+
+	reg_usb1_vbus: usb1-vbus {
+		compatible = "regulator-fixed";
+		regulator-name = "usb1-vbus";
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+		vin-supply = <&reg_vcc5v>;
+		gpio = <&r_pio 1 5 GPIO_ACTIVE_HIGH>;	/* PM5 */
+		enable-active-high;
+	};
+};
+
+&pio {
+	uart0_a7a_pins: uart0-a7a-pins {
+		pins = "PB9", "PB10";
+		function = "uart0";
+		allwinner,pinmux = <2>;
+	};
+
+	mmc2_a7a_pins: mmc2-a7a-pins {
+		pins = "PC0", "PC1", "PC5", "PC6", "PC8",
+		       "PC9", "PC10", "PC11", "PC13", "PC14",
+		       "PC15", "PC16";
+		function = "mmc2";
+		allwinner,pinmux = <3>;
+		drive-strength = <30>;
+		bias-pull-up;
+	};
+};
+
+&uart0 {
+	clock-frequency = <24000000>;
+	status = "okay";
+};
+
+&mmc0 {
+	pinctrl-0 = <&mmc0_pins>;
+	cd-gpios = <&pio 5 6 GPIO_ACTIVE_LOW>;	/* PF6 */
+	broken-cd;
+	bus-width = <4>;
+	status = "okay";
+};
+
+&mmc2 {
+	pinctrl-0 = <&mmc2_a7a_pins>;
+	bus-width = <8>;
+	non-removable;
+	status = "okay";
+};
+
+&r_i2c0 {
+	status = "okay";
+
+	axp318w: pmic@36 {
+		compatible = "x-powers,axp318w";
+		reg = <0x36>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		regulators {
+			reg_dcdc1: dcdc1 {
+				regulator-name = "vcc-3v3";
+				regulator-min-microvolt = <3300000>;
+				regulator-max-microvolt = <3300000>;
+				regulator-always-on;
+				regulator-boot-on;
+			};
+
+			reg_aldo1: aldo1 {
+				regulator-name = "vcc-pl-pm";
+				regulator-min-microvolt = <3300000>;
+				regulator-max-microvolt = <3300000>;
+				regulator-always-on;
+				regulator-boot-on;
+			};
+
+			reg_aldo5: aldo5 {
+				regulator-name = "vcc-emmc";
+				regulator-min-microvolt = <3300000>;
+				regulator-max-microvolt = <3300000>;
+				regulator-always-on;
+				regulator-boot-on;
+			};
+
+			reg_bldo1: bldo1 {
+				regulator-name = "vcc-1v8-pe-pcie";
+				regulator-min-microvolt = <1800000>;
+				regulator-max-microvolt = <1800000>;
+				regulator-always-on;
+				regulator-boot-on;
+			};
+
+			reg_swout1: swout1 {
+				regulator-name = "vcc-3v3-usb-lcd";
+				regulator-always-on;
+				regulator-boot-on;
+			};
+
+			reg_swout2: swout2 {
+				regulator-name = "vcc-3v3-card";
+				regulator-always-on;
+				regulator-boot-on;
+			};
+
+			reg_cldo5: cldo5 {
+				regulator-name = "vcc-1v8-pc-pf";
+				regulator-min-microvolt = <1800000>;
+				regulator-max-microvolt = <1800000>;
+				regulator-always-on;
+				regulator-boot-on;
+			};
+		};
+	};
+};
+
+&gmac0 {
+	pinctrl-0 = <&gmac0_pins>;
+	phy-mode = "rgmii-id";
+	phy-handle = <&phy0>;
+	snps,reset-gpio = <&pio 7 16 GPIO_ACTIVE_LOW>;	/* PH16 */
+	snps,reset-delays-us = <0 10000 150000>;
+	tx-internal-delay-ps = <1200>;
+	rx-internal-delay-ps = <1000>;
+	status = "okay";
+
+	mdio0: mdio {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		phy0: ethernet-phy@1 {
+			compatible = "ethernet-phy-id7b74.4412",
+				     "ethernet-phy-ieee802.3-c22";
+			reg = <1>;
+		};
+	};
+};
+
+&usbphy {
+	usb0_vbus-supply = <&reg_usb0_vbus>;
+	usb1_vbus-supply = <&reg_usb0_vbus>;
+	status = "okay";
+};
+
+&ehci0 {
+	vbus-supply = <&reg_usb0_vbus>;
+	status = "okay";
+};
+
+&ohci0 {
+	vbus-supply = <&reg_usb0_vbus>;
+	status = "okay";
+};
+
+&ehci1 {
+	vbus-supply = <&reg_usb0_vbus>;
+	status = "okay";
+};
+
+&ohci1 {
+	vbus-supply = <&reg_usb0_vbus>;
+	status = "okay";
+};
+
+&dwc3 {
+	dr_mode = "host";
+	vbus-supply = <&reg_usb1_vbus>;
+	status = "okay";
+};
+
+&pcie_rc {
+	power-gpios = <&pio 4 11 GPIO_ACTIVE_HIGH>;	/* PE11 */
+	reset-gpios = <&pio 4 13 GPIO_ACTIVE_HIGH>;	/* PE13 */
+	wake-gpios = <&pio 4 12 GPIO_ACTIVE_HIGH>;	/* PE12 */
+	status = "okay";
+};
+
+&spi0 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&spi0_pc_pins>;
+	status = "okay";
+
+	flash@0 {
+		compatible = "jedec,spi-nor";
+		reg = <0>;
+		spi-max-frequency = <50000000>;
+	};
+};
-- 
2.53.0

