Subject: [PATCH] sunxi: add MQ Pro SPL load addresses

Source changes: 2 files, +17/-1 lines.
Tested on MangoPi MQ Pro hardware: PASS.

Keep the kernel, DTB, and initrd outside OpenSBI reserved memory.

--- a/arch/riscv/Kconfig
+++ b/arch/riscv/Kconfig
@@ -49,6 +49,12 @@
 	select SYS_CACHE_SHIFT_6
 
 endchoice
+
+config SUNXI_MANGOPI_MQ_SPL
+	bool "MangoPi MQ Pro SPL memory layout"
+	depends on TARGET_SUN20I_D1 && SPL
+	help
+	  Use the tested kernel, DTB, and initrd load addresses.
 
 config SYS_ICACHE_OFF
 	bool "Do not enable icache"
--- a/include/configs/sunxi-common.h
+++ b/include/configs/sunxi-common.h
@@ -99,7 +99,17 @@
 
 /* Ethernet support */
 
-#ifdef CONFIG_ARM64
+#ifdef CONFIG_SUNXI_MANGOPI_MQ_SPL
+/* Keep the kernel, DTB, and initrd outside OpenSBI's reserved memory. */
+#define BOOTM_SIZE        __stringify(0x10000000)
+#define KERNEL_ADDR_R     __stringify(0x40200000)
+#define FDT_ADDR_R        __stringify(0x46000000)
+#define SCRIPT_ADDR_R     __stringify(0x47000000)
+#define PXEFILE_ADDR_R    __stringify(0x47000000)
+#define FDTOVERLAY_ADDR_R __stringify(SDRAM_OFFSET(1B00000))
+#define RAMDISK_ADDR_R    __stringify(0x48000000)
+
+#elif defined(CONFIG_ARM64)
 /*
  * Boards seem to come with at least 512MB of DRAM.
  * The kernel should go at 512K, which is the default text offset (that will
