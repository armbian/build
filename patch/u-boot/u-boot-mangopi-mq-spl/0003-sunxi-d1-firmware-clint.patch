Subject: [PATCH] sunxi: describe D1 CLINT in the firmware DTB

Source changes: 1 files, +9/-0 lines.
Tested on MangoPi MQ Pro hardware: PASS.

Restore the CLINT description used by the source-built Boot0 image.
OpenSBI needs this node for its timer and IPI drivers.

--- a/arch/riscv/dts/sunxi-u-boot.dtsi
+++ b/arch/riscv/dts/sunxi-u-boot.dtsi
@@ -9,6 +9,15 @@
 
 	soc {
 		bootph-all;
+#ifdef CONFIG_TARGET_SUN20I_D1
+		/* OpenSBI needs the machine-mode timer and IPI device. */
+		clint@14000000 {
+			compatible = "allwinner,sun20i-d1-clint", "thead,c900-clint";
+			reg = <0x14000000 0xc000>;
+			reg-io-width = <4>;
+			interrupts-extended = <&cpu0_intc 3>, <&cpu0_intc 7>;
+		};
+#endif
 	};
 };
