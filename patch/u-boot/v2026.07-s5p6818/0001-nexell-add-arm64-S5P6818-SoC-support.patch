+++ b/arch/arm/dts/Makefile
@@ -51,7 +51,8 @@ dtb-$(CONFIG_ROCKCHIP_RK3368) += \
 	rk3368-px5-evb.dtb \
 
 dtb-$(CONFIG_ARCH_S5P4418) += \
-	s5p4418-nanopi2.dtb
+	s5p4418-nanopi2.dtb \
+	s5p6818-nanopim3.dtb
 
 dtb-$(CONFIG_ARCH_MESON) += \
 	meson-a1-ad401.dtb
diff --git a/arch/arm/mach-nexell/Kconfig b/arch/arm/mach-nexell/Kconfig
index b43dd5a5..4f2c9637 100644
--- a/arch/arm/mach-nexell/Kconfig
+++ b/arch/arm/mach-nexell/Kconfig
@@ -14,6 +14,10 @@ config ARCH_S5P6818
 	bool "Nexell S5P6818 SoC"
 	select ARM64
 	select ARMV8_MULTIENTRY
+	select OF_CONTROL
+	select NX_GPIO
+	select DM_SERIAL
+	select PL01X_SERIAL
 	help
 	  Enable support for Nexell S5P6818 SoC.
 
@@ -30,6 +34,13 @@ config TARGET_NANOPI2
 	help
 	  Enable support for FriendlyARM NanoPi2 and NanoPC-T2 Boards.
 
+config TARGET_NANOPI3
+	bool "FriendlyARM NanoPi3 / NanoPC-T3 / NanoPi M3 Board (S5P6818)"
+	select ARCH_S5P6818
+	help
+	  Enable support for FriendlyARM S5P6818 boards (NanoPi3, NanoPC-T3/T3+,
+	  NanoPi M3).
+
 endchoice
 
 config SYS_PLLFIN
@@ -48,7 +59,8 @@ config SYS_SOC
 	default "nexell"
 
 config SYS_CONFIG_NAME
-	default "s5p4418_nanopi2"
