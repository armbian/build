@@ -419,6 +461,29 @@ static int eqos_probe_resources_aw(struct udevice *dev)
 	debug("rst gpio %d [%d %d %d]\n", eqos->phy_reset_gpio, eqos->reset_delays[0], eqos->reset_delays[1], eqos->reset_delays[2]);
 	debug("regulator dwmac:%s phy:%s\n", chip->dwmac_supply, chip->phy_supply);
 
+	/* Derive unique stable MAC address from SoC SID/eFuse if not explicitly set */
+	{
+		uint8_t mac_addr[6];
+		if (!eth_env_get_enetaddr("ethaddr", mac_addr)) {
+			unsigned int sid[4];
+			int i;
+			for (i = 0; i < 4; i++)
+				sid[i] = readl((void *)(0x03006200 + 4 * i));
+			if (sid[0] != 0 || sid[1] != 0 || sid[2] != 0 || sid[3] != 0) {
+				sid[3] = crc32(0, (unsigned char *)&sid[1], 12);
+				if ((sid[3] & 0xffffff) == 0)
+					sid[3] |= 0x800000;
+				mac_addr[0] = 0x02;
+				mac_addr[1] = (sid[0] >> 0) & 0xff;
+				mac_addr[2] = (sid[3] >> 24) & 0xff;
+				mac_addr[3] = (sid[3] >> 16) & 0xff;
+				mac_addr[4] = (sid[3] >> 8) & 0xff;
+				mac_addr[5] = (sid[3] >> 0) & 0xff;
+				eth_env_set_enetaddr("ethaddr", mac_addr);
+			}
+		}
+	}
+
 	return 0;
 err:
 	if (chip)
@@ -440,34 +505,25 @@ static int eqos_remove_resources_aw(struct udevice *dev)
 static int eqos_start_resets_aw(struct udevice *dev)
 {
 	struct eqos_priv *eqos = dev_get_priv(dev);
