--- /dev/null
+++ b/drivers/video/ssd16xx.c
@@ -0,0 +1,586 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Solomon Systech SSD16xx e-paper video driver
+ *
+ * Copyright (C) 2026 Texas Instruments Incorporated - https://www.ti.com/
+ * Copyright (C) 2026 Andrei Aldea <andrei1998@gmail.com>
+ *
+ * The GDEY042T81 setup is derived from Texas Instruments' Linux DRM
+ * driver for the panel's SSD1683 controller.
+ */
+
+#include <cyclic.h>
+#include <dm.h>
+#include <errno.h>
+#include <spi.h>
+#include <time.h>
+#include <video.h>
+#include <asm/gpio.h>
+#include <dm/device_compat.h>
+#include <dm/devres.h>
+#include <linux/delay.h>
+
+#define SSD16XX_CMD_DRIVER_OUTPUT_CONTROL	0x01
+#define SSD16XX_CMD_DEEP_SLEEP_MODE		0x10
+#define SSD16XX_CMD_DATA_ENTRY_MODE		0x11
+#define SSD16XX_CMD_SW_RESET			0x12
+#define SSD16XX_CMD_TEMPERATURE_SENSOR_CONTROL	0x1a
+#define SSD16XX_CMD_MASTER_ACTIVATION		0x20
+#define SSD16XX_CMD_DISPLAY_UPDATE_CONTROL1	0x21
+#define SSD16XX_CMD_DISPLAY_UPDATE_CONTROL2	0x22
+#define SSD16XX_CMD_WRITE_RAM_BW			0x24
+#define SSD16XX_CMD_WRITE_RAM_RED		0x26
+#define SSD16XX_CMD_BORDER_WAVEFORM_CONTROL	0x3c
+#define SSD16XX_CMD_SET_RAM_X_START_END		0x44
+#define SSD16XX_CMD_SET_RAM_Y_START_END		0x45
+#define SSD16XX_CMD_SET_RAM_X_COUNTER		0x4e
+#define SSD16XX_CMD_SET_RAM_Y_COUNTER		0x4f
+
+#define SSD16XX_WHITE_LUMA	(128 * 256)
+
+/**
+ * struct ssd16xx_panel - Controller settings for an e-paper panel
+ * @width: panel width in pixels
+ * @height: panel height in pixels
+ * @driver_output: third byte of the driver-output-control command
+ * @update_control: display-update-control-1 value for full refreshes
+ * @partial_update_control: display-update-control-1 value for partial refreshes
+ * @border_waveform: border-waveform value for full refreshes
+ * @partial_border_waveform: border-waveform value for partial refreshes
+ * @data_entry_mode: RAM data-entry mode
+ * @temperature_control: internal temperature-sensor setting
+ * @temperature_load: display-update-control-2 value which loads temperature
+ * @full_refresh_mode: display-update-control-2 value for a full refresh
+ * @partial_refresh_mode: display-update-control-2 value for a partial refresh
+ * @deep_sleep_mode: deep-sleep command value
+ * @partial_refresh_limit: number of partial refreshes allowed between full ones
+ * @reset_delay_ms: reset assertion and deassertion delay
+ * @busy_timeout_ms: maximum time to wait for the controller
+ */
+struct ssd16xx_panel {
+	u16 width;
+	u16 height;
+	u8 driver_output;
+	u8 update_control[2];
+	u8 partial_update_control[2];
+	u8 border_waveform;
+	u8 partial_border_waveform;
+	u8 data_entry_mode;
+	u8 temperature_control;
+	u8 temperature_load;
+	u8 full_refresh_mode;
+	u8 partial_refresh_mode;
+	u8 deep_sleep_mode;
+	u8 partial_refresh_limit;
+	u16 reset_delay_ms;
+	u32 busy_timeout_ms;
+};
+
+/**
+ * struct ssd16xx_priv - Private data for an SSD16xx display
+ * @reset_gpio: active-low controller reset
+ * @dc_gpio: data/command selector
+ * @busy_gpio: active-high controller busy indication
+ * @panel: panel-specific settings selected from match data
+ * @mono: converted one-bit framebuffer
+ * @refreshing: controller has an outstanding refresh
+ * @refreshing_full: outstanding refresh is a full refresh
+ * @partial_mode_ready: at least one full refresh has completed
+ * @partial_refreshes: partial refreshes since the last full refresh
+ */
+struct ssd16xx_priv {
+	struct gpio_desc reset_gpio;
+	struct gpio_desc dc_gpio;
+	struct gpio_desc busy_gpio;
+	const struct ssd16xx_panel *panel;
+	u8 *mono;
+	bool refreshing;
+	bool refreshing_full;
+	bool partial_mode_ready;
+	u8 partial_refreshes;
+};
+
+static size_t ssd16xx_row_bytes(const struct ssd16xx_panel *panel)
+{
+	return panel->width / 8;
+}
+
+static size_t ssd16xx_mono_size(const struct ssd16xx_panel *panel)
+{
+	return ssd16xx_row_bytes(panel) * panel->height;
+}
+
+static int ssd16xx_write(struct udevice *dev, bool data, const void *buf,
+			 size_t len)
+{
+	struct ssd16xx_priv *priv = dev_get_priv(dev);
+	int ret;
+
+	ret = dm_gpio_set_value(&priv->dc_gpio, data);
+	if (ret)
+		return ret;
+
+	return dm_spi_xfer(dev, len * 8, buf, NULL,
+			   SPI_XFER_BEGIN | SPI_XFER_END);
+}
+
+static int ssd16xx_command(struct udevice *dev, u8 command, const void *data,
+			   size_t len)
+{
+	int ret;
+
+	ret = ssd16xx_write(dev, false, &command, sizeof(command));
+	if (ret || !len)
+		return ret;
+
+	return ssd16xx_write(dev, true, data, len);
+}
+
+static int ssd16xx_busy(struct udevice *dev)
+{
+	struct ssd16xx_priv *priv = dev_get_priv(dev);
+
+	return dm_gpio_get_value(&priv->busy_gpio);
+}
+
+static int ssd16xx_wait_ready(struct udevice *dev)
+{
+	struct ssd16xx_priv *priv = dev_get_priv(dev);
+	ulong start = get_timer(0);
+	int busy;
+
+	do {
+		busy = ssd16xx_busy(dev);
+		if (busy < 0)
+			return busy;
+		if (!busy)
+			return 0;
+
+		/* Long e-paper updates must not starve watchdogs or cyclic work. */
+		schedule();
+		udelay(1000);
+	} while (get_timer(start) <= priv->panel->busy_timeout_ms);
+
+	dev_err(dev, "timed out waiting for display\n");
+
+	return -ETIMEDOUT;
+}
+
+static void ssd16xx_refresh_complete(struct ssd16xx_priv *priv)
+{
+	if (priv->refreshing_full) {
+		priv->partial_mode_ready = true;
+		priv->partial_refreshes = 0;
+	}
+
+	priv->refreshing = false;
+	priv->refreshing_full = false;
+}
+
+static int ssd16xx_finish_refresh(struct udevice *dev, bool wait)
+{
+	struct ssd16xx_priv *priv = dev_get_priv(dev);
+	int ret;
+
+	if (!priv->refreshing)
+		return 0;
+
+	if (wait) {
+		ret = ssd16xx_wait_ready(dev);
+		if (ret)
+			return ret;
+	} else {
+		ret = ssd16xx_busy(dev);
+		if (ret < 0)
+			return ret;
+		if (ret)
+			return -EAGAIN;
+	}
+
+	ssd16xx_refresh_complete(priv);
+
+	return 0;
+}
+
+static int ssd16xx_hw_reset(struct udevice *dev)
+{
+	struct ssd16xx_priv *priv = dev_get_priv(dev);
+	int ret;
+
+	/* GPIO logical values account for the active-low devicetree flag. */
+	ret = dm_gpio_set_value(&priv->reset_gpio, 1);
+	if (ret)
+		return ret;
+	mdelay(priv->panel->reset_delay_ms);
+
+	ret = dm_gpio_set_value(&priv->reset_gpio, 0);
+	if (ret)
+		return ret;
+	mdelay(priv->panel->reset_delay_ms);
+
+	return 0;
+}
+
+static int ssd16xx_set_cursor(struct udevice *dev)
+{
+	static const u8 x;
+	static const u8 y[] = { 0, 0 };
+	int ret;
+
+	ret = ssd16xx_command(dev, SSD16XX_CMD_SET_RAM_X_COUNTER, &x,
+			      sizeof(x));
+	if (ret)
+		return ret;
+
+	return ssd16xx_command(dev, SSD16XX_CMD_SET_RAM_Y_COUNTER, y,
+			       sizeof(y));
+}
+
+static int ssd16xx_hw_init(struct udevice *dev)
+{
+	struct ssd16xx_priv *priv = dev_get_priv(dev);
+	const struct ssd16xx_panel *panel = priv->panel;
+	u16 last_gate = panel->height - 1;
+	u8 driver_output[] = {
+		last_gate & 0xff,
+		last_gate >> 8,
+		panel->driver_output,
+	};
+	u8 x_range[] = { 0, ssd16xx_row_bytes(panel) - 1 };
+	u8 y_range[] = { 0, 0, last_gate & 0xff, last_gate >> 8 };
+	int ret;
+
+	ret = ssd16xx_hw_reset(dev);
+	if (ret)
+		return ret;
+
+	ret = ssd16xx_command(dev, SSD16XX_CMD_SW_RESET, NULL, 0);
+	if (ret)
+		return ret;
+	ret = ssd16xx_wait_ready(dev);
+	if (ret)
+		return ret;
+
+	ret = ssd16xx_command(dev, SSD16XX_CMD_DRIVER_OUTPUT_CONTROL,
+			      driver_output, sizeof(driver_output));
+	if (ret)
+		return ret;
+	ret = ssd16xx_command(dev, SSD16XX_CMD_DISPLAY_UPDATE_CONTROL1,
+			      panel->update_control,
+			      sizeof(panel->update_control));
+	if (ret)
+		return ret;
+	ret = ssd16xx_command(dev, SSD16XX_CMD_BORDER_WAVEFORM_CONTROL,
+			      &panel->border_waveform,
+			      sizeof(panel->border_waveform));
+	if (ret)
+		return ret;
+	ret = ssd16xx_command(dev, SSD16XX_CMD_TEMPERATURE_SENSOR_CONTROL,
+			      &panel->temperature_control,
+			      sizeof(panel->temperature_control));
+	if (ret)
+		return ret;
+	ret = ssd16xx_command(dev, SSD16XX_CMD_DISPLAY_UPDATE_CONTROL2,
+			      &panel->temperature_load,
+			      sizeof(panel->temperature_load));
+	if (ret)
+		return ret;
+	ret = ssd16xx_command(dev, SSD16XX_CMD_MASTER_ACTIVATION, NULL, 0);
+	if (ret)
+		return ret;
+	ret = ssd16xx_wait_ready(dev);
+	if (ret)
+		return ret;
+
+	ret = ssd16xx_command(dev, SSD16XX_CMD_DATA_ENTRY_MODE,
+			      &panel->data_entry_mode,
+			      sizeof(panel->data_entry_mode));
+	if (ret)
+		return ret;
+	ret = ssd16xx_command(dev, SSD16XX_CMD_SET_RAM_X_START_END, x_range,
+			      sizeof(x_range));
+	if (ret)
+		return ret;
+	ret = ssd16xx_command(dev, SSD16XX_CMD_SET_RAM_Y_START_END, y_range,
+			      sizeof(y_range));
+	if (ret)
+		return ret;
+	ret = ssd16xx_set_cursor(dev);
+	if (ret)
+		return ret;
+
+	return ssd16xx_wait_ready(dev);
+}
+
+static bool ssd16xx_pixel_is_white(u16 pixel)
+{
+	u32 red = (pixel >> 11) & 0x1f;
+	u32 green = (pixel >> 5) & 0x3f;
+	u32 blue = pixel & 0x1f;
+	u32 luma;
+
+	red = (red << 3) | (red >> 2);
+	green = (green << 2) | (green >> 4);
+	blue = (blue << 3) | (blue >> 2);
+	luma = 77 * red + 150 * green + 29 * blue;
+
+	return luma >= SSD16XX_WHITE_LUMA;
+}
+
+static void ssd16xx_convert_framebuffer(struct video_priv *uc_priv,
+					struct ssd16xx_priv *priv)
+{
+	const struct ssd16xx_panel *panel = priv->panel;
+	size_t row_bytes = ssd16xx_row_bytes(panel);
+	size_t x;
+	u16 y;
+
+	for (y = 0; y < panel->height; y++) {
+		const u16 *line = uc_priv->fb + y * uc_priv->line_length;
+
+		for (x = 0; x < row_bytes; x++) {
+			u8 value = 0;
+			int bit;
+
+			for (bit = 0; bit < 8; bit++) {
+				if (ssd16xx_pixel_is_white(line[x * 8 + bit]))
+					value |= BIT(7 - bit);
+			}
+			priv->mono[y * row_bytes + x] = value;
+		}
+	}
+}
+
+static int ssd16xx_prepare_refresh(struct udevice *dev, bool full)
+{
+	struct ssd16xx_priv *priv = dev_get_priv(dev);
+	const struct ssd16xx_panel *panel = priv->panel;
+	const u8 *update_control;
+	const u8 *border_waveform;
+	int ret;
+
+	if (full) {
+		update_control = panel->update_control;
+		border_waveform = &panel->border_waveform;
+	} else {
+		update_control = panel->partial_update_control;
+		border_waveform = &panel->partial_border_waveform;
+	}
+
+	ret = ssd16xx_command(dev, SSD16XX_CMD_BORDER_WAVEFORM_CONTROL,
+			      border_waveform, sizeof(*border_waveform));
+	if (ret)
+		return ret;
+
+	return ssd16xx_command(dev, SSD16XX_CMD_DISPLAY_UPDATE_CONTROL1,
+			       update_control, sizeof(panel->update_control));
+}
+
+static int ssd16xx_start_refresh(struct udevice *dev, bool full)
+{
+	struct ssd16xx_priv *priv = dev_get_priv(dev);
+	u8 mode = full ? priv->panel->full_refresh_mode :
+			 priv->panel->partial_refresh_mode;
+	int ret;
+
+	ret = ssd16xx_command(dev, SSD16XX_CMD_DISPLAY_UPDATE_CONTROL2, &mode,
+			      sizeof(mode));
+	if (ret)
+		return ret;
+	ret = ssd16xx_command(dev, SSD16XX_CMD_MASTER_ACTIVATION, NULL, 0);
+	if (ret)
+		return ret;
+
+	priv->refreshing = true;
+	priv->refreshing_full = full;
+	if (!full)
+		priv->partial_refreshes++;
+
+	/* Give BUSY time to assert before a later nonblocking status check. */
+	udelay(1000);
+
+	return 0;
+}
+
+static int ssd16xx_sync(struct udevice *dev)
+{
+	struct video_priv *uc_priv = dev_get_uclass_priv(dev);
+	struct ssd16xx_priv *priv = dev_get_priv(dev);
+	bool full;
+	int ret;
+
+	if (!video_damage_pending(dev))
+		return 0;
+
+	/* Keep console output responsive while a slow e-paper update runs. */
+	ret = ssd16xx_finish_refresh(dev, false);
+	if (ret)
+		return ret;
+
+	ssd16xx_convert_framebuffer(uc_priv, priv);
+	full = !priv->partial_mode_ready ||
+		priv->partial_refreshes >= priv->panel->partial_refresh_limit;
+
+	ret = dm_spi_claim_bus(dev);
+	if (ret)
+		return ret;
+
+	ret = ssd16xx_set_cursor(dev);
+	if (ret)
+		goto release;
+	ret = ssd16xx_command(dev, SSD16XX_CMD_WRITE_RAM_BW, priv->mono,
+			      ssd16xx_mono_size(priv->panel));
+	if (ret)
+		goto release;
+	ret = ssd16xx_prepare_refresh(dev, full);
+	if (ret)
+		goto release;
+
+	if (full) {
+		ret = ssd16xx_command(dev, SSD16XX_CMD_WRITE_RAM_RED, priv->mono,
+				      ssd16xx_mono_size(priv->panel));
+		if (ret)
+			goto release;
+	}
+
+	ret = ssd16xx_start_refresh(dev, full);
+
+release:
+	dm_spi_release_bus(dev);
+
+	return ret;
+}
+
+static int ssd16xx_probe(struct udevice *dev)
+{
+	struct video_priv *uc_priv = dev_get_uclass_priv(dev);
+	struct ssd16xx_priv *priv = dev_get_priv(dev);
+	int ret;
+
+	priv->panel = (const struct ssd16xx_panel *)dev_get_driver_data(dev);
+	if (!priv->panel || !priv->panel->width || !priv->panel->height ||
+	    priv->panel->width % 8)
+		return -EINVAL;
+
+	ret = gpio_request_by_name(dev, "reset-gpios", 0, &priv->reset_gpio,
+				   GPIOD_IS_OUT);
+	if (ret) {
+		dev_err(dev, "missing reset GPIO\n");
+		return ret;
+	}
+	ret = gpio_request_by_name(dev, "dc-gpios", 0, &priv->dc_gpio,
+				   GPIOD_IS_OUT);
+	if (ret) {
+		dev_err(dev, "missing data/command GPIO\n");
+		return ret;
+	}
+	ret = gpio_request_by_name(dev, "busy-gpios", 0, &priv->busy_gpio,
+				   GPIOD_IS_IN);
+	if (ret) {
+		dev_err(dev, "missing busy GPIO\n");
+		return ret;
+	}
+
+	priv->mono = devm_kmalloc(dev, ssd16xx_mono_size(priv->panel),
+				  GFP_KERNEL);
+	if (!priv->mono)
+		return -ENOMEM;
+
+	uc_priv->bpix = VIDEO_BPP16;
+	uc_priv->xsize = priv->panel->width;
+	uc_priv->ysize = priv->panel->height;
+	uc_priv->rot = 0;
+
+	ret = dm_spi_claim_bus(dev);
+	if (ret)
+		return ret;
+	ret = ssd16xx_hw_init(dev);
+	dm_spi_release_bus(dev);
+
+	return ret;
+}
+
+static int ssd16xx_remove(struct udevice *dev)
+{
+	struct ssd16xx_priv *priv = dev_get_priv(dev);
+	int reset_ret;
+	int ret;
+
+	/* Finish analogue drive activity before Linux takes over the panel. */
+	ret = ssd16xx_finish_refresh(dev, true);
+	if (!ret) {
+		ret = dm_spi_claim_bus(dev);
+		if (!ret) {
+			ret = ssd16xx_command(dev, SSD16XX_CMD_DEEP_SLEEP_MODE,
+					      &priv->panel->deep_sleep_mode,
+					      sizeof(priv->panel->deep_sleep_mode));
+			dm_spi_release_bus(dev);
+		}
+	}
+
+	/* Reset is asserted even if waiting or entering deep sleep failed. */
+	reset_ret = dm_gpio_set_value(&priv->reset_gpio, 1);
+	if (!ret)
+		ret = reset_ret;
+
+	return ret;
+}
+
+static int ssd16xx_bind(struct udevice *dev)
+{
+	const struct ssd16xx_panel *panel;
+	struct video_uc_plat *plat = dev_get_uclass_plat(dev);
+
+	panel = (const struct ssd16xx_panel *)dev_get_driver_data(dev);
+	if (!panel)
+		return -EINVAL;
+
+	plat->size = panel->width * panel->height * VNBYTES(VIDEO_BPP16);
+
+	return 0;
+}
+
+static const struct ssd16xx_panel gdey042t81 = {
+	.width = 400,
+	.height = 300,
+	.driver_output = 0x00,
+	.update_control = { 0x40, 0x00 },
+	.partial_update_control = { 0x00, 0x00 },
+	.border_waveform = 0x05,
+	.partial_border_waveform = 0x80,
+	.data_entry_mode = 0x03,
+	.temperature_control = 0x6e,
+	.temperature_load = 0x91,
+	.full_refresh_mode = 0xf7,
+	.partial_refresh_mode = 0xff,
+	.deep_sleep_mode = 0x01,
+	.partial_refresh_limit = 5,
+	.reset_delay_ms = 10,
+	.busy_timeout_ms = 10000,
+};
+
+static const struct video_ops ssd16xx_ops = {
+	.video_sync = ssd16xx_sync,
+	.video_sync_rate_limited = true,
+};
+
+static const struct udevice_id ssd16xx_ids[] = {
+	{
+		.compatible = "gooddisplay,gdey042t81",
+		.data = (ulong)&gdey042t81,
+	},
+	{ }
+};
+
+U_BOOT_DRIVER(ssd16xx_video) = {
+	.name = "ssd16xx_video",
+	.id = UCLASS_VIDEO,
+	.of_match = ssd16xx_ids,
+	.ops = &ssd16xx_ops,
+	.plat_auto = sizeof(struct video_uc_plat),
+	.bind = ssd16xx_bind,
+	.probe = ssd16xx_probe,
+	.remove = ssd16xx_remove,
+	.priv_auto = sizeof(struct ssd16xx_priv),
+	.flags = DM_FLAG_OS_PREPARE,
+};
