diff --git a/test/dm/ssd16xx.c b/test/dm/ssd16xx.c
new file mode 100644
index 00000000..2bd780dd
--- /dev/null
+++ b/test/dm/ssd16xx.c
@@ -0,0 +1,259 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Copyright (C) 2026 Andrei Aldea <andrei1998@gmail.com>
+ */
+
+#include <cyclic.h>
+#include <dm.h>
+#include <errno.h>
+#include <spi.h>
+#include <time.h>
+#include <video.h>
+#include <asm/gpio.h>
+#include <dm/device-internal.h>
+#include <dm/test.h>
+#include <dm/uclass-internal.h>
+#include <linux/string.h>
+#include <test/test.h>
+#include <test/ut.h>
+
+#define SSD16XX_CMD_DEEP_SLEEP_MODE		0x10
+#define SSD16XX_CMD_SW_RESET			0x12
+#define SSD16XX_CMD_MASTER_ACTIVATION		0x20
+#define SSD16XX_CMD_DISPLAY_UPDATE_CONTROL2	0x22
+#define SSD16XX_CMD_WRITE_RAM_BW			0x24
+#define SSD16XX_CMD_WRITE_RAM_RED		0x26
+
+#define SSD16XX_TEST_COMMANDS	128
+#define SSD16XX_TEST_MONO_SIZE	(400 * 300 / 8)
+
+struct sandbox_ssd16xx_spi_priv {
+	struct udevice *dc_gpio;
+	uint dc_offset;
+	u8 commands[SSD16XX_TEST_COMMANDS];
+	uint command_count;
+	u8 current_command;
+	uint bw_writes;
+	uint red_writes;
+	uint bw_length;
+	uint red_length;
+	u8 bw_first;
+	u8 update_mode;
+	bool fail_next;
+};
+
+static int sandbox_ssd16xx_spi_xfer(struct udevice *dev, uint bitlen,
+				    const void *dout, void *din,
+				    ulong flags)
+{
+	struct sandbox_ssd16xx_spi_priv *priv = dev_get_priv(dev->parent);
+	const u8 *bytes = dout;
+	uint length = bitlen / 8;
+	bool data;
+
+	if (!dout || bitlen % 8 || !length)
+		return -EINVAL;
+	if (priv->fail_next) {
+		priv->fail_next = false;
+		return -EIO;
+	}
+
+	data = sandbox_gpio_get_value(priv->dc_gpio, priv->dc_offset);
+	if (!data) {
+		if (length != 1)
+			return -EINVAL;
+		if (priv->command_count >= ARRAY_SIZE(priv->commands))
+			return -ENOSPC;
+		priv->current_command = bytes[0];
+		priv->commands[priv->command_count++] = bytes[0];
+		return 0;
+	}
+
+	switch (priv->current_command) {
+	case SSD16XX_CMD_DISPLAY_UPDATE_CONTROL2:
+		if (length == 1)
+			priv->update_mode = bytes[0];
+		break;
+	case SSD16XX_CMD_WRITE_RAM_BW:
+		priv->bw_writes++;
+		priv->bw_length = length;
+		priv->bw_first = bytes[0];
+		break;
+	case SSD16XX_CMD_WRITE_RAM_RED:
+		priv->red_writes++;
+		priv->red_length = length;
+		break;
+	}
+
+	return 0;
+}
+
+static int sandbox_ssd16xx_spi_set_speed(struct udevice *bus, uint speed)
+{
+	return 0;
+}
+
+static int sandbox_ssd16xx_spi_set_mode(struct udevice *bus, uint mode)
+{
+	return 0;
+}
+
+static int sandbox_ssd16xx_spi_cs_info(struct udevice *bus, uint cs,
+				       struct spi_cs_info *info)
+{
+	return cs ? -EINVAL : 0;
+}
+
+static int sandbox_ssd16xx_spi_probe(struct udevice *bus)
+{
+	struct sandbox_ssd16xx_spi_priv *priv = dev_get_priv(bus);
+	unsigned int gpio;
+
+	return gpio_lookup_name("b2", &priv->dc_gpio, &priv->dc_offset, &gpio);
+}
+
+static const struct dm_spi_ops sandbox_ssd16xx_spi_ops = {
+	.xfer = sandbox_ssd16xx_spi_xfer,
+	.set_speed = sandbox_ssd16xx_spi_set_speed,
+	.set_mode = sandbox_ssd16xx_spi_set_mode,
+	.cs_info = sandbox_ssd16xx_spi_cs_info,
+};
+
+static const struct udevice_id sandbox_ssd16xx_spi_ids[] = {
+	{ .compatible = "sandbox,ssd16xx-spi" },
+	{ }
+};
+
+U_BOOT_DRIVER(sandbox_ssd16xx_spi) = {
+	.name = "sandbox_ssd16xx_spi",
+	.id = UCLASS_SPI,
+	.of_match = sandbox_ssd16xx_spi_ids,
+	.ops = &sandbox_ssd16xx_spi_ops,
+	.probe = sandbox_ssd16xx_spi_probe,
+	.priv_auto = sizeof(struct sandbox_ssd16xx_spi_priv),
+};
+
+static int ssd16xx_test_get_gpio(const char *name, struct udevice **devp,
+				 uint *offsetp)
+{
+	unsigned int gpio;
+
+	return gpio_lookup_name(name, devp, offsetp, &gpio);
+}
+
+static int dm_test_ssd16xx(struct unit_test_state *uts)
+{
+	static const u8 init_commands[] = {
+		SSD16XX_CMD_SW_RESET, 0x01, 0x21, 0x3c, 0x1a, 0x22,
+		SSD16XX_CMD_MASTER_ACTIVATION, 0x11, 0x44, 0x45, 0x4e, 0x4f,
+	};
+	struct sandbox_ssd16xx_spi_priv *spi_priv;
+	struct video_uc_plat *uc_plat;
+	struct video_priv *video_priv;
+	struct udevice *reset_gpio;
+	struct udevice *busy_gpio;
+	struct udevice *bus;
+	struct udevice *dev;
+	ofnode node;
+	uint reset_offset;
+	uint busy_offset;
+	u16 *pixels;
+	uint red_writes;
+	int i;
+	int ret;
+
+	node = ofnode_path("/ssd16xx-test-spi");
+	ut_assertok(uclass_find_device_by_ofnode(UCLASS_SPI, node, &bus));
+	ut_assertnonnull(bus);
+	node = ofnode_path("/ssd16xx-test-spi/display@0");
+	ut_assertok(uclass_find_device_by_ofnode(UCLASS_VIDEO, node, &dev));
+	ut_assertnonnull(dev);
+
+	uc_plat = dev_get_uclass_plat(dev);
+	uc_plat->hide_logo = true;
+	ut_assertok(device_probe(dev));
+	ut_assertok(cyclic_unregister_all());
+
+	spi_priv = dev_get_priv(bus);
+	video_priv = dev_get_uclass_priv(dev);
+	ut_asserteq(400, video_priv->xsize);
+	ut_asserteq(300, video_priv->ysize);
+	ut_asserteq(VIDEO_BPP16, video_priv->bpix);
+	ut_assert(spi_priv->command_count >= ARRAY_SIZE(init_commands));
+	for (i = 0; i < ARRAY_SIZE(init_commands); i++)
+		ut_asserteq(init_commands[i], spi_priv->commands[i]);
+
+	/* Complete the initial white full refresh if post-probe deferred it. */
+	ut_assertok(video_sync(dev, true));
+	ut_asserteq(1, spi_priv->bw_writes);
+	ut_asserteq(1, spi_priv->red_writes);
+	ut_asserteq(SSD16XX_TEST_MONO_SIZE, spi_priv->bw_length);
+	ut_asserteq(SSD16XX_TEST_MONO_SIZE, spi_priv->red_length);
+	ut_asserteq(0xf7, spi_priv->update_mode);
+
+	ut_assertok(ssd16xx_test_get_gpio("b1", &reset_gpio, &reset_offset));
+	ut_asserteq(1, sandbox_gpio_get_value(reset_gpio, reset_offset));
+	ut_assertok(ssd16xx_test_get_gpio("b3", &busy_gpio, &busy_offset));
+	spi_priv->bw_writes = 0;
+	spi_priv->red_writes = 0;
+
+	/* RGB565 luminance conversion: white/black pairs become 10101010. */
+	memset(video_priv->fb, 0, video_priv->fb_size);
+	pixels = video_priv->fb;
+	for (i = 0; i < 8; i += 2)
+		pixels[i] = 0xffff;
+	video_damage(dev, 0, 0, video_priv->xsize, video_priv->ysize);
+	video_priv->last_sync = get_timer(0);
+	ut_assertok(video_sync(dev, false));
+	ut_asserteq(0, spi_priv->bw_writes);
+	ut_assert(video_damage_pending(dev));
+
+	/* A forced sync bypasses the slow-driver rate limit. */
+	ut_assertok(video_sync(dev, true));
+	ut_asserteq(1, spi_priv->bw_writes);
+	ut_asserteq(0, spi_priv->red_writes);
+	ut_asserteq(0xaa, spi_priv->bw_first);
+	ut_asserteq(0xff, spi_priv->update_mode);
+
+	/* A busy panel leaves damage queued and performs no SPI transfer. */
+	ut_assertok(sandbox_gpio_set_value(busy_gpio, busy_offset, 1));
+	video_damage(dev, 0, 0, 1, 1);
+	ret = video_sync(dev, true);
+	ut_asserteq(-EAGAIN, ret);
+	ut_asserteq(1, spi_priv->bw_writes);
+	ut_assert(video_damage_pending(dev));
+
+	ut_assertok(sandbox_gpio_set_value(busy_gpio, busy_offset, 0));
+	ut_assertok(video_sync(dev, true));
+	ut_asserteq(2, spi_priv->bw_writes);
+	ut_assert(!video_damage_pending(dev));
+
+	/* Five partial updates are followed by a full anti-ghosting update. */
+	red_writes = spi_priv->red_writes;
+	for (i = 2; i < 5; i++) {
+		video_damage(dev, i, i, 1, 1);
+		ut_assertok(video_sync(dev, true));
+		ut_asserteq(red_writes, spi_priv->red_writes);
+		ut_asserteq(0xff, spi_priv->update_mode);
+	}
+	video_damage(dev, 6, 6, 1, 1);
+	ut_assertok(video_sync(dev, true));
+	ut_asserteq(red_writes + 1, spi_priv->red_writes);
+	ut_asserteq(0xf7, spi_priv->update_mode);
+
+	/* Transport failures propagate without discarding framebuffer damage. */
+	video_damage(dev, 7, 7, 1, 1);
+	spi_priv->fail_next = true;
+	ret = video_sync(dev, true);
+	ut_asserteq(-EIO, ret);
+	ut_assert(video_damage_pending(dev));
+
+	ut_assertok(device_remove(dev, DM_REMOVE_NORMAL));
+	ut_asserteq(SSD16XX_CMD_DEEP_SLEEP_MODE,
+		    spi_priv->commands[spi_priv->command_count - 1]);
+	ut_asserteq(0, sandbox_gpio_get_value(reset_gpio, reset_offset));
+
+	return 0;
+}
+
+DM_TEST(dm_test_ssd16xx, UTF_SCAN_PDATA | UTF_SCAN_FDT);
