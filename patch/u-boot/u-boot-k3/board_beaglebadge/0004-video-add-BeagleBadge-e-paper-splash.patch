+BEAGLEBADGE E-PAPER BOOT LOGO
+M:	Andrei Aldea <andrei1998@gmail.com>
+S:	Maintained
+F:	drivers/video/beaglebadge_logo.c
+F:	drivers/video/beaglebadge_logo.h
+
 BINMAN
 M:	Simon Glass <sjg@chromium.org>
 M:	Alper Nebi Yasak <alpernebiyasak@gmail.com>
diff --git a/configs/am62lx_badge_defconfig b/configs/am62lx_badge_defconfig
index 271bc448..75a954cc 100644
--- a/configs/am62lx_badge_defconfig
+++ b/configs/am62lx_badge_defconfig
@@ -18,6 +18,7 @@ CONFIG_VIDEO=y
 CONFIG_VIDEO_DAMAGE=y
 CONFIG_VIDEO_REMOVE=y
 CONFIG_VIDEO_SSD16XX=y
+CONFIG_VIDEO_BEAGLEBADGE_LOGO=y
 CONFIG_VIDEO_SYNC_MS=1000
 CONFIG_VIDEO_SYNC_CYCLIC_MS=1000
 CONFIG_CYCLIC_MAX_CPU_TIME_US=1500000
diff --git a/drivers/video/Kconfig b/drivers/video/Kconfig
index 5cdcc9d9..cfe0bef9 100644
--- a/drivers/video/Kconfig
+++ b/drivers/video/Kconfig
@@ -945,6 +945,13 @@ config VIDEO_SSD16XX
 	  controllers connected over SPI. This currently supports the Good
 	  Display GDEY042T81 400x300 monochrome panel using an SSD1683.
 
+config VIDEO_BEAGLEBADGE_LOGO
+	bool "Use the BeagleBadge e-paper boot logo"
+	depends on VIDEO_SSD16XX && VIDEO_LOGO
+	help
+	  Display the board-specific, dithered 400x300 BeagleBadge welcome
+	  image and wait for the e-paper refresh before drawing the boot menu.
+
 source "drivers/video/zynqmp/Kconfig"
 source "drivers/video/nexell/Kconfig"
 
diff --git a/drivers/video/Makefile b/drivers/video/Makefile
index 5734345e..aa94880d 100644
--- a/drivers/video/Makefile
+++ b/drivers/video/Makefile
@@ -25,6 +25,7 @@ obj-$(CONFIG_PANEL_HX8238D) += hx8238d.o
 obj-$(CONFIG_$(PHASE_)SIMPLE_PANEL) += simple_panel.o
 
 obj-$(CONFIG_VIDEO_LOGO) += u_boot_logo.o
+obj-$(CONFIG_VIDEO_BEAGLEBADGE_LOGO) += beaglebadge_logo.o
 obj-$(CONFIG_$(PHASE_)BMP) += bmp.o
 
 endif
