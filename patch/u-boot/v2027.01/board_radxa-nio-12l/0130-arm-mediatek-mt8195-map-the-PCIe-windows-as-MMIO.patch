From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ricardo Pardini <ricardo@pardini.net>
Date: Sun, 8 Nov 2026 01:18:45 +0100
Subject: [PATCH] arm: mediatek: mt8195: map the PCIe windows as MMIO

The MT8195 PCIe memory windows are at 0x20000000-0x27ffffff, beyond the
0x20000000 bytes of MMIO mapped by default, so accessing a BAR (eg. of
an xHCI behind PCIe) fails with a translation fault. Map 0x40000000, up
to the DRAM base, as MT7988 does.

Assisted-by: Claude Opus 5.5
Signed-off-by: Ricardo Pardini <ricardo@pardini.net>
---
 arch/arm/mach-mediatek/Kconfig | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/arch/arm/mach-mediatek/Kconfig b/arch/arm/mach-mediatek/Kconfig
index 8b8d50571bc..b6c07069958 100644
--- a/arch/arm/mach-mediatek/Kconfig
+++ b/arch/arm/mach-mediatek/Kconfig
@@ -178,7 +178,7 @@ config MTK_MEM_MAP_DDR_SIZE
 
 config MTK_MEM_MAP_MMIO_SIZE
 	hex "MMIO .size in mem_map"
-	default 0x40000000 if TARGET_MT7622 || TARGET_MT7981 || TARGET_MT7986 || TARGET_MT7987 || TARGET_MT7988 || TARGET_MT8512
+	default 0x40000000 if TARGET_MT7622 || TARGET_MT7981 || TARGET_MT7986 || TARGET_MT7987 || TARGET_MT7988 || TARGET_MT8195 || TARGET_MT8512
 	default 0x20000000
 	help
 	  Target-specific MMIO region size in mem_map.
