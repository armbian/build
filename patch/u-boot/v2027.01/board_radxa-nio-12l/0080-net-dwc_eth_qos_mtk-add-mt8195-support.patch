From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ricardo Pardini <ricardo@pardini.net>
Date: Sat, 7 Nov 2026 23:37:54 +0100
Subject: [PATCH] net: dwc_eth_qos_mtk: add mt8195 support

MT8195 uses the same peri configuration register layout as MT8189 and
MT8366, at offset 0xfd0 in infracfg_ao.

Assisted-by: Claude Opus 5.5
Signed-off-by: Ricardo Pardini <ricardo@pardini.net>
---
 drivers/net/dwc_eth_qos.c     | 4 ++++
 drivers/net/dwc_eth_qos_mtk.c | 5 +++++
 2 files changed, 9 insertions(+)

diff --git a/drivers/net/dwc_eth_qos.c b/drivers/net/dwc_eth_qos.c
index 565bda088b0..002685011b6 100644
--- a/drivers/net/dwc_eth_qos.c
+++ b/drivers/net/dwc_eth_qos.c
@@ -1673,6 +1673,10 @@ static const struct udevice_id eqos_ids[] = {
 		.compatible = "mediatek,mt8189-gmac",
 		.data = (ulong)&eqos_mtk_config
 	},
+	{
+		.compatible = "mediatek,mt8195-gmac",
+		.data = (ulong)&eqos_mtk_config
+	},
 	{
 		.compatible = "mediatek,mt8366-gmac",
 		.data = (ulong)&eqos_mtk_config
diff --git a/drivers/net/dwc_eth_qos_mtk.c b/drivers/net/dwc_eth_qos_mtk.c
index b4ee9c12404..7292e3d2d5a 100644
--- a/drivers/net/dwc_eth_qos_mtk.c
+++ b/drivers/net/dwc_eth_qos_mtk.c
@@ -19,6 +19,7 @@
  * so add a SoC specific prefix.
  */
 #define MT8189_PERI_ETH_BASE		0x270
+#define MT8195_PERI_ETH_BASE		0xfd0
 #define MT8366_PERI_ETH_BASE		0x60
 
 #define MTK_PERI_ETH_CTRL0(base)	((base) + 0x0)
@@ -77,6 +78,10 @@ static const struct eqos_mtk_soc_data eqos_mtk_soc_data[] = {
 		.compatible = "mediatek,mt8189-gmac",
 		.peri_eth_base = MT8189_PERI_ETH_BASE,
 	},
+	{
+		.compatible = "mediatek,mt8195-gmac",
+		.peri_eth_base = MT8195_PERI_ETH_BASE,
+	},
 	{
 		.compatible = "mediatek,mt8366-gmac",
 		.peri_eth_base = MT8366_PERI_ETH_BASE,
