From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ricardo Pardini <ricardo@pardini.net>
Date: Sun, 8 Nov 2026 01:14:37 +0100
Subject: [PATCH] phy: mediatek: add MT8195 PCIe PHY driver

The PCIe PHY needs its power domain switched on, which happens when the
device probes. Add a minimal driver, based on Linux; it does not apply
the optional efuse calibration yet.

Assisted-by: Claude Opus 5.5
Signed-off-by: Ricardo Pardini <ricardo@pardini.net>
---
 drivers/phy/mediatek/Kconfig        |  8 +++++
 drivers/phy/mediatek/Makefile       |  1 +
 drivers/phy/mediatek/phy-mtk-pcie.c | 49 +++++++++++++++++++++++++++++
 3 files changed, 58 insertions(+)
 create mode 100644 drivers/phy/mediatek/phy-mtk-pcie.c

diff --git a/drivers/phy/mediatek/Kconfig b/drivers/phy/mediatek/Kconfig
index 4a33741006c..29f84eaa179 100644
--- a/drivers/phy/mediatek/Kconfig
+++ b/drivers/phy/mediatek/Kconfig
@@ -31,6 +31,14 @@ config PHY_MTK_MIPI_DSI
 	  Support for the MIPI TX D-PHY found on MediaTek SoCs such as the
 	  MT8183 and MT8365. The PHY provides the D-PHY lanes and their PLL.
 
+config PHY_MTK_PCIE
+	bool "MediaTek PCIe PHY driver"
+	depends on ARCH_MEDIATEK
+	depends on PHY
+	help
+	  Support for the PCIe PHY on MediaTek chipsets, eg. MT8195. It
+	  powers the PHY on; efuse calibration is not supported.
+
 config PHY_MTK_TPHY
 	bool "MediaTek T-PHY Driver"
 	depends on PHY
diff --git a/drivers/phy/mediatek/Makefile b/drivers/phy/mediatek/Makefile
index ad3272ffacc..4724602642a 100644
--- a/drivers/phy/mediatek/Makefile
+++ b/drivers/phy/mediatek/Makefile
@@ -3,6 +3,7 @@
 obj-$(CONFIG_PHY_MTK_DP) += phy-mtk-dp.o
 obj-$(CONFIG_PHY_MTK_HDMI) += phy-mtk-hdmi.o phy-mtk-hdmi-mt8195.o
 obj-$(CONFIG_PHY_MTK_MIPI_DSI) += phy-mtk-mipi-dsi.o phy-mtk-mipi-dsi-mt8183.o
+obj-$(CONFIG_PHY_MTK_PCIE) += phy-mtk-pcie.o
 obj-$(CONFIG_PHY_MTK_TPHY) += phy-mtk-tphy.o
 obj-$(CONFIG_PHY_MTK_UFS) += phy-mtk-ufs.o
 obj-$(CONFIG_PHY_MTK_XSPHY) += phy-mtk-xsphy.o
diff --git a/drivers/phy/mediatek/phy-mtk-pcie.c b/drivers/phy/mediatek/phy-mtk-pcie.c
new file mode 100644
index 00000000000..43f7b66ac86
--- /dev/null
+++ b/drivers/phy/mediatek/phy-mtk-pcie.c
@@ -0,0 +1,49 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * MediaTek PCIe PHY driver, based on the Linux one
+ *
+ * Copyright (c) 2022 MediaTek Inc.
+ */
+
+#include <dm.h>
+#include <dm/device_compat.h>
+#include <generic-phy.h>
+
+/*
+ * The PHY needs no setup besides its power domain, which the driver model
+ * switches on when the device probes. Linux also applies optional efuse
+ * calibration data ("nvmem-cells"); that is not implemented here.
+ */
+struct mtk_pcie_phy {
+	void __iomem *sif_base;
+};
+
+static const struct phy_ops mtk_pcie_phy_ops = {
+};
+
+static int mtk_pcie_phy_probe(struct udevice *dev)
+{
+	struct mtk_pcie_phy *pcie_phy = dev_get_priv(dev);
+
+	pcie_phy->sif_base = dev_remap_addr_name(dev, "sif");
+	if (!pcie_phy->sif_base) {
+		dev_err(dev, "failed to map phy-sif base\n");
+		return -ENOENT;
+	}
+
+	return 0;
+}
+
+static const struct udevice_id mtk_pcie_phy_ids[] = {
+	{ .compatible = "mediatek,mt8195-pcie-phy" },
+	{ }
+};
+
+U_BOOT_DRIVER(mtk_pcie_phy) = {
+	.name		= "mtk-pcie-phy",
+	.id		= UCLASS_PHY,
+	.of_match	= mtk_pcie_phy_ids,
+	.ops		= &mtk_pcie_phy_ops,
+	.probe		= mtk_pcie_phy_probe,
+	.priv_auto	= sizeof(struct mtk_pcie_phy),
+};
