From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ricardo Pardini <ricardo@pardini.net>
Date: Sat, 7 Nov 2026 23:39:45 +0100
Subject: [PATCH] board: mediatek: mt8195: serial# and stable MAC from UFS
 serial

Genio 1200 boards have no other unique storage U-Boot can read. Set
serial# from the UFS serial number, and derive a locally administered
ethaddr from its SHA-256. Values in the environment take precedence.

Assisted-by: Claude Opus 5.5
Signed-off-by: Ricardo Pardini <ricardo@pardini.net>
---
 board/mediatek/mt8195/mt8195.c | 35 ++++++++++++++++++++++++++++++++++
 1 file changed, 35 insertions(+)

diff --git a/board/mediatek/mt8195/mt8195.c b/board/mediatek/mt8195/mt8195.c
index 7e218da28e9..eb410cd84d0 100644
--- a/board/mediatek/mt8195/mt8195.c
+++ b/board/mediatek/mt8195/mt8195.c
@@ -5,6 +5,39 @@
 
 #include <env.h>
 #include <init.h>
+#include <ufs.h>
+#include <u-boot/sha256.h>
+
+/*
+ * Without other unique storage, use the UFS serial number as serial# (also
+ * passed to the OS) and derive a stable, locally administered MAC address
+ * from it. Values already in the environment take precedence.
+ */
+static void mt8195_setup_serial_and_ethaddr(void)
+{
+	u8 hash[SHA256_SUM_LEN];
+	const char *serial;
+	char buf[256];
+	u8 mac[6];
+
+	serial = env_get("serial#");
+	if (!serial) {
+		if (!IS_ENABLED(CONFIG_UFS) || ufs_get_serial(0, buf, sizeof(buf)))
+			return;
+		env_set("serial#", buf);
+		serial = buf;
+	}
+
+	if (!IS_ENABLED(CONFIG_DM_ETH) || !IS_ENABLED(CONFIG_SHA256) ||
+	    env_get("ethaddr"))
+		return;
+
+	sha256_csum_wd((const u8 *)serial, strlen(serial), hash, CHUNKSZ_SHA256);
+	memcpy(mac, hash, sizeof(mac));
+	mac[0] &= 0xfe;	/* unicast */
+	mac[0] |= 0x02;	/* locally administered */
+	eth_env_set_enetaddr("ethaddr", mac);
+}
 
 int board_late_init(void)
 {
@@ -16,5 +49,7 @@ int board_late_init(void)
 	if (CONFIG_DEFAULT_FDT_FILE[0] && !env_get("fdtfile"))
 		env_set("fdtfile", CONFIG_DEFAULT_FDT_FILE);
 
+	mt8195_setup_serial_and_ethaddr();
+
 	return 0;
 }
