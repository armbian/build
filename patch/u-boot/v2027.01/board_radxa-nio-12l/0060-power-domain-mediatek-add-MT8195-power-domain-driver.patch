From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ricardo Pardini <ricardo@pardini.net>
Date: Sat, 7 Nov 2026 23:37:20 +0100
Subject: [PATCH] power: domain: mediatek: add MT8195 power domain driver

Add the MT8195 power domains, with data from Linux
drivers/pmdomain/mediatek/mt8195-pm-domains.h. Only the capabilities
U-Boot implements (SRAM isolation) are kept.

Assisted-by: Claude Opus 5.5
Signed-off-by: Ricardo Pardini <ricardo@pardini.net>
---
 drivers/power/domain/Makefile              |   1 +
 drivers/power/domain/mt8195-power-domain.c | 693 +++++++++++++++++++++
 2 files changed, 694 insertions(+)
 create mode 100644 drivers/power/domain/mt8195-power-domain.c

diff --git a/drivers/power/domain/Makefile b/drivers/power/domain/Makefile
index 3b816ed3bed..d9af6998d21 100644
--- a/drivers/power/domain/Makefile
+++ b/drivers/power/domain/Makefile
@@ -21,6 +21,7 @@ obj-$(CONFIG_TARGET_MT7623) += mt2701-power-domain.o
 obj-$(CONFIG_TARGET_MT7622)$(CONFIG_TARGET_MT7629) += mt7622-power-domain.o
 obj-$(CONFIG_TARGET_MT8188) += mt8188-power-domain.o
 obj-$(CONFIG_TARGET_MT8189) += mt8189-power-domain.o
+obj-$(CONFIG_TARGET_MT8195) += mt8195-power-domain.o
 obj-$(CONFIG_TARGET_MT8365) += mt8365-power-domain.o
 obj-$(CONFIG_TARGET_MT8366) += mt8366-power-domain.o
 endif
