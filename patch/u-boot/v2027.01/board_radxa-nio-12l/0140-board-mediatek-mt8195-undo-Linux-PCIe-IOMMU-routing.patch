From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ricardo Pardini <ricardo@pardini.net>
Date: Sun, 8 Nov 2026 01:39:21 +0100
Subject: [PATCH] board: mediatek: mt8195: undo Linux PCIe IOMMU routing

Linux routes PCIe DMA through the infra IOMMU by setting per-port bits
in pericfg_ao (PERICFG_IOMMU_1). They survive a warm reboot, and U-Boot
has no IOMMU driver, so PCIe devices then cannot do DMA: an xHCI behind
PCIe times out on its first command. Clear the PCIe bits.

Assisted-by: Claude Opus 5.5
Signed-off-by: Ricardo Pardini <ricardo@pardini.net>
---
 board/mediatek/mt8195/mt8195.c | 28 ++++++++++++++++++++++++++++
 1 file changed, 28 insertions(+)

diff --git a/board/mediatek/mt8195/mt8195.c b/board/mediatek/mt8195/mt8195.c
index eb410cd84d0..ff8c168a044 100644
--- a/board/mediatek/mt8195/mt8195.c
+++ b/board/mediatek/mt8195/mt8195.c
@@ -5,9 +5,36 @@
 
 #include <env.h>
 #include <init.h>
+#include <asm/io.h>
+#include <dm/ofnode.h>
+#include <linux/bitops.h>
 #include <ufs.h>
 #include <u-boot/sha256.h>
 
+#define PERICFG_IOMMU_1		0x714
+#define PERICFG_IOMMU_PCIE	GENMASK(19, 16)	/* PCIe1, PCIe0 */
+
+/*
+ * Linux routes PCIe DMA through the infra IOMMU by setting per-port bits in
+ * pericfg_ao, which survive a warm reboot. U-Boot has no IOMMU driver, so
+ * clear them; otherwise PCIe devices (eg. an xHCI) cannot do DMA.
+ */
+static void mt8195_pcie_iommu_bypass(void)
+{
+	ofnode node;
+	fdt_addr_t base;
+
+	node = ofnode_by_compatible(ofnode_null(), "mediatek,mt8195-pericfg_ao");
+	if (!ofnode_valid(node))
+		return;
+
+	base = ofnode_get_addr(node);
+	if (base == FDT_ADDR_T_NONE)
+		return;
+
+	clrbits_le32(base + PERICFG_IOMMU_1, PERICFG_IOMMU_PCIE);
+}
+
 /*
  * Without other unique storage, use the UFS serial number as serial# (also
  * passed to the OS) and derive a stable, locally administered MAC address
@@ -49,6 +76,7 @@ int board_late_init(void)
 	if (CONFIG_DEFAULT_FDT_FILE[0] && !env_get("fdtfile"))
 		env_set("fdtfile", CONFIG_DEFAULT_FDT_FILE);
 
+	mt8195_pcie_iommu_bypass();
 	mt8195_setup_serial_and_ethaddr();
 
 	return 0;
