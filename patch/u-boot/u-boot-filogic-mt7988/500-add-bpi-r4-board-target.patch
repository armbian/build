--- /dev/null
+++ b/board/mediatek/mt7988/bananapi_bpi-r4.env
@@ -0,0 +1,15 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+
+/* bootflow scan fallback after the rootfs on mmc 0:5: NVMe on the M.2 key-M slot, then USB */
+boot_targets=nvme usb
+/* dhcp only configures the network, it does not start a TFTP load */
+autoload=no
+scriptaddr=0x50000000
+pxefile_addr_r=0x50100000
+kernel_addr_r=0x52000000
+kernel_comp_addr_r=0x5a000000
+kernel_comp_size=0x4000000
+fdt_addr_r=0x62000000
+fdtoverlay_addr_r=0x62100000
+ramdisk_addr_r=0x62180000
+fdtfile=DEFAULT_FDT_FILE
