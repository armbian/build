From: mingzq <north_sea@qq.com>
Date: Tue, 14 Jul 2026 00:00:00 +0000
Subject: rockchip: fit: select environment FIT partition with boot_a fallback

Let the boot_fit command select a GPT partition through boot_fit_part.
When the variable is unset, preserve the existing boot/recovery selection;
if the legacy boot partition does not exist, fall back to boot_a. This keeps
ordinary non-A/B boot behaviour unchanged while allowing an A/B raw-FIT image
to boot on its first run, before its persistent U-Boot environment exists.

Do not fall back when boot_fit_part was explicitly selected: an attempted
boot of boot_b must not silently boot boot_a instead.
---
 arch/arm/mach-rockchip/fit.c | 23 ++++++++--
 1 file changed, 18 insertions(+), 5 deletions(-)

diff --git a/arch/arm/mach-rockchip/fit.c b/arch/arm/mach-rockchip/fit.c
index 111111111111..222222222222 100644
--- a/arch/arm/mach-rockchip/fit.c
+++ b/arch/arm/mach-rockchip/fit.c
@@ -145,18 +145,31 @@ static void *fit_get_blob(struct blk_desc *dev_desc,
 {
 	__maybe_unused int conf_noffset;
 	disk_partition_t part;
-	char *part_name = PART_BOOT;
+	const char *part_name = env_get("boot_fit_part");
+	bool fallback_boot_a = false;
 	void *fit, *fdt;
 	int blk_num;
 
+	if (!part_name || !*part_name) {
+		part_name = PART_BOOT;
+		fallback_boot_a = true;
 #ifndef CONFIG_ANDROID_AB
-	if (rockchip_get_boot_mode() == BOOT_MODE_RECOVERY)
-		part_name = PART_RECOVERY;
+		if (rockchip_get_boot_mode() == BOOT_MODE_RECOVERY) {
+			part_name = PART_RECOVERY;
+			fallback_boot_a = false;
+		}
 #endif
+	}
 
 	if (part_get_info_by_name(dev_desc, part_name, &part) < 0) {
-		FIT_I("No %s partition\n", part_name);
-		return NULL;
+		if (!fallback_boot_a ||
+		    part_get_info_by_name(dev_desc, "boot_a", &part) < 0) {
+			FIT_I("No %s partition\n", part_name);
+			return NULL;
+		}
+
+		FIT_I("No %s partition, falling back to boot_a\n", part_name);
+		part_name = "boot_a";
 	}
 
 	*out_part = part;
-- 
Armbian

