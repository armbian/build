From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mingzq <north_sea@qq.com>
Date: Mon, 27 Jul 2026 02:50:47 +0000
Subject: rockchip: boot OS from scanned device after SPI NOR boot

SPI NOR contains the bootloader, not the operating system. After SPI boot,
scan the usual OS targets and enumerate PCIe before checking NVMe.

The vendor configuration enables Android bootloader support. Its FIT loader
first checks android_get_bootdev(), which is unset before the Android flow.
Only at FIT-load time, fall back to the RKIMG-selected descriptor so recovery
images can load from NVMe without causing PCIe scans during early init.
---
 arch/arm/mach-rockchip/boot_rkimg.c | 9 ++++++++-
 arch/arm/mach-rockchip/fit.c        | 2 ++
 include/configs/rockchip-common.h   | 2 +-
 3 files changed, 11 insertions(+), 2 deletions(-)

diff --git a/arch/arm/mach-rockchip/boot_rkimg.c b/arch/arm/mach-rockchip/boot_rkimg.c
index 111111111111..222222222222 100644
--- a/arch/arm/mach-rockchip/boot_rkimg.c
+++ b/arch/arm/mach-rockchip/boot_rkimg.c
@@ -111,7 +111,14 @@ static void boot_devtype_init(void)
 	/* atags */
 #ifdef CONFIG_ROCKCHIP_PRELOADER_ATAGS
 	if (!param_parse_atags_bootdev(&devtype, &devnum)) {
-		if (!bootdev_init(devtype, devnum)) {
+		/*
+		 * SPI NOR contains the bootloader, not the operating system.
+		 * When SPL reports mtd 2, continue to rkimg_bootdev so that
+		 * SD, NVMe, SCSI and eMMC remain available as OS boot targets.
+		 */
+		if (!strcmp(devtype, "mtd") && !strcmp(devnum, "2")) {
+			printf("Booted from SPI NOR; scanning OS boot devices\n");
+		} else if (!bootdev_init(devtype, devnum)) {
 			src = "atags";
 			goto finish;
 		}
diff --git a/arch/arm/mach-rockchip/fit.c b/arch/arm/mach-rockchip/fit.c
index 111111111111..222222222222 100644
--- a/arch/arm/mach-rockchip/fit.c
+++ b/arch/arm/mach-rockchip/fit.c
@@ -417,6 +417,8 @@ void *fit_image_load_bootables(ulong *size)
 
 #ifdef CONFIG_ANDROID_BOOTLOADER
 	dev_desc = android_get_bootdev();
+	if (!dev_desc)
+		dev_desc = rockchip_get_bootdev();
 #else
 	dev_desc = rockchip_get_bootdev();
 #endif
diff --git a/include/configs/rockchip-common.h b/include/configs/rockchip-common.h
index 111111111111..222222222222 100644
--- a/include/configs/rockchip-common.h
+++ b/include/configs/rockchip-common.h
@@ -172,7 +172,7 @@
 	"rkimg_bootdev=" \
 	"if mmc dev 1 && rkimgtest mmc 1; then " \
 		"setenv devtype mmc; setenv devnum 1; echo Boot from SDcard;" \
-	"elif nvme dev 0; then " \
+	"elif pci enum && nvme scan && nvme dev 0; then " \
 		"setenv devtype nvme; setenv devnum 0; echo Boot from nvme;" \
 	"elif nvme dev 1; then " \
 		"setenv devtype nvme; setenv devnum 1; echo Boot from nvme;" \
-- 
