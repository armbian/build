From 689755b9dae1bff8fd19ee4dfdf8a4b959ed786c Mon Sep 17 00:00:00 2001
From: Ricardo Pardini <ricardo@pardini.net>
Date: Fri, 23 Oct 2026 01:10:12 +0200
Subject: [PATCH] DEBUG: power_delivery: tcpm/fusb302: PD console tracing for
 Blade 3

- TYPEC_TCPM_DEBUG_CONSOLE (default y): print all tcpm/fusb302 debug() on
  the console, prefixed with ms since power-on
- board: print boot_mode, whether the kernel DTB is in use (no connector
  node without it) and the fusb302 probe result
- fusb302: before sw reset, dump registers, latched IRQs and decode
  stale RX FIFO messages; dump registers again at handover
- fusb302: report RX FIFO left non-empty after TX_SUCCESS/GCRCSENT reads
- tcpm_poll_event: log start, READY reached, 1 s heartbeat while
  spinning, final state, contract and source caps

Armbian only, not for upstream.

Assisted-by: Claude Opus 5.5
Signed-off-by: Ricardo Pardini <ricardo@pardini.net>
---
 arch/arm/mach-rockchip/board.c          |  13 ++-
 drivers/power/power_delivery/Kconfig    |   9 ++
 drivers/power/power_delivery/fusb302.c  | 109 ++++++++++++++++++++++++
 drivers/power/power_delivery/pd-debug.h |  26 ++++++
 drivers/power/power_delivery/tcpm.c     |  27 ++++++
 5 files changed, 183 insertions(+), 1 deletion(-)
 create mode 100644 drivers/power/power_delivery/pd-debug.h

diff --git a/arch/arm/mach-rockchip/board.c b/arch/arm/mach-rockchip/board.c
index 69488183625..56819e00497 100644
--- a/arch/arm/mach-rockchip/board.c
+++ b/arch/arm/mach-rockchip/board.c
@@ -456,18 +456,29 @@ static void scan_run_cmd(void)
 static void power_delivery_func(void)
 {
 	struct udevice *dev;
-	uclass_get_device_by_driver(UCLASS_PD,
+	int ret;
+
+	/* DEBUG (Armbian): without the kernel DTB there is no connector node */
+	printf("[%7lu] pd: probing fusb302, kernel dtb %s\n", get_timer(0),
+	       gd->flags & GD_FLG_KDTB_READY ? "in use" : "NOT in use");
+	ret = uclass_get_device_by_driver(UCLASS_PD,
 			DM_GET_DRIVER(fusb302), &dev);
+	printf("[%7lu] pd: fusb302 probe ret=%d%s%s\n", get_timer(0), ret,
+	       ret ? "" : ", dev ", ret ? "" : dev->name);
 }
 
 int board_late_init(void)
 {
 	int boot_mode;
 	boot_mode = readl((void *)CONFIG_ROCKCHIP_BOOT_MODE_REG);
+	printf("[%7lu] pd: boot_mode 0x%x\n", get_timer(0), boot_mode);
 	if (boot_mode == BOOT_MODE_NORMAL ||
 			boot_mode == BOOT_MODE_RECOVERY ||
 			boot_mode == BOOT_MODE_UNDEFINE) {
 		power_delivery_func();
+	} else {
+		printf("[%7lu] pd: boot_mode 0x%x, skipping fusb302\n",
+		       get_timer(0), boot_mode);
 	}
 
 #ifdef CONFIG_ROCKCHIP_SET_ETHADDR
diff --git a/drivers/power/power_delivery/Kconfig b/drivers/power/power_delivery/Kconfig
index b320c92d69c..f3c01ca4e5b 100644
--- a/drivers/power/power_delivery/Kconfig
+++ b/drivers/power/power_delivery/Kconfig
@@ -13,6 +13,15 @@ config TYPEC_TCPM
 	  The Type-C Port Controller Manager provides a USB PD and USB Type-C
 	  state machine for use with Type-C Port Controllers.
 
+config TYPEC_TCPM_DEBUG_CONSOLE
+	bool "Print TCPM / FUSB302 debug messages on the console (DEBUG)"
+	depends on TYPEC_TCPM
+	default y
+	help
+	  DEBUG (Armbian, not for upstream): print all debug() messages of
+	  the TCPM and FUSB302 drivers on the console, with a millisecond
+	  timestamp. Slows down PD handling.
+
 config TYPEC_TCPCI
 	tristate "Type-C Port Controller Interface driver"
 	depends on DM && DM_POWER_DELIVERY && DM_I2C
diff --git a/drivers/power/power_delivery/fusb302.c b/drivers/power/power_delivery/fusb302.c
index cf64df4ca4f..8f3a64f6274 100644
--- a/drivers/power/power_delivery/fusb302.c
+++ b/drivers/power/power_delivery/fusb302.c
@@ -12,6 +12,7 @@
 #include <power/power_delivery/power_delivery.h>
 #include "fusb302_reg.h"
 #include <irq-generic.h>
+#include "pd-debug.h"
 /*
  * When the device is SNK, BC_LVL interrupt is used to monitor cc pins
  * for the current capability offered by the SRC. As FUSB302 chip fires
@@ -165,6 +166,100 @@ static int fusb302_i2c_clear_bits(struct fusb302_chip *chip, u8 address,
 	return fusb302_i2c_mask_write(chip, address, clear_bits, 0x00);
 }
 
+/*
+ * DEBUG (Armbian, DO NOT UPSTREAM): dump the chip registers. Before the sw
+ * reset this shows what the previous boot / power loss left behind.
+ */
+static void fusb302_dump_regs(struct fusb302_chip *chip, const char *when)
+{
+	static const u8 regs[] = {
+		FUSB_REG_SWITCHES0, FUSB_REG_SWITCHES1, FUSB_REG_CONTROL0,
+		FUSB_REG_CONTROL2, FUSB_REG_CONTROL3, FUSB_REG_MASK,
+		FUSB_REG_POWER, FUSB_REG_MASKA, FUSB_REG_MASKB,
+		FUSB_REG_STATUS0A, FUSB_REG_STATUS1A, FUSB_REG_STATUS0,
+		FUSB_REG_STATUS1,
+	};
+	char buf[160];
+	int len = 0;
+	unsigned int i;
+	u8 data;
+
+	for (i = 0; i < ARRAY_SIZE(regs); i++) {
+		if (fusb302_i2c_read(chip, regs[i], &data))
+			return;
+		len += snprintf(buf + len, sizeof(buf) - len, " %02x=%02x",
+				regs[i], data);
+	}
+	pd_info("fusb302 regs %s:%s\n", when, buf);
+}
+
+/*
+ * DEBUG (Armbian, DO NOT UPSTREAM): before the sw reset wipes it, decode any
+ * PD message the partner sent (and the chip auto-acked) that nobody read.
+ * Reading the interrupt registers clears them, so read them here too.
+ */
+static void fusb302_dump_stale_state(struct fusb302_chip *chip)
+{
+	__le32 payload[PD_MAX_PAYLOAD];
+	u8 data, token, crc[4];
+	u8 irq, irqa, irqb;
+	unsigned int i, n, cnt;
+	__le16 hdr_le;
+	char buf[100];
+	int len;
+	u16 hdr;
+
+	fusb302_dump_regs(chip, "pre-reset");
+	if (fusb302_i2c_read(chip, FUSB_REG_INTERRUPT, &irq) ||
+	    fusb302_i2c_read(chip, FUSB_REG_INTERRUPTA, &irqa) ||
+	    fusb302_i2c_read(chip, FUSB_REG_INTERRUPTB, &irqb))
+		return;
+	pd_info("fusb302 pre-reset latched IRQ: 0x%02x, a: 0x%02x, b: 0x%02x\n",
+		irq, irqa, irqb);
+
+	for (n = 0; n < 8; n++) {
+		if (fusb302_i2c_read(chip, FUSB_REG_STATUS1, &data))
+			return;
+		if (data & FUSB_REG_STATUS1_RX_EMPTY)
+			break;
+		if (fusb302_i2c_read(chip, FUSB_REG_FIFOS, &token) ||
+		    fusb302_i2c_block_read(chip, FUSB_REG_FIFOS, 2,
+					   (u8 *)&hdr_le))
+			return;
+		hdr = le16_to_cpu(hdr_le);
+		cnt = pd_header_cnt(hdr);
+		if (cnt && fusb302_i2c_block_read(chip, FUSB_REG_FIFOS, cnt * 4,
+						  (u8 *)payload))
+			return;
+		if (fusb302_i2c_block_read(chip, FUSB_REG_FIFOS, 4, crc))
+			return;
+		len = 0;
+		buf[0] = '\0';
+		for (i = 0; i < cnt; i++)
+			len += snprintf(buf + len, sizeof(buf) - len, " %08x",
+					le32_to_cpu(payload[i]));
+		pd_info("fusb302 pre-reset stale RX msg %u: sop=%02x hdr=%04x %s type=%u id=%u rev=%u%s\n",
+			n, token, hdr, cnt ? "DATA" : "CTRL", pd_header_type(hdr),
+			pd_header_msgid(hdr), pd_header_rev(hdr) + 1, buf);
+	}
+	pd_info("fusb302 pre-reset stale RX FIFO: %u message(s)\n", n);
+}
+
+/*
+ * DEBUG (Armbian, DO NOT UPSTREAM): this driver reads one message per
+ * TX_SUCCESS / GCRCSENT; report when more are left in the RX FIFO.
+ */
+static void fusb302_check_rx_left(struct fusb302_chip *chip, const char *irq)
+{
+	u8 data;
+
+	if (fusb302_i2c_read(chip, FUSB_REG_STATUS1, &data))
+		return;
+	if (!(data & FUSB_REG_STATUS1_RX_EMPTY))
+		pd_info("fusb302 %s: RX FIFO NOT empty after read (status1=0x%02x)\n",
+			irq, data);
+}
+
 static int fusb302_sw_reset(struct fusb302_chip *chip)
 {
 	int ret = 0;
@@ -251,6 +346,8 @@ static int tcpm_init(struct tcpc_dev *dev)
 	int ret = 0;
 	u8 data;
 
+	fusb302_dump_stale_state(chip);
+
 	ret = fusb302_sw_reset(chip);
 	if (ret)
 		return ret;
@@ -1429,6 +1526,7 @@ static void fusb302_interrupt_handle(struct fusb302_chip *chip)
 			printf("cannot read in PD message, ret=%d\n", ret);
 			return;
 		}
+		fusb302_check_rx_left(chip, "TX_SUCCESS");
 	}
 
 	if (interrupta & FUSB_REG_INTERRUPTA_HARDRESET) {
@@ -1448,6 +1546,7 @@ static void fusb302_interrupt_handle(struct fusb302_chip *chip)
 			printf("cannot read in PD message, ret=%d\n", ret);
 			return;
 		}
+		fusb302_check_rx_left(chip, "GCRCSENT");
 	}
 }
 
@@ -1462,6 +1561,7 @@ static int fusb302_probe(struct udevice *dev)
 	struct fusb302_chip *chip = dev_get_priv(dev);
 
 	chip->udev = dev;
+	pd_info("fusb302 probe %s (%s)\n", dev->name, dev->parent->name);
 #if 0
 	/* get vbus regulator */
 	ret = regulator_get_by_platname("vbus5v0_typec", chip->vbus_regulator);
@@ -1475,6 +1575,10 @@ static int fusb302_probe(struct udevice *dev)
 		printf("%s: 'connector' node is not found\n", __func__);
 		return -ENODEV;
 	}
+	pd_info("fusb302 connector %s, label %s, power-role %s\n",
+		ofnode_get_name(chip->tcpc_dev.connector_node),
+		ofnode_read_string(chip->tcpc_dev.connector_node, "label") ?: "-",
+		ofnode_read_string(chip->tcpc_dev.connector_node, "power-role") ?: "-");
 
 	init_tcpc_dev(&chip->tcpc_dev);
 	chip->tcpm_port = tcpm_port_init(dev, &chip->tcpc_dev);
@@ -1491,7 +1595,12 @@ static int fusb302_probe(struct udevice *dev)
 	irq_install_handler(chip->irq, fusb302_irq_intn, chip);
 	irq_set_irq_type(chip->irq, IRQ_TYPE_EDGE_FALLING | IRQ_TYPE_LEVEL_LOW);
 	irq_handler_enable(chip->irq);
+	pd_info("fusb302 irq %d enabled, polling\n", chip->irq);
 	tcpm_poll_event(chip->tcpm_port);
+	fusb302_dump_regs(chip, "at handover");
+	pd_info("fusb302 probe done: %u mV %u mA\n",
+		tcpm_get_voltage(chip->tcpm_port) / 1000,
+		tcpm_get_current(chip->tcpm_port) / 1000);
 	return 0;
 }
 
diff --git a/drivers/power/power_delivery/pd-debug.h b/drivers/power/power_delivery/pd-debug.h
new file mode 100644
index 00000000000..473fbfce702
--- /dev/null
+++ b/drivers/power/power_delivery/pd-debug.h
@@ -0,0 +1,26 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+/*
+ * DEBUG (Armbian, DO NOT UPSTREAM): with CONFIG_TYPEC_TCPM_DEBUG_CONSOLE,
+ * print every debug() of the TCPM / FUSB302 drivers on the console, prefixed
+ * with the milliseconds since SoC power-on, so the USB PD timeline can be
+ * correlated with the source's timeouts.
+ *
+ * Must be included after <common.h>.
+ */
+
+#ifndef __PD_DEBUG_H
+#define __PD_DEBUG_H
+
+#include <common.h>
+
+#ifdef CONFIG_TYPEC_TCPM_DEBUG_CONSOLE
+#undef debug
+#define debug(fmt, ...)						\
+	printf("[%7lu] pd: " fmt, get_timer(0), ##__VA_ARGS__)
+#endif
+
+/* Always printed, timestamped */
+#define pd_info(fmt, ...)					\
+	printf("[%7lu] pd: " fmt, get_timer(0), ##__VA_ARGS__)
+
+#endif /* __PD_DEBUG_H */
diff --git a/drivers/power/power_delivery/tcpm.c b/drivers/power/power_delivery/tcpm.c
index 6b628bafa26..e81ecd8679e 100644
--- a/drivers/power/power_delivery/tcpm.c
+++ b/drivers/power/power_delivery/tcpm.c
@@ -13,6 +13,7 @@
 #include <rk_timer_irq.h>
 #include <power/power_delivery/tcpm.h>
 #include <power/power_delivery/pd_vdo.h>
+#include "pd-debug.h"
 
 #define FOREACH_STATE(S)			\
 	S(INVALID_STATE),			\
@@ -3512,11 +3513,23 @@ EXPORT_SYMBOL_GPL(tcpm_port_init);
 
 void tcpm_poll_event(struct tcpm_port *port)
 {
+	ulong start, next;
+	int i;
+
 	port->time_count = 3000;
+	pd_info("tcpm poll start: vbus %d, state %s\n",
+		port->tcpc->get_vbus(port->tcpc), tcpm_states[port->state]);
 	if (!port->tcpc->get_vbus(port->tcpc)) {
+		pd_info("tcpm poll: no VBUS, nothing to do\n");
 		return ;
 	}
 
+	/*
+	 * DEBUG: the get_timer() call also makes the compiler re-read
+	 * port->state, which only changes in IRQ context.
+	 */
+	start = get_timer(0);
+	next = 1000;
 	while (port->poll_event_cnt < TCPM_POLL_EVENT_TIME_OUT) {
 		if (!port->wait_dr_swap_Message &&
 		    ((port->state == SNK_READY) ||
@@ -3524,12 +3537,26 @@ void tcpm_poll_event(struct tcpm_port *port)
 		    (port->state == DEBUG_ACC_ATTACHED) ||
 		    (port->state == AUDIO_ACC_ATTACHED)))
 		    break;
+		if (get_timer(start) >= next) {
+			pd_info("tcpm poll: still waiting for READY after %lu ms, state %s\n",
+				next, tcpm_states[port->state]);
+			next += 1000;
+		}
 	}
+	pd_info("tcpm poll: %s after %lu ms, waiting %d ms more\n",
+		tcpm_states[port->state], get_timer(start), port->time_count);
 
 	while (port->time_count > 0) {
 		port->time_count--;
 		udelay(1000);
 	}
+
+	pd_info("tcpm poll end: state %s, pd_capable %d, rev %u, %u mV %u mA, hard resets %u\n",
+		tcpm_states[port->state], port->pd_capable,
+		port->negotiated_rev + 1, port->supply_voltage,
+		port->current_limit, port->hard_reset_count);
+	for (i = 0; i < port->nr_source_caps; i++)
+		pd_info("tcpm source cap %d: 0x%08x\n", i, port->source_caps[i]);
 	/*
 	 * At this time, call the callback function of the respective pd chip
 	 * to enter the low-power mode. In order to reduce the time spent on
-- 
