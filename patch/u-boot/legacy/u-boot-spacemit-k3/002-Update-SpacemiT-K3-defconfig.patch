From 7f56061433f739424eea0d7abd8a57c374ddd066 Mon Sep 17 00:00:00 2001
From: Patrick Yavitz <pyavitz@gmail.com>
Date: Thu, 18 Jun 2026 07:02:43 -0400
Subject: [PATCH] Update SpacemiT K3 defconfig

Rebased onto k3-br-v1.0.7. Keep CONFIG_SPL_SIZE_LIMIT=0x72F00 (BootROM
max-download-size is 0x74000; packaged FSBL = SPL + ~4KB NSIH header must stay
under it). v1.0.7's SPL grew past 0x72F00, so drop the SPL-only efuse driver
(CONFIG_SPL_SPACEMIT_K1X_EFUSE) and its now-unused misc uclass
(CONFIG_SPL_DRIVERS_MISC) to fit; the full efuse driver stays in u-boot proper.

Signed-off-by: Patrick Yavitz <pyavitz@gmail.com>
---
 configs/k3_defconfig | 40 +++++++++++++++++-----------------------

diff --git a/configs/k3_defconfig b/configs/k3_defconfig
index 9e1ffd39..1a38166b 100644
--- a/configs/k3_defconfig
+++ b/configs/k3_defconfig
@@ -9,7 +9,7 @@ CONFIG_SPL_DM_SPI=y
 CONFIG_DEFAULT_DEVICE_TREE="k3_spl"
 CONFIG_SPL_TEXT_BASE=0xc0801000
 CONFIG_SPL_MMC=y
-CONFIG_SPL_DRIVERS_MISC=y
+# CONFIG_SPL_DRIVERS_MISC is not set
 CONFIG_SPL_SYS_MALLOC_F_LEN=0x8000
 CONFIG_SPL_SIZE_LIMIT=0x72F00
 CONFIG_SPL=y
@@ -25,7 +25,9 @@ CONFIG_ARCH_RV64I=y
 CONFIG_RISCV_SMODE=y
 # CONFIG_RISCV_ISA_C is not set
 # CONFIG_SPL_SMP is not set
-CONFIG_ENV_VARS_UBOOT_CONFIG=y
+CONFIG_LOCALVERSION=" Armbian"
+# CONFIG_LOCALVERSION_AUTO is not set
+CONFIG_DISTRO_DEFAULTS=y
 CONFIG_HAS_CUSTOM_SYS_INIT_SP_ADDR=y
 CONFIG_CUSTOM_SYS_INIT_SP_ADDR=0x102300000
 CONFIG_STACK_SIZE=0x100000
@@ -34,16 +36,14 @@ CONFIG_FIT=y
 # CONFIG_FIT_FULL_CHECK is not set
 CONFIG_SPL_LOAD_FIT_ADDRESS=0x140000000
 CONFIG_SPL_FIT_IMAGE_POST_PROCESS=y
-# CONFIG_BOOTSTD is not set
-# CONFIG_LEGACY_IMAGE_FORMAT is not set
-CONFIG_SUPPORT_RAW_INITRD=y
+CONFIG_BOOTSTD_FULL=y
+CONFIG_BOOTSTD_BOOTCOMMAND=y
 CONFIG_OF_BOARD_SETUP=y
-CONFIG_BOOTDELAY=0
+CONFIG_SD_BOOT=y
 CONFIG_AUTOBOOT_KEYED=y
 CONFIG_AUTOBOOT_STOP_STR="s"
-CONFIG_USE_BOOTCOMMAND=y
-CONFIG_LOGLEVEL=7
-CONFIG_SPL_LOGLEVEL=1
+CONFIG_BOOTCOMMAND="run distro_bootcmd"
+CONFIG_LOGLEVEL=1
 # CONFIG_SYS_DEVICE_NULLDEV is not set
 CONFIG_DISPLAY_CPUINFO=y
 CONFIG_DISPLAY_BOARDINFO=y
@@ -77,7 +77,6 @@ CONFIG_SPL_FASTBOOT_LOAD=y
 CONFIG_SPL_USB_SDP_SUPPORT=y
 CONFIG_SPL_OPENSBI_SCRATCH_OPTIONS=0x0
 CONFIG_FDT_SIMPLEFB=y
-CONFIG_HUSH_PARSER=y
 CONFIG_SYS_CBSIZE=512
 CONFIG_SYS_PBSIZE=532
 CONFIG_CMD_TCPM=y
@@ -90,8 +89,7 @@ CONFIG_SYS_BOOTM_LEN=0x20000000
 # CONFIG_CMD_ELF is not set
 CONFIG_CMD_NVEDIT_EFI=y
 CONFIG_CMD_MD5SUM=y
-# CONFIG_CMD_LZMADEC is not set
-# CONFIG_CMD_UNLZ4 is not set
+CONFIG_CMD_ZIP=y
 CONFIG_CMD_GPIO=y
 CONFIG_CMD_PWM=y
 CONFIG_CMD_GPT=y
@@ -100,28 +98,22 @@ CONFIG_CMD_I2C=y
 CONFIG_CMD_MMC=y
 CONFIG_CMD_BKOPS_ENABLE=y
 CONFIG_CMD_MTD=y
-CONFIG_CMD_PART=y
 CONFIG_CMD_PCI=y
 CONFIG_CMD_ESPI=y
 CONFIG_CMD_UFS=y
 CONFIG_CMD_USB=y
 CONFIG_CMD_USB_MASS_STORAGE=y
 CONFIG_CMD_WDT=y
-CONFIG_CMD_DHCP=y
+CONFIG_CMD_SETEXPR_FMT=y
 CONFIG_SYS_DISABLE_AUTOLOAD=y
-CONFIG_CMD_PING=y
-CONFIG_CMD_PXE=y
 CONFIG_CMD_BMP=y
 # CONFIG_CMD_BLOCK_CACHE is not set
 CONFIG_CMD_CLS=y
 CONFIG_CMD_EFIDEBUG=y
 CONFIG_CMD_TIME=y
-CONFIG_CMD_SYSBOOT=y
-CONFIG_CMD_EXT2=y
-CONFIG_CMD_EXT4=y
-CONFIG_CMD_FAT=y
+CONFIG_CMD_UUID=y
+CONFIG_CMD_BTRFS=y
 CONFIG_CMD_SQUASHFS=y
-CONFIG_CMD_FS_GENERIC=y
 CONFIG_CMD_FS_UUID=y
 CONFIG_CMD_MTDPARTS=y
 CONFIG_MTDIDS_DEFAULT="nor0=d420c000.spi"
@@ -178,7 +170,7 @@ CONFIG_SYS_I2C_EEPROM_ADDR=0x50
 CONFIG_FS_LOADER=y
 CONFIG_SPL_FS_LOADER=y
 CONFIG_SPACEMIT_K1X_EFUSE=y
-CONFIG_SPL_SPACEMIT_K1X_EFUSE=y
+# CONFIG_SPL_SPACEMIT_K1X_EFUSE is not set
 CONFIG_HWMON_SENSORS_CTF2301=y
 CONFIG_RT7451_RETIMER=y
 CONFIG_MMC=y
@@ -252,7 +244,6 @@ CONFIG_TYPEC_TCPM=y
 CONFIG_TYPEC_FUSB301=y
 CONFIG_TYPEC_SWITCH=y
 CONFIG_TYPEC_SWITCH_GPIO_SBU=y
-CONFIG_USB_STORAGE=y
 CONFIG_USB_KEYBOARD=y
 # CONFIG_USB_KEYBOARD_FN_KEYS is not set
 CONFIG_SYS_USB_EVENT_POLL_COMPATIBLE=y
@@ -279,11 +270,14 @@ CONFIG_DISPLAY_SPACEMIT_MIPI=y
 CONFIG_DISPLAY_SPACEMIT_DPI=y
 CONFIG_DISPLAY_SPACEMIT_INNO_DP=y
 CONFIG_WDT_SPACEMIT=y
+CONFIG_EXT4_WRITE=y
 CONFIG_PRINT_TIMESTAMP=y
 # CONFIG_SPL_SHA1 is not set
 # CONFIG_SPL_SHA256 is not set
+# CONFIG_VPL_LZMA is not set
 CONFIG_SPL_LZO=y
 # CONFIG_HEXDUMP is not set
+CONFIG_OF_LIBFDT_OVERLAY=y
 # CONFIG_GENERATE_SMBIOS_TABLE is not set
 CONFIG_EFI_VARIABLE_NO_STORE=y
 CONFIG_LMB_MAX_REGIONS=32
-- 
2.53.0
