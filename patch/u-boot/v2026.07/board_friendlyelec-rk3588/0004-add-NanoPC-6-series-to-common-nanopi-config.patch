+++ b/arch/arm/dts/rk3588s-nanopi6-series-u-boot.dtsi
@@ -18,6 +18,11 @@
 	bootph-some-ram;
 };
 
+&fspim1_pins {
+	bootph-pre-ram;
+	bootph-some-ram;
