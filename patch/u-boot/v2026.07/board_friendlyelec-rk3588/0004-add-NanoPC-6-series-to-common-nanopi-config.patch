 arch/arm/dts/rk3588-nanopc-t6-lts-plus-u-boot.dtsi                 |  3 +
 arch/arm/dts/rk3588s-nanopi6-series-u-boot.dtsi                    |  5 +
 board/friendlyelec/nanopi6-series-rk3588s/nanopi6-series-rk3588s.c | 58 ++++++++--
 configs/nanopi6-series-rk3588s_defconfig                           |  2 +-
 dts/upstream/src/arm64/rockchip/rk3588-nanopc-t6-lts-plus.dts      | 38 ++++++
 dts/upstream/src/arm64/rockchip/rk3588s-nanopi6-series.dts         |  1 +
 6 files changed, 95 insertions(+), 12 deletions(-)

diff --git a/arch/arm/dts/rk3588-nanopc-t6-lts-plus-u-boot.dtsi b/arch/arm/dts/rk3588-nanopc-t6-lts-plus-u-boot.dtsi
