From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Igor Pecovnik <igor@armbian.com>
Date: Wed, 7 Oct 2026 19:00:00 +0200
Subject: nanopi6-series: fall back to compiled env when T6 SPI flash is absent

---
 board/friendlyelec/nanopi6-series-rk3588s/nanopi6-series-rk3588s.c | 11 ++++++++++-
 1 file changed, 10 insertions(+), 1 deletion(-)

diff --git a/board/friendlyelec/nanopi6-series-rk3588s/nanopi6-series-rk3588s.c b/board/friendlyelec/nanopi6-series-rk3588s/nanopi6-series-rk3588s.c
index 222222222222..333333333333 100644
--- a/board/friendlyelec/nanopi6-series-rk3588s/nanopi6-series-rk3588s.c
+++ b/board/friendlyelec/nanopi6-series-rk3588s/nanopi6-series-rk3588s.c
@@ -95,8 +95,17 @@ enum env_location env_get_location(enum env_operation op, int prio)
 	(void)op;
 	model = get_board_model();

+	/*
+	 * T6-LTS-Plus units without a populated SPI NOR chip fail this read
+	 * silently and end up with an empty environment - kernel_addr_r,
+	 * fdt_addr_r and ramdisk_addr_r from CFG_EXTRA_ENV_SETTINGS never
+	 * get applied, so every "load ... ${kernel_addr_r} ..." in boot.scr
+	 * fails on an empty address. Fall back to the compiled-in defaults
+	 * (ENVL_NOWHERE) when SPI flash has nothing valid, same as every
+	 * other board in this family already does at prio 0.
+	 */
 	if (is_t6(model))
-		return prio == 0 ? ENVL_SPI_FLASH : ENVL_UNKNOWN;
+		return prio == 0 ? ENVL_SPI_FLASH : prio == 1 ? ENVL_NOWHERE : ENVL_UNKNOWN;

 	return prio == 0 ? ENVL_NOWHERE : ENVL_UNKNOWN;
 }
