From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Igor Pecovnik <igor@armbian.com>
Date: Wed, 7 Oct 2026 18:30:00 +0200
Subject: nanopi6-series: make misc_init_r() tolerant of OTP read failure

---
 board/friendlyelec/nanopi6-series-rk3588s/nanopi6-series-rk3588s.c | 36 +++++++++++++++
 1 file changed, 36 insertions(+)

diff --git a/board/friendlyelec/nanopi6-series-rk3588s/nanopi6-series-rk3588s.c b/board/friendlyelec/nanopi6-series-rk3588s/nanopi6-series-rk3588s.c
index 111111111111..222222222222 100644
--- a/board/friendlyelec/nanopi6-series-rk3588s/nanopi6-series-rk3588s.c
+++ b/board/friendlyelec/nanopi6-series-rk3588s/nanopi6-series-rk3588s.c
@@ -207,3 +207,39 @@ int board_fit_config_name_match(const char *name)

 	return -EINVAL;
 }
+
+/*
+ * T6-LTS-Plus fails to read its OTP/eFuse block (symptom: boot halts with
+ * "initcall misc_init_r() failed" before the console prompt). The generic
+ * weak misc_init_r() in arch/arm/mach-rockchip/board.c treats that as fatal.
+ * FriendlyElec's own vendor U-Boot never depends on the OTP read succeeding
+ * for this board family (it derives cpuid#/ethaddr from an external EEPROM
+ * instead) - mirror that here by making the same steps non-fatal rather
+ * than reimplementing their EEPROM path, so other models in the family keep
+ * getting a real cpuid#/ethaddr when the OTP read does succeed.
+ */
+#ifdef CONFIG_MISC_INIT_R
+int rockchip_cpuid_from_efuse(const u32 cpuid_offset, const u32 cpuid_length,
+			      u8 *cpuid);
+int rockchip_cpuid_set(const u8 *cpuid, const u32 cpuid_length);
+int rockchip_setup_macaddr(void);
+
+int misc_init_r(void)
+{
+	const u32 cpuid_offset = CFG_CPUID_OFFSET;
+	const u32 cpuid_length = 0x10;
+	u8 cpuid[cpuid_length];
+
+	if (rockchip_cpuid_from_efuse(cpuid_offset, cpuid_length, cpuid)) {
+		printf("misc_init_r: OTP/eFuse cpuid read failed, skipping\n");
+		return 0;
+	}
+
+	if (rockchip_cpuid_set(cpuid, cpuid_length))
+		return 0;
+
+	rockchip_setup_macaddr();
+
+	return 0;
+}
+#endif /* CONFIG_MISC_INIT_R */
--
