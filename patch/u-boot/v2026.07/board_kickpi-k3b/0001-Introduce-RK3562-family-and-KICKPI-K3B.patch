diff --git a/arch/arm/dts/rk3562-kickpi-k3b-u-boot.dtsi b/arch/arm/dts/rk3562-kickpi-k3b-u-boot.dtsi
new file mode 100644
index 00000000..8b67056d
--- /dev/null
+++ b/arch/arm/dts/rk3562-kickpi-k3b-u-boot.dtsi
@@ -0,0 +1,32 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+
+#include "rk3562-u-boot.dtsi"
+
+&sdmmc0 {
+	u-boot,spl-fifo-mode;
+};
+
+&vcc3v3_sd {
+	bootph-pre-ram;
+	bootph-some-ram;
+};
+
+&vcc3v3_sd_pin {
+	bootph-pre-ram;
+	bootph-some-ram;
+};
+
+&vcc_3v3 {
+	bootph-pre-ram;
+	bootph-some-ram;
+};
+
+&vccio_sd {
+	bootph-pre-ram;
+	bootph-some-ram;
+};
+
+&gpio0 {
+	bootph-pre-ram;
+	bootph-some-ram;
+};
diff --git a/arch/arm/dts/rk3562-u-boot.dtsi b/arch/arm/dts/rk3562-u-boot.dtsi
new file mode 100644
index 00000000..7ce00d8d
--- /dev/null
+++ b/arch/arm/dts/rk3562-u-boot.dtsi
@@ -0,0 +1,141 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * (C) Copyright 2026 Rockchip Electronics Co., Ltd
+ */
+
+#include "rockchip-u-boot.dtsi"
+
+/ {
+	aliases {
+		mmc0 = &sdhci;
+		mmc1 = &sdmmc0;
+	};
+
+	chosen {
+		u-boot,spl-boot-order = "same-as-spl", &sdmmc0, &sdhci;
+	};
+
+	dmc: dmc {
+		compatible = "rockchip,rk3562-dmc";
+		bootph-all;
+	};
+
+	otp: nvmem@ff930000 {
+		compatible = "rockchip,rk3562-otp";
+		reg = <0x0 0xff930000 0x0 0x4000>;
+		#address-cells = <1>;
+		#size-cells = <1>;
+
+		cpu_id: id@a {
+			reg = <0x0a 0x10>;
+		};
+	};
+};
+
+&cru {
+	bootph-all;
+};
+
+&emmc_bus8 {
+	bootph-pre-ram;
+	bootph-some-ram;
+};
+
+&emmc_clk {
+	bootph-pre-ram;
+	bootph-some-ram;
+};
+
+&emmc_cmd {
+	bootph-pre-ram;
+	bootph-some-ram;
+};
+
+&emmc_strb {
+	bootph-pre-ram;
+	bootph-some-ram;
+};
+
+&ioc_grf {
+	bootph-all;
+};
+
+&otp {
+	bootph-some-ram;
+};
+
+&pcfg_pull_none {
+	bootph-all;
+};
+
+&pcfg_pull_none_smt {
+	bootph-pre-ram;
+	bootph-some-ram;
+};
+
+&pcfg_pull_up {
+	bootph-all;
+};
+
+&pcfg_pull_up_drv_level_2 {
+	bootph-pre-ram;
+	bootph-some-ram;
+};
+
+&pinctrl {
+	bootph-all;
+};
+
+&pmu_grf {
+	bootph-all;
+};
+
+&rng {
+	status = "okay";
+};
+
+&sdhci {
+	bootph-pre-ram;
+	bootph-some-ram;
+	max-frequency = <200000000>;
+};
+
+&sdmmc0 {
+	bootph-pre-ram;
+	bootph-some-ram;
+};
+
+&sdmmc0_bus4 {
+	bootph-pre-ram;
+	bootph-some-ram;
+};
+
+&sdmmc0_clk {
+	bootph-pre-ram;
+	bootph-some-ram;
+};
+
+&sdmmc0_cmd {
+	bootph-pre-ram;
+	bootph-some-ram;
+};
+
+&sdmmc0_det {
+	bootph-pre-ram;
+	bootph-some-ram;
+};
+
+&uart0 {
+	bootph-all;
+	clock-frequency = <24000000>;
+	pinctrl-names = "default";
+	pinctrl-0 = <&uart0m0_xfer>;
+};
+
+&uart0m0_xfer {
+	bootph-all;
+};
+
+&xin24m {
+	bootph-all;
+};
