+#ifndef _ASM_ARCH_CRU_RK3562_H
+#define _ASM_ARCH_CRU_RK3562_H
+
+#define MHz		1000000
+#define KHz		1000
+#define OSC_HZ		(24 * MHz)
+
+#define CPU_PVTPLL_HZ	(1008 * MHz)
+#define APLL_HZ		(600 * MHz)
+#define GPLL_HZ		(1188 * MHz)
+#define CPLL_HZ		(1000 * MHz)
+#define HPLL_HZ		(1000 * MHz)
+
+/* RK3562 pll id */
+enum rk3562_pll_id {
+	APLL,
+	GPLL,
+	VPLL,
+	HPLL,
+	CPLL,
+	DPLL,
+	PLL_COUNT,
+};
+
+struct rk3562_clk_priv {
+	struct rk3562_cru *cru;
+	ulong gpll_hz;
+	ulong vpll_hz;
+	ulong hpll_hz;
+	ulong cpll_hz;
+	ulong armclk_hz;
+	ulong armclk_enter_hz;
+	ulong armclk_init_hz;
+	bool sync_kernel;
+	bool set_armclk_rate;
+};
+
+struct rk3562_cru {
+	/* top cru */
+	uint32_t apll_con[5];
+	uint32_t reserved0014[19];
+	uint32_t gpll_con[5];
+	uint32_t reserved0074[3];
+	uint32_t vpll_con[5];
