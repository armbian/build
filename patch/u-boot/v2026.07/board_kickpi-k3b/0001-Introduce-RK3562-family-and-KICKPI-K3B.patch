 }
 
+static void rockchip_combphy_updatel(struct rockchip_combphy_priv *priv,
+				     u32 mask, u32 val, u32 reg)
+{
+	u32 tmp;
+
+	tmp = readl(priv->mmio + reg);
+	tmp = (tmp & ~mask) | val;
+	writel(tmp, priv->mmio + reg);
+}
+
 static int rockchip_combphy_init(struct phy *phy)
 {
 	struct rockchip_combphy_priv *priv = dev_get_priv(phy->dev);
@@ -343,6 +356,148 @@ static const struct rockchip_combphy_cfg rk3528_combphy_cfgs = {
 	.combphy_cfg	= rk3528_combphy_cfg,
 };
 
+static int rk3562_combphy_cfg(struct rockchip_combphy_priv *priv)
+{
+	const struct rockchip_combphy_grfcfg *cfg = priv->cfg->grfcfg;
+	ulong rate;
+	u32 val;
+
+	switch (priv->mode) {
+	case PHY_TYPE_PCIE:
+		/* Set SSC downward spread spectrum */
+		val = 0x1 << 4;
+		rockchip_combphy_updatel(priv, GENMASK(7, 4), val, 0x7c);
+
+		param_write(priv->phy_grf, &cfg->con0_for_pcie, true);
+		param_write(priv->phy_grf, &cfg->con1_for_pcie, true);
+		param_write(priv->phy_grf, &cfg->con2_for_pcie, true);
+		param_write(priv->phy_grf, &cfg->con3_for_pcie, true);
+		break;
+	case PHY_TYPE_USB3:
+		/* Set SSC downward spread spectrum */
+		val = 0x1 << 4;
+		rockchip_combphy_updatel(priv, GENMASK(7, 4), val, 0x7c);
+
+		/* Enable adaptive CTLE for USB3.0 Rx */
+		rockchip_combphy_updatel(priv, BIT(0), BIT(0), 0x38);
+
+		/* Set PLL KVCO fine tuning signals */
+		rockchip_combphy_updatel(priv, GENMASK(4, 2), BIT(3), 0x80);
+
+		/* Set PLL LPF R1 to su_trim[10:7]=1001 */
+		writel(0x4, priv->mmio + 0x2c);
+
+		/* Set PLL input clock divider 1/2 */
+		rockchip_combphy_updatel(priv, GENMASK(7, 6), 0x1 << 6, 0x14);
+
+		/* Set PLL loop divider */
+		writel(0x32, priv->mmio + 0x44);
+
+		/* Set PLL KVCO to min and set PLL charge pump current to max */
+		writel(0xf0, priv->mmio + 0x28);
+
+		param_write(priv->phy_grf, &cfg->pipe_sel_usb, true);
+		param_write(priv->phy_grf, &cfg->pipe_txcomp_sel, false);
+		param_write(priv->phy_grf, &cfg->pipe_txelec_sel, false);
+		param_write(priv->phy_grf, &cfg->usb_mode_set, true);
+		break;
+	default:
+		dev_err(priv->dev, "incompatible PHY type\n");
+		return -EINVAL;
+	}
+
+	rate = clk_get_rate(&priv->ref_clk);
+	if (!rate || IS_ERR_VALUE(rate))
+		rate = REF_CLOCK_100MHz;
+
+	switch (rate) {
+	case REF_CLOCK_24MHz:
+		if (priv->mode == PHY_TYPE_USB3) {
+			/* Set ssc_cnt[9:0]=0101111101 & 31.5KHz */
+			rockchip_combphy_updatel(priv, GENMASK(7, 6), 0x1 << 6, 0x38);
+			writel(0x5f, priv->mmio + 0x3c);
+		}
+		break;
+	case REF_CLOCK_25MHz:
+		param_write(priv->phy_grf, &cfg->pipe_clk_25m, true);
+		break;
+	case REF_CLOCK_100MHz:
+		param_write(priv->phy_grf, &cfg->pipe_clk_100m, true);
+		if (priv->mode == PHY_TYPE_PCIE) {
+			/* Gate_tx_pck_sel length select for L1ss support */
+			rockchip_combphy_updatel(priv, BIT(7), BIT(7), 0x74);
+
+			/* PLL KVCO tuning fine */
+			rockchip_combphy_updatel(priv, GENMASK(4, 2), 0x2 << 2, 0x80);
+
+			/* Enable controlling random jitter */
+			writel(0x4, priv->mmio + 0x2c);
+
+			rockchip_combphy_updatel(priv, GENMASK(7, 6), 0x1 << 6, 0x14);
+
+			writel(0x32, priv->mmio + 0x44);
+			writel(0xf0, priv->mmio + 0x28);
+		}
+		break;
+	default:
+		dev_err(priv->dev, "Unsupported rate: %lu\n", rate);
+		return -EINVAL;
+	}
+
+	if (dev_read_bool(priv->dev, "rockchip,ext-refclk")) {
+		param_write(priv->phy_grf, &cfg->pipe_clk_ext, true);
+		if (priv->mode == PHY_TYPE_PCIE && rate == REF_CLOCK_100MHz) {
+			val = 0x3 << 4;
+			val |= BIT(7);
+			rockchip_combphy_updatel(priv, GENMASK(5, 4), val, 0x30);
+
+			val = readl(priv->mmio + 0x34);
+			val |= BIT(0);
+			writel(val, priv->mmio + 0x34);
+		}
+	}
+
+	if (dev_read_bool(priv->dev, "rockchip,enable-ssc")) {
+		val = readl(priv->mmio + 0x1c);
+		val |= BIT(4);
+		writel(val, priv->mmio + 0x1c);
+	}
+
+	return 0;
+}
+
+static const struct rockchip_combphy_grfcfg rk3562_combphy_grfcfgs = {
+	/* pipe-phy-grf */
+	.pcie_mode_set		= { 0x0000, 5, 0, 0x00, 0x11 },
