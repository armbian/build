 #include <dm/device_compat.h>
 
 #define BIT_WRITEABLE_SHIFT		16
+#define REF_CLOCK_24MHz			24000000
+#define REF_CLOCK_25MHz			25000000
+#define REF_CLOCK_100MHz		100000000
 
 struct rockchip_combphy_priv;
 
