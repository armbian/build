From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mecid <mecid@mecomediagroup.de>
Date: Tue, 3 Nov 2026 03:24:41 +0100
Subject: [PATCH] imx8m: add 3264 and 3720 MT/s DRAM rates

The DEBIX Model A 2 GB and 4 GB LPDDR4 timings train at 3264 and
3720 MT/s. Add the 816 MHz and 930 MHz DRAM PLL settings for them.

Signed-off-by: Mecid <mecid@mecomediagroup.de>
---
 arch/arm/mach-imx/imx8m/clock_imx8mm.c | 2 ++
 drivers/ddr/imx/phy/ddrphy_utils.c     | 8 ++++++++
 2 files changed, 10 insertions(+)

diff --git a/arch/arm/mach-imx/imx8m/clock_imx8mm.c b/arch/arm/mach-imx/imx8m/clock_imx8mm.c
index b7b37020..3b84ec38 100644
--- a/arch/arm/mach-imx/imx8m/clock_imx8mm.c
+++ b/arch/arm/mach-imx/imx8m/clock_imx8mm.c
@@ -52,7 +52,9 @@ int enable_i2c_clk(unsigned char enable, unsigned i2c_num)
 static struct imx_int_pll_rate_table imx8mm_fracpll_tbl[] = {
 	PLL_1443X_RATE(1000000000U, 250, 3, 1, 0),
 	PLL_1443X_RATE(933000000U, 311, 4, 1, 0),
+	PLL_1443X_RATE(930000000U, 310, 2, 2, 0),
 	PLL_1443X_RATE(900000000U, 300, 2, 2, 0),
+	PLL_1443X_RATE(816000000U, 204, 3, 1, 0),
 	PLL_1443X_RATE(800000000U, 200, 3, 1, 0),
 	PLL_1443X_RATE(750000000U, 250, 2, 2, 0),
 	PLL_1443X_RATE(650000000U, 325, 3, 2, 0),
diff --git a/drivers/ddr/imx/phy/ddrphy_utils.c b/drivers/ddr/imx/phy/ddrphy_utils.c
index 8e350de8..9a2ba08d 100644
--- a/drivers/ddr/imx/phy/ddrphy_utils.c
+++ b/drivers/ddr/imx/phy/ddrphy_utils.c
@@ -116,10 +116,18 @@ void ddrphy_init_set_dfi_clk(unsigned int drate)
 		dram_pll_init(MHZ(933));
 		dram_disable_bypass();
 		break;
+	case 3720:
+		dram_pll_init(MHZ(930));
+		dram_disable_bypass();
+		break;
 	case 3600:
 		dram_pll_init(MHZ(900));
 		dram_disable_bypass();
 		break;
+	case 3264:
+		dram_pll_init(MHZ(816));
+		dram_disable_bypass();
+		break;
 	case 3200:
 		dram_pll_init(MHZ(800));
 		dram_disable_bypass();
