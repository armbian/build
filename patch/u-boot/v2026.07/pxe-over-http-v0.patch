From 23602a8d62588d8b5f630b62a8da2eca043f8f0c Mon Sep 17 00:00:00 2001
From: Ricardo Pardini <ricardo@pardini.net>
Date: Sat, 18 Jul 2026 17:05:29 +0200
Subject: [PATCH 1/4] pxe: support fetching PXE/extlinux files over HTTP(S)

The PXE/extlinux boot flow so far only supported fetching the
configuration and boot files over TFTP. TFTP is slow, has no transport
security and is increasingly firewalled, while every relevant deployment
already has an HTTP(S) server available.

The pxe_utils engine is already transport-agnostic: every file is read
through the pxe_context::getfile callback. Add a second getfile
implementation, do_get_http(), which fetches a file with wget()
(wget_request()), and select it automatically in pxe_get() and
'pxe boot'.

The transport is chosen based on the boot file location: the "pxe_url"
environment variable if it is an "http://" or "https://" URL, otherwise
the DHCP-provided "bootfile" (DHCP option 67), which may itself be a URL.
Conveying a full URL in DHCP option 67 matches the UEFI HTTP Boot
convention, so a DHCP server set up for UEFI HTTP Boot also drives this
path. When the location is not a URL, TFTP is used exactly as before.

When the URL points directly at a config file (it does not end in '/')
it is fetched as-is; when it ends in '/' the usual pxelinux.cfg/ name
probing is performed underneath it.

HTTPS works when CONFIG_WGET_HTTPS is enabled (lwIP + mbedTLS).

Signed-off-by: Ricardo Pardini <ricardo@pardini.net>
Co-Authored-By: Claude Opus 4.8 <noreply@anthropic.com>
---
 boot/Kconfig |  18 ++++++++
 cmd/pxe.c    | 113 ++++++++++++++++++++++++++++++++++++++++++++++++---
 2 files changed, 126 insertions(+), 5 deletions(-)

diff --git a/boot/Kconfig b/boot/Kconfig
index ae6f09a6ede..59679523039 100644
--- a/boot/Kconfig
+++ b/boot/Kconfig
@@ -414,6 +414,24 @@ config PXE_UTILS
 	help
 	  Utilities for parsing PXE file formats.
 
+config PXE_HTTP
+	bool "Support PXE/extlinux network boot over HTTP(S)"
+	depends on PXE_UTILS && CMD_WGET
+	default y
+	help
+	  Allow the "pxe" command and the extlinux-pxe bootflow to fetch the
+	  PXE/extlinux configuration and the boot files (kernel, initrd, device
+	  tree, ...) over HTTP or HTTPS using wget, instead of TFTP.
+
+	  The transport is selected automatically: if the boot file location
+	  (the "pxe_url" environment variable, or otherwise the DHCP-provided
+	  "bootfile", i.e. DHCP option 67) starts with "http://" or "https://",
+	  the files are downloaded with wget. This matches the UEFI HTTP Boot
+	  convention of passing a full URL in DHCP option 67. Otherwise TFTP is
+	  used as before.
+
+	  HTTPS additionally requires CONFIG_WGET_HTTPS.
+
 config BOOT_DEFAULTS_FEATURES
 	bool
 	select SUPPORT_RAW_INITRD
diff --git a/cmd/pxe.c b/cmd/pxe.c
index 3deae5e6d47..78e50670376 100644
--- a/cmd/pxe.c
+++ b/cmd/pxe.c
@@ -53,6 +53,82 @@ static int do_get_tftp(struct pxe_context *ctx, const char *file_path,
 	return 1;
 }
 
+#if defined(CONFIG_PXE_HTTP)
+static int do_get_http(struct pxe_context *ctx, const char *file_path,
+		       char *file_addr, enum bootflow_img_t type, ulong *sizep)
+{
+	struct wget_http_info info = {
+		.method = WGET_HTTP_METHOD_GET,
+		.set_bootdev = false,
+	};
+	ulong addr;
+	int ret;
+
+	if (!wget_validate_uri((char *)file_path))
+		return -EINVAL;
+
+	addr = hextoul(file_addr, NULL);
+	ret = wget_request(addr, (char *)file_path, &info);
+	if (ret)
+		return log_msg_ret("http", ret);
+
+	*sizep = info.file_size;
+	ctx->pxe_file_size = info.file_size;
+
+	return 1;
+}
+
+static bool pxe_is_url(const char *s)
+{
+	return s && (!strncmp(s, "http://", 7) || !strncmp(s, "https://", 8));
+}
+#else
+static inline bool pxe_is_url(const char *s)
+{
+	return false;
+}
+#endif
+
+/*
+ * Determine the base location that PXE/extlinux files are fetched relative to.
+ *
+ * If the "pxe_url" environment variable is an "http://" or "https://" URL it is
+ * used; otherwise the DHCP-provided "bootfile" (DHCP option 67) is used, which
+ * may itself be an HTTP(S) URL. Conveying a full URL in "bootfile" follows the
+ * UEFI HTTP Boot convention (DHCP option 67).
+ *
+ * The value is re-derived from the environment on each call rather than cached,
+ * because fetching files can update environment variables (e.g. wget sets
+ * "filesize"), which may relocate the returned string.
+ */
+static const char *pxe_get_base(void)
+{
+	const char *base = env_get("pxe_url");
+
+	if (pxe_is_url(base))
+		return base;
+
+	return env_get("bootfile");
+}
+
+/*
+ * Select the getfile callback (HTTP or TFTP) for the current base location.
+ * @basep is set to the base location returned by pxe_get_base().
+ */
+static pxe_getfile_func select_getfile(const char **basep)
+{
+	const char *base = pxe_get_base();
+
+	*basep = base;
+
+#if defined(CONFIG_PXE_HTTP)
+	if (pxe_is_url(base))
+		return do_get_http;
+#endif
+
+	return do_get_tftp;
+}
+
 /*
  * Looks for a pxe file with specified config file name,
  * which is received from DHCPv4 option 209 or
@@ -136,13 +212,34 @@ static int pxe_ipaddr_paths(struct pxe_context *ctx, unsigned long pxefile_addr_
 int pxe_get(ulong pxefile_addr_r, char **bootdirp, ulong *sizep, bool use_ipv6)
 {
 	struct cmd_tbl cmdtp[] = {};	/* dummy */
+	pxe_getfile_func getfile;
 	struct pxe_context ctx;
+	const char *base;
 	int i;
 
-	if (pxe_setup_ctx(&ctx, cmdtp, do_get_tftp, NULL, false,
-			  env_get("bootfile"), use_ipv6, false))
+	getfile = select_getfile(&base);
+
+	if (pxe_setup_ctx(&ctx, cmdtp, getfile, NULL, false, base, use_ipv6,
+			  false))
 		return -ENOMEM;
 
+#if defined(CONFIG_PXE_HTTP)
+	/*
+	 * If the base is a full HTTP(S) URL to a config file (i.e. it does not
+	 * end in '/'), fetch it directly rather than probing pxelinux.cfg/
+	 * style names underneath it.
+	 */
+	if (getfile == do_get_http && *base && base[strlen(base) - 1] != '/') {
+		const char *fname = strrchr(base, '/');
+
+		fname = fname ? fname + 1 : base;
+		if (get_pxe_file(&ctx, fname, pxefile_addr_r) > 0)
+			goto done;
+
+		goto error_exit;
+	}
+#endif
+
 	if (IS_ENABLED(CONFIG_BOOTP_PXE_DHCP_OPTION) &&
 	    pxelinux_configfile && !use_ipv6) {
 		if (pxe_dhcp_option_path(&ctx, pxefile_addr_r) > 0)
@@ -181,7 +278,7 @@ error_exit:
 
 	return -ENOENT;
 done:
-	*bootdirp = env_get("bootfile");
+	*bootdirp = (char *)pxe_get_base();
 
 	/*
 	 * The PXE file size is returned but not the name. It is probably not
@@ -264,7 +361,9 @@ do_pxe_boot(struct cmd_tbl *cmdtp, int flag, int argc, char *const argv[])
 {
 	unsigned long pxefile_addr_r;
 	char *pxefile_addr_str;
+	pxe_getfile_func getfile;
 	struct pxe_context ctx;
+	const char *base;
 	int ret;
 	bool use_ipv6 = false;
 
@@ -289,8 +388,9 @@ do_pxe_boot(struct cmd_tbl *cmdtp, int flag, int argc, char *const argv[])
 		return 1;
 	}
 
-	if (pxe_setup_ctx(&ctx, cmdtp, do_get_tftp, NULL, false,
-			  env_get("bootfile"), use_ipv6, false)) {
+	getfile = select_getfile(&base);
+	if (pxe_setup_ctx(&ctx, cmdtp, getfile, NULL, false, base, use_ipv6,
+			  false)) {
 		printf("Out of memory\n");
 		return CMD_RET_FAILURE;
 	}
@@ -331,5 +431,8 @@ static int do_pxe(struct cmd_tbl *cmdtp, int flag, int argc, char *const argv[])
 U_BOOT_CMD(pxe, 4, 1, do_pxe,
 	   "get and boot from pxe files",
 	   "get [" USE_IP6_CMD_PARAM "] - try to retrieve a pxe file using tftp\n"
+#if defined(CONFIG_PXE_HTTP)
+	   "                  (or http/https when 'pxe_url' or 'bootfile' is a URL)\n"
+#endif
 	   "pxe boot [pxefile_addr_r] [-ipv6] - boot from the pxe file at pxefile_addr_r\n"
 );
-- 
2.55.0


From 55ea3698959d2c8d07e85478e37795cbe48704ba Mon Sep 17 00:00:00 2001
From: Ricardo Pardini <ricardo@pardini.net>
Date: Sat, 18 Jul 2026 17:07:26 +0200
Subject: [PATCH 2/4] bootstd: extlinux-pxe: fetch files over HTTP(S) when
 URL-based

With PXE-over-HTTP support in pxe_utils/cmd, the extlinux-pxe bootmeth's
read_bootflow() already fetches the configuration over HTTP(S) when the
boot file location is a URL (via pxe_get()), and passes the URL base down
as the bootflow subdir.

Make the matching read_file() op, used during boot to load the kernel,
initrd, device tree and overlays, honour the same transport: when the
resolved path is an "http://" or "https://" URL, download it with wget()
instead of TFTP. Non-URL paths continue to use TFTP unchanged.

Signed-off-by: Ricardo Pardini <ricardo@pardini.net>
Co-Authored-By: Claude Opus 4.8 <noreply@anthropic.com>
---
 boot/bootmeth_pxe.c | 35 +++++++++++++++++++++++++----------
 1 file changed, 25 insertions(+), 10 deletions(-)

diff --git a/boot/bootmeth_pxe.c b/boot/bootmeth_pxe.c
index faa8d729b15..9c2e869daa6 100644
--- a/boot/bootmeth_pxe.c
+++ b/boot/bootmeth_pxe.c
@@ -121,21 +121,36 @@ static int extlinux_pxe_read_file(struct udevice *dev, struct bootflow *bflow,
 				  const char *file_path, ulong addr,
 				  enum bootflow_img_t type, ulong *sizep)
 {
-	char *tftp_argv[] = {"tftp", NULL, NULL, NULL};
 	struct pxe_context *ctx = dev_get_priv(dev);
-	char file_addr[17];
 	ulong size;
 	int ret;
 
-	sprintf(file_addr, "%lx", addr);
-	tftp_argv[1] = file_addr;
-	tftp_argv[2] = (void *)file_path;
+	if (IS_ENABLED(CONFIG_PXE_HTTP) &&
+	    (!strncmp(file_path, "http://", 7) ||
+	     !strncmp(file_path, "https://", 8))) {
+		struct wget_http_info info = {
+			.method = WGET_HTTP_METHOD_GET,
+			.set_bootdev = false,
+		};
+
+		if (wget_request(addr, (char *)file_path, &info))
+			return log_msg_ret("http", -ENOENT);
+		size = info.file_size;
+	} else {
+		char *tftp_argv[] = {"tftp", NULL, NULL, NULL};
+		char file_addr[17];
+
+		sprintf(file_addr, "%lx", addr);
+		tftp_argv[1] = file_addr;
+		tftp_argv[2] = (void *)file_path;
+
+		if (do_tftpb(ctx->cmdtp, 0, 3, tftp_argv))
+			return -ENOENT;
+		ret = pxe_get_file_size(&size);
+		if (ret)
+			return log_msg_ret("tftp", ret);
+	}
 
-	if (do_tftpb(ctx->cmdtp, 0, 3, tftp_argv))
-		return -ENOENT;
-	ret = pxe_get_file_size(&size);
-	if (ret)
-		return log_msg_ret("tftp", ret);
 	if (size > *sizep)
 		return log_msg_ret("spc", -ENOSPC);
 	*sizep = size;
-- 
