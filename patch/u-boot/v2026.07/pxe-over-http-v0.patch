 }
 
 /*
@@ -122,10 +133,14 @@ static pxe_getfile_func select_getfile(const char **basep)
 	*basep = base;
 
 #if defined(CONFIG_PXE_HTTP)
-	if (pxe_is_url(base))
+	if (pxe_is_url(base)) {
+		printf("PXEHTTP-DBG: transport=HTTP base='%s'\n", base);
