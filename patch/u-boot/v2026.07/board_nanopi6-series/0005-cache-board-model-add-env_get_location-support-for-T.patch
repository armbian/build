From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Muhammed Efe Cetin <efectn@protonmail.com>
Date: Sat, 22 Aug 2026 13:55:46 +0200
Subject: cache board model & add env_get_location support for T6

---
 board/friendlyelec/nanopi6-series-rk3588s/nanopi6-series-rk3588s.c | 25 +++++++++-
 configs/nanopi6-series-rk3588s_defconfig                           |  6 +++
 2 files changed, 29 insertions(+), 2 deletions(-)

diff --git a/board/friendlyelec/nanopi6-series-rk3588s/nanopi6-series-rk3588s.c b/board/friendlyelec/nanopi6-series-rk3588s/nanopi6-series-rk3588s.c
index 111111111111..222222222222 100644
--- a/board/friendlyelec/nanopi6-series-rk3588s/nanopi6-series-rk3588s.c
+++ b/board/friendlyelec/nanopi6-series-rk3588s/nanopi6-series-rk3588s.c
@@ -2,6 +2,7 @@
 
 #include <adc.h>
 #include <env.h>
+#include <env_internal.h>
 #include <fdt_support.h>
 #include <asm/arch-rockchip/bootrom.h>
 #include <asm/global_data.h>
@@ -43,11 +44,16 @@ static const struct board_model board_models[] = {
 	{ 2986, 3166, "rockchip/rk3588-nanopc-t6-lts-plus.dtb", "nanopi6_model=t6-lts-plus", BOARD_T6 },
 };
 
+static const struct board_model *cached_board_model;
+
 static const struct board_model *get_board_model(void)
 {
 	unsigned int val;
 	int i, ret;
 
+	if (cached_board_model)
+		return cached_board_model;
+
 	ret = adc_channel_single_shot("adc@fec10000", HW_ID_CHANNEL, &val);
 	if (ret)
 		return NULL;
@@ -56,8 +62,10 @@ static const struct board_model *get_board_model(void)
 		unsigned int min = board_models[i].low;
 		unsigned int max = board_models[i].high;
 
-		if (min <= val && val <= max)
-			return &board_models[i];
+		if (min <= val && val <= max) {
+			cached_board_model = &board_models[i];
+			return cached_board_model;
+		}
 	}
 
 	return NULL;
@@ -80,6 +88,19 @@ static bool is_t6(const struct board_model *model)
 	return model && model->type == BOARD_T6;
 }
 
+enum env_location env_get_location(enum env_operation op, int prio)
+{
+	const struct board_model *model;
+
+	(void)op;
+	model = get_board_model();
+
+	if (is_t6(model))
+		return prio == 0 ? ENVL_SPI_FLASH : ENVL_UNKNOWN;
+
+	return prio == 0 ? ENVL_NOWHERE : ENVL_UNKNOWN;
+}
+
 // Return true if the board booted from SPI, based on the BootROM boot source ID.
 static bool booted_from_spi(void)
 {
diff --git a/configs/nanopi6-series-rk3588s_defconfig b/configs/nanopi6-series-rk3588s_defconfig
index 111111111111..222222222222 100644
--- a/configs/nanopi6-series-rk3588s_defconfig
+++ b/configs/nanopi6-series-rk3588s_defconfig
@@ -49,6 +49,12 @@ CONFIG_SPL_OF_CONTROL=y
 CONFIG_OF_LIVE=y
 CONFIG_OF_LIST="rockchip/rk3588s-nanopi6-series rockchip/rk3588s-nanopi-r6s rockchip/rk3588s-nanopi-r6c rockchip/rk3588s-nanopi-m6 rockchip/rk3588s-nanopi-m6-spi rockchip/rk3588s-nanopi-m6v2 rockchip/rk3588s-nanopi-m6v2-spi rockchip/rk3588-nanopc-t6 rockchip/rk3588-nanopc-t6-lts rockchip/rk3588-nanopc-t6-lts-plus"
 CONFIG_OF_SPL_REMOVE_PROPS="clock-names interrupt-parent assigned-clocks assigned-clock-rates assigned-clock-parents"
+CONFIG_ENV_SIZE=0x20000
+CONFIG_ENV_OFFSET=0xc00000
+CONFIG_ENV_OVERWRITE=y
+CONFIG_ENV_IS_NOWHERE=y
+CONFIG_ENV_IS_IN_SPI_FLASH=y
+CONFIG_ENV_SECT_SIZE_AUTO=y
 CONFIG_ENV_RELOC_GD_ENV_ADDR=y
 CONFIG_SPL_DM_SEQ_ALIAS=y
 CONFIG_SPL_REGMAP=y
