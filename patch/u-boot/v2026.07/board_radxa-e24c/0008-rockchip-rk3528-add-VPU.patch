From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ricardo Pardini <ricardo@pardini.net>
Date: Thu, 13 Aug 2026 15:37:45 +0200
Subject: rockchip: rk3528: add VPU

---
 dts/upstream/src/arm64/rockchip/rk3528.dtsi | 23 ++++++++++
 1 file changed, 23 insertions(+)

diff --git a/dts/upstream/src/arm64/rockchip/rk3528.dtsi b/dts/upstream/src/arm64/rockchip/rk3528.dtsi
index 111111111111..222222222222 100644
--- a/dts/upstream/src/arm64/rockchip/rk3528.dtsi
+++ b/dts/upstream/src/arm64/rockchip/rk3528.dtsi
@@ -712,6 +712,29 @@
 			status = "disabled";
 		};
 
+		vpu: video-codec@ff7c0000 {
+			compatible = "rockchip,rk3528-vpu",
+				     "rockchip,rk3568-vpu";
+			reg = <0x0 0xff7c0000 0x0 0x800>;
+			clocks = <&cru ACLK_VPU>, <&cru HCLK_VPU>;
+			clock-names = "aclk", "hclk";
+			interrupts = <GIC_SPI 98 IRQ_TYPE_LEVEL_HIGH>;
+			interrupt-names = "vdpu";
+			iommus = <&vpu_mmu>;
+			power-domains = <&power RK3528_PD_VPU>;
+		};
+
+		vpu_mmu: iommu@ff7c0800 {
+			compatible = "rockchip,rk3528-iommu",
+				     "rockchip,rk3568-iommu";
+			reg = <0x0 0xff7c0800 0x0 0x40>;
+			clocks = <&cru ACLK_VPU>, <&cru HCLK_VPU>;
+			clock-names = "aclk", "iface";
+			interrupts = <GIC_SPI 99 IRQ_TYPE_LEVEL_HIGH>;
+			#iommu-cells = <0>;
+			power-domains = <&power RK3528_PD_VPU>;
+		};
+
 		spi0: spi@ff9c0000 {
 			compatible = "rockchip,rk3528-spi",
 				     "rockchip,rk3066-spi";
-- 
Armbian

