From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: serg987 <50438876+serg987@users.noreply.github.com>
Date: Sun, 1 Nov 2026 12:00:00 +0000
Subject: PCIe: sunxi: sun55i: make link training reliable

Wait 100 ms after PERST# release. This is the PCIe specification value.
Wait up to 1 s for the link. Check the link again after the speed change.
An empty slot returns from `pci enum` after 1.4 s with a clear message.

Signed-off-by: serg987 <50438876+serg987@users.noreply.github.com>
Assisted-by: claude-code:claude-opus-5-5
Assisted-by: claude-code:claude-sonnet-5-5
---
 drivers/pci/pcie-sun55i-plat.c |    3 ++-
 drivers/pci/pcie-sun55i.c      |   13 +++++++++++--
 drivers/pci/pcie-sun55i.h      |    2 +-
 3 files changed, 14 insertions(+), 4 deletions(-)

diff --git a/drivers/pci/pcie-sun55i-plat.c b/drivers/pci/pcie-sun55i-plat.c
index 111111111111..222222222222 100644
--- a/drivers/pci/pcie-sun55i-plat.c
+++ b/drivers/pci/pcie-sun55i-plat.c
@@ -341,7 +341,8 @@ static int sun55i_pcie_plat_init_port(struct udevice *dev)
 		goto err_power_off_phy;
 	}
 
-	mdelay(40);
+	/* PCIe CEM: 100 ms from PERST# deassertion before the first config access */
+	mdelay(100);
 
 	printf("PCIe: Hardware power-on sequence successful.\n");
 	return 0;
diff --git a/drivers/pci/pcie-sun55i.c b/drivers/pci/pcie-sun55i.c
index 111111111111..222222222222 100644
--- a/drivers/pci/pcie-sun55i.c
+++ b/drivers/pci/pcie-sun55i.c
@@ -283,7 +283,7 @@ static int sun55i_pcie_host_link_up_status(struct sun55i_pcie_port *pp)
     debug("  RDLH_LINK_UP: %d\n", !!(val & RDLH_LINK_UP));
     debug("  SMLH_LINK_UP: %d\n", !!(val & SMLH_LINK_UP));
     debug("  LINK_SPEED: %d\n", (val >> 16) & 0xF);
-    printf("  LINK_WIDTH: %d\n", (val >> 20) & 0x3F);
+    debug("  LINK_WIDTH: %d\n", (val >> 20) & 0x3F);
 
 	return ret;
 }
@@ -385,9 +385,18 @@ static void sun55i_pcie_host_init(struct udevice *dev)
     
 	sun55i_pcie_host_setup_rc(&pci->pcie_port);
 
-	sun55i_pcie_host_establish_link(pci);
+	if (sun55i_pcie_host_establish_link(pci)) {
+		/* Nothing trained: skip the speed change and its waits */
+		printf("PCIe: no link, nothing connected?\n");
+		return;
+	}
 
 	sun55i_pcie_host_speed_change(pci, pci->link_gen);
+
+	/* The speed change retrains the link: wait for it to come back before enumeration starts */
+	if (!sun55i_pcie_host_link_up(&pci->pcie_port) &&
+	    sun55i_pcie_host_wait_for_link(&pci->pcie_port))
+		printf("PCIe: link did not come back after speed change\n");
 }
 
 static int sun55i_pcie_probe(struct udevice *dev)
diff --git a/drivers/pci/pcie-sun55i.h b/drivers/pci/pcie-sun55i.h
index 111111111111..222222222222 100644
--- a/drivers/pci/pcie-sun55i.h
+++ b/drivers/pci/pcie-sun55i.h
@@ -176,7 +176,7 @@
 #define PORT_LOGIC_SPEED_CHANGE		(0x1 << 17)
 #define LINK_CONTROL2_LINK_STATUS2	0xa0
 /* Parameters for the waiting for link up routine */
-#define LINK_WAIT_MAX_RETRIE		100
+#define LINK_WAIT_MAX_RETRIE		1000
 #define LINK_WAIT_USLEEP_MIN		90000
 #define LINK_WAIT_USLEEP_MAX		100000
 #define SPEED_CHANGE_USLEEP_MIN		100
-- 
