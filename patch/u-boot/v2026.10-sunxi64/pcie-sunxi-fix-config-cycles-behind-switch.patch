From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: serg987 <50438876+serg987@users.noreply.github.com>
Date: Sun, 1 Nov 2026 12:00:00 +0000
Subject: PCIe: sunxi: sun55i: fix enumeration behind a PCIe switch

Fix the U-Boot hang in `pci enum` when a PCIe switch sits behind the root port.
Devices behind the switch enumerate. NVMe boot works through the switch.

Same fix as Radxa vendor commits af571628ed8 and b2d229198b2.

Signed-off-by: serg987 <50438876+serg987@users.noreply.github.com>
Assisted-by: claude-code:claude-opus-5-5
Assisted-by: claude-code:claude-sonnet-5-5
---
 drivers/pci/pcie-sun55i.c |   27 ++++++++++++++++++---------
 1 file changed, 18 insertions(+), 9 deletions(-)

diff --git a/drivers/pci/pcie-sun55i.c b/drivers/pci/pcie-sun55i.c
index 111111111111..222222222222 100644
--- a/drivers/pci/pcie-sun55i.c
+++ b/drivers/pci/pcie-sun55i.c
@@ -75,6 +75,21 @@ static void sun55i_pcie_prog_outbound_atu(struct sun55i_pcie_port *pp, int index
 	sun55i_pcie_writel_dbi(pci, PCIE_ATU_CR2_OUTBOUND(index), PCIE_ATU_ENABLE);
 }
 
+/*
+ * Only the bus directly below the root port is reached with a Type 0 config
+ * cycle. Anything further down (e.g. behind a PCIe switch) has to be sent as
+ * Type 1, which the bridges forward until the target bus is reached.
+ */
+static int sun55i_pcie_cfg_type(struct sun55i_pcie_port *pp, pci_dev_t d)
+{
+	struct sun55i_pcie *pci = to_sun55i_pcie_from_pp(pp);
+
+	if (PCI_BUS(d) == pci->first_busno + 1)
+		return PCIE_ATU_TYPE_CFG0;
+
+	return PCIE_ATU_TYPE_CFG1;
+}
+
 static int sun55i_pcie_rd_other_conf(struct sun55i_pcie_port *pp, pci_dev_t d, int where, int size, ulong *val)
 {
 	int ret = PCIBIOS_SUCCESSFUL, type;
@@ -86,10 +101,7 @@ static int sun55i_pcie_rd_other_conf(struct sun55i_pcie_port *pp, pci_dev_t d, i
 
 	busdev = PCIE_ATU_BUS(PCI_BUS(d)) | PCIE_ATU_DEV(PCI_DEV(d)) | PCIE_ATU_FUNC(PCI_FUNC(d));
 
-	if (PCI_BUS(d) != 0)
-		type = PCIE_ATU_TYPE_CFG0;
-	else
-		type = PCIE_ATU_TYPE_CFG1;
+	type = sun55i_pcie_cfg_type(pp, d);
 
 	sun55i_pcie_prog_outbound_atu(pp, PCIE_ATU_INDEX0, type, atu_cpu_addr, busdev, pp->cfg0_size);
 
@@ -109,10 +121,7 @@ static int sun55i_pcie_wr_other_conf(struct sun55i_pcie_port *pp, pci_dev_t d, i
 
 	busdev = PCIE_ATU_BUS(PCI_BUS(d)) | PCIE_ATU_DEV(PCI_DEV(d)) | PCIE_ATU_FUNC(PCI_FUNC(d));
 
-	if (PCI_BUS(d) != 0)
-		type = PCIE_ATU_TYPE_CFG0;
-	else
-		type = PCIE_ATU_TYPE_CFG1;
+	type = sun55i_pcie_cfg_type(pp, d);
 
 	sun55i_pcie_prog_outbound_atu(pp, PCIE_ATU_INDEX0, type, atu_cpu_addr, busdev, pp->cfg0_size);
 
@@ -213,7 +222,7 @@ static void sun55i_pcie_host_setup_rc(struct sun55i_pcie_port *pp)
 
 	val = sun55i_pcie_readl_dbi(pci, PCI_PRIMARY_BUS);
 	val &= 0xff000000;
-	val |= 0x00ff0100;
+	val |= PCIE_PRIMARY_BUS_ENABLE;
 	sun55i_pcie_writel_dbi(pci, PCI_PRIMARY_BUS, val);
 
 	val = sun55i_pcie_readl_dbi(pci, PCI_COMMAND);
-- 
