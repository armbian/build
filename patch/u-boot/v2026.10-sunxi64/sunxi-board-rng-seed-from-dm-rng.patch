From: Arun Iyengar <aiyengar1990@gmail.com>
Subject: [PATCH] sunxi: provide board_rng_seed() from the DM RNG device

CONFIG_BOARD_RNG_SEED makes fdt_chosen() add /chosen/rng-seed, which
Linux uses to seed its CRNG at boot, but requires the board to supply
board_rng_seed(). Do what the Xilinx and Rockchip boards do: read 64
bytes from the first UCLASS_RNG device (the sun8i-ce TRNG on H6/H616).

Signed-off-by: Arun Iyengar <aiyengar1990@gmail.com>
---
diff -ruN a/board/sunxi/board.c b/board/sunxi/board.c
--- a/board/sunxi/board.c
+++ b/board/sunxi/board.c
@@ -10,6 +10,7 @@
  * Some board init for the Allwinner A10-evb board.
  */
 
+#include <abuf.h>
 #include <clock_legacy.h>
 #include <dm.h>
 #include <env.h>
@@ -18,7 +19,9 @@
 #include <image.h>
 #include <init.h>
 #include <log.h>
+#include <malloc.h>
 #include <mmc.h>
+#include <rng.h>
 #include <axp_pmic.h>
 #include <generic-phy.h>
 #include <phy-sun4i-usb.h>
@@ -1020,3 +1023,35 @@
 	return ret;
 }
 #endif /* CONFIG_SPL_LOAD_FIT */
+
+#if IS_ENABLED(CONFIG_BOARD_RNG_SEED)
+/* Seed Linux's CRNG (/chosen/rng-seed) from the SoC's hardware RNG */
+int board_rng_seed(struct abuf *buf)
+{
+	struct udevice *dev;
+	const ulong len = 64;
+	u8 *data;
+	int ret;
+
+	ret = uclass_get_device(UCLASS_RNG, 0, &dev);
+	if (ret) {
+		printf("No RNG device for rng-seed: %d\n", ret);
+		return ret;
+	}
+
+	data = malloc(len);
+	if (!data)
+		return -ENOMEM;
+
+	ret = dm_rng_read(dev, data, len);
+	if (ret) {
+		printf("Reading RNG for rng-seed failed: %d\n", ret);
+		free(data);
+		return ret;
+	}
+
+	abuf_init_move(buf, data, len); /* fdt_chosen() frees it */
+
+	return 0;
+}
+#endif
