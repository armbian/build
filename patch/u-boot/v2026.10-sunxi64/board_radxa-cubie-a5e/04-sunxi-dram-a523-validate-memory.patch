 arch/arm/mach-sunxi/Kconfig                       | 78 +++++++++++++++++++++
 arch/arm/mach-sunxi/dram_dw_helpers.c             | 73 ++++++++++++++++++--
 arch/arm/mach-sunxi/dram_sun50i_h6.c              |  3 +-
 arch/arm/mach-sunxi/dram_sun50i_h616.c            |  3 +-
 arch/arm/mach-sunxi/dram_sun55i_a523.c            | 82 +++++++++++++++++++----
 6 files changed, 221 insertions(+), 21 deletions(-)

