From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Juan Sanchez Fuentes <juanesf91@gmail.com>
Date: Sat, 21 Nov 2026 19:10:00 -0300
Subject: sunxi: dram: a523: validate memory before accepting DRAM timings

Run a wide memory test after A523 DRAM training. Retry with the configured
alternative parameter sets when the memory check fails. This rejects wrong
nonzero sizes caused by address aliasing.

Signed-off-by: Juan Sanchez Fuentes <juanesf91@gmail.com>
---
 arch/arm/include/asm/arch-sunxi/dram_dw_helpers.h |  1 +
 arch/arm/mach-sunxi/Kconfig                       | 39 +++++++++++++++
 arch/arm/mach-sunxi/dram_dw_helpers.c             | 61 +++++++++++++++++++++++
 arch/arm/mach-sunxi/dram_sun55i_a523.c            | 60 ++++++++++++++++++----
 4 files changed, 150 insertions(+), 11 deletions(-)

diff --git a/arch/arm/include/asm/arch-sunxi/dram_dw_helpers.h b/arch/arm/include/asm/arch-sunxi/dram_dw_helpers.h
index bc9e0d868c5..f41872abf14 100644
--- a/arch/arm/include/asm/arch-sunxi/dram_dw_helpers.h
+++ b/arch/arm/include/asm/arch-sunxi/dram_dw_helpers.h
@@ -18,5 +18,6 @@ void mctl_auto_detect_rank_width(const struct dram_para *para,
 void mctl_auto_detect_dram_size(const struct dram_para *para,
 				struct dram_config *config);
 unsigned long mctl_calc_size(const struct dram_config *config);
+bool mctl_mem_stress_test(ulong base, ulong size);
 
 #endif
diff --git a/arch/arm/mach-sunxi/Kconfig b/arch/arm/mach-sunxi/Kconfig
index f945d1c54f5..08cd86a3e10 100644
--- a/arch/arm/mach-sunxi/Kconfig
+++ b/arch/arm/mach-sunxi/Kconfig
@@ -228,6 +228,45 @@ config DRAM_SUNXI_TPR12_ALT
 	  Alternative TPR12 value, used together with TPR6_ALT, TPR10_ALT
 	  and TPR11_ALT.
 
+config DRAM_SUNXI_TPR_ORIG_PARAMETERS
+	bool "DRAM original TPR parameter set (second memory check retry)"
+	depends on MACH_SUN55I_A523
+	help
+	  Enable a second DRAM init fallback with the original board timings.
+	  sunxi_dram_init() retrains the DRAM with these values when both the
+	  primary and alternative parameter sets fail the memory check.
+
+config DRAM_SUNXI_TPR6_ORIG
+	hex "DRAM TPR6 parameter (original set)"
+	depends on DRAM_SUNXI_TPR_ORIG_PARAMETERS
+	default 0x0
+	help
+	  Original TPR6 value, used when the primary and alternative sets fail.
+
+config DRAM_SUNXI_TPR10_ORIG
+	hex "DRAM TPR10 parameter (original set)"
+	depends on DRAM_SUNXI_TPR_ORIG_PARAMETERS
+	default 0x0
+	help
+	  Original TPR10 value, used together with TPR6_ORIG, TPR11_ORIG
+	  and TPR12_ORIG.
+
+config DRAM_SUNXI_TPR11_ORIG
+	hex "DRAM TPR11 parameter (original set)"
+	depends on DRAM_SUNXI_TPR_ORIG_PARAMETERS
+	default 0x0
+	help
+	  Original TPR11 value, used together with TPR6_ORIG, TPR10_ORIG
+	  and TPR12_ORIG.
+
+config DRAM_SUNXI_TPR12_ORIG
+	hex "DRAM TPR12 parameter (original set)"
+	depends on DRAM_SUNXI_TPR_ORIG_PARAMETERS
+	default 0x0
+	help
+	  Original TPR12 value, used together with TPR6_ORIG, TPR10_ORIG
+	  and TPR11_ORIG.
+
 choice
 	prompt "DRAM PHY pin mapping selection"
 	default DRAM_SUNXI_PHY_ADDR_MAP_0
diff --git a/arch/arm/mach-sunxi/dram_dw_helpers.c b/arch/arm/mach-sunxi/dram_dw_helpers.c
index d2af2d57fde..59bc20f3f18 100644
--- a/arch/arm/mach-sunxi/dram_dw_helpers.c
+++ b/arch/arm/mach-sunxi/dram_dw_helpers.c
@@ -8,6 +8,7 @@
 
 #include <init.h>
 #include <asm/arch/dram_dw_helpers.h>
+#include <asm/io.h>
 
 void mctl_auto_detect_rank_width(const struct dram_para *para,
 				 struct dram_config *config)
@@ -84,6 +85,66 @@ static bool mctl_check_pattern(ulong offset)
 	return true;
 }
 
+#define MCTL_TEST_WORDS 262144
+#define MCTL_TEST_SITES 9
+
+static u32 mctl_test_value(ulong addr, u32 site, u32 pattern, u32 index)
+{
+	return pattern ^ (u32)(addr >> 16) ^ (site << 24) ^ index;
+}
+
+/*
+ * Check a wide spread of addresses with multiple patterns.
+ *
+ * The built-in check in mctl_calc_size() only tests one word at 3/4 of
+ * the reported size. Address aliasing can make a wrong size pass that
+ * test. Write every site before reading any site so aliasing changes a
+ * value that is already in memory.
+ */
+bool mctl_mem_stress_test(ulong base, ulong size)
+{
+	static const u8 fractions[8] = { 0, 1, 2, 3, 4, 5, 6, 7 };
+	static const u32 patterns[4] = {
+		0xa5a5a5a5, 0x5a5a5a5a, 0x01234567, 0xfedcba98
+	};
+	ulong addr[MCTL_TEST_SITES];
+	u32 pattern, site, index;
+
+	if (size < 0x100000)
+		return false;
+
+	for (site = 0; site < 8; site++)
+		addr[site] = base + (size / 8) * fractions[site];
+	addr[8] = base + size - MCTL_TEST_WORDS * 4;
+
+	for (pattern = 0; pattern < ARRAY_SIZE(patterns); pattern++) {
+		for (site = 0; site < MCTL_TEST_SITES; site++) {
+			for (index = 0; index < MCTL_TEST_WORDS; index++) {
+				u32 val = mctl_test_value(addr[site], site,
+							  patterns[pattern],
+							  index);
+				writel(val, (void *)(addr[site] + index * 4));
+			}
+		}
+
+		dsb();
+
+		for (site = 0; site < MCTL_TEST_SITES; site++) {
+			for (index = 0; index < MCTL_TEST_WORDS; index++) {
+				u32 want = mctl_test_value(addr[site], site,
+							   patterns[pattern],
+							   index);
+				u32 got = readl((void *)(addr[site] + index * 4));
+				if (got == want)
+					continue;
+				return false;
+			}
+		}
+	}
+
+	return true;
+}
+
 void mctl_auto_detect_dram_size(const struct dram_para *para,
 				struct dram_config *config)
 {
diff --git a/arch/arm/mach-sunxi/dram_sun55i_a523.c b/arch/arm/mach-sunxi/dram_sun55i_a523.c
index 0c6b4b73f2f..1f87e7d147a 100644
--- a/arch/arm/mach-sunxi/dram_sun55i_a523.c
+++ b/arch/arm/mach-sunxi/dram_sun55i_a523.c
@@ -1508,25 +1508,50 @@ static unsigned long dram_init_with_para(const struct dram_para *para,
 	return mctl_calc_size(&config);
 }
 
+static unsigned long dram_init_and_test(const struct dram_para *para,
+					u32 tpr11, u32 tpr12)
+{
+	unsigned long size;
+
+	printf("DRAM train type=%u clk=%u ODT=0x%08x TPR6=0x%08x TPR10=0x%08x TPR11=0x%08x TPR12=0x%08x TPR14=0x%08x\n",
+	       para->type, CONFIG_DRAM_CLK, CONFIG_DRAM_SUNXI_ODT_EN,
+	       para->tpr6, para->tpr10, tpr11, tpr12,
+	       CONFIG_DRAM_SUNXI_TPR14);
+	size = dram_init_with_para(para, tpr11, tpr12);
+	if (!size)
+		return 0;
+
+	printf("DRAM memory test started\n");
+	if (!mctl_mem_stress_test(CFG_SYS_SDRAM_BASE, size)) {
+		printf("DRAM memory test failed\n");
+		return 0;
+	}
+	printf("DRAM memory test passed\n");
+
+	return size;
+}
+
 unsigned long sunxi_dram_init(void)
 {
 	unsigned long size;
 #if IS_ENABLED(CONFIG_DRAM_SUNXI_TPR_ALT_PARAMETERS)
 	struct dram_para para_alt;
 #endif
+#if IS_ENABLED(CONFIG_DRAM_SUNXI_TPR_ORIG_PARAMETERS)
+	struct dram_para para_orig;
+#endif
 
-	size = dram_init_with_para(&para, CONFIG_DRAM_SUNXI_TPR11,
-				   CONFIG_DRAM_SUNXI_TPR12);
+	size = dram_init_and_test(&para, CONFIG_DRAM_SUNXI_TPR11,
+				  CONFIG_DRAM_SUNXI_TPR12);
 
 #if IS_ENABLED(CONFIG_DRAM_SUNXI_TPR_ALT_PARAMETERS)
 	if (size == 0) {
 		/*
-		 * The memory probe built into mctl_calc_size() failed with
-		 * the default parameters. The defconfig can provide an
-		 * alternative set of PHY timings
+		 * The memory check failed with the default parameters. The
+		 * defconfig can provide an alternative set of PHY timings
 		 * (CONFIG_DRAM_SUNXI_TPR*_ALT) for boards whose DRAM
 		 * variants need them; retrain the DRAM with that set and
-		 * re-run the probe.
+		 * re-run the full check.
 		 */
 		printf("DRAM memory check failed, retrying with alternative parameters\n");
 
@@ -1534,11 +1559,24 @@ unsigned long sunxi_dram_init(void)
 		para_alt.tpr6 = CONFIG_DRAM_SUNXI_TPR6_ALT;
 		para_alt.tpr10 = CONFIG_DRAM_SUNXI_TPR10_ALT;
 
-		size = dram_init_with_para(&para_alt,
-					   CONFIG_DRAM_SUNXI_TPR11_ALT,
-					   CONFIG_DRAM_SUNXI_TPR12_ALT);
-		if (size == 0)
-			panic("DRAM unstable with both parameter sets\n");
+		size = dram_init_and_test(&para_alt,
+					  CONFIG_DRAM_SUNXI_TPR11_ALT,
+					  CONFIG_DRAM_SUNXI_TPR12_ALT);
+		if (size == 0) {
+#if IS_ENABLED(CONFIG_DRAM_SUNXI_TPR_ORIG_PARAMETERS)
+			printf("DRAM memory check failed, retrying with original parameters\n");
+
+			para_orig = para;
+			para_orig.tpr6 = CONFIG_DRAM_SUNXI_TPR6_ORIG;
+			para_orig.tpr10 = CONFIG_DRAM_SUNXI_TPR10_ORIG;
+
+			size = dram_init_and_test(&para_orig,
+							  CONFIG_DRAM_SUNXI_TPR11_ORIG,
+							  CONFIG_DRAM_SUNXI_TPR12_ORIG);
+#endif
+			if (size == 0)
+				panic("DRAM unstable with all parameter sets\n");
+		}
 	}
 #endif
 
