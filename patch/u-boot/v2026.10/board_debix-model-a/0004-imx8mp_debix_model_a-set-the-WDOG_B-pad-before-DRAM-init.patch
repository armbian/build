From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mecid <mecid@mecomediagroup.de>
Date: Tue, 3 Nov 2026 01:55:12 +0100
Subject: [PATCH] imx8mp_debix_model_a: set the WDOG_B pad before DRAM init

WDOG_B drives the PMIC cold reset. Without the pad setup, the PMIC
can power-cycle the board during DRAM training.

Signed-off-by: Mecid <mecid@mecomediagroup.de>
---
 board/polyhex/imx8mp_debix_model_a/spl.c | 21 +++++++++++++++++++++
 1 file changed, 21 insertions(+)

diff --git a/board/polyhex/imx8mp_debix_model_a/spl.c b/board/polyhex/imx8mp_debix_model_a/spl.c
index d5e16854..d9260037 100644
--- a/board/polyhex/imx8mp_debix_model_a/spl.c
+++ b/board/polyhex/imx8mp_debix_model_a/spl.c
@@ -9,6 +9,7 @@
 #include <asm/arch/imx8mp_pins.h>
 #include <asm/arch/sys_proto.h>
 #include <asm/mach-imx/boot_mode.h>
+#include <asm/mach-imx/iomux-v3.h>
 #include <asm/sections.h>
 #include <dm/device.h>
 #include <dm/uclass.h>
@@ -167,12 +168,32 @@ int board_fit_config_name_match(const char *name)
 	return -1;
 }
 
+#define WDOG_PAD_CTRL	(PAD_CTL_DSE6 | PAD_CTL_ODE | PAD_CTL_PUE | PAD_CTL_PE)
+
+static const iomux_v3_cfg_t wdog_pads[] = {
+	MX8MP_PAD_GPIO1_IO02__WDOG1_WDOG_B | MUX_PAD_CTRL(WDOG_PAD_CTRL),
+};
+
+/*
+ * WDOG_B drives the PMIC cold reset. Hold the line high before
+ * DRAM training, else the PMIC can power-cycle the board.
+ */
+static void debix_wdog_init(void)
+{
+	struct wdog_regs *wdog = (struct wdog_regs *)WDOG1_BASE_ADDR;
+
+	imx_iomux_v3_setup_multiple_pads(wdog_pads, ARRAY_SIZE(wdog_pads));
+	set_wdog_reset(wdog);
+}
+
 void board_init_f(ulong dummy)
 {
 	int ret;
 
 	arch_cpu_init();
 
+	debix_wdog_init();
+
 	init_uart_clk(1);
 
 	/* Clear the BSS. */
