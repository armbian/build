From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mecid <mecid@mecomediagroup.de>
Date: Mon, 2 Nov 2026 01:10:09 +0100
Subject: [PATCH] imx8mp_debix_model_a: fix the boot memory layout

The kernel load window is only 44 MB, which is too small for a
generic arm64 Image. ramdisk_addr_r and fdtoverlay_addr_r are
missing, so extlinux cannot load an initrd or DT overlays.

Move the FDT, script, overlay and ramdisk addresses above
0x50200000. Drop bootm_size.

Signed-off-by: Mecid <mecid@mecomediagroup.de>
---
 include/configs/imx8mp_debix_model_a.h | 11 +++++++----
 1 file changed, 7 insertions(+), 4 deletions(-)

diff --git a/include/configs/imx8mp_debix_model_a.h b/include/configs/imx8mp_debix_model_a.h
index d1a54e80..67581fe6 100644
--- a/include/configs/imx8mp_debix_model_a.h
+++ b/include/configs/imx8mp_debix_model_a.h
@@ -27,15 +27,18 @@
 /* Initial environment variables */
 #define CFG_EXTRA_ENV_SETTINGS		\
 	BOOTENV \
-	"scriptaddr=" __stringify(CONFIG_SYS_LOAD_ADDR) "\0" \
 	"kernel_addr_r=" __stringify(CONFIG_SYS_LOAD_ADDR) "\0" \
+	"kernel_comp_addr_r=0x58000000\0" \
+	"kernel_comp_size=0x08000000\0" \
+	"fdt_addr_r=0x50200000\0" \
+	"scriptaddr=0x50280000\0" \
+	"fdtoverlay_addr_r=0x50300000\0" \
+	"pxefile_addr_r=0x50380000\0" \
+	"ramdisk_addr_r=0x50400000\0" \
 	"image=Image\0" \
 	"console=ttymxc1,115200 earlycon=ec_imx6q,0x30890000,115200\0" \
-	"fdt_addr_r=0x43000000\0"			\
 	"boot_fdt=try\0" \
 	"fdtfile=" CONFIG_DEFAULT_FDT_FILE "\0" \
-	"initrd_addr=0x43800000\0"		\
-	"bootm_size=0x10000000\0" \
 	"mmcpart=1\0" \
 	"mmcroot=/dev/mmcblk1p2 rootwait rw\0" \
 
