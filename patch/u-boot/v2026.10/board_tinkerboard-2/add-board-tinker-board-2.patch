+++ b/drivers/power/regulator/fan53555.c
@@ -54,6 +54,8 @@ static const struct {
 	{ FAN53555_VENDOR_FAIRCHILD, 0x8, 0x1, true,  600000, 10000 },
 	/* Option 08 */
 	{ FAN53555_VENDOR_FAIRCHILD, 0x8, 0xf, true,  600000, 10000 },
+	/* FAN53200 */
