Date: Sat, 17 Oct 2026 20:36:39 +0200
Subject: [PATCH] power: rk8xx: Quartz64 Zero: raise the RK817 input current
 limit before VBUS is enabled

VCC_SYS feeds every buck and the USB VBUS switches through the RK817
charger power path. Its input current limit (PMIC_CHRG_IN) resets to a
value too low for a bus-powered USB 3 hub, so enabling VBUS in
board_init() resets the PMIC in a loop. Write the value Pine64's Android
kernel uses (0xdf) from rk8xx_probe(), before the boot-on regulators are
enabled.
---
diff --git a/drivers/power/pmic/rk8xx.c b/drivers/power/pmic/rk8xx.c
index 95b71d2f..f51eed9b 100644
--- a/drivers/power/pmic/rk8xx.c
+++ b/drivers/power/pmic/rk8xx.c
@@ -336,6 +336,21 @@ static int rk8xx_probe(struct udevice *dev)
 		      pmic_reg_read(dev, init_data[i].reg));
 	}
 
+	/*
+	 * Quartz64 Zero: VCC_SYS -- every buck and the USB VBUS switches -- comes
+	 * out of the RK817 charger's power path, whose input current limit resets
+	 * to a value too low for a bus-powered USB 3 hub: switching VBUS on in
+	 * board_init() then resets the PMIC in a loop. Raise it (Pine64's Android
+	 * value) before the boot-on regulators are enabled.
+	 */
+	if (priv->variant == RK817_ID &&
+	    of_machine_is_compatible("pine64,quartz64-zero")) {
+		ret = pmic_reg_write(dev, RK817_PMIC_CHRG_IN, 0xdf);
+		if (ret < 0)
+			printf("%s: i2c set reg 0x%x failed, ret=%d\n",
+			       __func__, RK817_PMIC_CHRG_IN, ret);
+	}
+
 	if (!IS_ENABLED(CONFIG_XPL_BUILD)) {
 		printf("PMIC:  RK%x ", show_variant);
 		if (on_source && off_source)
diff --git a/include/power/rk8xx_pmic.h b/include/power/rk8xx_pmic.h
index 913b6ebe..ea018b54 100644
--- a/include/power/rk8xx_pmic.h
+++ b/include/power/rk8xx_pmic.h
@@ -232,6 +232,7 @@ enum {
 #define RK8XX_ON_SOURCE		0xae
 #define RK8XX_OFF_SOURCE	0xaf
 #define RK817_BUCK4_CMIN	0xc6
+#define RK817_PMIC_CHRG_IN	0xe5
 #define RK817_ON_SOURCE		0xf5
 #define RK817_OFF_SOURCE	0xf6
 
