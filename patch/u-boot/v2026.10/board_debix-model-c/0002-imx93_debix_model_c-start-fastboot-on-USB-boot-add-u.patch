From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mecid <mecid@mecomediagroup.de>
Date: Mon, 2 Nov 2026 09:49:47 +0100
Subject: [PATCH 2/2] imx93_debix_model_c: start fastboot on USB boot, add ums

Start fastboot when the boot ROM loaded U-Boot over USB, so that
uuu can write eMMC. Add the ums command.

Signed-off-by: Mecid <mecid@mecomediagroup.de>
---
 board/polyhex/imx93_debix_model_c/imx93_debix_model_c.c | 8 ++++++++
 configs/imx93_debix_model_c_defconfig                   | 1 +
 2 files changed, 9 insertions(+)

diff --git a/board/polyhex/imx93_debix_model_c/imx93_debix_model_c.c b/board/polyhex/imx93_debix_model_c/imx93_debix_model_c.c
index db24ef4b..2b47ec26 100644
--- a/board/polyhex/imx93_debix_model_c/imx93_debix_model_c.c
+++ b/board/polyhex/imx93_debix_model_c/imx93_debix_model_c.c
@@ -5,6 +5,8 @@
 
 #include <env.h>
 #include <init.h>
+#include <asm/arch/sys_proto.h>
+#include <asm/mach-imx/boot_mode.h>
 
 int board_init(void)
 {
@@ -18,5 +20,11 @@ int board_late_init(void)
 		env_set("board_rev", "iMX93");
 	}
 
+	/* Wait for uuu when the boot ROM loaded U-Boot over USB */
+	if (get_boot_device() == USB_BOOT) {
+		puts("USB boot detected, starting fastboot\n");
+		env_set("bootcmd", "fastboot 0");
+	}
+
 	return 0;
 }
diff --git a/configs/imx93_debix_model_c_defconfig b/configs/imx93_debix_model_c_defconfig
index f68868f8..8e0323e7 100644
--- a/configs/imx93_debix_model_c_defconfig
+++ b/configs/imx93_debix_model_c_defconfig
@@ -63,6 +63,7 @@ CONFIG_CMD_GPIO=y
 CONFIG_CMD_GPT=y
 CONFIG_CMD_I2C=y
 CONFIG_CMD_MMC=y
+CONFIG_CMD_USB_MASS_STORAGE=y
 CONFIG_CMD_POWEROFF=y
 CONFIG_CMD_SNTP=y
 CONFIG_CMD_CACHE=y
-- 
