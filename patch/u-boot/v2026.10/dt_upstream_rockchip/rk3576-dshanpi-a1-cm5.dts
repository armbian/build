/*
 * Copyright (c) 2026 sckiyo <sckiyo@outlook.com>
 *
 * 100ASK DshanPi A1 CM5 core module.
 * This U-Boot DT holds only the boot devices:
 * debug UART, TF card, eMMC, and the RGMII1 Ethernet PHY.
 * The carrier has no devices that U-Boot needs at boot.
 */

/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/pinctrl/rockchip.h>
#include "rk3576.dtsi"

/ {
	model = "100ASK DshanPi A1 CM5";
	compatible = "100ask,dshanpi-a1-cm5", "rockchip,rk3576";

	aliases {
		ethernet0 = &gmac1;
		mmc0 = &sdhci;
		mmc1 = &sdmmc;
		mmc2 = &sdio;
	};

	chosen {
		stdout-path = "serial0:1500000n8";
	};
};

&gmac1 {
	clock_in_out = "output";
	phy-handle = <&yt8521s_phy>;
	phy-mode = "rgmii-id";
	tx_delay = <0x00>;
	rx_delay = <0x00>;
	pinctrl-names = "default";
	pinctrl-0 = <&eth1m0_miim
		     &eth1m0_tx_bus2
		     &eth1m0_rx_bus2
		     &eth1m0_rgmii_clk
		     &eth1m0_rgmii_bus>;
	status = "okay";
};

&mdio1 {
	yt8521s_phy: ethernet-phy@0 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <0>;
		pinctrl-names = "default";
		pinctrl-0 = <&gmac1_rstn>;
		reset-assert-us = <20000>;
		reset-deassert-us = <100000>;
		reset-gpios = <&gpio0 RK_PC5 GPIO_ACTIVE_LOW>;
		/* PHY TX and RX delay is 1.95 ns in rgmii-id mode. */
		rx-internal-delay-ps = <1950>;
		tx-internal-delay-ps = <1950>;
	};
};

&pinctrl {
	gmac {
		gmac1_rstn: gmac1-rstn {
			rockchip,pins = <0 RK_PC5 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
};

&sdhci {
	bus-width = <8>;
	max-frequency = <200000000>;
	mmc-hs400-1_8v;
	mmc-hs400-enhanced-strobe;
	no-sdio;
	no-sd;
	non-removable;
	status = "okay";
};

/*
 * GPIO0_B6 keeps the SDMMC0_PWREN function from the SoC default pinctrl.
 * dw_mmc sets PWREN at init, so the TF card has power.
 * Linux drives the same pin as a GPIO regulator.
 */
&sdmmc {
	bus-width = <4>;
	cap-sd-highspeed;
	disable-wp;
	max-frequency = <50000000>;
	no-mmc;
	no-sdio;
	status = "okay";
};

&uart0 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart0m0_xfer>;
	status = "okay";
};
