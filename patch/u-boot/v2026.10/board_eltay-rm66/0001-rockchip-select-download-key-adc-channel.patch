Subject: [PATCH] rockchip: Select the download key ADC channel

ELTAY RM66 wires the recovery key to SARADC channel 0.
Enter BootROM download mode when the key is held at startup.

diff --git a/arch/arm/mach-rockchip/boot_mode.c b/arch/arm/mach-rockchip/boot_mode.c
index 55e9456..263bd41 100644
--- a/arch/arm/mach-rockchip/boot_mode.c
+++ b/arch/arm/mach-rockchip/boot_mode.c
@@ -10,6 +10,7 @@
 #include <asm/io.h>
 #include <asm/arch-rockchip/boot_mode.h>
 #include <dm/device.h>
+#include <dm/ofnode.h>
 #include <dm/uclass.h>
 #include <linux/printk.h>
 
@@ -43,16 +44,17 @@ __weak int rockchip_dnl_key_pressed(void)
 	unsigned int val;
 	struct udevice *dev;
 	struct uclass *uc;
-	int ret;
+	int channel, ret;
 
 	ret = uclass_get(UCLASS_ADC, &uc);
 	if (ret)
 		return false;
 
+	channel = ofnode_conf_read_int("u-boot,rockchip-download-key-adc-channel", 1);
 	ret = -ENODEV;
 	uclass_foreach_dev(dev, uc) {
 		if (!strncmp(dev->name, "saradc", 6)) {
-			ret = adc_channel_single_shot(dev->name, 1, &val);
+			ret = adc_channel_single_shot(dev->name, channel, &val);
 			break;
 		}
 	}
diff --git a/doc/device-tree-bindings/config.txt b/doc/device-tree-bindings/config.txt
index 3756f57..a033fb0 100644
--- a/doc/device-tree-bindings/config.txt
+++ b/doc/device-tree-bindings/config.txt
@@ -90,6 +90,10 @@ rootdisk-offset (int)
 silent-console (int)
 	If present and non-zero, the console is silenced by default on boot.
 
+u-boot,rockchip-download-key-adc-channel (int)
+	Selects the SARADC channel for the Rockchip download key.
+	Defaults to channel 1.
+
 u-boot,spl-payload-offset (int)
 	If present (and SPL is controlled by the device-tree), this allows
 	to override the CONFIG_SYS_SPI_U_BOOT_OFFS setting using a value
