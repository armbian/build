Subject: [PATCH] rockchip: Preserve the RK356x BootROM download request

A global reset can clear BOOT_MODE_REG on RK356x.
Clear PMUGRF SOC_CON1 bit 2 before setting the download flag.

Link: https://lists.denx.de/pipermail/u-boot/2024-February/545125.html

diff --git a/arch/arm/mach-rockchip/boot_mode.c b/arch/arm/mach-rockchip/boot_mode.c
--- a/arch/arm/mach-rockchip/boot_mode.c
+++ b/arch/arm/mach-rockchip/boot_mode.c
@@ -9,9 +9,11 @@
 #include <log.h>
 #include <asm/io.h>
 #include <asm/arch-rockchip/boot_mode.h>
+#include <asm/arch-rockchip/hardware.h>
 #include <dm/device.h>
 #include <dm/ofnode.h>
 #include <dm/uclass.h>
+#include <linux/bitops.h>
 #include <linux/printk.h>
 
 #if (CONFIG_ROCKCHIP_BOOT_MODE_REG == 0)
@@ -23,8 +25,14 @@
 
 #else
 
+#define RK356X_PMUGRF_SOC_CON1 0xfdc20104
+
 void set_back_to_bootrom_dnl_flag(void)
 {
+	/* Preserve BOOT_MODE_REG across a global reset on RK356x. */
+	if (IS_ENABLED(CONFIG_ROCKCHIP_RK3568))
+		rk_clrreg(RK356X_PMUGRF_SOC_CON1, BIT(2));
+
 	writel(BOOT_BROM_DOWNLOAD, CONFIG_ROCKCHIP_BOOT_MODE_REG);
 }
 
