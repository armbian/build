From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: khaliforce <kforce@gmail.com>
Date: Mon, 5 Oct 2026 13:26:13 +0900
Subject: sunxi: add the RISC-V D1 platform configuration

Select the C906 CPU and D1 memory layout. Keep ARM board settings separate.
Follow the D1 Kconfig layout of Samuel Holland's port.

Link: https://github.com/smaeul/u-boot/tree/2e89b706f5c956a70c989cd31665f1429e9a0b48
Signed-off-by: khaliforce <kforce@gmail.com>
---
 arch/riscv/Kconfig        | 12 +++++
 board/sunxi/Kconfig-riscv | 24 ++++++++++
 include/configs/sun20i.h  | 12 +++++
 3 files changed, 48 insertions(+)

diff --git a/arch/riscv/Kconfig b/arch/riscv/Kconfig
index 111111111111..222222222222 100644
--- a/arch/riscv/Kconfig
+++ b/arch/riscv/Kconfig
@@ -57,6 +57,16 @@ config TARGET_STARFIVE_VISIONFIVE2
 	bool "Support StarFive VisionFive2 Board"
 	select BOARD_LATE_INIT
 
+config TARGET_SUN20I_D1
+	bool "Support Allwinner D1 boards"
+	select DM
+	select THEAD_C906
+	select GENERIC_RISCV
+	select SUPPORT_SPL
+	help
+	  Build for Allwinner D1 boards with a T-Head C906 CPU.
+	  Use a board defconfig to select DRAM and peripheral settings.
+
 config TARGET_TH1520_LPI4A
 	bool "Support Sipeed's TH1520 Lichee PI 4A Board"
 	select SYS_CACHE_SHIFT_6
@@ -125,6 +135,7 @@ source "board/sophgo/milkv_duo_256m/Kconfig"
 source "board/sophgo/licheerv_nano/Kconfig"
 source "board/spacemit/k1/Kconfig"
 source "board/starfive/visionfive2/Kconfig"
+source "board/sunxi/Kconfig-riscv"
 source "board/thead/th1520_lpi4a/Kconfig"
 source "board/xilinx/mbv/Kconfig"
 
@@ -146,6 +157,7 @@ source "arch/riscv/cpu/th1520/Kconfig"
 
 choice
 	prompt "Base ISA"
+	default ARCH_RV64I if TARGET_SUN20I_D1
 	default ARCH_RV32I
 
 config ARCH_RV32I
diff --git a/board/sunxi/Kconfig-riscv b/board/sunxi/Kconfig-riscv
new file mode 100644
index 000000000000..111111111111
--- /dev/null
+++ b/board/sunxi/Kconfig-riscv
@@ -0,0 +1,24 @@
+# SPDX-License-Identifier: GPL-2.0+
+# Copyright (C) 2026 khaliforce <kforce@gmail.com>
+
+if TARGET_SUN20I_D1
+
+config SYS_CPU
+	default "c906"
+
+config SYS_BOARD
+	default "sunxi"
+
+config SYS_SOC
+	default "sunxi"
+
+config SYS_CONFIG_NAME
+	default "sun20i"
+
+config TEXT_BASE
+	default 0x4a000000
+
+config SYS_LOAD_ADDR
+	default 0x42000000
+
+endif
diff --git a/include/configs/sun20i.h b/include/configs/sun20i.h
new file mode 100644
index 000000000000..111111111111
--- /dev/null
+++ b/include/configs/sun20i.h
@@ -0,0 +1,12 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+/* Copyright (C) 2026 khaliforce <kforce@gmail.com> */
+
+#ifndef __CONFIG_SUN20I_H
+#define __CONFIG_SUN20I_H
+
+/* The CCU driver does not provide the UART clock rate. */
+#define CFG_SYS_NS16550_CLK	24000000
+
+#define CFG_SYS_SDRAM_BASE	0x40000000
+
+#endif
-- 
Armbian

