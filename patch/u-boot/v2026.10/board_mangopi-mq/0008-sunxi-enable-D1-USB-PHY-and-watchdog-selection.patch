From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: khaliforce <kforce@gmail.com>
Date: Mon, 5 Oct 2026 15:03:01 +0900
Subject: sunxi: enable D1 USB PHY and watchdog selection

Keep the sunxi USB polling and watchdog defaults for D1.

Signed-off-by: khaliforce <kforce@gmail.com>
---
 drivers/phy/allwinner/Kconfig | 2 +-
 drivers/usb/Kconfig           | 2 +-
 drivers/watchdog/Kconfig      | 6 +++---
 3 files changed, 5 insertions(+), 5 deletions(-)

diff --git a/drivers/phy/allwinner/Kconfig b/drivers/phy/allwinner/Kconfig
index 111111111111..222222222222 100644
--- a/drivers/phy/allwinner/Kconfig
+++ b/drivers/phy/allwinner/Kconfig
@@ -3,7 +3,7 @@
 #
 config PHY_SUN4I_USB
 	bool "Allwinner Sun4I USB PHY driver"
-	depends on ARCH_SUNXI
+	depends on ARCH_SUNXI || TARGET_SUN20I_D1
 	depends on !MACH_SUN9I
 	default n if MACH_SUN8I_V3S
 	default y
diff --git a/drivers/usb/Kconfig b/drivers/usb/Kconfig
index 111111111111..222222222222 100644
--- a/drivers/usb/Kconfig
+++ b/drivers/usb/Kconfig
@@ -161,7 +161,7 @@ config USB_KEYBOARD_FN_KEYS
 
 choice
 	prompt "USB keyboard polling"
-	default SYS_USB_EVENT_POLL_VIA_INT_QUEUE if ARCH_SUNXI
+	default SYS_USB_EVENT_POLL_VIA_INT_QUEUE if ARCH_SUNXI || TARGET_SUN20I_D1
 	default SYS_USB_EVENT_POLL
 	help
 	  Enable a polling mechanism for USB keyboard.
diff --git a/drivers/watchdog/Kconfig b/drivers/watchdog/Kconfig
index 111111111111..222222222222 100644
--- a/drivers/watchdog/Kconfig
+++ b/drivers/watchdog/Kconfig
@@ -14,7 +14,7 @@ config WATCHDOG
 config WATCHDOG_AUTOSTART
 	bool "Automatically start watchdog timer"
 	depends on WDT
-	default n if ARCH_SUNXI
+	default n if ARCH_SUNXI || TARGET_SUN20I_D1
 	default n if ARCH_STM32MP
 	default n if ARCH_SNAPDRAGON
 	default y
@@ -33,7 +33,7 @@ config WATCHDOG_TIMEOUT_MSECS
 	default 128000 if ARCH_MX7 || ARCH_VF610
 	default 30000 if ARCH_SNAPDRAGON
 	default 10000 if ARCH_SOCFPGA
-	default 16000 if ARCH_SUNXI
+	default 16000 if ARCH_SUNXI || TARGET_SUN20I_D1
 	default 5376 if ULP_WATCHDOG
 	default 15000 if ARCH_BCM283X
 	default 60000
@@ -427,7 +427,7 @@ config WDT_STARFIVE
 
 config WDT_SUNXI
 	bool "Allwinner sunxi watchdog timer support"
-	depends on WDT && ARCH_SUNXI
+	depends on WDT && (ARCH_SUNXI || TARGET_SUN20I_D1)
 	default y
 	help
 	  Enable support for the watchdog timer in Allwinner sunxi SoCs.
-- 
Armbian

