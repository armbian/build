From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: khaliforce <kforce@gmail.com>
Date: Mon, 5 Oct 2026 13:50:58 +0900
Subject: sunxi: allow D1 to use the existing peripheral drivers

Enable clock, pin, reset, MMC and RAM drivers for RISC-V D1.

Signed-off-by: khaliforce <kforce@gmail.com>
---
 arch/riscv/Kconfig            |  5 ++
 board/sunxi/Kconfig-riscv     | 27 ++++++++++
 drivers/clk/sunxi/Kconfig     |  4 +-
 drivers/gpio/Kconfig          |  2 +-
 drivers/mmc/Kconfig           |  2 +-
 drivers/pinctrl/sunxi/Kconfig |  4 +-
 drivers/ram/sunxi/Kconfig     |  2 +-
 drivers/reset/Kconfig         |  2 +-
 8 files changed, 40 insertions(+), 8 deletions(-)

diff --git a/arch/riscv/Kconfig b/arch/riscv/Kconfig
index 111111111111..222222222222 100644
--- a/arch/riscv/Kconfig
+++ b/arch/riscv/Kconfig
@@ -60,6 +60,11 @@ config TARGET_STARFIVE_VISIONFIVE2
 config TARGET_SUN20I_D1
 	bool "Support Allwinner D1 boards"
 	select DM
+	select CLK
+	select DRAM_SUN20I_D1
+	select SUNXI_GEN_NCAT2
+	select SUNXI_NEW_PINCTRL
+	select MMC_SUNXI_HAS_NEW_MODE
 	select THEAD_C906
 	select GENERIC_RISCV
 	select SUPPORT_SPL
diff --git a/board/sunxi/Kconfig-riscv b/board/sunxi/Kconfig-riscv
index 111111111111..222222222222 100644
--- a/board/sunxi/Kconfig-riscv
+++ b/board/sunxi/Kconfig-riscv
@@ -21,4 +21,31 @@ config TEXT_BASE
 config SYS_LOAD_ADDR
 	default 0x42000000
 
+config SUNXI_GEN_NCAT2
+	bool
+
+config SUNXI_NEW_PINCTRL
+	bool
+
+config SUNXI_SRAM_ADDRESS
+	hex
+	default 0x20000
+
+config SYS_CLK_FREQ
+	default 1008000000
+
+config DRAM_CLK
+	int "D1 DRAM clock in MHz"
+	default 792
+	help
+	  Set the DRAM clock for the fitted memory chips.
+	  Use the value tested for the board.
+
+config DRAM_ZQ
+	int "D1 DRAM ZQ calibration"
+	default 8092667
+	help
+	  Set the ZQ calibration value for the fitted memory chips.
+	  Use the value tested for the board.
+
 endif
diff --git a/drivers/clk/sunxi/Kconfig b/drivers/clk/sunxi/Kconfig
index 111111111111..222222222222 100644
--- a/drivers/clk/sunxi/Kconfig
+++ b/drivers/clk/sunxi/Kconfig
@@ -1,6 +1,6 @@
 config CLK_SUNXI
 	bool "Clock support for Allwinner SoCs"
-	depends on CLK && ARCH_SUNXI
+	depends on CLK && (ARCH_SUNXI || TARGET_SUN20I_D1)
 	select DM_RESET
 	select SPL_DM_RESET if SPL_CLK
 	default y
@@ -89,7 +89,7 @@ config CLK_SUN8I_H3
 
 config CLK_SUN20I_D1
 	bool "Clock driver for Allwinner D1"
-	default MACH_SUN8I_R528
+	default MACH_SUN8I_R528 || TARGET_SUN20I_D1
 	help
 	  This enables common clock driver support for platforms based
 	  on Allwinner D1 SoC.
diff --git a/drivers/gpio/Kconfig b/drivers/gpio/Kconfig
index 111111111111..222222222222 100644
--- a/drivers/gpio/Kconfig
+++ b/drivers/gpio/Kconfig
@@ -459,7 +459,7 @@ config SPACEMIT_GPIO
 
 config SUNXI_GPIO
 	bool "Allwinner GPIO driver"
-	depends on ARCH_SUNXI
+	depends on ARCH_SUNXI || TARGET_SUN20I_D1
 	select SPL_STRTO if SPL
 	help
 	  Support the GPIO device in Allwinner SoCs.
diff --git a/drivers/mmc/Kconfig b/drivers/mmc/Kconfig
index 111111111111..222222222222 100644
--- a/drivers/mmc/Kconfig
+++ b/drivers/mmc/Kconfig
@@ -804,7 +804,7 @@ config ZYNQ_HISPD_BROKEN
 
 config MMC_SUNXI
 	bool "Allwinner sunxi SD/MMC Host Controller support"
-	depends on ARCH_SUNXI
+	depends on ARCH_SUNXI || TARGET_SUN20I_D1
 	default y
 	help
 	  This selects support for the SD/MMC Host Controller on
diff --git a/drivers/pinctrl/sunxi/Kconfig b/drivers/pinctrl/sunxi/Kconfig
index 111111111111..222222222222 100644
--- a/drivers/pinctrl/sunxi/Kconfig
+++ b/drivers/pinctrl/sunxi/Kconfig
@@ -1,6 +1,6 @@
 # SPDX-License-Identifier: GPL-2.0
 
-if ARCH_SUNXI
+if ARCH_SUNXI || TARGET_SUN20I_D1
 
 config PINCTRL_SUNXI
 	select PINCTRL_FULL
@@ -136,7 +136,7 @@ config PINCTRL_SUN50I_A100_R
 
 config PINCTRL_SUN20I_D1
 	bool "Support for the Allwinner D1/R528 PIO"
-	default MACH_SUN8I_R528
+	default MACH_SUN8I_R528 || TARGET_SUN20I_D1
 	select PINCTRL_SUNXI
 
 config PINCTRL_SUN55I_A523
diff --git a/drivers/ram/sunxi/Kconfig b/drivers/ram/sunxi/Kconfig
index 111111111111..222222222222 100644
--- a/drivers/ram/sunxi/Kconfig
+++ b/drivers/ram/sunxi/Kconfig
@@ -1,6 +1,6 @@
 config DRAM_SUN20I_D1
 	bool
-	depends on ARCH_SUNXI
+	depends on ARCH_SUNXI || TARGET_SUN20I_D1
 	help
 	  This enables support for the DRAM controller driver covering
 	  the Allwinner D1/R528/T113s SoCs.
diff --git a/drivers/reset/Kconfig b/drivers/reset/Kconfig
index 111111111111..222222222222 100644
--- a/drivers/reset/Kconfig
+++ b/drivers/reset/Kconfig
@@ -179,7 +179,7 @@ config RESET_NPCM
 
 config RESET_SUNXI
 	bool "RESET support for Allwinner SoCs"
-	depends on DM_RESET && ARCH_SUNXI
+	depends on DM_RESET && (ARCH_SUNXI || TARGET_SUN20I_D1)
 	default y
 	help
 	  This enables support for common reset driver for
-- 
Armbian

