From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: khaliforce <kforce@gmail.com>
Date: Mon, 5 Oct 2026 13:55:46 +0900
Subject: sunxi: add the D1 SPL and FIT handoff

Load OpenSBI and U-Boot from SD.
Pass the detected DRAM size through the firmware DT.
Based on Samuel Holland's D1 board implementation.

Link: https://github.com/smaeul/u-boot/tree/2e89b706f5c956a70c989cd31665f1429e9a0b48
Signed-off-by: khaliforce <kforce@gmail.com>
---
 arch/riscv/dts/sunxi-u-boot.dtsi |  90 +++++
 board/sunxi/Kconfig-riscv        |  22 ++
 board/sunxi/Makefile             |   3 +-
 board/sunxi/d1.c                 | 173 ++++++++++
 common/spl/Kconfig               |  13 +-
 scripts/Makefile.xpl             |   2 +-
 6 files changed, 295 insertions(+), 8 deletions(-)

diff --git a/arch/riscv/dts/sunxi-u-boot.dtsi b/arch/riscv/dts/sunxi-u-boot.dtsi
new file mode 100644
index 000000000000..111111111111
--- /dev/null
+++ b/arch/riscv/dts/sunxi-u-boot.dtsi
@@ -0,0 +1,90 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+
+#include "binman.dtsi"
+
+/ {
+	cpus {
+		bootph-all;
+	};
+
+	soc {
+		bootph-all;
+#ifdef CONFIG_TARGET_SUN20I_D1
+		/* OpenSBI requires machine-mode timer and IPI nodes in the FIT DTB. */
+		clint@14000000 {
+			compatible = "allwinner,sun20i-d1-clint", "thead,c900-clint";
+			reg = <0x14000000 0xc000>;
+			reg-io-width = <4>;
+			interrupts-extended = <&cpu0_intc 3>, <&cpu0_intc 7>;
+		};
+#endif
+	};
+};
+
+&binman {
+	u-boot-sunxi-with-spl {
+		filename = "u-boot-sunxi-with-spl.bin";
+		pad-byte = <0xff>;
+
+		blob@0 {
+			/*
+			 * This value matches SYS_MMCSD_RAW_MODE_U_BOOT_SECTOR
+			 * and SYS_SPI_U_BOOT_OFFS if those are defined.
+			 */
+			min-size = <0x8000>;
+			filename = "spl/sunxi-spl.bin";
+		};
+
+		blob@1 {
+			filename = "u-boot.itb";
+		};
+	};
+};
+
+&ccu {
+	bootph-all;
+};
+
+&cpu0 {
+	bootph-all;
+};
+
+&dcxo {
+	bootph-all;
+};
+
+&mbus {
+	bootph-all;
+};
+
+&mmc0 {
+	bootph-all;
+};
+
+&mmc0_pins {
+	bootph-all;
+};
+
+&pio {
+	bootph-all;
+
+	uart0-pb8-pins {
+		bootph-all;
+	};
+
+	uart3-pb-pins {
+		bootph-all;
+	};
+};
+
+&rtc {
+	bootph-all;
+};
+
+&uart0 {
+	bootph-all;
+};
+
+&uart3 {
+	bootph-all;
+};
