From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: khaliforce <kforce@gmail.com>
Date: Mon, 5 Oct 2026 13:50:58 +0900
Subject: clk: sunxi: initialize the D1 CPU PLL

Set the D1 CPU PLL frequency without changing ARM clock descriptors.
Follow clock_get_pll6() in arch/arm/mach-sunxi/clock_sun50i_h6.c.

Signed-off-by: khaliforce <kforce@gmail.com>
---
 drivers/clk/sunxi/clk_sunxi.c | 11 ++++
 include/clk/sunxi-d1.h        | 28 ++++++++++
 2 files changed, 39 insertions(+)

diff --git a/drivers/clk/sunxi/clk_sunxi.c b/drivers/clk/sunxi/clk_sunxi.c
index 111111111111..222222222222 100644
--- a/drivers/clk/sunxi/clk_sunxi.c
+++ b/drivers/clk/sunxi/clk_sunxi.c
@@ -11,6 +11,9 @@
 #include <reset.h>
 #include <asm/io.h>
 #include <clk/sunxi.h>
+#ifdef CONFIG_TARGET_SUN20I_D1
+#include <clk/sunxi-d1.h>
+#endif
 #include <dm/device-internal.h>
 #include <linux/bitops.h>
 #include <linux/log2.h>
@@ -78,6 +81,9 @@ static int sunxi_clk_bind(struct udevice *dev)
 
 static int sunxi_clk_probe(struct udevice *dev)
 {
+#ifdef CONFIG_TARGET_SUN20I_D1
+	struct ccu_plat *plat = dev_get_plat(dev);
+#endif
 	struct clk_bulk clk_bulk;
 	struct reset_ctl_bulk rst_bulk;
 	int ret;
@@ -90,6 +96,11 @@ static int sunxi_clk_probe(struct udevice *dev)
 	if (!ret)
 		reset_deassert_bulk(&rst_bulk);
 
+#ifdef CONFIG_TARGET_SUN20I_D1
+	if (plat->desc == &d1_ccu_desc)
+		sunxi_d1_clock_init(plat->base);
+#endif
+
 	return 0;
 }
 
diff --git a/include/clk/sunxi-d1.h b/include/clk/sunxi-d1.h
new file mode 100644
index 000000000000..111111111111
--- /dev/null
+++ b/include/clk/sunxi-d1.h
@@ -0,0 +1,28 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+/* Copyright (C) 2026 khaliforce <kforce@gmail.com> */
+
+#ifndef _CLK_SUNXI_D1_H
+#define _CLK_SUNXI_D1_H
+
+#include <asm/io.h>
+#include <linux/bitops.h>
+
+extern const struct ccu_desc d1_ccu_desc;
+
+static inline void sunxi_d1_clock_init(void __iomem *base)
+{
+	clrsetbits_le32(base, GENMASK(15, 8),
+		       (CONFIG_SYS_CLK_FREQ / 24000000 - 1) << 8);
+}
+
+static inline unsigned int sunxi_d1_get_pll6(void)
+{
+	u32 val = readl((void __iomem *)0x02001020);
+	u32 n = ((val >> 8) & 0xff) + 1;
+	u32 m = ((val >> 1) & 1) + 1;
+	u32 p = ((val >> 16) & 7) + 1;
+
+	return 24000000U * n / m / p;
+}
+
+#endif
-- 
Armbian

