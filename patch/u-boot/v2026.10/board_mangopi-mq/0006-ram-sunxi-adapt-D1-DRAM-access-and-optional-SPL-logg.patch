From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: khaliforce <kforce@gmail.com>
Date: Mon, 5 Oct 2026 13:52:33 +0900
Subject: ram: sunxi: adapt D1 DRAM access and optional SPL logging

Allow the D1 DRAM driver to compile for RISC-V.
Support optional SPL DRAM initialization and memory test logs.

Signed-off-by: khaliforce <kforce@gmail.com>
---
 drivers/ram/sunxi/Kconfig          |   6 +
 drivers/ram/sunxi/Makefile         |   6 +
 drivers/ram/sunxi/dram_sun20i_d1.c | 168 +++++-----
 3 files changed, 97 insertions(+), 83 deletions(-)

diff --git a/drivers/ram/sunxi/Kconfig b/drivers/ram/sunxi/Kconfig
index 111111111111..222222222222 100644
--- a/drivers/ram/sunxi/Kconfig
+++ b/drivers/ram/sunxi/Kconfig
@@ -7,6 +7,12 @@ config DRAM_SUN20I_D1
 
 if DRAM_SUN20I_D1
 
+config SPL_DRAM_SUNXI_DEBUG
+	bool "Verbose D1 SPL DRAM initialization"
+	depends on SPL
+	help
+	  Print DRAM initialization and memory test details in SPL.
+
 config DRAM_SUNXI_ODT_EN
 	hex "DRAM ODT EN parameter"
 	help
diff --git a/drivers/ram/sunxi/Makefile b/drivers/ram/sunxi/Makefile
index 111111111111..222222222222 100644
--- a/drivers/ram/sunxi/Makefile
+++ b/drivers/ram/sunxi/Makefile
@@ -1,3 +1,9 @@
 # SPDX-License-Identifier: GPL-2.0+
 
 obj-$(CONFIG_DRAM_SUN20I_D1) += dram_sun20i_d1.o
+
+ifdef CONFIG_XPL_BUILD
+ifeq ($(CONFIG_SPL_DRAM_SUNXI_DEBUG),y)
+CFLAGS_dram_sun20i_d1.o += -DDEBUG
+endif
+endif
