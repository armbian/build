From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Igor Velkov <iav@iav.lv>
Date: Thu, 24 Sep 2026 01:10:59 +0300
Subject: [PATCH 1/4] g12a: scp_task: print a build identifier (BL301_ID) in
 the start banner

When BL301_ID is set at build time, print it after "secure task start!"
so the console shows which BL301 runs. Without it the output is unchanged.

Signed-off-by: Igor Velkov <iav@iav.lv>
---
 arch/arm/cpu/armv8/g12a/firmware/scp_task/Makefile    | 5 +++++
 arch/arm/cpu/armv8/g12a/firmware/scp_task/user_task.c | 4 ++++
 2 files changed, 9 insertions(+)

diff --git a/arch/arm/cpu/armv8/g12a/firmware/scp_task/Makefile b/arch/arm/cpu/armv8/g12a/firmware/scp_task/Makefile
index 82f31b8..52eefdb 100644
--- a/arch/arm/cpu/armv8/g12a/firmware/scp_task/Makefile
+++ b/arch/arm/cpu/armv8/g12a/firmware/scp_task/Makefile
@@ -49,6 +49,11 @@ ifdef CONFIG_ODROID_COMMON
 CFLAGS += -DCONFIG_ODROID_COMMON
 endif
 
+# Build identifier printed in the "secure task start!" banner
+ifneq ($(BL301_ID),)
+CFLAGS += -DBL301_ID=\"$(BL301_ID)\"
+endif
+
 LDFLAGS=-Bstatic
 #LDFLAGS+=$(LD_LIB_PATH_ARM:%=-L%) -lm -lc -lgcc
 
diff --git a/arch/arm/cpu/armv8/g12a/firmware/scp_task/user_task.c b/arch/arm/cpu/armv8/g12a/firmware/scp_task/user_task.c
index 1bad144..fe80bcd 100644
--- a/arch/arm/cpu/armv8/g12a/firmware/scp_task/user_task.c
+++ b/arch/arm/cpu/armv8/g12a/firmware/scp_task/user_task.c
@@ -86,7 +86,11 @@ void secure_task(void)
 
 	/*init bss */
 	bss_init();
+#ifdef BL301_ID
+	dbg_prints("secure task start! [" BL301_ID "]\n");
+#else
 	dbg_prints("secure task start!\n");
+#endif
 
 	/* suspend pwr ops init*/
 	suspend_pwr_ops_init();
