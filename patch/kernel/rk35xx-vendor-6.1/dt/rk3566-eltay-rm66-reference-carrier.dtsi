/*
 * EXPERIMENTAL reference carrier composition for ELTAY RM66 — vendor BSP 6.1
 * flavor. Include after rk3566-eltay-rm66.dtsi.
 *
 * Port of the mainline rk3566-eltay-rm66-reference-carrier.dtsi to the BSP
 * bindings: the SoC dtsi pre-wires the HDMI/VOP graph (hdmi_in_vp0 is linked
 * to vp0_out_hdmi, both endpoints exist with status = "disabled"), so this
 * file only flips statuses and adds the connector-side output endpoint.
 * The generic DTB uses this reference wiring; it is not a claim that an
 * arbitrary CM4 carrier has the same power switches, pinmux or port roles.
 * Camera/CSI nodes are intentionally absent here (see the SoM dtsi header).
 */

#include <dt-bindings/leds/common.h>
#include <dt-bindings/soc/rockchip,vop2.h>

/ {
	aliases {
		mmc1 = &sdmmc0;
	};

	chosen {
		stdout-path = "serial2:1500000n8";
	};

	hdmi-con {
		compatible = "hdmi-connector";
		type = "a";

		port {
			hdmi_con_in: endpoint {
				remote-endpoint = <&hdmi_out_con>;
			};
		};
	};

	leds {
		compatible = "gpio-leds";
		pinctrl-names = "default";
		pinctrl-0 = <&work_led>;

		led-0 {
			color = <LED_COLOR_ID_GREEN>;
			default-state = "on";
			function = LED_FUNCTION_HEARTBEAT;
			gpios = <&gpio0 RK_PC0 GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "heartbeat";
		};
	};

	vcc3v3_pcie30: regulator-3v3-vcc-pcie30 {
		compatible = "regulator-fixed";
		enable-active-high;
		gpios = <&gpio0 RK_PB7 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&pcie20_pwren>;
		regulator-name = "vcc3v3_pcie30";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&vcc3v3_sys>;
	};

	vcc3v3_sys: regulator-3v3-vcc-sys {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v3_sys";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&vcc5v0_sys>;
	};

	vcc5v0_sys: regulator-5v0-vcc-sys {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_sys";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
	};

	vcc5v0_usb_host: regulator-5v0-vcc-usb-host {
		compatible = "regulator-fixed";
		enable-active-high;
		gpios = <&gpio0 RK_PA6 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&usb_host_pwren_h>;
		regulator-name = "vcc5v0_usb_host";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		vin-supply = <&vcc5v0_sys>;
	};

	vcc5v0_usb_otg: regulator-5v0-vcc-usb-otg {
		compatible = "regulator-fixed";
		enable-active-high;
		gpios = <&gpio0 RK_PA5 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&usb_otg_pwren_h>;
		regulator-name = "vcc5v0_usb_otg";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		vin-supply = <&vcc5v0_sys>;
	};
};

&combphy1_usq {
	status = "okay";
};

&combphy2_psq {
	status = "okay";
};

&hdmi {
	avdd-0v9-supply = <&vdda0v9_image>;
	avdd-1v8-supply = <&vcca1v8_image>;
	status = "okay";

	port@1 {
		reg = <1>;
		hdmi_out_con: endpoint {
			remote-endpoint = <&hdmi_con_in>;
		};
	};
};

/* The SoC dtsi pre-wires hdmi_in_vp0 <-> vp0_out_hdmi; only enable it. */
&hdmi_in_vp0 {
	status = "okay";
};

&hdmi_sound {
	status = "okay";
};

&i2s0_8ch {
	status = "okay";
};

&pcie2x1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pcie20_pins>;
	reset-gpios = <&gpio0 RK_PB6 GPIO_ACTIVE_HIGH>;
	vpcie3v3-supply = <&vcc3v3_pcie30>;
	status = "okay";
};

&saradc {
	vref-supply = <&vcca_1v8>;
	status = "okay";
};

&sdmmc0 {
	bus-width = <4>;
	cap-sd-highspeed;
	disable-wp;
	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc0_bus4 &sdmmc0_clk &sdmmc0_cmd &sdmmc0_det>;
	vmmc-supply = <&vcc3v3_sd>;
	vqmmc-supply = <&vccio_sd>;
	status = "okay";
};

&uart2 {
	status = "okay";
};

&usb_host0_ehci {
	status = "okay";
};

&usb_host0_ohci {
	status = "okay";
};

/* BSP names the USB3 controllers usbdrd30/usbhost30 with dwc3 children;
 * the fcc00000 port keeps the reference-carrier host-only role. */
&usbdrd30 {
	status = "okay";
};

&usbdrd_dwc3 {
	dr_mode = "host";
	status = "okay";
};

&usbhost30 {
	status = "okay";
};

&usbhost_dwc3 {
	status = "okay";
};

&usb_host1_ehci {
	status = "okay";
};

&usb_host1_ohci {
	status = "okay";
};

&usb2phy0 {
	status = "okay";
};

&u2phy0_host {
	phy-supply = <&vcc5v0_usb_host>;
	status = "okay";
};

&u2phy0_otg {
	phy-supply = <&vcc5v0_usb_otg>;
	status = "okay";
};

&usb2phy1 {
	status = "okay";
};

&u2phy1_host {
	phy-supply = <&vcc5v0_usb_host>;
	status = "okay";
};

&u2phy1_otg {
	phy-supply = <&vcc5v0_usb_host>;
	status = "okay";
};

&vop {
	assigned-clocks = <&cru DCLK_VOP0>, <&cru DCLK_VOP1>;
	assigned-clock-parents = <&pmucru PLL_HPLL>, <&cru PLL_VPLL>;
	status = "okay";
};

&vop_mmu {
	status = "okay";
};

&pinctrl {
	leds {
		work_led: work-led {
			rockchip,pins = <0 RK_PC0 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	pcie {
		pcie20_pins: pcie20-pins {
			rockchip,pins =
				<1 RK_PB0 4 &pcfg_pull_none>,
				<0 RK_PB6 RK_FUNC_GPIO &pcfg_pull_none>,
				<1 RK_PB1 4 &pcfg_pull_none>;
		};

		pcie20_pwren: pcie20-pwren {
			rockchip,pins = <0 RK_PB7 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	usb {
		usb_host_pwren_h: usb-host-pwren-h {
			rockchip,pins = <0 RK_PA6 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		usb_otg_pwren_h: usb-otg-pwren-h {
			rockchip,pins = <0 RK_PA5 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
};

/* Power entering the module from the reference system supply. */
&rk809 {
	vcc1-supply = <&vcc3v3_sys>;
	vcc2-supply = <&vcc3v3_sys>;
	vcc3-supply = <&vcc3v3_sys>;
	vcc4-supply = <&vcc3v3_sys>;
	vcc5-supply = <&vcc3v3_sys>;
	vcc6-supply = <&vcc3v3_sys>;
	vcc7-supply = <&vcc3v3_sys>;
	vcc8-supply = <&vcc3v3_sys>;
	vcc9-supply = <&vcc3v3_sys>;
};

&vdd_cpu {
	vin-supply = <&vcc3v3_sys>;
};
