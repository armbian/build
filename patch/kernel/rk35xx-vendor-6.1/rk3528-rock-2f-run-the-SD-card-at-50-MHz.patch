From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Igor Pecovnik <igor@armbian.com>
Date: Sat, 24 Oct 2026 10:30:43 +0200
Subject: [ARCHEOLOGY] rock-2f: fix the vendor kernel console and SD card

> X-Git-Archeology: > recovered message: > The vendor kernel prints to ttyFIQ0, but the boot script sets ttyS2,
> X-Git-Archeology: > recovered message: > so the serial console stays silent. Use ttyFIQ0.
> X-Git-Archeology: > recovered message: > At UHS SDR104 150 MHz every SD read fails and root is not found.
> X-Git-Archeology: > recovered message: > Run the SD card at 50 MHz.
> X-Git-Archeology: > recovered message: > Assisted-by: Claude Opus 5.5
> X-Git-Archeology: > recovered message: > Signed-off-by: Igor Pecovnik <igor@armbian.com>
> X-Git-Archeology: - Revision 6e8ee0adb77e03736d80f6bb179d2da0df9328d0: https://github.com/armbian/build/commit/6e8ee0adb77e03736d80f6bb179d2da0df9328d0
> X-Git-Archeology:   Date: Sat, 24 Oct 2026 10:30:43 +0200
> X-Git-Archeology:   From: Igor Pecovnik <igor@armbian.com>
> X-Git-Archeology:   Subject: rock-2f: fix the vendor kernel console and SD card
> X-Git-Archeology:
---
 arch/arm64/boot/dts/rockchip/rk3528-rock-2f.dts | 7 ++-----
 1 file changed, 2 insertions(+), 5 deletions(-)

diff --git a/arch/arm64/boot/dts/rockchip/rk3528-rock-2f.dts b/arch/arm64/boot/dts/rockchip/rk3528-rock-2f.dts
index 111111111111..222222222222 100644
--- a/arch/arm64/boot/dts/rockchip/rk3528-rock-2f.dts
+++ b/arch/arm64/boot/dts/rockchip/rk3528-rock-2f.dts
@@ -396,15 +396,12 @@ &sdmmc {
 	cap-mmc-highspeed;
 	cap-sd-highspeed;
 	disable-wp;
-	max-frequency = <150000000>;
+	/* UHS SDR104 at 150 MHz fails every read: use high speed at 50 MHz */
+	max-frequency = <50000000>;
 	pinctrl-names = "default";
 	pinctrl-0 = <&sdmmc_clk &sdmmc_cmd &sdmmc_det &sdmmc_bus4>;
 	rockchip,default-sample-phase = <90>;
 	supports-sd;
-	sd-uhs-sdr12;
-	sd-uhs-sdr25;
-	sd-uhs-sdr50;
-	sd-uhs-sdr104;
 	vqmmc-supply = <&vccio_sd>;
 	vmmc-supply = <&vcc_sd>;
 	status = "okay";
-- 
Armbian

