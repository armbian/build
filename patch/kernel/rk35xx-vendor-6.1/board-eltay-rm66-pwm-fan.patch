From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Sergey Braumann <ripetitor@proton.me>
Date: Sat, 24 Oct 2026 09:57:29 +0500
Subject: arm64: dts: rockchip: add ELTAY RM66 vendor PWM fan

Enable automatic fan control on the BB CM4 carrier.

Signed-off-by: Sergey Braumann <ripetitor@proton.me>
---
 arch/arm64/boot/dts/rockchip/rk3566-eltay-rm66-reference-carrier.dtsi | 20 ++++++++++
 1 file changed, 20 insertions(+)

diff --git a/arch/arm64/boot/dts/rockchip/rk3566-eltay-rm66-reference-carrier.dtsi b/arch/arm64/boot/dts/rockchip/rk3566-eltay-rm66-reference-carrier.dtsi
index 111111111111..222222222222 100644
--- a/arch/arm64/boot/dts/rockchip/rk3566-eltay-rm66-reference-carrier.dtsi
+++ b/arch/arm64/boot/dts/rockchip/rk3566-eltay-rm66-reference-carrier.dtsi
@@ -28,6 +28,22 @@ chosen {
 		stdout-path = "serial2:1500000n8";
 	};
 
+	fan: pwm-fan {
+		compatible = "pwm-fan";
+		#cooling-cells = <2>;
+		pwms = <&pwm7 0 20000000 0>;
+		cooling-levels = <0 50 100 150 200 255>;
+		rockchip,temp-trips = <
+			50000   1
+			55000   2
+			60000   3
+			65000   4
+			70000   5
+		>;
+
+		status = "okay";
+	};
+
 	/* 25 MHz oscillator feeding both CSI connectors (CAM1/CAM2). */
 	ext_cam_clk_25m: external-camera-clock-25m {
 		compatible = "fixed-clock";
@@ -151,6 +167,10 @@ &pcie2x1 {
 	status = "okay";
 };
 
+&pwm7 {
+	status = "okay";
+};
+
 &saradc {
 	vref-supply = <&vcca_1v8>;
 	status = "okay";
-- 
Armbian

