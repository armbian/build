From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Lukasz Sobala <lsobala1@gmail.com>
Date: Fri, 16 Oct 2026 03:07:38 +0200
Subject: [PATCH] riscv: dts: sophgo: add the SG2000 JPEG unit to the codec
 overlay

Add the JPEG unit and its reset line to overlays=video-codec. The arm64
overlay includes this file, so it gets the node too.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../sophgo/overlay/sg2000-video-codec.dtso    | 23 +++++++++++++++----
 1 file changed, 19 insertions(+), 4 deletions(-)

diff --git a/arch/riscv/boot/dts/sophgo/overlay/sg2000-video-codec.dtso b/arch/riscv/boot/dts/sophgo/overlay/sg2000-video-codec.dtso
index 8936f73..a7133b5 100644
--- a/arch/riscv/boot/dts/sophgo/overlay/sg2000-video-codec.dtso
+++ b/arch/riscv/boot/dts/sophgo/overlay/sg2000-video-codec.dtso
@@ -1,17 +1,19 @@
 // SPDX-License-Identifier: (GPL-2.0 OR MIT)
 /*
- * The SG2000 H.264 encoder, a Chips&Media CODA980.
+ * The SG2000 H.264 encoder, a Chips&Media CODA980, and its JPEG unit.
  *
- * Enable with overlays=video-codec in /boot/armbianEnv.txt. The driver loads
- * the vendor firmware from /lib/firmware/v4l-coda980-sg2000.bin.
+ * Enable with overlays=video-codec in /boot/armbianEnv.txt. The H.264
+ * driver loads the vendor firmware from
+ * /lib/firmware/v4l-coda980-sg2000.bin. The JPEG unit needs no firmware.
  *
- * The H.265 encoder (WAVE420L) and the JPEG codec are not in this overlay.
+ * The H.265 encoder (WAVE420L) is not in this overlay.
  */
 /dts-v1/;
 /plugin/;
 
 #include <dt-bindings/clock/sophgo,cv1800.h>
 #include <dt-bindings/interrupt-controller/irq.h>
+#include <riscv/sophgo/cv18xx-reset.h>
 
 /* The arm64 overlay defines these first, for the GIC */
 #ifndef SOC_PERIPHERAL_IRQ
@@ -36,4 +38,17 @@
 			 <&clk CLK_CFG_REG_VC>;
 		clock-names = "per", "ahb", "axi", "src", "cfg";
 	};
+
+	jpeg@b000000 {
+		compatible = "sophgo,sg2000-jpeg";
+		reg = <0x0b000000 0x300>;
+		interrupt-parent = <SOC_INTC>;
+		interrupts = <SOC_PERIPHERAL_IRQ(4) IRQ_TYPE_LEVEL_HIGH>;
+		interrupt-names = "jpeg";
+		clocks = <&clk CLK_JPEG>, <&clk CLK_APB_JPEG>,
+			 <&clk CLK_AXI_VIDEO_CODEC>, <&clk CLK_VC_SRC0>,
+			 <&clk CLK_CFG_REG_VC>;
+		clock-names = "per", "ahb", "axi", "src", "cfg";
+		resets = <&rst RST_JPEG>;
+	};
 };
