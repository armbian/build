From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: morikon <leafpmpmp@gmail.com>
Date: Tue, 13 Oct 2026 14:00:00 +0800
Subject: arm64: dts: sophgo: add Milk-V Duo S J2 camera overlays

Use the riscv J2 camera overlays with the interrupt numbers of the GIC.
---
 arch/arm64/boot/dts/sophgo/Makefile                      | 9 +++++++++
 .../boot/dts/sophgo/overlay/sg2000-camera-j2-imx708.dtso | 8 ++++++++
 .../boot/dts/sophgo/overlay/sg2000-camera-j2-ov5647.dtso | 8 ++++++++
 3 files changed, 25 insertions(+)
 create mode 100644 arch/arm64/boot/dts/sophgo/overlay/sg2000-camera-j2-imx708.dtso
 create mode 100644 arch/arm64/boot/dts/sophgo/overlay/sg2000-camera-j2-ov5647.dtso

diff --git a/arch/arm64/boot/dts/sophgo/Makefile b/arch/arm64/boot/dts/sophgo/Makefile
index 111111111111..222222222222 100644
--- a/arch/arm64/boot/dts/sophgo/Makefile
+++ b/arch/arm64/boot/dts/sophgo/Makefile
@@ -46,3 +46,12 @@ dtb-$(CONFIG_ARCH_SOPHGO) += overlay/sg2000-uart1.dtbo
 dtb-$(CONFIG_ARCH_SOPHGO) += overlay/sg2000-uart2.dtbo
 dtb-$(CONFIG_ARCH_SOPHGO) += overlay/sg2000-pwm0.dtbo
 dtb-$(CONFIG_ARCH_SOPHGO) += overlay/sg2000-pwm1.dtbo
+
+# The Milk-V Duo S J2 camera overlays. The composite targets only check
+# that the overlays apply to the base.
+sg2000-milkv-duo-s-camera-j2-imx708-dtbs := sg2000-milkv-duo-s.dtb overlay/sg2000-camera-j2-imx708.dtbo
+sg2000-milkv-duo-s-camera-j2-ov5647-dtbs := sg2000-milkv-duo-s.dtb overlay/sg2000-camera-j2-ov5647.dtbo
+dtb-$(CONFIG_ARCH_SOPHGO) += sg2000-milkv-duo-s-camera-j2-imx708.dtb
+dtb-$(CONFIG_ARCH_SOPHGO) += sg2000-milkv-duo-s-camera-j2-ov5647.dtb
+dtb-$(CONFIG_ARCH_SOPHGO) += overlay/sg2000-camera-j2-imx708.dtbo
+dtb-$(CONFIG_ARCH_SOPHGO) += overlay/sg2000-camera-j2-ov5647.dtbo
diff --git a/arch/arm64/boot/dts/sophgo/overlay/sg2000-camera-j2-imx708.dtso b/arch/arm64/boot/dts/sophgo/overlay/sg2000-camera-j2-imx708.dtso
new file mode 100644
index 000000000000..111111111111
--- /dev/null
+++ b/arch/arm64/boot/dts/sophgo/overlay/sg2000-camera-j2-imx708.dtso
@@ -0,0 +1,8 @@
+// SPDX-License-Identifier: (GPL-2.0 OR MIT)
+/* The riscv overlay, with the GIC's interrupt numbers */
+#include <dt-bindings/interrupt-controller/arm-gic.h>
+
+#define SOC_PERIPHERAL_IRQ(nr)	GIC_SPI (nr)
+#define SOC_INTC		&gic
+
+#include <riscv/sophgo/overlay/sg2000-camera-j2-imx708.dtso>
diff --git a/arch/arm64/boot/dts/sophgo/overlay/sg2000-camera-j2-ov5647.dtso b/arch/arm64/boot/dts/sophgo/overlay/sg2000-camera-j2-ov5647.dtso
new file mode 100644
index 000000000000..111111111111
--- /dev/null
+++ b/arch/arm64/boot/dts/sophgo/overlay/sg2000-camera-j2-ov5647.dtso
@@ -0,0 +1,8 @@
+// SPDX-License-Identifier: (GPL-2.0 OR MIT)
+/* The riscv overlay, with the GIC's interrupt numbers */
+#include <dt-bindings/interrupt-controller/arm-gic.h>
+
+#define SOC_PERIPHERAL_IRQ(nr)	GIC_SPI (nr)
+#define SOC_INTC		&gic
+
+#include <riscv/sophgo/overlay/sg2000-camera-j2-ov5647.dtso>
-- 
Armbian

