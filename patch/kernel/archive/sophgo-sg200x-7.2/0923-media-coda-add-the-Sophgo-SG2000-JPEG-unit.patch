+
 struct coda_video_device {
 	const char *name;
 	enum coda_inst_type type;
@@ -321,6 +326,10 @@ static const struct coda_video_device *coda980_video_devices[] = {
 	&coda980_bit_encoder,
 };
 
+static const struct coda_video_device *coda_jpu_video_devices[] = {
+	&coda9_jpeg_encoder,
