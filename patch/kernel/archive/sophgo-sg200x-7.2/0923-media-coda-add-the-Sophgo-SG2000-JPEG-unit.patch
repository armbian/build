+
 /*
  * Normalize all supported YUV 4:2:0 formats to the value used in the codec
  * tables.
@@ -415,6 +424,8 @@ const char *coda_product_name(int product)
 		return "CODA960";
 	case CODA_980:
 		return "CODA980";
+	case CODA_JPU:
+		return "JPU";
 	default:
 		snprintf(buf, sizeof(buf), "(0x%04x)", product);
 		return buf;
@@ -3000,6 +3011,40 @@ static void coda_copy_firmware(struct coda_dev *dev, const u8 * const buf,
 
 static void coda_fw_callback(const struct firmware *fw, void *context);
 
+/* Register the video devices, and drop the probe's runtime PM reference */
+static void coda_register_video_devices(struct coda_dev *dev)
+{
+	int i, ret;
+
+	dev->m2m_dev = v4l2_m2m_init(&coda_m2m_ops);
+	if (IS_ERR(dev->m2m_dev)) {
+		v4l2_err(&dev->v4l2_dev, "Failed to init mem2mem device\n");
+		dev->m2m_dev = NULL;
+		goto put_pm;
+	}
+
+	for (i = 0; i < dev->devtype->num_vdevs; i++) {
+		ret = coda_register_device(dev, i);
+		if (ret) {
+			v4l2_err(&dev->v4l2_dev,
+				 "Failed to register %s video device: %d\n",
+				 dev->devtype->vdevs[i]->name, ret);
+			goto rel_vfd;
+		}
+	}
+
+	pm_runtime_put_sync(dev->dev);
+	return;
+
+rel_vfd:
+	while (--i >= 0)
+		video_unregister_device(&dev->vfd[i]);
+	v4l2_m2m_release(dev->m2m_dev);
+	dev->m2m_dev = NULL;
+put_pm:
+	pm_runtime_put_sync(dev->dev);
+}
+
 static int coda_firmware_request(struct coda_dev *dev)
 {
 	char *fw;
@@ -3019,7 +3064,7 @@ static int coda_firmware_request(struct coda_dev *dev)
 static void coda_fw_callback(const struct firmware *fw, void *context)
 {
 	struct coda_dev *dev = context;
-	int i, ret;
+	int ret;
 
 	if (!fw) {
 		dev->firmware++;
@@ -3060,29 +3105,9 @@ static void coda_fw_callback(const struct firmware *fw, void *context)
 	if (ret < 0)
 		goto put_pm;
 
-	dev->m2m_dev = v4l2_m2m_init(&coda_m2m_ops);
-	if (IS_ERR(dev->m2m_dev)) {
-		v4l2_err(&dev->v4l2_dev, "Failed to init mem2mem device\n");
-		goto put_pm;
-	}
-
-	for (i = 0; i < dev->devtype->num_vdevs; i++) {
-		ret = coda_register_device(dev, i);
-		if (ret) {
-			v4l2_err(&dev->v4l2_dev,
-				 "Failed to register %s video device: %d\n",
-				 dev->devtype->vdevs[i]->name, ret);
-			goto rel_vfd;
-		}
-	}
-
-	pm_runtime_put_sync(dev->dev);
+	coda_register_video_devices(dev);
 	return;
 
-rel_vfd:
-	while (--i >= 0)
-		video_unregister_device(&dev->vfd[i]);
-	v4l2_m2m_release(dev->m2m_dev);
 put_pm:
 	pm_runtime_put_sync(dev->dev);
 }
@@ -3094,6 +3119,7 @@ enum coda_platform {
 	CODA_IMX6Q,
 	CODA_IMX6DL,
 	CODA_SG2000,
+	CODA_SG2000_JPU,
