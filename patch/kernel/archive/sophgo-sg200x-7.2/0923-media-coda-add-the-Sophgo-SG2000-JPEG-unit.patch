@@ -3196,6 +3230,7 @@ static const struct of_device_id coda_dt_ids[] = {
 	{ .compatible = "fsl,imx6q-vpu", .data = &coda_devdata[CODA_IMX6Q] },
 	{ .compatible = "fsl,imx6dl-vpu", .data = &coda_devdata[CODA_IMX6DL] },
 	{ .compatible = "sophgo,sg2000-vpu", .data = &coda_devdata[CODA_SG2000] },
+	{ .compatible = "sophgo,sg2000-jpeg", .data = &coda_devdata[CODA_SG2000_JPU] },
 	{ /* sentinel */ }
 };
 MODULE_DEVICE_TABLE(of, coda_dt_ids);
@@ -3231,14 +3266,26 @@ static int coda_probe(struct platform_device *pdev)
 	if (IS_ERR(dev->regs_base))
 		return PTR_ERR(dev->regs_base);
 
+	/*
+	 * The JPU registers are the CODA9 JPEG registers, at offset 0 instead
+	 * of CODA9_JPEG_BASE. The JPU has no other registers, and the driver
+	 * reads and writes only JPEG registers for it.
+	 */
+	if (dev->devtype->product == CODA_JPU)
+		dev->regs_base -= CODA9_JPEG_BASE;
+
 	/* SG2000: codec control block and the bus and source clocks */
-	if (dev->devtype->product == CODA_980) {
+	if (dev->devtype->product == CODA_980 ||
+	    dev->devtype->product == CODA_JPU) {
 		struct clk *clk;
 
-		dev->ctrl_base = devm_platform_ioremap_resource_byname(pdev,
-								       "ctrl");
-		if (IS_ERR(dev->ctrl_base))
-			return PTR_ERR(dev->ctrl_base);
+		if (dev->devtype->product == CODA_980) {
+			dev->ctrl_base =
+				devm_platform_ioremap_resource_byname(pdev,
+								      "ctrl");
+			if (IS_ERR(dev->ctrl_base))
+				return PTR_ERR(dev->ctrl_base);
+		}
 
 		clk = devm_clk_get_enabled(&pdev->dev, "axi");
 		if (IS_ERR(clk))
@@ -3254,22 +3301,26 @@ static int coda_probe(struct platform_device *pdev)
 					     "Could not get cfg clock\n");
 	}
 
-	/* IRQ */
-	irq = platform_get_irq_byname(pdev, "bit");
-	if (irq < 0)
-		irq = platform_get_irq(pdev, 0);
-	if (irq < 0)
-		return irq;
+	/* IRQ, not on the JPU */
+	if (dev->devtype->product != CODA_JPU) {
+		irq = platform_get_irq_byname(pdev, "bit");
+		if (irq < 0)
+			irq = platform_get_irq(pdev, 0);
+		if (irq < 0)
+			return irq;
 
-	ret = devm_request_irq(&pdev->dev, irq, coda_irq_handler, 0,
-			       CODA_NAME "-video", dev);
-	if (ret < 0) {
-		dev_err(&pdev->dev, "failed to request irq: %d\n", ret);
-		return ret;
+		ret = devm_request_irq(&pdev->dev, irq, coda_irq_handler, 0,
+				       CODA_NAME "-video", dev);
+		if (ret < 0) {
+			dev_err(&pdev->dev, "failed to request irq: %d\n",
+				ret);
+			return ret;
+		}
 	}
 
 	/* JPEG IRQ */
-	if (dev->devtype->product == CODA_960) {
+	if (dev->devtype->product == CODA_960 ||
+	    dev->devtype->product == CODA_JPU) {
 		irq = platform_get_irq_byname(pdev, "jpeg");
 		if (irq < 0)
 			return irq;
@@ -3297,7 +3348,8 @@ static int coda_probe(struct platform_device *pdev)
 	 * address space, so it runs without one for now.
 	 */
 	pool = of_gen_pool_get(np, "iram", 0);
-	if (!pool && dev->devtype->product != CODA_980) {
+	if (!pool && dev->devtype->product != CODA_980 &&
+	    dev->devtype->product != CODA_JPU) {
 		dev_err(&pdev->dev, "iram pool not available\n");
 		return -ENOMEM;
 	}
@@ -3317,7 +3369,9 @@ static int coda_probe(struct platform_device *pdev)
 	mutex_init(&dev->coda_mutex);
 	ida_init(&dev->ida);
 
-	dev->debugfs_root = debugfs_create_dir("coda", NULL);
+	/* The SG2000 has two coda devices: the JPU gets its own directory */
+	dev->debugfs_root = debugfs_create_dir(dev->devtype->product == CODA_JPU ?
+					       "coda-jpu" : "coda", NULL);
 
 	/* allocate auxiliary per-device buffers for the BIT processor */
 	if (dev->devtype->product == CODA_DX6) {
@@ -3372,6 +3426,12 @@ static int coda_probe(struct platform_device *pdev)
 	pm_runtime_set_active(&pdev->dev);
 	pm_runtime_enable(&pdev->dev);
 
+	/* The JPU needs no firmware */
+	if (dev->devtype->product == CODA_JPU) {
+		coda_register_video_devices(dev);
+		return 0;
+	}
+
 	ret = coda_firmware_request(dev);
 	if (ret)
 		goto err_alloc_workqueue;
diff --git a/drivers/media/platform/chips-media/coda/coda-jpeg.c b/drivers/media/platform/chips-media/coda/coda-jpeg.c
index 8352253..60c5c5f 100644
--- a/drivers/media/platform/chips-media/coda/coda-jpeg.c
+++ b/drivers/media/platform/chips-media/coda/coda-jpeg.c
@@ -1064,9 +1064,48 @@ static int coda9_jpeg_start_encoding(struct coda_ctx *ctx)
 	}
 	coda_set_jpeg_compression_quality(ctx, ctx->params.jpeg_quality);
 
+	if (dev->devtype->product == CODA_JPU) {
+		mutex_lock(&dev->coda_mutex);
+		ret = coda_jpu_reset(dev);
+		mutex_unlock(&dev->coda_mutex);
+		if (ret < 0) {
+			v4l2_err(&dev->v4l2_dev, "JPU init timeout\n");
+			return ret;
