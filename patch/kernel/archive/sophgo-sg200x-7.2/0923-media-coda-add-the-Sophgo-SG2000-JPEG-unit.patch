 	return 0;
 }
 
+/* The standalone JPU reads the source frame without a GDI */
+static void jpu_set_source(struct coda_ctx *ctx, struct coda_q_data *q_data,
+			   struct vb2_v4l2_buffer *buf, int chroma_format,
+			   bool chroma_interleave)
+{
+	struct coda_dev *dev = ctx->dev;
+	u32 cstride = q_data->bytesperline;
+
+	if (chroma_format == CODA9_JPEG_FORMAT_420 ||
+	    chroma_format == CODA9_JPEG_FORMAT_422)
+		cstride /= 2;
+	if (chroma_interleave)
+		cstride *= 2;
+
+	coda_write_base(ctx, q_data, buf, JPU_REG_DPB_BASE00);
+	coda_write(dev, q_data->bytesperline, JPU_REG_DPB_YSTRIDE);
+	coda_write(dev, cstride, JPU_REG_DPB_CSTRIDE);
+	coda_write(dev, 0, JPU_REG_CLP_INFO);
+	coda_write(dev, 0, JPU_REG_INTR_MASK);
+	/* Start the restart markers and the DC predictions from zero */
+	coda_write(dev, 0, CODA9_REG_JPEG_RST_INDEX);
+	coda_write(dev, 0, CODA9_REG_JPEG_RST_COUNT);
+	coda_write(dev, 0, CODA9_REG_JPEG_DPCM_DIFF_Y);
+	coda_write(dev, 0, CODA9_REG_JPEG_DPCM_DIFF_CB);
+	coda_write(dev, 0, CODA9_REG_JPEG_DPCM_DIFF_CR);
+	coda_write(dev, coda_read(dev, CODA9_REG_JPEG_PIC_STATUS),
+		   CODA9_REG_JPEG_PIC_STATUS);
+}
+
 static int coda9_jpeg_prepare_encode(struct coda_ctx *ctx)
 {
 	struct coda_q_data *q_data_src;
@@ -1095,7 +1134,8 @@ static int coda9_jpeg_prepare_encode(struct coda_ctx *ctx)
 	src_buf->flags |= V4L2_BUF_FLAG_KEYFRAME;
 	src_buf->flags &= ~V4L2_BUF_FLAG_PFRAME;
 
-	coda_set_gdi_regs(ctx);
+	if (dev->devtype->product != CODA_JPU)
+		coda_set_gdi_regs(ctx);
 
 	start_addr = vb2_dma_contig_plane_dma_addr(&dst_buf->vb2_buf, 0);
 	end_addr = start_addr + vb2_plane_size(&dst_buf->vb2_buf, 0);
@@ -1145,7 +1185,12 @@ static int coda9_jpeg_prepare_encode(struct coda_ctx *ctx)
 	coda_write(dev, CODA9_JPEG_PIC_CTRL_TC_DIRECTION |
 		   CODA9_JPEG_PIC_CTRL_ENCODER_EN, CODA9_REG_JPEG_PIC_CTRL);
 	coda_write(dev, 0, CODA9_REG_JPEG_SCL_INFO);
-	coda_write(dev, chroma_interleave, CODA9_REG_JPEG_DPB_CONFIG);
+	if (dev->devtype->product == CODA_JPU)
+		coda_write(dev, chroma_interleave ?
+			   JPU_DPB_CONFIG_CBCR_INTERLEAVE : 0,
+			   CODA9_REG_JPEG_DPB_CONFIG);
+	else
+		coda_write(dev, chroma_interleave, CODA9_REG_JPEG_DPB_CONFIG);
 	coda_write(dev, ctx->params.jpeg_restart_interval,
 		   CODA9_REG_JPEG_RST_INTVAL);
 	coda_write(dev, 1, CODA9_REG_JPEG_BBC_CTRL);
@@ -1172,6 +1217,12 @@ static int coda9_jpeg_prepare_encode(struct coda_ctx *ctx)
 
 	coda_write(dev, mcu_info[chroma_format], CODA9_REG_JPEG_MCU_INFO);
 
+	if (dev->devtype->product == CODA_JPU) {
+		jpu_set_source(ctx, q_data_src, src_buf, chroma_format,
+			       chroma_interleave);
+		goto start;
+	}
+
 	coda_write(dev, 1, CODA9_GDI_CONTROL);
 	timeout = ktime_add_us(ktime_get(), 100000);
 	do {
@@ -1197,6 +1248,7 @@ static int coda9_jpeg_prepare_encode(struct coda_ctx *ctx)
 	coda_write(dev, 1, CODA9_GDI_WPROT_ERR_CLR);
 	coda_write(dev, 0, CODA9_GDI_WPROT_RGN_EN);
 
+start:
 	trace_coda_jpeg_run(ctx, src_buf);
 
 	coda_write(dev, 1, CODA9_REG_JPEG_PIC_START);
@@ -1275,10 +1327,14 @@ static void coda9_jpeg_encode_timeout(struct coda_ctx *ctx)
 	if (wr_ptr >= end_addr - 256) {
 		v4l2_err(&dev->v4l2_dev, "JPEG too large for capture buffer\n");
 		coda9_jpeg_finish_encode(ctx);
-		return;
+	} else {
+		coda_hw_reset(ctx);
 	}
 
-	coda_hw_reset(ctx);
+	if (dev->devtype->product == CODA_JPU) {
+		v4l2_warn(&dev->v4l2_dev, "JPEG timeout: reset the JPU\n");
+		coda_jpu_hard_reset(dev);
+	}
 }
 
 static void coda9_jpeg_release(struct coda_ctx *ctx)
