diff --git a/drivers/media/platform/chips-media/coda/coda-bit.c b/drivers/media/platform/chips-media/coda/coda-bit.c
index 3373ba8..94fba2d 100644
--- a/drivers/media/platform/chips-media/coda/coda-bit.c
+++ b/drivers/media/platform/chips-media/coda/coda-bit.c
@@ -9,6 +9,8 @@
  */
 
 #include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/iopoll.h>
 #include <linux/irqreturn.h>
 #include <linux/kernel.h>
 #include <linux/log2.h>
@@ -108,6 +110,30 @@ static int coda_command_sync(struct coda_ctx *ctx, int cmd)
 	return ret;
 }
 
+/* The JPU has no BIT processor: its INIT command resets the JPEG unit */
+int coda_jpu_reset(struct coda_dev *dev)
+{
+	u32 val;
+
+	coda_write(dev, CODA9_JPEG_START_INIT, CODA9_REG_JPEG_PIC_START);
+	return readl_poll_timeout(dev->regs_base + CODA9_REG_JPEG_PIC_START,
+				  val, !(val & CODA9_JPEG_START_INIT), 1, 10000);
+}
+
+/*
+ * After a stalled frame INIT is not enough: the next frame has wrong DC
+ * predictions. Pulse the reset line too.
+ */
+int coda_jpu_hard_reset(struct coda_dev *dev)
+{
+	if (dev->rstc) {
+		reset_control_assert(dev->rstc);
+		usleep_range(10, 20);
+		reset_control_deassert(dev->rstc);
+	}
+	return coda_jpu_reset(dev);
+}
+
 int coda_hw_reset(struct coda_ctx *ctx)
 {
 	struct coda_dev *dev = ctx->dev;
@@ -117,6 +143,9 @@ int coda_hw_reset(struct coda_ctx *ctx)
 
 	lockdep_assert_held(&dev->coda_mutex);
 
+	if (dev->devtype->product == CODA_JPU)
+		return coda_jpu_reset(dev);
+
 	if (!dev->rstc)
 		return -ENOENT;
 
@@ -1202,6 +1231,9 @@ static int coda_start_encoding(struct coda_ctx *ctx)
 		coda_write(dev, CODA7_STREAM_BUF_DYNALLOC_EN |
 			CODA7_STREAM_BUF_PIC_RESET, CODA_REG_BIT_STREAM_CTRL);
 		break;
+	case CODA_JPU:
+		/* No BIT processor */
+		break;
 	}
 
 	ctx->frame_mem_ctrl &= ~(CODA_FRAME_CHROMA_INTERLEAVE | (0x3 << 9) |
@@ -1243,6 +1275,10 @@ static int coda_start_encoding(struct coda_ctx *ctx)
 			<< CODA7_PICWIDTH_OFFSET;
 		value |= (q_data_src->rect.height & CODA7_PICHEIGHT_MASK)
 			 << CODA_PICHEIGHT_OFFSET;
+		break;
+	case CODA_JPU:
+		/* No BIT processor */
+		break;
 	}
 	coda_write(dev, value, CODA_CMD_ENC_SEQ_SRC_SIZE);
 	if (dst_fourcc == V4L2_PIX_FMT_JPEG)
@@ -1425,6 +1461,9 @@ static int coda_start_encoding(struct coda_ctx *ctx)
 			coda_write(dev, 2 << 2 | 3, CODA9_CMD_ENC_SEQ_ME_OPTION);
 			coda_write(dev, 0, CODA9_CMD_ENC_SEQ_INTRA_WEIGHT);
 			break;
+		case CODA_JPU:
+			/* No BIT processor */
+			break;
 		}
 	}
 
@@ -2397,6 +2436,9 @@ static int coda_prepare_decode(struct coda_ctx *ctx)
 		/* 'hardcode to use interrupt disable mode'? */
 		coda_write(dev, (1 << 10), CODA_CMD_DEC_PIC_OPTION);
 		break;
+	case CODA_JPU:
+		/* No BIT processor */
+		break;
 	}
 
 	coda_write(dev, 0, CODA_CMD_DEC_PIC_SKIP_NUM);
diff --git a/drivers/media/platform/chips-media/coda/coda-common.c b/drivers/media/platform/chips-media/coda/coda-common.c
