+/* Retune the PLL and the timing controls for a newly selected mode */
+static int imx708_apply_mode(struct imx708 *imx708,
+			     const struct imx708_mode *mode)
+{
+	s32 hblank, vblank_max;
+	int ret;
+
+	ret = imx708_pll_calculate(imx708,
+				   link_freqs[__ffs(imx708->link_freq_bitmap)],
+				   mode->pixel_rate);
+	if (ret)
+		return ret;
+
+	__v4l2_ctrl_modify_range(imx708->pixel_rate,
+				 imx708->pll.pixel_rate_pixel_array,
+				 imx708->pll.pixel_rate_pixel_array, 1,
+				 imx708->pll.pixel_rate_pixel_array);
+
+	hblank = mode->line_length - mode->width;
+	__v4l2_ctrl_modify_range(imx708->hblank, hblank, hblank, 1, hblank);
+
+	/* Frame Time = 2^LONG_EXP_SHIFT * REG_FRAME_LENGTH */
+	vblank_max = ((1 << IMX708_LONG_EXP_SHIFT_MAX) *
+		      IMX708_FRAME_LENGTH_MAX) - mode->height;
+	__v4l2_ctrl_modify_range(imx708->vblank, mode->vblank_min, vblank_max,
+				 1, mode->vblank_min);
+	/* Start the new mode at its fastest rate */
+	ret = __v4l2_ctrl_s_ctrl(imx708->vblank, mode->vblank_min);
+	if (ret)
+		return ret;
+
+	/* VBLANK may not have changed, so its handler may not have run */
+	imx708_adjust_exposure_range(imx708, mode);
+
+	return 0;
+}
