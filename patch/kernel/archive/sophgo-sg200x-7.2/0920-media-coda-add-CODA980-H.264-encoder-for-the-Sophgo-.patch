+/*
+ * The CODA980 firmware writes the level into the SPS but does not choose it.
+ * Use the lowest level that allows the frame size and macroblock rate.
+ */
+static u32 coda980_h264_level_idc(struct coda_ctx *ctx)
+{
+	static const struct {
+		u32 level_idc;
+		u32 max_mbps;
+		u32 max_fs;
+	} levels[] = {
+		{ 10, 1485, 99 }, { 11, 3000, 396 }, { 12, 6000, 396 },
+		{ 13, 11880, 396 }, { 20, 11880, 396 }, { 21, 19800, 792 },
+		{ 22, 20250, 1620 }, { 30, 40500, 1620 }, { 31, 108000, 3600 },
+		{ 32, 216000, 5120 }, { 40, 245760, 8192 }, { 42, 522240, 8704 },
+		{ 50, 589824, 22080 }, { 51, 983040, 36864 },
+	};
+	struct coda_q_data *q_data_src;
+	u32 num, den, fs, mbps;
+	int i;
+
+	q_data_src = get_q_data(ctx, V4L2_BUF_TYPE_VIDEO_OUTPUT);
+	fs = DIV_ROUND_UP(q_data_src->rect.width, 16) *
+	     DIV_ROUND_UP(q_data_src->rect.height, 16);
+	num = ctx->params.framerate & 0xffff;
+	den = (ctx->params.framerate >> 16) + 1;
+	mbps = DIV_ROUND_UP(fs * num, den);
+
+	for (i = 0; i < ARRAY_SIZE(levels); i++)
+		if (fs <= levels[i].max_fs && mbps <= levels[i].max_mbps)
+			return levels[i].level_idc;
+
+	return 51;
+}
