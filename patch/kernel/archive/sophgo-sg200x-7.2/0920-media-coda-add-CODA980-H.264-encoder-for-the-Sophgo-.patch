+/*
+ * The CODA980 has one cache configuration register:
+ * merge[10:9], way shape[8:5], burst[3], tiled map[2], bypass[1:0].
+ * These are the vendor's encoder values for a linear frame map.
+ */
+static void coda980_set_frame_cache(struct coda_ctx *ctx)
+{
+	u32 cache_config = 3 << 9 | 15 << 5;
+
+	if (ctx->tiled_map_type != GDI_LINEAR_FRAME_MAP)
+		cache_config |= BIT(2);
+	coda_write(ctx->dev, cache_config, CODA9_CMD_SET_FRAME_CACHE_CONFIG);
+}
