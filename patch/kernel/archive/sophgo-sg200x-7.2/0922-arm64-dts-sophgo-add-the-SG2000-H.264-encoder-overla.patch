From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Lukasz Sobala <lsobala1@gmail.com>
Date: Fri, 16 Oct 2026 02:49:54 +0200
Subject: [PATCH 922/922] arm64: dts: sophgo: add the SG2000 H.264 encoder
 overlay

Use the riscv H.264 encoder overlay with the interrupt numbers of the GIC.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm64/boot/dts/sophgo/Makefile                       | 5 +++++
 .../arm64/boot/dts/sophgo/overlay/sg2000-video-codec.dtso | 8 ++++++++
 2 files changed, 13 insertions(+)
 create mode 100644 arch/arm64/boot/dts/sophgo/overlay/sg2000-video-codec.dtso

diff --git a/arch/arm64/boot/dts/sophgo/Makefile b/arch/arm64/boot/dts/sophgo/Makefile
index 75f919a..9fd2fb9 100644
--- a/arch/arm64/boot/dts/sophgo/Makefile
+++ b/arch/arm64/boot/dts/sophgo/Makefile
@@ -46,3 +46,8 @@ dtb-$(CONFIG_ARCH_SOPHGO) += overlay/sg2000-uart1.dtbo
 dtb-$(CONFIG_ARCH_SOPHGO) += overlay/sg2000-uart2.dtbo
 dtb-$(CONFIG_ARCH_SOPHGO) += overlay/sg2000-pwm0.dtbo
 dtb-$(CONFIG_ARCH_SOPHGO) += overlay/sg2000-pwm1.dtbo
+
+# The SG2000 H.264 encoder overlay
+sg2000-milkv-duo-s-video-codec-dtbs := sg2000-milkv-duo-s.dtb overlay/sg2000-video-codec.dtbo
+dtb-$(CONFIG_ARCH_SOPHGO) += sg2000-milkv-duo-s-video-codec.dtb
+dtb-$(CONFIG_ARCH_SOPHGO) += overlay/sg2000-video-codec.dtbo
diff --git a/arch/arm64/boot/dts/sophgo/overlay/sg2000-video-codec.dtso b/arch/arm64/boot/dts/sophgo/overlay/sg2000-video-codec.dtso
new file mode 100644
index 0000000..1465327
--- /dev/null
+++ b/arch/arm64/boot/dts/sophgo/overlay/sg2000-video-codec.dtso
@@ -0,0 +1,8 @@
+// SPDX-License-Identifier: (GPL-2.0 OR MIT)
+/* The riscv overlay, with the GIC's interrupt numbers */
+#include <dt-bindings/interrupt-controller/arm-gic.h>
+
+#define SOC_PERIPHERAL_IRQ(nr)	GIC_SPI (nr)
+#define SOC_INTC		&gic
+
+#include <riscv/sophgo/overlay/sg2000-video-codec.dtso>
