From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Lukasz Sobala <lsobala1@gmail.com>
Date: Wed, 14 Oct 2026 23:50:23 +0200
Subject: arm64: dts: sophgo: add the Milk-V Duo S J1 GC2083 camera
 overlay

Use the riscv J1 camera overlay with the interrupt numbers of the GIC.
---
 arch/arm64/boot/dts/sophgo/Makefile                       | 5 +++++
 .../boot/dts/sophgo/overlay/sg2000-camera-j1-gc2083.dtso  | 8 ++++++++
 2 files changed, 13 insertions(+)
 create mode 100644 arch/arm64/boot/dts/sophgo/overlay/sg2000-camera-j1-gc2083.dtso

diff --git a/arch/arm64/boot/dts/sophgo/Makefile b/arch/arm64/boot/dts/sophgo/Makefile
index f378ec1..e43d857 100644
--- a/arch/arm64/boot/dts/sophgo/Makefile
+++ b/arch/arm64/boot/dts/sophgo/Makefile
@@ -55,3 +55,8 @@ dtb-$(CONFIG_ARCH_SOPHGO) += sg2000-milkv-duo-s-camera-j2-imx708.dtb
 dtb-$(CONFIG_ARCH_SOPHGO) += sg2000-milkv-duo-s-camera-j2-ov5647.dtb
 dtb-$(CONFIG_ARCH_SOPHGO) += overlay/sg2000-camera-j2-imx708.dtbo
 dtb-$(CONFIG_ARCH_SOPHGO) += overlay/sg2000-camera-j2-ov5647.dtbo
+
+# The Milk-V Duo S J1 camera overlay
+sg2000-milkv-duo-s-camera-j1-gc2083-dtbs := sg2000-milkv-duo-s.dtb overlay/sg2000-camera-j1-gc2083.dtbo
+dtb-$(CONFIG_ARCH_SOPHGO) += sg2000-milkv-duo-s-camera-j1-gc2083.dtb
+dtb-$(CONFIG_ARCH_SOPHGO) += overlay/sg2000-camera-j1-gc2083.dtbo
diff --git a/arch/arm64/boot/dts/sophgo/overlay/sg2000-camera-j1-gc2083.dtso b/arch/arm64/boot/dts/sophgo/overlay/sg2000-camera-j1-gc2083.dtso
new file mode 100644
index 0000000..482381a
--- /dev/null
+++ b/arch/arm64/boot/dts/sophgo/overlay/sg2000-camera-j1-gc2083.dtso
@@ -0,0 +1,8 @@
+// SPDX-License-Identifier: (GPL-2.0 OR MIT)
+/* The riscv overlay, with the GIC's interrupt numbers */
+#include <dt-bindings/interrupt-controller/arm-gic.h>
+
+#define SOC_PERIPHERAL_IRQ(nr)	GIC_SPI (nr)
+#define SOC_INTC		&gic
+
+#include <riscv/sophgo/overlay/sg2000-camera-j1-gc2083.dtso>
