From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Lukasz Sobala <lsobala1@gmail.com>
Date: Tue, 28 Jul 2026 18:32:12 +0200
Subject: arm64: dts: sophgo: enable Milk-V Duo S peripherals in ARM mode

The initial arm64 Milk-V Duo S device tree only brought up the console,
SD card and Ethernet. The SoC description itself lives in
arch/riscv/boot/dts/sophgo/cv180x.dtsi and cv181x.dtsi, which the arm64
sg2000.dtsi #includes, so every peripheral enabled for the RISC-V Duo S
is equally available when the SG2000 runs its Cortex-A53.

Bring the arm64 board DTS to parity with sg2000-milkv-duo-s.dts on
RISC-V: I2C1-4, SPI0-3, UART1-4, PWM0-3, watchdog, eFuse, USB OTG, the
I2S/internal DAC+ADC sound card and the AIC8800D80 SDIO Wi-Fi slot.

sg2000.dtsi gains the C906L coprocessor reserved-memory region and
remoteproc node, mirroring its RISC-V counterpart. It is left disabled
here and enabled per-board.

Signed-off-by: Armbian <info@armbian.com>
---
 arch/arm64/boot/dts/sophgo/sg2000-milkv-duo-s.dts | 152 ++++++++++
 arch/arm64/boot/dts/sophgo/sg2000.dtsi            |  22 ++
 2 files changed, 174 insertions(+)

diff --git a/arch/arm64/boot/dts/sophgo/sg2000-milkv-duo-s.dts b/arch/arm64/boot/dts/sophgo/sg2000-milkv-duo-s.dts
index 111111111111..222222222222 100644
--- a/arch/arm64/boot/dts/sophgo/sg2000-milkv-duo-s.dts
+++ b/arch/arm64/boot/dts/sophgo/sg2000-milkv-duo-s.dts
@@ -9,15 +9,64 @@ / {
 	compatible = "milkv,duo-s", "sophgo,sg2000";
 
 	aliases {
+		i2c1 = &i2c1;
+		i2c2 = &i2c2;
+		i2c3 = &i2c3;
 		i2c4 = &i2c4;
 		mmc0 = &sdhci0;
+		pwm0 = &pwm0;
+		pwm1 = &pwm1;
+		pwm2 = &pwm2;
+		pwm3 = &pwm3;
 		serial0 = &uart0;
+		spi0 = &spi0;
 		spi3 = &spi3;
 	};
 
 	chosen {
 		stdout-path = "serial0:115200n8";
 	};
+
+	sound_card {
+		compatible = "simple-audio-card";
+		simple-audio-card,name = "Milk-V Duo S Built-in Audio";
+		simple-audio-card,format = "i2s";
+
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		simple-audio-card,dai-link@0 {
+			reg = <0>;
+			format = "i2s";
+			bitclock-master = <&i2s3_cpu>;
+			frame-master = <&i2s3_cpu>;
+
+			i2s3_cpu: cpu {
+				sound-dai = <&i2s3>;
+			};
+
+			codec {
+				sound-dai = <&int_dac>;
+				mclk-fs = <256>;
+			};
+		};
+
+		simple-audio-card,dai-link@1 {
+			reg = <1>;
+			format = "i2s";
+			bitclock-master = <&i2s0_cpu>;
+			frame-master = <&i2s0_cpu>;
+
+			i2s0_cpu: cpu {
+				sound-dai = <&i2s0>;
+			};
+
+			codec {
+				sound-dai = <&int_adc>;
+				mclk-fs = <256>;
+			};
+		};
+	};
 };
 
 &osc {
@@ -28,6 +77,10 @@ &dmac {
 	status = "okay";
 };
 
+&efuse {
+	status = "okay";
+};
+
 &emmc {
 	bus-width = <4>;
 	no-1-8-v;
@@ -42,14 +95,75 @@ &gmac0 {
 	status = "okay";
 };
 
+&i2c1 {
+	status = "okay";
+};
+
+&i2c2 {
+	status = "okay";
+};
+
+&i2c3 {
+	status = "okay";
+};
+
 &i2c4 {
 	status = "okay";
 };
 
+&i2s0 {
+	#sound-dai-cells = <0>;
+	status = "okay";
+};
+
+&i2s1 {
+	status = "disabled";
+};
+
+&i2s2 {
+	status = "disabled";
+};
+
+&i2s3 {
+	#sound-dai-cells = <0>;
+	status = "okay";
+};
+
+&int_adc {
+	#sound-dai-cells = <0>;
+	/delete-property/ mute-gpio-l;
+	/delete-property/ mute-gpio-r;
+	status = "okay";
+};
+
+&int_dac {
+	status = "okay";
+};
+
 &mdio {
 	status = "okay";
 };
 
+&pwm0 {
+	status = "okay";
+};
+
+&pwm1 {
+	status = "okay";
+};
+
+&pwm2 {
+	status = "okay";
+};
+
+&pwm3 {
+	status = "okay";
+};
+
+&remoteproc {
+	status = "okay";
+};
+
 &saradc {
 	status = "okay";
 };
@@ -61,6 +175,7 @@ &sdhci0 {
 	status = "okay";
 };
 
+/* AIC8800D80 Wi-Fi + Bluetooth */
 &sdhci1 {
 	bus-width = <4>;
 	cap-sdio-irq;
@@ -70,6 +185,18 @@ &sdhci1 {
 	status = "okay";
 };
 
+&spi0 {
+	status = "okay";
+};
+
+&spi1 {
+	status = "okay";
+};
+
+&spi2 {
+	status = "okay";
+};
+
 &spi3 {
 	status = "okay";
 };
@@ -78,3 +205,28 @@ &uart0 {
 	status = "okay";
 };
 
+&uart1 {
+	status = "okay";
+};
+
+&uart2 {
+	status = "okay";
+};
+
+&uart3 {
+	status = "okay";
+};
+
+/* Bluetooth HCI UART */
+&uart4 {
+	status = "okay";
+};
+
+&usb {
+	dr_mode = "otg";
+	status = "okay";
+};
+
+&wdt {
+	status = "okay";
+};
diff --git a/arch/arm64/boot/dts/sophgo/sg2000.dtsi b/arch/arm64/boot/dts/sophgo/sg2000.dtsi
index 111111111111..222222222222 100644
--- a/arch/arm64/boot/dts/sophgo/sg2000.dtsi
+++ b/arch/arm64/boot/dts/sophgo/sg2000.dtsi
@@ -37,6 +37,28 @@ memory@80000000 {
 		reg = <0x80000000 0x20000000>;	/* 512MiB */
 	};
 
+	reserved-memory {
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges;
+
+		coprocessor_rtos: region@9fe00000 {
+			reg = <0x9fe00000 0x200000>;
+			no-map;
+		};
+	};
+
+	remoteproc: c906l-rproc {
+		compatible = "sophgo,cv1800b-c906l";
+		firmware-name = "cvirtos.elf";
+		mboxes = <&mailbox 0 2>, <&mailbox 1 1>;
+		mbox-names = "tx", "rx";
+		memory-region = <&coprocessor_rtos>;
+		resets = <&rst 294>;
+		sophgo,syscon = <&syscon>;
+		status = "disabled";
+	};
+
 	pmu {
 		compatible = "arm,cortex-a53-pmu";
 		interrupts = <GIC_SPI 119 IRQ_TYPE_LEVEL_HIGH>,
-- 
Armbian

