From fe72bcd20037bbada6b765af21706edd0c4d819f Mon Sep 17 00:00:00 2001
From: Rosen Penev <rosenp@gmail.com>
Date: Tue, 1 Sep 2026 12:04:22 -0700
Subject: [PATCH] net: phy: marvell: enable wake IRQ in m88e1318_set_wol()

When WoL is enabled on the 88E1318S/88E1510, the PHY asserts its
INTn pin (active-low) on wake events.  Call enable_irq_wake() on
the PHY's IRQ so the underlying GPIO interrupt actually wakes the
system from suspend.  When WoL is disabled, call disable_irq_wake()
to clean up.

Assisted-by: opencode:big-pickle
Signed-off-by: Rosen Penev <rosenp@gmail.com>
---
 drivers/net/phy/marvell.c | 14 +++++++++++++-
 1 file changed, 13 insertions(+), 1 deletion(-)

diff --git a/drivers/net/phy/marvell.c b/drivers/net/phy/marvell.c
index f71cffa88406..be66bd32112b 100644
--- a/drivers/net/phy/marvell.c
+++ b/drivers/net/phy/marvell.c
@@ -32,6 +32,8 @@
 #include <linux/marvell_phy.h>
 #include <linux/bitfield.h>
 #include <linux/of.h>
+#include <linux/pm_wakeirq.h>
+#include <linux/property.h>
 #include <linux/sfp.h>
 
 #include <linux/io.h>
@@ -2074,6 +2076,9 @@ static int m88e1318_set_wol(struct phy_device *phydev,
 			goto error;
 	}
 
+	device_set_wakeup_enable(&phydev->mdio.dev,
+				 !!(wol->wolopts & (WAKE_MAGIC | WAKE_PHY)));
+
 error:
 	return phy_restore_page(phydev, oldpage, err);
 }
@@ -3587,14 +3592,21 @@ static int m88e1318_led_hw_control_get(struct phy_device *phydev, u8 index,
 
 static int marvell_probe(struct phy_device *phydev)
 {
+	struct device *dev = &phydev->mdio.dev;
 	struct marvell_priv *priv;
 
-	priv = devm_kzalloc(&phydev->mdio.dev, sizeof(*priv), GFP_KERNEL);
+	priv = devm_kzalloc(dev, sizeof(*priv), GFP_KERNEL);
 	if (!priv)
 		return -ENOMEM;
 
 	phydev->priv = priv;
 
+	if (device_property_present(dev, "wakeup-source") &&
+	    phy_interrupt_is_valid(phydev)) {
+		device_set_wakeup_capable(dev, true);
+		devm_pm_set_wake_irq(dev, phydev->irq);
+	}
+
 	return marvell_hwmon_probe(phydev);
 }
 
