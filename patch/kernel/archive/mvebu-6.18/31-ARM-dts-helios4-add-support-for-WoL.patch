From 367fe0961d406c42a8b6e122cee71f381c6e0be9 Mon Sep 17 00:00:00 2001
From: Rosen Penev <rosenp@gmail.com>
Date: Tue, 1 Sep 2026 12:02:58 -0700
Subject: [PATCH] ARM: dts: helios4: add support for WoL

Declare the PHY's interrupt on its device node so the 88E1510/88E1318
INTn/LED[2] pin (active-low) is registered as a proper IRQ. The MAC
(mvneta) already queries the PHY for WoL support and marks the netdev
wakeup-capable accordingly, so no MAC driver changes are needed.

Remove microsom_phy0_int_pins as muxing that into GPIO was only done on
a downstream patch to implement WoL through gpio-keys.

Assisted-by: opencode:big-pickle
Signed-off-by: Rosen Penev <rosenp@gmail.com>
---
 arch/arm/boot/dts/marvell/armada-388-helios4.dts            | 4 ----
 arch/arm/boot/dts/marvell/armada-38x-solidrun-microsom.dtsi | 4 ++++
 2 files changed, 4 insertions(+), 4 deletions(-)

diff --git a/arch/arm/boot/dts/marvell/armada-388-helios4.dts b/arch/arm/boot/dts/marvell/armada-388-helios4.dts
index 9c106633b2b9..39b2d4fa742c 100644
--- a/arch/arm/boot/dts/marvell/armada-388-helios4.dts
+++ b/arch/arm/boot/dts/marvell/armada-388-helios4.dts
@@ -286,10 +286,6 @@ pca0_pins: pca0-pins {
 					marvell,pins = "mpp23";
 					marvell,function = "gpio";
 				};
-				microsom_phy0_int_pins: microsom-phy0-int-pins {
-					marvell,pins = "mpp18";
-					marvell,function = "gpio";
-				};
 				helios_i2c1_pins: i2c1-pins {
 					marvell,pins = "mpp26", "mpp27";
 					marvell,function = "i2c1";
diff --git a/arch/arm/boot/dts/marvell/armada-38x-solidrun-microsom.dtsi b/arch/arm/boot/dts/marvell/armada-38x-solidrun-microsom.dtsi
index 51d0b7952976..c0d6a9340769 100644
--- a/arch/arm/boot/dts/marvell/armada-38x-solidrun-microsom.dtsi
+++ b/arch/arm/boot/dts/marvell/armada-38x-solidrun-microsom.dtsi
@@ -6,6 +6,7 @@
  */
 #include <dt-bindings/input/input.h>
 #include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/interrupt-controller/irq.h>
 
 / {
 	memory@0 {
@@ -68,6 +69,9 @@ phy_dedicated: ethernet-phy@0 {
 		 */
 		marvell,reg-init = <3 16 0 0x101e>;
 		reg = <0>;
+		interrupt-parent = <&gpio0>;
+		interrupts = <18 IRQ_TYPE_LEVEL_LOW>;
+		wakeup-source;
 	};
 };
 
-- 
Armbian

