From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: SuperKali <hello@superkali.me>
Date: Thu, 3 Sep 2026 12:08:07 +0200
Subject: phy: qcom-qmp-combo: apply deferred orientation changes

Ignoring an orientation update while DP is powered prevents a fatal
common-block reset, but loses the requested state. Save the pending
orientation and apply it after DP power-off so an opposite-orientation
reconnect programs the mux correctly.

Signed-off-by: SuperKali <hello@superkali.me>
---
 drivers/phy/qualcomm/phy-qcom-qmp-combo.c | 38 ++++++++--
 1 file changed, 33 insertions(+), 5 deletions(-)

diff --git a/drivers/phy/qualcomm/phy-qcom-qmp-combo.c b/drivers/phy/qualcomm/phy-qcom-qmp-combo.c
index 111111111111..222222222222 100644
--- a/drivers/phy/qualcomm/phy-qcom-qmp-combo.c
+++ b/drivers/phy/qualcomm/phy-qcom-qmp-combo.c
@@ -2312,10 +2312,16 @@ struct qmp_combo {
 
 	struct typec_switch_dev *sw;
 	enum typec_orientation orientation;
+	enum typec_orientation pending_orientation;
 
 	struct typec_mux_dev *mux;
 };
 
+#if IS_ENABLED(CONFIG_TYPEC)
+static int qmp_combo_typec_switch_set(struct typec_switch_dev *sw,
+				      enum typec_orientation orientation);
+#endif
+
 static void qmp_v3_dp_aux_init(struct qmp_combo *qmp);
 static void qmp_v3_configure_dp_tx(struct qmp_combo *qmp);
 static int qmp_v3_configure_dp_clocks(struct qmp_combo *qmp);
@@ -3851,6 +3857,9 @@ static int qmp_combo_dp_power_on(struct phy *phy)
 static int qmp_combo_dp_power_off(struct phy *phy)
 {
 	struct qmp_combo *qmp = phy_get_drvdata(phy);
+#if IS_ENABLED(CONFIG_TYPEC)
+	enum typec_orientation pending_orientation;
+#endif
 
 	mutex_lock(&qmp->phy_mutex);
 
@@ -3858,9 +3867,18 @@ static int qmp_combo_dp_power_off(struct phy *phy)
 	writel(DP_PHY_PD_CTL_PSR_PWRDN, qmp->dp_dp_phy + QSERDES_DP_PHY_PD_CTL);
 
 	qmp->dp_powered_on = false;
+#if IS_ENABLED(CONFIG_TYPEC)
+	pending_orientation = qmp->pending_orientation;
+	qmp->pending_orientation = TYPEC_ORIENTATION_NONE;
+#endif
 
 	mutex_unlock(&qmp->phy_mutex);
 
+#if IS_ENABLED(CONFIG_TYPEC)
+	if (pending_orientation != TYPEC_ORIENTATION_NONE)
+		return qmp_combo_typec_switch_set(qmp->sw, pending_orientation);
+#endif
+
 	return 0;
 }
 
@@ -4429,18 +4447,28 @@ static int qmp_combo_typec_switch_set(struct typec_switch_dev *sw,
 	struct qmp_combo *qmp = typec_switch_get_drvdata(sw);
 	const struct qmp_phy_cfg *cfg = qmp->cfg;
 
-	if (orientation == TYPEC_ORIENTATION_NONE)
-		return 0;
-
 	mutex_lock(&qmp->phy_mutex);
 
+	if (orientation == TYPEC_ORIENTATION_NONE) {
+		qmp->pending_orientation = TYPEC_ORIENTATION_NONE;
+		goto out_unlock;
+	}
+
+	if (orientation == qmp->orientation) {
+		qmp->pending_orientation = TYPEC_ORIENTATION_NONE;
+		goto out_unlock;
+	}
+
 	/*
 	 * Changing orientation force-cycles the common USB/DP PHY block.
-	 * Defer it until the active DP stream has been powered off.
+	 * Save the request while DP is active and apply it from power_off.
 	 */
-	if (orientation == qmp->orientation || qmp->dp_powered_on)
+	if (qmp->dp_powered_on) {
+		qmp->pending_orientation = orientation;
 		goto out_unlock;
+	}
 
+	qmp->pending_orientation = TYPEC_ORIENTATION_NONE;
 	qmp->orientation = orientation;
 
 	if (qmp->init_count) {
-- 
Armbian

