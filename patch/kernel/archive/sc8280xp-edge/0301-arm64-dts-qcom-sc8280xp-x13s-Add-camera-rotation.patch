From 544a666aaceef205c5f0f7703310cb32549d4482 Mon Sep 17 00:00:00 2001
From: Ricardo Pardini <ricardo@pardini.net>
Date: Wed, 4 Nov 2026 20:38:30 +0100
Subject: [PATCH 301/303] arm64: dts: qcom: sc8280xp-x13s: Add camera rotation

- Describe the ov5675 mounting rotation (0 degrees, verified with a capture)
- Lets the sensor expose V4L2_CID_CAMERA_SENSOR_ROTATION, silencing libcamera's "Rotation control not available" warning

Assisted-by: Claude Opus 5.5
Signed-off-by: Ricardo Pardini <ricardo@pardini.net>
---
 arch/arm64/boot/dts/qcom/sc8280xp-lenovo-thinkpad-x13s.dts | 1 +
 1 file changed, 1 insertion(+)

diff --git a/arch/arm64/boot/dts/qcom/sc8280xp-lenovo-thinkpad-x13s.dts b/arch/arm64/boot/dts/qcom/sc8280xp-lenovo-thinkpad-x13s.dts
index 51523e305a5b4..09e4330634f0a 100644
--- a/arch/arm64/boot/dts/qcom/sc8280xp-lenovo-thinkpad-x13s.dts
+++ b/arch/arm64/boot/dts/qcom/sc8280xp-lenovo-thinkpad-x13s.dts
@@ -684,6 +684,7 @@ camera@10 {
 		clocks = <&camcc CAMCC_MCLK3_CLK>;
 
 		orientation = <0>;	/* Front facing */
+		rotation = <0>;
 
 		avdd-supply = <&vreg_l6q>;
 		dvdd-supply = <&vreg_l2q>;
-- 
2.56.0

