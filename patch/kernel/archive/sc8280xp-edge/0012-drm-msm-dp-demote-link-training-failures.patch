From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: SuperKali <hello@superkali.me>
Date: Sat, 18 Jul 2026 13:00:32 +0200
Subject: drm/msm/dp: demote per-attempt link training failures to debug

Link training runs inside a rate/lane down-shift retry loop: on failure
the driver drops to a lower rate or lane count and tries again. Each
inner attempt logs "link training ... failed" at error level, so a link
that only comes up after one or more down-shifts still prints several
errors on an otherwise successful enable. The success counterparts of
these messages already use drm_dbg_dp(), so demote the matching failure
paths to debug as well.

The LTTPR training failure keeps its error level, as it indicates a
repeater fault rather than a normal rate down-shift.

Signed-off-by: SuperKali <hello@superkali.me>
---
 drivers/gpu/drm/msm/dp/dp_ctrl.c | 12 ++++++----
 1 file changed, 8 insertions(+), 4 deletions(-)

diff --git a/drivers/gpu/drm/msm/dp/dp_ctrl.c b/drivers/gpu/drm/msm/dp/dp_ctrl.c
index 111111111111..222222222222 100644
--- a/drivers/gpu/drm/msm/dp/dp_ctrl.c
+++ b/drivers/gpu/drm/msm/dp/dp_ctrl.c
@@ -1411,7 +1411,8 @@ static int msm_dp_ctrl_set_pattern_state_bit(struct msm_dp_ctrl_private *ctrl,
 				 data, data & bit,
 				 POLLING_SLEEP_US, POLLING_TIMEOUT_US);
 	if (ret < 0) {
-		DRM_ERROR("set state_bit for link_train=%d failed\n", state_bit);
+		drm_dbg_dp(ctrl->drm_dev,
+			   "set state_bit for link_train=%d failed\n", state_bit);
 		return ret;
 	}
 
@@ -1603,14 +1604,16 @@ static int msm_dp_ctrl_link_train_1_2(struct msm_dp_ctrl_private *ctrl,
 
 	ret = msm_dp_ctrl_link_train_1(ctrl, training_step, dp_phy);
 	if (ret) {
-		DRM_ERROR("link training #1 on phy %d failed. ret=%d\n", dp_phy, ret);
+		drm_dbg_dp(ctrl->drm_dev,
+			   "link training #1 on phy %d failed. ret=%d\n", dp_phy, ret);
 		return ret;
 	}
 	drm_dbg_dp(ctrl->drm_dev, "link training #1 on phy %d successful\n", dp_phy);
 
 	ret = msm_dp_ctrl_link_train_2(ctrl, training_step, dp_phy);
 	if (ret) {
-		DRM_ERROR("link training #2 on phy %d failed. ret=%d\n", dp_phy, ret);
+		drm_dbg_dp(ctrl->drm_dev,
+			   "link training #2 on phy %d failed. ret=%d\n", dp_phy, ret);
 		return ret;
 	}
 	drm_dbg_dp(ctrl->drm_dev, "link training #2 on phy %d successful\n", dp_phy);
@@ -1665,7 +1668,8 @@ static int msm_dp_ctrl_link_train(struct msm_dp_ctrl_private *ctrl,
 
 	ret = msm_dp_ctrl_link_train_1_2(ctrl, training_step, DP_PHY_DPRX);
 	if (ret) {
-		DRM_ERROR("link training on sink failed. ret=%d\n", ret);
+		drm_dbg_dp(ctrl->drm_dev,
+			   "link training on sink failed. ret=%d\n", ret);
 		goto end;
 	}
 
