From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Xilin Wu <sophon@radxa.com>
Date: Tue, 7 Jul 2026 16:27:38 +0800
Subject: firmware: qcom: scm: add TPM backend type query

Some Qualcomm firmware exposes a SIP call for discovering the active TPM
backend behind the qcom.tz.tpm application. Add a small SCM wrapper for
this call so clients can reject unsupported backends before binding.

The call uses service 0x20, command 0x01, and returns the TPM backend type
in result[0].

Signed-off-by: Xilin Wu <sophon@radxa.com>
(cherry picked from commit cf7cee1023310e49cfbb4419e61c5258491600a7)
Signed-off-by: SuperKali <hello@superkali.me>
---
 drivers/firmware/qcom/qcom_scm.c       | 35 ++++++++++
 drivers/firmware/qcom/qcom_scm.h       |  3 +
 include/linux/firmware/qcom/qcom_scm.h |  2 +
 3 files changed, 40 insertions(+)

diff --git a/drivers/firmware/qcom/qcom_scm.c b/drivers/firmware/qcom/qcom_scm.c
index 111111111111..222222222222 100644
--- a/drivers/firmware/qcom/qcom_scm.c
+++ b/drivers/firmware/qcom/qcom_scm.c
@@ -2111,6 +2111,41 @@ static int qcom_scm_find_dload_address(struct device *dev, u64 *addr)
 	return 0;
 }
 
+/**
+ * qcom_scm_query_tpm_type() - Query the TPM backend type from TrustZone.
+ * @type: Returned TPM type.
+ *
+ * Invoke the Qualcomm SIP TPM info call. Success or failure of the secure call
+ * is returned by qcom_scm_call(); the TPM type is returned in result[0].
+ *
+ * Return: Zero on success, nonzero on failure.
+ */
+int qcom_scm_query_tpm_type(u64 *type)
+{
+	struct qcom_scm_desc desc = {
+		.owner = ARM_SMCCC_OWNER_SIP,
+		.svc = QCOM_SCM_SVC_TPM_INFO,
+		.cmd = QCOM_SCM_TPM_INFO_QUERY_TYPE,
+		.arginfo = QCOM_SCM_ARGS(0),
+	};
+	struct qcom_scm_res res = {};
+	int ret;
+
+	if (!type)
+		return -EINVAL;
+
+	if (!__scm)
+		return -EPROBE_DEFER;
+
+	ret = qcom_scm_call(__scm->dev, &desc, &res);
+	if (ret)
+		return ret;
+
+	*type = res.result[0];
+	return 0;
+}
+EXPORT_SYMBOL_GPL(qcom_scm_query_tpm_type);
+
 #ifdef CONFIG_QCOM_QSEECOM
 
 /* Lock for QSEECOM SCM call executions */
diff --git a/drivers/firmware/qcom/qcom_scm.h b/drivers/firmware/qcom/qcom_scm.h
index 111111111111..222222222222 100644
--- a/drivers/firmware/qcom/qcom_scm.h
+++ b/drivers/firmware/qcom/qcom_scm.h
@@ -153,6 +153,9 @@ int qcom_scm_shm_bridge_enable(struct device *scm_dev);
 #define QCOM_SCM_SVC_STORAGE			0x1a
 #define QCOM_SCM_STORAGE_CMD			0x01
 
+#define QCOM_SCM_SVC_TPM_INFO			0x20
+#define QCOM_SCM_TPM_INFO_QUERY_TYPE		0x01
+
 #define QCOM_SCM_SVC_WAITQ			0x24
 #define QCOM_SCM_WAITQ_RESUME			0x02
 #define QCOM_SCM_WAITQ_GET_WQ_CTX		0x03
diff --git a/include/linux/firmware/qcom/qcom_scm.h b/include/linux/firmware/qcom/qcom_scm.h
index 111111111111..222222222222 100644
--- a/include/linux/firmware/qcom/qcom_scm.h
+++ b/include/linux/firmware/qcom/qcom_scm.h
@@ -197,6 +197,8 @@ int qcom_scm_shm_bridge_create(u64 pfn_and_ns_perm_flags,
 			       u64 ns_vmids, u64 *handle);
 int qcom_scm_shm_bridge_delete(u64 handle);
 
+int qcom_scm_query_tpm_type(u64 *type);
+
 #ifdef CONFIG_QCOM_QSEECOM
 
 int qcom_scm_qseecom_app_get_id(const char *app_name, u32 *app_id);
-- 
