Subject: arm64: dts: freescale: enable symbols in Verdin iMX8MM DTBs

The symbol nodes are required for U-Boot to apply overlays.

Signed-off-by: Lucas Hehl <lucas@hehl.com.br>
---
 arch/arm64/boot/dts/freescale/Makefile | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/arch/arm64/boot/dts/freescale/Makefile b/arch/arm64/boot/dts/freescale/Makefile
index 9cab0fce6e0e..3fe93ca82567 100644
--- a/arch/arm64/boot/dts/freescale/Makefile
+++ b/arch/arm64/boot/dts/freescale/Makefile
@@ -238,6 +238,10 @@ dtb-$(CONFIG_ARCH_MXC) += imx8mp-toradex-smarc-dev.dtb
 dtb-$(CONFIG_ARCH_MXC) += imx8mp-tqma8mpql-mba8mpxl.dtb
 dtb-$(CONFIG_ARCH_MXC) += imx8mp-tqma8mpql-mba8mp-ras314.dtb
 
+# Toradex Verdin iMX8M Mini: enable symbols for DT overlay support
+DTC_FLAGS_imx8mm-verdin-wifi-dev += -@
+DTC_FLAGS_imx8mm-verdin-nonwifi-dev += -@
+
 # TQ MBa8MPxL / RAS314: enable symbols node for DT overlay support
 DTC_FLAGS_imx8mp-tqma8mpql-mba8mpxl += -@
 DTC_FLAGS_imx8mp-tqma8mpql-mba8mp-ras314 += -@
