From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Igor Pecovnik <igor@armbian.com>
Date: Mon, 12 Oct 2026 21:11:33 +0200
Subject: [PATCH 24/24] arm64: dts: realtek: bpi-w2: add the ISO GPIOs and the
 LEDs

Add the ISO GPIO controller and the red, green and blue LEDs. The red
LED shows a heartbeat. The green and blue LEDs are for port traffic.
Give the second port the alias ethernet1, for a stable name.

Signed-off-by: Igor Pecovnik <igor@armbian.com>
---
 .../boot/dts/realtek/rtd1296-bananapi-w2.dts  | 51 +++++++++++++++++++
 1 file changed, 51 insertions(+)

diff --git a/arch/arm64/boot/dts/realtek/rtd1296-bananapi-w2.dts b/arch/arm64/boot/dts/realtek/rtd1296-bananapi-w2.dts
index 30edc2d..b7c074a 100644
--- a/arch/arm64/boot/dts/realtek/rtd1296-bananapi-w2.dts
+++ b/arch/arm64/boot/dts/realtek/rtd1296-bananapi-w2.dts
@@ -25,6 +25,7 @@
 
 	aliases {
 		ethernet0 = &gmac;
+		ethernet1 = &nat;
 		/* fixed names: the SD card is mmcblk0, the eMMC mmcblk1 */
 		mmc0 = &sdmmc;
 		mmc1 = &emmc;
@@ -993,3 +994,53 @@
 		pinctrl-0 = <&ir_rx_pins>;
 	};
 };
+
+/*
+ * ISO GPIO 0-34: the red LED, the power button and six header pins.
+ * The interrupt status registers sit in the same block as
+ * the ISO interrupt mux and the reset and clock controls; gpio-rtd maps
+ * them without claiming them.
+ */
+&iso {
+	iso_gpio: gpio@100 {
+		compatible = "realtek,rtd1295-iso-gpio";
+		reg = <0x100 0x100>, <0x0 0x100>;
+		interrupt-parent = <&iso_irq_mux>;
+		interrupts = <19>, <20>;	/* assert, deassert */
+		gpio-controller;
+		#gpio-cells = <2>;
+	};
+};
+
+#include <dt-bindings/leds/common.h>
+
+/* The three LEDs next to the power jack, from the BSP's rtk-leds node */
+/ {
+	leds {
+		compatible = "gpio-leds";
+
+		led-0 {
+			color = <LED_COLOR_ID_RED>;
+			function = LED_FUNCTION_HEARTBEAT;
+			gpios = <&iso_gpio 27 GPIO_ACTIVE_LOW>;
+			linux,default-trigger = "heartbeat";
+		};
+
+		/* user space sets these to show the two ports' traffic */
+		led-1 {
+			color = <LED_COLOR_ID_GREEN>;
+			function = LED_FUNCTION_LAN;
+			function-enumerator = <0>;
+			gpios = <&misc_gpio 97 GPIO_ACTIVE_LOW>;
+			default-state = "off";
+		};
+
+		led-2 {
+			color = <LED_COLOR_ID_BLUE>;
+			function = LED_FUNCTION_LAN;
+			function-enumerator = <1>;
+			gpios = <&misc_gpio 98 GPIO_ACTIVE_LOW>;
+			default-state = "off";
+		};
+	};
+};
