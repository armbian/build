From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Igor Pecovnik <igor@armbian.com>
Date: Mon, 12 Oct 2026 21:11:33 +0200
Subject: [PATCH 23/24] gpio: rtd: do not claim the interrupt status registers

On RTD1295 the ISO GPIO interrupt status registers share one block
with the ISO interrupt mux and the reset and clock controls. The
claim fails, so the ISO GPIOs do not probe. Map the registers without
claiming them.

Signed-off-by: Igor Pecovnik <igor@armbian.com>
---
 drivers/gpio/gpio-rtd.c | 16 +++++++++++++---
 1 file changed, 13 insertions(+), 3 deletions(-)

diff --git a/drivers/gpio/gpio-rtd.c b/drivers/gpio/gpio-rtd.c
index d46b40d..19a52ac 100644
--- a/drivers/gpio/gpio-rtd.c
+++ b/drivers/gpio/gpio-rtd.c
@@ -9,6 +9,7 @@
 #include <linux/cleanup.h>
 #include <linux/gpio/driver.h>
 #include <linux/interrupt.h>
+#include <linux/io.h>
 #include <linux/irqchip.h>
 #include <linux/irqchip/chained_irq.h>
 #include <linux/irqdomain.h>
@@ -527,6 +528,7 @@ static int rtd_gpio_probe(struct platform_device *pdev)
 	struct device *dev = &pdev->dev;
 	struct gpio_irq_chip *irq_chip;
 	struct rtd_gpio *data;
+	struct resource *res;
 	int ret;
 
 	data = devm_kzalloc(dev, sizeof(*data), GFP_KERNEL);
@@ -553,9 +555,17 @@ static int rtd_gpio_probe(struct platform_device *pdev)
 	if (IS_ERR(data->base))
 		return PTR_ERR(data->base);
 
-	data->irq_base = devm_platform_ioremap_resource(pdev, 1);
-	if (IS_ERR(data->irq_base))
-		return PTR_ERR(data->irq_base);
+	/*
+	 * On RTD1295 the ISO GPIO interrupt status shares its register block
+	 * with the ISO interrupt mux, reset and clock controls. Map it, but
+	 * do not claim it.
+	 */
+	res = platform_get_resource(pdev, IORESOURCE_MEM, 1);
+	if (!res)
+		return -EINVAL;
+	data->irq_base = devm_ioremap(dev, res->start, resource_size(res));
+	if (!data->irq_base)
+		return -ENOMEM;
 
 	data->gpio_chip.label = dev_name(dev);
 	data->gpio_chip.base = -1;
