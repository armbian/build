From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Igor Pecovnik <igor@armbian.com>
Date: Tue, 13 Oct 2026 21:34:03 +0200
Subject: [PATCH] arm64: dts: realtek: bpi-w2: enable the USB 2.0 port

Enable the EHCI/OHCI pair (port 2) with the generic drivers.
Switch on its VBUS. The type-A port next to the USB 3.0 port then works.

Signed-off-by: Igor Pecovnik <igor@armbian.com>
---
 .../boot/dts/realtek/rtd1296-bananapi-w2.dts  | 27 +++++++++++++++++--
 1 file changed, 25 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/realtek/rtd1296-bananapi-w2.dts b/arch/arm64/boot/dts/realtek/rtd1296-bananapi-w2.dts
index b7c074a..cd28598 100644
--- a/arch/arm64/boot/dts/realtek/rtd1296-bananapi-w2.dts
+++ b/arch/arm64/boot/dts/realtek/rtd1296-bananapi-w2.dts
@@ -502,8 +502,7 @@
  * index 0 to reg_wrap_vstatus and index 1 to reg_gusb2phyacc0.
  *
  * Port 0 is the Type-C port, as a device (below). Port 2, the EHCI/OHCI
- * pair, is not here: mainline has no driver for the BSP's
- * "Realtek,rtd129x-ehci".
+ * pair, uses the generic drivers.
  *
  * The USB clock gate and resets used to be left to the bootloader. LK runs
  * `usb start` and leaves them open, but the BSP u-boot on an SD boot does
@@ -839,6 +838,19 @@
 		};
 	};
 
+	/* Port 2: USB 2.0 host, the type-A port next to the USB 3.0 port */
+	usb@13000 {
+		compatible = "generic-ehci";
+		reg = <0x13000 0x100>;
+		interrupts = <GIC_SPI 21 IRQ_TYPE_LEVEL_HIGH>;
+	};
+
+	usb@13400 {
+		compatible = "generic-ohci";
+		reg = <0x13400 0x100>;
+		interrupts = <GIC_SPI 21 IRQ_TYPE_LEVEL_HIGH>;
+	};
+
 	/* Port 3: USB 3.0 host */
 	usb_u3host_usb2phy: usb-phy@13e14 {
 		compatible = "realtek,rtd1295-usb2phy";
@@ -926,6 +938,17 @@
 		gpio = <&misc_gpio 56 GPIO_ACTIVE_HIGH>;
 		enable-active-high;
 	};
+
+	/* VBUS of the USB 2.0 port (port 2) */
+	regulator-usb-p2-vbus {
+		compatible = "regulator-fixed";
+		regulator-name = "usb-p2-vbus";
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+		gpio = <&misc_gpio 18 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		regulator-always-on;
+	};
 };
 
 &rbus {
-- 
2.53.0

