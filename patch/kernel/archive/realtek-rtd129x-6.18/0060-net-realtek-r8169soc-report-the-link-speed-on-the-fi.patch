From b217c508737efe6b2573ee2ece2c859d4f379083 Mon Sep 17 00:00:00 2001
From: Igor Pecovnik <igor@armbian.com>
Date: Thu, 22 Oct 2026 10:05:08 +0000
Subject: [PATCH] net: realtek: r8169soc: report the link speed on the first
 read

ethtool reports an unknown speed on its first read after a link change.
The PHY latches the BMSR link status low. Clear the latch first.

Assisted-by: Claude Opus 5.5
Signed-off-by: Igor Pecovnik <igor@armbian.com>
---
 drivers/net/ethernet/realtek/r8169soc.c | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/drivers/net/ethernet/realtek/r8169soc.c b/drivers/net/ethernet/realtek/r8169soc.c
index 33f046bbc..5299800c0 100644
--- a/drivers/net/ethernet/realtek/r8169soc.c
+++ b/drivers/net/ethernet/realtek/r8169soc.c
@@ -2144,6 +2144,8 @@ static int rtl8169_get_link_ksettings(struct net_device *dev,
 	struct rtl8169_private *tp = netdev_priv(dev);
 
 	rtl_lock_work(tp);
+	/* BMSR link status latches low: clear it, then read the current state */
+	tp->mii.mdio_read(dev, tp->mii.phy_id, MII_BMSR);
 	mii_ethtool_get_link_ksettings(&tp->mii, cmd);
 	rtl_unlock_work(tp);
 
-- 
2.53.0

