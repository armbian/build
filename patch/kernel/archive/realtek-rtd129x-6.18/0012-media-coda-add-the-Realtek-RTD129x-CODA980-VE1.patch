+/*
+ * Realtek RTD129x: VE1 is a CODA980 behind a Realtek wrapper. Its SRAM power
+ * domain, reset and isolation live in the CRT block, and the wrapper has to
+ * enable its bus command interface (CTI) before any core register answers:
+ * until then every read ends in an SB2 timeout (0xdeadbeef). Realtek's BSP
+ * does this in rtk_ve/ve1/ve1.c, vpu_pctrl_on() and ve1_wrapper_setup().
+ */
+#define RTD129X_CRT_VE1_SRAM_PWR	0x390	/* 0xf00 on, 0xf01 off */
+#define RTD129X_CRT_VE1_SRAM_ACK	0x3a8	/* 4 when done; write 4 to ack */
+#define RTD129X_CRT_ISO			0x400
+#define RTD129X_CRT_ISO_VE1		BIT(0)
+#define RTD129X_VE_CTRL			0x3000
+#define RTD129X_VE_CTRL_CTI_EN		BIT(1)
+#define RTD129X_VE_CTI_GRP		0x3004
+#define RTD129X_VE_CTI_CMD_DEPTH	GENMASK(29, 24)
+
+void coda_rtd129x_power_on(struct coda_dev *dev)
+{
+	u32 val;
+	int i, ret;
+
+	/*
+	 * Early in boot the first power-on of the SRAM domain is not acked,
+	 * not even after 50 ms; powered off and on again it acks within some
+	 * 50 us. The BIT's code RAM must not take the firmware download
+	 * unpowered. A stale ack, from powering off, would end the wait at
+	 * once, so it is cleared first.
+	 */
+	regmap_read(dev->crt, RTD129X_CRT_VE1_SRAM_PWR, &val);
+	for (i = 0; val != 0xf00 && i < 3; i++) {
+		regmap_write(dev->crt, RTD129X_CRT_VE1_SRAM_ACK, 4);
+		regmap_write(dev->crt, RTD129X_CRT_VE1_SRAM_PWR, 0xf00);
+		ret = regmap_read_poll_timeout(dev->crt,
+					       RTD129X_CRT_VE1_SRAM_ACK, val,
+					       val == 4, 10, 10000);
+		regmap_write(dev->crt, RTD129X_CRT_VE1_SRAM_ACK, 4);
+		if (!ret)
+			break;
+		dev_dbg(dev->dev, "VE1 SRAM power-on not acked, retrying\n");
+		regmap_write(dev->crt, RTD129X_CRT_VE1_SRAM_PWR, 0xf01);
+		regmap_read_poll_timeout(dev->crt, RTD129X_CRT_VE1_SRAM_ACK,
+					 val, val == 4, 10, 10000);
+		val = 0xf01;
+	}
+	if (i == 3)
+		dev_err(dev->dev, "VE1 SRAM power-on not acked\n");
+
+	reset_control_assert(dev->rstc);
+	reset_control_deassert(dev->rstc);
+
+	regmap_update_bits(dev->crt, RTD129X_CRT_ISO, RTD129X_CRT_ISO_VE1, 0);
+
+	/* the wrapper; the command depth works around a 1296 timing issue */
+	val = readl(dev->regs_base + RTD129X_VE_CTRL);
+	writel(val | RTD129X_VE_CTRL_CTI_EN, dev->regs_base + RTD129X_VE_CTRL);
+	val = readl(dev->regs_base + RTD129X_VE_CTI_GRP);
+	val &= ~RTD129X_VE_CTI_CMD_DEPTH;
+	val |= FIELD_PREP(RTD129X_VE_CTI_CMD_DEPTH, 0x1a);
+	writel(val, dev->regs_base + RTD129X_VE_CTI_GRP);
+}
