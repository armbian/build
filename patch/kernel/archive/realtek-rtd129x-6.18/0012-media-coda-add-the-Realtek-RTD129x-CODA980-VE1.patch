+/*
+ * The CODA980 firmware reads command parameters the CODA960 code never
+ * writes, and the parameter registers are shared with the previous command's
+ * parameters and return values. Zero them before a command's parameters go
+ * in, so nothing stale is taken as an option. The ENCODE_HEADER command, for
+ * one, reads CABAC, 8x8 transform, chroma format, field and profile settings
+ * at 0x194-0x1a8, where SEQ_INIT left the frame rate, 264_PARA, slice mode
+ * and GOP size: the SPS came out as High profile with a bogus bit depth.
+ * Zero is what is wanted there: CAVLC, 4x4, 4:2:0, frames, Baseline.
+ */
+static void coda980_clear_params(struct coda_dev *dev)
+{
+	int reg;
+
+	if (dev->devtype->fw_product != CODA_980)
+		return;
+
+	for (reg = 0x180; reg < 0x200; reg += 4)
+		coda_write(dev, 0, reg);
+}
