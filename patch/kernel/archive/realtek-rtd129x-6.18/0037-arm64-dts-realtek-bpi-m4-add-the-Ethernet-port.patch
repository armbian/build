From a91b02ab7c48a4b61035f29a5415a902e55f98e5 Mon Sep 17 00:00:00 2001
From: Igor Pecovnik <igor@armbian.com>
Date: Wed, 21 Oct 2026 10:47:54 +0000
Subject: [PATCH 37/37] arm64: dts: realtek: bpi-m4: add the Ethernet port

Add the node for the 10/100 Ethernet port of the BPI-M4.
The r8169soc driver then brings the RJ45 port up.

Assisted-by: Claude Opus 5.5
Signed-off-by: Igor Pecovnik <igor@armbian.com>
---
 .../arm64/boot/dts/realtek/rtd1395-bpi-m4.dts | 25 +++++++++++++++++++
 1 file changed, 25 insertions(+)

diff --git a/arch/arm64/boot/dts/realtek/rtd1395-bpi-m4.dts b/arch/arm64/boot/dts/realtek/rtd1395-bpi-m4.dts
index 1a533ae36..aa9e8947d 100644
--- a/arch/arm64/boot/dts/realtek/rtd1395-bpi-m4.dts
+++ b/arch/arm64/boot/dts/realtek/rtd1395-bpi-m4.dts
@@ -19,6 +19,7 @@ memory@2f000 {
 	};
 
 	aliases {
+		ethernet0 = &gmac;
 		/* fixed names: the SD card is mmcblk0, the eMMC mmcblk1 */
 		mmc0 = &sdmmc;
 		mmc1 = &emmc;
@@ -81,6 +82,30 @@ emmc: mmc@12000 {
 		no-sdio;
 		status = "disabled";
 	};
+
+	/*
+	 * The RJ45: the SoC's MAC and its embedded 10/100 PHY. The driver
+	 * maps ISO and the OTP without requesting them, so the overlap with
+	 * the iso syscon does not collide.
+	 */
+	gmac: ethernet@16000 {
+		compatible = "realtek,rtd1395-r8168";
+		reg = <0x16000 0x1000>,	/* ETN */
+		      <0x7000 0x1000>,	/* ISO */
+		      <0x172c8 0x20>;	/* OTP: PHY R-cal and IDAC */
+		interrupts = <GIC_SPI 22 IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&iso_clk 12>, <&iso_clk 11>;	/* ETN_SYS, ETN_250M */
+		clock-names = "etn_sys", "etn_250m";
+		resets = <&iso_reset RTD1295_ISO_RSTN_GMAC>,
+			 <&iso_reset RTD1295_ISO_RSTN_GPHY>;
+		reset-names = "gmac", "gphy";
+		realtek,sb2 = <&sb2>;	/* to sync descriptors out to DDR */
+		mac-version = <42>;	/* RTL_GIGA_MAC_VER_42 */
+		output-mode = <0>;	/* embedded PHY */
+		bypass = <1>;
+		acp = <0>;
+		eee = <1>;
+	};
 };
 
 &uart0 {
