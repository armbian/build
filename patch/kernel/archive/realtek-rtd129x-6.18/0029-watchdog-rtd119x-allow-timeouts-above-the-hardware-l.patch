From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Igor Pecovnik <igor@armbian.com>
Date: Fri, 16 Oct 2026 18:18:35 +0200
Subject: [PATCH] watchdog: rtd119x: allow timeouts above the hardware limit

The counter wraps after ~159 s at 27 MHz. systemd sets a 10 min reboot
timeout and fails with -EINVAL, so shutdown runs without a watchdog.
Declare the limit as max_hw_heartbeat_ms. The core then pings in between.

Signed-off-by: Igor Pecovnik <igor@armbian.com>
---
 drivers/watchdog/rtd119x_wdt.c | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/drivers/watchdog/rtd119x_wdt.c b/drivers/watchdog/rtd119x_wdt.c
--- a/drivers/watchdog/rtd119x_wdt.c
+++ b/drivers/watchdog/rtd119x_wdt.c
@@ -70,8 +70,9 @@
 static int rtd119x_wdt_set_timeout(struct watchdog_device *wdev, unsigned int val)
 {
 	struct rtd119x_watchdog_device *data = watchdog_get_drvdata(wdev);
+	unsigned int hw = min(val, wdev->max_hw_heartbeat_ms / 1000);
 
-	writel(val * clk_get_rate(data->clk), data->base + RTD119X_TCWOV);
+	writel(hw * clk_get_rate(data->clk), data->base + RTD119X_TCWOV);
 
 	data->wdt_dev.timeout = val;
 
@@ -143,7 +144,8 @@
 	data->wdt_dev.info = &rtd119x_wdt_info;
 	data->wdt_dev.ops = &rtd119x_wdt_ops;
 	data->wdt_dev.timeout = 120;
-	data->wdt_dev.max_timeout = 0xffffffff / rate;
+	/* the core pings in between for a longer timeout */
+	data->wdt_dev.max_hw_heartbeat_ms = 0xffffffff / rate * 1000;
 	data->wdt_dev.min_timeout = 1;
 	data->wdt_dev.parent = dev;
 
-- 
Armbian

