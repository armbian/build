From b05a09bc728fcddb7a53d138922e4aa59a23f3e8 Mon Sep 17 00:00:00 2001
From: Igor Pecovnik <igor@armbian.com>
Date: Wed, 21 Oct 2026 18:09:04 +0000
Subject: [PATCH 47/51] arm64: dts: realtek: bpi-m4: add the audio CPU for the
 HDMI output

The audio firmware runs the HDMI output. Reserve the memory it uses, as
in the BSP, and add its RPC node and the scanout pool.

Assisted-by: Claude Opus 5.5
Signed-off-by: Igor Pecovnik <igor@armbian.com>
---
 .../arm64/boot/dts/realtek/rtd1395-bpi-m4.dts | 80 +++++++++++++++++++
 1 file changed, 80 insertions(+)

diff --git a/arch/arm64/boot/dts/realtek/rtd1395-bpi-m4.dts b/arch/arm64/boot/dts/realtek/rtd1395-bpi-m4.dts
index fd86df0b7..e2aec532f 100644
--- a/arch/arm64/boot/dts/realtek/rtd1395-bpi-m4.dts
+++ b/arch/arm64/boot/dts/realtek/rtd1395-bpi-m4.dts
@@ -41,6 +41,57 @@ usb_p2_vbus: regulator-usb-p2-vbus {
 		regulator-always-on;
 	};
 
+	/*
+	 * The audio CPU's firmware (bluecore.audio) runs the HDMI output. It
+	 * expects the BSP's memory layout (memory.h, rtd-1395-bananapi-m4-1GB
+	 * .dts) and writes into its heaps on its own, so they are reserved
+	 * as in the BSP. U-Boot starts it from /boot/bluecore.audio.
+	 */
+	reserved-memory {
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges;
+
+		/* ION_AUDIO_HEAP_PHYS_0: shared with the audio firmware */
+		acpu_audio_heap: audio-heap@2600000 {
+			reg = <0x02600000 0x00c00000>;
+			no-map;
+		};
+
+		/* ION_MEDIA_HEAP_PHYS_0: the firmware's video memory */
+		ion_media1: media-heap@3200000 {
+			reg = <0x03200000 0x0c700000>;
+			no-map;
+		};
+
+		/* ACPU_FIREWARE_PHYS: the image, its BSS, heap and stacks */
+		acpu_fw: audio-firmware@f900000 {
+			reg = <0x0f900000 0x00500000>;
+			no-map;
+		};
+
+		acpu_idmem: acpu-idmem@10000000 {
+			reg = <0x10000000 0x00014000>;
+			no-map;
+		};
+
+		/*
+		 * Scanout buffers for the HDMI output (rtd129x-vo). The audio
+		 * CPU reads them, so they must be below 512 MiB.
+		 */
+		vo_pool: vo-pool@11000000 {
+			compatible = "shared-dma-pool";
+			reg = <0x11000000 0x03200000>;
+			no-map;
+		};
+
+		/* ACPU_BOOTCODE_PHYS: the MIPS reset vector */
+		acpu_bootcode: acpu-bootcode@1fc00000 {
+			reg = <0x1fc00000 0x1000>;
+			no-map;
+		};
+	};
+
 	leds {
 		compatible = "gpio-leds";
 
@@ -362,6 +413,35 @@ cpu_tm: thermal-sensor@150 {
 	};
 };
 
+/*
+ * Shared with the audio CPU, which reads and writes them uncached: the IPC
+ * block and the RPC rings.
+ */
+&rpc_comm {
+	no-map;
+};
+
+&rpc_ringbuf {
+	no-map;
+};
+
+&rbus {
+	/*
+	 * The audio CPU's RPC. The registers are SB2's CPU_INT/CPU_INT_EN,
+	 * as on the RTD1295.
+	 */
+	acpu: audio-cpu@1a104 {
+		compatible = "realtek,rtd1395-acpu", "realtek,rtd1295-acpu";
+		reg = <0x1a104 0xc>;
+		interrupts = <GIC_SPI 33 IRQ_TYPE_LEVEL_HIGH>;
+		memory-region = <&rpc_comm>, <&rpc_ringbuf>,
+				<&acpu_audio_heap>, <&ion_media1>, <&acpu_fw>,
+				<&vo_pool>;
+		memory-region-names = "comm", "ring", "audio", "media",
+				      "firmware", "vo";
+	};
+};
+
 &uart0 {
 	status = "okay";
 };
-- 
