From a4dd3fec86ebdea7d9e4a5383f46d098e0efd971 Mon Sep 17 00:00:00 2001
From: Igor Pecovnik <igor@armbian.com>
Date: Thu, 22 Oct 2026 07:49:41 +0000
Subject: [PATCH 58/58] arm64: dts: realtek: bpi-m4: enable the M.2 PCIe slot

Enable PCIe0 for the M.2 Key E slot. PERST# is ISO GPIO 29.

Assisted-by: Claude Opus 5.5
Signed-off-by: Igor Pecovnik <igor@armbian.com>
---
 arch/arm64/boot/dts/realtek/rtd1395-bpi-m4.dts | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/arch/arm64/boot/dts/realtek/rtd1395-bpi-m4.dts b/arch/arm64/boot/dts/realtek/rtd1395-bpi-m4.dts
index 16b73f5de..0b271816e 100644
--- a/arch/arm64/boot/dts/realtek/rtd1395-bpi-m4.dts
+++ b/arch/arm64/boot/dts/realtek/rtd1395-bpi-m4.dts
@@ -455,6 +455,15 @@ acpu: audio-cpu@1a104 {
 	};
 };
 
+/*
+ * The M.2 Key E slot. PERST# is ISO GPIO 29, low active (BSP: gpios =
+ * <&rtk_iso_gpio 29 1 0>, driven low, then high).
+ */
+&pcie {
+	reset-gpios = <&iso_gpio 29 GPIO_ACTIVE_LOW>;
+	status = "okay";
+};
+
 &uart0 {
 	status = "okay";
 };
-- 
