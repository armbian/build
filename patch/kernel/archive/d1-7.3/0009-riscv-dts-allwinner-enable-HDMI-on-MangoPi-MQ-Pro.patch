From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Samuel Holland <samuel@sholland.org>
Date: Thu, 8 Oct 2026 07:28:46 +0900
Subject: riscv: dts: allwinner: enable HDMI on MangoPi MQ Pro

Enable the Mini HDMI connector and its display pipeline.
Power the controller from LDOA.

Select mixer0 so the UI plane can use HDMI.
Disable the unused LCD controller on this board.

Link: https://github.com/smaeul/linux/commit/8be4bf5bd4743f01f19bea15a1cecce38fc385e8
Signed-off-by: Samuel Holland <samuel@sholland.org>
---
 arch/riscv/boot/dts/allwinner/sun20i-d1-mangopi-mq-pro.dts | 35 ++++++++++
 1 file changed, 35 insertions(+)

diff --git a/arch/riscv/boot/dts/allwinner/sun20i-d1-mangopi-mq-pro.dts b/arch/riscv/boot/dts/allwinner/sun20i-d1-mangopi-mq-pro.dts
index 111111111111..222222222222 100644
--- a/arch/riscv/boot/dts/allwinner/sun20i-d1-mangopi-mq-pro.dts
+++ b/arch/riscv/boot/dts/allwinner/sun20i-d1-mangopi-mq-pro.dts
@@ -22,6 +22,17 @@ chosen {
 		stdout-path = "serial0:115200n8";
 	};
 
+	hdmi_connector: connector {
+		compatible = "hdmi-connector";
+		type = "c";
+
+		port {
+			hdmi_connector_in: endpoint {
+				remote-endpoint = <&hdmi_out_connector>;
+			};
+		};
+	};
+
 	leds {
 		compatible = "gpio-leds";
 
@@ -70,10 +81,30 @@ &dcxo {
 	clock-frequency = <24000000>;
 };
 
+&de {
+	allwinner,pipelines = <&mixer0>;
+	status = "okay";
+};
+
 &ehci1 {
 	status = "okay";
 };
 
+&hdmi {
+	hvcc-supply = <&reg_ldoa>;
+	status = "okay";
+};
+
+&hdmi_out {
+	hdmi_out_connector: endpoint {
+		remote-endpoint = <&hdmi_connector_in>;
+	};
+};
+
+&hdmi_phy {
+	status = "okay";
+};
+
 &mmc0 {
 	bus-width = <4>;
 	cd-gpios = <&pio 5 6 GPIO_ACTIVE_HIGH>; /* PF6 */
@@ -111,6 +142,10 @@ &pio {
 	vcc-pe-supply = <&reg_avdd2v8>;
 };
 
+&tcon_lcd0 {
+	status = "disabled";
+};
+
 &uart0 {
 	pinctrl-0 = <&uart0_pb8_pins>;
 	pinctrl-names = "default";
-- 
Armbian

