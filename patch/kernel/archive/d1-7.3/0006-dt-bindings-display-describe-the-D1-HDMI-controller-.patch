From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Samuel Holland <samuel@sholland.org>
Date: Thu, 8 Oct 2026 07:28:32 +0900
Subject: dt-bindings: display: describe the D1 HDMI controller and PHY

Describe the D1 HDMI clocks and reset interface.
Keep the existing controller clock requirements.

Link: https://github.com/smaeul/linux/commit/30c3e224ca82f185fb2ee9265050708613ea72b1
Signed-off-by: Samuel Holland <samuel@sholland.org>
---
 Documentation/devicetree/bindings/display/allwinner,sun8i-a83t-dw-hdmi.yaml  | 76 +++++++---
 Documentation/devicetree/bindings/display/allwinner,sun8i-a83t-hdmi-phy.yaml |  1 +
 2 files changed, 57 insertions(+), 20 deletions(-)

diff --git a/Documentation/devicetree/bindings/display/allwinner,sun8i-a83t-dw-hdmi.yaml b/Documentation/devicetree/bindings/display/allwinner,sun8i-a83t-dw-hdmi.yaml
index 111111111111..222222222222 100644
--- a/Documentation/devicetree/bindings/display/allwinner,sun8i-a83t-dw-hdmi.yaml
+++ b/Documentation/devicetree/bindings/display/allwinner,sun8i-a83t-dw-hdmi.yaml
@@ -25,6 +25,7 @@ properties:
 
   compatible:
     oneOf:
+      - const: allwinner,sun20i-d1-dw-hdmi
       - const: allwinner,sun8i-a83t-dw-hdmi
       - const: allwinner,sun50i-h6-dw-hdmi
 
@@ -46,23 +47,11 @@ properties:
 
   clocks:
     minItems: 3
-    items:
-      - description: Bus Clock
-      - description: Register Clock
-      - description: TMDS Clock
-      - description: HDMI CEC Clock
-      - description: HDCP Clock
-      - description: HDCP Bus Clock
+    maxItems: 6
 
   clock-names:
     minItems: 3
-    items:
-      - const: iahb
-      - const: isfr
-      - const: tmds
-      - const: cec
-      - const: hdcp
-      - const: hdcp-bus
+    maxItems: 6
 
   resets:
     minItems: 1
@@ -125,22 +114,69 @@ if:
   properties:
     compatible:
       contains:
-        enum:
-          - allwinner,sun50i-h6-dw-hdmi
+        const: allwinner,sun20i-d1-dw-hdmi
 
 then:
   properties:
     clocks:
-      minItems: 6
+      items:
+        - description: Bus Clock
+        - description: Register Clock
+        - description: HDMI CEC Clock
 
     clock-names:
-      minItems: 6
+      items:
+        - const: iahb
+        - const: isfr
+        - const: cec
 
     resets:
-      minItems: 2
+      maxItems: 1
 
     reset-names:
-      minItems: 2
+      maxItems: 1
+
+else:
+  properties:
+    clocks:
+      minItems: 3
+      items:
+        - description: Bus Clock
+        - description: Register Clock
+        - description: TMDS Clock
+        - description: HDMI CEC Clock
+        - description: HDCP Clock
+        - description: HDCP Bus Clock
+
+    clock-names:
+      minItems: 3
+      items:
+        - const: iahb
+        - const: isfr
+        - const: tmds
+        - const: cec
+        - const: hdcp
+        - const: hdcp-bus
+
+  if:
+    properties:
+      compatible:
+        contains:
+          const: allwinner,sun50i-h6-dw-hdmi
+
+  then:
+    properties:
+      clocks:
+        minItems: 6
+
+      clock-names:
+        minItems: 6
+
+      resets:
+        minItems: 2
+
+      reset-names:
+        minItems: 2
 
 additionalProperties: false
 
diff --git a/Documentation/devicetree/bindings/display/allwinner,sun8i-a83t-hdmi-phy.yaml b/Documentation/devicetree/bindings/display/allwinner,sun8i-a83t-hdmi-phy.yaml
index 111111111111..222222222222 100644
--- a/Documentation/devicetree/bindings/display/allwinner,sun8i-a83t-hdmi-phy.yaml
+++ b/Documentation/devicetree/bindings/display/allwinner,sun8i-a83t-hdmi-phy.yaml
@@ -19,6 +19,7 @@ properties:
       - allwinner,sun8i-a83t-hdmi-phy
       - allwinner,sun8i-h3-hdmi-phy
       - allwinner,sun8i-r40-hdmi-phy
+      - allwinner,sun20i-d1-hdmi-phy
       - allwinner,sun50i-a64-hdmi-phy
       - allwinner,sun50i-h6-hdmi-phy
 
-- 
Armbian

