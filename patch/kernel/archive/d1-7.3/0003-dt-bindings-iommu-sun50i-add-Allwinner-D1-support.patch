From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Samuel Holland <samuel@sholland.org>
Date: Thu, 8 Oct 2026 06:39:24 +0900
Subject: dt-bindings: iommu: sun50i: add Allwinner D1 support

Describe the D1 IOMMU without an external reset line.
Require resets for the existing hardware variants.

Link: https://github.com/smaeul/linux/commit/9e3ad4d1634a
Signed-off-by: Samuel Holland <samuel@sholland.org>
Co-developed-by: khaliforce <kforce@gmail.com>
Signed-off-by: khaliforce <kforce@gmail.com>
---
 Documentation/devicetree/bindings/iommu/allwinner,sun50i-h6-iommu.yaml | 15 +++++++++-
 1 file changed, 14 insertions(+), 1 deletion(-)

diff --git a/Documentation/devicetree/bindings/iommu/allwinner,sun50i-h6-iommu.yaml b/Documentation/devicetree/bindings/iommu/allwinner,sun50i-h6-iommu.yaml
index 111111111111..222222222222 100644
--- a/Documentation/devicetree/bindings/iommu/allwinner,sun50i-h6-iommu.yaml
+++ b/Documentation/devicetree/bindings/iommu/allwinner,sun50i-h6-iommu.yaml
@@ -18,6 +18,7 @@ properties:
 
   compatible:
     oneOf:
+      - const: allwinner,sun20i-d1-iommu
       - const: allwinner,sun50i-h6-iommu
       - const: allwinner,sun50i-h616-iommu
       - items:
@@ -42,7 +43,19 @@ required:
   - reg
   - interrupts
   - clocks
-  - resets
+
+allOf:
+  - if:
+      properties:
+        compatible:
+          contains:
+            const: allwinner,sun20i-d1-iommu
+    then:
+      properties:
+        resets: false
+    else:
+      required:
+        - resets
 
 additionalProperties: false
 
-- 
Armbian

