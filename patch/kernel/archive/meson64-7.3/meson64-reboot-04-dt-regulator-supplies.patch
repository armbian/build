From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Igor Velkov <iav@iav.lv>
Date: Tue, 06 Oct 2026 18:30:00 +0000
Subject: arm64: dts: amlogic: point meson64-reboot at the SD regulators

meson64-reboot shares the SD lines with the regulators that own them.
Name those regulators so that the driver probes after them.

Assisted-by: LLM
Signed-off-by: Igor Velkov <iav@iav.lv>
---
 arch/arm64/boot/dts/amlogic/meson-g12b-bananapi-cm4.dtsi | 1 +
 arch/arm64/boot/dts/amlogic/meson-sm1-odroid.dtsi        | 2 ++
 2 files changed, 3 insertions(+)

diff --git a/arch/arm64/boot/dts/amlogic/meson-g12b-bananapi-cm4.dtsi b/arch/arm64/boot/dts/amlogic/meson-g12b-bananapi-cm4.dtsi
index 111111111111..222222222222 100644
--- a/arch/arm64/boot/dts/amlogic/meson-g12b-bananapi-cm4.dtsi
+++ b/arch/arm64/boot/dts/amlogic/meson-g12b-bananapi-cm4.dtsi
@@ -20,5 +20,6 @@
 		sd-vqsw-gpios = <&gpio_ao GPIOAO_9 GPIO_ACTIVE_HIGH>;
 		sd-vmmc-gpios = <&gpio_ao GPIOAO_8 GPIO_ACTIVE_HIGH>;
+		vqmmc-supply = <&vddio_c>;
 	};

 	chosen {
diff --git a/arch/arm64/boot/dts/amlogic/meson-sm1-odroid.dtsi b/arch/arm64/boot/dts/amlogic/meson-sm1-odroid.dtsi
index 111111111111..222222222222 100644
--- a/arch/arm64/boot/dts/amlogic/meson-sm1-odroid.dtsi
+++ b/arch/arm64/boot/dts/amlogic/meson-sm1-odroid.dtsi
@@ -31,6 +31,8 @@
 		sd-vqen-gpios = <&gpio_ao GPIOE_2 GPIO_ACTIVE_HIGH>;
 		sd-vqsw-gpios = <&gpio_ao GPIOAO_6 GPIO_ACTIVE_HIGH>;
 		sd-vmmc-gpios = <&gpio_ao GPIOAO_3 GPIO_ACTIVE_HIGH>;
+		vqmmc-supply = <&tf_io>;
+		vmmc-supply = <&tflash_vdd>;
 	};

 	emmc_pwrseq: emmc-pwrseq {
--
Armbian

