From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Igor Velkov <iav@iav.lv>
Date: Wed, 14 Oct 2026 00:44:13 +0300
Subject: [PATCH] media: meson: vdec: release the FBC buffers on a format
 change

codec_hevc_setup_buffers() runs on every resume and allocates the FBC
buffers, MMU headers and MMU map without freeing those of the previous
format. codec_hevc_free_fbc_buffers() frees every FBC buffer with a
size computed from the current width, height and bit depth, which can
differ from the size the buffer was allocated with.

Record the size of each FBC buffer and free it with that size. Keep the
MMU map across resumes, its size is fixed. Free the FBC buffers and MMU
headers at the start of codec_hevc_setup_buffers() when every capture
buffer is queued: the ANC2AXI table is then rewritten for every buffer
index, so the earlier allocations are out of use. This is the case on
the resume from vdec_start_streaming(), where vb2 requires all capture
buffers to be queued. On the resume from amvdec_src_change() the
decoder may still hold buffers; on GXL and later the table rewrite
covers only the queued ones, so nothing is freed then.

Assisted-by: LLM
Signed-off-by: Igor Velkov <iav@iav.lv>
---
 .../media/meson/vdec/codec_hevc_common.c      | 40 ++++++++++++-------
 .../media/meson/vdec/codec_hevc_common.h      |  1 +
 2 files changed, 26 insertions(+), 15 deletions(-)

diff --git a/drivers/staging/media/meson/vdec/codec_hevc_common.c b/drivers/staging/media/meson/vdec/codec_hevc_common.c
index d6ed82d..6bd7831 100644
--- a/drivers/staging/media/meson/vdec/codec_hevc_common.c
+++ b/drivers/staging/media/meson/vdec/codec_hevc_common.c
@@ -203,38 +203,37 @@ static int codec_hevc_alloc_mmu_headers(struct amvdec_session *sess,
 	return 0;
 }
 
-void codec_hevc_free_fbc_buffers(struct amvdec_session *sess,
-				 struct codec_hevc_common *comm)
+static void codec_hevc_free_frame_buffers(struct amvdec_session *sess,
+					  struct codec_hevc_common *comm)
 {
 	struct device *dev = sess->core->dev;
-	u32 use_mmu;
-	u32 am21_size;
 	int i;
 
-	use_mmu = codec_hevc_use_mmu(sess->core->platform->revision,
-					 sess->pixfmt_cap,
-					 sess->bitdepth == 10 ? 1 : 0);
-
-	am21_size = amvdec_amfbc_size(sess->width, sess->height,
-					  sess->bitdepth == 10 ? 1 : 0,  use_mmu);
-
 	for (i = 0; i < MAX_REF_PIC_NUM; ++i) {
 		if (comm->fbc_buffer_vaddr[i]) {
-			dma_free_coherent(dev, am21_size,
+			dma_free_coherent(dev, comm->fbc_buffer_size[i],
 					  comm->fbc_buffer_vaddr[i],
 					  comm->fbc_buffer_paddr[i]);
 			comm->fbc_buffer_vaddr[i] = NULL;
 		}
 	}
 
+	codec_hevc_free_mmu_headers(sess, comm);
+}
+
+void codec_hevc_free_fbc_buffers(struct amvdec_session *sess,
+				 struct codec_hevc_common *comm)
+{
+	struct device *dev = sess->core->dev;
+
+	codec_hevc_free_frame_buffers(sess, comm);
+
 	if (comm->mmu_map_vaddr) {
 		dma_free_coherent(dev, MMU_MAP_SIZE,
 				  comm->mmu_map_vaddr,
 				  comm->mmu_map_paddr);
 		comm->mmu_map_vaddr = NULL;
 	}
-
-    codec_hevc_free_mmu_headers(sess, comm);
 }
 EXPORT_SYMBOL_GPL(codec_hevc_free_fbc_buffers);
 
@@ -267,6 +266,7 @@ static int codec_hevc_alloc_fbc_buffers(struct amvdec_session *sess,
 
 		comm->fbc_buffer_vaddr[idx] = vaddr;
 		comm->fbc_buffer_paddr[idx] = paddr;
+		comm->fbc_buffer_size[idx] = am21_size;
 	}
 
 	if (codec_hevc_use_mmu(revision, sess->pixfmt_cap, is_10bit) &&
@@ -287,10 +287,20 @@ int codec_hevc_setup_buffers(struct amvdec_session *sess,
 {
 	struct amvdec_core *core = sess->core;
     struct device *dev = core->dev;
+	struct vb2_queue *dst_vq = v4l2_m2m_get_dst_vq(sess->m2m_ctx);
 	int ret;
 
+	/*
+	 * With every capture buffer queued, the table rewrite below covers
+	 * every buffer index, so no earlier per-buffer allocation stays in use.
+	 */
+	if (v4l2_m2m_num_dst_bufs_ready(sess->m2m_ctx) ==
+	    vb2_get_num_buffers(dst_vq))
+		codec_hevc_free_frame_buffers(sess, comm);
+
 	if (codec_hevc_use_mmu(core->platform->revision,
-			       sess->pixfmt_cap, is_10bit)) {
+			       sess->pixfmt_cap, is_10bit) &&
+	    !comm->mmu_map_vaddr) {
 		comm->mmu_map_vaddr = dma_alloc_coherent(dev, MMU_MAP_SIZE,
 							 &comm->mmu_map_paddr,
 							 GFP_KERNEL);
diff --git a/drivers/staging/media/meson/vdec/codec_hevc_common.h b/drivers/staging/media/meson/vdec/codec_hevc_common.h
index 13f9f1d..fd96419 100644
--- a/drivers/staging/media/meson/vdec/codec_hevc_common.h
+++ b/drivers/staging/media/meson/vdec/codec_hevc_common.h
@@ -21,6 +21,7 @@ extern const u16 vdec_hevc_parser_cmd[VDEC_HEVC_PARSER_CMD_LEN];
 struct codec_hevc_common {
 	void      *fbc_buffer_vaddr[MAX_REF_PIC_NUM];
 	dma_addr_t fbc_buffer_paddr[MAX_REF_PIC_NUM];
+	u32        fbc_buffer_size[MAX_REF_PIC_NUM];
 
 	void      *mmu_header_vaddr[MAX_REF_PIC_NUM];
 	dma_addr_t mmu_header_paddr[MAX_REF_PIC_NUM];
