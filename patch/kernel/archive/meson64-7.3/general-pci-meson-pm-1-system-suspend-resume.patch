From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Igor Velkov <iav@iav.lv>
Date: Sat, 19 Sep 2026 02:54:51 +0000
Subject: PCI: meson: Add system suspend/resume support

On SM1 the controller sits in the PCIE power domain, which genpd
switches off in the noirq suspend phase.  The driver has no PM
callbacks, so the controller comes back unprogrammed and the first
config access to the Root Port after resume hangs the CPU.  On
ODROID-HC4 (ASM1061 SATA behind the port) s2idle never returns.

Add noirq callbacks.  Suspend asserts PERST#, stops the LTSSM and powers
the PHY off; genpd then cuts the domain.  Resume repeats the probe
sequence (PHY power on, PHY and controller reset) and hands over to
dw_pcie_resume_noirq() to program the Root Complex, MSI and iATU
registers and restart the link.

dw_pcie_suspend_noirq() is not used: it broadcasts PME_Turn_Off through a
MSG TLP window this controller does not have and fails with -ENOSPC, which
aborts the noirq suspend phase for the whole system.

Add a stop_link callback so that host deinit and a failed resume also
disable the LTSSM.

Signed-off-by: Igor Velkov <iav@iav.lv>
---
 drivers/pci/controller/dwc/pci-meson.c | 54 ++++++++++
 1 file changed, 54 insertions(+)

diff --git a/drivers/pci/controller/dwc/pci-meson.c b/drivers/pci/controller/dwc/pci-meson.c
index 2020672cfbc9..ae326fa1adca 100644
--- a/drivers/pci/controller/dwc/pci-meson.c
+++ b/drivers/pci/controller/dwc/pci-meson.c
@@ -295,10 +295,20 @@ static int meson_pcie_start_link(struct dw_pcie *pci)
 	meson_pcie_assert_reset(mp);
 
 	return 0;
 }
 
+static void meson_pcie_stop_link(struct dw_pcie *pci)
+{
+	struct meson_pcie *mp = to_meson_pcie(pci);
+	u32 val;
+
+	val = meson_cfg_readl(mp, PCIE_CFG0);
+	val &= ~APP_LTSSM_ENABLE;
+	meson_cfg_writel(mp, val, PCIE_CFG0);
+}
+
 static int meson_pcie_rd_own_conf(struct pci_bus *bus, u32 devfn,
 				  int where, int size, u32 *val)
 {
 	int ret;
 
@@ -355,10 +365,11 @@ static const struct dw_pcie_host_ops meson_pcie_host_ops = {
 };
 
 static const struct dw_pcie_ops dw_pcie_ops = {
 	.link_up = meson_pcie_link_up,
 	.start_link = meson_pcie_start_link,
+	.stop_link = meson_pcie_stop_link,
 };
 
 static int meson_pcie_probe(struct platform_device *pdev)
 {
 	struct device *dev = &pdev->dev;
@@ -439,10 +450,52 @@ static void meson_pcie_remove(struct platform_device *pdev)
 
 	dw_pcie_host_deinit(&mp->pci.pp);
 	meson_pcie_power_off(mp);
 }
 
+static int meson_pcie_suspend_noirq(struct device *dev)
+{
+	struct meson_pcie *mp = dev_get_drvdata(dev);
+	struct dw_pcie *pci = &mp->pci;
+
+	/* Hold the endpoint in PERST# until resume restarts the link */
+	gpiod_set_value_cansleep(mp->reset_gpio, 1);
+	dw_pcie_stop_link(pci);
+	meson_pcie_power_off(mp);
+
+	/*
+	 * Genpd powers the domain off, so resume rebuilds the root complex;
+	 * dw_pcie_suspend_noirq() needs a MSG TLP window this controller lacks.
+	 */
+	pci->suspended = true;
+
+	return 0;
+}
+
+static int meson_pcie_resume_noirq(struct device *dev)
+{
+	struct meson_pcie *mp = dev_get_drvdata(dev);
+	int ret;
+
+	ret = meson_pcie_power_on(mp);
+	if (ret) {
+		dev_err(dev, "phy power on failed, %d\n", ret);
+		return ret;
+	}
+
+	ret = meson_pcie_reset(mp);
+	if (ret) {
+		dev_err(dev, "reset failed, %d\n", ret);
+		return ret;
+	}
+
+	return dw_pcie_resume_noirq(&mp->pci);
+}
+
+static DEFINE_NOIRQ_DEV_PM_OPS(meson_pcie_pm_ops, meson_pcie_suspend_noirq,
+			       meson_pcie_resume_noirq);
+
 static const struct of_device_id meson_pcie_of_match[] = {
 	{
 		.compatible = "amlogic,axg-pcie",
 	},
 	{
@@ -456,10 +509,11 @@ static struct platform_driver meson_pcie_driver = {
 	.probe = meson_pcie_probe,
 	.remove = meson_pcie_remove,
 	.driver = {
 		.name = "meson-pcie",
 		.of_match_table = meson_pcie_of_match,
+		.pm = pm_sleep_ptr(&meson_pcie_pm_ops),
 	},
 };
 
 module_platform_driver(meson_pcie_driver);
 
