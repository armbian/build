From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: SuperKali <hello@superkali.me>
Date: Thu, 19 Nov 2026 21:22:48 +0100
Subject: leds: ws2812b: lengthen the reset and turn the strip off on unbind

WS2812B-V5 parts need more than 280 us of low time to latch a frame, the
18 byte prefix gave about 50 us at 2.85 MHz. Unbind also refused the
LED_OFF request sent while unregistering, so the strip stayed lit.
Use a 100 byte prefix and unregister the LEDs before refusing updates.

Signed-off-by: SuperKali <hello@superkali.me>
---
 drivers/leds/rgb/leds-ws2812b.c | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/drivers/leds/rgb/leds-ws2812b.c b/drivers/leds/rgb/leds-ws2812b.c
index 111111111111..222222222222 100644
--- a/drivers/leds/rgb/leds-ws2812b.c
+++ b/drivers/leds/rgb/leds-ws2812b.c
@@ -24,8 +24,8 @@
 
 #define WS2812B_BYTES_PER_COLOR 3
 #define WS2812B_NUM_COLORS 3
-/* A continuous 0 for 50us+ as the 'reset' signal */
-#define WS2812B_RESET_LEN 18
+/* A continuous 0 for 280us+ as the 'reset' signal, at up to 2.85 MHz */
+#define WS2812B_RESET_LEN 100
 
 struct ws2812b_led {
 	struct led_classdev_mc mc_cdev;
@@ -353,9 +353,9 @@ static int ws2812b_probe(struct spi_device *spi)
 
 	return 0;
 ERR_UNREG_LEDS:
-	ws2812b_mark_removing(priv);
 	while (cur_led--)
 		led_classdev_multicolor_unregister(&priv->leds[cur_led].mc_cdev);
+	ws2812b_mark_removing(priv);
 	flush_workqueue(priv->flush_wq);
 	destroy_workqueue(priv->flush_wq);
 ERR_DESTROY_MUTEX:
@@ -371,9 +371,10 @@ static void ws2812b_remove(struct spi_device *spi)
 	struct ws2812b_priv *priv = spi_get_drvdata(spi);
 	int cur_led;
 
-	ws2812b_mark_removing(priv);
+	/* Unregistering turns the LEDs off, so queue that frame before refusing updates */
 	for (cur_led = priv->num_leds - 1; cur_led >= 0; cur_led--)
 		led_classdev_multicolor_unregister(&priv->leds[cur_led].mc_cdev);
+	ws2812b_mark_removing(priv);
 	flush_workqueue(priv->flush_wq);
 	destroy_workqueue(priv->flush_wq);
 	kfree(priv->tx_buf);
-- 
