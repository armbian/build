From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Xilin Wu <sophon@radxa.com>
Date: Mon, 8 Jun 2026 17:23:59 +0800
Subject: arm64: dts: qcom: qcs6490-radxa-dragon-q6a: Switch to use Iris HFI
 Gen2 firmware

The HFI Gen2 firmware used on this platform is larger than the original
video firmware carveout, so replace the original 5 MiB video region with
a 7 MiB region.

Also add the Iris IOVA reservation and pass both the firmware carveout and the
IOVA reservation to the video codec node.

Signed-off-by: Xilin Wu <sophon@radxa.com>
(cherry picked from commit b1446e9db4e8ac1de3b2179447286ed1442af87a)
---
 arch/arm64/boot/dts/qcom/qcs6490-radxa-dragon-q6a.dts | 17 +++++++---
 1 file changed, 12 insertions(+), 5 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/qcs6490-radxa-dragon-q6a.dts b/arch/arm64/boot/dts/qcom/qcs6490-radxa-dragon-q6a.dts
index 111111111111..222222222222 100644
--- a/arch/arm64/boot/dts/qcom/qcs6490-radxa-dragon-q6a.dts
+++ b/arch/arm64/boot/dts/qcom/qcs6490-radxa-dragon-q6a.dts
@@ -204,6 +204,11 @@ cdsp_secure_heap_mem: cdsp-secure-heap@82700000 {
 			no-map;
 		};
 
+		video_mem: video@85b00000 {
+			reg = <0x0 0x85b00000 0x0 0x700000>;
+			no-map;
+		};
+
 		adsp_mem: adsp@8b800000 {
 			reg = <0x0 0x8b800000 0x0 0x2800000>;
 			no-map;
@@ -214,11 +219,6 @@ cdsp_mem: cdsp@8e000000 {
 			no-map;
 		};
 
-		video_mem: video@8fe00000 {
-			reg = <0x0 0x8fe00000 0x0 0x500000>;
-			no-map;
-		};
-
 		gpu_zap_mem: zap@90300000 {
 			reg = <0x0 0x90300000 0x0 0x5000>;
 			no-map;
@@ -248,6 +248,10 @@ adsp_rpc_remote_heap_mem: adsp-rpc-remote-heap@c6500000 {
 			reg = <0x0 0xc6500000 0x0 0x800000>;
 			no-map;
 		};
+
+		iris_iova: iris-iova {
+			iommu-addresses = <&venus 0x0 0x0 0x0 0x25800000>;
+		};
 	};
 
 	thermal-zones {
@@ -1208,6 +1212,9 @@ &usb_2_hsphy {
 };
 
 &venus {
+	firmware-name = "qcom/vpu/vpu20_p1_gen2_s6.mbn";
+	memory-region = <&video_mem>, <&iris_iova>;
+
 	status = "okay";
 };
 
-- 
Armbian

