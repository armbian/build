From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: SuperKali <hello@superkali.me>
Date: Thu, 19 Nov 2026 15:39:19 +0100
Subject: arm64: dts: qcom: kodiak: point the i2c19 alias at cci1_i2c1

The cci alias commit maps both i2c18 and i2c19 to cci1_i2c0, so the second CCI1 bus never gets a fixed number. Point i2c19 at cci1_i2c1.

Signed-off-by: SuperKali <hello@superkali.me>
---
 arch/arm64/boot/dts/qcom/kodiak.dtsi | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/qcom/kodiak.dtsi b/arch/arm64/boot/dts/qcom/kodiak.dtsi
index 111111111111..222222222222 100644
--- a/arch/arm64/boot/dts/qcom/kodiak.dtsi
+++ b/arch/arm64/boot/dts/qcom/kodiak.dtsi
@@ -60,7 +60,7 @@ aliases {
 		i2c16 = &cci0_i2c0;
 		i2c17 = &cci0_i2c1;
 		i2c18 = &cci1_i2c0;
-		i2c19 = &cci1_i2c0;
+		i2c19 = &cci1_i2c1;
 		mmc1 = &sdhc_1;
 		mmc2 = &sdhc_2;
 		spi0 = &spi0;
-- 
Armbian

