+	if (csi->plugin_det_gpio || csi->rk628->version < RK628F_VERSION)
+		return false;
+	if (rk628_i2c_read(csi->rk628, HDMI_RX_HDMI_CKM_RESULT, &val))
+		return false;
+
+	return !(val & GENMASK(15, 0));
