From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jiali Chen <chenjiali@radxa.com>
Date: Wed, 6 May 2026 19:59:35 +0800
Subject: arm64: dts: qcom: radxa-dragon-q6a: add hardware version detection

Rework PM7325 GPIO pinctrl for hardware version selection. Add
gpio-line-names, hardware_version_sel pin configuration, and
hardware_version_adc VADC channel for board revision identification.

Signed-off-by: Jiali Chen <chenjiali@radxa.com>
(cherry picked from commit 77a1fde63681072c0a9321799c02cfb147470b34)
---
 arch/arm64/boot/dts/qcom/qcs6490-radxa-dragon-q6a.dts | 28 ++++++++--
 1 file changed, 23 insertions(+), 5 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/qcs6490-radxa-dragon-q6a.dts b/arch/arm64/boot/dts/qcom/qcs6490-radxa-dragon-q6a.dts
index 111111111111..222222222222 100644
--- a/arch/arm64/boot/dts/qcom/qcs6490-radxa-dragon-q6a.dts
+++ b/arch/arm64/boot/dts/qcom/qcs6490-radxa-dragon-q6a.dts
@@ -669,10 +669,24 @@ &pcie1_port0 {
 };
 
 &pm7325_gpios {
-	pm7325_adc_default: adc-default-state {
-		pins = "gpio2";
+	pinctrl-0 = <&hardware_version_sel>;
+	pinctrl-names = "default";
+	gpio-line-names = "",	/* GPIO_01 */
+			  "UFS_THERM",
+			  "Version_ADC",
+			  "",
+			  "",
+			  "KYPD_VOL_UP_N",
+			  "Version_SEL",
+			  "",
+			  "MICRO USB DET",
+			  "";
+
+	hardware_version_sel: hardware-version-sel-state {
+		pins = "gpio7";
 		function = PMIC_GPIO_FUNC_NORMAL;
 		bias-high-impedance;
+		power-source = <1>;
 	};
 };
 
@@ -714,9 +728,6 @@ ufs-therm@3 {
 };
 
 &pmk8350_vadc {
-	pinctrl-0 = <&pm7325_adc_default>;
-	pinctrl-names = "default";
-
 	channel@3 {
 		reg = <PMK8350_ADC7_DIE_TEMP>;
 		label = "pmk7325_die_temp";
@@ -737,6 +748,13 @@ channel@103 {
 		qcom,pre-scaling = <1 1>;
 	};
 
+	channel@10b {
+		reg = <PM7325_ADC7_GPIO2>;
+		qcom,hw-settle-time = <200>;
+		qcom,pre-scaling = <1 1>;
+		label = "hardware_version_adc";
+	};
+
 	channel@144 {
 		reg = <PM7325_ADC7_AMUX_THM1_100K_PU>;
 		qcom,ratiometric;
-- 
Armbian

