From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: SuperKali <hello@superkali.me>
Date: Thu, 19 Nov 2026 21:22:48 +0100
Subject: drm/panel: ota7290b: fix the reset polarity, unprepare and size

The driver left reset logically asserted while the panel ran, and the
overlay declared the line active high to make that work. Describe the
line as active low and flip the logic, which keeps the same levels on
the wire. Also return a failed power off from unprepare and report the
135 x 217 mm active area the mode already uses.

Signed-off-by: SuperKali <hello@superkali.me>
---
 drivers/gpu/drm/panel/panel-orisetech-ota7290b.c | 14 +++++-----
 1 file changed, 7 insertions(+), 7 deletions(-)

diff --git a/drivers/gpu/drm/panel/panel-orisetech-ota7290b.c b/drivers/gpu/drm/panel/panel-orisetech-ota7290b.c
index 111111111111..222222222222 100644
--- a/drivers/gpu/drm/panel/panel-orisetech-ota7290b.c
+++ b/drivers/gpu/drm/panel/panel-orisetech-ota7290b.c
@@ -53,12 +53,12 @@ static int ota7290b_power_on(struct ota7290b_panel *ctx)
 		return ret;
 	}
 
-	gpiod_set_value(ctx->reset_gpio, 1);
-	usleep_range(100000, 200000);
 	gpiod_set_value(ctx->reset_gpio, 0);
 	usleep_range(100000, 200000);
 	gpiod_set_value(ctx->reset_gpio, 1);
 	usleep_range(100000, 200000);
+	gpiod_set_value(ctx->reset_gpio, 0);
+	usleep_range(100000, 200000);
 
 	return 0;
 }
@@ -68,7 +68,7 @@ static int ota7290b_power_off(struct ota7290b_panel *ctx)
 	struct mipi_dsi_device *dsi = ctx->dsi;
 	int ret = 0;
 
-	gpiod_set_value(ctx->reset_gpio, 0);
+	gpiod_set_value(ctx->reset_gpio, 1);
 
 	ret = regulator_bulk_disable(ARRAY_SIZE(ctx->supplies), ctx->supplies);
 	if (ret)
@@ -143,7 +143,7 @@ static int ota7290b_panel_unprepare(struct drm_panel *panel)
 	if (ret < 0)
 		dev_err(&dsi->dev, "power off failed: %d\n", ret);
 
-	return 0;
+	return ret;
 }
 
 static const struct drm_display_mode radxa_display_10fhd_ad003_1200x1920 = {
@@ -165,8 +165,8 @@ static const struct drm_display_mode radxa_display_10fhd_ad003_1200x1920 = {
 
 static const struct panel_desc radxa_display_10fhd_ad003_desc = {
 	.display_mode = &radxa_display_10fhd_ad003_1200x1920,
-	.width_mm = 74,
-	.height_mm = 131,
+	.width_mm = 135,
+	.height_mm = 217,
 	.mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_BURST | MIPI_DSI_MODE_NO_EOT_PACKET,
 	.format = MIPI_DSI_FMT_RGB888,
 	.lanes = 4,
@@ -224,7 +224,7 @@ static int ota7290b_panel_probe(struct mipi_dsi_device *dsi)
 	if (ret < 0)
 		return ret;
 
-	ctx->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_LOW);
+	ctx->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
 	if (IS_ERR(ctx->reset_gpio))
 		return dev_err_probe(dev, PTR_ERR(ctx->reset_gpio), "Failed to get reset-gpios\n");
 
-- 
