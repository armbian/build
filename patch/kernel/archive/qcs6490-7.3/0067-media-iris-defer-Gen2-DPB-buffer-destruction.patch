From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Junhao Xie <bigfoot@radxa.com>
Date: Wed, 12 Aug 2026 11:34:22 +0800
Subject: media: iris: defer Gen2 DPB buffer destruction

Keep released Gen2 DPB buffers until the deferred release path.
Avoid destroying buffers still referenced by firmware during streamoff.

Signed-off-by: Junhao Xie <bigfoot@radxa.com>
(cherry picked from commit fe41e5e55fbe84f60d0360210b21366c268871a9)
---
 drivers/media/platform/qcom/iris/iris_buffer.c            | 9 +++------
 drivers/media/platform/qcom/iris/iris_hfi_gen2_response.c | 4 ++++
 2 files changed, 7 insertions(+), 6 deletions(-)

diff --git a/drivers/media/platform/qcom/iris/iris_buffer.c b/drivers/media/platform/qcom/iris/iris_buffer.c
index 111111111111..222222222222 100644
--- a/drivers/media/platform/qcom/iris/iris_buffer.c
+++ b/drivers/media/platform/qcom/iris/iris_buffer.c
@@ -671,12 +671,9 @@ static int iris_destroy_internal_buffers(struct iris_inst *inst, u32 plane, bool
 	for (i = 0; i < len; i++) {
 		buffers = &inst->buffers[internal_buf_type[i]];
 		list_for_each_entry_safe(buf, next, &buffers->list, list) {
-			/*
-			 * during stream on, skip destroying internal(DPB) buffer
-			 * if firmware did not return it.
-			 * during close, destroy all buffers irrespectively.
-			 */
-			if (!force && buf->attr & BUF_ATTR_QUEUED)
+			if (!force && (buf->attr & BUF_ATTR_QUEUED ||
+			    (buf->type == BUF_DPB &&
+			     buf->attr & BUF_ATTR_PENDING_RELEASE)))
 				continue;
 
 			iris_destroy_internal_buffer(inst, buf);
diff --git a/drivers/media/platform/qcom/iris/iris_hfi_gen2_response.c b/drivers/media/platform/qcom/iris/iris_hfi_gen2_response.c
index 111111111111..222222222222 100644
--- a/drivers/media/platform/qcom/iris/iris_hfi_gen2_response.c
+++ b/drivers/media/platform/qcom/iris/iris_hfi_gen2_response.c
@@ -448,6 +448,10 @@ static int iris_hfi_gen2_handle_release_internal_buffer(struct iris_inst *inst,
 		return -EINVAL;
 
 	buf->attr &= ~BUF_ATTR_QUEUED;
+	if (buf->type == BUF_DPB) {
+		buf->attr |= BUF_ATTR_PENDING_RELEASE;
+		return 0;
+	}
 
 	iris_destroy_internal_buffer(inst, buf);
 
-- 
Armbian

