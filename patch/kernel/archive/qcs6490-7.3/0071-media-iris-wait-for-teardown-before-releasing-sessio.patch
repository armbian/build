From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Junhao Xie <bigfoot@radxa.com>
Date: Wed, 12 Aug 2026 11:44:08 +0800
Subject: media: iris: wait for teardown before releasing sessions

Wait for core error cleanup before stopping or releasing V4L2 sessions.

Signed-off-by: Junhao Xie <bigfoot@radxa.com>
(cherry picked from commit 6198771c71357a4e14381f72f7deee5bb0f7f6e8)
---
 drivers/media/platform/qcom/iris/iris_vb2.c  | 7 ++++++-
 drivers/media/platform/qcom/iris/iris_vidc.c | 1 +
 2 files changed, 7 insertions(+), 1 deletion(-)

diff --git a/drivers/media/platform/qcom/iris/iris_vb2.c b/drivers/media/platform/qcom/iris/iris_vb2.c
index 111111111111..222222222222 100644
--- a/drivers/media/platform/qcom/iris/iris_vb2.c
+++ b/drivers/media/platform/qcom/iris/iris_vb2.c
@@ -230,6 +230,7 @@ void iris_vb2_stop_streaming(struct vb2_queue *q)
 	int ret = 0;
 
 	inst = vb2_get_drv_priv(q);
+	iris_wait_for_sys_error(inst->core);
 
 	if (V4L2_TYPE_IS_CAPTURE(q->type) && inst->state == IRIS_INST_INIT)
 		return;
@@ -241,8 +242,12 @@ void iris_vb2_stop_streaming(struct vb2_queue *q)
 		goto exit;
 
 	ret = iris_session_streamoff(inst, q->type);
-	if (ret)
+	if (ret) {
+		mutex_unlock(&inst->lock);
+		iris_core_deinit_on_error(inst->core);
+		mutex_lock(&inst->lock);
 		goto exit;
+	}
 
 exit:
 	iris_helper_buffers_done(inst, q->type, VB2_BUF_STATE_ERROR);
diff --git a/drivers/media/platform/qcom/iris/iris_vidc.c b/drivers/media/platform/qcom/iris/iris_vidc.c
index 111111111111..222222222222 100644
--- a/drivers/media/platform/qcom/iris/iris_vidc.c
+++ b/drivers/media/platform/qcom/iris/iris_vidc.c
@@ -288,6 +288,7 @@ int iris_close(struct file *filp)
 {
 	struct iris_inst *inst = iris_get_inst(filp);
 
+	iris_wait_for_sys_error(inst->core);
 	v4l2_ctrl_handler_free(&inst->ctrl_handler);
 	v4l2_m2m_ctx_release(inst->m2m_ctx);
 	v4l2_m2m_release(inst->m2m_dev);
-- 
Armbian

