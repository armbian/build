+static int rk628_cru_pll_wait_lock(struct rk628 *rk628, u32 reg)
+{
+	u32 val = 0;
+	int ret, err;
+
+	ret = read_poll_timeout(rk628_i2c_read, err, err || (val & PLL_LOCK),
