+/* Compute the MIPI PLL dividers for fhsc Mbps and return the resulting rate. */
+static unsigned int rk628_combtxphy_mipi_pll(struct rk628_combtxphy *txphy,
+					     unsigned int fhsc)
+{
+	unsigned int fvco, frac_rate, fin = 24;
+
+	if (fhsc < 375)
+		txphy->rate_div = 4;
+	else if (fhsc < 750)
+		txphy->rate_div = 2;
+	else
+		txphy->rate_div = 1;
+
+	fvco = fhsc * 2 * txphy->rate_div;
+	txphy->ref_div = 1;
+	txphy->fb_div = fvco / 8 / fin;
+	frac_rate = fvco - (fin * 8 * txphy->fb_div);
+	if (frac_rate) {
+		frac_rate <<= 10;
+		frac_rate /= fin * 8;
+		txphy->frac_div = frac_rate;
+	} else {
+		txphy->frac_div = 0;
+	}
+
+	fvco = fin * (1024 * txphy->fb_div + txphy->frac_div);
+	fvco *= 8;
+	fvco = DIV_ROUND_UP(fvco, 1024 * txphy->ref_div);
+
+	return fvco / 2 / txphy->rate_div;
+}
+
+u32 rk628_txphy_mipi_rate_mbps(u32 mbps)
+{
+	struct rk628_combtxphy txphy = {};
+	unsigned int fhsc = 24 * (mbps / 24);
+
+	if (fhsc < 80 || fhsc > 2000)
+		return mbps;
+
+	return rk628_combtxphy_mipi_pll(&txphy, fhsc);
+}
+EXPORT_SYMBOL(rk628_txphy_mipi_rate_mbps);
