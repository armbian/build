From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Xilin Wu <sophon@radxa.com>
Date: Sat, 27 Dec 2025 14:23:26 +0800
Subject: arm64: dts: qcom: qcs6490-radxa-dragon-q6a: Update pcie1 iommu-map

Define more iommu-map entries to allow some PCIe devices with complex bus topologies to work

[SuperKali: rebased on Linux 7.3]
Signed-off-by: Xilin Wu <sophon@radxa.com>
(cherry picked from commit f6bcccb092126651edc27bfa62f0369e766a295b)
---
 arch/arm64/boot/dts/qcom/qcs6490-radxa-dragon-q6a.dts | 38 +++++++---
 1 file changed, 29 insertions(+), 9 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/qcs6490-radxa-dragon-q6a.dts b/arch/arm64/boot/dts/qcom/qcs6490-radxa-dragon-q6a.dts
index 111111111111..222222222222 100644
--- a/arch/arm64/boot/dts/qcom/qcs6490-radxa-dragon-q6a.dts
+++ b/arch/arm64/boot/dts/qcom/qcs6490-radxa-dragon-q6a.dts
@@ -622,16 +622,36 @@ &pcie1 {
 	pinctrl-0 = <&pcie1_clkreq_n>, <&pcie1_reset_n>, <&pcie1_wake_n>;
 	pinctrl-names = "default";
 
-	/* Support for QPS615 PCIe switch */
+	/*
+	* Support for many different bus topologies
+	* Tested devices:
+	* - QPS615 PCIe switch
+	* - ASM1182e PCIe switch
+	* - ASM2824 PCIe switch
+	* - NVIDIA dGPU
+	* - Chelsio T520-CR
+	*/
 	iommu-map = <0x0 &apps_smmu 0x1c80 0x0 0x1>,
-		    <0x100 &apps_smmu 0x1c81 0x0 0x1>,
-		    <0x208 &apps_smmu 0x1c84 0x0 0x1>,
-		    <0x210 &apps_smmu 0x1c85 0x0 0x1>,
-		    <0x218 &apps_smmu 0x1c86 0x0 0x1>,
-		    <0x300 &apps_smmu 0x1c87 0x0 0x1>,
-		    <0x400 &apps_smmu 0x1c88 0x0 0x1>,
-		    <0x500 &apps_smmu 0x1c89 0x0 0x1>,
-		    <0x501 &apps_smmu 0x1c90 0x0 0x1>;
+		    <0x100 &apps_smmu 0x1c80 0x0 0x1>,
+		    <0x101 &apps_smmu 0x1c80 0x0 0x1>,
+		    <0x102 &apps_smmu 0x1c80 0x0 0x1>,
+		    <0x103 &apps_smmu 0x1c80 0x0 0x1>,
+		    <0x104 &apps_smmu 0x1c80 0x0 0x1>,
+		    <0x105 &apps_smmu 0x1c80 0x0 0x1>,
+		    <0x106 &apps_smmu 0x1c80 0x0 0x1>,
+		    <0x200 &apps_smmu 0x1c80 0x0 0x1>,
+		    <0x208 &apps_smmu 0x1c80 0x0 0x1>,
+		    <0x210 &apps_smmu 0x1c80 0x0 0x1>,
+		    <0x218 &apps_smmu 0x1c80 0x0 0x1>,
+		    <0x220 &apps_smmu 0x1c80 0x0 0x1>,
+		    <0x238 &apps_smmu 0x1c80 0x0 0x1>,
+		    <0x240 &apps_smmu 0x1c80 0x0 0x1>,
+		    <0x260 &apps_smmu 0x1c80 0x0 0x1>,
+		    <0x300 &apps_smmu 0x1c80 0x0 0x1>,
+		    <0x400 &apps_smmu 0x1c80 0x0 0x1>,
+		    <0x500 &apps_smmu 0x1c80 0x0 0x1>,
+		    <0x501 &apps_smmu 0x1c80 0x0 0x1>,
+		    <0x600 &apps_smmu 0x1c80 0x0 0x1>;
 
 	status = "okay";
 };
-- 
