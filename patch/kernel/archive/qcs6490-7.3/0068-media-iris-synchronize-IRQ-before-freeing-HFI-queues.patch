From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Junhao Xie <bigfoot@radxa.com>
Date: Wed, 12 Aug 2026 11:39:37 +0800
Subject: media: iris: synchronize IRQ before freeing HFI queues

Wait for the threaded IRQ handler after powering down the device.
This prevents response handling from accessing freed HFI queue memory.

[SuperKali: rebased on Linux 7.3]
Signed-off-by: Junhao Xie <bigfoot@radxa.com>
(cherry picked from commit a5ca5d13e5389817bcaf6ac744efde096cb3475b)
---
 drivers/media/platform/qcom/iris/iris_core.c | 11 ++++++++--
 1 file changed, 9 insertions(+), 2 deletions(-)

diff --git a/drivers/media/platform/qcom/iris/iris_core.c b/drivers/media/platform/qcom/iris/iris_core.c
index 111111111111..222222222222 100644
--- a/drivers/media/platform/qcom/iris/iris_core.c
+++ b/drivers/media/platform/qcom/iris/iris_core.c
@@ -3,6 +3,7 @@
  * Copyright (c) 2022-2024 Qualcomm Innovation Center, Inc. All rights reserved.
  */
 
+#include <linux/interrupt.h>
 #include <linux/pm_runtime.h>
 
 #include "iris_core.h"
@@ -22,9 +23,15 @@ void iris_core_deinit(struct iris_core *core)
 
 		if (!ret)
 			iris_vpu_power_off(core);
+		mutex_unlock(&core->lock);
 
-		iris_hfi_queues_deinit(core);
-		core->state = IRIS_CORE_DEINIT;
+		synchronize_irq(core->irq);
+
+		mutex_lock(&core->lock);
+		if (core->state != IRIS_CORE_DEINIT) {
+			iris_hfi_queues_deinit(core);
+			core->state = IRIS_CORE_DEINIT;
+		}
 	}
 	mutex_unlock(&core->lock);
 
-- 
Armbian

