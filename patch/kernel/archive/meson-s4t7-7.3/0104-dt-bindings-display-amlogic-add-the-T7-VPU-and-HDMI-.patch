From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Igor Pecovnik <igor@armbian.com>
Date: Tue, 13 Oct 2026 18:34:02 +0000
Subject: [PATCH 104/107] dt-bindings: display: amlogic: add the T7 VPU and
 HDMI transmitter

Add the amlogic,meson-t7-vpu compatible and the binding of the T7 HDMI
2.1 transmitter, which is not a DesignWare core.

Signed-off-by: Igor Pecovnik <igor@armbian.com>
---
 .../display/amlogic,meson-t7-hdmi-tx.yaml     | 124 ++++++++++++++++++
 .../bindings/display/amlogic,meson-vpu.yaml   |  45 +++++--
 2 files changed, 160 insertions(+), 9 deletions(-)
 create mode 100644 Documentation/devicetree/bindings/display/amlogic,meson-t7-hdmi-tx.yaml

diff --git a/Documentation/devicetree/bindings/display/amlogic,meson-t7-hdmi-tx.yaml b/Documentation/devicetree/bindings/display/amlogic,meson-t7-hdmi-tx.yaml
new file mode 100644
index 000000000..543187f9f
--- /dev/null
+++ b/Documentation/devicetree/bindings/display/amlogic,meson-t7-hdmi-tx.yaml
@@ -0,0 +1,124 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/display/amlogic,meson-t7-hdmi-tx.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Amlogic T7 HDMI 2.1 Transmitter
+
+maintainers:
+  - Igor Pecovnik <igor@armbian.com>
+
+description: |
+  The HDMI transmitter of the Amlogic T7 SoC. It is not a Synopsys DesignWare
+  core. It has a TOP block with 32-bit registers and a COR block with 8-bit
+  registers. The video encoder (VENC) of the VPU feeds it, see
+  amlogic,meson-vpu.yaml. The HDMI PHY registers are in the analog control
+  block, which the VPU node describes.
+
+properties:
+  compatible:
+    const: amlogic,t7-hdmi-tx
+
+  reg:
+    items:
+      - description: TOP registers
+      - description: COR registers
+
+  reg-names:
+    items:
+      - const: top
+      - const: cor
+
+  interrupts:
+    maxItems: 1
+
+  clocks:
+    items:
+      - description: APB bus clock
+
+  clock-names:
+    items:
+      - const: pclk
+
+  resets:
+    items:
+      - description: HDMI TX controller reset
+      - description: HDMI TX PHY reset
+
+  reset-names:
+    items:
+      - const: hdmitx
+      - const: phy
+
+  power-domains:
+    maxItems: 1
+
+  "#sound-dai-cells":
+    const: 0
+
+  ports:
+    $ref: /schemas/graph.yaml#/properties/ports
+
+    properties:
+      port@0:
+        $ref: /schemas/graph.yaml#/properties/port
+        description: Input from the VPU HDMI-TX port.
+
+      port@1:
+        $ref: /schemas/graph.yaml#/properties/port
+        description: Output to the HDMI connector.
+
+    required:
+      - port@0
+      - port@1
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - interrupts
+  - clocks
+  - clock-names
+  - power-domains
+  - ports
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/interrupt-controller/arm-gic.h>
+
+    hdmi-tx@fe300000 {
+        compatible = "amlogic,t7-hdmi-tx";
+        reg = <0xfe300000 0x10000>, <0xfe380000 0x10000>;
+        reg-names = "top", "cor";
+        interrupts = <GIC_SPI 204 IRQ_TYPE_LEVEL_HIGH>;
+        clocks = <&clkc_periphs 194>;
+        clock-names = "pclk";
+        resets = <&reset 29>, <&reset 22>;
+        reset-names = "hdmitx", "phy";
+        power-domains = <&pwrc 14>;
+        #sound-dai-cells = <0>;
+
+        ports {
+            #address-cells = <1>;
+            #size-cells = <0>;
+
+            port@0 {
+                reg = <0>;
+
+                hdmi_tx_in: endpoint {
+                    remote-endpoint = <&vpu_hdmi_out>;
+                };
+            };
+
+            port@1 {
+                reg = <1>;
+
+                hdmi_tx_out: endpoint {
+                    remote-endpoint = <&hdmi_connector_in>;
+                };
+            };
+        };
+    };
diff --git a/Documentation/devicetree/bindings/display/amlogic,meson-vpu.yaml b/Documentation/devicetree/bindings/display/amlogic,meson-vpu.yaml
index 48327a869..8e6d369da 100644
--- a/Documentation/devicetree/bindings/display/amlogic,meson-vpu.yaml
+++ b/Documentation/devicetree/bindings/display/amlogic,meson-vpu.yaml
@@ -66,6 +66,7 @@ properties:
       - enum:
           - amlogic,meson-g12a-vpu # G12A (S905X2, S905Y2, S905D2)
           - amlogic,meson-s4-vpu # S4 (S905Y4)
+          - amlogic,meson-t7-vpu # T7 (A311D2)
 
   reg:
     minItems: 2
@@ -76,9 +77,11 @@ properties:
     maxItems: 5
 
   clocks:
+    minItems: 1
     maxItems: 2
 
   clock-names:
+    minItems: 1
     maxItems: 2
 
   interrupts:
@@ -128,7 +131,9 @@ allOf:
       properties:
         compatible:
           contains:
-            const: amlogic,meson-s4-vpu
+            enum:
+              - amlogic,meson-s4-vpu
+              - amlogic,meson-t7-vpu
     then:
       properties:
         reg:
@@ -145,14 +150,6 @@ allOf:
             - const: clkctrl
             - const: pwrctrl
             - const: sysctrl
-        clocks:
-          items:
-            - description: vpu clock
-            - description: vapb clock
-        clock-names:
-          items:
-            - const: vpu
-            - const: vapb
     else:
       properties:
         reg:
@@ -166,6 +163,36 @@ allOf:
         clocks: false
         clock-names: false
 
+  - if:
+      properties:
+        compatible:
+          contains:
+            const: amlogic,meson-s4-vpu
+    then:
+      properties:
+        clocks:
+          items:
+            - description: vpu clock
+            - description: vapb clock
+        clock-names:
+          items:
+            - const: vpu
+            - const: vapb
+
+  - if:
+      properties:
+        compatible:
+          contains:
+            const: amlogic,meson-t7-vpu
+    then:
+      properties:
+        clocks:
+          items:
+            - description: VPU interrupt and register clock gate
+        clock-names:
+          items:
+            - const: intr
+
 additionalProperties: false
 
 examples:
