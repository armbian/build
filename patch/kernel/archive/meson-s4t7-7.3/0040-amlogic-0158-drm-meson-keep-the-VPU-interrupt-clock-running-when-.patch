From e3333f0bcd6cecbf287d9023058a3780e5fc7db8 Mon Sep 17 00:00:00 2001
From: Christian Hewitt <christianshewitt@gmail.com>
Date: Sun, 27 Sep 2026 13:21:23 +0000
Subject: [PATCH 158/210] drm/meson: keep the VPU interrupt clock running when
 vsync is off

Disabling vsync gates HHI_GCLK_MPEG2 bit 25 directly. That bit is the
VPU interrupt clock gate, which is managed by the clock framework and is
also needed by other VPU blocks such as the deinterlacer, so writing it
behind the framework stops their interrupts too.

Mask vsync in the encoder only. The DRM core already ignores vblank
interrupts that arrive while vblank is disabled.

Assisted-by: Claude:claude-opus-5-5
Signed-off-by: Christian Hewitt <christianshewitt@gmail.com>
---
 drivers/gpu/drm/meson/meson_venc.c | 1 -
 1 file changed, 1 deletion(-)

diff --git a/drivers/gpu/drm/meson/meson_venc.c b/drivers/gpu/drm/meson/meson_venc.c
index 21c5fd6a82e3..a69a2ae30cf4 100644
--- a/drivers/gpu/drm/meson/meson_venc.c
+++ b/drivers/gpu/drm/meson/meson_venc.c
@@ -2002,7 +2002,6 @@ void meson_venc_enable_vsync(struct meson_drm *priv)
 
 void meson_venc_disable_vsync(struct meson_drm *priv)
 {
-	regmap_update_bits(priv->hhi, HHI_GCLK_MPEG2, BIT(25), 0);
 	writel_relaxed(0, priv->io_base + _REG(VENC_INTCTRL));
 }
 
