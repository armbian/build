From 091465b84314aa950c3cdadb443c2ee74fca5c65 Mon Sep 17 00:00:00 2001
From: Christian Hewitt <christianshewitt@gmail.com>
Date: Sun, 4 Oct 2026 12:59:31 +0000
Subject: [PATCH 195/210] dt-bindings: clock: amlogic,s4-pll-clkc: add the CPU
 clocks

The S4 CPU is clocked from sys_pll or from a dynamic clock derived from
xtal, fclk_div2 or fclk_div3, selected by a final mux. These registers
can only be written by the secure firmware.

Add clock IDs for sys_pll, its DCO, the dynamic clock and the CPU clock,
and an optional phandle to the secure monitor used to program them.

Assisted-by: Claude:claude-opus-5-5
Signed-off-by: Christian Hewitt <christianshewitt@gmail.com>
---
 .../bindings/clock/amlogic,s4-pll-clkc.yaml           | 11 +++++++++++
 include/dt-bindings/clock/amlogic,s4-pll-clkc.h       |  4 ++++
 2 files changed, 15 insertions(+)

diff --git a/Documentation/devicetree/bindings/clock/amlogic,s4-pll-clkc.yaml b/Documentation/devicetree/bindings/clock/amlogic,s4-pll-clkc.yaml
index d8932ec26ca8..151aba8a1218 100644
--- a/Documentation/devicetree/bindings/clock/amlogic,s4-pll-clkc.yaml
+++ b/Documentation/devicetree/bindings/clock/amlogic,s4-pll-clkc.yaml
@@ -27,6 +27,16 @@ properties:
   "#clock-cells":
     const: 1
 
+  amlogic,secure-monitor:
+    $ref: /schemas/types.yaml#/definitions/phandle-array
+    items:
+      - items:
+          - description: phandle to the secure monitor
+    description:
+      Phandle to the secure monitor. The sys_pll and CPU clock registers
+      can only be written by the secure firmware, so the CPU clocks are
+      only provided when this property is present.
+
 required:
   - compatible
   - reg
@@ -44,6 +54,7 @@ examples:
       clocks = <&xtal>;
       clock-names = "xtal";
       #clock-cells = <1>;
+      amlogic,secure-monitor = <&sm>;
     };
 
 ...
diff --git a/include/dt-bindings/clock/amlogic,s4-pll-clkc.h b/include/dt-bindings/clock/amlogic,s4-pll-clkc.h
index af9f110f8b62..02c27cd74f07 100644
--- a/include/dt-bindings/clock/amlogic,s4-pll-clkc.h
+++ b/include/dt-bindings/clock/amlogic,s4-pll-clkc.h
@@ -39,5 +39,9 @@
 #define CLKID_MPLL2			29
 #define CLKID_MPLL3_DIV			30
 #define CLKID_MPLL3			31
+#define CLKID_SYS_PLL_DCO		32
+#define CLKID_SYS_PLL			33
+#define CLKID_CPU_DYN_CLK		34
+#define CLKID_CPU_CLK			35
 
 #endif /* _DT_BINDINGS_CLOCK_AMLOGIC_S4_PLL_CLKC_H */
-- 
