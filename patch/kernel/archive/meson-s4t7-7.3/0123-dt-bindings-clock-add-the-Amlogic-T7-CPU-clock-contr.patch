From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Igor Pecovnik <igor@armbian.com>
Date: Wed, 14 Oct 2026 05:37:04 +0000
Subject: [PATCH] dt-bindings: clock: add the Amlogic T7 CPU clock controller

The T7 CPU clocks can only be written by the secure firmware. Describe
the controller that programs them through the secure monitor, and add
the clock IDs of both clusters.

Signed-off-by: Igor Pecovnik <igor@armbian.com>
---
 .../bindings/clock/amlogic,t7-cpu-clkc.yaml   | 70 +++++++++++++++++++
 .../dt-bindings/clock/amlogic,t7-cpu-clkc.h   | 21 ++++++
 2 files changed, 91 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/clock/amlogic,t7-cpu-clkc.yaml
 create mode 100644 include/dt-bindings/clock/amlogic,t7-cpu-clkc.h

diff --git a/Documentation/devicetree/bindings/clock/amlogic,t7-cpu-clkc.yaml b/Documentation/devicetree/bindings/clock/amlogic,t7-cpu-clkc.yaml
new file mode 100644
index 000000000000..478197ccdb56
--- /dev/null
+++ b/Documentation/devicetree/bindings/clock/amlogic,t7-cpu-clkc.yaml
@@ -0,0 +1,70 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/clock/amlogic,t7-cpu-clkc.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Amlogic T7 CPU Clock Controller
+
+maintainers:
+  - Igor Pecovnik <igor@armbian.com>
+
+description:
+  The A73 cluster runs from sys0_pll and the A53 cluster from sys1_pll, or
+  from a dynamic clock derived from xtal or the fixed PLL dividers. Only the
+  secure firmware can write these clocks, through the secure monitor. The
+  register range holds the sys0_pll and sys1_pll control registers.
+
+properties:
+  compatible:
+    const: amlogic,t7-cpu-clkc
+
+  reg:
+    maxItems: 1
+
+  '#clock-cells':
+    const: 1
+
+  clocks:
+    items:
+      - description: oscillator input of the PLLs and the dynamic clocks
+      - description: fixed PLL divided by 2
+      - description: fixed PLL divided by 3
+      - description: fixed PLL divided by 2.5
+
+  clock-names:
+    items:
+      - const: xtal
+      - const: fclk_div2
+      - const: fclk_div3
+      - const: fclk_div2p5
+
+  amlogic,secure-monitor:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: The secure monitor that programs the CPU clocks.
+
+required:
+  - compatible
+  - reg
+  - '#clock-cells'
+  - clocks
+  - clock-names
+  - amlogic,secure-monitor
+
+additionalProperties: false
+
+examples:
+  - |
+    apb {
+        #address-cells = <2>;
+        #size-cells = <2>;
+
+        clock-controller@8000 {
+            compatible = "amlogic,t7-cpu-clkc";
+            reg = <0 0x8000 0 0x40>;
+            clocks = <&xtal>, <&scmi_clk 18>, <&scmi_clk 22>, <&scmi_clk 20>;
+            clock-names = "xtal", "fclk_div2", "fclk_div3", "fclk_div2p5";
+            amlogic,secure-monitor = <&sm>;
+            #clock-cells = <1>;
+        };
+    };
diff --git a/include/dt-bindings/clock/amlogic,t7-cpu-clkc.h b/include/dt-bindings/clock/amlogic,t7-cpu-clkc.h
new file mode 100644
index 000000000000..d155b6af3624
--- /dev/null
+++ b/include/dt-bindings/clock/amlogic,t7-cpu-clkc.h
@@ -0,0 +1,21 @@
+/* SPDX-License-Identifier: (GPL-2.0-only OR MIT) */
+/*
+ * Amlogic T7 CPU clock controller
+ */
+
+#ifndef __T7_CPU_CLKC_H
+#define __T7_CPU_CLKC_H
+
+/* A73 cluster: sys0_pll */
+#define CLKID_A73_PLL_DCO	0
+#define CLKID_A73_PLL		1
+#define CLKID_A73_DYN		2
+#define CLKID_A73_CPU		3
+
+/* A53 cluster: sys1_pll */
+#define CLKID_A53_PLL_DCO	4
+#define CLKID_A53_PLL		5
+#define CLKID_A53_DYN		6
+#define CLKID_A53_CPU		7
+
+#endif /* __T7_CPU_CLKC_H */
