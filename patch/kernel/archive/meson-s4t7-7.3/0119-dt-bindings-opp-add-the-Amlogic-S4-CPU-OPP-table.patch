From 3ee45e206710168c3fbf832b78b257c20de3979f Mon Sep 17 00:00:00 2001
From: Christian Hewitt <christianshewitt@gmail.com>
Date: Wed, 7 Oct 2026 12:32:44 +0000
Subject: [PATCH 197/210] dt-bindings: opp: add the Amlogic S4 CPU OPP table

Amlogic S4 SoCs are binned at manufacture, and better bins run the same
CPU frequencies at lower voltages. The bin is stored in efuse and is
reported by the secure monitor.

Describe a single OPP table that lists the voltage for each bin in
opp-microvolt-bin<N> and falls back to opp-microvolt, with a phandle to
the secure monitor that reports the bin.

Assisted-by: Claude:claude-opus-5-5
Signed-off-by: Christian Hewitt <christianshewitt@gmail.com>
---
 .../opp/amlogic,s4-cpu-operating-points.yaml  | 80 +++++++++++++++++++
 1 file changed, 80 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/opp/amlogic,s4-cpu-operating-points.yaml

diff --git a/Documentation/devicetree/bindings/opp/amlogic,s4-cpu-operating-points.yaml b/Documentation/devicetree/bindings/opp/amlogic,s4-cpu-operating-points.yaml
new file mode 100644
index 000000000000..8a2f4b2a00ba
--- /dev/null
+++ b/Documentation/devicetree/bindings/opp/amlogic,s4-cpu-operating-points.yaml
@@ -0,0 +1,80 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/opp/amlogic,s4-cpu-operating-points.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Amlogic S4 CPU OPP
+
+maintainers:
+  - Christian Hewitt <christianshewitt@gmail.com>
+
+description: |
+  Amlogic S4 SoCs are binned at manufacture, and the CPU voltage for each
+  OPP depends on the bin. The secure monitor firmware reports the bin,
+  where a higher bin is better silicon that runs the same frequency at a
+  lower voltage. Each OPP lists the voltage for a bin in
+  opp-microvolt-bin<N>, and falls back to opp-microvolt for bins it does
+  not list.
+
+allOf:
+  - $ref: opp-v2-base.yaml#
+
+properties:
+  compatible:
+    const: amlogic,s4-cpu-operating-points
+
+  amlogic,secure-monitor:
+    description: phandle to the secure monitor that reports the bin
+    $ref: /schemas/types.yaml#/definitions/phandle-array
+    items:
+      - items:
+          - description: phandle to the secure monitor
+
+  opp-shared: true
+
+required:
+  - compatible
+  - amlogic,secure-monitor
+
+patternProperties:
+  "^opp-[0-9]+$":
+    type: object
+
+    properties:
+      opp-hz: true
+      clock-latency-ns: true
+      opp-microvolt: true
+
+    patternProperties:
+      "^opp-microvolt-bin[0-9]$": true
+
+    required:
+      - opp-hz
+      - opp-microvolt
+
+    unevaluatedProperties: false
+
+additionalProperties: false
+
+examples:
+  - |
+    opp-table {
+        compatible = "amlogic,s4-cpu-operating-points";
+        amlogic,secure-monitor = <&sm>;
+        opp-shared;
+
+        opp-100000000 {
+            opp-hz = /bits/ 64 <100000000>;
+            opp-microvolt = <769000>;
+            opp-microvolt-bin2 = <759000>;
+            opp-microvolt-bin3 = <759000>;
+        };
+
+        opp-1704000000 {
+            opp-hz = /bits/ 64 <1704000000>;
+            opp-microvolt = <909000>;
+            opp-microvolt-bin2 = <829000>;
+            opp-microvolt-bin3 = <809000>;
+        };
+    };
-- 
