From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Igor Pecovnik <igor@armbian.com>
Date: Tue, 13 Oct 2026 00:00:00 +0200
Subject: [PATCH] arm64: dts: amlogic: t7: add Mali GPU node

Add the Mali-G52 GPU node to T7 and enable it on Khadas VIM4.
The GPU is IO-coherent. Without dma-coherent, jobs fail with
DATA_INVALID_FAULT. The GPU runs at 800 MHz from fclk_div2p5.

Signed-off-by: Igor Pecovnik <igor@armbian.com>
---
diff --git a/arch/arm64/boot/dts/amlogic/amlogic-t7-a311d2-khadas-vim4.dts b/arch/arm64/boot/dts/amlogic/amlogic-t7-a311d2-khadas-vim4.dts
index ada2d1f31038..e5d2ac7d581c 100644
--- a/arch/arm64/boot/dts/amlogic/amlogic-t7-a311d2-khadas-vim4.dts
+++ b/arch/arm64/boot/dts/amlogic/amlogic-t7-a311d2-khadas-vim4.dts
@@ -706,3 +706,7 @@ bluetooth {
 		vddio-supply = <&vddao_1v8>;
 	};
 };
+
+&gpu {
+	status = "okay";
+};
diff --git a/arch/arm64/boot/dts/amlogic/amlogic-t7.dtsi b/arch/arm64/boot/dts/amlogic/amlogic-t7.dtsi
index 4c57633c2818..f28a33964956 100644
--- a/arch/arm64/boot/dts/amlogic/amlogic-t7.dtsi
+++ b/arch/arm64/boot/dts/amlogic/amlogic-t7.dtsi
@@ -963,6 +963,31 @@ uart_c: serial@7c000 {
 				status = "disabled";
 			};
 
+			gpu: gpu@400000 {
+				compatible = "amlogic,meson-g12a-mali", "arm,mali-bifrost";
+				reg = <0x0 0x400000 0x0 0x4000>;
+				interrupts = <GIC_SPI 146 IRQ_TYPE_LEVEL_HIGH>,
+					     <GIC_SPI 145 IRQ_TYPE_LEVEL_HIGH>,
+					     <GIC_SPI 144 IRQ_TYPE_LEVEL_HIGH>;
+				interrupt-names = "job", "mmu", "gpu";
+				clocks = <&clkc_periphs CLKID_MALI>,
+					 <&clkc_periphs CLKID_SYS_MALI>;
+				clock-names = "core", "bus";
+				resets = <&reset RESET_MALI_CAPB3>, <&reset RESET_MALI>;
+				power-domains = <&pwrc PWRC_T7_MALI_TOP_ID>;
+				assigned-clocks = <&clkc_periphs CLKID_MALI_0_SEL>,
+						  <&clkc_periphs CLKID_MALI_0>,
+						  <&clkc_periphs CLKID_MALI>;
+				assigned-clock-parents = <&scmi_clk CLKID_FCLK_DIV2P5>,
+							 <0>,
+							 <&clkc_periphs CLKID_MALI_0>;
+				assigned-clock-rates = <0>, <800000000>, <0>;
+				/* The GPU is IO-coherent (ACE-Lite) on T7 */
+				dma-coherent;
+				#cooling-cells = <2>;
+				status = "disabled";
+			};
+
 			eth_phy: mdio-multiplexer@28000 {
 				compatible = "amlogic,g12a-mdio-mux";
 				reg = <0x0 0x28000 0x0 0xa4>;
