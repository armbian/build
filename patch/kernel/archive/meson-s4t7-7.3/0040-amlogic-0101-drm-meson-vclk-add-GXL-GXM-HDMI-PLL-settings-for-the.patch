From 0665f8c36a56c017407f304ce69cc4138f893f10 Mon Sep 17 00:00:00 2001
From: Christian Hewitt <christianshewitt@gmail.com>
Date: Sat, 12 Sep 2026 15:17:18 +0000
Subject: [PATCH 101/210] drm/meson: vclk: add GXL/GXM HDMI PLL settings for
 the deep color VCOs

Add the GXL/GXM m/frac values for the 3712.5 MHz and 4455 MHz deep color
VCOs, including the 1000/1001 alternates. The existing GXL/GXM analog
settings apply unchanged at these rates.

Assisted-by: Claude:claude-opus-5
Signed-off-by: Christian Hewitt <christianshewitt@gmail.com>
---
 drivers/gpu/drm/meson/meson_vclk.c | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/drivers/gpu/drm/meson/meson_vclk.c b/drivers/gpu/drm/meson/meson_vclk.c
index abb8d9f29061..aa56c8e6c948 100644
--- a/drivers/gpu/drm/meson/meson_vclk.c
+++ b/drivers/gpu/drm/meson/meson_vclk.c
@@ -879,10 +879,18 @@ static void meson_vclk_set(struct meson_drm *priv,
 			m = 0x7b;
 			frac = vic_alternate_clock ? 0x281 : 0x300;
 			break;
+		case 3712500000:
+			m = 0x9a;
+			frac = vic_alternate_clock ? 0x222 : 0x2c0;
+			break;
 		case 4320000000:
 			m = vic_alternate_clock ? 0xb3 : 0xb4;
 			frac = vic_alternate_clock ? 0x347 : 0;
 			break;
+		case 4455000000:
+			m = 0xb9;
+			frac = vic_alternate_clock ? 0x1c2 : 0x280;
+			break;
 		case 5940000000:
 			m = 0xf7;
 			frac = vic_alternate_clock ? 0x102 : 0x200;
-- 
