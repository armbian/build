From 70204ab94626cae71c4e6dfd1ea679076a4c77de Mon Sep 17 00:00:00 2001
From: Christian Hewitt <christianshewitt@gmail.com>
Date: Mon, 28 Sep 2026 07:20:35 +0000
Subject: [PATCH 114/210] drm/meson: overlay: fix the Amlogic FBC memory saving
 mode check

The memory saving test masks the modifier with a full Amlogic FBC
modifier, which includes the vendor field, so it is true for every
Amlogic FBC modifier. Basic layout 10-bit frames are then read with
8-bit superblock sizes and the header is looked up inside the body.

Test the option bits only.

Fixes: 376b1391d9e9 ("drm/meson: overlay: setup overlay for Amlogic FBC Memory Saving mode")
Assisted-by: Claude:claude-opus-5-5
Signed-off-by: Christian Hewitt <christianshewitt@gmail.com>
---
 drivers/gpu/drm/meson/meson_overlay.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/drivers/gpu/drm/meson/meson_overlay.c b/drivers/gpu/drm/meson/meson_overlay.c
index 7047807f1a3e..db4fdf03f493 100644
--- a/drivers/gpu/drm/meson/meson_overlay.c
+++ b/drivers/gpu/drm/meson/meson_overlay.c
@@ -495,8 +495,8 @@ static void meson_overlay_atomic_update(struct drm_plane *plane,
 					  AFBC_HOLD_LINE_NUM(8) |
 					  AFBC_BURST_LEN(2);
 
-		if (fb->modifier & DRM_FORMAT_MOD_AMLOGIC_FBC(0,
-						AMLOGIC_FBC_OPTION_MEM_SAVING))
+		if ((fb->modifier >> __fourcc_mod_amlogic_options_shift) &
+		    AMLOGIC_FBC_OPTION_MEM_SAVING)
 			priv->viu.vd1_afbc_mode |= AFBC_BLK_MEM_MODE;
 
 		if ((fb->modifier & __fourcc_mod_amlogic_layout_mask) ==
-- 
