From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Igor Pecovnik <igor@armbian.com>
Date: Wed, 14 Oct 2026 07:22:16 +0000
Subject: [PATCH] dt-bindings: display: meson-dw-hdmi: allow one sound DAI cell

The DesignWare HDMI codec has an I2S and an SPDIF input. With one cell,
a sound card can select the input.

Signed-off-by: Igor Pecovnik <igor@armbian.com>
---
 .../devicetree/bindings/display/amlogic,meson-dw-hdmi.yaml     | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/Documentation/devicetree/bindings/display/amlogic,meson-dw-hdmi.yaml b/Documentation/devicetree/bindings/display/amlogic,meson-dw-hdmi.yaml
index 935c83fc4451..c501cb9c18eb 100644
--- a/Documentation/devicetree/bindings/display/amlogic,meson-dw-hdmi.yaml
+++ b/Documentation/devicetree/bindings/display/amlogic,meson-dw-hdmi.yaml
@@ -105,7 +105,8 @@ properties:
     const: 0
 
   "#sound-dai-cells":
-    const: 0
+    description: With 1 cell, 0 selects the I2S input and 1 the SPDIF input.
+    enum: [0, 1]
 
   sound-name-prefix: true
 
