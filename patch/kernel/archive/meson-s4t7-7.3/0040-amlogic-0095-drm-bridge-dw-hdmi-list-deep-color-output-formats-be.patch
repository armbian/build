From e891b8ec17f0a5ea30e1ae0b37208afde3f06f5b Mon Sep 17 00:00:00 2001
From: Gus Bourg <gus@bourg.net>
Date: Wed, 2 Sep 2026 17:30:00 -0700
Subject: [PATCH 095/210] drm/bridge: dw-hdmi: list deep color output formats
 before RGB888

The bridge chain selects the first output format that every bridge can
resolve. RGB888 is first in the dw-hdmi list, so a deep color format is
never selected.

Move the RGB888 fallback below the deep color formats and prefer full
chroma formats over YUV422 within each deep color depth. Sinks without
deep color support negotiate the same format as before.

Signed-off-by: Gus Bourg <gus@bourg.net>
---
 drivers/gpu/drm/bridge/synopsys/dw-hdmi.c | 23 ++++++++++++-----------
 1 file changed, 12 insertions(+), 11 deletions(-)

diff --git a/drivers/gpu/drm/bridge/synopsys/dw-hdmi.c b/drivers/gpu/drm/bridge/synopsys/dw-hdmi.c
index 43bee72dc4e2..0f6e46a30ff8 100644
--- a/drivers/gpu/drm/bridge/synopsys/dw-hdmi.c
+++ b/drivers/gpu/drm/bridge/synopsys/dw-hdmi.c
@@ -2639,13 +2639,11 @@ static u32 *dw_hdmi_bridge_atomic_get_output_bus_fmts(struct drm_bridge *bridge,
 	}
 
 	/*
-	 * Order bus formats from 16bit to 8bit and from YUV422 to RGB
-	 * if supported. In any case the default RGB888 format is added
+	 * Order bus formats from 16bit to 8bit if supported, preferring full
+	 * chroma over YUV422 within each deep color depth. The default RGB888
+	 * format is added after the deep color formats.
 	 */
 
-	/* Default 8bit RGB fallback */
-	output_fmts[i++] = MEDIA_BUS_FMT_RGB888_1X24;
-
 	if (max_bpc >= 16 && info->bpc == 16) {
 		if (info->color_formats & BIT(DRM_OUTPUT_COLOR_FORMAT_YCBCR444))
 			output_fmts[i++] = MEDIA_BUS_FMT_YUV16_1X48;
@@ -2654,25 +2652,28 @@ static u32 *dw_hdmi_bridge_atomic_get_output_bus_fmts(struct drm_bridge *bridge,
 	}
 
 	if (max_bpc >= 12 && info->bpc >= 12) {
-		if (info->color_formats & BIT(DRM_OUTPUT_COLOR_FORMAT_YCBCR422))
-			output_fmts[i++] = MEDIA_BUS_FMT_UYVY12_1X24;
-
 		if (info->color_formats & BIT(DRM_OUTPUT_COLOR_FORMAT_YCBCR444))
 			output_fmts[i++] = MEDIA_BUS_FMT_YUV12_1X36;
 
 		output_fmts[i++] = MEDIA_BUS_FMT_RGB121212_1X36;
-	}
 
-	if (max_bpc >= 10 && info->bpc >= 10) {
 		if (info->color_formats & BIT(DRM_OUTPUT_COLOR_FORMAT_YCBCR422))
-			output_fmts[i++] = MEDIA_BUS_FMT_UYVY10_1X20;
+			output_fmts[i++] = MEDIA_BUS_FMT_UYVY12_1X24;
+	}
 
+	if (max_bpc >= 10 && info->bpc >= 10) {
 		if (info->color_formats & BIT(DRM_OUTPUT_COLOR_FORMAT_YCBCR444))
 			output_fmts[i++] = MEDIA_BUS_FMT_YUV10_1X30;
 
 		output_fmts[i++] = MEDIA_BUS_FMT_RGB101010_1X30;
+
+		if (info->color_formats & BIT(DRM_OUTPUT_COLOR_FORMAT_YCBCR422))
+			output_fmts[i++] = MEDIA_BUS_FMT_UYVY10_1X20;
 	}
 
+	/* Default 8bit RGB fallback */
+	output_fmts[i++] = MEDIA_BUS_FMT_RGB888_1X24;
+
 	if (info->color_formats & BIT(DRM_OUTPUT_COLOR_FORMAT_YCBCR422))
 		output_fmts[i++] = MEDIA_BUS_FMT_UYVY8_1X16;
 
