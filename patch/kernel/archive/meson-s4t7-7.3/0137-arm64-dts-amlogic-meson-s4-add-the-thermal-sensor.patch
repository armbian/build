From 9f7261c7c20d0d01845de93e845420b233350956 Mon Sep 17 00:00:00 2001
From: Christian Hewitt <christianshewitt@gmail.com>
Date: Sat, 3 Oct 2026 14:46:23 +0000
Subject: [PATCH 186/210] arm64: dts: amlogic: meson-s4: add the thermal sensor

Add the SoC thermal sensor, which takes its calibration from the secure
monitor, and a thermal zone with trip points of 85C passive, 95C hot
and 105C critical. The GPU is the only cooling device until the CPU has
frequency scaling.

Assisted-by: Claude:claude-opus-5-5
Signed-off-by: Christian Hewitt <christianshewitt@gmail.com>
---
 arch/arm64/boot/dts/amlogic/meson-s4.dtsi | 45 +++++++++++++++++++++++
 1 file changed, 45 insertions(+)

diff --git a/arch/arm64/boot/dts/amlogic/meson-s4.dtsi b/arch/arm64/boot/dts/amlogic/meson-s4.dtsi
index 2ee3a0f93122..21af6640fc06 100644
--- a/arch/arm64/boot/dts/amlogic/meson-s4.dtsi
+++ b/arch/arm64/boot/dts/amlogic/meson-s4.dtsi
@@ -17,6 +17,7 @@
 #include <dt-bindings/reset/amlogic,meson-g12a-audio-reset.h>
 #include <dt-bindings/sound/meson-g12a-toacodec.h>
 #include <dt-bindings/sound/meson-g12a-tohdmitx.h>
+#include <dt-bindings/thermal/thermal.h>
 
 / {
 	cpus {
@@ -88,6 +89,15 @@ pwrc: power-controller {
 		};
 	};
 
+	cpu_temp: temperature-sensor@fe020000 {
+		compatible = "amlogic,s4-thermal", "amlogic,t7-thermal";
+		reg = <0x0 0xfe020000 0x0 0x50>;
+		interrupts = <GIC_SPI 30 IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&clkc_periphs CLKID_TS>;
+		#thermal-sensor-cells = <0>;
+		amlogic,secure-monitor = <&sm 1>;
+	};
+
 	saradc: adc@fe026000 {
 		compatible = "amlogic,meson-s4-saradc",
 			     "amlogic,meson-g12a-saradc";
@@ -135,6 +145,41 @@ opp-799999987 {
 		};
 	};
 
+	thermal-zones {
+		cpu_thermal: cpu-thermal {
+			polling-delay = <1000>;
+			polling-delay-passive = <100>;
+			thermal-sensors = <&cpu_temp>;
+
+			trips {
+				cpu_passive: cpu-passive {
+					temperature = <85000>; /* millicelsius */
+					hysteresis = <5000>; /* millicelsius */
+					type = "passive";
+				};
+
+				cpu_hot: cpu-hot {
+					temperature = <95000>; /* millicelsius */
+					hysteresis = <5000>; /* millicelsius */
+					type = "hot";
+				};
+
+				cpu_critical: cpu-critical {
+					temperature = <105000>; /* millicelsius */
+					hysteresis = <1000>; /* millicelsius */
+					type = "critical";
+				};
+			};
+
+			cooling-maps {
+				map0 {
+					trip = <&cpu_passive>;
+					cooling-device = <&gpu THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
+				};
+			};
+		};
+	};
+
 	soc {
 		compatible = "simple-bus";
 		#address-cells = <2>;
