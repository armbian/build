+++ b/drivers/gpu/drm/meson/Kconfig
@@ -23,6 +23,20 @@ config DRM_MESON_DW_HDMI
 	select DRM_DW_HDMI
 	imply DRM_DW_HDMI_I2S_AUDIO
 
+config DRM_MESON_HDMITX21
+	tristate "HDMI 2.1 transmitter support for Amlogic T7"
+	depends on DRM_MESON
+	default y if DRM_MESON
+	select DRM_DISPLAY_CONNECTOR
