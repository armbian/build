From a3414bda3bac228d7ed5300447c011f495a1958f Mon Sep 17 00:00:00 2001
From: Gus Bourg <gus@bourg.net>
Date: Wed, 2 Sep 2026 17:30:00 -0700
Subject: [PATCH 099/210] drm/meson: vclk: bound the G12A HDMI PLL lock retries

The G12A HDMI PLL is reset until it reports lock. If the analog
settings do not suit the requested VCO the loop never ends and the
board hangs during boot.

Give up after 100 attempts and report the failure.

Signed-off-by: Gus Bourg <gus@bourg.net>
---
 drivers/gpu/drm/meson/meson_vclk.c | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/meson/meson_vclk.c b/drivers/gpu/drm/meson/meson_vclk.c
index c0be0b7655bf..9d34e26ddbb8 100644
--- a/drivers/gpu/drm/meson/meson_vclk.c
+++ b/drivers/gpu/drm/meson/meson_vclk.c
@@ -492,6 +492,7 @@ static void meson_hdmi_pll_set_params(struct meson_drm *priv, unsigned int m,
 				      unsigned int od2, unsigned int od3)
 {
 	unsigned int val;
+	int lock_tries = 100;
 
 	if (meson_vpu_is_compatible(priv, VPU_COMPATIBLE_GXBB)) {
 		regmap_write(priv->hhi, HHI_HDMI_PLL_CNTL, 0x58000200 | m);
@@ -580,7 +581,11 @@ static void meson_hdmi_pll_set_params(struct meson_drm *priv, unsigned int m,
 						        == HDMI_PLL_LOCK_G12A),
 						      10, 100))
 				break;
-		} while(1);
+		} while (--lock_tries);
+
+		if (!lock_tries)
+			pr_err("HDMI PLL failed to lock for m=0x%x frac=0x%x\n",
+			       m, frac);
 	}
 
 	if (meson_vpu_is_compatible(priv, VPU_COMPATIBLE_GXBB))
-- 
