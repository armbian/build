From bc64a103e2ae88d09978aba0dd23e64dd84ec0fd Mon Sep 17 00:00:00 2001
From: Viacheslav Bocharov <v@baodeep.com>
Date: Tue, 13 Oct 2026 20:39:38 +0300
Subject: [PATCH 135/135] mmc: meson-gx: use the interface 3 tuning on T7

The T7 controllers have the same SD_EMMC_INTF3 sampling interface as
the S4 ones, and the vendor kernel tunes the T7 SDIO and SD controllers
through it. Resampling tuning does not give a reliable sampling point:
the BCM43752 WiFi module on the Khadas VIM4 fails the firmware download
with -EILSEQ in SDR104 mode.

Enable the interface 3 tuning in the T7 data.

Signed-off-by: Viacheslav Bocharov <v@baodeep.com>
---
 drivers/mmc/host/meson-gx-mmc.c | 1 +
 1 file changed, 1 insertion(+)

diff --git a/drivers/mmc/host/meson-gx-mmc.c b/drivers/mmc/host/meson-gx-mmc.c
index d5a57ee14aae..8be0dc919bd5 100644
--- a/drivers/mmc/host/meson-gx-mmc.c
+++ b/drivers/mmc/host/meson-gx-mmc.c
@@ -1444,6 +1444,7 @@ static const struct meson_mmc_data meson_t7_data = {
 	.adjust		= SD_EMMC_V3_ADJUST,
 	.irq_sdio_sleep	= CLK_V3_IRQ_SDIO_SLEEP,
 	.has_pipeline_clk = true,
+	.intf3_tuning	= true,
 };
 
 static const struct of_device_id meson_mmc_of_match[] = {
