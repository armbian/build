From 4de79d4efd8b84dbfb742faa4d59c3be7f75ccfe Mon Sep 17 00:00:00 2001
From: Viacheslav Bocharov <v@baodeep.com>
Date: Tue, 13 Oct 2026 20:39:04 +0300
Subject: [PATCH 131/135] clk: meson: t7: keep the Ethernet pipeline clock on

The Ethernet controller needs sys_ampipe_eth, but the VIM4 Ethernet
node does not reference it. clk_disable_unused() then gates it, and
Ethernet transmit times out.

Mark the gate CLK_IGNORE_UNUSED until the T7 Ethernet support gives
it a consumer.

Signed-off-by: Viacheslav Bocharov <v@baodeep.com>
---
 drivers/clk/meson/t7-peripherals.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/drivers/clk/meson/t7-peripherals.c b/drivers/clk/meson/t7-peripherals.c
index 2f429ea86796..efd9d3affee3 100644
--- a/drivers/clk/meson/t7-peripherals.c
+++ b/drivers/clk/meson/t7-peripherals.c
@@ -946,7 +946,7 @@ static T7_SYS_PCLK(sys_cec,		SYS_CLK_EN0_REG0, 16,	0);
 static T7_SYS_PCLK(sys_gdc,		SYS_CLK_EN0_REG0, 17,	0);
 static T7_SYS_PCLK(sys_deswarp,		SYS_CLK_EN0_REG0, 18,	0);
 static T7_SYS_PCLK(sys_ampipe_nand,	SYS_CLK_EN0_REG0, 19,	0);
-static T7_SYS_PCLK(sys_ampipe_eth,	SYS_CLK_EN0_REG0, 20,	0);
+static T7_SYS_PCLK(sys_ampipe_eth,	SYS_CLK_EN0_REG0, 20,	CLK_IGNORE_UNUSED);
 /*
  * NOTE: sys_am2axi0..2 provide the clock to the AXI bus used for DMA between
  * the peripherals and the DRAM. After the clocks are disabled, a device that
-- 
