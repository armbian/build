From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Igor Pecovnik <igor@armbian.com>
Date: Tue, 13 Oct 2026 18:34:03 +0000
Subject: [PATCH 107/107] arm64: dts: amlogic: t7: add the display, enable HDMI
 on VIM4

Add the canvas, VPU and HDMI transmitter nodes and the HDMI pin states.
Enable them on Khadas VIM4 with an HDMI connector, and add the HDMI
transmitter to the VIM4 sound card.

Signed-off-by: Igor Pecovnik <igor@armbian.com>
---
 .../amlogic/amlogic-t7-a311d2-khadas-vim4.dts | 34 +++++++
 arch/arm64/boot/dts/amlogic/amlogic-t7.dtsi   | 99 +++++++++++++++++++
 2 files changed, 133 insertions(+)

diff --git a/arch/arm64/boot/dts/amlogic/amlogic-t7-a311d2-khadas-vim4.dts b/arch/arm64/boot/dts/amlogic/amlogic-t7-a311d2-khadas-vim4.dts
index e74f33370fd7..dc7c712cc48f 100644
--- a/arch/arm64/boot/dts/amlogic/amlogic-t7-a311d2-khadas-vim4.dts
+++ b/arch/arm64/boot/dts/amlogic/amlogic-t7-a311d2-khadas-vim4.dts
@@ -456,6 +456,15 @@ codec {
 				sound-dai = <&tohdmitx TOHDMITX_SPDIF_IN_B>;
 			};
 		};
+
+		/* HDMI transmitter, fed from the TDM interfaces by tohdmitx */
+		dai-link-8 {
+			sound-dai = <&tohdmitx TOHDMITX_I2S_OUT>;
+
+			codec {
+				sound-dai = <&hdmi_tx>;
+			};
+		};
 	};
 };
 
@@ -808,3 +817,28 @@ bluetooth {
 &gpu {
 	status = "okay";
 };
+
+/ {
+	hdmi-connector {
+		compatible = "hdmi-connector";
+		type = "a";
+
+		port {
+			hdmi_connector_in: endpoint {
+				remote-endpoint = <&hdmi_tx_tmds_out>;
+			};
+		};
+	};
+};
+
+&hdmi_tx {
+	status = "okay";
+};
+
+&hdmi_tx_tmds_out {
+	remote-endpoint = <&hdmi_connector_in>;
+};
+
+&vpu {
+	status = "okay";
+};
diff --git a/arch/arm64/boot/dts/amlogic/amlogic-t7.dtsi b/arch/arm64/boot/dts/amlogic/amlogic-t7.dtsi
index ed9c127cd1cb..2249e6222209 100644
--- a/arch/arm64/boot/dts/amlogic/amlogic-t7.dtsi
+++ b/arch/arm64/boot/dts/amlogic/amlogic-t7.dtsi
@@ -1825,3 +1825,102 @@ pdm: audio-controller@331000 {
 		resets = <&clkc_audio AUD_RESET_PDM>;
 	};
 };
+
+/ {
+	vpu: vpu@ff000000 {
+		compatible = "amlogic,meson-t7-vpu";
+		reg = <0x0 0xff000000 0x0 0x40000>,
+		      <0x0 0xfe008000 0x0 0x2000>,
+		      <0x0 0xfe000000 0x0 0x2000>,
+		      <0x0 0xfe00c000 0x0 0x800>,
+		      <0x0 0xfe010000 0x0 0x100>;
+		reg-names = "vpu", "hhi", "clkctrl", "pwrctrl", "sysctrl";
+		interrupts = <GIC_SPI 197 IRQ_TYPE_EDGE_RISING>;
+		amlogic,canvas = <&canvas>;
+		power-domains = <&pwrc PWRC_T7_VPU_HDMI_ID>;
+		clocks = <&clkc_periphs CLKID_SYS_VPU_INTR>;
+		clock-names = "intr";
+		#address-cells = <1>;
+		#size-cells = <0>;
+		status = "disabled";
+
+		/* CVBS VDAC output port */
+		cvbs_vdac_port: port@0 {
+			reg = <0>;
+		};
+
+		/* HDMI-TX output port */
+		hdmi_tx_port: port@1 {
+			reg = <1>;
+
+			hdmi_tx_out: endpoint {
+				remote-endpoint = <&hdmi_tx_in>;
+			};
+		};
+	};
+};
+
+&apb4 {
+	canvas: video-lut@36048 {
+		compatible = "amlogic,canvas";
+		reg = <0x0 0x36048 0x0 0x14>;
+	};
+
+	hdmi_tx: hdmi-tx@300000 {
+		compatible = "amlogic,t7-hdmi-tx";
+		reg = <0x0 0x300000 0x0 0x10000>,
+		      <0x0 0x380000 0x0 0x10000>;
+		reg-names = "top", "cor";
+		interrupts = <GIC_SPI 204 IRQ_TYPE_LEVEL_HIGH>;
+		power-domains = <&pwrc PWRC_T7_VI_CLK2_ID>;
+		clocks = <&clkc_periphs CLKID_SYS_HDMITX_APB>;
+		clock-names = "pclk";
+		resets = <&reset RESET_HDMITX>,
+			 <&reset RESET_HDMITXPHY>;
+		reset-names = "hdmitx", "phy";
+		#sound-dai-cells = <0>;
+		pinctrl-0 = <&hdmitx_hpd_pins>, <&hdmitx_ddc_pins>;
+		pinctrl-names = "default";
+		status = "disabled";
+
+		ports {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			port@0 {
+				reg = <0>;
+
+				hdmi_tx_in: endpoint {
+					remote-endpoint = <&hdmi_tx_out>;
+				};
+			};
+
+			port@1 {
+				reg = <1>;
+
+				hdmi_tx_tmds_out: endpoint {
+				};
+			};
+		};
+	};
+};
+
+&periphs_pinctrl {
+	hdmitx_hpd_pins: hdmitx-hpd {
+		mux {
+			groups = "hdmitx_hpd_in";
+			function = "hdmitx";
+			bias-disable;
+		};
+	};
+
+	hdmitx_ddc_pins: hdmitx-ddc {
+		mux {
+			groups = "hdmitx_sda_w13",
+				 "hdmitx_sck_w14";
+			function = "hdmitx";
+			bias-disable;
+			drive-strength-microamp = <4000>;
+		};
+	};
+};
