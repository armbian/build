From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Igor Pecovnik <igor@armbian.com>
Date: Wed, 14 Oct 2026 05:37:28 +0000
Subject: [PATCH] dt-bindings: opp: amlogic: add the T7 CPU OPP table

T7 has one OPP table for each cluster, and the secure monitor reports
the bin of each cluster. Add the T7 compatible.

Signed-off-by: Igor Pecovnik <igor@armbian.com>
---
 .../bindings/opp/amlogic,s4-cpu-operating-points.yaml    | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/Documentation/devicetree/bindings/opp/amlogic,s4-cpu-operating-points.yaml b/Documentation/devicetree/bindings/opp/amlogic,s4-cpu-operating-points.yaml
index 8a2f4b2a00ba..a42b1f2c61ad 100644
--- a/Documentation/devicetree/bindings/opp/amlogic,s4-cpu-operating-points.yaml
+++ b/Documentation/devicetree/bindings/opp/amlogic,s4-cpu-operating-points.yaml
@@ -4,7 +4,7 @@
 $id: http://devicetree.org/schemas/opp/amlogic,s4-cpu-operating-points.yaml#
 $schema: http://devicetree.org/meta-schemas/core.yaml#
 
-title: Amlogic S4 CPU OPP
+title: Amlogic S4 and T7 CPU OPP
 
 maintainers:
   - Christian Hewitt <christianshewitt@gmail.com>
@@ -15,14 +15,17 @@ description: |
   where a higher bin is better silicon that runs the same frequency at a
   lower voltage. Each OPP lists the voltage for a bin in
   opp-microvolt-bin<N>, and falls back to opp-microvolt for bins it does
-  not list.
+  not list. T7 has one OPP table per cluster, and the firmware reports
+  the bin of each cluster.
 
 allOf:
   - $ref: opp-v2-base.yaml#
 
 properties:
   compatible:
-    const: amlogic,s4-cpu-operating-points
+    enum:
+      - amlogic,s4-cpu-operating-points
+      - amlogic,t7-cpu-operating-points
 
   amlogic,secure-monitor:
     description: phandle to the secure monitor that reports the bin
