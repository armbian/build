From 0b38d75cd6d12e70f76327034b25af6de393ebe5 Mon Sep 17 00:00:00 2001
From: Viacheslav Bocharov <v@baodeep.com>
Date: Tue, 13 Oct 2026 20:39:04 +0300
Subject: [PATCH 117/117] arm64: dts: amlogic: t7: add the bus clock to the
 thermal sensors

The T7 thermal binding requires two clocks: the per-sensor bus clock
that gates register access, and the shared sensor clock. Without the
bus clock, clk_disable_unused() gates the sensor registers and the
readings freeze.

Signed-off-by: Viacheslav Bocharov <v@baodeep.com>
---
 arch/arm64/boot/dts/amlogic/amlogic-t7.dtsi | 24 +++++++++++++++------
 1 file changed, 18 insertions(+), 6 deletions(-)

diff --git a/arch/arm64/boot/dts/amlogic/amlogic-t7.dtsi b/arch/arm64/boot/dts/amlogic/amlogic-t7.dtsi
index a44270db80cd..0879b53f93a8 100644
--- a/arch/arm64/boot/dts/amlogic/amlogic-t7.dtsi
+++ b/arch/arm64/boot/dts/amlogic/amlogic-t7.dtsi
@@ -1094,7 +1094,9 @@ a73_tsensor: temperature-sensor@20000 {
 				compatible = "amlogic,t7-thermal";
 				reg = <0x0 0x20000 0x0 0x50>;
 				interrupts = <GIC_SPI 31 IRQ_TYPE_LEVEL_HIGH>;
-				clocks = <&clkc_periphs CLKID_TS>;
+				clocks = <&clkc_periphs CLKID_SYS_TS_A73>,
+					 <&clkc_periphs CLKID_TS>;
+				clock-names = "bus", "core";
 				#thermal-sensor-cells = <0>;
 				amlogic,secure-monitor = <&sm 1>;
 			};
@@ -1103,7 +1105,9 @@ a53_tsensor: temperature-sensor@22000 {
 				compatible = "amlogic,t7-thermal";
 				reg = <0x0 0x22000 0x0 0x50>;
 				interrupts = <GIC_SPI 30 IRQ_TYPE_LEVEL_HIGH>;
-				clocks = <&clkc_periphs CLKID_TS>;
+				clocks = <&clkc_periphs CLKID_SYS_TS_A53>,
+					 <&clkc_periphs CLKID_TS>;
+				clock-names = "bus", "core";
 				#thermal-sensor-cells = <0>;
 				amlogic,secure-monitor = <&sm 2>;
 			};
@@ -1258,7 +1262,9 @@ gpu_tsensor: temperature-sensor@94000 {
 				compatible = "amlogic,t7-thermal";
 				reg = <0x0 0x94000 0x0 0x50>;
 				interrupts = <GIC_SPI 83 IRQ_TYPE_LEVEL_HIGH>;
-				clocks = <&clkc_periphs CLKID_TS>;
+				clocks = <&clkc_periphs CLKID_SYS_TS_GPU>,
+					 <&clkc_periphs CLKID_TS>;
+				clock-names = "bus", "core";
 				power-domains = <&pwrc PWRC_T7_MALI_TOP_ID>;
 				#thermal-sensor-cells = <0>;
 				amlogic,secure-monitor = <&sm 3>;
@@ -1268,7 +1274,9 @@ nna_tsensor: temperature-sensor@96000 {
 				compatible = "amlogic,t7-thermal";
 				reg = <0x0 0x96000 0x0 0x50>;
 				interrupts = <GIC_SPI 84 IRQ_TYPE_LEVEL_HIGH>;
-				clocks = <&clkc_periphs CLKID_TS>;
+				clocks = <&clkc_periphs CLKID_SYS_TS_NNA>,
+					 <&clkc_periphs CLKID_TS>;
+				clock-names = "bus", "core";
 				power-domains = <&pwrc PWRC_T7_NNA_TOP_ID>;
 				#thermal-sensor-cells = <0>;
 				amlogic,secure-monitor = <&sm 4>;
@@ -1278,7 +1286,9 @@ vpu_tsensor: temperature-sensor@98000 {
 				compatible = "amlogic,t7-thermal";
 				reg = <0x0 0x98000 0x0 0x50>;
 				interrupts = <GIC_SPI 85 IRQ_TYPE_LEVEL_HIGH>;
-				clocks = <&clkc_periphs CLKID_TS>;
+				clocks = <&clkc_periphs CLKID_SYS_TS_VPU>,
+					 <&clkc_periphs CLKID_TS>;
+				clock-names = "bus", "core";
 				power-domains = <&pwrc PWRC_T7_VPU_HDMI_ID>;
 				#thermal-sensor-cells = <0>;
 				amlogic,secure-monitor = <&sm 6>;
@@ -1288,7 +1298,9 @@ hevc_tsensor: temperature-sensor@9a000 {
 				compatible = "amlogic,t7-thermal";
 				reg = <0x0 0x9a000 0x0 0x50>;
 				interrupts = <GIC_SPI 86 IRQ_TYPE_LEVEL_HIGH>;
-				clocks = <&clkc_periphs CLKID_TS>;
+				clocks = <&clkc_periphs CLKID_SYS_TS_HEVC>,
+					 <&clkc_periphs CLKID_TS>;
+				clock-names = "bus", "core";
 				power-domains = <&pwrc PWRC_T7_DOS_HEVC_ID>;
 				#thermal-sensor-cells = <0>;
 				amlogic,secure-monitor = <&sm 5>;
-- 
