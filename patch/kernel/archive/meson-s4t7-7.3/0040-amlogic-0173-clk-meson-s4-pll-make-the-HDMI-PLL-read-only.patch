From 3b2b18c4f56edf77d45a78c3563f7631c033fb60 Mon Sep 17 00:00:00 2001
From: Christian Hewitt <christianshewitt@gmail.com>
Date: Mon, 5 Oct 2026 05:26:02 +0000
Subject: [PATCH 173/210] clk: meson: s4-pll: make the HDMI PLL read-only

The display driver programs the HDMI PLL directly and has no clock
reference on it, so the clock framework treats it as unused and turns it
off when it disables unused clocks. This stops the pixel clock shortly
after boot: vsync stops, DRM times out waiting for vblanks and the
display loses sync until the next full modeset reprograms the PLL.

As on G12A, expose the HDMI PLL and its dividers read-only and do not
cache their rates.

Assisted-by: Claude:claude-opus-5-5
Signed-off-by: Christian Hewitt <christianshewitt@gmail.com>
---
 drivers/clk/meson/s4-pll.c | 11 ++++++-----
 1 file changed, 6 insertions(+), 5 deletions(-)

diff --git a/drivers/clk/meson/s4-pll.c b/drivers/clk/meson/s4-pll.c
index 56ce6f566e53..065c3a3acbb2 100644
--- a/drivers/clk/meson/s4-pll.c
+++ b/drivers/clk/meson/s4-pll.c
@@ -459,11 +459,12 @@ static struct clk_regmap s4_hdmi_pll_dco = {
 	},
 	.hw.init = &(struct clk_init_data){
 		.name = "hdmi_pll_dco",
-		.ops = &meson_clk_pll_ops,
+		.ops = &meson_clk_pll_ro_ops,
 		.parent_data = (const struct clk_parent_data []) {
 			{ .fw_name = "xtal", }
 		},
 		.num_parents = 1,
+		.flags = CLK_GET_RATE_NOCACHE,
 	},
 };
 
@@ -476,12 +477,12 @@ static struct clk_regmap s4_hdmi_pll_od = {
 	},
 	.hw.init = &(struct clk_init_data){
 		.name = "hdmi_pll_od",
-		.ops = &clk_regmap_divider_ops,
+		.ops = &clk_regmap_divider_ro_ops,
 		.parent_hws = (const struct clk_hw *[]) {
 			&s4_hdmi_pll_dco.hw
 		},
 		.num_parents = 1,
-		.flags = CLK_SET_RATE_PARENT,
+		.flags = CLK_GET_RATE_NOCACHE | CLK_SET_RATE_PARENT,
 	},
 };
 
@@ -494,12 +495,12 @@ static struct clk_regmap s4_hdmi_pll = {
 	},
 	.hw.init = &(struct clk_init_data){
 		.name = "hdmi_pll",
-		.ops = &clk_regmap_divider_ops,
+		.ops = &clk_regmap_divider_ro_ops,
 		.parent_hws = (const struct clk_hw *[]) {
 			&s4_hdmi_pll_od.hw
 		},
 		.num_parents = 1,
-		.flags = CLK_SET_RATE_PARENT,
+		.flags = CLK_GET_RATE_NOCACHE | CLK_SET_RATE_PARENT,
 	},
 };
 
