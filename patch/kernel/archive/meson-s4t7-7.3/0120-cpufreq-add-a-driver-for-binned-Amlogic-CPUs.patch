From 182277991f89ba30153b1449715aeab33eaeb34b Mon Sep 17 00:00:00 2001
From: Martin Blumenstingl <martin.blumenstingl@googlemail.com>
Date: Wed, 7 Oct 2026 12:32:44 +0000
Subject: [PATCH 198/210] cpufreq: add a driver for binned Amlogic CPUs

Newer Amlogic SoCs are binned at manufacture, and better bins run the
same CPU frequencies at lower voltages. Without this, every chip runs
the voltages of the lowest bin.

Bind to the S4 CPU OPP table, read the bin through the secure monitor,
select the matching opp-microvolt-bin<N> voltages for each CPU, then
register cpufreq-dt. Add S4 to the cpufreq-dt-platdev blocklist so the
generic driver is only registered once the voltages are set.

Signed-off-by: Martin Blumenstingl <martin.blumenstingl@googlemail.com>
[chewitt: drop the intermediate clock handling now done by the S4 PLL
 clock driver, use the existing amlogic,secure-monitor property, and
 bind to the OPP table node instead of the machine compatible so the
 module autoloads when built as =m]
Assisted-by: Claude:claude-opus-5-5
Signed-off-by: Christian Hewitt <christianshewitt@gmail.com>
---
 drivers/cpufreq/Kconfig.arm          |  14 +++
 drivers/cpufreq/Makefile             |   1 +
 drivers/cpufreq/amlogic-cpufreq.c    | 142 +++++++++++++++++++++++++++
 drivers/cpufreq/cpufreq-dt-platdev.c |   2 +
 4 files changed, 159 insertions(+)
 create mode 100644 drivers/cpufreq/amlogic-cpufreq.c

diff --git a/drivers/cpufreq/Kconfig.arm b/drivers/cpufreq/Kconfig.arm
index a441668f9e0c..e132ef903625 100644
--- a/drivers/cpufreq/Kconfig.arm
+++ b/drivers/cpufreq/Kconfig.arm
@@ -24,6 +24,20 @@ config ARM_AIROHA_SOC_CPUFREQ
 	help
 	  This adds the CPUFreq driver for Airoha EN7581 SoCs.
 
+config ARM_AMLOGIC_SOC_CPUFREQ
+	tristate "Amlogic binned CPUFreq driver"
+	depends on ARCH_MESON || COMPILE_TEST
+	depends on MESON_SM
+	depends on CPUFREQ_DT
+	select PM_OPP
+	default ARCH_MESON
+	help
+	  This adds the CPUFreq driver for Amlogic SoCs that read the
+	  silicon bin from the secure monitor to select CPU voltages.
+
+	  To compile this driver as a module, choose M here: the
+	  module will be called amlogic-cpufreq.
+
 config ARM_APPLE_SOC_CPUFREQ
 	tristate "Apple Silicon SoC CPUFreq support"
 	depends on ARCH_APPLE || (COMPILE_TEST && 64BIT)
diff --git a/drivers/cpufreq/Makefile b/drivers/cpufreq/Makefile
index 6c7a39b7f8d2..29021d34821e 100644
--- a/drivers/cpufreq/Makefile
+++ b/drivers/cpufreq/Makefile
@@ -54,6 +54,7 @@ obj-$(CONFIG_X86_AMD_FREQ_SENSITIVITY)	+= amd_freq_sensitivity.o
 ##################################################################################
 # ARM SoC drivers
 obj-$(CONFIG_ARM_AIROHA_SOC_CPUFREQ)	+= airoha-cpufreq.o
+obj-$(CONFIG_ARM_AMLOGIC_SOC_CPUFREQ)	+= amlogic-cpufreq.o
 obj-$(CONFIG_ARM_APPLE_SOC_CPUFREQ)	+= apple-soc-cpufreq.o
 obj-$(CONFIG_ARM_ARMADA_37XX_CPUFREQ)	+= armada-37xx-cpufreq.o
 obj-$(CONFIG_ARM_ARMADA_8K_CPUFREQ)	+= armada-8k-cpufreq.o
diff --git a/drivers/cpufreq/amlogic-cpufreq.c b/drivers/cpufreq/amlogic-cpufreq.c
new file mode 100644
index 000000000000..ade7bd9c8749
--- /dev/null
+++ b/drivers/cpufreq/amlogic-cpufreq.c
@@ -0,0 +1,142 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Amlogic binned CPU frequency scaling
+ *
+ * Newer Amlogic SoCs are binned at manufacture, and better silicon runs
+ * the same CPU frequencies at lower voltages. The secure monitor reports
+ * the bin, which selects the matching opp-microvolt-bin<N> voltages before
+ * the generic cpufreq-dt driver takes over.
+ *
+ * Copyright (C) 2026 Martin Blumenstingl <martin.blumenstingl@googlemail.com>
+ */
+
+#include <linux/cpu.h>
+#include <linux/firmware/meson/meson_sm.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/pm_opp.h>
+#include <linux/slab.h>
+
+struct amlogic_cpufreq_priv {
+	struct platform_device *cpufreq_dt_pdev;
+	int opp_tokens[];
+};
+
+static int amlogic_cpufreq_get_bin(struct device *dev)
+{
+	struct meson_sm_firmware *fw;
+	s32 bin;
+	int ret;
+
+	struct device_node *sm_np __free(device_node) =
+		of_parse_phandle(dev->of_node, "amlogic,secure-monitor", 0);
+	if (!sm_np)
+		return dev_err_probe(dev, -ENODEV,
+				     "Failed to get the secure monitor\n");
+
+	fw = meson_sm_get(sm_np);
+	if (!fw)
+		return -EPROBE_DEFER;
+
+	ret = meson_sm_call(fw, SM_GET_DVFS_TABLE_INDEX, &bin, 0, 0, 0, 0, 0);
+	if (ret)
+		return dev_err_probe(dev, ret, "Failed to read the CPU bin\n");
+
+	if (bin < 0)
+		return dev_err_probe(dev, -EINVAL,
+				     "Invalid CPU bin %d\n", bin);
+
+	return bin;
+}
+
+static void amlogic_cpufreq_clear_config(struct amlogic_cpufreq_priv *priv)
+{
+	unsigned int cpu;
+
+	for_each_present_cpu(cpu)
+		dev_pm_opp_clear_config(priv->opp_tokens[cpu]);
+}
+
+static int amlogic_cpufreq_probe(struct platform_device *pdev)
+{
+	char name[] = "binXXXXXXXXXXX"; /* Integers can take 11 chars max */
+	struct dev_pm_opp_config config = {};
+	struct amlogic_cpufreq_priv *priv;
+	struct device *cpu_dev;
+	unsigned int cpu;
+	int bin, ret;
+
+	bin = amlogic_cpufreq_get_bin(&pdev->dev);
+	if (bin < 0)
+		return bin;
+
+	priv = devm_kzalloc(&pdev->dev,
+			    struct_size(priv, opp_tokens, num_possible_cpus()),
+			    GFP_KERNEL);
+	if (!priv)
+		return -ENOMEM;
+
+	snprintf(name, sizeof(name), "bin%d", bin);
+	config.prop_name = name;
+
+	for_each_present_cpu(cpu) {
+		cpu_dev = get_cpu_device(cpu);
+		if (!cpu_dev) {
+			ret = -ENODEV;
+			goto err_clear_config;
+		}
+
+		ret = dev_pm_opp_set_config(cpu_dev, &config);
+		if (ret < 0)
+			goto err_clear_config;
+
+		priv->opp_tokens[cpu] = ret;
+	}
+
+	priv->cpufreq_dt_pdev = platform_device_register_simple("cpufreq-dt",
+								-1, NULL, 0);
+	if (IS_ERR(priv->cpufreq_dt_pdev)) {
+		ret = dev_err_probe(&pdev->dev, PTR_ERR(priv->cpufreq_dt_pdev),
+				    "Failed to register cpufreq-dt\n");
+		goto err_clear_config;
+	}
+
+	platform_set_drvdata(pdev, priv);
+
+	dev_info(&pdev->dev, "Using CPU bin %d voltages\n", bin);
+
+	return 0;
+
+err_clear_config:
+	amlogic_cpufreq_clear_config(priv);
+	return ret;
+}
+
+static void amlogic_cpufreq_remove(struct platform_device *pdev)
+{
+	struct amlogic_cpufreq_priv *priv = platform_get_drvdata(pdev);
+
+	platform_device_unregister(priv->cpufreq_dt_pdev);
+	amlogic_cpufreq_clear_config(priv);
+}
+
+static const struct of_device_id amlogic_cpufreq_match_list[] = {
+	{ .compatible = "amlogic,s4-cpu-operating-points" },
+	{}
+};
+MODULE_DEVICE_TABLE(of, amlogic_cpufreq_match_list);
+
+static struct platform_driver amlogic_cpufreq_driver = {
+	.probe = amlogic_cpufreq_probe,
+	.remove = amlogic_cpufreq_remove,
+	.driver = {
+		.name = "amlogic-cpufreq",
+		.of_match_table = amlogic_cpufreq_match_list,
+	},
+};
+module_platform_driver(amlogic_cpufreq_driver);
+
+MODULE_AUTHOR("Martin Blumenstingl <martin.blumenstingl@googlemail.com>");
+MODULE_DESCRIPTION("Amlogic binned CPU frequency scaling driver");
+MODULE_LICENSE("GPL");
diff --git a/drivers/cpufreq/cpufreq-dt-platdev.c b/drivers/cpufreq/cpufreq-dt-platdev.c
index 371ca1fe9020..7caf071ae021 100644
--- a/drivers/cpufreq/cpufreq-dt-platdev.c
+++ b/drivers/cpufreq/cpufreq-dt-platdev.c
@@ -115,6 +115,8 @@ static const struct of_device_id blocklist[] __initconst = {
 	{ .compatible = "allwinner,sun50i-h618", },
 	{ .compatible = "allwinner,sun50i-h700", },
 
+	{ .compatible = "amlogic,s4", },
+
 	{ .compatible = "apple,arm-platform", },
 
 	{ .compatible = "arm,vexpress", },
