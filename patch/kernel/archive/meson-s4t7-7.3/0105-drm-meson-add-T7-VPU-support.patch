+		writel_relaxed(priv->viu.osd1_bld_v_scope,
+			       priv->io_base + _REG(VPP_OSD1_BLD_V_SCOPE));
+	} else {
+		writel_bits_relaxed(VIU_OSD1_POSTBLD_SRC_MASK,
+				    VIU_OSD1_POSTBLD_SRC_OSD1,
+				    priv->io_base + _REG(OSD1_BLEND_SRC_CTRL));
+	}
 }
 
