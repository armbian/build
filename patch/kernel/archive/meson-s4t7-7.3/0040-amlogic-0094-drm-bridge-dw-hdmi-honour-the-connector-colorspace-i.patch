From f81e71a7dddd8c41ab8f727388fea010c33e9bb5 Mon Sep 17 00:00:00 2001
From: Gus Bourg <gus@bourg.net>
Date: Wed, 2 Sep 2026 17:30:00 -0700
Subject: [PATCH 094/210] drm/bridge: dw-hdmi: honour the connector colorspace
 in the AVI infoframe

The AVI infoframe colorimetry is derived from the output encoding and
can only signal BT.601 or BT.709, so a colorspace selected through the
connector Colorspace property, such as BT.2020 for HDR, never reaches
the sink.

Set the colorimetry with drm_hdmi_avi_infoframe_colorimetry() when the
connector state carries a non-default colorspace.

Signed-off-by: Gus Bourg <gus@bourg.net>
---
 drivers/gpu/drm/bridge/synopsys/dw-hdmi.c | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/drivers/gpu/drm/bridge/synopsys/dw-hdmi.c b/drivers/gpu/drm/bridge/synopsys/dw-hdmi.c
index 48d0408efd17..43bee72dc4e2 100644
--- a/drivers/gpu/drm/bridge/synopsys/dw-hdmi.c
+++ b/drivers/gpu/drm/bridge/synopsys/dw-hdmi.c
@@ -1795,6 +1795,10 @@ static void hdmi_config_AVI(struct dw_hdmi *hdmi,
 			HDMI_EXTENDED_COLORIMETRY_XV_YCC_601;
 	}
 
+	if (connector->state &&
+	    connector->state->colorspace != DRM_MODE_COLORIMETRY_DEFAULT)
+		drm_hdmi_avi_infoframe_colorimetry(&frame, connector->state);
+
 	/*
 	 * The Designware IP uses a different byte format from standard
 	 * AVI info frames, though generally the bits are in the correct
-- 
