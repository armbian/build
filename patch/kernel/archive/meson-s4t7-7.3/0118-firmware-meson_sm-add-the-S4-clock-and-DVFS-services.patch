From a3c10e52247fbeadf53a9d4c8a06102ad3f4b586 Mon Sep 17 00:00:00 2001
From: Christian Hewitt <christianshewitt@gmail.com>
Date: Sun, 4 Oct 2026 12:59:16 +0000
Subject: [PATCH 194/210] firmware: meson_sm: add the S4 clock and DVFS
 services

On S4 the sys_pll and CPU clock registers are only writable from the
secure world. The BL31 firmware exposes two services for this: function
0x82000098 programs the PLLs and 0x82000099 reads and programs the CPU
clock tree. Each takes a sub-function ID as its first argument.

S4 chips are also binned at manufacture and the bin is stored in efuse.
Function 0x82000088 returns the index of the CPU DVFS table the chip
should use. Higher indices are better silicon that runs the same
frequencies at lower voltages.

Add command indices for all three so the clock and cpufreq drivers can
use them.

Assisted-by: Claude:claude-opus-5-5
Signed-off-by: Christian Hewitt <christianshewitt@gmail.com>
---
 drivers/firmware/meson/meson_sm.c       | 3 +++
 include/linux/firmware/meson/meson_sm.h | 3 +++
 2 files changed, 6 insertions(+)

diff --git a/drivers/firmware/meson/meson_sm.c b/drivers/firmware/meson/meson_sm.c
index ab9751a59b55..cb6bf5ae78c9 100644
--- a/drivers/firmware/meson/meson_sm.c
+++ b/drivers/firmware/meson/meson_sm.c
@@ -48,6 +48,9 @@ static const struct meson_sm_chip gxbb_chip = {
 		CMD(SM_THERMAL_CALIB_READ,	0x82000047),
 		CMD(SM_A1_PWRC_SET,		0x82000093),
 		CMD(SM_A1_PWRC_GET,		0x82000095),
+		CMD(SM_PLL_CLK,			0x82000098),
+		CMD(SM_CPU_CLK,			0x82000099),
+		CMD(SM_GET_DVFS_TABLE_INDEX,	0x82000088),
 		{ /* sentinel */ },
 	},
 };
diff --git a/include/linux/firmware/meson/meson_sm.h b/include/linux/firmware/meson/meson_sm.h
index 3ebc2bd9a976..5543cbddf776 100644
--- a/include/linux/firmware/meson/meson_sm.h
+++ b/include/linux/firmware/meson/meson_sm.h
@@ -15,6 +15,9 @@ enum {
 	SM_THERMAL_CALIB_READ,
 	SM_A1_PWRC_SET,
 	SM_A1_PWRC_GET,
+	SM_PLL_CLK,
+	SM_CPU_CLK,
+	SM_GET_DVFS_TABLE_INDEX,
 };
 
 struct meson_sm_firmware;
