From fc66d7877eae009b4b064d7dbb25f38addb7433e Mon Sep 17 00:00:00 2001
From: Christian Hewitt <christianshewitt@gmail.com>
Date: Sat, 3 Oct 2026 14:44:53 +0000
Subject: [PATCH 185/210] dt-bindings: thermal: amlogic: add S4 compatible

The S4 SoC family thermal sensor reads its calibration data from the
secure monitor with the same layout as T7, so use T7 as the fallback.

Assisted-by: Claude:claude-opus-5-5
Signed-off-by: Christian Hewitt <christianshewitt@gmail.com>
---
 Documentation/devicetree/bindings/thermal/amlogic,thermal.yaml | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/Documentation/devicetree/bindings/thermal/amlogic,thermal.yaml b/Documentation/devicetree/bindings/thermal/amlogic,thermal.yaml
index 8cfa44dcda58..e05bc26a0624 100644
--- a/Documentation/devicetree/bindings/thermal/amlogic,thermal.yaml
+++ b/Documentation/devicetree/bindings/thermal/amlogic,thermal.yaml
@@ -21,6 +21,9 @@ properties:
               - amlogic,g12a-cpu-thermal
               - amlogic,g12a-ddr-thermal
           - const: amlogic,g12a-thermal
+      - items:
+          - const: amlogic,s4-thermal
+          - const: amlogic,t7-thermal
       - enum:
           - amlogic,a1-cpu-thermal
           - amlogic,t7-thermal
