From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Igor Pecovnik <igor@armbian.com>
Date: Sun, 27 Sep 2026 12:00:00 +0200
Subject: ARM: dts: exynos: odroid-xu4: describe on-board RTL8153 ethernet

The XU4 has no on-SoC ethernet; its gigabit port is an RTL8153 USB3
bridge soldered on the SuperSpeed root port of usbdrd_dwc3_1. Without a
DT node, udev can only name it after its MAC (enx001e06xxxxxx).

Describe the device and its interface under the DWC3 node and add an
ethernet0 alias pointing to the interface, so the netdev gets an of_node
and systemd assigns the stable onboard name end0.

Signed-off-by: Igor Pecovnik <igor@armbian.com>
---
--- a/arch/arm/boot/dts/samsung/exynos5422-odroidxu4.dts
+++ b/arch/arm/boot/dts/samsung/exynos5422-odroidxu4.dts
@@ -17,6 +17,10 @@
 	model = "Hardkernel ODROID XU4";
 	compatible = "hardkernel,odroid-xu4", "samsung,exynos5800", "samsung,exynos5";
 
+	aliases {
+		ethernet0 = &ethernet;
+	};
+
 	led-controller {
 		compatible = "pwm-leds";
 
@@ -90,6 +94,30 @@
 
 &usbdrd_dwc3_1 {
 	dr_mode = "host";
+	#address-cells = <1>;
+	#size-cells = <0>;
+
+	/*
+	 * On-board RTL8153 USB3 gigabit ethernet, on the SuperSpeed root
+	 * port (raw xHCI port 2; port 1 is the USB2 side).
+	 */
+	usb_ethernet: ethernet@2 {
+		compatible = "usbbda,8153";
+		reg = <2>;
+		#address-cells = <2>;
+		#size-cells = <0>;
+
+		/*
+		 * The RTL8153 has two configurations, so its interface does
+		 * not share the device node and has to be described on its
+		 * own. The ethernet0 alias points here, giving the netdev a
+		 * DT node: systemd names it end0.
+		 */
+		ethernet: interface@0,1 {
+			compatible = "usbifbda,8153.config1.0";
+			reg = <0 1>;
+		};
+	};
 };
 
 &i2c_1 { 
