-static int team_nl_cmd_options_set(struct sk_buff *skb, struct genl_info *info)
-{
-	struct team *team;
-	int err = 0;
-	int i;
-	struct nlattr *nl_option;
-
-	rtnl_lock();
-
-	team = team_nl_team_get(info);
