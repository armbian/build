-		return -ENOMEM;
-
-	hdr = genlmsg_put(msg, info->snd_portid, info->snd_seq,
-			  &team_nl_family, 0, TEAM_CMD_NOOP);
-	if (!hdr) {
-		err = -EMSGSIZE;
-		goto err_msg_put;
-	}
-
-	genlmsg_end(msg, hdr);
-
-	return genlmsg_unicast(genl_info_net(info), msg, info->snd_portid);
