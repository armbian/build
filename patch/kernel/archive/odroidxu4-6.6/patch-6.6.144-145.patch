-				break;
-			}
-			goto errout;
-		}
-		i++;
-	}
-
-	nla_nest_end(skb, option_list);
-	genlmsg_end(skb, hdr);
-	if (incomplete)
-		goto start_again;
-
-send_done:
-	nlh = nlmsg_put(skb, portid, seq, NLMSG_DONE, 0, flags | NLM_F_MULTI);
-	if (!nlh) {
