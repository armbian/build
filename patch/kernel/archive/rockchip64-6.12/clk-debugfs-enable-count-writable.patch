From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ARC-MX <wmx129674@126.com>
Date: Wed, 04 Nov 2026 18:22:32 +0800
Subject: [PATCH] clk: allow writing clk_enable_count from debugfs

Rockchip vendor kernels expose clk_enable_count as writable and userspace
bring-up tools (npu_powerctrl) drive clocks by writing 1/0 there.  Upstream
exposes it 0444, so those writes fail with EIO.  Make it 0644 and call
clk_prepare_enable()/clk_disable_unprepare(); a write of 0 only releases
refcounts taken through this file.

Signed-off-by: ARC-MX <wmx129674@126.com>
---
 1 file changed, 45 insertions(+), 1 deletion(-)

diff --git a/drivers/clk/clk.c b/drivers/clk/clk.c
index 5b4ab9419..03c2a552c 100644
--- a/drivers/clk/clk.c
+++ b/drivers/clk/clk.c
@@ -3510,6 +3510,49 @@ DEFINE_DEBUGFS_ATTRIBUTE(clk_prepare_enable_fops, clk_prepare_enable_get,
 #define clk_phase_mode	0644
 #endif
 
+/*
+ * Rockchip's vendor kernels expose /sys/kernel/debug/clk/<name>/clk_enable_count
+ * as writable, and userspace bring-up tools (e.g. npu_powerctrl for the
+ * RK3399Pro NPU) drive clocks by writing 1/0 there.  Upstream only exposes the
+ * refcount read-only, which makes those tools fail with EIO.
+ *
+ * Keep upstream's read (the raw enable_count) and add the vendor write
+ * semantics: a write of non-zero prepares and enables the clock, zero
+ * unprepares and disables it.  Enabling also recurses into parents in the
+ * clock core, so writing to a gate-less mux such as clk_wifi_pmu still opens
+ * the gate on its parent clk_wifi_div.
+ */
+static int clk_enable_count_get(void *data, u64 *val)
+{
+	struct clk_core *core = data;
+
+	*val = core->enable_count;
+	return 0;
+}
+
+static int clk_enable_count_set(void *data, u64 val)
+{
+	struct clk_core *core = data;
+	int ret = 0;
+
+	if (val) {
+		ret = clk_prepare_enable(core->hw->clk);
+	} else if (core->enable_count > 0) {
+		/*
+		 * Only release an enable this file itself took.  A clock the
+		 * bring-up tool never enabled (e.g. rk808-clkout2, kept
+		 * prepared by sdio-pwrseq) must not be torn down by a stray
+		 * "write 0".
+		 */
+		clk_disable_unprepare(core->hw->clk);
+	}
+
+	return ret;
+}
+
+DEFINE_DEBUGFS_ATTRIBUTE(clk_enable_count_fops, clk_enable_count_get,
+			 clk_enable_count_set, "%llu\n");
+
 static int clk_rate_get(void *data, u64 *val)
 {
 	struct clk_core *core = data;
@@ -3730,7 +3773,8 @@ static void clk_debug_create_one(struct clk_core *core, struct dentry *pdentry)
 			    &clk_phase_fops);
 	debugfs_create_file("clk_flags", 0444, root, core, &clk_flags_fops);
 	debugfs_create_u32("clk_prepare_count", 0444, root, &core->prepare_count);
-	debugfs_create_u32("clk_enable_count", 0444, root, &core->enable_count);
+	debugfs_create_file("clk_enable_count", 0644, root, core,
+			    &clk_enable_count_fops);
 	debugfs_create_u32("clk_protect_count", 0444, root, &core->protect_count);
 	debugfs_create_u32("clk_notifier_count", 0444, root, &core->notifier_count);
 	debugfs_create_file("clk_duty_cycle", 0444, root, core,
