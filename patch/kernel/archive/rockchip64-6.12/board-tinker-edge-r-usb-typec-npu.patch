From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ARC-MX <wmx129674@126.com>
Date: Wed, 04 Nov 2026 18:22:32 +0800
Subject: [PATCH] arm64: dts: rk3399pro-tinker-edge-r: fix Type-C/USB for the NPU

fusb302 cannot resolve its Type-C supplier, so rockchip-usb2phy's OTG
port fails with -EINVAL and every USB controller the RK3399Pro NPU hangs
off stays in probe deferral.  Add the connector child node tcpm reads
extcon-cables from, the fcs,int_n GPIO property, and the USB3 autosuspend
quirk the vendor DTS carries.

Signed-off-by: ARC-MX <wmx129674@126.com>
---
 1 file changed, 43 insertions(+), 0 deletions(-)

diff --git a/arch/arm64/boot/dts/rockchip/rk3399pro-tinker-edge-r.dts b/arch/arm64/boot/dts/rockchip/rk3399pro-tinker-edge-r.dts
index 6e4b86c..5fc825a 100644
--- a/arch/arm64/boot/dts/rockchip/rk3399pro-tinker-edge-r.dts
+++ b/arch/arm64/boot/dts/rockchip/rk3399pro-tinker-edge-r.dts
@@ -8,6 +8,7 @@
 
 /dts-v1/;
 #include <dt-bindings/input/linux-event-codes.h>
+#include <dt-bindings/usb/pd.h>
 #include <dt-bindings/pwm/pwm.h>
 #include "rk3399.dtsi"
 
@@ -713,9 +714,49 @@
 		pinctrl-names = "default";
 		pinctrl-0 = <&fusb0_int>;
 		int-n-gpios = <&gpio1 RK_PA2 GPIO_ACTIVE_HIGH>;
+		/*
+		 * fusb302 >= 6.x does devm_gpiod_get(dev, "fcs,int_n"), so it looks
+		 * for "fcs,int_n-gpios"; without it probe fails with -ENOENT and the
+		 * Type-C supplier stays unresolved, which keeps usb2phy@e450 and the
+		 * NPU's USB2 port (fe380000/fe3a0000) in probe deferral.
+		 */
+		fcs,int_n-gpios = <&gpio1 RK_PA2 GPIO_ACTIVE_HIGH>;
 		vbus-5v-gpios = <&gpio4 RK_PD1 GPIO_ACTIVE_HIGH>;
 		vbus2-5v-gpios = <&gpio2 RK_PD2 GPIO_ACTIVE_HIGH>;
 		status = "okay";
+
+		/*
+		 * fusb302 only looks at a child node named "connector" for the
+		 * port description (fusb302_fwnode_get ->
+		 * device_get_named_child_node(dev, "connector")); anything put
+		 * on this node itself is ignored.  Without a connector child
+		 * tcpm falls back to default_supported_cables = {EXTCON_NONE},
+		 * so rockchip-usb2phy's OTG port gets -EINVAL from
+		 * devm_extcon_register_notifier(EXTCON_USB_HOST) and the whole
+		 * usb2phy@e450 probe fails:
+		 *
+		 *   register USB HOST notifier failed
+		 *   probe with driver rockchip-usb2phy failed with error -22
+		 *
+		 * which leaves fe800000.usb, fe380000.usb and fe3a0000.usb -
+		 * the ports the RK3399Pro NPU hangs off - in probe deferral
+		 * forever, so npu_upgrade can never see the maskrom device.
+		 *
+		 * Roles/PDOs match ASUS's own DTS for this board; the cable ids
+		 * match rk3399-nanopc-t4 / rk3399-orangepi-4-lts (USB, USB_HOST,
+		 * SDP, CDP, DCP, SLOW_CHARGER, ACA, AUDIO_ADAPTER).
+		 */
+		usb_con: connector {
+			compatible = "usb-c-connector";
+			label = "USB-C";
+			data-role = "dual";
+			power-role = "dual";
+			try-power-role = "sink";
+			op-sink-microwatt = <1000000>;
+			sink-pdos = <PDO_FIXED(5000, 500, PDO_FIXED_USB_COMM)>;
+			source-pdos = <PDO_FIXED(5000, 1500, PDO_FIXED_USB_COMM)>;
+			extcon-cables = <1 2 5 6 9 10 12 44>;
+		};
 	};
 
 	vdd_gpu: fan53555@60 {
@@ -920,12 +961,14 @@
 
 &usbdrd_dwc3_0 {
 	dr_mode = "otg";
+	snps,dis-u3-autosuspend-quirk;
 	status = "okay";
 };
 
 &usbdrd_dwc3_1 {
 	status = "okay";
 	dr_mode = "host";
+	snps,dis-u3-autosuspend-quirk;
 };
 
 &vpu {
