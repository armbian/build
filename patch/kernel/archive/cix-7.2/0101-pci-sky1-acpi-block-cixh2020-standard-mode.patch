From 1925deb2bcf1044ffdfef1a9b0279a01c3b2091a Mon Sep 17 00:00:00 2001
From: Jason Perlow <jperlow@gmail.com>
Date: Tue, 7 Jul 2026 11:56:02 -0400
Subject: [PATCH] pci: sky1-acpi: block CIXH2020 platform devices in standard
 PCIe mode

With sky1_pcie_native=off the PNP0A08 hosts enumerate via ECAM, but
CIXH2020 fell through to default platform enumeration and the vendor
native driver probed it anyway -- its early controller reset kills the
live firmware-configured links, leaving the root ports config-dead
(D3cold-inaccessible) and SError-panicking the first NVMe access.
Standard mode now claims CIXH2020 without creating a platform device.
---
 drivers/pci/controller/cadence/pci-sky1-acpi.c | 18 ++++++++++++++++--
 1 file changed, 16 insertions(+), 2 deletions(-)

diff --git a/drivers/pci/controller/cadence/pci-sky1-acpi.c b/drivers/pci/controller/cadence/pci-sky1-acpi.c
index 251032d4e056..06fc929fbb0e 100644
--- a/drivers/pci/controller/cadence/pci-sky1-acpi.c
+++ b/drivers/pci/controller/cadence/pci-sky1-acpi.c
@@ -160,16 +160,30 @@ static int sky1_cixh2020_create_pdev(struct acpi_device *adev)
 static int sky1_acpi_scan_attach(struct acpi_device *adev,
 				 const struct acpi_device_id *id)
 {
-	if (!sky1_acpi_detected || !sky1_pcie_native)
+	if (!sky1_acpi_detected)
 		return 0;
 
 	if (!strcmp(id->id, "PNP0A08")) {
+		if (!sky1_pcie_native)
+			return 0; /* standard ACPI/ECAM host path */
 		dev_info(&adev->dev,
 			 "Sky1: blocking PNP0A08, CIXH2020 will handle\n");
 		return 1;
 	}
 
-	/* CIXH2020 — create platform device with filtered resources */
+	/*
+	 * CIXH2020: in standard mode the firmware-configured controller
+	 * must not be touched -- block platform device creation so the
+	 * vendor native driver cannot probe (its early controller reset
+	 * kills the live links). In native mode, create the filtered
+	 * platform device as usual.
+	 */
+	if (!sky1_pcie_native) {
+		dev_info(&adev->dev,
+			 "Sky1: blocking CIXH2020 (standard PCIe mode)\n");
+		return 1;
+	}
+
 	return sky1_cixh2020_create_pdev(adev);
 }
 
