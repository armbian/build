diff --git a/drivers/soc/cix/acpi/acpi_resource_lookup.c b/drivers/soc/cix/acpi/acpi_resource_lookup.c
new file mode 100644
index 000000000000..667b714709c9
--- /dev/null
+++ b/drivers/soc/cix/acpi/acpi_resource_lookup.c
@@ -0,0 +1,561 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ *Copyright 2024 Cix Technology Group Co., Ltd.
+ */
+
+#include <linux/acpi.h>
+#include <linux/cma.h>
+#include <linux/device.h>
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/platform_device.h>
+#include <linux/reset-controller.h>
+#include <linux/version.h>
+
+#include <linux/../../mm/cma.h>
+
+extern int dma_declare_coherent_memory(struct device *dev,
+		phys_addr_t phys_addr, dma_addr_t device_addr, size_t size);
+
+static struct acpi_device *acpi_obj_path_to_adev(union acpi_object *obj)
+{
+        struct acpi_device *adev = NULL;
+        char *path;
+        acpi_handle handle;
+        acpi_status status;
+
+        if (!obj || !obj->string.length)
+                return NULL;
+
+        path = obj->string.pointer;
+        status = acpi_get_handle(NULL, path, &handle);
+        if (ACPI_FAILURE(status)) {
+                return NULL;
+        }
+
+#if LINUX_VERSION_CODE <= KERNEL_VERSION(6, 0, 0)
+        adev = acpi_bus_get_acpi_device(handle);
+#else
+        adev = acpi_fetch_acpi_dev(handle);
+#endif
+
+        return adev;
+}
+
+static struct device *acpi_obj_str_platform_device(const union acpi_object *obj)
+{
+	struct device *dev;
+	struct acpi_device *adev;
+
+	adev = acpi_obj_path_to_adev((union acpi_object *)obj);
+	if (!adev)
+		return NULL;
+
+	dev = bus_find_device_by_acpi_dev(&platform_bus_type, adev);
+	if (!dev)
+		return NULL;
+
+	return dev;
+}
+
+static const char *acpi_obj_str_to_devname(const union acpi_object *obj)
+{
+	struct device *dev;
+
+	dev = acpi_obj_str_platform_device(obj);
+	if (!dev)
+		return NULL;
+
+	return dev_name(dev);
+}
+
+static struct device *acpi_obj_ref_platform_device(const union acpi_object *obj)
+{
+	struct device *dev;
+	struct acpi_device *adev;
+
+	adev = acpi_fetch_acpi_dev(obj->reference.handle);
+	if (!adev)
+		return NULL;
+
+	dev = bus_find_device_by_acpi_dev(&platform_bus_type, adev);
+	if (!dev)
+		return NULL;
+
+	return dev;
+}
+
+static const char *acpi_obj_ref_to_devname(const union acpi_object *obj)
+{
+	struct device *dev;
+
+	dev = acpi_obj_ref_platform_device(obj);
+	if (!dev)
+		return NULL;
+
+	return dev_name(dev);
+}
+
+static struct device *acpi_obj_to_platform_device(const union acpi_object *obj)
+{
+	if (!obj)
+		return NULL;
+
+	if (obj->type == ACPI_TYPE_LOCAL_REFERENCE)
+		return acpi_obj_ref_platform_device(obj);
+	else if (obj->type == ACPI_TYPE_STRING)
+		return acpi_obj_str_platform_device(obj);
+	else
+		return NULL;
+}
+
+static const char *acpi_obj_to_devname(const union acpi_object *obj)
+{
+	if (!obj)
+		return NULL;
+
+	if (obj->type == ACPI_TYPE_LOCAL_REFERENCE)
+		return acpi_obj_ref_to_devname(obj);
+	else if (obj->type == ACPI_TYPE_STRING)
+		return acpi_obj_str_to_devname(obj);
+	else
+		return NULL;
+}
+
+static int reset_lookup_handle(acpi_handle handle,
+			const union acpi_object *obj, void *data)
+{
+	struct device *dev = data;
+	const union acpi_object *child, *el;
+	struct reset_control_lookup *lookup;
+	int i, pcnt, count = 0;
+	struct acpi_device *adev = acpi_fetch_acpi_dev(handle);
+
+	if (!adev || !adev->status.present)
+		return -ENODEV;
+
+	for (i = 0; i < obj->package.count; i++) {
+		child = &obj->package.elements[i];
+		pcnt = child->package.count;
+
+		/* package: <provider,ref>, <index>, <user,ref>, [<con-id>] */
+		if (pcnt < 3)
+			continue;
+
+		el = child->package.elements;
+
+		if ((el[0].type != ACPI_TYPE_LOCAL_REFERENCE
+			    && el[0].type != ACPI_TYPE_STRING)
+		    || (el[1].type != ACPI_TYPE_INTEGER)
+		    || (el[2].type != ACPI_TYPE_LOCAL_REFERENCE
+			    && el[2].type != ACPI_TYPE_STRING)
+		    || (pcnt > 3 && (el[3].type != ACPI_TYPE_STRING)))
+			continue;
+
+		lookup = devm_kzalloc(dev, sizeof(*lookup), GFP_KERNEL);
+		if (!lookup)
+			return -ENOMEM;
+		INIT_LIST_HEAD(&lookup->list);
+		lookup->provider = acpi_obj_to_devname(&el[0]);
+		lookup->index = el[1].integer.value;
+		lookup->dev_id = acpi_obj_to_devname(&el[2]);
+		lookup->con_id = pcnt > 3 ?
+			devm_kstrdup(dev, el[3].string.pointer, GFP_KERNEL)
+			: NULL;
+
+		if (!lookup->provider || (!lookup->dev_id && !lookup->con_id))
+			continue;
+
+		reset_controller_add_lookup(lookup, 1);
+
+		dev_dbg(&adev->dev,
+			"rst lookup: prov[%s] idx[%d] dev[%s] con[%s]\n",
+			lookup->provider, lookup->index,
+			lookup->dev_id, lookup->con_id);
+		count++;
+	}
+
+	dev_dbg(&adev->dev, "reset lookup handle done %d/%d",
+			count, obj->package.count);
+
+	return count;
+}
+
+static int cma_init_reserved_memory(phys_addr_t base, phys_addr_t size,
+				    unsigned int order_per_bit,
+				    const char *name,
+				    struct cma **res_cma)
+{
+	struct cma *cma;
+
+	/* Sanity checks */
+	if (cma_area_count == ARRAY_SIZE(cma_areas)) {
+		pr_err("Not enough slots for CMA reserved regions!\n");
+		return -ENOSPC;
+	}
+
+	if (!size || !memblock_is_region_reserved(base, size))
+		return -EINVAL;
+
+	/* alignment should be aligned with order_per_bit */
+	if (!IS_ALIGNED(CMA_MIN_ALIGNMENT_PAGES, 1 << order_per_bit))
+		return -EINVAL;
+
+	/* ensure minimal alignment required by mm core */
+	if (!IS_ALIGNED(base | size, CMA_MIN_ALIGNMENT_BYTES))
+		return -EINVAL;
+
+	/*
+	 * Each reserved area must be initialised later, when more kernel
+	 * subsystems (like slab allocator) are available.
+	 */
+	cma = &cma_areas[cma_area_count];
+
+	if (name)
+		snprintf(cma->name, CMA_MAX_NAME, name);
+	else
+		snprintf(cma->name, CMA_MAX_NAME,  "cma%d\n", cma_area_count);
+
+	cma->base_pfn = PFN_DOWN(base);
+	cma->count = size >> PAGE_SHIFT;
+	cma->order_per_bit = order_per_bit;
+	*res_cma = cma;
+	cma_area_count++;
+	totalcma_pages += (size / PAGE_SIZE);
+
+	return 0;
+}
+
+static int rmem_dev_set_dma(struct device *dev, phys_addr_t base, size_t size)
+{
+	if (!dev || dev->dma_mem)
+		return -EINVAL;
+
+	if (!memblock_is_region_memory(base, size)
+		|| memblock_is_map_memory(base))
+		return -EFAULT;
+
+	return dma_declare_coherent_memory(dev, base, base, size);
+}
+
+static int rmem_dev_set_cma(struct device *dev,
+			phys_addr_t base, phys_addr_t size)
+{
+	struct cma *cma;
+	int ret;
+
+	if (!dev || dev->cma_area)
+		return -EINVAL;
+
+	if (!memblock_is_region_reserved(base, size))
+		return -EFAULT;
+
+	ret = cma_init_reserved_memory(base, size, 0, dev_name(dev), &cma);
+	if (ret)
+		return ret;
+
+	dev->cma_area = cma;
+
+	return ret;
+}
+
+static int reserved_mem_lookup_handle(acpi_handle handle,
+			const union acpi_object *obj, void *data)
+{
+	struct device *rdev, *dev = data;
+	const union acpi_object *child, *el;
+	int i, pcnt, count = 0, ret;
+	phys_addr_t base, size;
+	struct acpi_device *adev = acpi_fetch_acpi_dev(handle);
+
+	if (!adev || !adev->status.present)
+		return -ENODEV;
+
+	for (i = 0; i < obj->package.count; i++) {
+		child = &obj->package.elements[i];
+		pcnt = child->package.count;
+
+		/* package: <base>, <size>, <type,string>, <dev,ref> */
+		if (pcnt != 4)
+			continue;
+
+		el = child->package.elements;
+
+		if ((el[0].type != ACPI_TYPE_INTEGER)
+		    || (el[1].type != ACPI_TYPE_INTEGER)
+		    || (el[2].type != ACPI_TYPE_STRING)
+		    || (el[3].type != ACPI_TYPE_LOCAL_REFERENCE
+			    && el[3].type != ACPI_TYPE_STRING))
+			continue;
+
+		base = el[0].integer.value;
+		size = el[1].integer.value;
+
+		rdev = acpi_obj_to_platform_device(&el[3]);
+		if (!rdev)
+			continue;
+
+		if (!strcmp(el[2].string.pointer, "no-map"))
+			ret = rmem_dev_set_dma(rdev, base, (size_t)size);
+		else if (!strcmp(el[2].string.pointer, "reusable"))
+			ret = rmem_dev_set_cma(rdev, base, size);
+		else
+			ret = -EFAULT;
+		if (ret)
+			dev_err(dev, "rsv mem[%d] err: 0x%llX-0x%llX[%s]->[%s]",
+					i, base, size, el[2].string.pointer,
+					dev_name(rdev));
+
+		/*
+		 * To make it simple, there is no duplicates check, and the
+		 * dma memory won't be released in the device's life.
+		 */
+
+		dev_dbg(&adev->dev, "rsv mem [%d][%s]: 0x%llX-0x%llX[%s]->[%s]",
+				i, ret ? "fail" : "ok", base, size,
+				el[2].string.pointer, dev_name(rdev));
+
+		if (!ret)
+			count++;
+	}
+
+	dev_dbg(&adev->dev, "reserved memory lookup handle done %d/%d",
+				count, obj->package.count);
+
+	return count;
+}
+
+static int resource_name_lookup_handle(acpi_handle handle,
+			const union acpi_object *obj, void *data)
+{
+	struct device *rdev, *dev = data;
+	const union acpi_object *child, *el;
+	int i, pcnt, count = 0, index;
+	unsigned int type;
+	struct resource *res;
+	const char *name;
+	struct acpi_device *adev = acpi_fetch_acpi_dev(handle);
+
+	if (!adev || !adev->status.present)
+		return -ENODEV;
+
+	for (i = 0; i < obj->package.count; i++) {
+		child = &obj->package.elements[i];
+		pcnt = child->package.count;
+
+		/* package: <rdev>, <type>, <index>, <name> */
+		if (pcnt != 4)
+			continue;
+
+		el = child->package.elements;
+
+		if ((el[0].type != ACPI_TYPE_LOCAL_REFERENCE
+			    && el[0].type != ACPI_TYPE_STRING)
+		    || (el[1].type != ACPI_TYPE_INTEGER)
+		    || (el[2].type != ACPI_TYPE_INTEGER)
+		    || (el[3].type != ACPI_TYPE_STRING))
+			continue;
+
+		rdev = acpi_obj_to_platform_device(&el[0]);
+		type = el[1].integer.value;
+		index = el[2].integer.value;
+		name = devm_kstrdup(dev, el[3].string.pointer, GFP_KERNEL);
+		if (!rdev || !name)
+			continue;
+
+		res = platform_get_resource(to_platform_device(rdev),
+					type, index);
+		if (!res)
+			continue;
+		res->name = name;
+
+		if ((res->flags & IORESOURCE_IRQ)
+				&& (res->flags & IORESOURCE_DISABLED))
+			acpi_irq_get(ACPI_HANDLE(rdev), index, res);
+
+		dev_dbg(&adev->dev, "resource set name [%s][0x%x][%d]->[%s]",
+				dev_name(rdev), type, index, name);
+
+		count++;
+	}
+
+	dev_dbg(&adev->dev, "resource name lookup handle done %d/%d",
+			count, obj->package.count);
+
+	return count;
+}
+
+static int device_link_lookup_handle(acpi_handle handle,
+			const union acpi_object *obj, void *data)
+{
+	struct device *consumer, *supplier;
+	const union acpi_object *child, *el;
+	int i, pcnt, count = 0;
+	u32 flags;
+	struct acpi_device *adev = acpi_fetch_acpi_dev(handle);
+
+	if (!adev || !adev->status.present)
+		return -ENODEV;
+
+	for (i = 0; i < obj->package.count; i++) {
+		child = &obj->package.elements[i];
+		pcnt = child->package.count;
+
+		/* package: <supplier>, <consumer>, <flags> */
+		if (pcnt != 3)
+			continue;
+
+		el = child->package.elements;
+
+		if ((el[0].type != ACPI_TYPE_LOCAL_REFERENCE
+			    && el[0].type != ACPI_TYPE_STRING)
+		    || (el[1].type != ACPI_TYPE_LOCAL_REFERENCE
+			    && el[1].type != ACPI_TYPE_STRING)
+		    || (el[2].type != ACPI_TYPE_INTEGER))
+			continue;
+
+		supplier = acpi_obj_to_platform_device(&el[0]);
+		consumer = acpi_obj_to_platform_device(&el[1]);
+		flags = (u32)el[2].integer.value;
+
+		if (!supplier || !consumer)
+			continue;
+
+		device_link_add(consumer, supplier, flags);
+
+		dev_dbg(&adev->dev, "device link [%s]->[%s], flags[%u]",
+				dev_name(consumer), dev_name(supplier), flags);
+
+		count++;
+	}
+
+	dev_dbg(&adev->dev, "device link lookup handle done %d/%d",
+			count, obj->package.count);
+
+	return count;
+}
+
+static int acpi_res_lookup_handle(acpi_handle handle, const char *name,
+		int (*func)(acpi_handle handle,
+			const union acpi_object *obj, void *data),
+		void *data)
+{
+	struct acpi_buffer output = {ACPI_ALLOCATE_BUFFER, NULL};
+	int ret;
+	acpi_status status;
+
+	if (!name || !func)
+		return -EINVAL;
+
+	status = acpi_evaluate_object_typed(handle,
+			(acpi_string)name, NULL, &output, ACPI_TYPE_PACKAGE);
+	if (ACPI_FAILURE(status))
+		return -ENODEV;
+
+	ret = func(handle, (const union acpi_object *)output.pointer, data);
+	kfree(output.pointer);
+
+	return ret;
+}
+
+static int acpi_resource_lookup_device(acpi_handle handle, void *data)
+{
+	struct device *dev = data;
+	int ret;
+
+	/* reset lookup */
+	ret = acpi_res_lookup_handle(handle,
+				"RSTL", reset_lookup_handle, dev);
+	if (ret < 0 && ret != -ENODEV)
+		dev_err(dev, "reset lookup handle fail");
+
+	/* reserved memory lookup */
+	ret = acpi_res_lookup_handle(handle,
+				"RSVL", reserved_mem_lookup_handle, dev);
+	if (ret < 0 && ret != -ENODEV)
+		dev_err(dev, "reserved memmory lookup handle fail");
+
+	/* resource name lookup */
+	ret = acpi_res_lookup_handle(handle,
+				"RSNL", resource_name_lookup_handle, dev);
+	if (ret < 0 && ret != -ENODEV)
+		dev_err(dev, "resource name lookup handle fail");
+
+	/* device link lookup */
+	ret = acpi_res_lookup_handle(handle,
+				"DLKL", device_link_lookup_handle, dev);
+	if (ret < 0 && ret != -ENODEV)
+		dev_err(dev, "device link lookup handle fail");
+
+	/*
+	 * Since some resources maybe disabled in some platform, and the
+	 * handles in the lookup process with the hardware maybe fail.
+	 * But other handles witch bind some resources to the device driver
+	 * by using "devm_xxx" functions is still needed by other drivers.
+	 *
+	 * So just print error message instead of return error value to the
+	 * "probe" function, witch cause the resoruces release in the device
+	 * driver.
+	 */
+
+	return 0;
+}
+
+static acpi_status acpi_bus_res_scan(acpi_handle handle, u32 level,
+					void *context, void **ret_p)
+{
+	struct device *dev = context;
+	acpi_object_type acpi_type;
+
+	if (!dev)
+		return AE_OK;
+
+	if (ACPI_FAILURE(acpi_get_type(handle, &acpi_type)))
+		return AE_OK;
+
+	if (acpi_type != ACPI_TYPE_DEVICE)
+		return AE_OK;
+
+	acpi_resource_lookup_device(handle, dev);
+
+	return AE_OK;
+}
+
+static int acpi_resource_lookup_probe(struct platform_device *pdev)
+{
+	acpi_status status;
+
+	status = acpi_walk_namespace(ACPI_TYPE_ANY,
+				ACPI_ROOT_OBJECT, ACPI_UINT32_MAX,
+				acpi_bus_res_scan, NULL, &pdev->dev, NULL);
+
+	/* do not ensure every resource since differnt configs */
+	return 0;
+}
+
+static const struct acpi_device_id acpi_resource_lookup_match[] = {
+	{ "CIXA1019" },
+	{},
+};
+MODULE_DEVICE_TABLE(acpi, acpi_resource_lookup_match);
+
+static struct platform_driver acpi_resource_lookup_driver = {
+	.driver = {
+		.name = "acpi_resource_lookup",
+		.acpi_match_table = ACPI_PTR(acpi_resource_lookup_match),
+	},
+	.probe = acpi_resource_lookup_probe,
+};
+
+static int __init acpi_resource_lookup_init(void)
+{
+	if (acpi_disabled)
+		return -ENODEV;
+
+	return platform_driver_register(&acpi_resource_lookup_driver);
+}
+subsys_initcall(acpi_resource_lookup_init);
+
+MODULE_AUTHOR("Zichar Zhang <zichar.zhang@cixtech.com>");
+MODULE_DESCRIPTION("cix resource tables");
+MODULE_LICENSE("GPL v2");
diff --git a/drivers/soc/cix/acpi/cix-acpi-ec-fan.c b/drivers/soc/cix/acpi/cix-acpi-ec-fan.c
new file mode 100644
index 000000000000..7acf860dc0ce
--- /dev/null
+++ b/drivers/soc/cix/acpi/cix-acpi-ec-fan.c
@@ -0,0 +1,238 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Copyright 2026 Cix Technology Group Co., Ltd.
+ * CIX ACPI EC fan control over ASL methods.
+ */
+
+#include <linux/acpi.h>
+#include <linux/device.h>
+#include <linux/errno.h>
+#include <linux/kernel.h>
+#include <linux/mutex.h>
+#include <linux/platform_device.h>
+#include <linux/string.h>
+#include <linux/sysfs.h>
+
+#include "cix-acpi-ec.h"
+
+enum cix_aec_fan_mode_id {
+	CIX_AEC_FAN_MODE_MUTE = 0,
+	CIX_AEC_FAN_MODE_NORMAL,
+	CIX_AEC_FAN_MODE_MANUAL,
+	CIX_AEC_FAN_MODE_PERFORMANCE,
+	CIX_AEC_FAN_MODE_MAX,
+};
+
+struct cix_aec_fan_mode_desc {
+	const char *name;
+	const char *set_method;
+};
+
+static const struct cix_aec_fan_mode_desc cix_aec_fan_modes[CIX_AEC_FAN_MODE_MAX] = {
+	[CIX_AEC_FAN_MODE_MUTE] = {
+		.name = "mute",
+		.set_method = "SFMT",
+	},
+	[CIX_AEC_FAN_MODE_NORMAL] = {
+		.name = "normal",
+		.set_method = "SFAT",
+	},
+	[CIX_AEC_FAN_MODE_MANUAL] = {
+		.name = "manual",
+		.set_method = "SFMN",
+	},
+	[CIX_AEC_FAN_MODE_PERFORMANCE] = {
+		.name = "performance",
+		.set_method = "SFPF",
+	},
+};
+
+static int cix_aec_fan_set_mode(struct cix_aec *aec, int mode)
+{
+	acpi_status status;
+
+	if (mode < 0 || mode >= CIX_AEC_FAN_MODE_MAX)
+		return -EINVAL;
+	if (!cix_aec_fan_modes[mode].set_method)
+		return -EINVAL;
+
+	mutex_lock(&aec->lock);
+	status = acpi_evaluate_object(aec->handle,
+				      (acpi_string)cix_aec_fan_modes[mode].set_method,
+				      NULL, NULL);
+	if (!ACPI_FAILURE(status))
+		aec->fan_mode = mode;
+	mutex_unlock(&aec->lock);
+
+	return ACPI_FAILURE(status) ? -EIO : 0;
+}
+
+static int cix_aec_fan_set_pwm(struct cix_aec *aec, int duty, int type, int index)
+{
+	union acpi_object args[3];
+	struct acpi_object_list arg_list = {
+		.count = ARRAY_SIZE(args),
+		.pointer = args,
+	};
+	unsigned long long ret;
+	acpi_status status;
+
+	args[0].type = ACPI_TYPE_INTEGER;
+	args[0].integer.value = duty;
+	args[1].type = ACPI_TYPE_INTEGER;
+	args[1].integer.value = type;
+	args[2].type = ACPI_TYPE_INTEGER;
+	args[2].integer.value = index;
+
+	mutex_lock(&aec->lock);
+	status = acpi_evaluate_integer(aec->handle, "SFPW", &arg_list, &ret);
+	if (!ACPI_FAILURE(status) && ret == 0) {
+		aec->fan_duty = duty;
+		aec->fan_type = type;
+		aec->fan_index = index;
+		aec->fan_mode = CIX_AEC_FAN_MODE_MANUAL;
+	}
+	mutex_unlock(&aec->lock);
+	if (ACPI_FAILURE(status))
+		return -EIO;
+	if (ret != 0)
+		return -EIO;
+
+	return 0;
+}
+
+static int cix_aec_fan_get_pwm(struct cix_aec *aec)
+{
+	union acpi_object args[2];
+	struct acpi_object_list arg_list = {
+		.count = ARRAY_SIZE(args),
+		.pointer = args,
+	};
+	unsigned long long duty;
+	acpi_status status;
+
+	args[0].type = ACPI_TYPE_INTEGER;
+	args[0].integer.value = aec->fan_type;
+	args[1].type = ACPI_TYPE_INTEGER;
+	args[1].integer.value = aec->fan_index;
+
+	mutex_lock(&aec->lock);
+	status = acpi_evaluate_integer(aec->handle, "GFPW", &arg_list, &duty);
+	mutex_unlock(&aec->lock);
+	if (ACPI_FAILURE(status))
+		return -EIO;
+	if (duty == 0xFFFFFFFFULL)
+		return -EIO;
+
+	return (int)duty;
+}
+
+static ssize_t fan_mode_show(struct device *dev, struct device_attribute *attr,
+			     char *buf)
+{
+	struct cix_aec *aec = dev_get_drvdata(dev);
+
+	if (aec->fan_mode < 0 || aec->fan_mode >= CIX_AEC_FAN_MODE_MAX)
+		return -EINVAL;
+
+	return sysfs_emit(buf, "%s\n", cix_aec_fan_modes[aec->fan_mode].name);
+}
+
+static ssize_t fan_mode_store(struct device *dev, struct device_attribute *attr,
+			      const char *buf, size_t count)
+{
+	struct cix_aec *aec = dev_get_drvdata(dev);
+	int mode;
+	int ret;
+
+	for (mode = 0; mode < CIX_AEC_FAN_MODE_MAX; mode++) {
+		if (sysfs_streq(buf, cix_aec_fan_modes[mode].name))
+			break;
+	}
+	if (mode == CIX_AEC_FAN_MODE_MAX)
+		return -EINVAL;
+
+	ret = cix_aec_fan_set_mode(aec, mode);
+	if (ret)
+		return ret;
+
+	return count;
+}
+static DEVICE_ATTR_RW(fan_mode);
+
+static ssize_t fan_available_mode_show(struct device *dev,
+				       struct device_attribute *attr, char *buf)
+{
+	ssize_t len = 0;
+	int i;
+
+	for (i = 0; i < CIX_AEC_FAN_MODE_MAX; i++) {
+		len += scnprintf(buf + len, PAGE_SIZE - len, "%s%s",
+				 cix_aec_fan_modes[i].name,
+				 (i == CIX_AEC_FAN_MODE_MAX - 1) ? "\n" : " ");
+	}
+
+	return len;
+}
+static DEVICE_ATTR_RO(fan_available_mode);
+
+static ssize_t fan_pwm_show(struct device *dev, struct device_attribute *attr,
+			    char *buf)
+{
+	struct cix_aec *aec = dev_get_drvdata(dev);
+	int duty;
+
+	duty = cix_aec_fan_get_pwm(aec);
+	if (duty < 0)
+		return duty;
+
+	return sysfs_emit(buf, "%d\n", duty);
+}
+
+static ssize_t fan_pwm_store(struct device *dev, struct device_attribute *attr,
+			     const char *buf, size_t count)
+{
+	struct cix_aec *aec = dev_get_drvdata(dev);
+	int duty;
+	int type;
+	int index;
+	int ret;
+
+	ret = sscanf(buf, "%d %d %d", &duty, &type, &index);
+	if (ret != 3)
+		return -EINVAL;
+
+	ret = cix_aec_fan_set_pwm(aec, duty, type, index);
+	if (ret)
+		return ret;
+
+	return count;
+}
+static DEVICE_ATTR_RW(fan_pwm);
+
+static struct attribute *cix_aec_fan_attrs[] = {
+	&dev_attr_fan_mode.attr,
+	&dev_attr_fan_available_mode.attr,
+	&dev_attr_fan_pwm.attr,
+	NULL,
+};
+
+static const struct attribute_group cix_aec_fan_attr_group = {
+	.name = "fan",
+	.attrs = cix_aec_fan_attrs,
+};
+
+int cix_aec_fan_init(struct cix_aec *aec)
+{
+	aec->fan_mode = CIX_AEC_FAN_MODE_NORMAL;
+	aec->fan_type = 0;
+	aec->fan_index = 0;
+	aec->fan_duty = -1;
+
+	return sysfs_create_group(&aec->class_dev->kobj, &cix_aec_fan_attr_group);
+}
+
+void cix_aec_fan_exit(struct cix_aec *aec)
+{
+	sysfs_remove_group(&aec->class_dev->kobj, &cix_aec_fan_attr_group);
+}
diff --git a/drivers/soc/cix/acpi/cix-acpi-ec-gpio.c b/drivers/soc/cix/acpi/cix-acpi-ec-gpio.c
new file mode 100644
index 000000000000..ed3354318462
--- /dev/null
+++ b/drivers/soc/cix/acpi/cix-acpi-ec-gpio.c
@@ -0,0 +1,238 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Copyright 2026 Cix Technology Group Co., Ltd.
+ * CIX ACPI EC GPIO implementation over ASL methods.
+ */
+
+#include <linux/acpi.h>
+#include <linux/bitmap.h>
+#include <linux/bitops.h>
+#include <linux/device.h>
+#include <linux/errno.h>
+#include <linux/module.h>
+#include <linux/sysfs.h>
+#include "cix-acpi-ec.h"
+
+static int cix_aec_gpio_to_asl_num(unsigned int gpio)
+{
+	if (gpio >= CIX_AEC_GPIO_COUNT)
+		return -EINVAL;
+
+	if (gpio >= CIX_AEC_GPIO_GAP_START)
+		gpio += CIX_AEC_GPIO_GAP_SIZE;
+
+	return gpio;
+}
+
+static int cix_aec_gpio_write(acpi_handle handle, struct mutex *lock,
+			      unsigned int gpio, int value)
+{
+	union acpi_object args[2];
+	struct acpi_object_list arg_list = {
+		.count = ARRAY_SIZE(args),
+		.pointer = args,
+	};
+	acpi_status status;
+	int ec_gpio;
+
+	if (!handle || !lock)
+		return -EINVAL;
+
+	ec_gpio = cix_aec_gpio_to_asl_num(gpio);
+	if (ec_gpio < 0)
+		return ec_gpio;
+
+	args[0].type = ACPI_TYPE_INTEGER;
+	args[0].integer.value = ec_gpio;
+	args[1].type = ACPI_TYPE_INTEGER;
+	args[1].integer.value = !!value;
+
+	mutex_lock(lock);
+	status = acpi_evaluate_object(handle, "WRGP", &arg_list, NULL);
+	mutex_unlock(lock);
+	if (ACPI_FAILURE(status))
+		return -EIO;
+
+	return 0;
+}
+
+static int cix_aec_gpio_read(acpi_handle handle, struct mutex *lock,
+			     unsigned int gpio)
+{
+	union acpi_object arg;
+	struct acpi_object_list arg_list = {
+		.count = 1,
+		.pointer = &arg,
+	};
+	unsigned long long val;
+	acpi_status status;
+	int ec_gpio;
+
+	if (!handle || !lock)
+		return -EINVAL;
+
+	ec_gpio = cix_aec_gpio_to_asl_num(gpio);
+	if (ec_gpio < 0)
+		return ec_gpio;
+
+	arg.type = ACPI_TYPE_INTEGER;
+	arg.integer.value = ec_gpio;
+
+	mutex_lock(lock);
+	status = acpi_evaluate_integer(handle, "RDGP", &arg_list, &val);
+	mutex_unlock(lock);
+	if (ACPI_FAILURE(status))
+		return -EIO;
+
+	return !!val;
+}
+
+static int cix_aec_gpio_get_direction(struct gpio_chip *gc, unsigned int gpio)
+{
+	struct cix_aec *aec = gpiochip_get_data(gc);
+
+	if (test_bit(gpio, aec->gpio_dir_out))
+		return GPIO_LINE_DIRECTION_OUT;
+
+	return GPIO_LINE_DIRECTION_IN;
+}
+
+static int cix_aec_gpio_direction_input(struct gpio_chip *gc, unsigned int gpio)
+{
+	struct cix_aec *aec = gpiochip_get_data(gc);
+
+	clear_bit(gpio, aec->gpio_dir_out);
+	return 0;
+}
+
+static int cix_aec_gpio_direction_output(struct gpio_chip *gc, unsigned int gpio,
+					 int value)
+{
+	struct cix_aec *aec = gpiochip_get_data(gc);
+	int ret;
+
+	ret = cix_aec_gpio_write(aec->handle, &aec->lock, gpio, value);
+	if (ret)
+		return ret;
+
+	set_bit(gpio, aec->gpio_dir_out);
+	return 0;
+}
+
+static int cix_aec_gpio_get(struct gpio_chip *gc, unsigned int gpio)
+{
+	struct cix_aec *aec = gpiochip_get_data(gc);
+
+	return cix_aec_gpio_read(aec->handle, &aec->lock, gpio);
+}
+
+static void cix_aec_gpio_set(struct gpio_chip *gc, unsigned int gpio, int value)
+{
+	struct cix_aec *aec = gpiochip_get_data(gc);
+
+	cix_aec_gpio_write(aec->handle, &aec->lock, gpio, value);
+}
+
+static ssize_t gpio_count_show(struct device *dev,
+			       struct device_attribute *attr, char *buf)
+{
+	return sysfs_emit(buf, "%u\n", CIX_AEC_GPIO_COUNT);
+}
+static DEVICE_ATTR_RO(gpio_count);
+
+static ssize_t gpio_read_show(struct device *dev,
+			      struct device_attribute *attr, char *buf)
+{
+	struct cix_aec *aec = dev_get_drvdata(dev);
+	int ret;
+
+	ret = cix_aec_gpio_read(aec->handle, &aec->lock, aec->gpio_read_index);
+	if (ret < 0)
+		return ret;
+
+	return sysfs_emit(buf, "%d\n", ret);
+}
+
+static ssize_t gpio_read_store(struct device *dev,
+			       struct device_attribute *attr,
+			       const char *buf, size_t count)
+{
+	struct cix_aec *aec = dev_get_drvdata(dev);
+	unsigned int gpio;
+
+	if (kstrtouint(buf, 0, &gpio))
+		return -EINVAL;
+
+	aec->gpio_read_index = gpio;
+
+	return count;
+}
+static DEVICE_ATTR_RW(gpio_read);
+
+static ssize_t gpio_write_store(struct device *dev,
+				struct device_attribute *attr,
+				const char *buf, size_t count)
+{
+	struct cix_aec *aec = dev_get_drvdata(dev);
+	unsigned int gpio;
+	unsigned int value;
+	int ret;
+
+	if (sscanf(buf, "%u %u", &gpio, &value) != 2)
+		return -EINVAL;
+
+	ret = cix_aec_gpio_write(aec->handle, &aec->lock, gpio, value);
+	if (ret)
+		return ret;
+
+	return count;
+}
+static DEVICE_ATTR_WO(gpio_write);
+
+static struct attribute *cix_aec_gpio_attrs[] = {
+	&dev_attr_gpio_count.attr,
+	&dev_attr_gpio_read.attr,
+	&dev_attr_gpio_write.attr,
+	NULL,
+};
+
+static const struct attribute_group cix_aec_gpio_attr_group = {
+	.name = "gpio",
+	.attrs = cix_aec_gpio_attrs,
+};
+
+int cix_aec_gpio_init(struct cix_aec *aec)
+{
+	int ret;
+
+	ret = sysfs_create_group(&aec->class_dev->kobj, &cix_aec_gpio_attr_group);
+	if (ret)
+		return ret;
+
+	bitmap_zero(aec->gpio_dir_out, CIX_AEC_GPIO_COUNT);
+
+	aec->gc.label = "cix-acpi-ec-gpio";
+	aec->gc.parent = aec->dev;
+	aec->gc.owner = THIS_MODULE;
+	aec->gc.base = -1;
+	aec->gc.ngpio = CIX_AEC_GPIO_COUNT;
+	aec->gc.can_sleep = true;
+	aec->gc.get_direction = cix_aec_gpio_get_direction;
+	aec->gc.direction_input = cix_aec_gpio_direction_input;
+	aec->gc.direction_output = cix_aec_gpio_direction_output;
+	aec->gc.get = cix_aec_gpio_get;
+	aec->gc.set = cix_aec_gpio_set;
+
+	ret = devm_gpiochip_add_data(aec->dev, &aec->gc, aec);
+	if (ret) {
+		sysfs_remove_group(&aec->class_dev->kobj, &cix_aec_gpio_attr_group);
+		return ret;
+	}
+
+	return 0;
+}
+
+void cix_aec_gpio_exit(struct cix_aec *aec)
+{
+	sysfs_remove_group(&aec->class_dev->kobj, &cix_aec_gpio_attr_group);
+}
diff --git a/drivers/soc/cix/acpi/cix-acpi-ec-light.c b/drivers/soc/cix/acpi/cix-acpi-ec-light.c
new file mode 100644
index 000000000000..22aff80572ee
--- /dev/null
+++ b/drivers/soc/cix/acpi/cix-acpi-ec-light.c
@@ -0,0 +1,164 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Copyright 2026 Cix Technology Group Co., Ltd.
+ * CIX ACPI EC light/backlight control over ASL methods.
+ */
+
+#include <linux/acpi.h>
+#include <linux/device.h>
+#include <linux/errno.h>
+#include <linux/kernel.h>
+#include <linux/mutex.h>
+#include <linux/platform_device.h>
+#include <linux/slab.h>
+#include <linux/sysfs.h>
+
+#include "cix-acpi-ec.h"
+
+static int cix_aec_get_kbl(struct cix_aec *aec, int *percent, int *enable)
+{
+	struct acpi_buffer buffer = { ACPI_ALLOCATE_BUFFER, NULL };
+	union acpi_object *obj;
+	acpi_status status;
+	int ret = -EIO;
+
+	mutex_lock(&aec->lock);
+	status = acpi_evaluate_object(aec->handle, "GKBL", NULL, &buffer);
+	mutex_unlock(&aec->lock);
+	if (ACPI_FAILURE(status))
+		return -EIO;
+
+	obj = buffer.pointer;
+	if (!obj || obj->type != ACPI_TYPE_PACKAGE || obj->package.count < 2)
+		goto out;
+	if (obj->package.elements[0].type != ACPI_TYPE_INTEGER)
+		goto out;
+	if (obj->package.elements[1].type != ACPI_TYPE_INTEGER)
+		goto out;
+
+	*percent = (int)obj->package.elements[0].integer.value;
+	*enable = (int)obj->package.elements[1].integer.value;
+	ret = 0;
+out:
+	kfree(buffer.pointer);
+	return ret;
+}
+
+static int cix_aec_set_kbl(struct cix_aec *aec, int percent)
+{
+	union acpi_object arg;
+	struct acpi_object_list arg_list = {
+		.count = 1,
+		.pointer = &arg,
+	};
+	acpi_status status;
+
+	arg.type = ACPI_TYPE_INTEGER;
+	arg.integer.value = percent;
+
+	mutex_lock(&aec->lock);
+	status = acpi_evaluate_object(aec->handle, "SKBL", &arg_list, NULL);
+	mutex_unlock(&aec->lock);
+	if (ACPI_FAILURE(status))
+		return -EIO;
+
+	return 0;
+}
+
+static int cix_aec_get_lss(struct cix_aec *aec, int *type, int *value)
+{
+	struct acpi_buffer buffer = { ACPI_ALLOCATE_BUFFER, NULL };
+	union acpi_object *obj;
+	acpi_status status;
+	int ret = -EIO;
+
+	mutex_lock(&aec->lock);
+	status = acpi_evaluate_object(aec->handle, "GLSS", NULL, &buffer);
+	mutex_unlock(&aec->lock);
+	if (ACPI_FAILURE(status))
+		return -EIO;
+
+	obj = buffer.pointer;
+	if (!obj || obj->type != ACPI_TYPE_PACKAGE || obj->package.count < 2)
+		goto out;
+	if (obj->package.elements[0].type != ACPI_TYPE_INTEGER)
+		goto out;
+	if (obj->package.elements[1].type != ACPI_TYPE_INTEGER)
+		goto out;
+
+	*type = (int)obj->package.elements[0].integer.value;
+	*value = (int)obj->package.elements[1].integer.value;
+	ret = 0;
+out:
+	kfree(buffer.pointer);
+	return ret;
+}
+
+static ssize_t kbl_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct cix_aec *aec = dev_get_drvdata(dev);
+	int percent;
+	int enable;
+	int ret;
+
+	ret = cix_aec_get_kbl(aec, &percent, &enable);
+	if (ret)
+		return ret;
+
+	return sysfs_emit(buf, "%d %d\n", percent, enable);
+}
+
+static ssize_t kbl_store(struct device *dev, struct device_attribute *attr,
+			 const char *buf, size_t count)
+{
+	struct cix_aec *aec = dev_get_drvdata(dev);
+	int percent;
+	int ret;
+
+	ret = kstrtoint(buf, 0, &percent);
+	if (ret)
+		return ret;
+
+	ret = cix_aec_set_kbl(aec, percent);
+	if (ret)
+		return ret;
+
+	return count;
+}
+static DEVICE_ATTR_RW(kbl);
+
+static ssize_t lss_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct cix_aec *aec = dev_get_drvdata(dev);
+	int type;
+	int value;
+	int ret;
+
+	ret = cix_aec_get_lss(aec, &type, &value);
+	if (ret)
+		return ret;
+
+	return sysfs_emit(buf, "%d %d\n", type, value);
+}
+static DEVICE_ATTR_RO(lss);
+
+static struct attribute *cix_aec_light_attrs[] = {
+	&dev_attr_kbl.attr,
+	&dev_attr_lss.attr,
+	NULL,
+};
+
+static const struct attribute_group cix_aec_light_attr_group = {
+	.name = "light",
+	.attrs = cix_aec_light_attrs,
+};
+
+int cix_aec_light_init(struct cix_aec *aec)
+{
+	return sysfs_create_group(&aec->class_dev->kobj, &cix_aec_light_attr_group);
+}
+
+void cix_aec_light_exit(struct cix_aec *aec)
+{
+	sysfs_remove_group(&aec->class_dev->kobj, &cix_aec_light_attr_group);
+}
diff --git a/drivers/soc/cix/acpi/cix-acpi-ec.c b/drivers/soc/cix/acpi/cix-acpi-ec.c
new file mode 100644
index 000000000000..e30515e7f37a
--- /dev/null
+++ b/drivers/soc/cix/acpi/cix-acpi-ec.c
@@ -0,0 +1,400 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Copyright 2026 Cix Technology Group Co., Ltd.
+ * CIX ACPI EC platform driver entry.
+ */
+
+#include <linux/acpi.h>
+#include <linux/errno.h>
+#include <linux/kernel.h>
+#include <linux/list.h>
+#include <linux/module.h>
+#include <linux/platform_device.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+
+#include "cix-acpi-ec.h"
+#include "../cix-plat-base.h"
+
+#define CIX_EC_ACPI_HID "CIXHA015"
+#define CIX_EC_MAX_ASL_ARGS 16
+
+struct cix_aec_asl_item {
+	struct list_head node;
+	char name[5];
+	int argc;
+};
+
+struct cix_aec_ctx {
+	struct list_head items;
+	int item_count;
+};
+
+static struct cix_aec_ctx cix_aec_ctx = {
+	.items = LIST_HEAD_INIT(cix_aec_ctx.items),
+	.item_count = 0,
+};
+
+struct cix_aec_scan_ctx {
+	int err;
+};
+
+static const char * const cix_aec_method_blacklist[] = {
+	"_STA",
+	"_INI",
+	"REST",
+	"STAT",
+	"STOP",
+	"READ",
+	"WRIT",
+	"CKSB",
+	"CLRB",
+	"SETB",
+	"CLRF",
+	"TRAS",
+	"EVNT",
+	"NTII",
+};
+
+static bool cix_aec_method_is_blacklisted(const char *name)
+{
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(cix_aec_method_blacklist); i++) {
+		if (!strcmp(name, cix_aec_method_blacklist[i]))
+			return true;
+	}
+
+	return false;
+}
+
+static const struct cix_aec_asl_item *cix_aec_find_method_spec(const char *name)
+{
+	struct cix_aec_asl_item *item;
+
+	list_for_each_entry(item, &cix_aec_ctx.items, node)
+		if (!strcmp(name, item->name))
+			return item;
+
+	return NULL;
+}
+
+static void cix_aec_clear_methods(void)
+{
+	struct cix_aec_asl_item *item;
+	struct cix_aec_asl_item *tmp;
+
+	list_for_each_entry_safe(item, tmp, &cix_aec_ctx.items, node) {
+		list_del(&item->node);
+		kfree(item);
+	}
+	cix_aec_ctx.item_count = 0;
+}
+
+static acpi_status cix_aec_scan_method_cb(acpi_handle handle, u32 level,
+					  void *context, void **return_value)
+{
+	struct cix_aec_scan_ctx *ctx = context;
+	struct cix_aec_asl_item *item;
+	struct acpi_device_info *info = NULL;
+	struct acpi_buffer name_buf = { ACPI_ALLOCATE_BUFFER, NULL };
+	acpi_status status;
+
+	status = acpi_get_name(handle, ACPI_SINGLE_NAME, &name_buf);
+	if (ACPI_FAILURE(status))
+		return AE_OK;
+
+	if (cix_aec_method_is_blacklisted(name_buf.pointer)) {
+		kfree(name_buf.pointer);
+		return AE_OK;
+	}
+
+	item = kzalloc(sizeof(*item), GFP_KERNEL);
+	if (!item) {
+		ctx->err = -ENOMEM;
+		kfree(name_buf.pointer);
+		return AE_CTRL_TERMINATE;
+	}
+
+	strscpy(item->name, name_buf.pointer, sizeof(item->name));
+	item->argc = -1;
+
+	status = acpi_get_object_info(handle, &info);
+	if (ACPI_SUCCESS(status) && info)
+		item->argc = info->param_count;
+
+	kfree(info);
+	kfree(name_buf.pointer);
+	list_add_tail(&item->node, &cix_aec_ctx.items);
+	cix_aec_ctx.item_count++;
+
+	return AE_OK;
+}
+
+static int cix_aec_scan_methods(struct cix_aec *aec)
+{
+	struct cix_aec_scan_ctx ctx = {
+		.err = 0,
+	};
+	acpi_status status;
+
+	cix_aec_clear_methods();
+
+	status = acpi_walk_namespace(ACPI_TYPE_METHOD, aec->handle, ACPI_UINT32_MAX,
+				     cix_aec_scan_method_cb, NULL, &ctx, NULL);
+	if (ACPI_FAILURE(status) && status != AE_CTRL_TERMINATE)
+		return -EIO;
+	if (ctx.err)
+		return ctx.err;
+	if (!cix_aec_ctx.item_count)
+		return -ENOENT;
+
+	return 0;
+}
+
+static char *cix_aec_next_token(char **cursor)
+{
+	char *tok;
+
+	while ((tok = strsep(cursor, " \t\n")) != NULL) {
+		if (*tok != '\0')
+			return tok;
+	}
+
+	return NULL;
+}
+
+static ssize_t cix_aec_dump_methods(char *buf)
+{
+	ssize_t len = 0;
+	struct cix_aec_asl_item *item;
+
+	len += scnprintf(buf + len, PAGE_SIZE - len,
+			 "METHOD\tARGC\n");
+	len += scnprintf(buf + len, PAGE_SIZE - len,
+			 "------\t----\n");
+
+	list_for_each_entry(item, &cix_aec_ctx.items, node) {
+		if (item->argc >= 0) {
+			len += scnprintf(buf + len, PAGE_SIZE - len, "%s\t%d\n",
+					 item->name, item->argc);
+		} else {
+			len += scnprintf(buf + len, PAGE_SIZE - len, "%s\t?\n",
+					 item->name);
+		}
+		if (len >= PAGE_SIZE - 1)
+			break;
+	}
+
+	return len;
+}
+
+static ssize_t asl_call_show(struct device *dev, struct device_attribute *attr,
+			     char *buf)
+{
+	struct cix_aec *aec = dev_get_drvdata(dev);
+	ssize_t len;
+
+	mutex_lock(&aec->lock);
+	len = cix_aec_dump_methods(buf);
+	mutex_unlock(&aec->lock);
+
+	return len;
+}
+
+static ssize_t asl_methods_show(struct device *dev, struct device_attribute *attr,
+				char *buf)
+{
+	struct cix_aec *aec = dev_get_drvdata(dev);
+	ssize_t len;
+
+	mutex_lock(&aec->lock);
+	len = cix_aec_dump_methods(buf);
+	mutex_unlock(&aec->lock);
+
+	return len;
+}
+static DEVICE_ATTR_RO(asl_methods);
+
+static ssize_t asl_call_store(struct device *dev, struct device_attribute *attr,
+			      const char *buf, size_t count)
+{
+	struct cix_aec *aec = dev_get_drvdata(dev);
+	const struct cix_aec_asl_item *method;
+	union acpi_object objs[CIX_EC_MAX_ASL_ARGS];
+	struct acpi_object_list arg_list = {
+		.pointer = objs,
+	};
+	unsigned long long number;
+	struct acpi_buffer out = { ACPI_ALLOCATE_BUFFER, NULL };
+	char *kbuf;
+	char *cursor;
+	char *tok;
+	int argc = 0;
+	acpi_status status;
+
+	kbuf = kstrdup(buf, GFP_KERNEL);
+	if (!kbuf)
+		return -ENOMEM;
+
+	cursor = kbuf;
+	tok = cix_aec_next_token(&cursor);
+	if (!tok)
+		goto err_inval;
+
+	method = cix_aec_find_method_spec(tok);
+	if (!method)
+		goto err_noent;
+
+	while ((tok = cix_aec_next_token(&cursor)) != NULL) {
+		if (argc >= CIX_EC_MAX_ASL_ARGS)
+			goto err_too_many;
+		if (!kstrtoull(tok, 0, &number)) {
+			objs[argc].type = ACPI_TYPE_INTEGER;
+			objs[argc].integer.value = number;
+		} else {
+			objs[argc].type = ACPI_TYPE_STRING;
+			objs[argc].string.pointer = tok;
+			objs[argc].string.length = strlen(tok);
+		}
+		argc++;
+	}
+
+	if (method->argc >= 0 && argc != method->argc)
+		goto err_inval;
+
+	arg_list.count = argc;
+	mutex_lock(&aec->lock);
+	status = acpi_evaluate_object(aec->handle, (acpi_string)method->name,
+				      argc ? &arg_list : NULL, &out);
+	if (ACPI_FAILURE(status))
+		goto err_eval;
+	mutex_unlock(&aec->lock);
+
+	kfree(out.pointer);
+	kfree(kbuf);
+	return count;
+err_inval:
+	kfree(kbuf);
+	return -EINVAL;
+err_noent:
+	kfree(kbuf);
+	return -ENOENT;
+err_too_many:
+	kfree(kbuf);
+	return -E2BIG;
+err_eval:
+	mutex_unlock(&aec->lock);
+	kfree(out.pointer);
+	kfree(kbuf);
+	return -EIO;
+}
+static DEVICE_ATTR_RW(asl_call);
+
+static int cix_aec_probe(struct platform_device *pdev)
+{
+	struct cix_aec *aec;
+	struct class *cix_class;
+	int ret;
+
+	aec = devm_kzalloc(&pdev->dev, sizeof(*aec), GFP_KERNEL);
+	if (!aec)
+		return -ENOMEM;
+
+	aec->dev = &pdev->dev;
+	aec->handle = ACPI_HANDLE(&pdev->dev);
+	if (!aec->handle)
+		return -ENODEV;
+
+	mutex_init(&aec->lock);
+	platform_set_drvdata(pdev, aec);
+
+	cix_class = cix_plat_base_get_class();
+	if (!cix_class)
+		return -EPROBE_DEFER;
+
+	aec->class_dev = device_create(cix_class, &pdev->dev,
+				       MKDEV(0, 0), aec, "ec");
+	if (IS_ERR(aec->class_dev))
+		return PTR_ERR(aec->class_dev);
+
+	ret = device_create_file(aec->class_dev, &dev_attr_asl_call);
+	if (ret)
+		goto err_destroy_class_dev;
+
+	ret = device_create_file(aec->class_dev, &dev_attr_asl_methods);
+	if (ret)
+		goto err_remove_asl_call;
+
+	ret = cix_aec_scan_methods(aec);
+	if (ret)
+		goto err_remove_asl_methods;
+
+	ret = cix_aec_gpio_init(aec);
+	if (ret)
+		goto err_free_asl_list;
+
+	ret = cix_aec_light_init(aec);
+	if (ret)
+		goto err_gpio;
+
+	ret = cix_aec_fan_init(aec);
+	if (ret) {
+		cix_aec_light_exit(aec);
+		goto err_gpio;
+	}
+
+	return 0;
+
+err_gpio:
+	cix_aec_gpio_exit(aec);
+err_free_asl_list:
+	cix_aec_clear_methods();
+err_remove_asl_methods:
+	device_remove_file(aec->class_dev, &dev_attr_asl_methods);
+err_remove_asl_call:
+	device_remove_file(aec->class_dev, &dev_attr_asl_call);
+err_destroy_class_dev:
+	device_unregister(aec->class_dev);
+	aec->class_dev = NULL;
+	return ret;
+}
+
+static int cix_aec_remove(struct platform_device *pdev)
+{
+	struct cix_aec *aec = platform_get_drvdata(pdev);
+
+	cix_aec_fan_exit(aec);
+	cix_aec_light_exit(aec);
+	cix_aec_gpio_exit(aec);
+	if (aec->class_dev) {
+		cix_aec_clear_methods();
+		device_remove_file(aec->class_dev, &dev_attr_asl_methods);
+		device_remove_file(aec->class_dev, &dev_attr_asl_call);
+		device_unregister(aec->class_dev);
+		aec->class_dev = NULL;
+	}
+
+	return 0;
+}
+
+static const struct acpi_device_id cix_aec_acpi_match[] = {
+	{ CIX_EC_ACPI_HID, 0 },
+	{ }
+};
+MODULE_DEVICE_TABLE(acpi, cix_aec_acpi_match);
+
+static struct platform_driver cix_aec_driver = {
+	.probe = cix_aec_probe,
+	.remove = cix_aec_remove,
+	.driver = {
+		.name = "cix-acpi-ec",
+		.acpi_match_table = cix_aec_acpi_match,
+	},
+};
+module_platform_driver(cix_aec_driver);
+
+MODULE_AUTHOR("Zichar Zhang <zichar.zhang@cixtech.com>");
+MODULE_DESCRIPTION("CIX ACPI EC platform driver");
+MODULE_ALIAS("platform:cix-acpi-ec");
+MODULE_LICENSE("GPL");
diff --git a/drivers/soc/cix/acpi/cix-acpi-ec.h b/drivers/soc/cix/acpi/cix-acpi-ec.h
new file mode 100644
index 000000000000..438ff0fa81d5
