+	"B0",
+	"B1",
+	"B2",
+	"C0",
+	"C1",
+	"Unknown",
+};
+
+#define CORES_MASK			0x7C000
+#define CORES_SHIT_BITS			0xE
+/* Cores Information */
+#define CORES_1				0x1
+#define CORES_2				0x2
+#define CORES_3				0x3
+#define CORES_4				0x4
+#define CORES_5				0x5
+#define CORES_6				0x6
