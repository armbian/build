From 39abd37adc76f31c484ed7eeb7c47dbdf4975bd7 Mon Sep 17 00:00:00 2001
From: Jason Perlow <jperlow@gmail.com>
Date: Tue, 7 Jul 2026 05:31:30 -0400
Subject: [PATCH] phy: cix: defer probe when ACPI clkdev clocks are not yet
 registered

cix-pcie-phy and cix-usbdp probe before cix_acpi_clk/acpi_scmi_clk have
added their clkdev entries; devm_clk_get() then returns -ENOENT which
the drivers treated as terminal, leaving sky1-pcie deferring forever and
PCIe (hence the NVMe root disk) dead. Map early -ENOENT to -EPROBE_DEFER
so the PHYs re-probe once the clock providers are up.
---
 drivers/phy/cix/phy-cix-pcie.c  | 12 ++++++++----
 drivers/phy/cix/phy-cix-usbdp.c |  9 +++++----
 2 files changed, 13 insertions(+), 8 deletions(-)

diff --git a/drivers/phy/cix/phy-cix-pcie.c b/drivers/phy/cix/phy-cix-pcie.c
index 6efaf01d3246..c840108c659b 100644
--- a/drivers/phy/cix/phy-cix-pcie.c
+++ b/drivers/phy/cix/phy-cix-pcie.c
@@ -541,13 +541,17 @@ static int cix_pcie_phy_probe(struct platform_device *pdev)
 	pcie_phy->dev = dev;
 
 	pcie_phy->apb_clk = devm_clk_get(dev, "pclk");
-	if (IS_ERR(pcie_phy->apb_clk)) {
-		dev_err(dev, "phy apb clock not found\n");
-		return PTR_ERR(pcie_phy->apb_clk);
-	}
+	if (IS_ERR(pcie_phy->apb_clk))
+		return dev_err_probe(dev,
+				     PTR_ERR(pcie_phy->apb_clk) == -ENOENT ?
+				     -EPROBE_DEFER : PTR_ERR(pcie_phy->apb_clk),
+				     "phy apb clock not found\n");
 
 	pcie_phy->refclk = devm_clk_get(dev, "refclk");
 	if (IS_ERR(pcie_phy->refclk)) {
+		if (PTR_ERR(pcie_phy->refclk) == -ENOENT)
+			return dev_err_probe(dev, -EPROBE_DEFER,
+					     "phy refclk not ready\n");
 		dev_err(dev, "phy refclk not found\n");
 		return PTR_ERR(pcie_phy->refclk);
 	}
diff --git a/drivers/phy/cix/phy-cix-usbdp.c b/drivers/phy/cix/phy-cix-usbdp.c
index 0a5eb88a227c..270a52dc6501 100644
--- a/drivers/phy/cix/phy-cix-usbdp.c
+++ b/drivers/phy/cix/phy-cix-usbdp.c
@@ -1494,10 +1494,11 @@ static int cix_udphy_probe(struct platform_device *pdev)
 	}
 
 	udphy->apb_clk = devm_clk_get(dev, "pclk");
-	if (IS_ERR(udphy->apb_clk)) {
-		dev_err(dev, "phy apb clock not found\n");
-		return PTR_ERR(udphy->apb_clk);
-	}
+	if (IS_ERR(udphy->apb_clk))
+		return dev_err_probe(dev,
+				     PTR_ERR(udphy->apb_clk) == -ENOENT ?
+				     -EPROBE_DEFER : PTR_ERR(udphy->apb_clk),
+				     "phy apb clock not found\n");
 
 	udphy->base = devm_platform_ioremap_resource(pdev, 0);
 	if (IS_ERR(udphy->base))
-- 
