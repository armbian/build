From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jason Perlow <jperlow@gmail.com>
Date: Tue, 7 Jul 2026 10:32:08 -0400
Subject: pci: sky1-acpi: add sky1_pcie_native=off to use standard PNP0A08/ECAM
 path

cixmini BIOS 1.0 firmware fully initializes the PCIe links and the
working 7.0.12 vendor kernel enumerates PCI through the plain ACPI
host-bridge/ECAM path -- no vendor platform driver at all. Native mode
needs clock/reset/strap plumbing still incomplete on this firmware
generation and currently hangs or fails probe. Default stays native;
sky1_pcie_native=off restores the standard path.
---
 drivers/pci/controller/cadence/pci-sky1-acpi.c | 16 +++++++++-
 1 file changed, 15 insertions(+), 1 deletion(-)

diff --git a/drivers/pci/controller/cadence/pci-sky1-acpi.c b/drivers/pci/controller/cadence/pci-sky1-acpi.c
index 111111111111..222222222222 100644
--- a/drivers/pci/controller/cadence/pci-sky1-acpi.c
+++ b/drivers/pci/controller/cadence/pci-sky1-acpi.c
@@ -27,6 +27,20 @@
 #include "pci-sky1-acpi.h"
 
 static bool sky1_acpi_detected;
+/*
+ * sky1_pcie_native=off reverts to the standard ACPI PNP0A08/ECAM PCI
+ * host path (firmware link bring-up), as used by the working 7.0.12
+ * vendor kernel on cixmini BIOS 1.0. Native mode (default) blocks
+ * PNP0A08 and drives the Cadence controller directly.
+ */
+static bool sky1_pcie_native = true;
+static int __init sky1_pcie_native_setup(char *arg)
+{
+	if (arg && !strcmp(arg, "off"))
+		sky1_pcie_native = false;
+	return 0;
+}
+early_param("sky1_pcie_native", sky1_pcie_native_setup);
 
 /*
  * Resource filter for CIXH2020 _CRS.
@@ -146,7 +160,7 @@ static int sky1_cixh2020_create_pdev(struct acpi_device *adev)
 static int sky1_acpi_scan_attach(struct acpi_device *adev,
 				 const struct acpi_device_id *id)
 {
-	if (!sky1_acpi_detected)
+	if (!sky1_acpi_detected || !sky1_pcie_native)
 		return 0;
 
 	if (!strcmp(id->id, "PNP0A08")) {
-- 
Armbian

