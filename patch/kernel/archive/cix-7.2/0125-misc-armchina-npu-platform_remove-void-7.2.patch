From 3c11dbe55226cbd058c70d38f926eb2ac5a81fe0 Mon Sep 17 00:00:00 2001
From: Jason Perlow <jperlow@gmail.com>
Date: Thu, 9 Jul 2026 20:09:32 -0400
Subject: [PATCH 6/6] misc: armchina-npu: convert platform_driver::remove to
 void return for 7.2

Kernel commit 0edb555a65d1 (platform: Make platform_driver::remove()
return void) changed the .remove callback type from int to void.
The Entrpi armchina-npu v7.1 sky1-next port pre-dates this and still
declares default_remove() / r329_remove() as int, triggering
-Werror=incompatible-pointer-types on v7.2-rc1.

Convert both to void, drop the return-value tail. armchina_aipu_remove()
still returns int internally, but that value is now discarded by the
platform_driver contract (sky1_npu_remove was already void since the
7.0.x BSP).

No functional change; device removal cannot fail at this layer.
---
 drivers/misc/armchina-npu/default/default.c | 4 ++--
 drivers/misc/armchina-npu/r329/r329.c       | 5 ++---
 2 files changed, 4 insertions(+), 5 deletions(-)

diff --git a/drivers/misc/armchina-npu/default/default.c b/drivers/misc/armchina-npu/default/default.c
index a39f0c972827..45157bd4c22a 100755
--- a/drivers/misc/armchina-npu/default/default.c
+++ b/drivers/misc/armchina-npu/default/default.c
@@ -29,9 +29,9 @@ static int default_probe(struct platform_device *p_dev)
 	return armchina_aipu_probe(p_dev, &default_soc, &default_ops);
 }
 
-static int default_remove(struct platform_device *p_dev)
+static void default_remove(struct platform_device *p_dev)
 {
-	return armchina_aipu_remove(p_dev);
+	armchina_aipu_remove(p_dev);
 }
 
 static int default_suspend(struct platform_device *p_dev, pm_message_t state)
diff --git a/drivers/misc/armchina-npu/r329/r329.c b/drivers/misc/armchina-npu/r329/r329.c
index c21fe74c532a..e6ccb8984bf6 100755
--- a/drivers/misc/armchina-npu/r329/r329.c
+++ b/drivers/misc/armchina-npu/r329/r329.c
@@ -107,12 +107,11 @@ static int r329_probe(struct platform_device *p_dev)
 	return armchina_aipu_probe(p_dev, &r329, &r329_ops);
 }
 
-static int r329_remove(struct platform_device *p_dev)
+static void r329_remove(struct platform_device *p_dev)
 {
-	int ret = armchina_aipu_remove(p_dev);
+	armchina_aipu_remove(p_dev);
 
 	r329_disable_clk(&p_dev->dev, &r329);
-	return ret;
 }
 
 static int r329_suspend(struct platform_device *p_dev, pm_message_t state)
-- 
2.51.0

