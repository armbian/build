From: Jason Perlow <jperlow@gmail.com>
Date: Wed, 8 Jul 2026 20:00:00 -0400
Subject: [PATCH] iommu/arm-smmu-v3: sky1 disable PRI + restore event queue (supersedes 0106)

---
diff --git a/drivers/iommu/arm/arm-smmu-v3/arm-smmu-v3.c b/drivers/iommu/arm/arm-smmu-v3/arm-smmu-v3.c
index a3b2335edc7a..dad9bf6822d2 100644
--- a/drivers/iommu/arm/arm-smmu-v3/arm-smmu-v3.c
+++ b/drivers/iommu/arm/arm-smmu-v3/arm-smmu-v3.c
@@ -4746,14 +4746,7 @@ static void arm_smmu_write_strtab(struct arm_smmu_device *smmu)
 	writel_relaxed(reg, smmu->base + ARM_SMMU_STRTAB_BASE_CFG);
 }
 
-/*
- * CIX Sky1: the PCIe SMMU's 2-level stream table only covers 25 of 32
- * Stream-ID bits, so every PCIe DMA raises a C_BAD_STREAMID event -> a
- * ~130 IRQ/s event-queue storm on CPU0 that stalls early boot (probes
- * fault in hardirq context) and wedges the system. DMA still works via
- * disable_bypass=0. Leave the event queue disabled for this SMMU so the
- * storm never starts.
- */
+/* CIX Sky1 PCIe SMMU, identified by its ACPI MMIO resource. */
 static bool arm_smmu_is_cix_sky1_pcie(struct arm_smmu_device *smmu)
 {
 	struct resource *res;
@@ -4831,10 +4824,7 @@ static int arm_smmu_device_reset(struct arm_smmu_device *smmu)
 	writel_relaxed(smmu->evtq.q.llq.prod, smmu->page1 + ARM_SMMU_EVTQ_PROD);
 	writel_relaxed(smmu->evtq.q.llq.cons, smmu->page1 + ARM_SMMU_EVTQ_CONS);
 
-	if (arm_smmu_is_cix_sky1_pcie(smmu))
-		dev_info(smmu->dev, "CIX Sky1: leaving event queue disabled (C_BAD_STREAMID storm workaround)\n");
-	else
-		enables |= CR0_EVTQEN;
+	enables |= CR0_EVTQEN;
 	ret = arm_smmu_write_reg_sync(smmu, enables, ARM_SMMU_CR0,
 				      ARM_SMMU_CR0ACK);
 	if (ret) {
@@ -5391,6 +5381,11 @@ static void arm_smmu_acpi_install_bypass_ste(struct arm_smmu_device *smmu)
 		count++;
 	}
 
+	/*
+	 * Sky1 PCIe DTI ATS-master emits translated TLPs even for non-ATS
+	 * endpoints. Keep EATS enabled in the translated STEs installed for
+	 * the normal DMA domains.
+	 */
 	smmu->options |= ARM_SMMU_OPT_PCIE_ATS_OVERRIDE;
 
 	dev_info(smmu->dev,
@@ -5572,6 +5567,20 @@ static int arm_smmu_device_probe(struct platform_device *pdev)
 	if (ret)
 		return ret;
 
+	/*
+	 * Sky1's IORT reports ATS, but not PRI, for the PCIe root complex.
+	 * Enabling the MMU-700 PRI queue on this integration produces sustained
+	 * C_BAD_STREAMID events followed by PCIe transaction failures.  The
+	 * working 7.0 configuration never enables CR0.PRIQEN.  Mask PRI before
+	 * queue allocation so a generic configuration with CONFIG_PCI_PRI=y has
+	 * the same hardware state.
+	 */
+	if (arm_smmu_is_cix_sky1_pcie(smmu) &&
+	    (smmu->features & ARM_SMMU_FEAT_PRI)) {
+		smmu->features &= ~ARM_SMMU_FEAT_PRI;
+		dev_info(dev, "CIX Sky1 PCIe SMMU: PRI disabled\n");
+	}
+
 	/* Initialise in-memory data structures */
 	ret = arm_smmu_init_structures(smmu);
 	if (ret)
