@@ -26,6 +26,15 @@
 #include <linux/platform_device.h>
 #include <linux/reset-controller.h>
 
+static bool ncz_no_links;
+static int __init ncz_no_links_setup(char *str)
+{
+	ncz_no_links = true;
+	return 0;
+}
+early_param("ncz_no_links", ncz_no_links_setup);
+
+
 static struct acpi_device *acpi_obj_to_acpi_dev(const union acpi_object *obj)
 {
 	if (!obj)
@@ -337,13 +346,15 @@ static int acpi_resource_lookup_device(acpi_handle handle, void *data)
 		dev_dbg(dev, "resource name lookup handle failed for %s\n",
 			acpi_device_hid(acpi_fetch_acpi_dev(handle)));
 
-	ret = acpi_res_lookup_eval(handle, "DLKL",
+	ret = ncz_no_links ? -ENODEV :
+	      acpi_res_lookup_eval(handle, "DLKL",
 				   device_link_lookup_handle, dev);
 	if (ret < 0 && ret != -ENODEV)
 		dev_dbg(dev, "device link lookup handle failed for %s\n",
 			acpi_device_hid(acpi_fetch_acpi_dev(handle)));
 
-	ret = acpi_res_lookup_eval(handle, "CLKT",
+	ret = ncz_no_links ? -ENODEV :
+	      acpi_res_lookup_eval(handle, "CLKT",
 				   clock_dependency_handle, dev);
 	if (ret < 0 && ret != -ENODEV)
 		dev_dbg(dev, "clock dependency handle failed for %s\n",
