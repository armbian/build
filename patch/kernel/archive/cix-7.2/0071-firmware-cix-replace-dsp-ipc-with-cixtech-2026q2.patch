-	return -EOPNOTSUPP;
+	return -ENOTSUPP;
 }
 
-static inline int cix_dsp_request_mbox(struct cix_dsp_ipc *dsp_ipc)
+int cix_dsp_request_mbox(struct cix_dsp_ipc *dsp_ipc)
 {
-	return -EOPNOTSUPP;
