From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: retro98boy <retro98boy@qq.com>
Date: Sat, 24 Oct 2026 09:25:08 +0800
Subject: arm64: dts: rockchip: add RK3562 DDR memory controller

---
 arch/arm64/boot/dts/rockchip/rk3562.dtsi | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/arch/arm64/boot/dts/rockchip/rk3562.dtsi b/arch/arm64/boot/dts/rockchip/rk3562.dtsi
index 111111111111..222222222222 100644
--- a/arch/arm64/boot/dts/rockchip/rk3562.dtsi
+++ b/arch/arm64/boot/dts/rockchip/rk3562.dtsi
@@ -262,6 +262,16 @@ arm_pmu: arm-pmu {
 		interrupt-affinity = <&cpu0>, <&cpu1>, <&cpu2>, <&cpu3>;
 	};
 
+	dmc: memory-controller {
+		compatible = "rockchip,rk3562-dmc";
+		interrupts = <GIC_SPI 118 IRQ_TYPE_LEVEL_HIGH>;
+		interrupt-names = "complete";
+		clocks = <&scmi_clk CLK_DDR>;
+		clock-names = "dmc_clk";
+		devfreq-events = <&dfi>;
+		status = "disabled";
+	};
+
 	firmware {
 		scmi: scmi {
 			compatible = "arm,scmi-smc";
-- 
Armbian

