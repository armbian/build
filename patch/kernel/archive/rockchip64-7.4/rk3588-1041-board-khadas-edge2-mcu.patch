From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ricardo Pardini <ricardo@pardini.net>
Date: Fri, 20 Nov 2026 20:02:37 +0100
Subject: dt-bindings: mfd: khadas-mcu: add Khadas Edge2 MCU compatible

The MCU on the Khadas Edge2 (RK3588S) uses the same register map
generation as the VIM4 one (fan control at 0x8a, taking a speed in
percent), and is not discoverable either.

Based on Muhammed Efe Cetin's Edge2 MCU series.

Link: https://lore.kernel.org/all/cover.1761059314.git.efectn@protonmail.com/
---
 Documentation/devicetree/bindings/mfd/khadas,mcu.yaml | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/Documentation/devicetree/bindings/mfd/khadas,mcu.yaml b/Documentation/devicetree/bindings/mfd/khadas,mcu.yaml
index 111111111111..222222222222 100644
--- a/Documentation/devicetree/bindings/mfd/khadas,mcu.yaml
+++ b/Documentation/devicetree/bindings/mfd/khadas,mcu.yaml
@@ -11,13 +11,14 @@ maintainers:
 
 description: |
   Khadas embeds a microcontroller on their VIM and Edge boards adding some
-  system feature as PWM Fan control (for VIM2 rev14 or VIM3), User memory
+  system feature as PWM Fan control (for VIM2 rev14, VIM3, VIM4 or Edge2), User memory
   storage, IR/Key resume control, system power LED control and more.
 
 properties:
   compatible:
     enum:
       - khadas,mcu # MCU revision is discoverable
+      - khadas,edge2-mcu # VIM4-like MCU variant, not discoverable
       - khadas,vim4-mcu # Different MCU variant, not discoverable
 
   "#cooling-cells": # Only needed for boards having FAN control feature
-- 
Armbian

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ricardo Pardini <ricardo@pardini.net>
Date: Fri, 20 Nov 2026 20:02:38 +0100
Subject: mfd: khadas-mcu: add Khadas Edge2 MCU variant

The Edge2 MCU has the VIM4 register map (LED, fan, watchdog and reset
at 0x89-0x91); its sleep enable register is volatile as well. It has
no user memory cell.

Based on Muhammed Efe Cetin's Edge2 MCU series.

Link: https://lore.kernel.org/all/cover.1761059314.git.efectn@protonmail.com/
---
 drivers/mfd/khadas-mcu.c       | 30 ++++++++++
 include/linux/mfd/khadas-mcu.h |  2 +
 2 files changed, 32 insertions(+)

diff --git a/drivers/mfd/khadas-mcu.c b/drivers/mfd/khadas-mcu.c
index 111111111111..222222222222 100644
--- a/drivers/mfd/khadas-mcu.c
+++ b/drivers/mfd/khadas-mcu.c
@@ -126,6 +126,28 @@ static const struct mfd_cell khadas_mcu_vim4_fan_cells[] = {
 	MFD_CELL_NAME("khadas-mcu-vim4-fan"),
 };
 
+static bool khadas_mcu_edge2_reg_volatile(struct device *dev, unsigned int reg)
+{
+	if (reg == KHADAS_MCU_MCU_SLEEP_MODE_REG)
+		return true;
+
+	return khadas_mcu_vim4_reg_volatile(dev, reg);
+}
+
+static const struct regmap_config khadas_mcu_edge2_regmap_config = {
+	.reg_bits	= 8,
+	.reg_stride	= 1,
+	.val_bits	= 8,
+	.max_register	= KHADAS_MCU_VIM4_SYS_RST_REG,
+	.volatile_reg	= khadas_mcu_edge2_reg_volatile,
+	.writeable_reg	= khadas_mcu_vim4_reg_writeable,
+	.cache_type	= REGCACHE_MAPLE,
+};
+
+static const struct mfd_cell khadas_mcu_edge2_fan_cells[] = {
+	MFD_CELL_NAME("khadas-mcu-edge2-fan"),
+};
+
 static int khadas_mcu_probe(struct i2c_client *client)
 {
 	const struct mfd_cell *cells, *fan_cells;
@@ -158,6 +180,13 @@ static int khadas_mcu_probe(struct i2c_client *client)
 		fan_cells	= khadas_mcu_vim4_fan_cells;
 		nfan_cells	= ARRAY_SIZE(khadas_mcu_vim4_fan_cells);
 		break;
+	case KHADAS_MCU_EDGE2:
+		regmap_cfg	= &khadas_mcu_edge2_regmap_config;
+		cells		= NULL;
+		ncells		= 0;
+		fan_cells	= khadas_mcu_edge2_fan_cells;
+		nfan_cells	= ARRAY_SIZE(khadas_mcu_edge2_fan_cells);
+		break;
 	default:
 		return -ENODEV;
 	}
@@ -193,6 +222,7 @@ static int khadas_mcu_probe(struct i2c_client *client)
 #ifdef CONFIG_OF
 static const struct of_device_id khadas_mcu_of_match[] = {
 	{ .compatible = "khadas,mcu", .data = (void *)KHADAS_MCU_GENERIC },
+	{ .compatible = "khadas,edge2-mcu", .data = (void *)KHADAS_MCU_EDGE2 },
 	{ .compatible = "khadas,vim4-mcu", .data = (void *)KHADAS_MCU_VIM4 },
 	{},
 };
diff --git a/include/linux/mfd/khadas-mcu.h b/include/linux/mfd/khadas-mcu.h
index 111111111111..222222222222 100644
--- a/include/linux/mfd/khadas-mcu.h
+++ b/include/linux/mfd/khadas-mcu.h
@@ -99,10 +99,12 @@ struct khadas_mcu {
  * enum khadas_mcu_type - Khadas MCU hardware variant
  * @KHADAS_MCU_GENERIC: VIM1, VIM2, VIM3, Edge, Edge-V (shared register map)
  * @KHADAS_MCU_VIM4: VIM4 (extended register map, distinct fan/LED/WDT regs)
+ * @KHADAS_MCU_EDGE2: Edge2 (VIM4 register map)
  */
 enum khadas_mcu_type {
 	KHADAS_MCU_GENERIC = 1,
 	KHADAS_MCU_VIM4,
+	KHADAS_MCU_EDGE2,
 };
 
 #endif /* MFD_KHADAS_MCU_H */
-- 
Armbian

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ricardo Pardini <ricardo@pardini.net>
Date: Fri, 20 Nov 2026 20:02:39 +0100
Subject: thermal: khadas_mcu_fan: support the Khadas Edge2 MCU

The Edge2 MCU controls the fan like the VIM4 one: a speed in percent
written to 0x8a. Use the VIM4 register and levels. There is no fan
supply on the Edge2; the regulator core provides a dummy one.

Based on Muhammed Efe Cetin's Edge2 MCU series.

Link: https://lore.kernel.org/all/cover.1761059314.git.efectn@protonmail.com/
---
 drivers/thermal/khadas_mcu_fan.c | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/drivers/thermal/khadas_mcu_fan.c b/drivers/thermal/khadas_mcu_fan.c
index 111111111111..222222222222 100644
--- a/drivers/thermal/khadas_mcu_fan.c
+++ b/drivers/thermal/khadas_mcu_fan.c
@@ -121,6 +121,7 @@ static int khadas_mcu_fan_probe(struct platform_device *pdev)
 		ctx->nlevels = ARRAY_SIZE(khadas_mcu_fan_levels);
 		break;
 	case KHADAS_MCU_VIM4:
+	case KHADAS_MCU_EDGE2:
 		ctx->fan_reg = KHADAS_MCU_VIM4_FAN_CTRL_REG;
 		ctx->levels = khadas_mcu_vim4_fan_levels;
 		ctx->nlevels = ARRAY_SIZE(khadas_mcu_vim4_fan_levels);
@@ -205,6 +206,7 @@ static SIMPLE_DEV_PM_OPS(khadas_mcu_fan_pm, khadas_mcu_fan_suspend,
 static const struct platform_device_id khadas_mcu_fan_id_table[] = {
 	{ .name = "khadas-mcu-fan-ctrl", .driver_data = KHADAS_MCU_GENERIC },
 	{ .name = "khadas-mcu-vim4-fan", .driver_data = KHADAS_MCU_VIM4 },
+	{ .name = "khadas-mcu-edge2-fan", .driver_data = KHADAS_MCU_EDGE2 },
 	{},
 };
 MODULE_DEVICE_TABLE(platform, khadas_mcu_fan_id_table);
-- 
Armbian

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ricardo Pardini <ricardo@pardini.net>
Date: Fri, 20 Nov 2026 20:02:57 +0100
Subject: arm64: dts: rockchip: add Khadas MCU and fan control to Khadas Edge 2

Describe the Khadas MCU on i2c2 and drive its fan from the package
thermal zone, one trip per fan level (30/40/55/75/100 %).

Based on Muhammed Efe Cetin's Edge2 MCU series.

Link: https://lore.kernel.org/all/cover.1761059314.git.efectn@protonmail.com/
---
 arch/arm64/boot/dts/rockchip/rk3588s-khadas-edge2.dts | 69 ++++++++++
 1 file changed, 69 insertions(+)

diff --git a/arch/arm64/boot/dts/rockchip/rk3588s-khadas-edge2.dts b/arch/arm64/boot/dts/rockchip/rk3588s-khadas-edge2.dts
index 111111111111..222222222222 100644
--- a/arch/arm64/boot/dts/rockchip/rk3588s-khadas-edge2.dts
+++ b/arch/arm64/boot/dts/rockchip/rk3588s-khadas-edge2.dts
@@ -328,6 +328,12 @@ dp_altmode_mux: endpoint {
 	};
 
 
+	khadas_mcu: system-controller@18 {
+		compatible = "khadas,edge2-mcu";
+		reg = <0x18>;
+		#cooling-cells = <2>;
+	};
+
 	hym8563: rtc@51 {
 		compatible = "haoyu,hym8563";
 		reg = <0x51>;
@@ -341,6 +347,69 @@ &i2s5_8ch {
 	status = "okay";
 };
 
+&package_thermal {
+	polling-delay = <1000>;
+
+	trips {
+		package_fan0: package-fan0 {
+			temperature = <45000>;
+			hysteresis = <5000>;
+			type = "active";
+		};
+
+		package_fan1: package-fan1 {
+			temperature = <50000>;
+			hysteresis = <5000>;
+			type = "active";
+		};
+
+		package_fan2: package-fan2 {
+			temperature = <55000>;
+			hysteresis = <5000>;
+			type = "active";
+		};
+
+		package_fan3: package-fan3 {
+			temperature = <60000>;
+			hysteresis = <5000>;
+			type = "active";
+		};
+
+		package_fan4: package-fan4 {
+			temperature = <70000>;
+			hysteresis = <5000>;
+			type = "active";
+		};
+	};
+
+	cooling-maps {
+		map0 {
+			trip = <&package_fan0>;
+			cooling-device = <&khadas_mcu 1 1>;
+		};
+
+		map1 {
+			trip = <&package_fan1>;
+			cooling-device = <&khadas_mcu 2 2>;
+		};
+
+		map2 {
+			trip = <&package_fan2>;
+			cooling-device = <&khadas_mcu 3 3>;
+		};
+
+		map3 {
+			trip = <&package_fan3>;
+			cooling-device = <&khadas_mcu 4 4>;
+		};
+
+		map4 {
+			trip = <&package_fan4>;
+			cooling-device = <&khadas_mcu 5 THERMAL_NO_LIMIT>;
+		};
+	};
+};
+
 &pd_gpu {
 	domain-supply = <&vdd_gpu_s0>;
 };
-- 
Armbian

