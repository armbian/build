 					       (val & CMN_ANA_LCPLL_LOCK_DONE), 200, 100000);
@@ -782,15 +782,15 @@ static int rk_udphy_init(struct rk_udphy *udphy)
 	int ret;
 
 	dev_dbg(udphy->dev, "reinit PHY with USB3=%s and DP=%s (%u lanes) flipped=%s\n",
