 			power-domains = <&cpu_pd1>, <&scmi_dvfs 0>;
 			power-domain-names = "psci", "perf";
@@ -71,6 +73,7 @@ cpu2: cpu@200 {
 			compatible = "qcom,oryon";
 			reg = <0x0 0x200>;
