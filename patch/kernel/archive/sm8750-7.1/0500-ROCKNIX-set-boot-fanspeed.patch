+	uint32_t revn;
+	const char *fw[ADRENO_FW_MAX];
+	uint32_t gmem;
+	u64 quirks;
+	const struct adreno_gpu_funcs *funcs;
+	const char *zapfw;
+	u32 inactive_period;
+	union {
+		const struct a6xx_info *a6xx;
+	};
+	/**
+	 * @speedbins: Optional table of fuse to speedbin mappings
+	 *
+	 * Consists of pairs of fuse, index mappings, terminated with
+	 * {SHRT_MAX, 0} sentinal.
