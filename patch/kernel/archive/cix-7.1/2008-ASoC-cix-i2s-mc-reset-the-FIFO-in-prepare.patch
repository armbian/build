From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Igor Pecovnik <igor@armbian.com>
Date: Sun, 1 Nov 2026 19:00:00 +0100
Subject: [PATCH] ASoC: cix: i2s-mc: reset the FIFO in prepare

Port two fixes from the vendor driver:

- Reset the FIFO in prepare, not in startup. PipeWire keeps the PCM open
  and prepares it again after a pause or an xrun. The FIFO then starts
  empty for each stream.
- Mask the global interrupt request. The ISR only counts underruns.

Assisted-by: Claude Opus 5.5
Signed-off-by: Igor Pecovnik <igor@armbian.com>
---
--- a/sound/soc/cix/cdns_i2s_mc.c
+++ b/sound/soc/cix/cdns_i2s_mc.c
@@ -499,7 +499,7 @@
 	return 0;
 }
 
-static int cdns_i2s_mc_startup(struct snd_pcm_substream *substream,
+static int cdns_i2s_mc_prepare(struct snd_pcm_substream *substream,
 			       struct snd_soc_dai *cpu_dai)
 {
 	struct cdns_i2s_mc_priv *i2s_mc_priv = snd_soc_dai_get_drvdata(cpu_dai);
@@ -568,12 +568,9 @@
 				   I2S_RFIFO_CTRL_RAEMPTY_THRESHOLD | I2S_RFIFO_CTRL_RAFULL_THRESHOLD, fifo);
 	}
 
-	/*
-	 * Enable global interrupt mask, for both transmitter and recevider, use
-	 * individual interrupt masks
-	 */
+	/* Mask the global interrupt request, as the vendor driver does */
 	regmap_update_bits(i2s_mc_priv->regmap, I2S_CID_CTRL,
-			   I2S_CID_CTRL_INTREQ_MASK, I2S_CID_CTRL_INTREQ_MASK);
+			   I2S_CID_CTRL_INTREQ_MASK, 0);
 
 	return 0;
 }
@@ -741,8 +738,8 @@
 	.probe = cdns_i2s_mc_dai_probe,
 	.set_fmt = cdns_i2s_mc_set_fmt,
 
-	.startup = cdns_i2s_mc_startup,
 	.hw_params = cdns_i2s_mc_hw_params,
+	.prepare = cdns_i2s_mc_prepare,
 	.trigger = cdns_i2s_mc_trigger,
 };
 
