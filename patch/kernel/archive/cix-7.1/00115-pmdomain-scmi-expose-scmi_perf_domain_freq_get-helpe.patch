From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jianfeng Liu <Jianfeng.Liu@cixtech.com>
Date: Thu, 16 Jul 2026 12:51:18 +0800
Subject: pmdomain: scmi: expose scmi_perf_domain_freq_get() helper

Add a public helper to read the current frequency of an SCMI perf
domain, mirroring the existing scmi_perf_domain_est_power()/
scmi_perf_domain_power_scale() helpers. It reads the performance level
back from firmware (via the fastchannel when available) and converts it
to a frequency.

This lets consumers that drive DVFS through the perf genpd query the
real operating frequency, which the clock rate cache does not track.

Co-Authored-By: Claude <noreply@anthropic.com>
---
 drivers/pmdomain/arm/scmi_perf_domain.c | 30 ++++++++++
 include/linux/scmi_perf_domain.h        |  6 ++
 2 files changed, 36 insertions(+)

diff --git a/drivers/pmdomain/arm/scmi_perf_domain.c b/drivers/pmdomain/arm/scmi_perf_domain.c
index 111111111111..222222222222 100644
--- a/drivers/pmdomain/arm/scmi_perf_domain.c
+++ b/drivers/pmdomain/arm/scmi_perf_domain.c
@@ -318,6 +318,36 @@ enum scmi_power_scale scmi_perf_domain_power_scale(struct device *dev)
 }
 EXPORT_SYMBOL_GPL(scmi_perf_domain_power_scale);
 
+/**
+ * scmi_perf_domain_freq_get() - Get the current frequency of an SCMI perf domain
+ * @dev:  Device attached to an SCMI perf domain genpd
+ * @rate: [out] Current frequency in Hz
+ *
+ * Reads the performance level back from firmware (via the fastchannel when
+ * available) and converts it to a frequency. This reflects the real operating
+ * frequency, which the clock rate cache does not track when DVFS goes through
+ * the perf domain.
+ *
+ * Returns 0 on success, or negative error.
+ */
+int scmi_perf_domain_freq_get(struct device *dev, unsigned long *rate)
+{
+	struct generic_pm_domain *genpd;
+	struct scmi_perf_domain *pd;
+
+	if (!dev || !dev->pm_domain)
+		return -ENODEV;
+
+	genpd = pd_to_genpd(dev->pm_domain);
+	if (IS_ERR(genpd) ||
+	    genpd->set_performance_state != scmi_pd_set_perf_state)
+		return -ENODEV;
+
+	pd = to_scmi_pd(genpd);
+	return pd->perf_ops->freq_get(pd->ph, pd->domain_id, rate, false);
+}
+EXPORT_SYMBOL_GPL(scmi_perf_domain_freq_get);
+
 module_scmi_driver(scmi_perf_domain_driver);
 
 MODULE_AUTHOR("Ulf Hansson <ulf.hansson@linaro.org>");
diff --git a/include/linux/scmi_perf_domain.h b/include/linux/scmi_perf_domain.h
index 111111111111..222222222222 100644
--- a/include/linux/scmi_perf_domain.h
+++ b/include/linux/scmi_perf_domain.h
@@ -15,6 +15,7 @@
 int scmi_perf_domain_est_power(struct device *dev,
 			       unsigned long *rate, unsigned long *power);
 enum scmi_power_scale scmi_perf_domain_power_scale(struct device *dev);
+int scmi_perf_domain_freq_get(struct device *dev, unsigned long *rate);
 
 #else
 
@@ -30,5 +31,10 @@ static inline enum scmi_power_scale scmi_perf_domain_power_scale(struct device *
 	return SCMI_POWER_BOGOWATTS;
 }
 
+static inline int scmi_perf_domain_freq_get(struct device *dev, unsigned long *rate)
+{
+	return -ENODEV;
+}
+
 #endif /* CONFIG_ARM_SCMI_PERF_DOMAIN */
 #endif /* _LINUX_SCMI_PERF_DOMAIN_H */
-- 
Armbian

