From 169ddd2b08f387e6b9164afa100e08c013e72fc7 Mon Sep 17 00:00:00 2001
From: Ondrej Jirman <megi@xff.cz>
Date: Thu, 13 Aug 2026 13:04:03 +0200
Subject: [PATCH] video: sun5i-eink: use the vendor layer attributes for
 palette mode

The palette RAM stores 24 bits per entry, so per-pixel alpha is
always 0 and the layer blends away into the backcolor - all pins
flat, dead panel. The vendor's ATTCTL0 value carries global alpha
0xff with the per-layer override enabled; use it verbatim.
---
 drivers/video/fbdev/sun5i-eink.c | 10 ++++++----
 1 file changed, 6 insertions(+), 4 deletions(-)

diff --git a/drivers/video/fbdev/sun5i-eink.c b/drivers/video/fbdev/sun5i-eink.c
index 8c4b58ff207e..7d94a8a9b647 100644
--- a/drivers/video/fbdev/sun5i-eink.c
+++ b/drivers/video/fbdev/sun5i-eink.c
@@ -302,10 +302,12 @@ static void eink_debe_setup(struct eink_dev *eink, struct eink_buffer *buf)
 	regmap_write(be, SUN4I_BACKEND_LAYLINEWIDTH_REG(0),
 		     eink->pix.bytesperline * 8);
 
-	regmap_write(be, SUN4I_BACKEND_ATTCTL_REG0(0),
-		     SUN4I_BACKEND_ATTCTL_REG0_LAY_WORKMOD(0) |
-		     SUN4I_BACKEND_ATTCTL_REG0_LAY_PIPESEL(0) |
-		     SUN4I_BACKEND_ATTCTL_REG0_LAY_PRISEL(3));
+	/* The vendor epdc value, verbatim: global alpha 0xff + enable is
+	 * REQUIRED - the palette RAM stores only 24 bits, so per-pixel
+	 * alpha reads as 0 and without the global override the layer
+	 * blends fully transparent over the backcolor: every pin stays
+	 * low and the panel never reacts. */
+	regmap_write(be, SUN4I_BACKEND_ATTCTL_REG0(0), 0xff400301);
 	regmap_write(be, SUN4I_BACKEND_ATTCTL_REG1(0),
 		     SUN4I_BACKEND_LAY_FBFMT_8BPP);
 
