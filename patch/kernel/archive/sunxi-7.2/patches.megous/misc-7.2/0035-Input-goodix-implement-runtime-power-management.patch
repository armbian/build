From 5f94d1bf50739482159e18c53a4276888c7b364b Mon Sep 17 00:00:00 2001
From: Ondrej Jirman <megi@xff.cz>
Date: Fri, 17 Jul 2026 15:58:29 +0200
Subject: [PATCH] Input: goodix - implement runtime power management

Disable the touchscreen when nothing is using it.

Signed-off-by: Ondrej Jirman <megi@xff.cz>
---
 drivers/input/touchscreen/goodix.c | 51 ++++++++++++++++++++++++++++--
 1 file changed, 49 insertions(+), 2 deletions(-)

diff --git a/drivers/input/touchscreen/goodix.c b/drivers/input/touchscreen/goodix.c
index 15e3b772987b..b127efae118f 100644
--- a/drivers/input/touchscreen/goodix.c
+++ b/drivers/input/touchscreen/goodix.c
@@ -18,6 +18,7 @@
 #include <linux/delay.h>
 #include <linux/irq.h>
 #include <linux/interrupt.h>
+#include <linux/pm_runtime.h>
 #include <linux/platform_data/x86/soc.h>
 #include <linux/slab.h>
 #include <linux/acpi.h>
@@ -36,6 +37,8 @@
 #define GOODIX_MAX_CONTACT_SIZE		9
 #define GOODIX_MAX_CONTACTS		10
 
+#define GOODIX_AUTOSUSPEND_DELAY_MS	500
+
 #define GOODIX_CONFIG_MIN_LENGTH	186
 #define GOODIX_CONFIG_911_LENGTH	186
 #define GOODIX_CONFIG_967_LENGTH	228
@@ -310,6 +313,21 @@ static int goodix_ts_read_input_report(struct goodix_ts_data *ts, u8 *data)
 	return -ENOMSG;
 }
 
+static int goodix_input_open(struct input_dev *dev)
+{
+	struct goodix_ts_data *ts = input_get_drvdata(dev);
+
+	return pm_runtime_resume_and_get(&ts->client->dev);
+}
+
+static void goodix_input_close(struct input_dev *dev)
+{
+	struct goodix_ts_data *ts = input_get_drvdata(dev);
+
+	pm_runtime_mark_last_busy(&ts->client->dev);
+	pm_runtime_put_autosuspend(&ts->client->dev);
+}
+
 static int goodix_create_pen_input(struct goodix_ts_data *ts)
 {
 	struct device *dev = &ts->client->dev;
@@ -344,6 +362,10 @@ static int goodix_create_pen_input(struct goodix_ts_data *ts)
 		input->id.product = 0x1001;
 	input->id.version = ts->version;
 
+	input_set_drvdata(input, ts);
+	input->open = goodix_input_open;
+	input->close = goodix_input_close;
+
 	ts->input_pen = input;
 	return 0;
 }
@@ -1242,6 +1264,8 @@ static int goodix_configure_dev(struct goodix_ts_data *ts)
 	}
 
 	input_set_drvdata(ts->input_dev, ts);
+	ts->input_dev->open = goodix_input_open;
+	ts->input_dev->close = goodix_input_close;
 
 	if (!ts->client->irq) {
 		error = input_setup_polling(ts->input_dev, goodix_ts_work_i2c_poll);
@@ -1278,6 +1302,21 @@ static int goodix_configure_dev(struct goodix_ts_data *ts)
 		return error;
 	}
 
+	/*
+	 * Enable runtime power management. The device is suspended when
+	 * no userspace has the input device open, and resumed on open.
+	 * Keep it active across the enable, then drop the reference so
+	 * autosuspend can kick in when the device stays unopened.
+	 */
+	pm_runtime_set_autosuspend_delay(&ts->client->dev,
+					 GOODIX_AUTOSUSPEND_DELAY_MS);
+	pm_runtime_use_autosuspend(&ts->client->dev);
+	pm_runtime_set_active(&ts->client->dev);
+	pm_runtime_get_noresume(&ts->client->dev);
+	pm_runtime_enable(&ts->client->dev);
+	pm_runtime_mark_last_busy(&ts->client->dev);
+	pm_runtime_put_autosuspend(&ts->client->dev);
+
 	return 0;
 }
 
@@ -1444,6 +1483,14 @@ static void goodix_ts_remove(struct i2c_client *client)
 {
 	struct goodix_ts_data *ts = i2c_get_clientdata(client);
 
+	/*
+	 * Resume the device if it is runtime suspended, so that the devm
+	 * cleanups (irq, regulators) run with the device powered on, then
+	 * disable runtime power management.
+	 */
+	pm_runtime_get_sync(&client->dev);
+	pm_runtime_disable(&client->dev);
+
 	if (ts->load_cfg_from_disk)
 		wait_for_completion(&ts->firmware_loading_complete);
 
@@ -1582,7 +1629,7 @@ static int goodix_resume(struct device *dev)
 	return 0;
 }
 
-static DEFINE_SIMPLE_DEV_PM_OPS(goodix_pm_ops, goodix_suspend, goodix_resume);
+static DEFINE_RUNTIME_DEV_PM_OPS(goodix_pm_ops, goodix_suspend, goodix_resume, NULL);
 
 static const struct i2c_device_id goodix_ts_id[] = {
 	{ .name = "GDIX1001:00" },
@@ -1630,7 +1677,7 @@ static struct i2c_driver goodix_ts_driver = {
 		.name = "Goodix-TS",
 		.acpi_match_table = ACPI_PTR(goodix_acpi_match),
 		.of_match_table = of_match_ptr(goodix_of_match),
-		.pm = pm_sleep_ptr(&goodix_pm_ops),
+		.pm = pm_ptr(&goodix_pm_ops),
 	},
 };
 module_i2c_driver(goodix_ts_driver);
-- 
2.43.0

