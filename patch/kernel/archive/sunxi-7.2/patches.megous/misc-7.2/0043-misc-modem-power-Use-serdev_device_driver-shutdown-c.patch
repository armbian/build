From ca74b4117285287947839dd45ba97f1fefa69a39 Mon Sep 17 00:00:00 2001
From: Ondrej Jirman <megi@xff.cz>
Date: Sun, 26 Jul 2026 00:54:29 +0200
Subject: [PATCH] misc: modem-power: Use serdev_device_driver shutdown callback

Setting device_driver.shutdown makes driver_register() warn ("Driver
'modem-power' needs updating - please use bus_type methods") and the
callback is never invoked, because the serdev bus has its own shutdown
method that takes precedence. Use the serdev_device_driver shutdown
callback instead, so the modem is actually powered down on shutdown.

Signed-off-by: Ondrej Jirman <megi@xff.cz>
---
 drivers/misc/modem-power.c | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/drivers/misc/modem-power.c b/drivers/misc/modem-power.c
index 36204f30316b..b7bbb70ec2c1 100644
--- a/drivers/misc/modem-power.c
+++ b/drivers/misc/modem-power.c
@@ -1879,9 +1879,9 @@ static const struct of_device_id mpwr_of_match_serdev[] = {
 };
 MODULE_DEVICE_TABLE(of, mpwr_of_match_serdev);
 
-static void mpwr_serdev_shutdown(struct device *dev)
+static void mpwr_serdev_shutdown(struct serdev_device *serdev)
 {
-	struct mpwr_dev *mpwr = dev_get_drvdata(dev);
+	struct mpwr_dev *mpwr = dev_get_drvdata(&serdev->dev);
 
 	mpwr_shutdown_generic(mpwr);
 }
@@ -1889,11 +1889,11 @@ static void mpwr_serdev_shutdown(struct device *dev)
 static struct serdev_device_driver mpwr_serdev_driver = {
         .probe  = mpwr_serdev_probe,
         .remove = mpwr_serdev_remove,
+        .shutdown = mpwr_serdev_shutdown,
         .driver = {
                 .name = DRIVER_NAME,
                 .of_match_table = mpwr_of_match_serdev,
 		.pm = &mpwr_pm_ops,
-		.shutdown = mpwr_serdev_shutdown,
         },
 };
 
