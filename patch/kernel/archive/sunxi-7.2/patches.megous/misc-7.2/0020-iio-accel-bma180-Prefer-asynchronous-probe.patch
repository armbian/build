From eec455d2e2a5b35084e6dfe49bc739200fa75d95 Mon Sep 17 00:00:00 2001
From: Ondrej Jirman <megi@xff.cz>
Date: Tue, 21 Jul 2026 15:34:24 +0200
Subject: [PATCH] iio: accel: bma180: Prefer asynchronous probe

The driver is slow to probe and nothing in the boot path depends on it
being ready synchronously, so let it probe in parallel. This makes it
faster to boot the TBS A711 tablet.

Signed-off-by: Ondrej Jirman <megi@xff.cz>
---
 drivers/iio/accel/bma180.c | 1 +
 1 file changed, 1 insertion(+)

diff --git a/drivers/iio/accel/bma180.c b/drivers/iio/accel/bma180.c
index 62bda8d76691..313f35bca7b6 100644
--- a/drivers/iio/accel/bma180.c
+++ b/drivers/iio/accel/bma180.c
@@ -1122,6 +1122,7 @@ static struct i2c_driver bma180_driver = {
 		.name	= "bma180",
 		.pm	= pm_sleep_ptr(&bma180_pm_ops),
 		.of_match_table = bma180_of_match,
+		.probe_type = PROBE_PREFER_ASYNCHRONOUS,
 	},
 	.probe		= bma180_probe,
 	.remove		= bma180_remove,
-- 
2.43.0

