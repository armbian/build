From 47e1bd7f6c6098cdd2e7051404843e8399fa94ca Mon Sep 17 00:00:00 2001
From: Ondrej Jirman <megi@xff.cz>
Date: Mon, 20 Jul 2026 02:31:33 +0200
Subject: [PATCH] dt-bindings: usb: sun4i-a10-musb: Add A64 compatible and idma
 region

allwinner,sun50i-a64-musb has been in sun50i-a64.dtsi since the A64
internal DMA support went in, but was never added here, so the node fails
dtbs_check. Add it to the sun8i-a33-musb fallback list.

The idma registers sit at 0x1c19500, above the USB PHY, so they cannot be
covered by widening the single existing region. Allow a second reg entry
for them and name the two regions. Only the A64 has the engine, so every
other compatible stays at one region.
Signed-off-by: Ondrej Jirman <megi@xff.cz>
---
 .../usb/allwinner,sun4i-a10-musb.yaml         | 51 ++++++++++++++-----
 1 file changed, 38 insertions(+), 13 deletions(-)

diff --git a/Documentation/devicetree/bindings/usb/allwinner,sun4i-a10-musb.yaml b/Documentation/devicetree/bindings/usb/allwinner,sun4i-a10-musb.yaml
index 7ffcd236d7bb..ac11d999d370 100644
--- a/Documentation/devicetree/bindings/usb/allwinner,sun4i-a10-musb.yaml
+++ b/Documentation/devicetree/bindings/usb/allwinner,sun4i-a10-musb.yaml
@@ -23,6 +23,7 @@ properties:
           - enum:
               - allwinner,sun8i-a83t-musb
               - allwinner,sun20i-d1-musb
+              - allwinner,sun50i-a64-musb
               - allwinner,sun50i-a100-musb
               - allwinner,sun50i-h6-musb
               - allwinner,sun55i-a523-musb
@@ -32,7 +33,16 @@ properties:
           - const: allwinner,sun8i-h3-musb
 
   reg:
-    maxItems: 1
+    minItems: 1
+    items:
+      - description: MUSB core registers
+      - description: Allwinner USB-OTG internal DMA registers
+
+  reg-names:
+    minItems: 1
+    items:
+      - const: mc
+      - const: dma
 
   interrupts:
     maxItems: 1
@@ -76,18 +86,33 @@ required:
   - dr_mode
   - extcon
 
-if:
-  properties:
-    compatible:
-      contains:
-        enum:
-          - allwinner,sun6i-a31-musb
-          - allwinner,sun8i-a33-musb
-          - allwinner,sun8i-h3-musb
-
-then:
-  required:
-    - resets
+allOf:
+  - if:
+      properties:
+        compatible:
+          contains:
+            enum:
+              - allwinner,sun6i-a31-musb
+              - allwinner,sun8i-a33-musb
+              - allwinner,sun8i-h3-musb
+    then:
+      required:
+        - resets
+
+  # Only the A64 has the vendor "internal DMA" engine, and hence a second
+  # register region.
+  - if:
+      not:
+        properties:
+          compatible:
+            contains:
+              const: allwinner,sun50i-a64-musb
+    then:
+      properties:
+        reg:
+          maxItems: 1
+        reg-names:
+          maxItems: 1
 
 additionalProperties: false
 
-- 
2.43.0

