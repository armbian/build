--- a/drivers/usb/musb/sunxi.c
+++ b/drivers/usb/musb/sunxi.c
@@ -9,6 +9,8 @@
  */
 
 #include <linux/clk.h>
+#include <linux/dma/sun4i-dma.h>
+#include <linux/dmaengine.h>
 #include <linux/err.h>
 #include <linux/extcon.h>
