From 8f9edb3a42c6dcee90ee11ff2d9355ca49098628 Mon Sep 17 00:00:00 2001
From: Ondrej Jirman <megi@xff.cz>
Date: Fri, 24 Jul 2026 19:32:21 +0200
Subject: [PATCH] usb: musb: sunxi: Add system DMA (ddma) support for the A13

The A13 USB controller has no DMA engine of its own; the SoC's
dedicated DMA engine moves FIFO data instead, handshaking over a single
USB DRQ line that VEND0 muxes to one endpoint FIFO at a time. Drive it
through the dmaengine API (modeled on ux500_dma.c), with a channel
described in DT.

Differences from the idma path, all forced by the hardware or the
framework:

- one transfer in flight globally: whoever hits channel_program()
  second falls back to PIO for that transfer (single DRQ + VEND0 mux)
- completion arrives in the dmaengine tasklet callback instead of the
  shared USB interrupt, so it takes musb->lock itself; an abort under
  that lock must use the non-syncing terminate to avoid deadlocking
- no TXCSR pre-arming in channel_program(): the engine waits for the
  DRQ handshake, which only starts once the core sets the endpoint's
  CSR DMA bits, so the core's own ordering suffices
- no MUSB_DMA_RX_MODE1_ALWAYS: the core's standard mode selection
  (mode 1 multi-packet arms only for exact-length short_not_ok
  requests, per-packet mode 0 otherwise) matches what the vendor
  driver did on this hardware

The DDMA timing parameters (one packet per DRQ handshake, 16 wait
cycles on the USB side) are the vendor driver's, passed through the
sun4i-dma peripheral_config override.

Signed-off-by: Ondrej Jirman <megi@xff.cz>
---
 drivers/usb/musb/Kconfig     |  11 +
 drivers/usb/musb/musb_core.h |   2 +-
 drivers/usb/musb/sunxi.c     | 500 +++++++++++++++++++++++++++++++++--
 3 files changed, 491 insertions(+), 22 deletions(-)

diff --git a/drivers/usb/musb/Kconfig b/drivers/usb/musb/Kconfig
index 5ca7491a6809..6584b0b0494e 100644
--- a/drivers/usb/musb/Kconfig
+++ b/drivers/usb/musb/Kconfig
@@ -162,6 +162,17 @@ config USB_SUNXI_IDMA
 	  The A83T, H3/H5 and A64 are supported; other sunxi SoCs fall
 	  back to PIO.
 
+config USB_SUNXI_DDMA
+	bool 'Allwinner USB-OTG system DMA'
+	depends on USB_MUSB_SUNXI
+	depends on DMA_SUN4I
+	help
+	  Enable USB-OTG DMA transfers through the SoC's dedicated DMA
+	  engine on Allwinner SoCs whose USB controller has no DMA
+	  engine of its own.
+
+	  Only the A13 is supported; other sunxi SoCs fall back to PIO.
+
 config USB_TI_CPPI41_DMA
 	bool 'TI CPPI 4.1'
 	depends on (ARCH_OMAP || ARCH_DAVINCI_DA8XX) && DMADEVICES
diff --git a/drivers/usb/musb/musb_core.h b/drivers/usb/musb/musb_core.h
