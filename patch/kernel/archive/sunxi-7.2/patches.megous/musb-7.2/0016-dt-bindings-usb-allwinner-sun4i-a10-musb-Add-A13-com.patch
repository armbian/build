From 8c23df69e480a73e0f3897988f22be4591c3a563 Mon Sep 17 00:00:00 2001
From: Ondrej Jirman <megi@xff.cz>
Date: Fri, 24 Jul 2026 19:32:53 +0200
Subject: [PATCH] dt-bindings: usb: allwinner,sun4i-a10-musb: Add A13
 compatible and DMA channel

The A13 controller has no DMA engine of its own; DMA transfers go
through a channel of the SoC DMA engine instead. Add a dedicated A13
compatible (with the A10 fallback it used until now) and let it
describe that channel.

Signed-off-by: Ondrej Jirman <megi@xff.cz>
---
 .../usb/allwinner,sun4i-a10-musb.yaml         | 23 +++++++++++++++++++
 1 file changed, 23 insertions(+)

diff --git a/Documentation/devicetree/bindings/usb/allwinner,sun4i-a10-musb.yaml b/Documentation/devicetree/bindings/usb/allwinner,sun4i-a10-musb.yaml
index 2e2f2787bdf2..79b6d7908fc3 100644
--- a/Documentation/devicetree/bindings/usb/allwinner,sun4i-a10-musb.yaml
+++ b/Documentation/devicetree/bindings/usb/allwinner,sun4i-a10-musb.yaml
@@ -31,6 +31,9 @@ properties:
       - items:
           - const: allwinner,sun50i-h616-musb
           - const: allwinner,sun8i-h3-musb
+      - items:
+          - const: allwinner,sun5i-a13-musb
+          - const: allwinner,sun4i-a10-musb
 
   reg:
     minItems: 1
@@ -50,6 +53,13 @@ properties:
   interrupt-names:
     const: mc
 
+  dmas:
+    maxItems: 1
+    description: SoC DMA engine channel used for both directions
+
+  dma-names:
+    const: rxtx
+
   clocks:
     maxItems: 1
 
@@ -117,6 +127,19 @@ allOf:
         reg-names:
           maxItems: 1
 
+  # Only SoCs whose controller has no DMA engine of its own (A13) use a
+  # channel of the SoC DMA engine.
+  - if:
+      not:
+        properties:
+          compatible:
+            contains:
+              const: allwinner,sun5i-a13-musb
+    then:
+      properties:
+        dmas: false
+        dma-names: false
+
 additionalProperties: false
 
 examples:
-- 
2.43.0

