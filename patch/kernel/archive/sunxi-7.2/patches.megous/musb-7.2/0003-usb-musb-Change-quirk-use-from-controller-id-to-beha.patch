diff --git a/drivers/usb/musb/musb_core.h b/drivers/usb/musb/musb_core.h
index 44484fea63cb..ff7111846698 100644
--- a/drivers/usb/musb/musb_core.h
+++ b/drivers/usb/musb/musb_core.h
@@ -147,31 +147,48 @@ struct musb_platform_ops {
 #define MUSB_DA8XX		BIT(8)
 #define MUSB_PRESERVE_SESSION	BIT(7)
 /*
- * A DMA-engine quirk bit is only defined when its DMA backend is built in;
- * otherwise it is 0, so the musb_dma_*() accessors fold to a compile-time 0 and
- * that engine's code paths are dead-code eliminated (as the old per-accessor
- * #ifdefs used to do).
+ * DMA behavioral capabilities. Generic core/host/gadget code queries these
+ * instead of the identity of whichever DMA engine a glue driver wires up; each
+ * glue declares the behaviors its engine needs.
+ *
+ * A capability bit is nonzero only when DMA is compiled in at all (i.e. not
+ * CONFIG_MUSB_PIO_ONLY) and at least one engine that needs it is built in;
+ * otherwise it falls through to 0, so the musb_dma_*() accessors fold to a
+ * compile-time 0 and that behavior's code is dead-code eliminated.
+ *
+ * MUSB_DMA_SW_MODE_SELECT: driver selects DMA mode 0/1 and drives CSR
+ * MUSB_DMA_ENGINE_MANAGED: engine drives the transfer; needs tx_dma_start
+ * MUSB_DMA_QUEUE_AUTOADVANCE: engine keeps advancing its queue past short
+ * packets, so HW acks short RX and the driver must not (the only such engine is
+ * CPPI 4.1)
+ * MUSB_DMA_RX_MODE_AUTOCLEAR: gadget RX: AutoClear-then-mode sequence
  */
-#ifdef CONFIG_USB_UX500_DMA
-#define MUSB_DMA_UX500		BIT(6)
-#else
-#define MUSB_DMA_UX500		0
+#ifndef CONFIG_MUSB_PIO_ONLY
+#if defined(CONFIG_USB_INVENTRA_DMA) || defined(CONFIG_USB_UX500_DMA)
+#define MUSB_DMA_SW_MODE_SELECT		BIT(5)
+#endif
+#if defined(CONFIG_USB_TI_CPPI41_DMA) || defined(CONFIG_USB_TUSB_OMAP_DMA)
+#define MUSB_DMA_ENGINE_MANAGED		BIT(4)
 #endif
 #ifdef CONFIG_USB_TI_CPPI41_DMA
-#define MUSB_DMA_CPPI41		BIT(5)
-#else
-#define MUSB_DMA_CPPI41		0
+#define MUSB_DMA_QUEUE_AUTOADVANCE	BIT(3)
+#endif
+#ifdef CONFIG_USB_UX500_DMA
+#define MUSB_DMA_RX_MODE_AUTOCLEAR	BIT(2)
+#endif
+#endif /* !CONFIG_MUSB_PIO_ONLY */
+
+#ifndef MUSB_DMA_SW_MODE_SELECT
+#define MUSB_DMA_SW_MODE_SELECT		0
+#endif
+#ifndef MUSB_DMA_ENGINE_MANAGED
+#define MUSB_DMA_ENGINE_MANAGED		0
 #endif
-#define MUSB_DMA_CPPI		BIT(4)
-#ifdef CONFIG_USB_TUSB_OMAP_DMA
-#define MUSB_DMA_TUSB_OMAP	BIT(3)
-#else
-#define MUSB_DMA_TUSB_OMAP	0
+#ifndef MUSB_DMA_QUEUE_AUTOADVANCE
+#define MUSB_DMA_QUEUE_AUTOADVANCE	0
 #endif
-#ifdef CONFIG_USB_INVENTRA_DMA
-#define MUSB_DMA_INVENTRA	BIT(2)
-#else
-#define MUSB_DMA_INVENTRA	0
+#ifndef MUSB_DMA_RX_MODE_AUTOCLEAR
+#define MUSB_DMA_RX_MODE_AUTOCLEAR	0
 #endif
 #define MUSB_IN_TUSB		BIT(1)
 #define MUSB_INDEXED_EP		BIT(0)
diff --git a/drivers/usb/musb/musb_dma.h b/drivers/usb/musb/musb_dma.h
index aaab6eda0668..c794b11c636e 100644
--- a/drivers/usb/musb/musb_dma.h
+++ b/drivers/usb/musb/musb_dma.h
@@ -49,11 +49,17 @@ struct musb_hw_ep;
 #define	is_dma_capable()	(1)
 #endif
 
-#define musb_dma_ux500(musb)		(musb->ops->quirks & MUSB_DMA_UX500)
-#define musb_dma_cppi41(musb)		(musb->ops->quirks & MUSB_DMA_CPPI41)
-#define tusb_dma_omap(musb)		(musb->ops->quirks & MUSB_DMA_TUSB_OMAP)
-#define musb_dma_inventra(musb)		(musb->ops->quirks & MUSB_DMA_INVENTRA)
-#define	is_cppi_enabled(musb)		musb_dma_cppi41(musb)
+/*
+ * DMA behavioral capability accessors. Generic core/host/gadget code asks what
+ * a DMA engine needs, never which engine it is; each glue driver declares these
+ * in its musb_platform_ops.quirks. They are only evaluated inside
+ * is_dma_capable() / musb->dma_controller guarded regions, so PIO-only builds
+ * still fold the surrounding block away.
+ */
+#define musb_dma_sw_mode_select(musb)	 ((musb)->ops->quirks & MUSB_DMA_SW_MODE_SELECT)
+#define musb_dma_engine_managed(musb)	 ((musb)->ops->quirks & MUSB_DMA_ENGINE_MANAGED)
+#define musb_dma_queue_autoadvance(musb) ((musb)->ops->quirks & MUSB_DMA_QUEUE_AUTOADVANCE)
+#define musb_dma_rx_mode_autoclear(musb) ((musb)->ops->quirks & MUSB_DMA_RX_MODE_AUTOCLEAR)
 
 /*
  * DMA channel status ... updated by the dma controller driver whenever that
diff --git a/drivers/usb/musb/musb_dsps.c b/drivers/usb/musb/musb_dsps.c
