From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ondrej Jirman <megi@xff.cz>
Date: Fri, 24 Jul 2026 19:25:49 +0200
Subject: usb: musb: sunxi: Add A13 compatible

Add a dedicated match entry for the A13, for now identical to the A10
one it used as a fallback. This gives the A13 a place to declare its
system-DMA wiring, which the A10 entry (shared with SoCs that are not
wired for it in DT) can't.

Signed-off-by: Ondrej Jirman <megi@xff.cz>
---
 drivers/usb/musb/sunxi.c | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/drivers/usb/musb/sunxi.c b/drivers/usb/musb/sunxi.c
index 111111111111..222222222222 100644
--- a/drivers/usb/musb/sunxi.c
+++ b/drivers/usb/musb/sunxi.c
@@ -1364,6 +1364,11 @@ static const struct sunxi_musb_cfg sun4i_a10_musb_cfg = {
 	.has_sram = true,
 };
 
+static const struct sunxi_musb_cfg sun5i_a13_musb_cfg = {
+	.hdrc_config = &sunxi_musb_hdrc_config_5eps,
+	.has_sram = true,
+};
+
 static const struct sunxi_musb_cfg sun6i_a31_musb_cfg = {
 	.hdrc_config = &sunxi_musb_hdrc_config_5eps,
 	.has_reset = true,
@@ -1406,6 +1411,8 @@ static const struct sunxi_musb_cfg suniv_f1c100s_musb_cfg = {
 static const struct of_device_id sunxi_musb_match[] = {
 	{ .compatible = "allwinner,sun4i-a10-musb",
 	  .data = &sun4i_a10_musb_cfg, },
+	{ .compatible = "allwinner,sun5i-a13-musb",
+	  .data = &sun5i_a13_musb_cfg, },
 	{ .compatible = "allwinner,sun6i-a31-musb",
 	  .data = &sun6i_a31_musb_cfg, },
 	{ .compatible = "allwinner,sun8i-a33-musb",
-- 
