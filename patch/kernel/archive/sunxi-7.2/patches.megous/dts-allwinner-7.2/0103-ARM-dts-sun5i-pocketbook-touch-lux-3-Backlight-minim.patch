From 2dd2e7b7b1e85e02791ae7b030615dd59e7e52cd Mon Sep 17 00:00:00 2001
From: Ondrej Jirman <megi@xff.cz>
Date: Thu, 13 Aug 2026 17:02:31 +0200
Subject: [PATCH] ARM: dts: sun5i: pocketbook-touch-lux-3: Backlight minimum
 duty offset

The frontlight boost regulator needs ~11% PWM duty before it starts
reacting: with the plain CIE table light only appeared from step
~1250 of 3124, which is lightness 0.40 -> ((40+16)/116)^3 = 11.3%
duty. Offset the curve with lth-brightness so the whole brightness
range maps above the threshold.

Signed-off-by: Ondrej Jirman <megi@xff.cz>
---
 .../dts/allwinner/sun5i-a13-pocketbook-touch-lux-3.dts     | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/arch/arm/boot/dts/allwinner/sun5i-a13-pocketbook-touch-lux-3.dts b/arch/arm/boot/dts/allwinner/sun5i-a13-pocketbook-touch-lux-3.dts
index 4f5856af6136..4bd6376046ef 100644
--- a/arch/arm/boot/dts/allwinner/sun5i-a13-pocketbook-touch-lux-3.dts
+++ b/arch/arm/boot/dts/allwinner/sun5i-a13-pocketbook-touch-lux-3.dts
@@ -28,8 +28,11 @@ backlight {
 		enable-gpios = <&pio 1 4 GPIO_ACTIVE_HIGH>; /* PB4 */
 		/* no brightness-levels: the driver generates a fine
 		 * CIE 1931 perceptually uniform table (as on the
-		 * PinePhone); tune lth-brightness if the first steps
-		 * turn out dark */
+		 * PinePhone); the boost regulator starts reacting at
+		 * ~11% duty (measured: light from CIE step 1250/3124,
+		 * lightness 0.40 -> ((40+16)/116)^3 = 0.113), so the
+		 * curve is offset to start there */
+		lth-brightness = <13>;
 		power-supply = <&reg_vcc3v3>;
 	};
 
