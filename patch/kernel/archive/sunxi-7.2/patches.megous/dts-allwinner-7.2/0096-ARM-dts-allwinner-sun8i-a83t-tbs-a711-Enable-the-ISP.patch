From effdd377d1711028890361bef5fc9b3bb42379b7 Mon Sep 17 00:00:00 2001
From: Ondrej Jirman <megi@xff.cz>
Date: Mon, 3 Aug 2026 00:40:19 +0200
Subject: [PATCH] ARM: dts: allwinner: sun8i-a83t-tbs-a711: Enable the ISP

Route the tablet's two cameras through the ISP rather than straight to
memory.

Enabling the ISP means the CSI grows a port for it, and a node cannot
describe its connections with both the old single "port" and the newer
numbered "ports" at once -- the binding takes one or the other. So move
the two camera endpoints into ports/port@0, which is where the parallel
input belongs. Both endpoints keep their own properties and labels, and
the pair still sits on one port, only one of them linked at a time,
chosen in the media graph.

Nothing about how the cameras are wired changes. The ISP itself is
enabled but adds no default behaviour: which path a frame takes is
decided by which links userspace enables, and the CSI can still write
straight to memory as before.

Signed-off-by: Ondrej Jirman <megi@xff.cz>
---
 .../dts/allwinner/sun8i-a83t-tbs-a711.dts     | 51 +++++++++++--------
 1 file changed, 31 insertions(+), 20 deletions(-)

diff --git a/arch/arm/boot/dts/allwinner/sun8i-a83t-tbs-a711.dts b/arch/arm/boot/dts/allwinner/sun8i-a83t-tbs-a711.dts
index 74730e435bee..af0c23889b60 100644
--- a/arch/arm/boot/dts/allwinner/sun8i-a83t-tbs-a711.dts
+++ b/arch/arm/boot/dts/allwinner/sun8i-a83t-tbs-a711.dts
@@ -260,32 +260,43 @@ &csi {
 	pinctrl-0 = <&csi_8bit_parallel_pins>, <&csi_mclk_pin>;
 	status = "okay";
 
-	port {
-		#address-cells = <1>;
-		#size-cells = <0>;
-
-		csi_hm5065_ep: endpoint@0 {
+	ports {
+		/*
+		 * Both cameras sit on the parallel port. Only one of them is
+		 * linked at a time, which is chosen in the media graph.
+		 */
+		port@0 {
 			reg = <0>;
-			remote-endpoint = <&hm5065_ep>;
-			bus-width = <8>;
-			data-active = <1>;
-			pclk-sample = <0>;
-			hsync-active = <0>;
-			vsync-active = <1>;
-		};
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			csi_hm5065_ep: endpoint@0 {
+				reg = <0>;
+				remote-endpoint = <&hm5065_ep>;
+				bus-width = <8>;
+				data-active = <1>;
+				pclk-sample = <0>;
+				hsync-active = <0>;
+				vsync-active = <1>;
+			};
 
-		csi_gc2145_ep: endpoint@1 {
-			reg = <1>;
-			remote-endpoint = <&gc2145_ep>;
-			bus-width = <8>;
-			hsync-active = <1>;
-			vsync-active = <1>;
-			data-active = <1>;
-			pclk-sample = <1>;
+			csi_gc2145_ep: endpoint@1 {
+				reg = <1>;
+				remote-endpoint = <&gc2145_ep>;
+				bus-width = <8>;
+				hsync-active = <1>;
+				vsync-active = <1>;
+				data-active = <1>;
+				pclk-sample = <1>;
+			};
 		};
 	};
 };
 
+&isp {
+	status = "okay";
+};
+
 &de {
 	status = "okay";
 };
-- 
