From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ondrej Jirman <megi@xff.cz>
Date: Tue, 4 Aug 2026 20:05:00 +0200
Subject: ARM: dts: allwinner: sun8i-a83t-tbs-a711: Enable headset jack
 detection

The AC100's IRQ_AUDIO line was already wired up (PL12); what was
missing is everything that makes the codec's jack machinery run: the
jack-type telling it a 4-pole headset is expected, the digital codec
listed among the aux devices (simple-card only calls set_jack for aux
components), and the jack-pins mapping so plug state drives the
Headphone Jack and Headset Microphone DAPM pins.

Signed-off-by: Ondrej Jirman <megi@xff.cz>
---
 arch/arm/boot/dts/allwinner/sun8i-a83t-tbs-a711.dts | 19 +++++++++-
 1 file changed, 18 insertions(+), 1 deletion(-)

diff --git a/arch/arm/boot/dts/allwinner/sun8i-a83t-tbs-a711.dts b/arch/arm/boot/dts/allwinner/sun8i-a83t-tbs-a711.dts
index 111111111111..222222222222 100644
--- a/arch/arm/boot/dts/allwinner/sun8i-a83t-tbs-a711.dts
+++ b/arch/arm/boot/dts/allwinner/sun8i-a83t-tbs-a711.dts
@@ -192,7 +192,23 @@ sound: sound {
 		#size-cells = <0>;
 		compatible = "simple-audio-card";
 		simple-audio-card,name = "ac100-audio";
-		simple-audio-card,aux-devs = <&ac100_codec_analog>, <&speaker_amp>;
+		/*
+		 * The digital codec is an aux device on top of being a
+		 * DAI-link codec: simple-card only wires up jack
+		 * detection (set_jack) for aux components.
+		 */
+		simple-audio-card,aux-devs = <&ac100_codec_analog>,
+					     <&ac100_codec>, <&speaker_amp>;
+		/*
+		 * The component name comes from fmt_single_name(); verify
+		 * against /sys/kernel/debug/asoc/components if the jack
+		 * pins do not follow plug state.
+		 */
+		simple-audio-card,jack-pins =
+				"sun8i-codec.ac100-codec", "Headphone Jack",
+				"sun8i-codec.ac100-codec", "Headset Microphone";
+		/* SND_JACK_HEADPHONE, SND_JACK_MICROPHONE */
+		simple-audio-card,jack-pins-mask = <1>, <2>;
 		simple-audio-card,widgets = "Microphone", "Headset Microphone",
 					    "Microphone", "Internal Microphone",
 					    "Headphone", "Headphone Jack",
@@ -534,6 +550,7 @@ ac100_codec: codec {
 			interrupts = <0 12 IRQ_TYPE_LEVEL_LOW>; /* PL12 */
 			#clock-cells = <0>;
 			clock-output-names = "4M_adda";
+			jack-type = "headset";
 
 			LDOIN-supply = <&reg_aldo2>;
 			AVCC-supply = <&reg_aldo3>;
-- 
Armbian

