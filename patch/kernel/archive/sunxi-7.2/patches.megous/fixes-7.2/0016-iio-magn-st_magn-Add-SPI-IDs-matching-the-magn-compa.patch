From f5509f709f6d579a5337698b6f4da920e0f96b66 Mon Sep 17 00:00:00 2001
From: Ondrej Jirman <megi@xff.cz>
Date: Sun, 26 Jul 2026 00:55:46 +0200
Subject: [PATCH] iio: magn: st_magn: Add SPI IDs matching the -magn
 compatibles

The SPI core warns at driver registration when an of_device_id has no
corresponding spi_device_id ("SPI driver st-magn-spi has no
spi_device_id for st,lis3mdl-magn" and three more), because the id
table names use underscores while the compatibles use -magn. Add the
missing aliases.

Signed-off-by: Ondrej Jirman <megi@xff.cz>
---
 drivers/iio/magnetometer/st_magn_spi.c | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/drivers/iio/magnetometer/st_magn_spi.c b/drivers/iio/magnetometer/st_magn_spi.c
index 69693e836ad7..83ee1bfbc13e 100644
--- a/drivers/iio/magnetometer/st_magn_spi.c
+++ b/drivers/iio/magnetometer/st_magn_spi.c
@@ -93,6 +93,11 @@ static const struct spi_device_id st_magn_id_table[] = {
 	{ LSM9DS1_MAGN_DEV_NAME },
 	{ IIS2MDC_MAGN_DEV_NAME },
 	{ LSM303C_MAGN_DEV_NAME },
+	/* aliases matching the -magn compatible strings */
+	{ "lis3mdl-magn" },
+	{ "lsm303agr-magn" },
+	{ "lsm9ds1-magn" },
+	{ "lsm303c-magn" },
 	{ }
 };
 MODULE_DEVICE_TABLE(spi, st_magn_id_table);
-- 
2.43.0

