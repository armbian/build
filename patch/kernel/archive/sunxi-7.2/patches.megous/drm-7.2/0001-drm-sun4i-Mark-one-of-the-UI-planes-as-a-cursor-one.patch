From 922241038566b66d08c79772a977fcbc60e0fd39 Mon Sep 17 00:00:00 2001
From: Ondrej Jirman <megi@xff.cz>
Date: Mon, 31 Oct 2022 03:23:11 +0100
Subject: [PATCH] drm/sun4i: Mark one of the UI planes as a cursor one

Signed-off-by: Ondrej Jirman <megi@xff.cz>
---
 drivers/gpu/drm/sun4i/sun8i_mixer.c | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/drivers/gpu/drm/sun4i/sun8i_mixer.c b/drivers/gpu/drm/sun4i/sun8i_mixer.c
index 4e4226295010..dc7566408c5a 100644
--- a/drivers/gpu/drm/sun4i/sun8i_mixer.c
+++ b/drivers/gpu/drm/sun4i/sun8i_mixer.c
@@ -352,11 +352,11 @@ static struct drm_plane **sun8i_layers_init(struct drm_device *drm,
 	for (i = 0; i < mixer->cfg->ui_num; i++) {
 		unsigned int index = mixer->cfg->vi_num + i;
 		struct sun8i_layer *layer;
-
+		enum drm_plane_type type = DRM_PLANE_TYPE_OVERLAY;
 		if (i == 0)
 			type = DRM_PLANE_TYPE_PRIMARY;
-		else
-			type = DRM_PLANE_TYPE_OVERLAY;
+		else if (i == (mixer->cfg->ui_num - 1))
+			type = DRM_PLANE_TYPE_CURSOR;
 
 		phy_index = index;
 		if (mixer->cfg->de_type == SUN8I_MIXER_DE33)
-- 
2.43.0

