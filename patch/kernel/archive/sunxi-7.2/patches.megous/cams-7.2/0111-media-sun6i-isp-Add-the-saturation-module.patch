From 333cc96e0719f892b7737696e9da2e730fbcad6d Mon Sep 17 00:00:00 2001
From: Ondrej Jirman <megi@xff.cz>
Date: Sun, 2 Aug 2026 15:13:04 +0200
Subject: [PATCH] media: sun6i-isp: Add the saturation module

Per-channel saturation with a common gain. The three channel fields are
nibbles and the gain is nine bits, which lines up with the vendor's
isp_saturation_config and its satu_r, satu_g, satu_b and satu_gain.

Identical on the A83T and the V3s.

Signed-off-by: Ondrej Jirman <megi@xff.cz>
---
 .../media/sunxi/sun6i-isp/sun6i_isp_params.c  | 20 +++++++++++++++++++
 .../sunxi/sun6i-isp/uapi/sun6i-isp-config.h   | 10 ++++++++++
 2 files changed, 30 insertions(+)

diff --git a/drivers/staging/media/sunxi/sun6i-isp/sun6i_isp_params.c b/drivers/staging/media/sunxi/sun6i-isp/sun6i_isp_params.c
index 51821bb73ff8..f7f62bba5e50 100644
--- a/drivers/staging/media/sunxi/sun6i-isp/sun6i_isp_params.c
+++ b/drivers/staging/media/sunxi/sun6i-isp/sun6i_isp_params.c
@@ -132,6 +132,20 @@ sun6i_isp_params_configure_contrast(struct sun6i_isp_device *isp_dev,
 			     SUN6I_ISP_CONTRAST_CFG_MAX(contrast->max));
 }
 
+static void
+sun6i_isp_params_configure_saturation(struct sun6i_isp_device *isp_dev,
+				      const struct sun6i_isp_params_config *config)
+{
+	const struct sun6i_isp_params_config_saturation *saturation =
+		&config->saturation;
+
+	sun6i_isp_load_write(isp_dev, SUN6I_ISP_SATURATION_CFG_REG,
+			     SUN6I_ISP_SATURATION_CFG_R(saturation->saturation_r) |
+			     SUN6I_ISP_SATURATION_CFG_G(saturation->saturation_g) |
+			     SUN6I_ISP_SATURATION_CFG_B(saturation->saturation_b) |
+			     SUN6I_ISP_SATURATION_CFG_GAIN(saturation->gain));
+}
+
 static void
 sun6i_isp_params_configure_cnr(struct sun6i_isp_device *isp_dev,
 			       const struct sun6i_isp_params_config *config)
@@ -230,6 +244,9 @@ sun6i_isp_params_configure_modules(struct sun6i_isp_device *isp_dev,
 	if (modules & SUN6I_ISP_MODULE_CONTRAST)
 		sun6i_isp_params_configure_contrast(isp_dev, config);
 
+	if (modules & SUN6I_ISP_MODULE_SATURATION)
+		sun6i_isp_params_configure_saturation(isp_dev, config);
+
 	value = sun6i_isp_load_read(isp_dev, SUN6I_ISP_MODULE_EN_REG);
 	/* Clear all modules but keep input configuration. */
 	value &= SUN6I_ISP_MODULE_EN_SRC0 | SUN6I_ISP_MODULE_EN_SRC1;
@@ -246,6 +263,9 @@ sun6i_isp_params_configure_modules(struct sun6i_isp_device *isp_dev,
 	if (modules & SUN6I_ISP_MODULE_CONTRAST)
 		value |= SUN6I_ISP_MODULE_EN_CONTRAST;
 
+	if (modules & SUN6I_ISP_MODULE_SATURATION)
+		value |= SUN6I_ISP_MODULE_EN_SATU;
+
 	/* Bayer stage is always enabled. */
 
 	sun6i_isp_load_write(isp_dev, SUN6I_ISP_MODULE_EN_REG, value);
diff --git a/drivers/staging/media/sunxi/sun6i-isp/uapi/sun6i-isp-config.h b/drivers/staging/media/sunxi/sun6i-isp/uapi/sun6i-isp-config.h
index cded71bd3bbc..b42e53aeb570 100644
--- a/drivers/staging/media/sunxi/sun6i-isp/uapi/sun6i-isp-config.h
+++ b/drivers/staging/media/sunxi/sun6i-isp/uapi/sun6i-isp-config.h
@@ -15,6 +15,7 @@
 #define SUN6I_ISP_MODULE_YUV_GAIN_OFFSET	(1U << 2)
 #define SUN6I_ISP_MODULE_CNR			(1U << 3)
 #define SUN6I_ISP_MODULE_CONTRAST		(1U << 4)
+#define SUN6I_ISP_MODULE_SATURATION		(1U << 5)
 
 struct sun6i_isp_params_config_bayer {
 	__u16	offset_r;
@@ -60,6 +61,14 @@ struct sun6i_isp_params_config_contrast {
 	__u8	max;
 };
 
+struct sun6i_isp_params_config_saturation {
+	__u8	saturation_r;
+	__u8	saturation_g;
+	__u8	saturation_b;
+
+	__u16	gain;
+};
+
 struct sun6i_isp_params_config {
 	__u32					modules_used;
 
@@ -68,6 +77,7 @@ struct sun6i_isp_params_config {
 	struct sun6i_isp_params_config_yuv_gain_offset	yuv_gain_offset;
 	struct sun6i_isp_params_config_cnr	cnr;
 	struct sun6i_isp_params_config_contrast	contrast;
+	struct sun6i_isp_params_config_saturation	saturation;
 };
 
 #endif /* _UAPI_SUN6I_ISP_CONFIG_H */
-- 
2.43.0

