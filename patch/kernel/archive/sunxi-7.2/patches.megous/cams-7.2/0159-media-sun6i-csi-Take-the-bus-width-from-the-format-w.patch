@@ -134,6 +154,7 @@ static const struct sun6i_csi_bridge_format sun6i_csi_bridge_formats[] = {
 	{
 		.mbus_code		= MEDIA_BUS_FMT_UYVY8_1X16,
 		.bus_bpp		= 2,
+		.bus_width		= 16,
 		.input_format		= SUN6I_CSI_INPUT_FMT_YUV422,
