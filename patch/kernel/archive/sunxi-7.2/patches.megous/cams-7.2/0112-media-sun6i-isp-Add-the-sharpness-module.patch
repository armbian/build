From 8597c17bbe82ec9fa48859b38d63032748757e1d Mon Sep 17 00:00:00 2001
From: Ondrej Jirman <megi@xff.cz>
Date: Sun, 2 Aug 2026 15:27:41 +0200
Subject: [PATCH] media: sun6i-isp: Add the sharpness module

A sharpening level plus the range it is allowed to act over, packed as
a 12 bit level and two bytes in the upper half of the register. The
vendor's isp_sharp_config carries the same level, min and max triple.

The mode register's sharp bit is left alone. proc_configure() already
sets it, and it selects between the module's two modes rather than
gating it -- the module itself is gated by SAP in MODULE_EN, which is
what this adds.

Identical on the A83T and the V3s.

Signed-off-by: Ondrej Jirman <megi@xff.cz>
---
 .../media/sunxi/sun6i-isp/sun6i_isp_params.c  | 18 +++++++++++
 .../media/sunxi/sun6i-isp/sun6i_isp_reg.h     | 30 +++++++++++++++++++
 .../sunxi/sun6i-isp/uapi/sun6i-isp-config.h   |  9 ++++++
 3 files changed, 57 insertions(+)

diff --git a/drivers/staging/media/sunxi/sun6i-isp/sun6i_isp_params.c b/drivers/staging/media/sunxi/sun6i-isp/sun6i_isp_params.c
index f7f62bba5e50..5396256d41f7 100644
--- a/drivers/staging/media/sunxi/sun6i-isp/sun6i_isp_params.c
+++ b/drivers/staging/media/sunxi/sun6i-isp/sun6i_isp_params.c
@@ -146,6 +146,18 @@ sun6i_isp_params_configure_saturation(struct sun6i_isp_device *isp_dev,
 			     SUN6I_ISP_SATURATION_CFG_GAIN(saturation->gain));
 }
 
+static void
+sun6i_isp_params_configure_sharp(struct sun6i_isp_device *isp_dev,
+				 const struct sun6i_isp_params_config *config)
+{
+	const struct sun6i_isp_params_config_sharp *sharp = &config->sharp;
+
+	sun6i_isp_load_write(isp_dev, SUN6I_ISP_SAP_CFG_REG,
+			     SUN6I_ISP_SAP_CFG_LEVEL(sharp->level) |
+			     SUN6I_ISP_SAP_CFG_MIN(sharp->min) |
+			     SUN6I_ISP_SAP_CFG_MAX(sharp->max));
+}
+
 static void
 sun6i_isp_params_configure_cnr(struct sun6i_isp_device *isp_dev,
 			       const struct sun6i_isp_params_config *config)
@@ -247,6 +259,9 @@ sun6i_isp_params_configure_modules(struct sun6i_isp_device *isp_dev,
 	if (modules & SUN6I_ISP_MODULE_SATURATION)
 		sun6i_isp_params_configure_saturation(isp_dev, config);
 
+	if (modules & SUN6I_ISP_MODULE_SHARP)
+		sun6i_isp_params_configure_sharp(isp_dev, config);
+
 	value = sun6i_isp_load_read(isp_dev, SUN6I_ISP_MODULE_EN_REG);
 	/* Clear all modules but keep input configuration. */
 	value &= SUN6I_ISP_MODULE_EN_SRC0 | SUN6I_ISP_MODULE_EN_SRC1;
@@ -266,6 +281,9 @@ sun6i_isp_params_configure_modules(struct sun6i_isp_device *isp_dev,
 	if (modules & SUN6I_ISP_MODULE_SATURATION)
 		value |= SUN6I_ISP_MODULE_EN_SATU;
 
+	if (modules & SUN6I_ISP_MODULE_SHARP)
+		value |= SUN6I_ISP_MODULE_EN_SAP;
+
 	/* Bayer stage is always enabled. */
 
 	sun6i_isp_load_write(isp_dev, SUN6I_ISP_MODULE_EN_REG, value);
diff --git a/drivers/staging/media/sunxi/sun6i-isp/sun6i_isp_reg.h b/drivers/staging/media/sunxi/sun6i-isp/sun6i_isp_reg.h
index 2aee592a05f3..43e4bfe378a3 100644
--- a/drivers/staging/media/sunxi/sun6i-isp/sun6i_isp_reg.h
+++ b/drivers/staging/media/sunxi/sun6i-isp/sun6i_isp_reg.h
@@ -245,6 +245,36 @@
 #define SUN6I_ISP_WB_CFG_REG			0x148
 #define SUN6I_ISP_WB_CFG_CLIP(v)		((v) & GENMASK(11, 0))
 
+/* Sharpness */
+
+#define SUN6I_ISP_SAP_CFG_REG			0x160
+#define SUN6I_ISP_SAP_CFG_LEVEL(v)		((v) & GENMASK(11, 0))
+#define SUN6I_ISP_SAP_CFG_MIN(v)		(((v) << 16) & GENMASK(23, 16))
+#define SUN6I_ISP_SAP_CFG_MAX(v)		(((v) << 24) & GENMASK(31, 24))
+
+/* RGB2RGB */
+
+/*
+ * A 3x3 colour correction matrix followed by a per-channel offset. The
+ * twelve values are packed two to a register, except that the last
+ * matrix coefficient shares a register with the first offset.
+ */
+
+#define SUN6I_ISP_RGB2RGB_GAIN0_REG		0x188
+#define SUN6I_ISP_RGB2RGB_GAIN1_REG		0x18c
+#define SUN6I_ISP_RGB2RGB_GAIN2_REG		0x190
+#define SUN6I_ISP_RGB2RGB_GAIN3_REG		0x194
+#define SUN6I_ISP_RGB2RGB_GAIN_LOW(v)		((v) & GENMASK(11, 0))
+#define SUN6I_ISP_RGB2RGB_GAIN_HIGH(v)		(((v) << 16) & GENMASK(27, 16))
+
+#define SUN6I_ISP_RGB2RGB_GAIN4_REG		0x198
+#define SUN6I_ISP_RGB2RGB_GAIN4_MATRIX(v)	((v) & GENMASK(11, 0))
+#define SUN6I_ISP_RGB2RGB_GAIN4_OFFSET_R(v)	(((v) << 16) & GENMASK(28, 16))
+
+#define SUN6I_ISP_RGB2RGB_OFFSET_REG		0x19c
+#define SUN6I_ISP_RGB2RGB_OFFSET_G(v)		((v) & GENMASK(12, 0))
+#define SUN6I_ISP_RGB2RGB_OFFSET_B(v)		(((v) << 16) & GENMASK(28, 16))
+
 /* Contrast */
 
 #define SUN6I_ISP_CONTRAST_CFG_REG		0x164
diff --git a/drivers/staging/media/sunxi/sun6i-isp/uapi/sun6i-isp-config.h b/drivers/staging/media/sunxi/sun6i-isp/uapi/sun6i-isp-config.h
index b42e53aeb570..6f929ab2bc86 100644
--- a/drivers/staging/media/sunxi/sun6i-isp/uapi/sun6i-isp-config.h
+++ b/drivers/staging/media/sunxi/sun6i-isp/uapi/sun6i-isp-config.h
@@ -16,6 +16,7 @@
 #define SUN6I_ISP_MODULE_CNR			(1U << 3)
 #define SUN6I_ISP_MODULE_CONTRAST		(1U << 4)
 #define SUN6I_ISP_MODULE_SATURATION		(1U << 5)
+#define SUN6I_ISP_MODULE_SHARP			(1U << 6)
 
 struct sun6i_isp_params_config_bayer {
 	__u16	offset_r;
@@ -69,6 +70,13 @@ struct sun6i_isp_params_config_saturation {
 	__u16	gain;
 };
 
+struct sun6i_isp_params_config_sharp {
+	__u16	level;
+
+	__u8	min;
+	__u8	max;
+};
+
 struct sun6i_isp_params_config {
 	__u32					modules_used;
 
@@ -78,6 +86,7 @@ struct sun6i_isp_params_config {
 	struct sun6i_isp_params_config_cnr	cnr;
 	struct sun6i_isp_params_config_contrast	contrast;
 	struct sun6i_isp_params_config_saturation	saturation;
+	struct sun6i_isp_params_config_sharp	sharp;
 };
 
 #endif /* _UAPI_SUN6I_ISP_CONFIG_H */
-- 
2.43.0

