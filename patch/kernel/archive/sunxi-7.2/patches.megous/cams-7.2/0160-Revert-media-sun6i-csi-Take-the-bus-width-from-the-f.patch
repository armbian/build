 	{
 		.mbus_code		= MEDIA_BUS_FMT_VYUY8_1X16,
 		.bus_bpp		= 2,
-		.bus_width		= 16,
 		.input_format		= SUN6I_CSI_INPUT_FMT_YUV422,
 		.input_yuv_seq		= SUN6I_CSI_INPUT_YUV_SEQ_VYUY,
 		.input_yuv_seq_invert	= SUN6I_CSI_INPUT_YUV_SEQ_UYVY,
@@ -303,32 +279,11 @@ sun6i_csi_bridge_configure_parallel(struct sun6i_csi_device *csi_dev,
 	struct v4l2_fwnode_endpoint *endpoint = &source->endpoint;
 	unsigned char bus_width = endpoint->bus.parallel.bus_width;
 	unsigned int flags = endpoint->bus.parallel.flags;
-	const struct sun6i_csi_bridge_format *format;
 	const struct v4l2_mbus_framefmt *sink_format;
-	unsigned char data_width;
 	u32 value = SUN6I_CSI_IF_CFG_IF_CSI;
 
 	sink_format = v4l2_subdev_state_get_format(state, SUN6I_CSI_BRIDGE_PAD_SINK);
 
-	/*
-	 * A pattern has no device tree node, so there is no endpoint to take
-	 * a bus width from and it comes out as zero -- which falls through to
-	 * the default below and leaves the interface at eight bits whatever
-	 * format is configured. Fall back to what the format says the bus
-	 * carries, which is the only source of the answer when the source is
-	 * not a real one.
-	 *
-	 * Only the data width is taken this way. The combined-YUV decisions
-	 * below still key off the endpoint, so a source that does have a node
-	 * behaves exactly as it did.
-	 */
-	data_width = bus_width;
-	if (!data_width) {
-		format = sun6i_csi_bridge_format_find(sink_format->code);
-		if (format)
-			data_width = format->bus_width;
-	}
-
 	if (sink_format->field == V4L2_FIELD_INTERLACED ||
 	    sink_format->field == V4L2_FIELD_INTERLACED_TB ||
 	    sink_format->field == V4L2_FIELD_INTERLACED_BT)
@@ -386,7 +341,7 @@ sun6i_csi_bridge_configure_parallel(struct sun6i_csi_device *csi_dev,
 		break;
 	}
 
-	switch (data_width) {
+	switch (bus_width) {
 	case 8:
 	/* 16-bit YUV formats use a doubled width in 8-bit mode. */
 	case 16:
@@ -399,7 +354,7 @@ sun6i_csi_bridge_configure_parallel(struct sun6i_csi_device *csi_dev,
 		value |= SUN6I_CSI_IF_CFG_DATA_WIDTH_12;
 		break;
 	default:
-		dev_warn(dev, "unsupported bus width: %u\n", data_width);
+		dev_warn(dev, "unsupported bus width: %u\n", bus_width);
 		break;
 	}
 
