@@ -27,12 +27,6 @@ struct sun6i_csi_bridge_format {
 	u8	input_yuv_seq_invert;
 	/* Bytes the bus carries per pixel, which a pattern has to supply. */
 	u8	bus_bpp;
-	/*
-	 * Bits the bus carries per sample. Only needed when there is no
-	 * endpoint to ask -- a pattern has no device tree node, so its bus
-	 * width has to come from the format instead.
-	 */
-	u8	bus_width;
 };
 
