From 05963ce8b61a7aacab7073114e405e2b6af75660 Mon Sep 17 00:00:00 2001
From: Ondrej Jirman <megi@xff.cz>
Date: Wed, 29 Jul 2026 17:25:03 +0200
Subject: [PATCH] media: gc2145: Enable the edge enhancement block

The block enables were written as a bare 0x0b - lens shading, defect
correction and interpolation - leaving edge enhancement off. Three
things depend on it and none of them worked on hardware: the sharpness
control writes its strength into a stopped block, and the emboss and
sketch effects are nothing but the two edge map bits, so emboss came out
looking like the plain greyscale its fixed chroma makes of the image and
sketch did nothing at all.

Name the bits while turning it on. Denoising stays off, so edge
enhancement will bring some sensor noise up with the detail; the
sharpness default is mild enough that the answer to that is a lower
default rather than a stopped block.

Signed-off-by: Ondrej Jirman <megi@xff.cz>
---
 drivers/media/i2c/gc2145.c | 27 +++++++++++++++++++++++----
 1 file changed, 23 insertions(+), 4 deletions(-)

diff --git a/drivers/media/i2c/gc2145.c b/drivers/media/i2c/gc2145.c
index 94dd72a33b8e..261fceafa7f2 100644
--- a/drivers/media/i2c/gc2145.c
+++ b/drivers/media/i2c/gc2145.c
@@ -155,6 +155,13 @@
 #define GC2145_P0_END_TIME		0x14
 
 #define GC2145_P0_ISP_BLK_ENABLE1	0x80
+#define GC2145_ISP_BLK_ENABLE1_LSC		BIT(0)
+#define GC2145_ISP_BLK_ENABLE1_DD		BIT(1)
+#define GC2145_ISP_BLK_ENABLE1_DN		BIT(2)
+#define GC2145_ISP_BLK_ENABLE1_INTERPOLATION	BIT(3)
+#define GC2145_ISP_BLK_ENABLE1_EE		BIT(4)
+#define GC2145_ISP_BLK_ENABLE1_CC		BIT(5)
+#define GC2145_ISP_BLK_ENABLE1_GAMMA		BIT(6)
 #define GC2145_P0_ISP_BLK_ENABLE2	0x81
 #define GC2145_P0_ISP_BLK_ENABLE3	0x82
 #define GC2145_ISP_BLK_ENABLE3_AWB		BIT(1)
@@ -2210,10 +2217,13 @@ static int gc2145_setup_mode(struct gc2145_dev *sensor,
 	gc2145_tx_write8(sensor, GC2145_P0_ISP_OUT_FORMAT, pix_fmt->fmt_setup);
 
 	// set gamma curve
-	gc2145_tx_update_bits(sensor, 0x80, BIT(6), BIT(6));
+	gc2145_tx_update_bits(sensor, GC2145_P0_ISP_BLK_ENABLE1,
+			      GC2145_ISP_BLK_ENABLE1_GAMMA,
+			      GC2145_ISP_BLK_ENABLE1_GAMMA);
 
 	// disable denoising
-	gc2145_tx_update_bits(sensor, 0x80, BIT(2), 0);
+	gc2145_tx_update_bits(sensor, GC2145_P0_ISP_BLK_ENABLE1,
+			      GC2145_ISP_BLK_ENABLE1_DN, 0);
 
 	/* drive strength, for the byte clock leaving the parallel port */
 	gc2145_tx_write8(sensor, 0x24, pclk2 > 40000000 ? 0xff : 0x55);
@@ -2665,8 +2675,17 @@ static int gc2145_configure(struct gc2145_dev *sensor)
 	gc2145_tx_write8(sensor, 0x19, 0x0c); // set AD pipe number
 	gc2145_tx_write8(sensor, 0x20, 0x01); // AD clk mode
 
-	// enable defect correction, etc.
-	gc2145_tx_write8(sensor, 0x80, 0x0b);
+	/*
+	 * Edge enhancement is what the sharpness control drives and what
+	 * the emboss and sketch effects are made of: both of those are
+	 * nothing but the edge map bits, so with the block off they look
+	 * like a plain greyscale and like nothing at all.
+	 */
+	gc2145_tx_write8(sensor, GC2145_P0_ISP_BLK_ENABLE1,
+			 GC2145_ISP_BLK_ENABLE1_LSC |
+			 GC2145_ISP_BLK_ENABLE1_DD |
+			 GC2145_ISP_BLK_ENABLE1_INTERPOLATION |
+			 GC2145_ISP_BLK_ENABLE1_EE);
 
 	gc2145_tx_write8(sensor, GC2145_P0_SYNC_MODE, sync_mode);
 
-- 
