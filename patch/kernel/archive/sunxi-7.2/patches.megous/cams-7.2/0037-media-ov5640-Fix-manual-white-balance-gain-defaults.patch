From f57c76eea42c5ce39542181c9fd07b396c96a29c Mon Sep 17 00:00:00 2001
From: Ondrej Jirman <megi@xff.cz>
Date: Wed, 29 Jul 2026 02:25:10 +0200
Subject: [PATCH] media: ov5640: Fix manual white balance gain defaults

The red and blue balance controls defaulted to 0, which is zero gain,
not unity. Turning off auto white balance without setting both
controls first zeroed the red and blue channels. Per the datasheet the
gains are in 1/1024 steps, so default to 0x400.

The green gain has no control and was never written, leaving whatever
the AWB algorithm had converged to before it was switched off. Reset
it to unity together with the other two.

Signed-off-by: Ondrej Jirman <megi@xff.cz>
---
 drivers/media/i2c/ov5640.c | 16 ++++++++++++++--
 1 file changed, 14 insertions(+), 2 deletions(-)

diff --git a/drivers/media/i2c/ov5640.c b/drivers/media/i2c/ov5640.c
index 2780631732cc..ce3a62381966 100644
--- a/drivers/media/i2c/ov5640.c
+++ b/drivers/media/i2c/ov5640.c
@@ -68,6 +68,8 @@
 #define OV5640_REG_AWB_G_GAIN		0x3402
 #define OV5640_REG_AWB_B_GAIN		0x3404
 #define OV5640_REG_AWB_MANUAL_CTRL	0x3406
+/* AWB gains are in 1/1024 steps, 0x400 is unity gain */
+#define OV5640_AWB_GAIN_UNITY		0x400
 #define OV5640_REG_AEC_PK_EXPOSURE_HI	0x3500
 #define OV5640_REG_AEC_PK_EXPOSURE_MED	0x3501
 #define OV5640_REG_AEC_PK_EXPOSURE_LO	0x3502
@@ -3420,6 +3422,14 @@ static int ov5640_set_ctrl_white_balance(struct ov5640_dev *sensor, int awb)
 		u16 blue = (u16)sensor->ctrls.blue_balance->val;
 
 		ret = ov5640_write_reg16(sensor, OV5640_REG_AWB_R_GAIN, red);
+		if (ret)
+			return ret;
+		/*
+		 * There is no control for the green channel, but the AWB
+		 * algorithm may have left it at something other than unity.
+		 */
+		ret = ov5640_write_reg16(sensor, OV5640_REG_AWB_G_GAIN,
+					 OV5640_AWB_GAIN_UNITY);
 		if (ret)
 			return ret;
 		ret = ov5640_write_reg16(sensor, OV5640_REG_AWB_B_GAIN, blue);
@@ -3801,9 +3811,11 @@ static int ov5640_init_controls(struct ov5640_dev *sensor)
 					   V4L2_CID_AUTO_WHITE_BALANCE,
 					   0, 1, 1, 1);
 	ctrls->blue_balance = v4l2_ctrl_new_std(hdl, ops, V4L2_CID_BLUE_BALANCE,
-						0, 4095, 1, 0);
+						0, 4095, 1,
+						OV5640_AWB_GAIN_UNITY);
 	ctrls->red_balance = v4l2_ctrl_new_std(hdl, ops, V4L2_CID_RED_BALANCE,
-					       0, 4095, 1, 0);
+					       0, 4095, 1,
+					       OV5640_AWB_GAIN_UNITY);
 	/* Auto/manual exposure */
 	ctrls->auto_exp = v4l2_ctrl_new_std_menu(hdl, ops,
 						 V4L2_CID_EXPOSURE_AUTO,
-- 
2.43.0

