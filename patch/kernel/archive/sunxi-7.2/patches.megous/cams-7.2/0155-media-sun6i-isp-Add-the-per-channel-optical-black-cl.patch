From 4ae01c807a64c43fded2ccf4a4143b38f0b02fbf Mon Sep 17 00:00:00 2001
From: Ondrej Jirman <megi@xff.cz>
Date: Thu, 6 Aug 2026 18:23:21 +0200
Subject: [PATCH] media: sun6i-isp: Add the per-channel optical black clamps

The vendor's register map has four more OB registers than this driver
knew about, one black level per mosaic channel at 0xa0 to 0xac. They are
what an optical black clamp would actually subtract, and nothing here
named them, so the block was measured without them and came out looking
like it had no correction at all.

The vendor does not write them either -- it maps all four and writes
none, on every one of its six variants, and its only OB setter handles
the frame size, the valid window and the valid start. So this is not a
case of copying what the vendor does; it is adding the registers so the
question can be asked properly.

Signed-off-by: Ondrej Jirman <megi@xff.cz>
---
 drivers/staging/media/sunxi/sun6i-isp/sun6i_isp_params.c | 9 +++++++++
 drivers/staging/media/sunxi/sun6i-isp/sun6i_isp_reg.h    | 9 +++++++++
 .../media/sunxi/sun6i-isp/uapi/sun6i-isp-config.h        | 6 ++++++
 3 files changed, 24 insertions(+)

diff --git a/drivers/staging/media/sunxi/sun6i-isp/sun6i_isp_params.c b/drivers/staging/media/sunxi/sun6i-isp/sun6i_isp_params.c
index 7e429ca06e19..1b74b20f6376 100644
--- a/drivers/staging/media/sunxi/sun6i-isp/sun6i_isp_params.c
+++ b/drivers/staging/media/sunxi/sun6i-isp/sun6i_isp_params.c
@@ -512,6 +512,15 @@ sun6i_isp_params_configure_obc(struct sun6i_isp_device *isp_dev,
 	sun6i_isp_load_write(isp_dev, SUN6I_ISP_OB_VERT_PARA_REG, obc->vert_para);
 	sun6i_isp_load_write(isp_dev, SUN6I_ISP_OB_OFFSET_FIXED_REG,
 			     obc->offset_fixed);
+
+	sun6i_isp_load_write(isp_dev, SUN6I_ISP_SRC0_OB_CLAMP_R_REG,
+			     obc->clamp_r);
+	sun6i_isp_load_write(isp_dev, SUN6I_ISP_SRC0_OB_CLAMP_GR_REG,
+			     obc->clamp_gr);
+	sun6i_isp_load_write(isp_dev, SUN6I_ISP_SRC0_OB_CLAMP_GB_REG,
+			     obc->clamp_gb);
+	sun6i_isp_load_write(isp_dev, SUN6I_ISP_SRC0_OB_CLAMP_B_REG,
+			     obc->clamp_b);
 }
 
 static void
diff --git a/drivers/staging/media/sunxi/sun6i-isp/sun6i_isp_reg.h b/drivers/staging/media/sunxi/sun6i-isp/sun6i_isp_reg.h
index bbd6bad4dc92..03b6399a739c 100644
--- a/drivers/staging/media/sunxi/sun6i-isp/sun6i_isp_reg.h
+++ b/drivers/staging/media/sunxi/sun6i-isp/sun6i_isp_reg.h
@@ -241,6 +241,15 @@
 #define SUN6I_ISP_OB_VERT_PARA_REG		0x98
 #define SUN6I_ISP_OB_OFFSET_FIXED_REG		0x9c
 
+/*
+ * Per-channel black level. Named from the vendor's register map, which
+ * maps all four and writes none of them, on any of its six variants.
+ */
+#define SUN6I_ISP_SRC0_OB_CLAMP_R_REG		0xa0
+#define SUN6I_ISP_SRC0_OB_CLAMP_GR_REG		0xa4
+#define SUN6I_ISP_SRC0_OB_CLAMP_GB_REG		0xa8
+#define SUN6I_ISP_SRC0_OB_CLAMP_B_REG		0xac
+
 /* Defect pixel correction */
 
 /*
diff --git a/drivers/staging/media/sunxi/sun6i-isp/uapi/sun6i-isp-config.h b/drivers/staging/media/sunxi/sun6i-isp/uapi/sun6i-isp-config.h
index 2414e26a7b6b..3ec150073260 100644
--- a/drivers/staging/media/sunxi/sun6i-isp/uapi/sun6i-isp-config.h
+++ b/drivers/staging/media/sunxi/sun6i-isp/uapi/sun6i-isp-config.h
@@ -66,6 +66,12 @@ struct sun6i_isp_params_config_obc {
 	__u32	horz_pos;
 	__u32	vert_para;
 	__u32	offset_fixed;
+
+	/* Per-channel black level, in the mosaic's own order. */
+	__u32	clamp_r;
+	__u32	clamp_gr;
+	__u32	clamp_gb;
+	__u32	clamp_b;
 };
 
 struct sun6i_isp_params_config_bdnf {
-- 
2.43.0

