From f7042c9543b8cf8a751a29f71c599672a5cdb135 Mon Sep 17 00:00:00 2001
From: Ondrej Jirman <megi@xff.cz>
Date: Thu, 6 Aug 2026 13:29:15 +0200
Subject: [PATCH] media: sun6i-csi: Do not validate the source format against a
 pattern

A pattern feeds the input from memory, so the source is no part of the
pipeline: it is never started and nothing it puts on the bus is used.
Holding the bridge's sink format to it therefore limits the pipeline to
the sizes and codes whichever sensor happens to be linked can offer,
which is the limitation that feeding from memory exists to remove. On
this board that is three sizes and one code.

Skip the check while a pattern is supplying the input.

Signed-off-by: Ondrej Jirman <megi@xff.cz>
---
 .../sunxi/sun6i-csi/sun6i_csi_bridge.c        | 22 ++++++++++++++++++-
 1 file changed, 21 insertions(+), 1 deletion(-)

diff --git a/drivers/media/platform/sunxi/sun6i-csi/sun6i_csi_bridge.c b/drivers/media/platform/sunxi/sun6i-csi/sun6i_csi_bridge.c
index 3604505fff3e..250273f17cba 100644
--- a/drivers/media/platform/sunxi/sun6i-csi/sun6i_csi_bridge.c
+++ b/drivers/media/platform/sunxi/sun6i-csi/sun6i_csi_bridge.c
@@ -660,8 +660,28 @@ static const struct v4l2_subdev_internal_ops sun6i_csi_bridge_internal_ops = {
 
 /* Media Entity */
 
+/*
+ * A pattern feeds the input from memory, which makes the source no part of the
+ * pipeline: it is never started, and nothing it would put on the bus is used.
+ * Its format therefore says nothing about what will arrive, and holding the
+ * sink to it only limits the pipeline to the sizes and codes whichever sensor
+ * happens to be linked can offer -- which is exactly the limitation feeding
+ * from memory exists to remove.
+ */
+static int sun6i_csi_bridge_link_validate(struct media_link *link)
+{
+	struct v4l2_subdev *subdev =
+		media_entity_to_v4l2_subdev(link->sink->entity);
+	struct sun6i_csi_device *csi_dev = v4l2_get_subdevdata(subdev);
+
+	if (sun6i_csi_pattern_replaces_source(csi_dev))
+		return 0;
+
+	return v4l2_subdev_link_validate(link);
+}
+
 static const struct media_entity_operations sun6i_csi_bridge_entity_ops = {
-	.link_validate	= v4l2_subdev_link_validate,
+	.link_validate	= sun6i_csi_bridge_link_validate,
 };
 
 /* V4L2 Async */
