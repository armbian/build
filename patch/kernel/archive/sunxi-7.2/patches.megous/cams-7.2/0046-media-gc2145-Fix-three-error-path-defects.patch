From cf645267093162a2140c46c1f355e3955d09a3bf Mon Sep 17 00:00:00 2001
From: Ondrej Jirman <megi@xff.cz>
Date: Wed, 29 Jul 2026 02:55:24 +0200
Subject: [PATCH] media: gc2145: Fix three error path defects

Probe printed an error when the enable or reset pin was missing and
then returned the still-zero ret, so it succeeded with an unusable
sensor. Return -EINVAL.

A clk_set_rate() failure jumped to the label that calls
clk_disable_unprepare() on a clock that had not been enabled yet.

The zero length firmware path returned without releasing the firmware.

Signed-off-by: Ondrej Jirman <megi@xff.cz>
---
 drivers/media/i2c/gc2145.c | 8 +++++---
 1 file changed, 5 insertions(+), 3 deletions(-)

diff --git a/drivers/media/i2c/gc2145.c b/drivers/media/i2c/gc2145.c
index d80e457f275b..420c23cb47b3 100644
--- a/drivers/media/i2c/gc2145.c
+++ b/drivers/media/i2c/gc2145.c
@@ -597,8 +597,10 @@ static int gc2145_load_firmware(struct gc2145_dev *sensor, const char *name)
 		return 1;
 	}
 
-	if (fw->size == 0)
+	if (fw->size == 0) {
+		release_firmware(fw);
 		return 1;
+	}
 
 	ret = gc2145_set_registers(sensor, fw->data, fw->size);
 
@@ -2106,7 +2108,7 @@ static int gc2145_set_power(struct gc2145_dev *sensor, bool on)
 
 		ret = clk_set_rate(sensor->xclk, 24000000);
 		if (ret)
-			goto xclk_off;
+			goto power_off;
 
 		ret = clk_prepare_enable(sensor->xclk);
 		if (ret)
@@ -2313,7 +2315,7 @@ static int gc2145_probe(struct i2c_client *client)
 
 	if (!sensor->enable_gpio || !sensor->reset_gpio) {
 		dev_err(dev, "enable and reset pins must be configured\n");
-		return ret;
+		return -EINVAL;
 	}
 
 	v4l2_i2c_subdev_init(&sensor->sd, client, &gc2145_subdev_ops);
-- 
2.43.0

