+/*
+ * How many bytes one frame occupies on the bus, which is the length a pattern
+ * has to have in DRAM to stand in for one.
+ */
+int sun6i_csi_bridge_frame_bytes(struct sun6i_csi_device *csi_dev, u32 *bytes)
+{
+	struct v4l2_subdev *subdev = &csi_dev->bridge.subdev;
+	const struct sun6i_csi_bridge_format *format;
+	const struct v4l2_mbus_framefmt *mbus_format;
+	struct v4l2_subdev_state *state;
+	int ret = 0;
+
+	state = v4l2_subdev_lock_and_get_active_state(subdev);
+
+	mbus_format = v4l2_subdev_state_get_format(state,
+						   SUN6I_CSI_BRIDGE_PAD_SINK);
+
+	format = sun6i_csi_bridge_format_find(mbus_format->code);
+	if (format)
+		*bytes = mbus_format->width * mbus_format->height *
+			 format->bus_bpp;
+	else
+		ret = -EINVAL;
+
+	v4l2_subdev_unlock_state(state);
+
+	return ret;
+}
