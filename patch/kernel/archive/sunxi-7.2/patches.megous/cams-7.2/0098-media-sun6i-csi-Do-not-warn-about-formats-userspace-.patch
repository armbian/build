From afda478741f8e4f09cca503574b865651bd19e57 Mon Sep 17 00:00:00 2001
From: Ondrej Jirman <megi@xff.cz>
Date: Sun, 2 Aug 2026 19:09:35 +0200
Subject: [PATCH] media: sun6i-csi: Do not warn about formats userspace chose

Link validation runs when userspace starts streaming, and both format
lookups can fail simply because the pipeline was set up with a format
combination the driver does not support - which is a user error, not
a driver bug, so a kernel backtrace is the wrong answer. Report which
format was rejected instead.

Signed-off-by: Ondrej Jirman <megi@xff.cz>
---
 .../media/platform/sunxi/sun6i-csi/sun6i_csi_capture.c | 10 ++++++++--
 1 file changed, 8 insertions(+), 2 deletions(-)

diff --git a/drivers/media/platform/sunxi/sun6i-csi/sun6i_csi_capture.c b/drivers/media/platform/sunxi/sun6i-csi/sun6i_csi_capture.c
index d93e5cae6acb..4db74b9356fe 100644
--- a/drivers/media/platform/sunxi/sun6i-csi/sun6i_csi_capture.c
+++ b/drivers/media/platform/sunxi/sun6i-csi/sun6i_csi_capture.c
@@ -949,8 +949,11 @@ static int sun6i_csi_capture_link_validate(struct media_link *link)
 
 	sun6i_csi_capture_format(csi_dev, &pixelformat, &capture_field);
 	capture_format = sun6i_csi_capture_format_find(pixelformat);
-	if (WARN_ON(!capture_format))
+	if (!capture_format) {
+		v4l2_err(v4l2_dev, "unsupported capture format %p4cc\n",
+			 &pixelformat);
 		return -EINVAL;
+	}
 
 	ret = v4l2_subdev_call_state_active(&csi_dev->bridge.subdev, pad,
 					    get_fmt, &fmt);
@@ -958,8 +961,11 @@ static int sun6i_csi_capture_link_validate(struct media_link *link)
 		return ret;
 
 	bridge_format = sun6i_csi_bridge_format_find(fmt.format.code);
-	if (WARN_ON(!bridge_format))
+	if (!bridge_format) {
+		v4l2_err(v4l2_dev, "unsupported bridge format 0x%04x\n",
+			 fmt.format.code);
 		return -EINVAL;
+	}
 
 	/* No cropping/scaling is supported. */
 	if (capture_width != fmt.format.width ||
-- 
2.43.0

