From 8ae59755aa5c5ce0f48cf559e8bb567c7d2c6277 Mon Sep 17 00:00:00 2001
From: Ondrej Jirman <megi@xff.cz>
Date: Sun, 2 Aug 2026 17:42:34 +0200
Subject: [PATCH] media: hm5065: Let the shared supplies settle before the
 clock

The supplies are shared with the other camera on the board, so this
sensor may be the one bringing them up from cold. It is held in reset
throughout, but the clock was started the instant the regulators were
enabled - wait for them like the gc2145 now does.

Signed-off-by: Ondrej Jirman <megi@xff.cz>
---
 drivers/media/i2c/hm5065.c | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/drivers/media/i2c/hm5065.c b/drivers/media/i2c/hm5065.c
index df59af7d24df..9a8e8c53dd9a 100644
--- a/drivers/media/i2c/hm5065.c
+++ b/drivers/media/i2c/hm5065.c
@@ -2100,10 +2100,14 @@ static int hm5065_power_on(struct device *dev)
 	struct hm5065_dev *sensor = to_hm5065_dev(sd);
 	int ret;
 
+	/* the chip is held in reset already, see the pin request */
 	ret = regulator_bulk_enable(HM5065_NUM_SUPPLIES, sensor->supplies);
 	if (ret)
 		return ret;
 
+	/* the supplies are shared with the other camera, let them settle */
+	usleep_range(10000, 12000);
+
 	/* pick the rate before the clock starts, not while it runs */
 	ret = clk_set_rate(sensor->xclk, 24000000);
 	if (ret)
-- 
2.43.0

