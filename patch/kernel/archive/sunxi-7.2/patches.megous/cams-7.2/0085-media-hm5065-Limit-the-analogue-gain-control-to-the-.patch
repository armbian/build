From 3919598a55d956e8551c3e375b0791eef5734177 Mon Sep 17 00:00:00 2001
From: Ondrej Jirman <megi@xff.cz>
Date: Sun, 2 Aug 2026 15:01:45 +0200
Subject: [PATCH] media: hm5065: Limit the analogue gain control to the
 documented range

The coded analog gain tops out at 0xf0 = 24.1 dB per the datasheet
gain table, and the exposure algorithm's own ceiling defaults to the
same value; codes above that are undefined. The coding is also
non-linear, not the 0.1 dB steps the old test scripts assumed - note
that at the control.

Signed-off-by: Ondrej Jirman <megi@xff.cz>
---
 drivers/media/i2c/hm5065.c | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/drivers/media/i2c/hm5065.c b/drivers/media/i2c/hm5065.c
index 96f9e6a61dec..f35fa7192a8e 100644
--- a/drivers/media/i2c/hm5065.c
+++ b/drivers/media/i2c/hm5065.c
@@ -1228,8 +1228,12 @@ static int hm5065_init_controls(struct hm5065_dev *sensor)
 					  V4L2_CID_DIGITAL_GAIN,
 					  1000, 4000, 1, 1000);
 
+	/*
+	 * The gain coding is non-linear: each 0x10 step adds 0.56-2.5 dB
+	 * up to 0xe0, continuing in steps of 4 up to 0xf0 = 24.1 dB (x16).
+	 */
 	ctrls->a_gain = v4l2_ctrl_new_std(hdl, ops, V4L2_CID_ANALOGUE_GAIN,
-					  0, 0xf4, 1, 0);
+					  0, 0xf0, 1, 0);
 
 	ctrls->metering =
 		v4l2_ctrl_new_std_menu(hdl, ops, V4L2_CID_EXPOSURE_METERING,
-- 
2.43.0

