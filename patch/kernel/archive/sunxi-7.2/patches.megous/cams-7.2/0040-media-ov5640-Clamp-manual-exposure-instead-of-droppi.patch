From 0ff1817906091d2dbde49dac62d48023a8a935c8 Mon Sep 17 00:00:00 2001
From: Ondrej Jirman <megi@xff.cz>
Date: Wed, 29 Jul 2026 02:27:50 +0200
Subject: [PATCH] media: ov5640: Clamp manual exposure instead of dropping it

An exposure at or above the frame length was not written to the sensor
at all, while the control kept reporting the value userspace asked
for. Clamp it to the largest usable exposure so that the control stays
monotonic all the way to the end of its range.

Signed-off-by: Ondrej Jirman <megi@xff.cz>
---
 drivers/media/i2c/ov5640.c | 19 +++++++++++++------
 1 file changed, 13 insertions(+), 6 deletions(-)

diff --git a/drivers/media/i2c/ov5640.c b/drivers/media/i2c/ov5640.c
index b4d9a8cbf7db..bf745a05e67a 100644
--- a/drivers/media/i2c/ov5640.c
+++ b/drivers/media/i2c/ov5640.c
@@ -3478,20 +3478,27 @@ static int ov5640_set_ctrl_exposure(struct ov5640_dev *sensor,
 	}
 
 	if (!auto_exp && ctrls->exposure->is_new) {
-		u16 max_exp;
+		u16 extra_exp;
+		u32 max_exp;
 
+		/*
+		 * The exposure has to stay below the frame length, extra
+		 * lines included. Clamp to that instead of dropping the
+		 * write, so that the control does not silently stop having
+		 * an effect at the top of its range.
+		 */
 		ret = ov5640_read_reg16(sensor, OV5640_REG_AEC_PK_VTS,
-					&max_exp);
+					&extra_exp);
 		if (ret)
 			return ret;
 		ret = ov5640_get_vts(sensor);
 		if (ret < 0)
 			return ret;
-		max_exp += ret;
-		ret = 0;
 
-		if (ctrls->exposure->val < max_exp)
-			ret = ov5640_set_exposure(sensor, ctrls->exposure->val);
+		max_exp = extra_exp + ret;
+		ret = ov5640_set_exposure(sensor,
+					  min_t(u32, ctrls->exposure->val,
+						max_exp - 1));
 	}
 
 	return ret;
-- 
