From: Ondrej Jirman <megi@xff.cz>
Date: Sun, 2 Aug 2026 14:46:35 +0200
Subject: media: sun6i-isp: Add support for the A83T ISP

The A83T ISP is the same block as the V3s one, minus the disc module the
V3s added. The register layout is identical: every register offset this
driver uses is at the same place on both, and so is every bit field it
programs (frontend source mode, input format and YUV sequence, optical
black, bayer gain/offset, BDNF).

Only the table sizes differ. The A83T has a smaller LUT/lens/gamma table
and a smaller DRC table, matching the fact that it has no disc table to
hold:

                   A83T     V3s
  load/save       0x1000  0x1000
  lut             0x0800  0x0e00
  drc             0x0200  0x0600
  stats           0x2100  0x2100

Add the variant and the compatible.

Signed-off-by: Ondrej Jirman <megi@xff.cz>
---
 drivers/staging/media/sunxi/sun6i-isp/sun6i_isp.c | 11 ++++++++++
 1 file changed, 11 insertions(+)

diff --git a/drivers/staging/media/sunxi/sun6i-isp/sun6i_isp.c b/drivers/staging/media/sunxi/sun6i-isp/sun6i_isp.c
index 111111111111..222222222222 100644
--- a/drivers/staging/media/sunxi/sun6i-isp/sun6i_isp.c
+++ b/drivers/staging/media/sunxi/sun6i-isp/sun6i_isp.c
@@ -517,6 +517,13 @@ static void sun6i_isp_remove(struct platform_device *platform_dev)
  * - sun8i-v3s-isp: based on sun8i-a83t-isp with a new disc module;
  */
 
+static const struct sun6i_isp_variant sun8i_a83t_isp_variant = {
+	.table_load_save_size	= 0x1000,
+	.table_lut_size		= 0x800,
+	.table_drc_size		= 0x200,
+	.table_stats_size	= 0x2100,
+};
+
 static const struct sun6i_isp_variant sun8i_v3s_isp_variant = {
 	.table_load_save_size	= 0x1000,
 	.table_lut_size		= 0xe00,
@@ -525,6 +532,10 @@ static const struct sun6i_isp_variant sun8i_v3s_isp_variant = {
 };
 
 static const struct of_device_id sun6i_isp_of_match[] = {
+	{
+		.compatible	= "allwinner,sun8i-a83t-isp",
+		.data		= &sun8i_a83t_isp_variant,
+	},
 	{
 		.compatible	= "allwinner,sun8i-v3s-isp",
 		.data		= &sun8i_v3s_isp_variant,
