From c01028981a1c242791e129b2d04d6914c7f60092 Mon Sep 17 00:00:00 2001
From: Ondrej Jirman <megi@xff.cz>
Date: Sun, 2 Aug 2026 15:02:14 +0200
Subject: [PATCH] media: hm5065: Report full range quantization

The output pipe is JFIF based - YCbCr spans the full [1:254] range
with Rec. 601 encoding - but the format reported defaults, which for
the sRGB colorspace let consumers assume limited range.

Signed-off-by: Ondrej Jirman <megi@xff.cz>
---
 drivers/media/i2c/hm5065.c | 10 +++++++---
 1 file changed, 7 insertions(+), 3 deletions(-)

diff --git a/drivers/media/i2c/hm5065.c b/drivers/media/i2c/hm5065.c
index f35fa7192a8e..1f10d90fb098 100644
--- a/drivers/media/i2c/hm5065.c
+++ b/drivers/media/i2c/hm5065.c
@@ -444,7 +444,11 @@ struct hm5065_pixfmt {
 	u8 fmt_setup;
 };
 
-//XXX: identify colrorspace correctly, see datasheet page 40
+/*
+ * The output pipe is JFIF based - the custom-order YCbCr formats span
+ * the full [1:254] range with Rec. 601 encoding, and the RGB formats
+ * are full range too.
+ */
 static const struct hm5065_pixfmt hm5065_formats[] = {
 	{
 		.code              = MEDIA_BUS_FMT_UYVY8_2X8,
@@ -1640,8 +1644,8 @@ static int hm5065_set_fmt(struct v4l2_subdev *sd,
 	mf->code = pixfmt->code;
 	mf->colorspace = pixfmt->colorspace;
 	mf->xfer_func = V4L2_XFER_FUNC_DEFAULT;
-	mf->ycbcr_enc = V4L2_YCBCR_ENC_DEFAULT;
-	mf->quantization = V4L2_QUANTIZATION_DEFAULT;
+	mf->ycbcr_enc = V4L2_YCBCR_ENC_601;
+	mf->quantization = V4L2_QUANTIZATION_FULL_RANGE;
 	mf->field = V4L2_FIELD_NONE;
 
 	mf->width = clamp(mf->width, HM5065_CAPTURE_WIDTH_MIN,
-- 
2.43.0

