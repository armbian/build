From ab53444972e0e700f8721bec32b17d676b40cb00 Mon Sep 17 00:00:00 2001
From: Ondrej Jirman <megi@xff.cz>
Date: Sun, 2 Aug 2026 15:12:50 +0200
Subject: [PATCH] media: sun6i-isp: Add the contrast module

A contrast level plus the input range it works over. The register packs
the level into the low nibble and the two range endpoints into the next
two bytes, matching the vendor's isp_private_contrast_config, which
carries a level and a min/max pair of the same widths.

Identical on the A83T and the V3s.

Signed-off-by: Ondrej Jirman <megi@xff.cz>
---
 .../media/sunxi/sun6i-isp/sun6i_isp_params.c  | 19 +++++++++++++++++++
 .../media/sunxi/sun6i-isp/sun6i_isp_reg.h     | 15 +++++++++++++++
 .../sunxi/sun6i-isp/uapi/sun6i-isp-config.h   |  8 ++++++++
 3 files changed, 42 insertions(+)

diff --git a/drivers/staging/media/sunxi/sun6i-isp/sun6i_isp_params.c b/drivers/staging/media/sunxi/sun6i-isp/sun6i_isp_params.c
index 3ecaf2d49fa4..51821bb73ff8 100644
--- a/drivers/staging/media/sunxi/sun6i-isp/sun6i_isp_params.c
+++ b/drivers/staging/media/sunxi/sun6i-isp/sun6i_isp_params.c
@@ -119,6 +119,19 @@ sun6i_isp_params_configure_yuv_gain_offset(struct sun6i_isp_device *isp_dev,
 			     SUN6I_ISP_YUV_GAIN1_V(yuv->gain_v));
 }
 
+static void
+sun6i_isp_params_configure_contrast(struct sun6i_isp_device *isp_dev,
+				    const struct sun6i_isp_params_config *config)
+{
+	const struct sun6i_isp_params_config_contrast *contrast =
+		&config->contrast;
+
+	sun6i_isp_load_write(isp_dev, SUN6I_ISP_CONTRAST_CFG_REG,
+			     SUN6I_ISP_CONTRAST_CFG_LEVEL(contrast->level) |
+			     SUN6I_ISP_CONTRAST_CFG_MIN(contrast->min) |
+			     SUN6I_ISP_CONTRAST_CFG_MAX(contrast->max));
+}
+
 static void
 sun6i_isp_params_configure_cnr(struct sun6i_isp_device *isp_dev,
 			       const struct sun6i_isp_params_config *config)
@@ -214,6 +227,9 @@ sun6i_isp_params_configure_modules(struct sun6i_isp_device *isp_dev,
 	if (modules & SUN6I_ISP_MODULE_CNR)
 		sun6i_isp_params_configure_cnr(isp_dev, config);
 
+	if (modules & SUN6I_ISP_MODULE_CONTRAST)
+		sun6i_isp_params_configure_contrast(isp_dev, config);
+
 	value = sun6i_isp_load_read(isp_dev, SUN6I_ISP_MODULE_EN_REG);
 	/* Clear all modules but keep input configuration. */
 	value &= SUN6I_ISP_MODULE_EN_SRC0 | SUN6I_ISP_MODULE_EN_SRC1;
@@ -227,6 +243,9 @@ sun6i_isp_params_configure_modules(struct sun6i_isp_device *isp_dev,
 	if (modules & SUN6I_ISP_MODULE_CNR)
 		value |= SUN6I_ISP_MODULE_EN_CNR;
 
+	if (modules & SUN6I_ISP_MODULE_CONTRAST)
+		value |= SUN6I_ISP_MODULE_EN_CONTRAST;
+
 	/* Bayer stage is always enabled. */
 
 	sun6i_isp_load_write(isp_dev, SUN6I_ISP_MODULE_EN_REG, value);
diff --git a/drivers/staging/media/sunxi/sun6i-isp/sun6i_isp_reg.h b/drivers/staging/media/sunxi/sun6i-isp/sun6i_isp_reg.h
index e27b9654642e..2aee592a05f3 100644
--- a/drivers/staging/media/sunxi/sun6i-isp/sun6i_isp_reg.h
+++ b/drivers/staging/media/sunxi/sun6i-isp/sun6i_isp_reg.h
@@ -245,6 +245,21 @@
 #define SUN6I_ISP_WB_CFG_REG			0x148
 #define SUN6I_ISP_WB_CFG_CLIP(v)		((v) & GENMASK(11, 0))
 
+/* Contrast */
+
+#define SUN6I_ISP_CONTRAST_CFG_REG		0x164
+#define SUN6I_ISP_CONTRAST_CFG_LEVEL(v)		((v) & GENMASK(3, 0))
+#define SUN6I_ISP_CONTRAST_CFG_MIN(v)		(((v) << 8) & GENMASK(15, 8))
+#define SUN6I_ISP_CONTRAST_CFG_MAX(v)		(((v) << 16) & GENMASK(23, 16))
+
+/* Saturation */
+
+#define SUN6I_ISP_SATURATION_CFG_REG		0x168
+#define SUN6I_ISP_SATURATION_CFG_R(v)		((v) & GENMASK(3, 0))
+#define SUN6I_ISP_SATURATION_CFG_G(v)		(((v) << 4) & GENMASK(7, 4))
+#define SUN6I_ISP_SATURATION_CFG_B(v)		(((v) << 8) & GENMASK(11, 8))
+#define SUN6I_ISP_SATURATION_CFG_GAIN(v)	(((v) << 16) & GENMASK(24, 16))
+
 /* CNR */
 
 #define SUN6I_ISP_CNR_REG			0x14c
diff --git a/drivers/staging/media/sunxi/sun6i-isp/uapi/sun6i-isp-config.h b/drivers/staging/media/sunxi/sun6i-isp/uapi/sun6i-isp-config.h
index 161d14adc068..cded71bd3bbc 100644
--- a/drivers/staging/media/sunxi/sun6i-isp/uapi/sun6i-isp-config.h
+++ b/drivers/staging/media/sunxi/sun6i-isp/uapi/sun6i-isp-config.h
@@ -14,6 +14,7 @@
 #define SUN6I_ISP_MODULE_BDNF			(1U << 1)
 #define SUN6I_ISP_MODULE_YUV_GAIN_OFFSET	(1U << 2)
 #define SUN6I_ISP_MODULE_CNR			(1U << 3)
+#define SUN6I_ISP_MODULE_CONTRAST		(1U << 4)
 
 struct sun6i_isp_params_config_bayer {
 	__u16	offset_r;
@@ -53,6 +54,12 @@ struct sun6i_isp_params_config_cnr {
 	__u16	offset;
 };
 
+struct sun6i_isp_params_config_contrast {
+	__u8	level;
+	__u8	min;
+	__u8	max;
+};
+
 struct sun6i_isp_params_config {
 	__u32					modules_used;
 
@@ -60,6 +67,7 @@ struct sun6i_isp_params_config {
 	struct sun6i_isp_params_config_bdnf	bdnf;
 	struct sun6i_isp_params_config_yuv_gain_offset	yuv_gain_offset;
 	struct sun6i_isp_params_config_cnr	cnr;
+	struct sun6i_isp_params_config_contrast	contrast;
 };
 
 #endif /* _UAPI_SUN6I_ISP_CONFIG_H */
-- 
2.43.0

