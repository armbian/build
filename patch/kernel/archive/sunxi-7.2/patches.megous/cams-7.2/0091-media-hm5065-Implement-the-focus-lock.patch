From 06c556be6660420405720a5eb72cebc4ee8e3a9d Mon Sep 17 00:00:00 2001
From: Ondrej Jirman <megi@xff.cz>
Date: Sun, 2 Aug 2026 15:10:14 +0200
Subject: [PATCH] media: hm5065: Implement the focus lock

The 3A lock control already advertised the focus bit without acting
on it. Park the AF algorithm in the manual mode while the lock is
held - the lens stays where continuous AF left it - and resume the
continuous mode on unlock.

Signed-off-by: Ondrej Jirman <megi@xff.cz>
---
 drivers/media/i2c/hm5065.c | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/drivers/media/i2c/hm5065.c b/drivers/media/i2c/hm5065.c
index f8fe35b42993..26d548d97b81 100644
--- a/drivers/media/i2c/hm5065.c
+++ b/drivers/media/i2c/hm5065.c
@@ -982,6 +982,7 @@ static int hm5065_3a_lock(struct hm5065_dev *sensor, struct v4l2_ctrl *ctrl)
 {
 	bool awb_lock = ctrl->val & V4L2_LOCK_WHITE_BALANCE;
 	bool ae_lock = ctrl->val & V4L2_LOCK_EXPOSURE;
+	bool af_lock = ctrl->val & V4L2_LOCK_FOCUS;
 	int ret = 0;
 
 	if ((ctrl->val ^ ctrl->cur.val) & V4L2_LOCK_EXPOSURE
@@ -995,6 +996,16 @@ static int hm5065_3a_lock(struct hm5065_dev *sensor, struct v4l2_ctrl *ctrl)
 			  awb_lock ?
 			  HM5065_REG_WB_MISC_SETTINGS_FREEZE_ALGO : 0, &ret);
 
+	/*
+	 * Parking the algorithm in the manual mode holds the lens at its
+	 * current position; no lens command is sent, so nothing moves.
+	 */
+	if (((ctrl->val ^ ctrl->cur.val) & V4L2_LOCK_FOCUS)
+	    && sensor->ctrls.focus_auto->val)
+		cci_write(sensor->regmap, HM5065_REG_AF_MODE,
+			  af_lock ? HM5065_REG_AF_MODE_MANUAL :
+			  HM5065_REG_AF_MODE_CONTINUOUS, &ret);
+
 	return ret;
 }
 
