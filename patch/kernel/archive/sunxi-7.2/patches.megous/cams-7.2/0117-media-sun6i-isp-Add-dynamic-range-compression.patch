From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ondrej Jirman <megi@xff.cz>
Date: Sun, 2 Aug 2026 15:46:13 +0200
Subject: media: sun6i-isp: Add dynamic range compression

The last of the table-driven modules that both variants have: a 256
entry curve at the start of the DRC buffer, with no register
configuration of its own.

There is a mode selector for this module in the vendor interface, but
isp_set_rgb_drc_mode() is a single return instruction on both the A83T
and the V3s, so there is nothing to program. The V3s pairs this with a
disc table further into the same buffer, which is not wired up here.

Signed-off-by: Ondrej Jirman <megi@xff.cz>
---
 drivers/staging/media/sunxi/sun6i-isp/sun6i_isp_params.c      | 17 ++++++++++
 drivers/staging/media/sunxi/sun6i-isp/uapi/sun6i-isp-config.h |  7 ++++
 2 files changed, 24 insertions(+)

diff --git a/drivers/staging/media/sunxi/sun6i-isp/sun6i_isp_params.c b/drivers/staging/media/sunxi/sun6i-isp/sun6i_isp_params.c
index 111111111111..222222222222 100644
--- a/drivers/staging/media/sunxi/sun6i-isp/sun6i_isp_params.c
+++ b/drivers/staging/media/sunxi/sun6i-isp/sun6i_isp_params.c
@@ -250,6 +250,17 @@ sun6i_isp_params_configure_lsc(struct sun6i_isp_device *isp_dev,
 				     lsc->table_b, sizeof(lsc->table_b));
 }
 
+static void
+sun6i_isp_params_configure_drc(struct sun6i_isp_device *isp_dev,
+			       const struct sun6i_isp_params_config *config)
+{
+	sun6i_isp_params_table_write(isp_dev, &isp_dev->tables.drc,
+				     SUN6I_ISP_TABLE_DRC_OFFSET,
+				     SUN6I_ISP_FE_CTRL_DRC_UPDATE,
+				     config->drc.table,
+				     sizeof(config->drc.table));
+}
+
 static void
 sun6i_isp_params_configure_cnr(struct sun6i_isp_device *isp_dev,
 			       const struct sun6i_isp_params_config *config)
@@ -363,6 +374,9 @@ sun6i_isp_params_configure_modules(struct sun6i_isp_device *isp_dev,
 	if (modules & SUN6I_ISP_MODULE_LSC)
 		sun6i_isp_params_configure_lsc(isp_dev, config);
 
+	if (modules & SUN6I_ISP_MODULE_DRC)
+		sun6i_isp_params_configure_drc(isp_dev, config);
+
 	if (modules & SUN6I_ISP_MODULE_RGB2RGB)
 		sun6i_isp_params_configure_rgb2rgb(isp_dev, config);
 
@@ -391,6 +405,9 @@ sun6i_isp_params_configure_modules(struct sun6i_isp_device *isp_dev,
 	if (modules & SUN6I_ISP_MODULE_LSC)
 		value |= SUN6I_ISP_MODULE_EN_LSC;
 
+	if (modules & SUN6I_ISP_MODULE_DRC)
+		value |= SUN6I_ISP_MODULE_EN_RGB_DRC;
+
 	if (modules & SUN6I_ISP_MODULE_RGB2RGB)
 		value |= SUN6I_ISP_MODULE_EN_RGB2RGB;
 
diff --git a/drivers/staging/media/sunxi/sun6i-isp/uapi/sun6i-isp-config.h b/drivers/staging/media/sunxi/sun6i-isp/uapi/sun6i-isp-config.h
index 111111111111..222222222222 100644
--- a/drivers/staging/media/sunxi/sun6i-isp/uapi/sun6i-isp-config.h
+++ b/drivers/staging/media/sunxi/sun6i-isp/uapi/sun6i-isp-config.h
@@ -20,6 +20,7 @@
 #define SUN6I_ISP_MODULE_RGB2RGB		(1U << 7)
 #define SUN6I_ISP_MODULE_GAMMA			(1U << 8)
 #define SUN6I_ISP_MODULE_LSC			(1U << 9)
+#define SUN6I_ISP_MODULE_DRC			(1U << 10)
 
 struct sun6i_isp_params_config_bayer {
 	__u16	offset_r;
@@ -105,6 +106,11 @@ struct sun6i_isp_params_config_lsc {
 	__u16	table_b[256];
 };
 
+/* Dynamic range compression curve, one 16-bit entry per input level. */
+struct sun6i_isp_params_config_drc {
+	__u16	table[256];
+};
+
 struct sun6i_isp_params_config {
 	__u32					modules_used;
 
@@ -118,6 +124,7 @@ struct sun6i_isp_params_config {
 	struct sun6i_isp_params_config_rgb2rgb	rgb2rgb;
 	struct sun6i_isp_params_config_gamma	gamma;
 	struct sun6i_isp_params_config_lsc	lsc;
+	struct sun6i_isp_params_config_drc	drc;
 };
 
 #endif /* _UAPI_SUN6I_ISP_CONFIG_H */
-- 
Armbian

