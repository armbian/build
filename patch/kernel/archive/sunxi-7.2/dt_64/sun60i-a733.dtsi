			clocks = <&ccu CLK_BUS_PWM1>;
			clock-names = "bus";
			resets = <&ccu RST_BUS_PWM1>;
			pwm-number = <10>;
			pwm-base = <10>;
			#pwm-cells = <3>;
			status = "disabled";
