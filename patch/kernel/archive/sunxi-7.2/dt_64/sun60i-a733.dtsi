#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <dt-bindings/clock/sun60i-a733-ccu.h>
#include <dt-bindings/clock/sun55i-a523-r-ccu.h>
#include <dt-bindings/reset/sun60i-a733-ccu.h>
#include <dt-bindings/reset/sun55i-a523-r-ccu.h>
#include <dt-bindings/power/allwinner,sun60i-a733-pck-600.h>
#include <dt-bindings/thermal/thermal.h>

#ifndef CLK_PLL_CPU_L
#define CLK_PLL_CPU_L 1
#endif
#ifndef CLK_PLL_CPU_B
#define CLK_PLL_CPU_B 2
#endif

/ {
	interrupt-parent = <&gic>;
	#address-cells = <2>;
	#size-cells = <2>;

	clocks {
		osc24M: osc24M {
			#clock-cells = <0>;
			compatible = "fixed-clock";
			clock-frequency = <24000000>;
			clock-output-names = "osc24M";
		};

		osc32k: osc32k {
			#clock-cells = <0>;
			compatible = "fixed-clock";
			clock-frequency = <32768>;
			clock-output-names = "osc32k";
		};
	};

	cpus {
		#address-cells = <2>;
		#size-cells = <0>;

		cpu0: cpu@0 {
			compatible = "arm,cortex-a55";
			device_type = "cpu";
			reg = <0x0 0x0>;
			enable-method = "psci";
			clocks = <&cpupll_ccu CLK_PLL_CPU_L>;
			operating-points-v2 = <&cluster0_opp_table>;
		};

		cpu1: cpu@100 {
			compatible = "arm,cortex-a55";
			device_type = "cpu";
			reg = <0x0 0x100>;
			enable-method = "psci";
			clocks = <&cpupll_ccu CLK_PLL_CPU_L>;
			operating-points-v2 = <&cluster0_opp_table>;
		};

		cpu2: cpu@200 {
			compatible = "arm,cortex-a55";
			device_type = "cpu";
			reg = <0x0 0x200>;
			enable-method = "psci";
			clocks = <&cpupll_ccu CLK_PLL_CPU_L>;
			operating-points-v2 = <&cluster0_opp_table>;
		};

		cpu3: cpu@300 {
			compatible = "arm,cortex-a55";
			device_type = "cpu";
			reg = <0x0 0x300>;
			enable-method = "psci";
			clocks = <&cpupll_ccu CLK_PLL_CPU_L>;
			operating-points-v2 = <&cluster0_opp_table>;
		};

		cpu4: cpu@400 {
			compatible = "arm,cortex-a55";
			device_type = "cpu";
			reg = <0x0 0x400>;
			enable-method = "psci";
			clocks = <&cpupll_ccu CLK_PLL_CPU_L>;
			operating-points-v2 = <&cluster0_opp_table>;
		};

		cpu5: cpu@500 {
			compatible = "arm,cortex-a55";
			device_type = "cpu";
			reg = <0x0 0x500>;
			enable-method = "psci";
			clocks = <&cpupll_ccu CLK_PLL_CPU_L>;
			operating-points-v2 = <&cluster0_opp_table>;
		};

		cpu6: cpu@600 {
			compatible = "arm,cortex-a76";
			device_type = "cpu";
			reg = <0x0 0x600>;
			enable-method = "psci";
			clocks = <&cpupll_ccu CLK_PLL_CPU_B>;
			operating-points-v2 = <&cluster1_opp_table>;
		};

		cpu7: cpu@700 {
			compatible = "arm,cortex-a76";
			device_type = "cpu";
			reg = <0x0 0x700>;
			enable-method = "psci";
			clocks = <&cpupll_ccu CLK_PLL_CPU_B>;
			operating-points-v2 = <&cluster1_opp_table>;
		};
	};

	cluster0_opp_table: opp-table-cluster0 {
		compatible = "operating-points-v2";
		opp-shared;

		opp-408000000 {
			opp-hz = /bits/ 64 <408000000>;
			opp-microvolt = <800000>;
			clock-latency-ns = <244144>;
		};

		opp-720000000 {
			opp-hz = /bits/ 64 <720000000>;
			opp-microvolt = <800000>;
			clock-latency-ns = <244144>;
		};

		opp-792000000 {
			opp-hz = /bits/ 64 <792000000>;
			opp-microvolt = <800000>;
			clock-latency-ns = <244144>;
		};

		opp-936000000 {
			opp-hz = /bits/ 64 <936000000>;
			opp-microvolt = <800000>;
			clock-latency-ns = <244144>;
		};

		opp-1008000000 {
			opp-hz = /bits/ 64 <1008000000>;
			opp-microvolt = <800000>;
			clock-latency-ns = <244144>;
		};

		opp-1104000000 {
			opp-hz = /bits/ 64 <1104000000>;
			opp-microvolt = <800000>;
			clock-latency-ns = <244144>;
		};

		opp-1200000000 {
			opp-hz = /bits/ 64 <1200000000>;
			opp-microvolt = <850000>;
			clock-latency-ns = <244144>;
		};

		opp-1296000000 {
			opp-hz = /bits/ 64 <1296000000>;
			opp-microvolt = <900000>;
			clock-latency-ns = <244144>;
		};

		opp-1392000000 {
			opp-hz = /bits/ 64 <1392000000>;
			opp-microvolt = <950000>;
			clock-latency-ns = <244144>;
		};

		opp-1416000000 {
			opp-hz = /bits/ 64 <1416000000>;
			opp-microvolt = <960000>;
			clock-latency-ns = <244144>;
		};

		opp-1512000000 {
			opp-hz = /bits/ 64 <1512000000>;
			opp-microvolt = <1000000>;
			clock-latency-ns = <244144>;
		};
	};

	cluster1_opp_table: opp-table-cluster1 {
		compatible = "operating-points-v2";
		opp-shared;

		opp-408000000 {
			opp-hz = /bits/ 64 <408000000>;
			opp-microvolt = <800000>;
			clock-latency-ns = <244144>;
		};

		opp-720000000 {
			opp-hz = /bits/ 64 <720000000>;
			opp-microvolt = <800000>;
			clock-latency-ns = <244144>;
		};

		opp-792000000 {
			opp-hz = /bits/ 64 <792000000>;
			opp-microvolt = <800000>;
			clock-latency-ns = <244144>;
		};

		opp-936000000 {
			opp-hz = /bits/ 64 <936000000>;
			opp-microvolt = <800000>;
			clock-latency-ns = <244144>;
		};

		opp-1008000000 {
			opp-hz = /bits/ 64 <1008000000>;
			opp-microvolt = <800000>;
			clock-latency-ns = <244144>;
		};

		opp-1200000000 {
			opp-hz = /bits/ 64 <1200000000>;
			opp-microvolt = <800000>;
			clock-latency-ns = <244144>;
		};

		opp-1392000000 {
			opp-hz = /bits/ 64 <1392000000>;
			opp-microvolt = <850000>;
			clock-latency-ns = <244144>;
		};

		opp-1512000000 {
			opp-hz = /bits/ 64 <1512000000>;
			opp-microvolt = <900000>;
			clock-latency-ns = <244144>;
		};

		opp-1608000000 {
			opp-hz = /bits/ 64 <1608000000>;
			opp-microvolt = <950000>;
			clock-latency-ns = <244144>;
		};

		opp-1704000000 {
			opp-hz = /bits/ 64 <1704000000>;
			opp-microvolt = <1000000>;
			clock-latency-ns = <244144>;
		};

		opp-1800000000 {
			opp-hz = /bits/ 64 <1800000000>;
			opp-microvolt = <1050000>;
			clock-latency-ns = <244144>;
		};

		opp-1920000000 {
			opp-hz = /bits/ 64 <1920000000>;
			opp-microvolt = <1100000>;
			clock-latency-ns = <244144>;
		};

		opp-2016000000 {
			opp-hz = /bits/ 64 <2016000000>;
			opp-microvolt = <1150000>;
			clock-latency-ns = <244144>;
		};
	};

	psci {
		compatible = "arm,psci-1.0";
		method = "smc";
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupts = <GIC_PPI 13 IRQ_TYPE_LEVEL_LOW>,
			     <GIC_PPI 14 IRQ_TYPE_LEVEL_LOW>,
			     <GIC_PPI 11 IRQ_TYPE_LEVEL_LOW>,
			     <GIC_PPI 10 IRQ_TYPE_LEVEL_LOW>;
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		secmon_reserved: secmon@48000000 {
			reg = <0x0 0x48000000 0x0 0x01000000>;
			no-map;
		};
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <1>;
		#size-cells = <1>;
		ranges = <0x0 0x0 0x0 0x40000000>;

		gic: interrupt-controller@3400000 {
			compatible = "arm,gic-v3";
			reg = <0x03400000 0x10000>,
			      <0x03460000 0x100000>;
			interrupts = <GIC_PPI 9 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-controller;
			#interrupt-cells = <3>;
		};

		npu: npu@3600000 {
			compatible = "allwinner,npu";
			reg = <0x03600000 0x1000>;
			interrupts = <GIC_SPI 65 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "npu";
			clocks = <&ccu CLK_NPU>, <&ccu CLK_PLL_PERIPH0_800M>, <&ccu CLK_BUS_NPU>;
			clock-names = "clk_npu", "clk_parent", "clk_bus";
			resets = <&ccu RST_BUS_NPU_CORE>, <&ccu RST_BUS_NPU_AXI>, <&ccu RST_BUS_NPU_AHB>;
			reset-names = "npu_rst", "npu_axi_rst", "npu_ahb_rst";
			power-domains = <&pck600 PD_NPU>;
			assigned-clocks = <&ccu CLK_NPU>;
			assigned-clock-parents = <&ccu CLK_PLL_PERIPH0_800M>;
			assigned-clock-rates = <800000000>;
			status = "disabled";
		};

		pio: pinctrl@2000000 {
			compatible = "allwinner,sun60i-a733-pinctrl",
				     "allwinner,sun55i-a523-pinctrl";
			reg = <0x02000000 0x800>;
			interrupts = <GIC_SPI 67 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 69 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 71 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 73 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 75 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 77 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 79 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 81 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 83 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 85 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 140 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_APB1>, <&osc24M>, <&osc32k>;
			clock-names = "apb", "hosc", "losc";
			#gpio-cells = <3>;
			gpio-controller;
			interrupt-controller;
			#interrupt-cells = <3>;

			uart0_pb_pins: uart0-pb-pins {
				pins = "PB9", "PB10";
				function = "uart0";
				allwinner,pinmux = <2>;
			};

			mmc0_pins: mmc0-pins {
				pins = "PF0", "PF1", "PF2", "PF3", "PF4", "PF5";
				function = "mmc0";
				allwinner,pinmux = <2>;
				drive-strength = <30>;
				bias-pull-up;
			};

			mmc1_pins: mmc1-pins {
				pins = "PG0", "PG1", "PG2", "PG3", "PG4", "PG5";
				function = "mmc1";
				allwinner,pinmux = <2>;
				drive-strength = <30>;
				bias-pull-up;
			};

			mmc2_pins: mmc2-pins {
				pins = "PC0", "PC1", "PC5", "PC6", "PC7",
				       "PC8", "PC9", "PC10", "PC11", "PC12", "PC13";
				function = "mmc2";
				allwinner,pinmux = <3>;
				drive-strength = <30>;
				bias-pull-up;
			};

			gmac0_rgmii_pins: gmac0-rgmii-pins {
				pins = "PH0", "PH1", "PH2", "PH3",
				       "PH4", "PH5", "PH6", "PH7",
				       "PH8", "PH9", "PH10", "PH11",
				       "PH12", "PH13", "PH14", "PH15";
				function = "gmac0";
				allwinner,pinmux = <5>;
				drive-strength = <40>;
				bias-pull-up;
			};

			uart1_pg_pins: uart1-pg-pins {
				pins = "PG6", "PG7", "PG8", "PG9";
				function = "uart1";
				allwinner,pinmux = <2>;
			};

			uart2_pb_pins: uart2-pb-pins {
				pins = "PB0", "PB1";
				function = "uart2";
				allwinner,pinmux = <2>;
			};

			uart5_pi_pins: uart5-pi-pins {
				pins = "PI8", "PI9";
				function = "uart5";
				allwinner,pinmux = <3>;
			};

			i2s4_pins: i2s4-pins {
				pins = "PK0", "PK1", "PK2", "PK3", "PK4";
				function = "i2s4";
				allwinner,pinmux = <4>;
			};

			twi0_pb_pins: twi0-pb-pins {
				pins = "PB2", "PB3";
				function = "twi0";
				allwinner,pinmux = <8>;
			};

			twi1_pb_pins: twi1-pb-pins {
				pins = "PB4", "PB5";
				function = "twi1";
				allwinner,pinmux = <8>;
			};

			twi2_pe_pins: twi2-pe-pins {
				pins = "PE1", "PE2";
				function = "twi2";
				allwinner,pinmux = <2>;
			};

			twi3_pe_pins: twi3-pe-pins {
				pins = "PE3", "PE4";
				function = "twi3";
				allwinner,pinmux = <2>;
			};

			twi7_pins: twi7-pins {
				pins = "PJ22", "PJ23";
				function = "twi7";
				allwinner,pinmux = <6>;
				drive-strength = <10>;
				bias-pull-up;
			};

			spi0_pc_pins: spi0-pc-pins {
				pins = "PC2", "PC3", "PC4", "PC12";
				function = "spi0";
				allwinner,pinmux = <5>;
			};

			spi1_ph_pins: spi1-ph-pins {
				pins = "PH3", "PH4", "PH5", "PH6";
				function = "spi1";
				allwinner,pinmux = <7>;
			};
		};

		ccu: clock-controller@2002000 {
			compatible = "allwinner,sun60i-a733-ccu";
			reg = <0x02002000 0x3000>;
			clocks = <&osc24M>, <&osc32k>, <&osc32k>, <&osc32k>;

			clock-names = "hosc", "losc", "iosc", "losc-fanout";
			#clock-cells = <1>;
			#reset-cells = <1>;
		};

		cpupll_ccu: clock-controller@8870000 {
			compatible = "allwinner,sun60iw2-cpupll";
			reg = <0x08870000 0x3034>;
			clocks = <&osc24M>;
			clock-names = "dcxo";
			#clock-cells = <1>;
			#reset-cells = <1>;
		};

		r_pio: pinctrl@7025000 {
			compatible = "allwinner,sun60i-a733-r-pinctrl",
				     "allwinner,sun55i-a523-r-pinctrl";
			reg = <0x07025000 0x800>;
			interrupts = <GIC_SPI 198 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 200 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&r_ccu CLK_R_APB0>, <&osc24M>, <&osc32k>;
			clock-names = "apb", "hosc", "losc";
			#gpio-cells = <3>;
			gpio-controller;
			interrupt-controller;
			#interrupt-cells = <3>;
			status = "disabled";

			s_pwm_fan_pin: s-pwm-fan-pin {
				pins = "PL9";
				function = "s_pwm";
				allwinner,pinmux = <6>;
			};

			r_i2c0_pins: r-i2c0-pins {
				pins = "PL0", "PL1";
				function = "r_i2c0";
				allwinner,pinmux = <2>;
				drive-strength = <10>;
				bias-pull-up;
			};
		};

		r_ccu: clock-controller@7010000 {
			compatible = "allwinner,sun55i-a523-r-ccu";
			reg = <0x07010000 0x1000>;
			clocks = <&osc24M>, <&osc32k>, <&osc32k>, <&ccu CLK_PLL_PERIPH0_200M>;
			clock-names = "hosc", "losc", "iosc", "pll-periph";
			#clock-cells = <1>;
			#reset-cells = <1>;
		};

		pck600: power-controller@7060000 {
			compatible = "allwinner,sun60i-a733-pck-600";
			reg = <0x07060000 0xb000>;
			clocks = <&r_ccu CLK_BUS_R_PPU0>;
			#power-domain-cells = <1>;
		};

		wdt: watchdog@2050000 {
			compatible = "allwinner,sun55i-a523-wdt",
				     "allwinner,sun20i-d1-wdt";
			reg = <0x02050000 0x20>;
			interrupts = <GIC_SPI 23 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&osc24M>;
			status = "disabled";
		};

		uart0: serial@2500000 {
			compatible = "snps,dw-apb-uart";
			reg = <0x02500000 0x400>;
			interrupts = <GIC_SPI 2 IRQ_TYPE_LEVEL_HIGH>;
			reg-shift = <2>;
			reg-io-width = <4>;
			clocks = <&ccu CLK_BUS_UART0>;
			resets = <&ccu RST_BUS_UART0>;
			status = "disabled";
		};

		mmc0: mmc@4020000 {
			compatible = "allwinner,sun55i-a523-mmc",
				     "allwinner,sun20i-d1-mmc";
			reg = <0x04020000 0x1000>;
			clocks = <&ccu CLK_BUS_MMC0>, <&ccu CLK_MMC0>;
			clock-names = "ahb", "mmc";
			resets = <&ccu RST_BUS_MMC0>;
			reset-names = "ahb";
			interrupts = <GIC_SPI 161 IRQ_TYPE_LEVEL_HIGH>;
			pinctrl-names = "default";
			pinctrl-0 = <&mmc0_pins>;
			status = "disabled";

			max-frequency = <150000000>;
			cap-sd-highspeed;
			cap-mmc-highspeed;
			#address-cells = <1>;
			#size-cells = <0>;
		};

		mmc1: mmc@4021000 {
			compatible = "allwinner,sun55i-a523-mmc",
				     "allwinner,sun20i-d1-mmc";
			reg = <0x04021000 0x1000>;
			clocks = <&ccu CLK_BUS_MMC1>, <&ccu CLK_MMC1>;
			clock-names = "ahb", "mmc";
			resets = <&ccu RST_BUS_MMC1>;
			reset-names = "ahb";
			interrupts = <GIC_SPI 162 IRQ_TYPE_LEVEL_HIGH>;
			pinctrl-names = "default";
			pinctrl-0 = <&mmc1_pins>;
			status = "disabled";

			max-frequency = <150000000>;
			cap-sd-highspeed;
			cap-sdio-irq;
			#address-cells = <1>;
			#size-cells = <0>;
		};

		mmc2: mmc@4022000 {
			compatible = "allwinner,sun55i-a523-mmc",
				     "allwinner,sun20i-d1-mmc";
			reg = <0x04022000 0x1000>;
			clocks = <&ccu CLK_BUS_MMC2>, <&ccu CLK_MMC2>;
			clock-names = "ahb", "mmc";
			resets = <&ccu RST_BUS_MMC2>;
			reset-names = "ahb";
			interrupts = <GIC_SPI 163 IRQ_TYPE_LEVEL_HIGH>;
			pinctrl-names = "default";
			pinctrl-0 = <&mmc2_pins>;
			status = "disabled";

			max-frequency = <150000000>;
			cap-sd-highspeed;
			cap-mmc-highspeed;
			#address-cells = <1>;
			#size-cells = <0>;
		};

		usbphy: phy@4100400 {
			compatible = "allwinner,sun55i-a523-usb-phy";
			reg = <0x04100400 0x14>,
			      <0x04101800 0x4>,
			      <0x04200800 0x4>;
			reg-names = "phy_ctrl",
				    "pmu0",
				    "pmu1";
			clocks = <&ccu CLK_USB_OHCI0>,
				 <&ccu CLK_USB_OHCI1>;
			clock-names = "usb0_phy",
				      "usb1_phy";
			resets = <&ccu RST_USB_PHY0>,
				 <&ccu RST_USB_PHY1>;
			reset-names = "usb0_reset",
				      "usb1_reset";
			status = "disabled";
			#phy-cells = <1>;
		};

		u2phy: phy@6b00000 {
			compatible = "allwinner,sunxi-plat-phy";
			reg = <0x06b00000 0x800>,
			      <0x03000000 0x300>;
			reg-names = "u2_base", "res_base";
			clocks = <&ccu CLK_BUS_OTG>, <&osc24M>;
			clock-names = "phy_clk", "res_dcap";
			aw,rext_mode = <2>;
			aw,phy_tune_param = <0x143338D6>;
			#phy-cells = <0>;
			status = "disabled";
		};

		dwc3: usb@6a00000 {
			compatible = "snps,dwc3";
			reg = <0x06a00000 0x100000>;
			interrupts = <GIC_SPI 155 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_BUS_OTG>, <&ccu CLK_USB3_REF>;
			clock-names = "bus_clk", "ref";
			assigned-clocks = <&ccu CLK_USB3_REF>;
			assigned-clock-rates = <24000000>;
			resets = <&ccu RST_BUS_3>, <&ccu RST_BUS_PCIE_USB3>;
			reset-names = "bus", "dwc3";
			maximum-speed = "super-speed-plus";
			phy_type = "utmi";
			dr_mode = "host";
			snps,dis_enblslpm_quirk;
			snps,dis-u1-entry-quirk;
			snps,dis-u2-entry-quirk;
			snps,dis_u2_susphy_quirk;
			snps,dis_u3_susphy_quirk;
			phys = <&u2phy>, <&combo0_usb>;
			phy-names = "usb2-phy", "usb3-phy";
			status = "disabled";
		};

		ehci0: usb@4101000 {
			compatible = "allwinner,sun55i-a523-ehci",
				     "generic-ehci";
			reg = <0x04101000 0x100>;
			interrupts = <GIC_SPI 157 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_BUS_OHCI0>,
				 <&ccu CLK_BUS_EHCI0>,
				 <&ccu CLK_USB_OHCI0>;
			resets = <&ccu RST_BUS_OHCI0>,
				 <&ccu RST_BUS_EHCI0>;
			phys = <&usbphy 0>;
			phy-names = "usb";
			status = "disabled";
		};

		ohci0: usb@4101400 {
			compatible = "allwinner,sun55i-a523-ohci",
				     "generic-ohci";
			reg = <0x04101400 0x100>;
			interrupts = <GIC_SPI 158 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_BUS_OHCI0>,
				 <&ccu CLK_USB_OHCI0>;
			resets = <&ccu RST_BUS_OHCI0>;
			phys = <&usbphy 0>;
