			reg = <0x04200400 0x100>;
			interrupts = <GIC_SPI 160 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_BUS_OHCI1>,
				 <&ccu CLK_USB_OHCI1>;
			resets = <&ccu RST_BUS_OHCI1>;
			phys = <&usbphy 1>;
			phy-names = "usb";
			status = "disabled";
		};

		gmac0: ethernet@4500000 {
			compatible = "allwinner,sun60i-a733-gmac210";
			reg = <0x04500000 0x4000>;
			interrupts = <GIC_SPI 172 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 178 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 173 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 174 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "macirq", "eth_lpi", "tx0_irq", "rx0_irq";
			clocks = <&ccu CLK_BUS_EMAC0>, <&ccu CLK_BUS_EMAC0>, <&ccu CLK_BUS_EMAC0>;
			clock-names = "stmmaceth", "pclk", "ptp_ref";
			resets = <&ccu RST_BUS_EMAC0>;
			reset-names = "stmmaceth";
			syscon = <&gmac0_syscon>;
			status = "disabled";
		};

		gmac0_syscon: syscon@4508000 {
			compatible = "allwinner,sun60i-a733-gmac-syscon", "syscon";
			reg = <0x04508000 0x100>;
		};

		r_i2c0: i2c@7083000 {
			compatible = "allwinner,sun6i-a31-i2c";
			reg = <0x07083000 0x400>;
			interrupts = <GIC_SPI 203 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&r_ccu CLK_BUS_R_I2C0>;
			clock-names = "bus";
			resets = <&r_ccu RST_BUS_R_I2C0>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};

		serdes: serdes@6c00000 {
			compatible = "allwinner,cadence-combophy";
			reg = <0x06c00000 0x2000>,
			      <0x06c06000 0x2000>,
			      <0x0709016c 0x4>;
			clocks = <&ccu CLK_SERDES_PHY_CFG>, <&osc24M>, <&osc24M>;
			clock-names = "serdes-clk", "dcxo-serdes0-clk", "dcxo-serdes1-clk";
			resets = <&ccu RST_BUS_SERDES>;
			reset-names = "serdes-reset";
			power-domains = <&pck600 PD_PCIE>;
			udp-disable;
			#address-cells = <1>;
			#size-cells = <1>;
			ranges;
			status = "disabled";



			combophy0: combo-phy0@6c01000 {
				reg = <0x06c01000 0xa00>,
				      <0x06c80000 0x20000>;
				lane_remap = <0x00 0x01 0x02 0x03>;
				lane_invert = <0x00 0x00 0x00 0x00>;
				combo0_dp: combo0-dp-phy {
					#phy-cells = <0>;
					status = "okay";
				};
				combo0_usb: combo0-usb-phy {
					#phy-cells = <0>;
					status = "okay";
				};
			};

			combophy1: combo-phy1@6c02000 {
				reg = <0x06c02000 0xa00>,
				      <0x06ca0000 0x20000>;
				lane_remap = <0x00 0x01 0x02 0x03>;
				lane_invert = <0x00 0x00 0x00 0x00>;
				combo1_usb: combo1-usb-phy {
					#phy-cells = <0>;
					status = "okay";
				};
				combo1_pcie: combo1-pcie-phy {
					#phy-cells = <0>;
					status = "okay";
				};
			};

			aux_hpd: aux-hpd@6c01e00 {
				reg = <0x06c01e00 0x200>;
				aux_hpd_phy: aux-hpd-phy {
					#phy-cells = <0>;
					status = "okay";
				};
			};
		};

		sid: efuse@3006000 {
			compatible = "allwinner,sun60i-a733-sid",
				     "allwinner,sun55i-a523-sid",
				     "allwinner,sun50i-a64-sid";
			reg = <0x03006000 0x1000>;
			#address-cells = <1>;
			#size-cells = <1>;

			ths_calibration: ths-calibration@44 {
				reg = <0x44 0xc>;
			};
		};

		dma: dma-controller@4601000 {
			compatible = "allwinner,sun60i-a733-dma",
				     "allwinner,sun55i-a523-dma",
				     "allwinner,sun50i-a100-dma";
			reg = <0x04601000 0x1000>;
			interrupts = <GIC_SPI 111 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_BUS_DMA>, <&ccu CLK_MBUS_DMA>;
			clock-names = "bus", "mbus";
			dma-channels = <16>;
			dma-requests = <64>;
			resets = <&ccu RST_BUS_DMA>;
			#dma-cells = <1>;
			status = "disabled";
		};

		ths: thermal-sensor@2522000 {
			compatible = "allwinner,sun60i-a733-ths";
			reg = <0x02522000 0x500>;
			interrupts = <GIC_SPI 40 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_BUS_THS>, <&ccu CLK_GPADC0>;
			clock-names = "bus", "mod";
			resets = <&ccu RST_BUS_THS>;
			nvmem-cells = <&ths_calibration>;
			nvmem-cell-names = "calibration";
			#thermal-sensor-cells = <1>;
			status = "disabled";
		};

		pwm0: pwm@2527000 {
			compatible = "allwinner,sun60i-a733-pwm",
