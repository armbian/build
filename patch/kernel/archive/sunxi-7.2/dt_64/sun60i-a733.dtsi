			clocks = <&ccu CLK_BUS_PWM0>;
			clock-names = "bus";
			resets = <&ccu RST_BUS_PWM0>;
			pwm-number = <10>;
			pwm-base = <0>;
			#pwm-cells = <3>;
			status = "disabled";
		};

		pwm1: pwm@2528000 {
			compatible = "allwinner,sun60i-a733-pwm",
