			status = "disabled";
		};

		twi7: i2c@2517000 {
			compatible = "allwinner,sun60i-a733-i2c",
				     "allwinner,sun55i-a523-i2c",
				     "allwinner,sun6i-a31-i2c";
			reg = <0x02517000 0x400>;
			interrupts = <GIC_SPI 18 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_BUS_I2C7>;
			resets = <&ccu RST_BUS_I2C7>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};

		gpadc: adc@2521000 {
			compatible = "allwinner,sun60i-a733-gpadc",
				     "allwinner,sun55i-a523-gpadc",
				     "allwinner,sun20i-d1-gpadc";
			reg = <0x02521000 0x400>;
			interrupts = <GIC_SPI 38 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_BUS_GPADC0>, <&ccu CLK_GPADC0>;
			clock-names = "bus", "mod";
			resets = <&ccu RST_BUS_GPADC0>;
			#io-channel-cells = <1>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";

			channel@0 {
				reg = <0>;
			};

			channel@1 {
				reg = <1>;
			};

			channel@2 {
				reg = <2>;
			};

			channel@3 {
				reg = <3>;
			};

			channel@4 {
				reg = <4>;
			};

			channel@5 {
				reg = <5>;
			};

			channel@6 {
				reg = <6>;
			};

			channel@7 {
				reg = <7>;
			};
		};

		lradc: lradc@2524000 {
			compatible = "allwinner,sun60i-a733-lradc",
				     "allwinner,sun55i-a523-lradc",
				     "allwinner,sun50i-h616-lradc";
			reg = <0x02524000 0x400>;
			interrupts = <GIC_SPI 37 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_BUS_LRADC>;
			resets = <&ccu RST_BUS_LRADC>;
			status = "disabled";
		};

		i2s4: i2s@2536000 {
			compatible = "allwinner,sun60i-a733-i2s",
				     "allwinner,sun50i-h6-i2s";
			reg = <0x02536000 0x1000>;
			interrupts = <GIC_SPI 46 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_BUS_I2S4>, <&ccu CLK_I2S4>;
			clock-names = "apb", "mod";
			resets = <&ccu RST_BUS_I2S4>;
			dmas = <&dma 7>, <&dma 7>;
			dma-names = "rx", "tx";
			#sound-dai-cells = <0>;
			status = "disabled";
		};

		spi0: spi@2540000 {
			compatible = "allwinner,sun60i-a733-spi",
				     "allwinner,sun50i-r329-spi";
			reg = <0x02540000 0x1000>;
			interrupts = <GIC_SPI 24 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_BUS_SPI0>, <&ccu CLK_SPI0>;
			clock-names = "ahb", "mod";
			resets = <&ccu RST_BUS_SPI0>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};

		spi1: spi@2541000 {
			compatible = "allwinner,sun60i-a733-spi",
				     "allwinner,sun50i-r329-spi";
			reg = <0x02541000 0x1000>;
			interrupts = <GIC_SPI 25 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_BUS_SPI1>, <&ccu CLK_SPI1>;
			clock-names = "ahb", "mod";
			resets = <&ccu RST_BUS_SPI1>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};
	};


	pcie_rc: pcie@6000000 {
		#address-cells = <3>;
		#size-cells = <2>;
		compatible = "allwinner,sunxi-pcie-v300-rc";
		bus-range = <0x0 0xff>;
		reg = <0x0 0x06000000 0x0 0x480000>;
		reg-names = "dbi";
		device_type = "pci";
		ranges = <0x00000800 0 0x20000000 0x0 0x20000000 0 0x01000000>,
			 <0x81000000 0 0x21000000 0x0 0x21000000 0 0x01000000>,
			 <0x82000000 0 0x22000000 0x0 0x22000000 0 0x06000000>;
		dma-ranges = <0x02000000 0x0 0x40000000 0x0 0x40000000 0x3 0xc0000000>;
		num-lanes = <1>;
		interrupts = <GIC_SPI 152 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 153 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 136 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 137 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 138 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 139 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 140 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 141 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 142 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 143 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "sii", "msi", "edma-w0", "edma-w1", "edma-w2", "edma-w3",
				  "edma-r0", "edma-r1", "edma-r2", "edma-r3";
		#interrupt-cells = <1>;
		interrupt-map-mask = <0 0 0 7>;
		interrupt-map = <0 0 0 1 &pcie_intc 0>,
				<0 0 0 2 &pcie_intc 1>,
				<0 0 0 3 &pcie_intc 2>,
				<0 0 0 4 &pcie_intc 3>;
		num-edma = <4>;
		max-link-speed = <3>;
		num-ib-windows = <16>;
		num-ob-windows = <16>;
		linux,pci-domain = <0>;
		power-domains = <&pck600 PD_PCIE>;
		clocks = <&ccu CLK_PCIE_AUX>, <&ccu CLK_PCIE_AXI_SLV>, <&ccu CLK_PCIE_ITS>;
		clock-names = "pclk_aux", "pclk_slv", "its";
		assigned-clocks = <&ccu CLK_PCIE_AXI_SLV>;
		assigned-clock-parents = <&ccu CLK_PLL_PERIPH0_400M>;
		assigned-clock-rates = <400000000>;
		resets = <&ccu RST_PCIE_PCLK>, <&ccu RST_PCIE_PWRUP>, <&ccu RST_PCIE_ITS>;
		reset-names = "pclk_rst", "pwrup_rst", "its";
		status = "disabled";

		pcie_intc: legacy-interrupt-controller {
			interrupt-controller;
			#address-cells = <0>;
			#interrupt-cells = <1>;
		};
	};

	thermal-zones {
		cpu_little_thermal: cpu-little-thermal {
			polling-delay-passive = <0>;
			polling-delay = <0>;
			thermal-sensors = <&ths 0>;

			trips {
				cpu_little_passive: cpu-little-passive {
					temperature = <75000>;
					hysteresis = <2000>;
					type = "passive";
				};

				cpu_little_hot: cpu-little-hot {
					temperature = <85000>;
					hysteresis = <2000>;
					type = "passive";
				};

				cpu_little_crit: cpu-little-crit {
					temperature = <105000>;
					hysteresis = <0>;
					type = "critical";
				};
			};
		};

		cpu_big_thermal: cpu-big-thermal {
			polling-delay-passive = <0>;
			polling-delay = <0>;
			thermal-sensors = <&ths 1>;

			trips {
				cpu_big_passive: cpu-big-passive {
					temperature = <75000>;
					hysteresis = <2000>;
					type = "passive";
				};

				cpu_big_hot: cpu-big-hot {
					temperature = <85000>;
					hysteresis = <2000>;
					type = "passive";
				};

				cpu_big_crit: cpu-big-crit {
					temperature = <105000>;
					hysteresis = <0>;
					type = "critical";
				};
			};
		};

		gpu_thermal: gpu-thermal {
			polling-delay-passive = <0>;
			polling-delay = <0>;
			thermal-sensors = <&ths 2>;

			trips {
				gpu_crit: gpu-crit {
					temperature = <105000>;
					hysteresis = <0>;
					type = "critical";
				};
			};
		};

		npu_thermal: npu-thermal {
			polling-delay-passive = <0>;
			polling-delay = <0>;
			thermal-sensors = <&ths 3>;

			trips {
				npu_crit: npu-crit {
					temperature = <105000>;
					hysteresis = <0>;
					type = "critical";
				};
			};
		};

		ddr_thermal: ddr-thermal {
			polling-delay-passive = <0>;
			polling-delay = <0>;
			thermal-sensors = <&ths 4>;

			trips {
				ddr_crit: ddr-crit {
					temperature = <105000>;
					hysteresis = <0>;
					type = "critical";
				};
			};
		};
	};
};
