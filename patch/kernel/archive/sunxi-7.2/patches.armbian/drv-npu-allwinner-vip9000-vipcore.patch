+vip_status_e show_memory_mapping(
+    vipdrv_video_mem_handle_t *ptr,
+    void *m,
+    vip_uint32_t index,
+    vip_bool_e is_heap_alloc,
+    loff_t *len,
+    loff_t offset
+    )
+{
+    vip_uint32_t iter = 0;
+    vip_char_t *alloc_type = VIP_NULL;
+    vipdrv_mem_mapping_profile_t *memory_mapping = VIP_NULL;
