+    allocator->name = name;
+    allocator->alctor_type = type;
+    allocator->device_vis = ~(vip_uint64_t)0;
+    allocator->callback.allocate = vipdrv_alloc_heap_reserved;
+    allocator->callback.free = vipdrv_free_heap_reserved;
+    allocator->callback.map_kernel_logical = vipdrv_kernel_logical_map_reserved;
+    allocator->callback.unmap_kernel_logical = vipdrv_kernel_logical_unmap_reserved;
+    allocator->callback.map_user_logical = vipdrv_user_logical_map_reserved;
+    allocator->callback.unmap_user_logical = vipdrv_user_logical_unmap_reserved;
