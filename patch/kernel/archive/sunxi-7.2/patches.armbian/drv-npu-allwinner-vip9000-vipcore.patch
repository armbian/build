+/*
+* @brief turn off the VIP clock.
+* */
+static vip_status_e npu_clk_uninit(void)
+{
+	/* Do NOT assert resets or disable clocks on idle to prevent wiping internal VIP9000 registers */
+	return VIP_SUCCESS;
+}
