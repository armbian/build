+vip_char_t* page_str(
+    vipdrv_mem_flag_e mem_flag
+    )
+{
+    switch (mem_flag & VIPDRV_MEM_FLAG_CONTIGUOUS) {
+    case VIPDRV_MEM_FLAG_16M_CONTIGUOUS: return "16M";
+    case VIPDRV_MEM_FLAG_1M_CONTIGUOUS: return "1M";
+    case VIPDRV_MEM_FLAG_64K_CONTIGUOUS: return "64K";
+    default:
+        return "None";
+    }
+}
+
+vip_uint32_t get_page_shift(
+    vipdrv_mem_flag_e mem_flag
+    )
+{
+    switch (mem_flag & VIPDRV_MEM_FLAG_CONTIGUOUS) {
+    case VIPDRV_MEM_FLAG_16M_CONTIGUOUS: return 24;
+    case VIPDRV_MEM_FLAG_1M_CONTIGUOUS: return 20;
+    case VIPDRV_MEM_FLAG_64K_CONTIGUOUS: return 16;
+    default:
+        return 0;
+    }
+}
