+static vip_status_e mmu_map_mmu_flush(
+    vipdrv_mmu_info_t* mmu_info
+    )
+{
+    vip_status_e status = VIP_SUCCESS;
+    vipdrv_context_t* context = (vipdrv_context_t*)vipdrv_get_context(VIPDRV_CONTEXT_PROP_ALL);
