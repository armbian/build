+    allocator->callback.phy_vip2cpu = vipdrv_drv_get_cpuphysical;
+    allocator->callback.phy_cpu2vip = vipdrv_drv_get_vipphysical;
+
+    return VIP_SUCCESS;
+}
+#endif
