+++ b/drivers/soc/sunxi/Makefile
@@ -1,3 +1,4 @@
 # SPDX-License-Identifier: GPL-2.0-only
 obj-$(CONFIG_SUNXI_MBUS) +=	sunxi_mbus.o
 obj-$(CONFIG_SUNXI_SRAM) +=	sunxi_sram.o
+obj-$(CONFIG_ALLWINNER_VIPCORE) += vipcore/
diff --git a/drivers/soc/sunxi/vipcore/Kconfig b/drivers/soc/sunxi/vipcore/Kconfig
new file mode 100644
index 000000000000..1b84f4cc02e3
--- /dev/null
+++ b/drivers/soc/sunxi/vipcore/Kconfig
@@ -0,0 +1,7 @@
+# SPDX-License-Identifier: GPL-2.0-only
+config ALLWINNER_VIPCORE
+	tristate "Allwinner VIP9000 NPU Core Driver"
+	depends on ARCH_SUNXI
+	help
+	  Enable support for the VeriSilicon VIP9000 Neural Processing Unit (NPU)
+	  found in Allwinner A733 / sun60iw2 SoCs.
