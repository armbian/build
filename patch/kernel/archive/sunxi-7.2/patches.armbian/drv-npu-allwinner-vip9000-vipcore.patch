+*/
+vip_status_e vipdrv_hw_destroy(void);
+
+/*
+@brief To run any initial commands once in the beginning.
+*/
+vip_status_e vipdrv_hw_submit_initcmd(
+    vipdrv_hardware_t* hardware
+    );
+
+/*
+@ brief
