+#define PRINTK_I(...)
+#define PRINTK_W(...)    vipdrv_os_print(VIP_LOG_WARN, __VA_ARGS__)
+#define PRINTK_E(...)    vipdrv_os_print(VIP_LOG_ERROR, __VA_ARGS__)
+#elif (vpmdENABLE_DEBUG_LOG == 1)
