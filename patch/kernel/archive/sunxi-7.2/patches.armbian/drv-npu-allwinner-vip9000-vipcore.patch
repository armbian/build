+    VIPDRV_TASK_DIS_PROFILE_SHOW  = 1,
+    VIPDRV_TASK_DIS_PROFILE_RESET = 2,
+    VIPDRV_TASK_DIS_PROFILE_MAX,
+} vipdrv_task_dispatch_profile_e;
