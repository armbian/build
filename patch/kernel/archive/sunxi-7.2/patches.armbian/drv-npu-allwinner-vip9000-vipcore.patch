+    vip_physical_t(*phy_vip2cpu)(vip_physical_t);
+    vip_physical_t(*phy_cpu2vip)(vip_physical_t);
+} vipdrv_videomem_heap_ops_t;
+
+typedef struct _vipdrv_videomem_heap_info {
+    vip_physical_t             vip_physical;
+    vip_size_t                 vip_memsize;
