+++ b/Documentation/devicetree/bindings/mailbox/allwinner,sun55i-a523-msgbox.yaml
@@ -0,0 +1,91 @@
+# SPDX-License-Identifier: GPL-2.0
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/mailbox/allwinner,sun55i-a523-msgbox.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Allwinner sun55i (T527/A523) Message Box
+
+maintainers:
+  - Juan Sanchez Fuentes <juanesf91@gmail.com>
+
+description: |
+  The hardware message box on sun55i SoCs (T527/A523) is a four-user mailbox
+  controller containing 12 unidirectional FIFOs shared between the ARM, CPUS,
+  DSP and RV (E906) processors. Each user has its own register block. An
+  interrupt is raised for received messages, but software must poll to know
+  when a transmitted message has been acknowledged by the remote user. Each
+  FIFO can hold fifteen 32-bit messages; when a FIFO is full, clients must
+  wait before attempting more transmissions.
+
+  Refer to ./mailbox.txt for generic information about mailbox device-tree
+  bindings.
+
+properties:
+  compatible:
+    oneOf:
+      - items:
+          - enum:
+              - allwinner,sun55i-a523-msgbox
+          - const: allwinner,sun55iw3-msgbox
+      - const: allwinner,sun55i-a523-msgbox
+      - const: allwinner,sun55iw3-msgbox
+
+  reg:
+    maxItems: 4
+    description: one register block per mailbox user
+
+  reg-names:
+    items:
+      - const: arm
+      - const: cpus
+      - const: dsp
+      - const: rv
+
+  clocks:
+    maxItems: 1
+    description: bus clock
+
+  resets:
+    maxItems: 1
+    description: bus reset
+
+  interrupts:
+    maxItems: 1
+    description: interrupt for the local (ARM) block
+
+  '#mbox-cells':
+    const: 1
+    description: first cell is the channel number (0-11)
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - clocks
+  - resets
+  - '#mbox-cells'
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/sun55i-a523-ccu.h>
+    #include <dt-bindings/interrupt-controller/arm-gic.h>
+    #include <dt-bindings/reset/sun55i-a523-ccu.h>
+
+    msgbox: mailbox@3003000 {
+        compatible = "allwinner,sun55i-a523-msgbox",
+                     "allwinner,sun55iw3-msgbox";
+        reg = <0x03003000 0x1000>,
+              <0x07120000 0x1000>,
+              <0x07094000 0x1000>,
+              <0x07136000 0x1000>;
+        reg-names = "arm", "cpus", "dsp", "rv";
+        clocks = <&ccu CLK_BUS_MSGBOX>;
+        resets = <&ccu RST_BUS_MSGBOX>;
+        interrupts = <GIC_SPI 0 IRQ_TYPE_LEVEL_HIGH>;
+        #mbox-cells = <1>;
+    };
+
+...
