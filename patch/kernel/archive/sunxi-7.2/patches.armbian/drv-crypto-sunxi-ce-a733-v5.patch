--- /dev/null
+++ b/drivers/crypto/allwinner/sunxi-ce/sunxi_ce_proc_comm.c
@@ -0,0 +1,494 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Copyright(c) 2020 - 2023 Allwinner Technology Co.,Ltd. All rights reserved. */
