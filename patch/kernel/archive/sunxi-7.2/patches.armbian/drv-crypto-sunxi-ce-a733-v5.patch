+#if IS_ENABLED(CONFIG_AW_HWRNG_DRIVER)
+int sunxi_register_hwrng(sunxi_ce_cdev_t *ce_dev);
+void sunxi_unregister_hwrng(sunxi_ce_cdev_t *ce_dev);
+#endif
+
+#endif /* end of _SUNXI_CE_CDEV_H_ */
