+u32 ss_hash_start(ss_hash_ctx_t *ctx, ss_aes_req_ctx_t *req_ctx, u32 len, u32 last)
+{
+	int ret = 0;
+	int flow = 2;
+	u32 blk_size = ss_hash_blk_size(req_ctx->type);
+	char *digest = NULL;
+	dma_addr_t ptask_dma = 0;
+	dma_addr_t digest_dma = 0;
+	dma_addr_t md_dma = 0;
+	dma_addr_t key_dma = 0;
+	ce_new_task_desc_t *task = NULL;
+#ifdef SS_TOTAL_DATALEN_ENABLE
+	u64 total_data_len;
+#endif
+
+	/* Total len is too small, so process it in the padding data later. */
+	if ((last == 0) && (len > 0) && (len < blk_size)) {
+		ctx->cnt += len;
+		return 0;
+	}
+
+	digest = kzalloc(SHA512_DIGEST_SIZE, GFP_KERNEL);
+	if (digest == NULL) {
+		SS_ERR("Failed to kmalloc(%d)\n", SHA512_DIGEST_SIZE);
+		return -ENOMEM;
+	}
+
+	task = dma_pool_zalloc(ss_dev->task_pool, GFP_KERNEL, &ptask_dma);
+	if (!task) {
+		SS_ERR("dma_pool_zalloc task failed\n");
+		kfree(digest);
+		return -ENOMEM;
+	}
+
+	ss_new_task_desc_init(task, flow);
+	task->task_phy_addr = ptask_dma;
+
+	ss_pending_clear(flow);
+	ss_irq_enable(flow);
+
+	if (req_ctx->type == SS_METHOD_HMAC_SHA1)
+		ss_hmac_method_set(SS_METHOD_SHA1, task);
+	else if (req_ctx->type == SS_METHOD_HMAC_SHA256)
+		ss_hmac_method_set(SS_METHOD_SHA256, task);
+	else
+		ss_hash_method_set(req_ctx->type, task);
+
+	SS_DBG("Flow: %d, Dir: %d, Method: %d, Mode: %d, len: %d / %d\n", flow,
+			req_ctx->dir, req_ctx->type, req_ctx->mode, len, ctx->cnt);
+	SS_DBG("IV address = 0x%px, size = %d\n", ctx->md, ctx->md_size);
+
+	md_dma = dma_map_single(&ss_dev->pdev->dev, ctx->md, ctx->md_size, DMA_TO_DEVICE);
+	ce_task_addr_set(NULL, md_dma, task->iv_addr);
+
+	if (ctx->npackets++)
+		ss_hash_iv_mode_set(1, task);
+
+#ifdef SS_HMAC_ENABLE
+	if (CE_METHOD_IS_HMAC(req_ctx->type)) {
+		/* hamc_hash set key operation same as rng */
+		ss_rng_key_set(ctx->key, ctx->key_size, task);
+		key_dma = dma_map_single(&ss_dev->pdev->dev, ctx->key, ctx->key_size, DMA_TO_DEVICE);
+		ce_task_addr_set(NULL, key_dma, task->key_addr);
+		ctx->comm.flags &= ~SS_FLAG_NEW_KEY;
+	}
+#endif
+
+	if (last == 1) {
+		ss_hmac_sha1_last(task);
+		ss_hash_data_len_set(ctx->tail_len * 8, task);/*bits*/
+	} else {
+#ifdef SS_LPKG_KEEP_ON
+		/* Multi-sg mode is enabled, this bit should allways be fixed to 1 in CE V3.x */
+		ss_hmac_sha1_last(task);
+#endif
+		ss_hash_data_len_set(((len - (len % blk_size)) * 8), task);
+#ifdef SS_TOTAL_DATALEN_ENABLE
+		SS_DBG("ssd cnt is %d\n", ctx->cnt);
+		/* muilt_packets hash should config total_datalen */
+		total_data_len = ctx->cnt * 8;
+		ss_hash_total_data_len_set(total_data_len, task);
+#endif
+	}
+
+	/* Prepare the src scatterlist */
+	req_ctx->dma_src.nents = ss_sg_cnt(req_ctx->dma_src.sg, len);
+	dma_map_sg(&ss_dev->pdev->dev, req_ctx->dma_src.sg, req_ctx->dma_src.nents, DMA_TO_DEVICE);
+	ss_sg_config(task->ce_sg, &req_ctx->dma_src, req_ctx->type, 0, len % blk_size, 1, SRC_FLAG);
+
+#ifdef SS_HASH_HW_PADDING
+	if (last == 1) {
+		task->ce_sg[0].src_len = ctx->tail_len; /* byte */
+		SS_DBG("cnt %d, tail_len %d.\n", ctx->cnt, ctx->tail_len);
+#ifdef SS_TOTAL_DATALEN_ENABLE
+		/* muilt_packets hash should config total_datalen */
+		total_data_len = ctx->cnt * 8;
+		ss_hash_total_data_len_set(total_data_len, task);
+#else
+		ss_hash_data_len_set(ctx->cnt * 8, task); /* bits */
+#endif
+	}
+#endif
+
+	/* Prepare the dst scatterlist */
+	digest_dma = dma_map_single(&ss_dev->pdev->dev, digest, SHA512_DIGEST_SIZE, DMA_FROM_DEVICE);
+	ce_task_addr_set(NULL, digest_dma, task->ce_sg[0].dst_addr);
+	task->ce_sg[0].dst_len = ctx->md_size;
+
+	if (last == 1) {
+		ctx->npackets = 0;  /* restart count npackets */
+		if (req_ctx->type == SS_METHOD_SHA224)
+			task->ce_sg[0].dst_len  = SHA224_DIGEST_SIZE;
+		if (req_ctx->type == SS_METHOD_SHA384)
+			task->ce_sg[0].dst_len  = SHA384_DIGEST_SIZE;
+	}
+
+	ce_print_new_task_desc(task);
+
+	/* Start CE controller. */
+	init_completion(&ss_dev->flows[flow].done);
+
+	SS_DBG("Before CE, COMM_CTL: 0x%08x, ICR: 0x%08x\n", task->comm_ctl, ss_reg_rd(CE_REG_ICR));
+	ss_hash_rng_ctrl_start(task);
+
+	ret = wait_for_completion_timeout(&ss_dev->flows[flow].done, msecs_to_jiffies(SS_WAIT_TIME));
+	if (ret == 0) {
+		SS_ERR("Timed out! ISR: 0x%08x, ICR: 0x%08x, ERR: 0x%08x, TSR: 0x%08x\n",
+		       ss_reg_rd(CE_REG_ISR), ss_reg_rd(CE_REG_ICR),
+		       ss_reg_rd(CE_REG_ERR), ss_reg_rd(CE_REG_TSR));
+		ss_reset();
+		ret = -ETIMEDOUT;
+	}
+	ss_irq_disable(flow);
+	ss_ctrl_stop();
+
+	dma_unmap_single(&ss_dev->pdev->dev, digest_dma, SHA512_DIGEST_SIZE, DMA_FROM_DEVICE);
+	dma_unmap_sg(&ss_dev->pdev->dev, req_ctx->dma_src.sg, req_ctx->dma_src.nents, DMA_TO_DEVICE);
+	if (key_dma)
+		dma_unmap_single(&ss_dev->pdev->dev, key_dma, ctx->key_size, DMA_TO_DEVICE);
+	dma_unmap_single(&ss_dev->pdev->dev, md_dma, ctx->md_size, DMA_TO_DEVICE);
+	dma_pool_free(ss_dev->task_pool, task, ptask_dma);
+
+#ifdef SS_HASH_HW_PADDING
+	if (last == 1) {
+		ctx->cnt >>= 3;
+	}
+#endif
+
+	SS_DBG("After CE, TSR: 0x%08x, ERR: 0x%08x\n", ss_reg_rd(CE_REG_TSR), ss_reg_rd(CE_REG_ERR));
+	SS_DBG("After CE, dst data:\n");
+	ss_print_hex(digest, SHA512_DIGEST_SIZE, digest);
+
+	if (ss_flow_err(flow)) {
+		SS_ERR("CE return error: %d\n", ss_flow_err(flow));
+		ss_pending_clear(flow);
+		ss_ctrl_stop();
+		kfree(digest);
+		return -EINVAL;
+	}
+
+	/* Backup the MD to ctx->md. */
+	memcpy(ctx->md, digest, ctx->md_size);
+
+	if (last == 0)
+		ctx->cnt += len;
+	kfree(digest);
+	return ret < 0 ? ret : 0;
+}
+
+void ss_load_iv(ss_aes_ctx_t *ctx, ss_aes_req_ctx_t *req_ctx,
+	char *buf, int size)
+{
+	if (buf == NULL)
+		return;
+
+	/* Only AES/DES/3DES-ECB don't need IV. */
+	if (CE_METHOD_IS_AES(req_ctx->type) &&
+		(req_ctx->mode == SS_AES_MODE_ECB))
+		return;
+
+	/* CBC/CTS/GCM need update the IV eachtime. */
+	if ((ctx->cnt == 0)
+		|| (CE_IS_AES_MODE(req_ctx->type, req_ctx->mode, CBC))
+		|| (CE_IS_AES_MODE(req_ctx->type, req_ctx->mode, CTS))
+		|| (CE_IS_AES_MODE(req_ctx->type, req_ctx->mode, GCM))
+		|| (CE_IS_AES_MODE(req_ctx->type, req_ctx->mode, XTS))) {
+		SS_DBG("IV address = 0x%px, size = %d\n", buf, size);
+		ctx->iv_size = size;
+		memcpy(ctx->iv, buf, ctx->iv_size);
+	}
+
+	SS_DBG("The current IV:\n");
+	ss_print_hex(ctx->iv, ctx->iv_size, ctx->iv);
+}
+
+void ss_aead_load_iv(ss_aead_ctx_t *ctx, ss_aes_req_ctx_t *req_ctx,
+	char *buf, int size)
+{
+	if (buf == NULL)
+		return;
+
+	/* CBC/CTS/GCM need update the IV eachtime. */
+	if ((ctx->cnt == 0)
+		|| (CE_IS_AES_MODE(req_ctx->type, req_ctx->mode, GCM))) {
+		SS_DBG("IV address = 0x%px, size = %d\n", buf, size);
+		ctx->iv_size = size;
+		memcpy(ctx->iv, buf, ctx->iv_size);
+	}
+
+	SS_DBG("The current IV:\n");
+	ss_print_hex(ctx->iv, ctx->iv_size, ctx->iv);
+}
+
+int ss_aead_one_req(sunxi_ce_cdev_t *sss, struct aead_request *req)
+{
+	int ret = 0;
+	struct crypto_aead *tfm = NULL;
+	ss_aead_ctx_t *ctx = NULL;
+	ss_aes_req_ctx_t *req_ctx = NULL;
+
+	SS_ENTER();
+	if (!req->src || !req->dst) {
+		SS_ERR("Invalid sg: src = 0x%px, dst = 0x%px\n", req->src, req->dst);
+		return -EINVAL;
+	}
+
+	ss_dev_lock();
+
+	tfm = crypto_aead_reqtfm(req);
+	req_ctx = aead_request_ctx(req);
+	ctx = crypto_aead_ctx(tfm);
+
+	ss_aead_load_iv(ctx, req_ctx, req->iv, crypto_aead_ivsize(tfm));
+
+	memset(ctx->task_ctr, 0, sizeof(ctx->task_ctr));
+	ctx->tag_len = tfm->authsize;
+	ctx->assoclen = req->assoclen;
+	ctx->cryptlen = req->cryptlen;
+
+	req_ctx->dma_src.sg = req->src;
+	req_ctx->dma_dst.sg = req->dst;
+
+	ret = ss_aead_start(ctx, req_ctx);
+	if (ret < 0)
+		SS_ERR("ss_aes_start fail(%d)\n", ret);
+
+	ss_dev_unlock();
+
+	return ret;
+}
+
+int ss_aes_one_req(sunxi_ce_cdev_t *sss, struct skcipher_request *req)
+{
+	int ret = 0;
+	struct crypto_skcipher *tfm = NULL;
+	ss_aes_ctx_t *ctx = NULL;
+	ss_aes_req_ctx_t *req_ctx = NULL;
+
+	SS_ENTER();
+	if (!req->src || !req->dst) {
+		SS_ERR("Invalid sg: src = 0x%px, dst = 0x%px\n", req->src, req->dst);
+		return -EINVAL;
+	}
+
+	ss_dev_lock();
+
+	tfm = crypto_skcipher_reqtfm(req);
+	req_ctx = skcipher_request_ctx(req);
+	ctx = crypto_skcipher_ctx(tfm);
+
+	ss_load_iv(ctx, req_ctx, req->iv, crypto_skcipher_ivsize(tfm));
+
+	req_ctx->dma_src.sg = req->src;
+	req_ctx->dma_dst.sg = req->dst;
+
+#ifdef SS_RSA_PREPROCESS_ENABLE
+	ss_rsa_preprocess(ctx, req_ctx, req->cryptlen);
+#endif
+
+	ret = ss_aes_start(ctx, req_ctx, req->cryptlen);
+	if (ret < 0)
+		SS_ERR("ss_aes_start fail(%d)\n", ret);
+
+	ss_dev_unlock();
+
+#ifdef SS_CTR_MODE_ENABLE
+	if (req_ctx->mode == SS_AES_MODE_CTR) {
+		SS_DBG("CNT: %08x %08x %08x %08x\n",
+			*(int *)&ctx->iv[0], *(int *)&ctx->iv[4],
+			*(int *)&ctx->iv[8], *(int *)&ctx->iv[12]);
+	}
+#endif
+
+	ctx->cnt += req->cryptlen;
+	return ret;
+}
+
+irqreturn_t sunxi_ss_irq_handler(int irq, void *dev_id)
+{
+	int i;
+	int pending = 0;
+	sunxi_ce_cdev_t *sss = (sunxi_ce_cdev_t *)dev_id;
+
+	pending = ss_pending_get();
+	SS_DBG("pending: %#x\n", pending);
+	for (i = 0; i < SS_FLOW_NUM; i++) {
+		if (pending & (CE_CHAN_PENDING << (2 * i))) {
+			SS_DBG("Chan %d completed. pending: %#x\n", i, pending);
+			ss_pending_clear(i);
+			complete(&sss->flows[i].done);
+		}
+	}
+
+	return IRQ_HANDLED;
+}
+
+int ce_trng_get_random(u8 *buf, u32 rng_len, u32 flag)
+{
+	int ret = 0;
+	int flow = 2;
+	dma_addr_t ptask = 0;
+	ce_new_task_desc_t *task = NULL;
+	dma_addr_t dma_dst;
+
+	if (!buf || !rng_len) {
+		SS_ERR("input is NULL\n");
+		return -1;
+	}
+
+	ss_dev_lock();
+
+	task = dma_pool_alloc(ss_dev->task_pool, GFP_KERNEL, &ptask);
+	if (!task) {
+		SS_ERR("dma_pool_alloc fail\n");
+		ss_dev_unlock();
+		return -2;
+	}
+
+	ss_new_task_desc_init(task, flow);
+	task->task_phy_addr = ptask;
+
+	ss_rng_method_set(SS_METHOD_SHA256, SS_METHOD_TRNG, task);
+
+	dma_dst = dma_map_single(&ss_dev->pdev->dev, buf, rng_len, DMA_FROM_DEVICE);
+	if (dma_mapping_error(&ss_dev->pdev->dev, dma_dst)) {
+		SS_ERR("dma_map_single fail\n");
+		dma_pool_free(ss_dev->task_pool, task, ptask);
+		ss_dev_unlock();
+		return -EFAULT;
+	}
+
+	/* Prepare the dst scatterlist */
+	ce_task_addr_set(NULL, dma_dst, task->ce_sg[0].dst_addr);
+	task->ce_sg[0].dst_len = rng_len;
+
+	SS_DBG("Flow: %d, Request: %d, ptask: %pad, dma_dst: %pad\n",
+	       flow, rng_len, &ptask, &dma_dst);
+
+	ce_print_new_task_desc(task);
+
+	/* Start CE controller. */
+	init_completion(&ss_dev->flows[flow].done);
+
+	SS_DBG("Before CE, COMM_CTL: 0x%08x, ICR: 0x%08x, ISR: 0x%08x\n",
+		task->comm_ctl, ss_reg_rd(CE_REG_ICR), ss_reg_rd(CE_REG_ISR));
+
+	ss_pending_clear(flow);
+	ss_irq_enable(flow);
+	wmb();
+	ss_hash_rng_ctrl_start(task);
+
+	ret = wait_for_completion_timeout(&ss_dev->flows[flow].done,
+		msecs_to_jiffies(SS_WAIT_TIME));
+	if (ret == 0) {
+		SS_ERR("Timed out! ISR: 0x%08x, ICR: 0x%08x, ERR: 0x%08x, TSR: 0x%08x\n",
+		       ss_reg_rd(CE_REG_ISR), ss_reg_rd(CE_REG_ICR),
+		       ss_reg_rd(CE_REG_ERR), ss_reg_rd(CE_REG_TSR));
+		ss_irq_disable(flow);
+		ss_ctrl_stop();
+		dma_pool_free(ss_dev->task_pool, task, ptask);
+		dma_unmap_single(&ss_dev->pdev->dev, dma_dst, rng_len, DMA_FROM_DEVICE);
+		ss_reset();
+		ss_dev_unlock();
+		return -ETIMEDOUT;
+	}
+	SS_DBG("After CE, TSR: 0x%08x, ERR: 0x%08x, ISR: 0x%08x\n",
+		ss_reg_rd(CE_REG_TSR), ss_reg_rd(CE_REG_ERR), ss_reg_rd(CE_REG_ISR));
+
+	dma_unmap_single(&ss_dev->pdev->dev, dma_dst, rng_len, DMA_FROM_DEVICE);
+	dma_pool_free(ss_dev->task_pool, task, ptask);
+	ss_irq_disable(flow);
+	ss_ctrl_stop();
+
+	if (ss_flow_err(flow)) {
+		SS_ERR("TRNG CE return error: %d\n", ss_flow_err(flow));
+		ss_pending_clear(flow);
+		ss_dev_unlock();
+		return -EINVAL;
+	}
+
+	ss_dev_unlock();
+	return 0;
+}
