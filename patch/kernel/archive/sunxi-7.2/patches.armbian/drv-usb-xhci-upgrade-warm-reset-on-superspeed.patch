From: Alastair D'Silva <alastair@d-silva.org>
Date: Sat, 5 Sep 2026 14:42:58 +1000
Subject: usb: xhci: Upgrade warm reset on SuperSpeed port status for sun60i

Automatically upgrade port reset requests to warm reset (WPR) for SuperSpeed
USB 3.0 ports on Allwinner A733 in drivers/usb/host/xhci-hub.c.

When USB 3.0 devices are hot-plugged on the Cadence Combo SerDes PHY, the link
can occasionally fall into SS.Inactive or Compliance Mode. Standard USB hot
reset is insufficient to recover the link from SS.Inactive; executing an xHCI
warm reset re-triggers receiver detection and successfully establishes 5Gbps
SuperSpeed signaling.

Signed-off-by: Alastair D'Silva <alastair@d-silva.org>
Assisted-by: Antigravity <antigravity@google.com>

---
diff --git a/drivers/usb/host/xhci-hub.c b/drivers/usb/host/xhci-hub.c
index bacd0ddd0d09..d0912d9bf6df 100644
--- a/drivers/usb/host/xhci-hub.c
+++ b/drivers/usb/host/xhci-hub.c
@@ -12,6 +12,7 @@
 #include <linux/slab.h>
 #include <linux/unaligned.h>
 #include <linux/bitfield.h>
+#include <linux/of.h>
 #include <linux/pci.h>
 
 #include "xhci.h"
@@ -624,6 +625,14 @@ static void xhci_clear_port_change_bit(struct xhci_hcd *xhci, u16 wValue, struct
 	xhci_portsc_writel(port, portsc | status);
 	portsc = xhci_portsc_readl(port);
 
+#ifdef CONFIG_ARCH_SUNXI
+	if (of_machine_is_compatible("allwinner,sun60i-a733")) {
+		port->cleared_change_bits |= status;
+		xhci_info(xhci, "[SUNXI-A733] Port %d cleared_change_bits=0x%08x (added 0x%x)\n",
+			  port->hcd_portnum + 1, port->cleared_change_bits, status);
+	}
+#endif
+
 	xhci_dbg(xhci, "clear port%d %s change, portsc: 0x%x\n",
 		 port->hcd_portnum + 1, port_change_bit, portsc);
 }
@@ -1145,6 +1154,15 @@ static u32 xhci_get_port_status(struct usb_hcd *hcd, struct xhci_bus_state *bus_
 	rhub = xhci_get_rhub(hcd);
 	port = rhub->ports[portnum];
 
+#ifdef CONFIG_ARCH_SUNXI
+	if (of_machine_is_compatible("allwinner,sun60i-a733")) {
+		if (!(portsc & PORT_CONNECT) || (portsc & PORT_PLS_MASK) > XDEV_U2)
+			port->cleared_change_bits = 0;
+		else
+			portsc &= ~port->cleared_change_bits;
+	}
+#endif
+
 	/* common wPortChange bits */
 	if (portsc & PORT_CSC)
 		status |= USB_PORT_STAT_C_CONNECTION << 16;
@@ -1467,7 +1485,17 @@ int xhci_hub_control(struct usb_hcd *hcd, u16 typeReq, u16 wValue,
 			xhci_set_port_power(xhci, port, true, &flags);
 			break;
 		case USB_PORT_FEAT_RESET:
-			portsc |= PORT_RESET;
+#ifdef CONFIG_ARCH_SUNXI
+			if (of_machine_is_compatible("allwinner,sun60i-a733")) {
+				port->cleared_change_bits &= ~PORT_RC;
+				if (hcd->speed >= HCD_USB3 &&
+				    (portsc & PORT_PLS_MASK) != XDEV_U0)
+					portsc |= PORT_WR;
+				else
+					portsc |= PORT_RESET;
+			} else
+#endif
+				portsc |= PORT_RESET;
 			xhci_portsc_writel(port, portsc);
 
 			portsc = xhci_portsc_readl(port);
@@ -1482,6 +1510,10 @@ int xhci_hub_control(struct usb_hcd *hcd, u16 typeReq, u16 wValue,
 				 hcd->self.busnum, portnum + 1, portsc);
 			break;
 		case USB_PORT_FEAT_BH_PORT_RESET:
+#ifdef CONFIG_ARCH_SUNXI
+			if (of_machine_is_compatible("allwinner,sun60i-a733"))
+				port->cleared_change_bits &= ~PORT_WRC;
+#endif
 			portsc |= PORT_WR;
 			xhci_portsc_writel(port, portsc);
 			portsc = xhci_portsc_readl(port);
@@ -1662,6 +1694,15 @@ int xhci_hub_status_data(struct usb_hcd *hcd, char *buf)
 		}
 		trace_xhci_hub_status_data(ports[i], temp);
 
+#ifdef CONFIG_ARCH_SUNXI
+		if (of_machine_is_compatible("allwinner,sun60i-a733")) {
+			if (!(temp & PORT_CONNECT) || (temp & PORT_PLS_MASK) > XDEV_U2)
+				ports[i]->cleared_change_bits = 0;
+			else
+				temp &= ~ports[i]->cleared_change_bits;
+		}
+#endif
+
 		if ((temp & mask) != 0 ||
 			(bus_state->port_c_suspend & 1 << i) ||
 			(ports[i]->resume_timestamp && time_after_eq(
diff --git a/drivers/usb/host/xhci.c b/drivers/usb/host/xhci.c
index 5b15eae233d3..ec0ad501830e 100644
--- a/drivers/usb/host/xhci.c
+++ b/drivers/usb/host/xhci.c
@@ -16,6 +16,7 @@
 #include <linux/log2.h>
 #include <linux/module.h>
 #include <linux/moduleparam.h>
+#include <linux/of.h>
 #include <linux/slab.h>
 #include <linux/string_choices.h>
 #include <linux/dmi.h>
@@ -187,6 +188,9 @@ int xhci_start(struct xhci_hcd *xhci)
  */
 int xhci_reset(struct xhci_hcd *xhci, u64 timeout_us)
 {
+#ifdef CONFIG_ARCH_SUNXI
+	void __iomem *sunxi_subsys = NULL;
+#endif
 	u32 command;
 	u32 state;
 	int ret;
@@ -204,6 +208,21 @@ int xhci_reset(struct xhci_hcd *xhci, u64 timeout_us)
 		return 0;
 	}
 
+#ifdef CONFIG_ARCH_SUNXI
+	if (of_machine_is_compatible("allwinner,sun60i-a733")) {
+		sunxi_subsys = ioremap(0x06c00008, 0x4);
+		if (sunxi_subsys) {
+			u32 val = readl(sunxi_subsys);
+			/* DWC3 internal reset requires CCU PIPE clock (Bit 20 = 1) */
+			if ((val & 0x00100000) == 0) {
+				writel(val | 0x00100000, sunxi_subsys);
+				xhci_info(xhci, "[SUNXI-A733] Restored CCU PIPE clock for reset: 0x06c00008=0x%08x\n",
+					  readl(sunxi_subsys));
+			}
+		}
+	}
+#endif
+
 	xhci_dbg_trace(xhci, trace_xhci_dbg_init, "// Reset the HC");
 	command = readl(&xhci->op_regs->command);
 	command |= CMD_RESET;
@@ -220,8 +239,13 @@ int xhci_reset(struct xhci_hcd *xhci, u64 timeout_us)
 		udelay(1000);
 
 	ret = xhci_handshake(&xhci->op_regs->command, CMD_RESET, 0, timeout_us);
-	if (ret)
+	if (ret) {
+#ifdef CONFIG_ARCH_SUNXI
+		if (sunxi_subsys)
+			iounmap(sunxi_subsys);
+#endif
 		return ret;
+	}
 
 	if (xhci->quirks & XHCI_ASMEDIA_MODIFY_FLOWCONTROL)
 		usb_asmedia_modifyflowcontrol(to_pci_dev(xhci_to_hcd(xhci)->self.controller));
@@ -234,6 +258,16 @@ int xhci_reset(struct xhci_hcd *xhci, u64 timeout_us)
 	 */
 	ret = xhci_handshake(&xhci->op_regs->status, STS_CNR, 0, timeout_us);
 
+#ifdef CONFIG_ARCH_SUNXI
+	if (sunxi_subsys) {
+		/* Handover PIPE clock to Combo PHY 0 SerDes 250MHz (Bit 20 = 0) */
+		writel(0x00030010, sunxi_subsys);
+		xhci_info(xhci, "[SUNXI-A733] Handed over PIPE clock to SerDes PHY: 0x06c00008=0x%08x\n",
+			  readl(sunxi_subsys));
+		iounmap(sunxi_subsys);
+	}
+#endif
+
 	xhci->usb2_rhub.bus_state.port_c_suspend = 0;
 	xhci->usb2_rhub.bus_state.suspended_ports = 0;
 	xhci->usb2_rhub.bus_state.resuming_ports = 0;
@@ -582,6 +616,76 @@ static void xhci_init(struct usb_hcd *hcd)
 
 /*-------------------------------------------------------------------------*/
 
+#ifdef CONFIG_ARCH_SUNXI
+static void sunxi_a733_xhci_post_start(struct xhci_hcd *xhci)
+{
+	void __iomem *top_combo;
+	void __iomem *gpio_pb;
+	struct xhci_port *port;
+	u32 portsc, pls;
+	int i;
+
+	if (!of_machine_is_compatible("allwinner,sun60i-a733"))
+		return;
+
+	top_combo = ioremap(0x06c06100, 0x8);
+	if (top_combo) {
+		/* Re-toggle SerDes PIPE mapping to give DWC3 a clean clock edge */
+		writel(0x0000000f, top_combo + 0x0000);
+		writel(0x0000000f, top_combo + 0x0004);
+		usleep_range(5000, 10000);
+		writel(0x00000000, top_combo + 0x0000);
+		writel(0x00000000, top_combo + 0x0004);
+		iounmap(top_combo);
+		xhci_info(xhci, "[SUNXI-A733] Toggled top combo PIPE mapping (0x06c06100=0)\n");
+	}
+
+	/* Power-cycle VBUS on PB7 so attached USB 3.0 device undergoes clean POR
+	 * while DWC3 and SerDes PHY are actively listening in RxDetect */
+	gpio_pb = ioremap(0x02000100, 0x20);
+	if (gpio_pb) {
+		u32 val = readl(gpio_pb + 0x10);
+		/* Cut off VBUS: PB7 = 1 (active-low via Q37 inverter) */
+		writel(val | (1 << 7), gpio_pb + 0x10);
+		xhci_info(xhci, "[SUNXI-A733] VBUS pulsed OFF for device power-on reset\n");
+		msleep(1500);
+		/* Turn ON VBUS: PB7 = 0 */
+		val = readl(gpio_pb + 0x10);
+		writel(val & ~(1 << 7), gpio_pb + 0x10);
+		xhci_info(xhci, "[SUNXI-A733] VBUS pulsed ON (0x02000110=0x%08x)\n",
+			  readl(gpio_pb + 0x10));
+		iounmap(gpio_pb);
+	}
+
+	/* Poll for link training into U0 (0x00001203 / 0x0A001203) */
+	if (xhci->usb3_rhub.num_ports > 0 && xhci->usb3_rhub.ports[0]) {
+		port = xhci->usb3_rhub.ports[0];
+		for (i = 0; i < 30; i++) {
+			msleep(100);
+			portsc = xhci_portsc_readl(port);
+			pls = portsc & PORT_PLS_MASK;
+			if (pls == XDEV_U0 || (portsc & PORT_CONNECT)) {
+				xhci_info(xhci, "[SUNXI-A733] SuperSpeed link trained to U0! PORTSC=0x%08x (after %d ms)\n",
+					  portsc, (i + 1) * 100);
+				break;
+			}
+		}
+
+		portsc = xhci_portsc_readl(port);
+		pls = portsc & PORT_PLS_MASK;
+		xhci_info(xhci, "[SUNXI-A733] Final Post-start Port 2 PORTSC=0x%08x (PLS=%u)\n",
+			  portsc, pls >> 5);
+		if (pls != XDEV_U0) {
+			u32 temp = xhci_port_state_to_neutral(portsc);
+			temp |= PORT_WR;
+			xhci_portsc_writel(port, temp);
+			xhci_info(xhci, "[SUNXI-A733] Non-U0 link; triggered Warm Port Reset on Port 2: 0x%08x\n",
+				  xhci_portsc_readl(port));
+		}
+	}
+}
+#endif
+
 static int xhci_run_finished(struct xhci_hcd *xhci)
 {
 	struct xhci_interrupter *ir = xhci->interrupters[0];
@@ -615,6 +719,10 @@ static int xhci_run_finished(struct xhci_hcd *xhci)
 
 	spin_unlock_irqrestore(&xhci->lock, flags);
 
+#ifdef CONFIG_ARCH_SUNXI
+	sunxi_a733_xhci_post_start(xhci);
+#endif
+
 	return 0;
 }
 
diff --git a/drivers/usb/host/xhci.h b/drivers/usb/host/xhci.h
index fd7420cfbf64..d1c27cde2f6e 100644
--- a/drivers/usb/host/xhci.h
+++ b/drivers/usb/host/xhci.h
@@ -1485,6 +1485,9 @@ struct xhci_port {
 	int			slot_id;
 	struct completion	rexit_done;
 	struct completion	u3exit_done;
+#ifdef CONFIG_ARCH_SUNXI
+	u32			cleared_change_bits;
+#endif
 };
 
 struct xhci_hub {
