From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Alastair D'Silva <alastair@d-silva.org>
Date: Tue, 8 Sep 2026 10:00:00 +1000
Subject: Input: sun4i-lradc-keys - Add Allwinner A733 and A523 support

Add of_device_id match table entries for "allwinner,sun60i-a733-lradc"
and "allwinner,sun55i-a523-lradc" using lradc_variant_h616.

Signed-off-by: Alastair D'Silva <alastair@d-silva.org>
Assisted-by: Antigravity <antigravity@google.com>

---
 drivers/input/keyboard/sun4i-lradc-keys.c | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/drivers/input/keyboard/sun4i-lradc-keys.c b/drivers/input/keyboard/sun4i-lradc-keys.c
index 5730f08f82d7..da4ba27100e4 100644
--- a/drivers/input/keyboard/sun4i-lradc-keys.c
+++ b/drivers/input/keyboard/sun4i-lradc-keys.c
@@ -350,5 +350,9 @@ static const struct of_device_id sun4i_lradc_of_match[] = {
 	{ .compatible = "allwinner,sun50i-h616-lradc",
 		.data = &lradc_variant_h616 },
+	{ .compatible = "allwinner,sun55i-a523-lradc",
+		.data = &lradc_variant_h616 },
+	{ .compatible = "allwinner,sun60i-a733-lradc",
+		.data = &lradc_variant_h616 },
 	{ /* sentinel */ }
 };
 MODULE_DEVICE_TABLE(of, sun4i_lradc_of_match);
-- 
Armbian
