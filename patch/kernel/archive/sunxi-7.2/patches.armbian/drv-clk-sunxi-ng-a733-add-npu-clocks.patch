From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Alastair D'Silva <alastair@d-silva.org>
Date: Tue, 8 Sep 2026 10:00:00 +1000
Subject: clk: sunxi-ng: a733: Add VIP9000 NPU clocks and resets

Add clock multiplexer, bus gate, and tripartite reset controls for the
VeriSilicon VIP9000 Neural Processing Unit in ccu-sun60i-a733.c, and export
their IDs in the A733 CCU binding headers.

The VIP9000 NPU on Allwinner A733 uses a three-way reset structure where the
Core execution pipeline (reg 0x1b04, bits 16 and 19), AXI bus interface (bit 17),
and AHB configuration register interface (bit 18) must each be deasserted
independently. Older sunxi CCU drivers exposed only a single reset line; when
only one reset bit was released, the VIP9000 execution core remained in
quiescence, causing immediate synchronous external aborts during MMIO access
and locking up userspace inference.

This patch defines:
- NPU core clock mux (npu_clk) at 0x1b00 referencing &pll_npu_4x_clk.
- NPU bus gate (bus_npu_clk) at 0x1b04 BIT(0).
- Independent resets in sun60i_a733_ccu_resets[]:
  * RST_BUS_NPU_CORE: 0x1b04, BIT(16) | BIT(19)
  * RST_BUS_NPU_AXI:  0x1b04, BIT(17)
  * RST_BUS_NPU_AHB:  0x1b04, BIT(18)

Signed-off-by: Alastair D'Silva <alastair@d-silva.org>
Assisted-by: Antigravity <antigravity@google.com>

---
diff --git a/drivers/clk/sunxi-ng/ccu-sun60i-a733.c b/drivers/clk/sunxi-ng/ccu-sun60i-a733.c
index a1b52a9..f9ba79d 100644
--- a/drivers/clk/sunxi-ng/ccu-sun60i-a733.c
+++ b/drivers/clk/sunxi-ng/ccu-sun60i-a733.c
@@ -495,13 +495,15 @@ static const struct clk_hw *npu_parents[] = {
 	&pll_periph0_480M_clk.common.hw,
 	&pll_periph0_600M_clk.hw,
 	&pll_periph0_800M_clk.common.hw,
-	&pll_npu_2x_clk.hw,
+	&pll_npu_4x_clk.common.hw,
 };
-static SUNXI_CCU_M_HW_WITH_MUX_GATE(npu_clk, "npu", npu_parents, 0x6e0,
+static SUNXI_CCU_M_HW_WITH_MUX_GATE(npu_clk, "npu", npu_parents, 0x1b00,
 				    0, 5,	/* M */
 				    24, 3,	/* mux */
 				    BIT(31),	/* gate */
-				    CLK_SET_RATE_PARENT);
+				    0);
+
+static SUNXI_CCU_GATE_HWS(bus_npu_clk, "bus-npu", ahb_hws, 0x1b04, BIT(0), 0);
 
 static SUNXI_CCU_GATE_HWS(bus_dma_clk, "bus-dma", ahb_hws, 0x704, BIT(0), 0);
 
@@ -1297,6 +1299,7 @@ static struct ccu_common *sun60i_a733_ccu_clks[] = {
 	&ve_clk.common,
 	&bus_ve_clk.common,
 	&npu_clk.common,
+	&bus_npu_clk.common,
 	&bus_dma_clk.common,
 	&bus_msgbox_clk.common,
 	&bus_spinlock_clk.common,
@@ -1618,6 +1621,7 @@ static struct clk_hw_onecell_data sun60i_a733_hw_clks = {
 		[CLK_SERDES_PHY_CFG]	= &serdes_phy_cfg_clk.common.hw,
 		[CLK_PCIE_AXI_SLV]	= &pcie_axi_slv_clk.common.hw,
 		[CLK_PCIE_ITS]		= &pcie_its_clk.common.hw,
+		[CLK_BUS_NPU]		= &bus_npu_clk.common.hw,
 		[CLK_I2S4]		= &i2s4_clk.common.hw,
 		[CLK_BUS_I2S4]		= &bus_i2s4_clk.common.hw,
 	},
@@ -1691,6 +1695,9 @@ static struct ccu_reset_map sun60i_a733_ccu_resets[] = {
 	[RST_PCIE_PCLK]		= { 0x238c, BIT(17) },
 	[RST_PCIE_ITS]		= { 0x1574, BIT(16) },
 	[RST_BUS_SERDES]	= { 0x23c4, BIT(16) },
+	[RST_BUS_NPU_CORE]	= { 0x1b04, BIT(16) | BIT(19) },
+	[RST_BUS_NPU_AXI]	= { 0x1b04, BIT(17) },
+	[RST_BUS_NPU_AHB]	= { 0x1b04, BIT(18) },
 	[RST_BUS_DISPLAY0_TOP]	= { 0xabc, BIT(16) },
 	[RST_BUS_DISPLAY1_TOP]	= { 0xacc, BIT(16) },
 	[RST_BUS_HDMI_MAIN]	= { 0xb1c, BIT(16) },
diff --git a/include/dt-bindings/clock/sun60i-a733-ccu.h b/include/dt-bindings/clock/sun60i-a733-ccu.h
index 4283e86..60efc4f 100644
--- a/include/dt-bindings/clock/sun60i-a733-ccu.h
+++ b/include/dt-bindings/clock/sun60i-a733-ccu.h
@@ -191,6 +191,7 @@
 #define CLK_SERDES_PHY_CFG	181
 #define CLK_PCIE_AXI_SLV	182
 #define CLK_PCIE_ITS		183
+#define CLK_BUS_NPU		184
 
 #define CLK_BUS_I2C6		185
 #define CLK_BUS_I2C7		186
diff --git a/include/dt-bindings/reset/sun60i-a733-ccu.h b/include/dt-bindings/reset/sun60i-a733-ccu.h
index 4a55742..4f6e10b 100644
--- a/include/dt-bindings/reset/sun60i-a733-ccu.h
+++ b/include/dt-bindings/reset/sun60i-a733-ccu.h
@@ -90,6 +90,10 @@
 #define RST_PCIE_ITS		90
 #define RST_BUS_SERDES		91
 
+#define RST_BUS_NPU_CORE	92
+#define RST_BUS_NPU_AXI		93
+#define RST_BUS_NPU_AHB		94
+
 #define RST_BUS_I2C6		95
 #define RST_BUS_I2C7		96
 
