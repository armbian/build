From: Alastair D'Silva <alastair@d-silva.org>
Subject: phy: allwinner: add sun55i-a523-usb-phy compatible and passby burst fix

Add "allwinner,sun55i-a523-usb-phy" compatible support to phy-sun4i-usb.c using
the D1 PHY configuration, and configure AHB passby burst bits in sun4i_usb_phy_passby().

The USB 2.0 PHY on Allwinner A523 and A733 shares register layout with the
Allwinner D1 PHY. Without configuring the AHB passby burst control bits, high-speed
USB 2.0 transfers suffer from AHB bus starvation and buffer underruns, causing
transient device disconnects during sustained I/O.

Signed-off-by: Alastair D'Silva <alastair@d-silva.org>
Assisted-by: Antigravity <antigravity@google.com>

---
 drivers/phy/allwinner/phy-sun4i-usb.c | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/drivers/phy/allwinner/phy-sun4i-usb.c b/drivers/phy/allwinner/phy-sun4i-usb.c
--- a/drivers/phy/allwinner/phy-sun4i-usb.c
+++ b/drivers/phy/allwinner/phy-sun4i-usb.c
@@ -241,5 +241,6 @@ static void sun4i_usb_phy_passby(struct sun4i_usb_phy *phy, int enable)
 	bits = SUNXI_AHB_ICHR8_EN | SUNXI_AHB_INCR4_BURST_EN |
 		SUNXI_AHB_INCRX_ALIGN_EN | SUNXI_ULPI_BYPASS_EN;
+	bits |= BIT(1) | BIT(2); /* AHB_INCR1 and AHB_INCRX burst control */
 
 	/* A83T USB2 is HSIC */
 	if (phy_data->cfg->hsic_index &&
@@ -251,7 +252,7 @@ static void sun4i_usb_phy_passby(struct sun4i_usb_phy *phy, int enable)
 	reg_value = readl(phy->pmu);
 
 	if (enable)
-		reg_value |= bits;
+		reg_value = (reg_value | bits) & ~(BIT(31) | BIT(3));
 	else
 		reg_value &= ~bits;
 
@@ -1113,6 +1114,7 @@ static const struct of_device_id sun4i_usb_phy_of_match[] = {
 	{ .compatible = "allwinner,sun8i-r40-usb-phy", .data = &sun8i_r40_cfg },
 	{ .compatible = "allwinner,sun8i-v3s-usb-phy", .data = &sun8i_v3s_cfg },
 	{ .compatible = "allwinner,sun20i-d1-usb-phy", .data = &sun20i_d1_cfg },
+	{ .compatible = "allwinner,sun55i-a523-usb-phy", .data = &sun20i_d1_cfg },
 	{ .compatible = "allwinner,sun50i-a64-usb-phy",
 	  .data = &sun50i_a64_cfg},
 	{ .compatible = "allwinner,sun50i-h6-usb-phy", .data = &sun50i_h6_cfg },
