From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Juan Sanchez Fuentes <juanesf91@gmail.com>
Date: Sat, 1 Aug 2026 00:00:00 +0000
Subject: arm64: dts: allwinner: sun55i-t527-avaota-a1: Enable SPI LCD

The Avaota A1 has a 1.14" 135x240 ST7789V LCD connected to the R-domain
SPI0 controller (r_spi0), with the data/command, reset and backlight
lines on R_PIO GPIOs:

 - PL10: S-SPI0 CS0
 - PL11: S-SPI0 CLK
 - PL12: S-SPI0 MOSI
 - PL13: DC
 - PL9:  RESET
 - PL8:  BACKLIGHT

The panel is wired so its visible 135x240 area maps to GRAM columns
0-134 and rows 0-239 (no window offset, matching the vendor firmware).
Use the 135x240 native resolution with rotate=90 so the controller
rotates the framebuffer to a 240x135 landscape display.

The r_spi0 controller node already exists in the dtsi and the
allwinner,sun55i-a523-spi compatible is supported by spi-sun6i.
S-SPI0 is mux function 6 on PL10/PL11/PL12.

The mcu_dma controller cannot serve the R-domain SPI0: its
dmaengine_prep_slave_sg call fails with -EINVAL, so every SPI transfer
larger than the FIFO depth aborts. Drop the RX channel (keep only the
TX one) so the spi-sun6i driver keeps can_dma unset and falls back to
PIO, which handles transfers of any size.

Signed-off-by: Juan Sanchez Fuentes <juanesf91@gmail.com>
Assisted-by: opencode:big-pickle
---
 arch/arm64/boot/dts/allwinner/sun55i-t527-avaota-a1.dts | 32 ++++++++++
 1 file changed, 32 insertions(+)

diff --git a/arch/arm64/boot/dts/allwinner/sun55i-t527-avaota-a1.dts b/arch/arm64/boot/dts/allwinner/sun55i-t527-avaota-a1.dts
index 111111111111..222222222222 100644
--- a/arch/arm64/boot/dts/allwinner/sun55i-t527-avaota-a1.dts
+++ b/arch/arm64/boot/dts/allwinner/sun55i-t527-avaota-a1.dts
@@ -436,6 +436,12 @@ &r_pio {
  *	vcc-pl-supply = <&reg_aldo3>;
  */
 	vcc-pm-supply = <&reg_aldo3>;
+
+	r_spi0_lcd_pins: r-spi0-lcd-pins {
+		pins = "PL10", "PL11", "PL12";
+		function = "s_spi0";
+		allwinner,pinmux = <6>;
+	};
 };
 
 &rtc {
@@ -446,6 +452,32 @@ &rtc {
 	assigned-clock-rates = <32768>;
 };
 
+&r_spi0 {
+	/*
+	 * The mcu_dma controller cannot serve the R-domain SPI0 (the
+	 * dmaengine_prep_slave_sg call fails with -EINVAL), so drop the
+	 * RX channel to keep the driver in PIO mode.
+	 */
+	dmas = <&mcu_dma 13>;
+	dma-names = "tx";
+	pinctrl-names = "default";
+	pinctrl-0 = <&r_spi0_lcd_pins>;
+	status = "okay";
+
+	lcd: st7789v@0 {
+		compatible = "sitronix,st7789v";
+		reg = <0>;
+		spi-max-frequency = <10000000>;
+		dc-gpios = <&r_pio 0 13 GPIO_ACTIVE_HIGH>;
+		reset-gpios = <&r_pio 0 9 GPIO_ACTIVE_LOW>;
+		led-gpios = <&r_pio 0 8 GPIO_ACTIVE_HIGH>;
+		width = <135>;
+		height = <240>;
+		buswidth = <8>;
+		rotate = <90>;
+	};
+};
+
 &spi0  {
 	pinctrl-names = "default";
 	pinctrl-0 = <&spi0_pj_pins>, <&spi0_cs0_pj_pin>,
-- 
Armbian

