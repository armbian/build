From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Juan Sanchez Fuentes <juanesf91@gmail.com>
Date: Tue, 1 Sep 2026 00:00:00 -0400
Subject: arm64: dts: t527-avaota-a1: enable HDMI display output

Pin the reusable CMA pool to low DRAM (0x43000000, 80 MiB, within the DE
fetch aperture and clear of the no-map reservations), add the
hdmi-connector node inside the root node and enable &de / &hdmi.

Also power the PHY: BLDO3 (1.8 V) feeds VCC18-HDMI on this board but was
left off (its only consumer is the disabled camera), so the inno HDMI PHY
had no I/O supply and the monitor reported no signal. Mark the rail
regulator-always-on and wire it as the dw-hdmi hvcc supply.

Signed-off-by: Juan Sanchez Fuentes <juanesf91@gmail.com>
Assisted-by: opencode:muse-spark-1.2-contributor-free
---
 arch/arm64/boot/dts/allwinner/sun55i-t527-avaota-a1.dts | 44 ++++++++++
 1 file changed, 44 insertions(+)

diff --git a/arch/arm64/boot/dts/allwinner/sun55i-t527-avaota-a1.dts b/arch/arm64/boot/dts/allwinner/sun55i-t527-avaota-a1.dts
index 111111111111..222222222222 100644
--- a/arch/arm64/boot/dts/allwinner/sun55i-t527-avaota-a1.dts
+++ b/arch/arm64/boot/dts/allwinner/sun55i-t527-avaota-a1.dts
@@ -59,6 +59,20 @@ rv_vdev0vring1: vdev0vring1@4ae42000 {
 			reg = <0x0 0x4ae42000 0x0 0x2000>;
 			no-map;
 		};
+
+		/* DE fetch aperture only reaches DRAM below ~0x4b100000;
+		 * pin the CMA pool low (see the RCQ pool at 0x43000000).
+		 * 80 MiB: stop at 0x48000000 to stay clear of the
+		 * secmon@48000000/48100000 and vdev@4ae00000 no-map
+		 * reservations (overlap hands out no-map pages -> oops) */
+		linux,cma {
+			compatible = "shared-dma-pool";
+			reusable;
+			reg = <0x0 0x43000000 0x0 0x5000000>;
+			alloc-ranges = <0x0 0x43000000 0x0 0x5000000>;
+			size = <0x0 0x5000000>;
+			linux,cma-default;
+		};
 	};
 
 	ext_osc32k: ext-osc32k-clk {
@@ -108,8 +122,21 @@ wifi_pwrseq: wifi-pwrseq {
 		reset-gpios = <&pio 6 13 GPIO_ACTIVE_LOW>;	/* PG13 WL-REG-ON */
 		post-power-on-delay-ms = <200>;
 	};
+
+	hdmi-connector {
+		compatible = "hdmi-connector";
+		type = "a";
+
+		port {
+			hdmi_con_in: endpoint {
+				remote-endpoint = <&hdmi_out_con>;
+			};
+		};
+	};
+
 };
 
+
 &ehci0 {
 	status = "okay";
 };
@@ -370,6 +397,8 @@ reg_bldo2: bldo2 {
 			reg_bldo3: bldo3 {
 				regulator-min-microvolt = <1800000>;
 				regulator-max-microvolt = <1800000>;
+				/* also VCC18-HDMI: the inno HDMI PHY I/O supply */
+				regulator-always-on;
 				regulator-name = "vcc-cvp-pk-vid1v8";
 			};
 
@@ -584,3 +613,18 @@ &e906_rproc {
 		< 0x40040000	0x3ffc0000	0x40040000 >;
 	status = "okay";
 };
+
+&de {
+	status = "okay";
+};
+
+&hdmi {
+	hvcc-supply = <&reg_bldo3>;
+	status = "okay";
+};
+
+&hdmi_out {
+	hdmi_out_con: endpoint {
+		remote-endpoint = <&hdmi_con_in>;
+	};
+};
-- 
Armbian

