diff --git a/drivers/gpu/drm/sun4i/sun55i_de.c b/drivers/gpu/drm/sun4i/sun55i_de.c
index 111111111111..222222222222 100644
--- a/drivers/gpu/drm/sun4i/sun55i_de.c
+++ b/drivers/gpu/drm/sun4i/sun55i_de.c
@@ -929,19 +929,72 @@ void sun55i_de_layer_update(struct sun8i_mixer *mixer, struct sun8i_layer *layer
  * background-colour flashes (the bug the vendor avoids by arming in blanking).
  * Defer the arm to the next blanking window in sun55i_de_vblank_quirk().
  */
-/* flip-min: only the fb-address blocks need reloading on a page flip */
+/* flip-min: only a few blocks need reloading on a page flip.
+ *
+ * The primary UI channel (pipe 0) carries the opaque desktop framebuffer: a
+ * page flip only changes its fb address, so just the OVL layer/para blocks are
+ * reloaded. The overlay and cursor channels (pipes 1/2) are staged dynamically
+ * by Xorg *after* the initial full reload (the cursor plane comes and goes,
+ * moves, changes enable state), so ALL of their blocks plus the shared blender
+ * must be reloaded on every flip to keep the shadow in sync with the hardware.
+ */
 static bool is_fb_block(unsigned int i)
 {
 	unsigned int c;
 
+	/* shared blender: pipe enables/route/blend change with overlay/cursor */
+	if (i == SUN55I_DE_BLK_BLD_ATTR || i == SUN55I_DE_BLK_BLD_CTL)
+		return true;
+
 	if (i < SUN55I_DE_BLK_UI_BASE_IDX)
 		return false;
-	for (c = 0; c < SUN55I_DE_UI_CHANNELS; c++) {
-		if (i == SUN55I_DE_BLK_CH(c, SUN55I_DE_BLKCH_OVL_LAY0) ||
-		    i == SUN55I_DE_BLK_CH(c, SUN55I_DE_BLKCH_OVL_PARA))
-			return true;
+
+	/* channel maps: 0 == primary (fb-address only), 1/2 == dynamic */
+	c = (i - SUN55I_DE_BLK_UI_BASE_IDX) / SUN55I_DE_BLK_PER_UI_CH;
+	if (c == 0)
+		return i == SUN55I_DE_BLK_CH(0, SUN55I_DE_BLKCH_OVL_LAY0) ||
+		       i == SUN55I_DE_BLK_CH(0, SUN55I_DE_BLKCH_OVL_PARA);
+
+	/* overlay/cursor: reload the whole channel register file every flip */
+	return i >= SUN55I_DE_BLK_CH(c, 0) &&
+	       i < SUN55I_DE_BLK_CH(c, SUN55I_DE_BLK_PER_UI_CH);
+}
+
+static u32 sun55i_de_arm_target(struct sun55i_de *de);
+
+/*
+ * Backstop arm: program the RCQ load to land in the next leading-blanking
+ * window via the hrtimer, so a staged commit is armed even when the TCON
+ * vblank IRQ is not enabled (Xorg cursor-only updates never enable the
+ * vblank IRQ, and the beam-gated arm in sun55i_de_vblank_quirk() then never
+ * runs, freezing the cursor). Mirrors that quirk's line math. Idempotent:
+ * if the vblank IRQ already armed this commit, do_arm() finds arm_pending
+ * clear and the extra load is a no-op. Caller must hold arm_lock.
+ */
+static void sun55i_de_schedule_arm(struct sun55i_de *de)
+{
+	u32 target, cur_line;
+	u64 lines;
+
+	if (!de->ns_per_line || !tcon_curline_io)
+		return;
+
+	target = sun55i_de_arm_target(de);
+	cur_line = readl(tcon_curline_io) & 0xfff;
+
+	if (cur_line <= target) {
+		lines = target - cur_line;
+	} else {
+		u32 ahead = cur_line < de->line_total ?
+			    de->line_total - cur_line : 0;
+
+		lines = ahead + target;
 	}
-	return false;
+
+	de->arm_sched = true;
+	hrtimer_start(&de->arm_timer,
+		      ns_to_ktime(lines * de->ns_per_line),
+		      HRTIMER_MODE_REL);
 }
 
 void sun55i_de_commit(struct sun8i_mixer *mixer)
@@ -977,6 +1030,14 @@ void sun55i_de_commit(struct sun8i_mixer *mixer)
 	de->commit_seq++;
 	dbg_commits++;
 	de->arm_pending = true;
+
+	/*
+	 * Backstop arm: the TCON vblank IRQ is not enabled for cursor-only
+	 * updates, so arm via the hrtimer to the next blanking target. If an
+	 * arm is already pending from a previous commit, that timer covers it.
+	 */
+	if (!de->arm_sched)
+		sun55i_de_schedule_arm(de);
 	spin_unlock_irqrestore(&de->arm_lock, flags);
 }
 
@@ -1059,8 +1120,26 @@ static enum hrtimer_restart sun55i_de_arm_timer(struct hrtimer *t)
 	unsigned long flags;
 
 	spin_lock_irqsave(&de->arm_lock, flags);
-	if (de->arm_pending)
-		sun55i_de_do_arm(de);
+	/* hrtimer fired: a racing commit must see this and re-schedule itself */
+	de->arm_sched = false;
+	if (de->arm_pending) {
+		u32 cur = tcon_curline_io ? readl(tcon_curline_io) & 0xfff : 0;
+
+		/*
+		 * Beam-gated self-correction: the timer was aimed at the
+		 * blanking target, but IRQ/scheduling latency may have it
+		 * fire with the beam in active video - arming there tears.
+		 * Re-check and defer to the next blanking window instead.
+		 */
+		if (de->ns_per_line && cur >= de->line_active) {
+			sun55i_de_schedule_arm(de);
+		} else {
+			sun55i_de_do_arm(de);
+			/* RCQ still busy (arm_busy_gate): retry at the next blanking */
+			if (de->arm_pending)
+				sun55i_de_schedule_arm(de);
+		}
+	}
 	spin_unlock_irqrestore(&de->arm_lock, flags);
 
 	return HRTIMER_NORESTART;
