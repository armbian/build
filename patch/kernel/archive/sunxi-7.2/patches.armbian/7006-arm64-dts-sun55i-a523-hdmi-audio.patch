From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Juan Sanchez <juanesf91@gmail.com>
Date: Fri, 18 Sep 2026 21:30:00 -0500
Subject: arm64: dts: allwinner: a523: HDMI audio through I2S2 and DW-HDMI

Add the "sndhdmi" simple-audio-card wiring I2S2 into the DW-HDMI I2S
input on the Radxa Cubie A5E, Avaota A1 and OrangePi 4A, plus a
#sound-dai-cells on the HDMI node so it can be referenced as the
codec DAI. 32-bit TDM slots are used because dw-hdmi-i2s-audio
hardcodes INPUTCLKFS=64fs and would sample narrower frames wrong.

The link is marked playback-only: the DW-HDMI I2S wiring is
receive-only on the SoC side, and the capture PCM that the generic
hdmi-codec driver would otherwise expose makes session managers
probe a second stream that the driver refuses ("Only one
simultaneous stream supported").

Co-authored-by: opencode <noreply@opencode.ai>
Signed-off-by: Juan Sanchez <juanesf91@gmail.com>
---
 arch/arm64/boot/dts/allwinner/sun55i-a523.dtsi            |    1 +
 arch/arm64/boot/dts/allwinner/sun55i-a527-cubie-a5e.dts    |   34 +++
 arch/arm64/boot/dts/allwinner/sun55i-t527-avaota-a1.dts    |   34 +++
 arch/arm64/boot/dts/allwinner/sun55i-t527-orangepi-4a.dts  |   34 +++
 4 files changed, 103 insertions(+)

diff --git a/arch/arm64/boot/dts/allwinner/sun55i-a523.dtsi b/arch/arm64/boot/dts/allwinner/sun55i-a523.dtsi
index 231fc40e5..dc3f239f7 100644
--- a/arch/arm64/boot/dts/allwinner/sun55i-a523.dtsi
+++ b/arch/arm64/boot/dts/allwinner/sun55i-a523.dtsi
@@ -319,6 +319,7 @@ hdmi: hdmi@5520000 {
 			power-domains = <&pck600 PD_VO0>;
 			phys = <&hdmi_phy>;
 			phy-names = "phy";
+			#sound-dai-cells = <0>;
 			status = "disabled";
 
 			ports {
diff --git a/arch/arm64/boot/dts/allwinner/sun55i-a527-cubie-a5e.dts b/arch/arm64/boot/dts/allwinner/sun55i-a527-cubie-a5e.dts
index 879b3abac..9891ed9fc 100644
--- a/arch/arm64/boot/dts/allwinner/sun55i-a527-cubie-a5e.dts
+++ b/arch/arm64/boot/dts/allwinner/sun55i-a527-cubie-a5e.dts
@@ -96,6 +96,40 @@ hdmi_con_in: endpoint {
 		};
 	};
 
+	/*
+	 * HDMI AUDIO (BSP 5.15 recipe): the BSP outputs HDMI audio through
+	 * I2S2 (i2s2@7114000, mcu_dma req 5, card "sndhdmi", i2s format,
+	 * CPU master) into the DW-HDMI I2S input (internal SoC wiring, no
+	 * pinctrl). In mainline this is sun4i-i2s (r329 fallback) +
+	 * dw-hdmi-i2s-audio / hdmi-codec + simple-audio-card, rk3328
+	 * pattern. mclk-fs=128: the DW-HDMI does not consume MCLK but
+	 * sun4i-i2s derives its BCLK dividers from it.
+	 */
+	hdmi_sound: hdmi-sound {
+		compatible = "simple-audio-card";
+		simple-audio-card,name = "sndhdmi";
+		simple-audio-card,format = "i2s";
+		simple-audio-card,mclk-fs = <128>;
+		playback-only;
+
+		simple-audio-card,cpu {
+			sound-dai = <&i2s2>;
+			/*
+			 * 32-bit slots always (like the BSP soundcard-mach,
+			 * slot-width = <32>): dw-hdmi-i2s-audio hardcodes
+			 * INPUTCLKFS=64fs, and with 16-bit slots sun4i-i2s
+			 * generates 32fs frames -> DW-HDMI samples the frame
+			 * wrong and the sink gets silence.
+			 */
+			dai-tdm-slot-num = <2>;
+			dai-tdm-slot-width = <32>;
+		};
+
+		simple-audio-card,codec {
+			sound-dai = <&hdmi>;
+		};
+	};
+
 	leds {
 		compatible = "gpio-leds";
 
@@ -609,3 +643,7 @@ hdmi_out_con: endpoint {
 		remote-endpoint = <&hdmi_con_in>;
 	};
 };
+
+&i2s2 {
+	status = "okay";
+};
