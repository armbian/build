+/*
+ * ----------------------------------------------------------------------------
+ * A523/H728 (sun55iw3) Innosilicon HDMI PHY.
+ *
+ * Ported from the Allwinner BSP (bsp/.../lowlevel_hdmi20/phy_inno.c). The DW-HDMI
