From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Alastair D'Silva <alastair@d-silva.org>
Date: Tue, 8 Sep 2026 10:00:00 +1000
Subject: clk: sunxi-ng: a733: Add Crypto Engine (CE) clocks

Add Crypto Engine (CE) module clock and bus interface clock/reset definitions
to ccu-sun60i-a733.c, and export CLK_CE, CLK_BUS_CE, and RST_BUS_CE in the
A733 CCU binding headers.

The Allwinner Crypto Engine provides hardware acceleration for symmetric
ciphers (AES, 3DES) and cryptographic hashes (MD5, SHA1, SHA256, SHA512).
The internal cryptographic pipeline requires the dedicated module clock at
0xac0 (with M and N dividers and PLL_PERIPH0 parents), while the AHB slave
register interface requires the bus clock gate and reset at 0xac4.

Providing these clocks enables the sun8i-ce driver to un-gate and reset the
crypto engine hardware and accelerate cryptographic workloads.

Signed-off-by: Alastair D'Silva <alastair@d-silva.org>
Assisted-by: Antigravity <antigravity@google.com>

---
diff --git a/drivers/clk/sunxi-ng/ccu-sun60i-a733.c b/drivers/clk/sunxi-ng/ccu-sun60i-a733.c
index eb76623..a1b52a9 100644
--- a/drivers/clk/sunxi-ng/ccu-sun60i-a733.c
+++ b/drivers/clk/sunxi-ng/ccu-sun60i-a733.c
@@ -467,14 +467,14 @@ static const struct clk_parent_data ce_parents[] = {
 	{ .hw = &pll_periph0_400M_clk.hw },
 	{ .hw = &pll_periph0_300M_clk.hw },
 };
-static SUNXI_CCU_M_DATA_WITH_MUX_GATE(ce_clk, "ce", ce_parents, 0x680,
+static SUNXI_CCU_M_DATA_WITH_MUX_GATE(ce_clk, "ce", ce_parents, 0xac0,
 				       0, 5,	/* M */
 				       24, 3,	/* mux */
 				       BIT(31),	/* gate */
 				       0);
 
-static SUNXI_CCU_GATE_HWS(bus_ce_clk, "bus-ce", ahb_hws, 0x68c, BIT(0), 0);
-static SUNXI_CCU_GATE_HWS(bus_ce_sys_clk, "bus-ce-sys", ahb_hws, 0x68c,
+static SUNXI_CCU_GATE_HWS(bus_ce_clk, "bus-ce", ahb_hws, 0xac4, BIT(0), 0);
+static SUNXI_CCU_GATE_HWS(bus_ce_sys_clk, "bus-ce-sys", ahb_hws, 0xac4,
 			  BIT(1), 0);
 
 static const struct clk_hw *ve_parents[] = {
@@ -1636,8 +1636,8 @@ static struct ccu_reset_map sun60i_a733_ccu_resets[] = {
 	[RST_BUS_G2D]		= { 0x63c, BIT(16) },
 	[RST_BUS_SYS]		= { 0x64c, BIT(16) },
 	[RST_BUS_GPU]		= { 0x67c, BIT(16) },
-	[RST_BUS_CE]		= { 0x68c, BIT(16) },
-	[RST_BUS_SYS_CE]	= { 0x68c, BIT(17) },
+	[RST_BUS_CE]		= { 0xac4, BIT(16) },
+	[RST_BUS_SYS_CE]	= { 0xac4, BIT(17) },
 	[RST_BUS_VE]		= { 0x69c, BIT(16) },
 	[RST_BUS_DMA]		= { 0x70c, BIT(16) },
 	[RST_BUS_MSGBOX]	= { 0x71c, BIT(16) },
