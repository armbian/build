From: Alastair D'Silva <alastair@d-silva.org>
Date: Tue, 8 Sep 2026 10:00:00 +1000
Subject: clk: sunxi-ng: a733: Add GPADC, THS, and LRADC clocks

Add clock gates, parent muxing, and reset controls for the analog and sensing
peripherals (GPADC0, THS, and LRADC) in ccu-sun60i-a733.c, and export their
respective IDs in the A733 CCU binding headers.

The A733 SoC incorporates multiple analog-to-digital converters for junction
temperature monitoring (THS), general analog voltage sensing (GPADC0), and
recovery button sampling (LRADC). On mainline Linux, these drivers require
active clock gating and reset deassertion:
- GPADC0 module clock (0xfc0) and bus reset (0xfc4)
- Thermal Sensor Controller (THS) bus reset (0xfe4)
- LRADC keys bus clock gate and reset (0x1024)

Specifically, the THS driver requires reset deassertion at 0xfe4 to access
eFuse thermal calibration registers; without this reset, the THS driver probe
fails, disabling thermal zone monitoring and kernel thermal throttling.

Signed-off-by: Alastair D'Silva <alastair@d-silva.org>
Assisted-by: Antigravity <antigravity@google.com>

---
diff --git a/drivers/clk/sunxi-ng/ccu-sun60i-a733.c b/drivers/clk/sunxi-ng/ccu-sun60i-a733.c
index 50d49ac..eb76623 100644
--- a/drivers/clk/sunxi-ng/ccu-sun60i-a733.c
+++ b/drivers/clk/sunxi-ng/ccu-sun60i-a733.c
@@ -821,20 +821,25 @@ static SUNXI_CCU_M_DATA_WITH_MUX_GATE(ir_tx_clk, "ir-tx", ir_tx_ledc_parents,
 static SUNXI_CCU_GATE_HWS(bus_ir_tx_clk, "bus-ir-tx", apb0_hws, 0x9cc,
 			  BIT(0), 0);
 
-static SUNXI_CCU_M_WITH_GATE(gpadc0_clk, "gpadc0", "hosc", 0x9e0,
-				 0, 5,		/* M */
-				 BIT(31),	/* gate */
-				 0);
-static SUNXI_CCU_M_WITH_GATE(gpadc1_clk, "gpadc1", "hosc", 0x9e4,
-				 0, 5,		/* M */
-				 BIT(31),	/* gate */
-				 0);
-static SUNXI_CCU_GATE_HWS(bus_gpadc0_clk, "bus-gpadc0", ahb_hws, 0x9ec,
+static const struct clk_parent_data gpadc0_parents[] = {
+	{ .fw_name = "hosc" },
+};
+static SUNXI_CCU_M_DATA_WITH_MUX_GATE(gpadc0_clk, "gpadc0", gpadc0_parents, 0xfc0,
+				      0, 5,		/* M */
+				      24, 1,		/* mux */
+				      BIT(31),		/* gate */
+				      0);
+static SUNXI_CCU_M_DATA_WITH_MUX_GATE(gpadc1_clk, "gpadc1", gpadc0_parents, 0x9e4,
+				      0, 5,		/* M */
+				      24, 1,		/* mux */
+				      BIT(31),		/* gate */
+				      0);
+static SUNXI_CCU_GATE_HWS(bus_gpadc0_clk, "bus-gpadc0", ahb_hws, 0xfc4,
 			  BIT(0), 0);
 static SUNXI_CCU_GATE_HWS(bus_gpadc1_clk, "bus-gpadc1", ahb_hws, 0x9ec,
 			  BIT(1), 0);
 
-static SUNXI_CCU_GATE_HWS(bus_ths_clk, "bus-ths", apb0_hws, 0x9fc, BIT(0), 0);
+static SUNXI_CCU_GATE_HWS(bus_ths_clk, "bus-ths", apb0_hws, 0xfe4, BIT(0), 0);
 
 /*
  * The first parent is a 48 MHz input clock divided by 4. That 48 MHz clock is
@@ -898,7 +903,7 @@ static SUNXI_CCU_GATE_HWS(bus_ehci1_clk, "bus-ehci1", ahb_hws, 0x230c,
 			  BIT(4), 0);
 static SUNXI_CCU_GATE_HWS(bus_otg_clk, "bus-otg", ahb_hws, 0x2304, BIT(8), 0);
 
-static SUNXI_CCU_GATE_HWS(bus_lradc_clk, "bus-lradc", apb0_hws, 0xa9c,
+static SUNXI_CCU_GATE_HWS(bus_lradc_clk, "bus-lradc", apb0_hws, 0x1024,
 			  BIT(0), 0);
 
 static const struct clk_parent_data losc_hosc_parents[] = {
@@ -1669,9 +1674,9 @@ static struct ccu_reset_map sun60i_a733_ccu_resets[] = {
 	[RST_BUS_EMAC1]		= { 0x98c, BIT(16) | BIT(17) },	/* GMAC1-AXI */
 	[RST_BUS_IR_RX]		= { 0x1004, BIT(16) },
 	[RST_BUS_IR_TX]		= { 0x100c, BIT(16) },
-	[RST_BUS_GPADC0]	= { 0x9ec, BIT(16) },
+	[RST_BUS_GPADC0]	= { 0xfc4, BIT(16) },
 	[RST_BUS_GPADC1]	= { 0x9ec, BIT(17) },
-	[RST_BUS_THS]		= { 0x9fc, BIT(16) },
+	[RST_BUS_THS]		= { 0xfe4, BIT(16) },
 	[RST_USB_PHY0]		= { 0x2300, BIT(30) },
 	[RST_USB_PHY1]		= { 0x2308, BIT(30) },
 	[RST_BUS_OHCI0]		= { 0x2304, BIT(16) },
@@ -1680,7 +1685,7 @@ static struct ccu_reset_map sun60i_a733_ccu_resets[] = {
 	[RST_BUS_EHCI1]		= { 0x230c, BIT(20) },
 	[RST_BUS_OTG]		= { 0x2304, BIT(24) },
 	[RST_BUS_3]		= { 0x235c, BIT(16) },	/* USB2 / DWC3 reset */
-	[RST_BUS_LRADC]		= { 0xa9c, BIT(16) },
+	[RST_BUS_LRADC]		= { 0x1024, BIT(16) },
 	[RST_BUS_PCIE_USB3]	= { 0x238c, BIT(16) | BIT(17) },
 	[RST_PCIE_PWRUP]	= { 0x238c, BIT(16) },
 	[RST_PCIE_PCLK]		= { 0x238c, BIT(17) },

