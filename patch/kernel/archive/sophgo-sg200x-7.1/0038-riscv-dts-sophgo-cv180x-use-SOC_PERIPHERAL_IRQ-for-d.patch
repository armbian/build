From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Lukasz Sobala <lsobala1@gmail.com>
Date: Tue, 28 Jul 2026 18:32:12 +0200
Subject: riscv: dts: sophgo: cv180x: use SOC_PERIPHERAL_IRQ for dual-arch
 nodes

cv180x.dtsi is shared between arch/riscv and arch/arm64: the arm64
sg2000.dtsi #includes it and redefines SOC_PERIPHERAL_IRQ() so that it
emits GIC_SPI interrupt specifiers instead of PLIC ones.

Three nodes added by the out-of-tree Sophgo patch series hardcode raw
PLIC interrupt numbers, which yields wrong (or, for the mailbox,
unresolvable) interrupt specifiers when the SoC runs in ARM mode:

  mailbox@1900000         irq 101 -> SOC_PERIPHERAL_IRQ(85)
  watchdog@3010000        irq  58 -> SOC_PERIPHERAL_IRQ(42)
  thermal-sensor@30e0000  irq  16 -> SOC_PERIPHERAL_IRQ(0)

The mailbox node additionally sat outside the "soc" node and carried an
explicit interrupt-parent = <&plic>, a label that does not exist on
arm64. Move it into "soc" so it inherits the per-arch interrupt parent
like every other peripheral on this SoC.

Signed-off-by: Armbian <info@armbian.com>
---
 arch/riscv/boot/dts/sophgo/cv180x.dtsi | 21 +++++-----
 1 file changed, 10 insertions(+), 11 deletions(-)

diff --git a/arch/riscv/boot/dts/sophgo/cv180x.dtsi b/arch/riscv/boot/dts/sophgo/cv180x.dtsi
index 111111111111..222222222222 100644
--- a/arch/riscv/boot/dts/sophgo/cv180x.dtsi
+++ b/arch/riscv/boot/dts/sophgo/cv180x.dtsi
@@ -48,21 +48,20 @@ soc_critical: soc-critical {
 		};
 	};
 
-	mailbox: mailbox@1900000 {
-		compatible = "sophgo,cv1800b-mailbox";
-		reg = <0x01900000 0x1000>;
-		interrupts = <101 IRQ_TYPE_LEVEL_HIGH>;
-		interrupt-parent = <&plic>;
-		#mbox-cells = <2>;
-		status = "okay";
-	};
-
 	soc {
 		compatible = "simple-bus";
 		#address-cells = <1>;
 		#size-cells = <1>;
 		ranges;
 
+		mailbox: mailbox@1900000 {
+			compatible = "sophgo,cv1800b-mailbox";
+			reg = <0x01900000 0x1000>;
+			interrupts = <SOC_PERIPHERAL_IRQ(85) IRQ_TYPE_LEVEL_HIGH>;
+			#mbox-cells = <2>;
+			status = "okay";
+		};
+
 		syscon: syscon@3000000 {
 			compatible = "sophgo,cv1800b-top-syscon",
 				     "syscon", "simple-mfd";
@@ -99,7 +98,7 @@ wdt: watchdog@3010000 {
 			compatible = "snps,dw-wdt";
 			reg = <0x03010000 0x100>;
 			snps,watchdog-tops = <0x0fffffff 0x1fffffff 0x3fffffff 0x7fffffff 0x0fffffff 0x1fffffff 0x3fffffff 0x7fffffff 0x0fffffff 0x1fffffff 0x3fffffff 0x7fffffff 0x0fffffff 0x1fffffff 0x3fffffff 0x7fffffff>;
-			interrupts = <58 4>;
+			interrupts = <SOC_PERIPHERAL_IRQ(42) IRQ_TYPE_LEVEL_HIGH>;
 			clocks = <&osc>;
 			resets = <&rst RST_WDT1>;
 		};
@@ -255,7 +254,7 @@ soc_temp: thermal-sensor@30e0000 {
 			compatible = "sophgo,cv1800-thermal";
 			reg = <0x30e0000 0x100>;
 			clocks = <&clk CLK_TEMPSEN>;
-			interrupts = <16 IRQ_TYPE_LEVEL_HIGH>;
+			interrupts = <SOC_PERIPHERAL_IRQ(0) IRQ_TYPE_LEVEL_HIGH>;
 			#thermal-sensor-cells = <0>;
 		};
 		
