 		}
@@ -190,22 +190,22 @@ struct dsm_client *dsm_register_client(struct dsm_dev *dev)
 		goto out;
 	}
 
-	strncpy(ptr->client_name, dev->name, CLIENT_NAME_LEN - 1);
