From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Igor Pecovnik <igor@armbian.com>
Date: Sun, 15 Nov 2026 17:50:59 +0000
Subject: [PATCH] soc: cix: dst: replace strncpy()

7.3 removes strncpy(). dst_strncpy() keeps its semantics.

Signed-off-by: Igor Pecovnik <igor@armbian.com>

---
 .../cix/cix_dst/blackbox/platform_ap/rdr_ap_hook.c   |  4 ++--
 .../cix_dst/blackbox/platform_ap/rdr_ap_moddump.c    |  2 +-
 .../cix_dst/blackbox/platform_ap/rdr_ap_regdump.c    |  2 +-
 .../cix_dst/blackbox/platform_ap/rdr_ap_ringbuffer.c |  2 +-
 .../cix/cix_dst/blackbox/platform_ap/rdr_ap_stack.c  |  2 +-
 drivers/soc/cix/cix_dst/blackbox/rdr_dump_core.c     |  4 ++--
 .../soc/cix/cix_dst/blackbox/rdr_logmonitor_core.c   |  2 +-
 drivers/soc/cix/cix_dst/dsm/dsm_core.c               | 12 ++++++------
 drivers/soc/cix/cix_dst/dst_fdleak_main.c            |  2 +-
 drivers/soc/cix/cix_dst/dst_print.h                  | 11 +++++++++++
 drivers/soc/cix/cix_dst/hw_boottime.c                |  2 +-
 .../cix_dst/pm_exception_monitor/pm_exception_dsm.c  |  2 +-
 drivers/soc/cix/cix_dst/util.c                       |  4 ++--
 13 files changed, 31 insertions(+), 20 deletions(-)

diff --git a/drivers/soc/cix/cix_dst/blackbox/platform_ap/rdr_ap_hook.c b/drivers/soc/cix/cix_dst/blackbox/platform_ap/rdr_ap_hook.c
index 280b064cd..be3d8210f 100644
--- a/drivers/soc/cix/cix_dst/blackbox/platform_ap/rdr_ap_hook.c
+++ b/drivers/soc/cix/cix_dst/blackbox/platform_ap/rdr_ap_hook.c
@@ -189,7 +189,7 @@ void __task_switch_hook(const void *pre_task, void *next_task)
 	info.clock = local_clock();
 	cpu = (u8)smp_processor_id();
 	info.pid = (u32)task->pid;
-	(void)strncpy(info.comm, task->comm, sizeof(task->comm) - 1);
+	(void)dst_strncpy(info.comm, task->comm, sizeof(task->comm) - 1);
 	info.comm[TASK_COMM_LEN - 1] = '\0';
 	info.stack = (uintptr_t)task->stack;
 
@@ -272,7 +272,7 @@ void __hung_task_hook(void *tsk, u32 timeout)
 	info.clock = local_clock();
 	info.timeout = (u32)timeout;
 	info.pid = (u32)task->pid;
-	(void)strncpy(info.comm, task->comm, sizeof(task->comm) - 1);
+	(void)dst_strncpy(info.comm, task->comm, sizeof(task->comm) - 1);
 	info.comm[TASK_COMM_LEN - 1] = '\0';
 
 	rdr_rbuf_write(g_hook_buffer[HK_HUNGTASK].percpu[0].vaddr, (u8 *)&info);
diff --git a/drivers/soc/cix/cix_dst/blackbox/platform_ap/rdr_ap_moddump.c b/drivers/soc/cix/cix_dst/blackbox/platform_ap/rdr_ap_moddump.c
