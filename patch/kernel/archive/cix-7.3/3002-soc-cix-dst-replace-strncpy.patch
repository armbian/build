diff --git a/drivers/soc/cix/cix_dst/dst_print.h b/drivers/soc/cix/cix_dst/dst_print.h
index 495db37c5..8f2e51b7a 100755
--- a/drivers/soc/cix/cix_dst/dst_print.h
+++ b/drivers/soc/cix/cix_dst/dst_print.h
@@ -5,6 +5,17 @@
 
 #include <linux/types.h>
 #include <linux/printk.h>
+#include <linux/string.h>
+
+/*
+ * strncpy() is gone since 7.3. Same semantics: copy up to @n bytes of @src,
+ * then pad @dst with zeros up to @n bytes.
+ */
+static inline char *dst_strncpy(char *dst, const char *src, size_t n)
+{
+	memcpy_and_pad(dst, n, src, strnlen(src, n), 0);
+	return dst;
+}
 
 #define DST_ALERT(fmt, args...) \
 	pr_alert("<dst::%s:%d> " fmt, __FUNCTION__, __LINE__, ##args)
