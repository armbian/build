 	       sizeof(hw_boottime[boot_log_count].event));
-	strncpy((char *)&hw_boottime[boot_log_count].event, str, strlen(str));
+	dst_strncpy((char *)&hw_boottime[boot_log_count].event, str, strlen(str));
 
 	boot_log_count++;
 	mutex_unlock(&hw_boottime_lock);
