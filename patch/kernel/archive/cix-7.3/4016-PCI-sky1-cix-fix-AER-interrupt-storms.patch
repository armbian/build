+static u32 sky1_phy_readl_phy_status(struct sky1_pcie *pcie, u32 reg);
+
+/* One-time dump of everything that could be holding an AER line asserted. */
+static void sky1_pcie_aer_dump(struct sky1_pcie *pcie, int irq)
+{
+	void __iomem *rp = pcie->reg_base + CDNS_PCIE_HPA_RP_BASE;
+	u16 aer = sky1_cdns_pcie_find_ext_capability(rp, PCI_EXT_CAP_ID_ERR);
+	u8 exp = sky1_cdns_pcie_find_capability(rp, PCI_CAP_ID_EXP);
+	struct device *dev = pcie->dev;
+	u32 phy[4];
+	int i;
+
+	dev_err(dev, "AER dump irq %d (%s): trigger type 0x%x\n", irq,
+		sky1_pcie_aer_irq_name(pcie, irq), irq_get_trigger_type(irq));
+	if (aer)
+		dev_err(dev, "AER cap 0x%x: uncor sts 0x%08x mask 0x%08x sev 0x%08x, cor sts 0x%08x mask 0x%08x, cap/ctl 0x%08x, root cmd 0x%08x sts 0x%08x src 0x%08x\n",
+			aer, readl(rp + aer + PCI_ERR_UNCOR_STATUS),
+			readl(rp + aer + PCI_ERR_UNCOR_MASK),
+			readl(rp + aer + PCI_ERR_UNCOR_SEVER),
+			readl(rp + aer + PCI_ERR_COR_STATUS),
+			readl(rp + aer + PCI_ERR_COR_MASK),
+			readl(rp + aer + PCI_ERR_CAP),
+			readl(rp + aer + PCI_ERR_ROOT_COMMAND),
+			readl(rp + aer + PCI_ERR_ROOT_STATUS),
+			readl(rp + aer + PCI_ERR_ROOT_ERR_SRC));
+	if (exp)
+		dev_err(dev, "PCIe cap 0x%x: devctl/sta 0x%08x lnkctl/sta 0x%08x rtctl 0x%08x rtsta 0x%08x\n",
+			exp, readl(rp + exp + PCI_EXP_DEVCTL),
+			readl(rp + exp + PCI_EXP_LNKCTL),
+			readl(rp + exp + PCI_EXP_RTCTL),
+			readl(rp + exp + PCI_EXP_RTSTA));
+	dev_err(dev, "local err0 sts 0x%08x mask 0x%08x, err1 sts 0x%08x mask 0x%08x, dbg0 0x%08x\n",
+		readl(rp + I_LOCAL_ERR_STS_REG0), readl(rp + I_LOCAL_ERR_MASK_REG0),
+		readl(rp + I_LOCAL_ERR_STS_REG1), readl(rp + I_LOCAL_ERR_MASK_REG1),
+		sky1_pcie_ctrl_readl_reg(pcie, IP_REG_I_DBG_STS_0));
+	mutex_lock(&sky1_init_mutex);
+	for (i = 0; i < 4; i++)
+		phy[i] = sky1_phy_readl_phy_status(pcie, STATUS_REG(i));
+	mutex_unlock(&sky1_init_mutex);
+	dev_err(dev, "app status 0-3: 0x%08x 0x%08x 0x%08x 0x%08x\n",
+		phy[0], phy[1], phy[2], phy[3]);
+}
+
+/*
+ * Give up on an AER line after this many interrupts in a row that found no
+ * error status anywhere: nothing here can clear the source, and on 7.3 the
+ * line was seen re-firing forever (1730 times in 19 s) until a hard lockup.
+ */
+#define SKY1_AER_SPURIOUS_LIMIT		64
+/*
+ * On the board the storm is a burst while the link comes up (64 interrupts in
+ * about 0.16 s on aer_nf), so switch the line back on after a pause instead
+ * of losing that error class for the whole boot. Give up after a few bursts.
+ */
+#define SKY1_AER_REARM_DELAY_MS		2000
+#define SKY1_AER_REARM_MAX		5
+
+static struct sky1_aer_guard *sky1_pcie_aer_guard(struct sky1_pcie *pcie, int irq)
+{
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(pcie->aer_guard); i++)
+		if (pcie->aer_guard[i].irq == irq)
+			return &pcie->aer_guard[i];
+	return NULL;
+}
+
+static void sky1_pcie_aer_rearm_fn(struct work_struct *work)
+{
+	struct sky1_aer_guard *g = container_of(to_delayed_work(work),
+						struct sky1_aer_guard, rearm_work);
+	struct sky1_pcie *pcie = g->pcie;
+	unsigned long flags;
+	bool rearm;
+
+	spin_lock_irqsave(&pcie->aer_lock, flags);
+	rearm = g->rearm_pending;
+	g->rearm_pending = false;
+	if (rearm) {
+		g->off = false;
+		g->spurious = 0;
+	}
+	spin_unlock_irqrestore(&pcie->aer_lock, flags);
+	if (!rearm)
+		return;
+	dev_info(pcie->dev, "AER irq %d (%s): re-enabled (%u/%u)\n", g->irq,
+		 sky1_pcie_aer_irq_name(pcie, g->irq), g->rearms,
+		 SKY1_AER_REARM_MAX);
+	enable_irq(g->irq);
+}
+
+/*
+ * Stop the AER lines and any pending re-enable. disable_irq() waits for a
+ * running handler, so no handler can queue rearm_work after the cancel. A line
+ * the guard had switched off "for a while" is disabled twice at this point;
+ * drop the guard's count so a later enable_irq() really enables it.
+ */
+static void sky1_pcie_aer_stop(struct sky1_pcie *pcie)
+{
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(pcie->aer_guard); i++)
+		disable_irq(pcie->aer_guard[i].irq);
+	for (i = 0; i < ARRAY_SIZE(pcie->aer_guard); i++) {
+		struct sky1_aer_guard *g = &pcie->aer_guard[i];
+		unsigned long flags;
+		bool pending;
+
+		cancel_delayed_work_sync(&g->rearm_work);
+		spin_lock_irqsave(&pcie->aer_lock, flags);
+		pending = g->rearm_pending;
+		g->rearm_pending = false;
+		if (pending) {
+			g->off = false;
+			g->spurious = 0;
+		}
+		spin_unlock_irqrestore(&pcie->aer_lock, flags);
+		if (pending)
+			enable_irq(g->irq);
+	}
+}
+
 static irqreturn_t sky1_pcie_aer_irq_handler(int irq, void *arg)
 {
 	struct sky1_pcie *pcie = arg;
 	void __iomem *reg_base;
 	u16 aer_offset = 0;
-	u32 sta, source_id;
+	u8 cap_offset;
+	u32 sta, source_id, corr, uncorr, devsta = 0;
 	unsigned long flags;
 	irqreturn_t ret;
 #define _AER_ERR_STATUS_MASK                             \
@@ -643,17 +825,88 @@ static irqreturn_t sky1_pcie_aer_irq_handler(int irq, void *arg)
 	aer_offset =
 		sky1_cdns_pcie_find_ext_capability(reg_base, PCI_EXT_CAP_ID_ERR);
 	if (!aer_offset) {
-		dev_err(pcie->dev, "RC no aer capability\n");
-		ret = IRQ_NONE;
-		goto unlock;
+		spin_unlock_irqrestore(&pcie->aer_lock, flags);
+		dev_err_ratelimited(pcie->dev, "RC no aer capability\n");
+		return IRQ_NONE;
 	}
 
 	sta = readl(reg_base + aer_offset + PCI_ERR_ROOT_STATUS);
+	source_id = readl(reg_base + aer_offset + PCI_ERR_ROOT_ERR_SRC);
+	corr = readl(reg_base + aer_offset + PCI_ERR_COR_STATUS);
+	uncorr = readl(reg_base + aer_offset + PCI_ERR_UNCOR_STATUS);
+	cap_offset = sky1_cdns_pcie_find_capability(reg_base, PCI_CAP_ID_EXP);
+	if (cap_offset)
+		devsta = readl(reg_base + cap_offset + PCI_EXP_DEVCTL) >> 16;
+
+	if (!sta && !corr && !uncorr &&
+	    !(devsta & (PCI_EXP_DEVSTA_CED | PCI_EXP_DEVSTA_NFED |
+			PCI_EXP_DEVSTA_FED))) {
+		struct sky1_aer_guard *g = sky1_pcie_aer_guard(pcie, irq);
+		bool cut = false, rearm = false;
+		unsigned int n;
+		u32 local;
+
+		/* A latched local (non-AER-capability) error is a source we can clear. */
+		local = sky1_pcie_clear_local_aer(pcie, sky1_pcie_aer_irq_name(pcie, irq));
+		if (local & SKY1_LOCAL_AER_BITS) {
+			if (g)
+				g->spurious = 0;
+			spin_unlock_irqrestore(&pcie->aer_lock, flags);
+			return IRQ_HANDLED;
+		}
+		if (!g) {
+			spin_unlock_irqrestore(&pcie->aer_lock, flags);
+			return local ? IRQ_HANDLED : IRQ_NONE;
+		}
+
+		/*
+		 * Nothing latched (not ours, or a source we cannot clear), or only
+		 * the LTSSM indication: both count towards the guard below, so a
+		 * link that keeps changing state cannot hold the CPU either.
+		 */
+		if (time_after(jiffies, g->last + HZ))
+			g->spurious = 0;	/* only bursts count */
+		g->last = jiffies;
+		n = ++g->spurious;
+		if (n >= SKY1_AER_SPURIOUS_LIMIT && !g->off) {
+			cut = true;
+			g->off = true;
+			rearm = g->rearms < SKY1_AER_REARM_MAX;
+			if (rearm) {
+				g->rearms++;
+				g->rearm_pending = true;
+			}
+		}
+		spin_unlock_irqrestore(&pcie->aer_lock, flags);
+
+		if (!local)
+			dev_warn_ratelimited(pcie->dev,
+				"spurious AER irq %d (%s), no error status (%u in a row)\n",
+				irq, sky1_pcie_aer_irq_name(pcie, irq), n);
+		if (cut) {
+			dev_err(pcie->dev,
+				"AER irq %d (%s): %u interrupts with no error status, disabling it%s\n",
+				irq, sky1_pcie_aer_irq_name(pcie, irq), n,
+				rearm ? " for a while" : " for good");
+			if (g->rearms == 1 && rearm)
+				sky1_pcie_aer_dump(pcie, irq);
+			disable_irq_nosync(irq);
+			if (rearm)
+				schedule_delayed_work(&g->rearm_work,
+					msecs_to_jiffies(SKY1_AER_REARM_DELAY_MS));
+		}
+		return local ? IRQ_HANDLED : IRQ_NONE;
+	}
+	{
+		struct sky1_aer_guard *g = sky1_pcie_aer_guard(pcie, irq);
+
+		if (g)
+			g->spurious = 0;
+	}
+
 	/* Clear root error status */
 	writel(sta, (reg_base + aer_offset + PCI_ERR_ROOT_STATUS));
-	source_id = readl(reg_base + aer_offset + PCI_ERR_ROOT_ERR_SRC);
 
-	dev_info(pcie->dev, "root err status =0x%x,id = 0x%x", sta, source_id );
 	if (!(sta & _AER_ERR_STATUS_MASK))
 		/* local AER error flow */
 		sky1_pcie_handle_rp_aer_irq(pcie);
@@ -663,14 +916,17 @@ static irqreturn_t sky1_pcie_aer_irq_handler(int irq, void *arg)
 
 	ret = IRQ_HANDLED;
 
-unlock:
 	spin_unlock_irqrestore(&pcie->aer_lock, flags);
+	dev_info_ratelimited(pcie->dev,
+		"AER irq %d (%s): root err status 0x%x, source id 0x%x, cor 0x%x, uncor 0x%x\n",
+		irq, sky1_pcie_aer_irq_name(pcie, irq), sta, source_id, corr, uncorr);
 	return ret;
 }
 
