From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: EvilOlaf <werner@armbian.com>
Date: Tue, 17 Nov 2026 19:16:57 +0100
Subject: soc: cix: dst: wait idle in the blackbox main thread

The bbox_main thread waited in down_timeout(). That sleep is
uninterruptible, so the idle thread added 1 to the load average.
Wait with wait_event_idle_timeout() on a wait queue instead.

Assisted-by: Claude Opus 5.5
---
 drivers/soc/cix/cix_dst/blackbox/rdr_core.c | 18 +++++-----
 1 file changed, 10 insertions(+), 8 deletions(-)

diff --git a/drivers/soc/cix/cix_dst/blackbox/rdr_core.c b/drivers/soc/cix/cix_dst/blackbox/rdr_core.c
index 111111111111..222222222222 100644
--- a/drivers/soc/cix/cix_dst/blackbox/rdr_core.c
+++ b/drivers/soc/cix/cix_dst/blackbox/rdr_core.c
@@ -23,6 +23,7 @@
 #include <linux/syscalls.h>
 #include <linux/sched/debug.h>
 #include <linux/hardirq.h>
+#include <linux/wait.h>
 #include <uapi/linux/sched/types.h>
 #include "rdr_field.h"
 #include "rdr_print.h"
@@ -34,7 +35,7 @@ struct ap_syserr_process_t {
 	atomic_t running;
 };
 
-static struct semaphore rdr_sem;
+static DECLARE_WAIT_QUEUE_HEAD(rdr_wq);
 static LIST_HEAD(g_rdr_syserr_list);
 static DEFINE_SPINLOCK(g_rdr_syserr_list_lock);
 static struct wakeup_source *blackbox_wl;
@@ -246,7 +247,7 @@ void rdr_system_error(u32 modid, u32 arg1, u32 arg2)
 	}
 
 	if (rdr_register_syserr(modid, arg1, arg2))
-		up(&rdr_sem);
+		wake_up(&rdr_wq);
 	BB_PR_END();
 }
 EXPORT_SYMBOL(rdr_system_error);
@@ -395,10 +396,13 @@ static int rdr_main_thread_body(void *arg)
 	BB_PR_START();
 
 	while (!kthread_should_stop()) {
-		if (down_timeout(&rdr_sem, jiffies_time)) {
-			if (rdr_syserr_list_empty())
-				continue;
-		}
+		/* An idle wait does not count in the load average. */
+		wait_event_idle_timeout(rdr_wq,
+					!rdr_syserr_list_empty() ||
+					kthread_should_stop(),
+					jiffies_time);
+		if (rdr_syserr_list_empty())
+			continue;
 		BB_DBG("enter into a new while =============\n");
 		BB_DBG("============wait for fs ready start =============\n");
 		while (rdr_wait_partition(PATH_MNTN_PARTITION,
@@ -430,8 +434,6 @@ static int rdr_func_init(struct platform_device *pdev)
 		return -EBUSY;
 	}
 
-	sema_init(&rdr_sem, 0);
-
 	init_done = true;
 	return 0;
 }
-- 
