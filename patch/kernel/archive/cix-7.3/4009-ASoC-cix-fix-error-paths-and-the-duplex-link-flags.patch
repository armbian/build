From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Igor Pecovnik <igor@armbian.com>
Date: Tue, 17 Nov 2026 08:45:13 +0000
Subject: ASoC: cix: fix error paths and the duplex link flags

- The DAI link with both playback_only and capture_only set fails PCM
  creation on 7.3. The duplex ALC5682 link then breaks the card. Set
  neither flag.
- Without a bitclock or frame master phandle, set the codec as clock
  consumer, as snd_soc_of_parse_daifmt() did.
- Do not read the missing cpu node in the error message.
- Free the devm DMA config with devm_kfree().

Assisted-by: Claude Opus 5.5
Signed-off-by: Igor Pecovnik <igor@armbian.com>
---
 sound/soc/cix/card-utils.c  | 8 +++++---
 sound/soc/cix/cdns_i2s_mc.c | 2 +-
 sound/soc/cix/cdns_i2s_sc.c | 2 +-
 3 files changed, 7 insertions(+), 5 deletions(-)

diff --git a/sound/soc/cix/card-utils.c b/sound/soc/cix/card-utils.c
index 111111111111..222222222222 100644
--- a/sound/soc/cix/card-utils.c
+++ b/sound/soc/cix/card-utils.c
@@ -96,6 +96,9 @@ static int cix_dailink_parsing_fmt(struct device_node *np,
 		else
 			dai_fmt |= SND_SOC_DAIFMT_CBC_CFC;
 #endif
+	} else {
+		/* No master phandle: the codec is the clock consumer. */
+		dai_fmt |= SND_SOC_DAIFMT_CBC_CFC;
 	}
 	of_node_put(bitclkmaster);
 	of_node_put(framemaster);
@@ -487,7 +490,7 @@ int cix_card_parse_of(struct cix_asoc_card *priv)
 
 		cpu = of_get_child_by_name(np, "cpu");
 		if (!cpu) {
-			dev_err(dev, "%s: can't find cpu device node\n", cpu->name);
+			dev_err(dev, "%s: can't find cpu device node\n", np->name);
 			ret = -EINVAL;
 			goto err_put_cpu;
 		}
@@ -712,8 +715,7 @@ static struct snd_soc_dai_link sky1_dailink[] = {
 		.dpcm_playback = 1,
 		.dpcm_capture = 1,
 #else
-		.playback_only = 1,
-		.capture_only = 1,
+		/* Duplex: set neither playback_only nor capture_only. */
 #endif
 		.ops = &cix_dailink_ops,
 		SND_SOC_DAILINK_REG(cix_i2s0_sc_alc5682),
diff --git a/sound/soc/cix/cdns_i2s_mc.c b/sound/soc/cix/cdns_i2s_mc.c
index 111111111111..222222222222 100644
--- a/sound/soc/cix/cdns_i2s_mc.c
+++ b/sound/soc/cix/cdns_i2s_mc.c
@@ -887,7 +887,7 @@ static struct snd_dmaengine_pcm_config *devm_snd_pcm_alloc_config(
 
 ERROR:
 	if (config)
-		kfree(config);
+		devm_kfree(dev, config);
 	dev_err(dev, "snd pcm alloc config fail\n");
 
 	return NULL;
diff --git a/sound/soc/cix/cdns_i2s_sc.c b/sound/soc/cix/cdns_i2s_sc.c
index 111111111111..222222222222 100644
--- a/sound/soc/cix/cdns_i2s_sc.c
+++ b/sound/soc/cix/cdns_i2s_sc.c
@@ -1028,7 +1028,7 @@ static struct snd_dmaengine_pcm_config *devm_snd_pcm_alloc_config(
 
 ERROR:
 	if (config)
-		kfree(config);
+		devm_kfree(dev, config);
 	dev_err(dev, "snd pcm alloc config fail\n");
 
 	return NULL;
-- 
Armbian

