From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Igor Pecovnik <igor@armbian.com>
Date: Sun, 15 Nov 2026 17:50:21 +0000
Subject: [PATCH] drm: cix: adapt to the 7.3 DRM API

7.3 renames struct drm_atomic_state to struct drm_atomic_commit and
removes drm_panel_init() and of_drm_get_panel_orientation().

Signed-off-by: Igor Pecovnik <igor@armbian.com>

---
 drivers/gpu/drm/cix/dptx/cix_edp_panel.c      | 13 +++--
 drivers/gpu/drm/cix/dptx/trilin_dptx.c        | 16 ++++--
 drivers/gpu/drm/cix/dptx/trilin_dptx.h        |  2 +-
 drivers/gpu/drm/cix/dptx/trilin_drm.c         | 10 ++--
 drivers/gpu/drm/cix/dptx/trilin_drm_mst.c     | 12 ++---
 drivers/gpu/drm/cix/linlon-dp/linlondp_crtc.c |  8 +--
 drivers/gpu/drm/cix/linlon-dp/linlondp_kms.c  | 24 ++++-----
 drivers/gpu/drm/cix/linlon-dp/linlondp_kms.h  |  2 +-
 .../gpu/drm/cix/linlon-dp/linlondp_pipeline.h | 30 +++++------
 .../cix/linlon-dp/linlondp_pipeline_state.c   | 52 +++++++++----------
 .../gpu/drm/cix/linlon-dp/linlondp_plane.c    |  4 +-
 drivers/gpu/drm/cix/linlon-dp/linlondp_pm.c   |  4 +-
 12 files changed, 93 insertions(+), 84 deletions(-)

diff --git a/drivers/gpu/drm/cix/dptx/cix_edp_panel.c b/drivers/gpu/drm/cix/dptx/cix_edp_panel.c
index 1a9f8d1d6..bf9489a18 100644
--- a/drivers/gpu/drm/cix/dptx/cix_edp_panel.c
+++ b/drivers/gpu/drm/cix/dptx/cix_edp_panel.c
@@ -39,6 +39,7 @@
 
 #include <drm/drm_crtc.h>
 #include <drm/drm_device.h>
+#include <drm/drm_of.h>
 #include <drm/drm_panel.h>
 #include <linux/acpi.h>
 #include <linux/backlight.h>
@@ -628,9 +629,10 @@ static int cix_edp_panel_probe(struct device *dev, const struct panel_desc *desc
 
 	dev_info(dev, "%s, begin\n", __func__);
 
-	panel = devm_kzalloc(dev, sizeof(*panel), GFP_KERNEL);
-	if (!panel)
-		return -ENOMEM;
+	panel = devm_drm_panel_alloc(dev, struct cix_edp_panel, base,
+				     &cix_edp_panel_funcs, DRM_MODE_CONNECTOR_eDP);
+	if (IS_ERR(panel))
+		return PTR_ERR(panel);
 
 	panel->enabled = false;
 	panel->prepared = false;
@@ -670,7 +672,7 @@ static int cix_edp_panel_probe(struct device *dev, const struct panel_desc *desc
 	if (has_acpi_companion(dev)) {
 		err = acpi_drm_get_panel_orientation(dev, &panel->orientation);
 	} else {
-		err = of_drm_get_panel_orientation(dev->of_node, &panel->orientation);
+		err = drm_of_get_panel_orientation(dev->of_node, &panel->orientation);
 	}
 	
 	if (err) {
@@ -690,9 +692,6 @@ static int cix_edp_panel_probe(struct device *dev, const struct panel_desc *desc
 	if (desc->bpc != 6 && desc->bpc != 8)
 		dev_warn(dev, "Expected bpc in {6,8} but got: %u\n", desc->bpc);
 
-	drm_panel_init(&panel->base, dev, &cix_edp_panel_funcs,
-		       DRM_MODE_CONNECTOR_eDP);
-
 	if (has_acpi_companion(dev)) {
 		err = drm_panel_acpi_backlight(&panel->base);
 	} else {
diff --git a/drivers/gpu/drm/cix/dptx/trilin_dptx.c b/drivers/gpu/drm/cix/dptx/trilin_dptx.c
