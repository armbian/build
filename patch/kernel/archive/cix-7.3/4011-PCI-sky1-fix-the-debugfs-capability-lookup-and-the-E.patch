From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Igor Pecovnik <igor@armbian.com>
Date: Tue, 17 Nov 2026 08:45:13 +0000
Subject: PCI: sky1: fix the debugfs capability lookup and the ECAM high
 address

- debugfs passed the mapped register window to
  cdns_pcie_find_capability(), which expects a struct cdns_pcie.
  Use sky1_cdns_pcie_find_capability(), as the driver does.
- Write the upper 32 bits of the ECAM base to CPU_ADDR1. An ECAM
  window above 4 GiB was programmed at address 0.

Assisted-by: Claude Opus 5.5
Signed-off-by: Igor Pecovnik <igor@armbian.com>
---
 drivers/pci/controller/cadence/pci-sky1-debugfs.c      | 6 +++---
 drivers/pci/controller/cadence/pcie-cadence-host-hpa.c | 3 ++-
 2 files changed, 5 insertions(+), 4 deletions(-)

diff --git a/drivers/pci/controller/cadence/pci-sky1-debugfs.c b/drivers/pci/controller/cadence/pci-sky1-debugfs.c
index 111111111111..222222222222 100644
--- a/drivers/pci/controller/cadence/pci-sky1-debugfs.c
+++ b/drivers/pci/controller/cadence/pci-sky1-debugfs.c
@@ -896,7 +896,7 @@ static void sky1_pcie_link_set_speed(struct sky1_pcie *pcie, u32 link_gen)
 	u8 offset;
 
 	reg_base = pcie->reg_base + CDNS_PCIE_HPA_RP_BASE;
-	offset = cdns_pcie_find_capability(reg_base, PCI_CAP_ID_EXP);
+	offset = sky1_cdns_pcie_find_capability(reg_base, PCI_CAP_ID_EXP);
 	dev_info(pcie->dev, "PCI_CAP_ID_EXP: 0x%x\n", offset);
 
 	cap = readl(reg_base + offset + PCI_EXP_LNKCAP);
@@ -938,7 +938,7 @@ static void sky1_pcie_set_speed_retrain(struct sky1_pcie *pcie)
 	char *speed;
 
 	reg_base = pcie->reg_base + CDNS_PCIE_HPA_RP_BASE;
-	offset = cdns_pcie_find_capability(reg_base, PCI_CAP_ID_EXP);
+	offset = sky1_cdns_pcie_find_capability(reg_base, PCI_CAP_ID_EXP);
 	val = readl(reg_base + offset + PCI_EXP_LNKCTL);
 	val |= PCI_EXP_LNKCTL_RL;
 	writel(val, reg_base + offset + PCI_EXP_LNKCTL);
@@ -1117,7 +1117,7 @@ static ssize_t sky1_pcie_compliance_write(struct file *file,
 	if (!ret) {
 		dev_info(pcie->dev, "type: %d\n", type);
 		reg_base = pcie->reg_base + CDNS_PCIE_HPA_RP_BASE;
-		offset = cdns_pcie_find_capability(reg_base, PCI_CAP_ID_EXP);
+		offset = sky1_cdns_pcie_find_capability(reg_base, PCI_CAP_ID_EXP);
 		dev_info(pcie->dev, "PCI_CAP_ID_EXP: 0x%x\n", offset);
 		val = readl(reg_base + offset + PCI_EXP_LNKCTL2);
 		if (!!type)
diff --git a/drivers/pci/controller/cadence/pcie-cadence-host-hpa.c b/drivers/pci/controller/cadence/pcie-cadence-host-hpa.c
index 111111111111..222222222222 100644
--- a/drivers/pci/controller/cadence/pcie-cadence-host-hpa.c
+++ b/drivers/pci/controller/cadence/pcie-cadence-host-hpa.c
@@ -290,7 +290,8 @@ static int cdns_pcie_hpa_create_region_for_ecam(struct cdns_pcie_rc *rc)
 
 	/* rc0-high-axi-address */
 	cdns_pcie_hpa_writel(pcie, REG_BANK_AXI_SLAVE,
-			     CDNS_PCIE_HPA_AT_OB_REGION_CPU_ADDR1(0), 0x0);
+			     CDNS_PCIE_HPA_AT_OB_REGION_CPU_ADDR1(0),
+			     upper_32_bits(cfg_res->start));
 	/* Type-1 CFG */
 	cdns_pcie_hpa_writel(pcie, REG_BANK_AXI_SLAVE,
 			     CDNS_PCIE_HPA_AT_OB_REGION_DESC0(0),
-- 
