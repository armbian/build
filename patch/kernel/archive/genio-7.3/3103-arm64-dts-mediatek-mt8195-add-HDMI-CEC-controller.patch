From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ricardo Pardini <ricardo@pardini.net>
Date: Sun, 8 Nov 2026 15:52:58 +0100
Subject: arm64: dts: mediatek: mt8195: Add HDMI CEC controller

Add the HDMI CEC controller node, disabled by default.
---
 arch/arm64/boot/dts/mediatek/mt8195.dtsi | 13 ++++++++++
 1 file changed, 13 insertions(+)

diff --git a/arch/arm64/boot/dts/mediatek/mt8195.dtsi b/arch/arm64/boot/dts/mediatek/mt8195.dtsi
index 111111111111..222222222222 100644
--- a/arch/arm64/boot/dts/mediatek/mt8195.dtsi
+++ b/arch/arm64/boot/dts/mediatek/mt8195.dtsi
@@ -869,6 +869,19 @@ apmixedsys: syscon@1000c000 {
 			#clock-cells = <1>;
 		};
 
+		cec: cec@10014000 {
+			compatible = "mediatek,mt8195-cec";
+			reg = <0 0x10014000 0 0x100>;
+			interrupts = <GIC_SPI 680 IRQ_TYPE_LEVEL_HIGH 0>;
+			clocks = <&infracfg_ao CLK_INFRA_AO_CEC_66M_H>,
+				 <&infracfg_ao CLK_INFRA_AO_CEC_66M_B>,
+				 <&infracfg_ao CLK_INFRA_AO_HDMI_32K>,
+				 <&infracfg_ao CLK_INFRA_AO_HDMI_26M>;
+			clock-names = "cec-66m-h", "cec-66m-b", "hdmi-32k", "hdmi-26m";
+			hdmi-phandle = <&hdmi>;
+			status = "disabled";
+		};
+
 		systimer: timer@10017000 {
 			compatible = "mediatek,mt8195-timer",
 				     "mediatek,mt6765-timer";
-- 
Armbian

