From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ricardo Pardini <ricardo@pardini.net>
Date: Sun, 8 Nov 2026 15:52:58 +0100
Subject: drm/mediatek: mtk_hdmi: Register a CEC notifier for HDMI v2

On HDMI v2 (MT8195, MT8188) the CEC controller is a separate block
with its own driver. Let the bridge connector register a CEC notifier,
so the CEC adapter gets the physical address from the EDID.

Look up the MT8173 CEC node only for HDMI v1, which uses it for
hotplug detection. This removes a misleading "Failed to find CEC node"
message on HDMI v2.
---
 drivers/gpu/drm/mediatek/mtk_hdmi.c        |  3 ++-
 drivers/gpu/drm/mediatek/mtk_hdmi_common.c | 10 ++++++++++
 drivers/gpu/drm/mediatek/mtk_hdmi_common.h |  1 +
 3 files changed, 13 insertions(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/mediatek/mtk_hdmi.c b/drivers/gpu/drm/mediatek/mtk_hdmi.c
index 111111111111..222222222222 100644
--- a/drivers/gpu/drm/mediatek/mtk_hdmi.c
+++ b/drivers/gpu/drm/mediatek/mtk_hdmi.c
@@ -1205,7 +1205,8 @@ static const struct mtk_hdmi_ver_conf mtk_hdmi_v1_ver_conf = {
 	.bridge_funcs = &mtk_hdmi_bridge_funcs,
 	.codec_ops = &mtk_hdmi_audio_codec_ops,
 	.mtk_hdmi_clock_names = mtk_hdmi_clk_names,
-	.num_clocks = ARRAY_SIZE(mtk_hdmi_clk_names)
+	.num_clocks = ARRAY_SIZE(mtk_hdmi_clk_names),
+	.has_cec_hpd = true,
 };
 
 static const struct mtk_hdmi_conf mtk_hdmi_conf_mt2701 = {
diff --git a/drivers/gpu/drm/mediatek/mtk_hdmi_common.c b/drivers/gpu/drm/mediatek/mtk_hdmi_common.c
index 111111111111..222222222222 100644
--- a/drivers/gpu/drm/mediatek/mtk_hdmi_common.c
+++ b/drivers/gpu/drm/mediatek/mtk_hdmi_common.c
@@ -344,6 +344,10 @@ static int mtk_hdmi_dt_parse_pdata(struct mtk_hdmi *hdmi, struct platform_device
 	if (ret)
 		return ret;
 
+	/* Only v1 gets hotplug detection from the MT8173 CEC block */
+	if (!hdmi->conf->ver_conf->has_cec_hpd)
+		return 0;
+
 	ret = mtk_hdmi_get_cec_dev(hdmi, dev, np);
 	if (ret == -EOPNOTSUPP)
 		dev_info(dev, "CEC support unavailable: node not found\n");
@@ -446,6 +450,12 @@ struct mtk_hdmi *mtk_hdmi_common_probe(struct platform_device *pdev)
 		hdmi->bridge.ops |= DRM_BRIDGE_OP_HDMI |
 				    DRM_BRIDGE_OP_HDMI_SPD_INFOFRAME;
 
+	/* A separate CEC controller gets the physical address via the notifier */
+	if (!ver_conf->has_cec_hpd) {
+		hdmi->bridge.ops |= DRM_BRIDGE_OP_HDMI_CEC_NOTIFIER;
+		hdmi->bridge.hdmi_cec_dev = dev;
+	}
+
 	hdmi->bridge.type = DRM_MODE_CONNECTOR_HDMIA;
 	hdmi->bridge.ddc = hdmi->ddc_adpt;
 	hdmi->bridge.vendor = "MediaTek";
diff --git a/drivers/gpu/drm/mediatek/mtk_hdmi_common.h b/drivers/gpu/drm/mediatek/mtk_hdmi_common.h
index 111111111111..222222222222 100644
--- a/drivers/gpu/drm/mediatek/mtk_hdmi_common.h
+++ b/drivers/gpu/drm/mediatek/mtk_hdmi_common.h
@@ -138,6 +138,7 @@ struct mtk_hdmi_ver_conf {
 	const char * const *mtk_hdmi_clock_names;
 	int num_clocks;
 	bool interlace_allowed;
+	bool has_cec_hpd;
 };
 
 struct mtk_hdmi_conf {
-- 
