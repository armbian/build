From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Kyrie Wu <kyrie.wu@mediatek.com>
Date: Sat, 19 Sep 2026 15:59:40 +0800
Subject: GENIO: media: mediatek: vcodec: guard empty stateless capture queue

Change-Id: I83eec384b14bd25e375a07b62837909cc575ad94
Signed-off-by: Kyrie Wu <kyrie.wu@mediatek.com>
---
 drivers/media/platform/mediatek/vcodec/decoder/mtk_vcodec_dec_stateless.c | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/drivers/media/platform/mediatek/vcodec/decoder/mtk_vcodec_dec_stateless.c b/drivers/media/platform/mediatek/vcodec/decoder/mtk_vcodec_dec_stateless.c
index 111111111111..222222222222 100644
--- a/drivers/media/platform/mediatek/vcodec/decoder/mtk_vcodec_dec_stateless.c
+++ b/drivers/media/platform/mediatek/vcodec/decoder/mtk_vcodec_dec_stateless.c
@@ -262,6 +262,13 @@ static void mtk_vdec_stateless_cap_to_disp(struct mtk_vcodec_dec_ctx *ctx, int e
 		state = VB2_BUF_STATE_DONE;
 
 	dst_buf = v4l2_m2m_dst_buf_remove(ctx->m2m_ctx);
+	if (!dst_buf) {
+		mtk_v4l2_vdec_err(ctx,
+			"[%d] CAPTURE buffer unavailable on decode completion", ctx->id);
+		kref_put(&req->refcount, mtk_vcodec_dec_request_release);
+		return;
+	}
+
 	v4l2_m2m_buf_done(dst_buf, state);
 	kref_put(&req->refcount, mtk_vcodec_dec_request_release);
 }
-- 
Armbian

