From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ricardo Pardini <ricardo@pardini.net>
Date: Sun, 8 Nov 2026 15:52:58 +0100
Subject: dt-bindings: media: cec: add MediaTek MT8195 HDMI CEC controller

Add the binding for the HDMI CEC controller of the MediaTek MT8195.
It is a separate block from the HDMI transmitter. The MT8188 has the
same block.
---
 Documentation/devicetree/bindings/media/cec/mediatek,mt8195-cec.yaml | 78 ++++++++++
 1 file changed, 78 insertions(+)

diff --git a/Documentation/devicetree/bindings/media/cec/mediatek,mt8195-cec.yaml b/Documentation/devicetree/bindings/media/cec/mediatek,mt8195-cec.yaml
new file mode 100644
index 000000000000..111111111111
--- /dev/null
+++ b/Documentation/devicetree/bindings/media/cec/mediatek,mt8195-cec.yaml
@@ -0,0 +1,78 @@
+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/cec/mediatek,mt8195-cec.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MediaTek MT8195 HDMI CEC controller
+
+maintainers:
+  - Ricardo Pardini <ricardo@pardini.net>
+
+description:
+  The HDMI CEC controller of the MediaTek MT8195 and compatible SoCs.
+  It is a separate block from the HDMI transmitter.
+
+allOf:
+  - $ref: cec-common.yaml#
+
+properties:
+  compatible:
+    oneOf:
+      - const: mediatek,mt8195-cec
+      - items:
+          - const: mediatek,mt8188-cec
+          - const: mediatek,mt8195-cec
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+  clocks:
+    items:
+      - description: CEC 66 MHz H clock gate
+      - description: CEC 66 MHz B clock gate
+      - description: HDMI 32 kHz clock gate
+      - description: HDMI 26 MHz clock gate
+
+  clock-names:
+    items:
+      - const: cec-66m-h
+      - const: cec-66m-b
+      - const: hdmi-32k
+      - const: hdmi-26m
+
+required:
+  - compatible
+  - reg
+  - interrupts
+  - clocks
+  - clock-names
+  - hdmi-phandle
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/mt8195-clk.h>
+    #include <dt-bindings/interrupt-controller/arm-gic.h>
+    #include <dt-bindings/interrupt-controller/irq.h>
+
+    soc {
+        #address-cells = <2>;
+        #size-cells = <2>;
+
+        cec@10014000 {
+            compatible = "mediatek,mt8195-cec";
+            reg = <0 0x10014000 0 0x100>;
+            interrupts = <GIC_SPI 680 IRQ_TYPE_LEVEL_HIGH 0>;
+            clocks = <&infracfg_ao CLK_INFRA_AO_CEC_66M_H>,
+                     <&infracfg_ao CLK_INFRA_AO_CEC_66M_B>,
+                     <&infracfg_ao CLK_INFRA_AO_HDMI_32K>,
+                     <&infracfg_ao CLK_INFRA_AO_HDMI_26M>;
+            clock-names = "cec-66m-h", "cec-66m-b", "hdmi-32k", "hdmi-26m";
+            hdmi-phandle = <&hdmi>;
+        };
+    };
-- 
Armbian

