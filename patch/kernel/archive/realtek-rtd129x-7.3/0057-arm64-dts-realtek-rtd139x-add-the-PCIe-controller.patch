From ac8fa5fd067f1e7a82f23c3e38d423a373525b6f Mon Sep 17 00:00:00 2001
From: Igor Pecovnik <igor@armbian.com>
Date: Thu, 22 Oct 2026 07:49:41 +0000
Subject: [PATCH 57/58] arm64: dts: realtek: rtd139x: add the PCIe controller

Add the PCIe0 host controller node. Boards enable it.

Assisted-by: Claude Opus 5.5
Signed-off-by: Igor Pecovnik <igor@armbian.com>
---
 arch/arm64/boot/dts/realtek/rtd139x.dtsi | 34 ++++++++++++++++++++++++
 1 file changed, 34 insertions(+)

diff --git a/arch/arm64/boot/dts/realtek/rtd139x.dtsi b/arch/arm64/boot/dts/realtek/rtd139x.dtsi
index b92bcd4a5..cf50c075a 100644
--- a/arch/arm64/boot/dts/realtek/rtd139x.dtsi
+++ b/arch/arm64/boot/dts/realtek/rtd139x.dtsi
@@ -155,6 +155,40 @@ crt_clk: clock-controller@c {
 	};
 };
 
+/*
+ * PCIe0, Gen2 x1. The SerDes is shared with SGMII. The second range holds
+ * the SerDes select, the third the ISO pin mux of CLKREQ# (gpio_46). The
+ * memory window is 120 KiB, so only small BARs fit.
+ */
+&rbus {
+	pcie: pcie@60000 {
+		compatible = "realtek,rtd1395-pcie";
+		reg = <0x60000 0x1000>, <0x1c800 0x100>, <0x4e000 0x100>;
+		reg-names = "ctrl", "sys", "pinmux";
+		interrupts = <GIC_SPI 61 IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&crt_clk 1>;			/* CLK_EN1: PCIE0 */
+		resets = <&reset2 RTD1295_RSTN_PCIE0_STITCH>,
+			 <&reset2 RTD1295_RSTN_PCIE0>,
+			 <&reset2 RTD1295_RSTN_PCIE0_CORE>,
+			 <&reset2 RTD1295_RSTN_PCIE0_POWER>,
+			 <&reset2 RTD1295_RSTN_PCIE0_NONSTICH>,
+			 <&reset2 RTD1295_RSTN_PCIE0_PHY>,
+			 <&reset4 RTD1295_RSTN_PCIE0_PHY_MDIO>,
+			 <&reset4 16>;			/* PCIE0_SGMII_MDIO */
+		reset-names = "stitch", "rstn", "core", "power", "nonstitch",
+			      "phy", "phy-mdio", "sgmii-mdio";
+		device_type = "pci";
+		#address-cells = <3>;
+		#size-cells = <2>;
+		bus-range = <0x00 0x00>;
+		ranges = <0x02000000 0x0 0x98062000 0x62000 0x0 0x1e000>;
+		linux,pci-domain = <0>;
+		num-lanes = <1>;
+		max-link-speed = <1>;			/* BSP default */
+		status = "disabled";
+	};
+};
+
 &iso {
 	iso_irq_mux: interrupt-controller@0 {
 		compatible = "realtek,rtd1395-iso-irq-mux";
-- 
