From 12b469367ed6533f4193039c6a4a095849b68ee7 Mon Sep 17 00:00:00 2001
From: Igor Pecovnik <igor@armbian.com>
Date: Thu, 22 Oct 2026 07:20:26 +0000
Subject: [PATCH 54/55] arm64: dts: realtek: bpi-m4: enable HDMI audio output

Enable HDMI audio playback through the audio CPU firmware. The board
then has an ALSA playback device for HDMI.

Assisted-by: Claude Opus 5.5
Signed-off-by: Igor Pecovnik <igor@armbian.com>
---
 arch/arm64/boot/dts/realtek/rtd1395-bpi-m4.dts | 1 +
 1 file changed, 1 insertion(+)

diff --git a/arch/arm64/boot/dts/realtek/rtd1395-bpi-m4.dts b/arch/arm64/boot/dts/realtek/rtd1395-bpi-m4.dts
index 9ca72af3b..16b73f5de 100644
--- a/arch/arm64/boot/dts/realtek/rtd1395-bpi-m4.dts
+++ b/arch/arm64/boot/dts/realtek/rtd1395-bpi-m4.dts
@@ -451,6 +451,7 @@ acpu: audio-cpu@1a104 {
 				<&acpu_audio_heap>, <&ion_media1>, <&acpu_fw>;
 		memory-region-names = "comm", "ring", "audio", "media",
 				      "firmware";
+		realtek,hdmi-audio-out;
 	};
 };
 
-- 
