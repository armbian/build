From 1e3529718bff370e684f26a70ad8e100c4273d93 Mon Sep 17 00:00:00 2001
From: Igor Pecovnik <igor@armbian.com>
Date: Wed, 21 Oct 2026 10:37:08 +0000
Subject: [PATCH 34/46] arm64: dts: realtek: rtd139x: add muxes, clock gates
 and GPIOs

Add the interrupt muxes, the clock gates and the ISO GPIOs. Give the
UARTs their interrupts. Start the CPUs through the spin table.

Assisted-by: Claude Opus 5.5
Signed-off-by: Igor Pecovnik <igor@armbian.com>
---
 arch/arm64/boot/dts/realtek/rtd1395.dtsi |  8 +++++
 arch/arm64/boot/dts/realtek/rtd139x.dtsi | 46 ++++++++++++++++++++++++
 2 files changed, 54 insertions(+)

diff --git a/arch/arm64/boot/dts/realtek/rtd1395.dtsi b/arch/arm64/boot/dts/realtek/rtd1395.dtsi
index 2efe5b25c..a51c43edb 100644
--- a/arch/arm64/boot/dts/realtek/rtd1395.dtsi
+++ b/arch/arm64/boot/dts/realtek/rtd1395.dtsi
@@ -18,6 +18,8 @@ cpu0: cpu@0 {
 			device_type = "cpu";
 			compatible = "arm,cortex-a53";
 			reg = <0x0 0x0>;
+			enable-method = "spin-table";
+			cpu-release-addr = <0x0 0x98007f30>;
 			next-level-cache = <&l2>;
 		};
 
@@ -25,6 +27,8 @@ cpu1: cpu@1 {
 			device_type = "cpu";
 			compatible = "arm,cortex-a53";
 			reg = <0x0 0x1>;
+			enable-method = "spin-table";
+			cpu-release-addr = <0x0 0x98007f30>;
 			next-level-cache = <&l2>;
 		};
 
@@ -32,6 +36,8 @@ cpu2: cpu@2 {
 			device_type = "cpu";
 			compatible = "arm,cortex-a53";
 			reg = <0x0 0x2>;
+			enable-method = "spin-table";
+			cpu-release-addr = <0x0 0x98007f30>;
 			next-level-cache = <&l2>;
 		};
 
@@ -39,6 +45,8 @@ cpu3: cpu@3 {
 			device_type = "cpu";
 			compatible = "arm,cortex-a53";
 			reg = <0x0 0x3>;
+			enable-method = "spin-table";
+			cpu-release-addr = <0x0 0x98007f30>;
 			next-level-cache = <&l2>;
 		};
 
diff --git a/arch/arm64/boot/dts/realtek/rtd139x.dtsi b/arch/arm64/boot/dts/realtek/rtd139x.dtsi
index e8af39193..b92bcd4a5 100644
--- a/arch/arm64/boot/dts/realtek/rtd139x.dtsi
+++ b/arch/arm64/boot/dts/realtek/rtd139x.dtsi
@@ -146,7 +146,39 @@ reset4: reset-controller@50 {
 	};
 };
 
+&crt {
+	/* CLK_EN1/CLK_EN2: specifier n is bit n of CLK_EN1, bit n-32 of CLK_EN2 */
+	crt_clk: clock-controller@c {
+		compatible = "realtek,rtd1295-crt-clk";
+		reg = <0xc 0x8>;
+		#clock-cells = <1>;
+	};
+};
+
 &iso {
+	iso_irq_mux: interrupt-controller@0 {
+		compatible = "realtek,rtd1395-iso-irq-mux";
+		reg = <0x0 0x4>, <0x40 0x4>;
+		interrupts = <GIC_SPI 41 IRQ_TYPE_LEVEL_HIGH>;
+		interrupt-controller;
+		#interrupt-cells = <1>;
+	};
+
+	iso_clk: clock-controller@8c {
+		compatible = "realtek,rtd1295-iso-clk";
+		reg = <0x8c 0x4>;
+		#clock-cells = <1>;
+	};
+
+	iso_gpio: gpio@100 {
+		compatible = "realtek,rtd1395-iso-gpio";
+		reg = <0x100 0x100>, <0x0 0x100>;
+		interrupt-parent = <&iso_irq_mux>;
+		interrupts = <19>, <20>;	/* assert, deassert */
+		gpio-controller;
+		#gpio-cells = <2>;
+	};
+
 	iso_reset: reset-controller@88 {
 		compatible = "snps,dw-low-reset";
 		reg = <0x88 0x4>;
@@ -165,18 +197,30 @@ uart0: serial@800 {
 		reg-shift = <2>;
 		reg-io-width = <4>;
 		clock-frequency = <27000000>;
+		interrupt-parent = <&iso_irq_mux>;
+		interrupts = <2>;
 		resets = <&iso_reset RTD1295_ISO_RSTN_UR0>;
 		status = "disabled";
 	};
 };
 
 &misc {
+	misc_irq_mux: interrupt-controller@c {
+		compatible = "realtek,rtd1395-misc-irq-mux";
+		reg = <0xc 0x4>, <0x80 0x4>;
+		interrupts = <GIC_SPI 40 IRQ_TYPE_LEVEL_HIGH>;
+		interrupt-controller;
+		#interrupt-cells = <1>;
+	};
+
 	uart1: serial@200 {
 		compatible = "snps,dw-apb-uart";
 		reg = <0x200 0x100>;
 		reg-shift = <2>;
 		reg-io-width = <4>;
 		clock-frequency = <432000000>;
+		interrupt-parent = <&misc_irq_mux>;
+		interrupts = <3>;
 		resets = <&reset2 RTD1295_RSTN_UR1>;
 		status = "disabled";
 	};
@@ -187,6 +231,8 @@ uart2: serial@400 {
 		reg-shift = <2>;
 		reg-io-width = <4>;
 		clock-frequency = <432000000>;
+		interrupt-parent = <&misc_irq_mux>;
+		interrupts = <8>;
 		resets = <&reset2 RTD1295_RSTN_UR2>;
 		status = "disabled";
 	};
-- 
2.53.0

