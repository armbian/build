From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Igor Pecovnik <igor@armbian.com>
Date: Tue, 13 Oct 2026 21:40:46 +0200
Subject: [PATCH] arm64: dts: realtek: bpi-w2: make the Type-C port dual role

Add the Type-C controller and the VBUS regulator of port 0. The port then
works as host and as device.

Move the PM register of port 0 to 0x13364. 0x13360 is a Type-C register.

Signed-off-by: Igor Pecovnik <igor@armbian.com>
---
 .../boot/dts/realtek/rtd1296-bananapi-w2.dts  | 42 +++++++++++++++----
 1 file changed, 34 insertions(+), 8 deletions(-)

diff --git a/arch/arm64/boot/dts/realtek/rtd1296-bananapi-w2.dts b/arch/arm64/boot/dts/realtek/rtd1296-bananapi-w2.dts
index cd28598..110f11c 100644
--- a/arch/arm64/boot/dts/realtek/rtd1296-bananapi-w2.dts
+++ b/arch/arm64/boot/dts/realtek/rtd1296-bananapi-w2.dts
@@ -16,6 +16,7 @@
 
 /dts-v1/;
 
+#include <dt-bindings/gpio/gpio.h>
 #include <dt-bindings/thermal/thermal.h>
 #include "rtd1296.dtsi"
 
@@ -501,16 +502,14 @@
  * <PHY data (wrapper)>, <PHY control (dwc3 core)>, and phy-rtk-usb2.c maps
  * index 0 to reg_wrap_vstatus and index 1 to reg_gusb2phyacc0.
  *
- * Port 0 is the Type-C port, as a device (below). Port 2, the EHCI/OHCI
- * pair, uses the generic drivers.
+ * Port 0 is the Type-C port. The Type-C driver switches it between host
+ * and device. Port 2, the EHCI/OHCI pair, uses the generic drivers.
  *
  * The USB clock gate and resets used to be left to the bootloader. LK runs
  * `usb start` and leaves them open, but the BSP u-boot on an SD boot does
  * not, and dwc3 then read garbage from GSNPSID. They are now claimed below
- * through crt_clk and reset1/reset2. Port power (VBUS) is still whatever
- * the bootloader set, since the BSP drives it from its "Realtek,usb-manager"
- * through GPIOs and mainline has no equivalent. It measured on after an SD
- * boot: the onboard hub enumerated.
+ * through crt_clk and reset1/reset2. VBUS of ports 0 and 2 comes from the
+ * GPIO regulators below. Ports 1 and 3 have VBUS on without a GPIO.
  */
 &rbus {
 	/*
@@ -790,7 +789,8 @@
 
 	usb@13200 {
 		compatible = "realtek,rtd1295-dwc3", "realtek,rtd-dwc3";
-		reg = <0x13200 0x140>, <0x13360 0x4>;
+		/* 0x1334c-0x13363 holds the Type-C registers */
+		reg = <0x13200 0x140>, <0x13364 0x4>;
 		#address-cells = <1>;
 		#size-cells = <1>;
 		ranges;
@@ -804,11 +804,27 @@
 			interrupts = <GIC_SPI 21 IRQ_TYPE_LEVEL_HIGH>;
 			phys = <&usb_drd_usb2phy>, <&usb_drd_usb3phy>;
 			phy-names = "usb2-phy", "usb3-phy";
-			dr_mode = "peripheral";
+			dr_mode = "otg";
+			extcon = <&type_c>;
 			snps,dis_u2_susphy_quirk;
 		};
 	};
 
+	type_c: type-c@1334c {
+		compatible = "realtek,rtd1295-type-c";
+		reg = <0x1334c 0x18>;
+		interrupts = <GIC_SPI 60 IRQ_TYPE_LEVEL_HIGH>;
+		realtek,rd-ctrl-gpios = <&iso_gpio 34 GPIO_ACTIVE_HIGH>;
+		vbus-supply = <&usb_p0_vbus>;
+
+		connector {
+			compatible = "usb-c-connector";
+			label = "USB-C";
+			data-role = "dual";
+			power-role = "dual";
+		};
+	};
+
 	/* Port 1: USB 2.0 host */
 	usb_u2host_usb2phy: usb-phy@13c14 {
 		compatible = "realtek,rtd1295-usb2phy";
@@ -939,6 +955,16 @@
 		enable-active-high;
 	};
 
+	/* VBUS of the Type-C port (port 0), on in host mode */
+	usb_p0_vbus: regulator-usb-p0-vbus {
+		compatible = "regulator-fixed";
+		regulator-name = "usb-p0-vbus";
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+		gpio = <&iso_gpio 1 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+	};
+
 	/* VBUS of the USB 2.0 port (port 2) */
 	regulator-usb-p2-vbus {
 		compatible = "regulator-fixed";
-- 
2.53.0

