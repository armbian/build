From 9def6550e1be437544f71516fe543d4dfe29d13c Mon Sep 17 00:00:00 2001
From: Igor Pecovnik <igor@armbian.com>
Date: Thu, 22 Oct 2026 07:00:41 +0000
Subject: [PATCH 50/51] sound: rtd129x-acpu: add the video output only with a
 scanout pool

A board can show a framebuffer that the audio firmware scans out on its
own. Add the video output device only when the DT gives it a scanout
pool.

Assisted-by: Claude Opus 5.5
Signed-off-by: Igor Pecovnik <igor@armbian.com>
---
 sound/realtek-rtd129x-acpu/acpu-rpc.c | 10 ++++++++--
 1 file changed, 8 insertions(+), 2 deletions(-)

diff --git a/sound/realtek-rtd129x-acpu/acpu-rpc.c b/sound/realtek-rtd129x-acpu/acpu-rpc.c
index ff5f981b6..3bf2fa62d 100644
--- a/sound/realtek-rtd129x-acpu/acpu-rpc.c
+++ b/sound/realtek-rtd129x-acpu/acpu-rpc.c
@@ -820,8 +820,14 @@ static int acpu_probe(struct platform_device *pdev)
 	}
 
 	platform_set_drvdata(pdev, acpu);
-	return acpu_add_adev(acpu, RTD_ACPU_PCM_NAME, &acpu->pcm) ?:
-	       acpu_add_adev(acpu, RTD_ACPU_VO_NAME, &acpu->vo);
+	ret = acpu_add_adev(acpu, RTD_ACPU_PCM_NAME, &acpu->pcm);
+	if (ret)
+		return ret;
+	/* without a scanout pool the firmware shows a framebuffer of its own */
+	if (of_property_match_string(dev->of_node, "memory-region-names",
+				     "vo") < 0)
+		return 0;
+	return acpu_add_adev(acpu, RTD_ACPU_VO_NAME, &acpu->vo);
 }
 
 /* A physical address as the firmware wants it */
