diff --git a/Documentation/devicetree/bindings/net/realtek,rtd1295-hwnat.yaml b/Documentation/devicetree/bindings/net/realtek,rtd1295-hwnat.yaml
new file mode 100644
index 000000000000..190a4d01f1d4
--- /dev/null
+++ b/Documentation/devicetree/bindings/net/realtek,rtd1295-hwnat.yaml
@@ -0,0 +1,101 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/net/realtek,rtd1295-hwnat.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Realtek RTD1295/RTD1296 hardware NAT switch core as a NIC
+
+maintainers:
+  - Jalen Lin <jalen.lin@gmail.com>
+
+description: |
+  The RTD1295 and RTD1296 SoCs have a hardware NAT engine: an RTL8197F-style
+  switch core with a CPU port, behind which sit up to three external ports
+  (MAC0: RGMII1 or SGMII, MAC4: the embedded GPHY, MAC5: RGMII0). This
+  binding describes it used as a plain network interface on port 5
+  (RGMII0) with an external PHY, the switch bridging only that port and
+  the CPU. The embedded GPHY is left to the SoC's ordinary GMAC.
+
+allOf:
+  - $ref: ethernet-controller.yaml#
+
+properties:
+  compatible:
+    const: realtek,rtd1295-hwnat
+
+  reg:
+    description: The whole NAT block, switch tables and CPU interface.
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+  clocks:
+    description: The NAT clock gate (CRT CLK_EN2 bit 0).
+    maxItems: 1
+
+  resets:
+    description: The NAT block reset (CRT SOFT_RESET1 bit 1).
+    maxItems: 1
+
+  realtek,sb2:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description:
+      The SB2 system controller, which holds the RGMII0 pad mux, drive and
+      slew-rate registers.
+
+  phy-mode:
+    enum:
+      - rgmii
+      - rgmii-id
+      - rgmii-rxid
+      - rgmii-txid
+
+  mdio:
+    $ref: mdio.yaml#
+    unevaluatedProperties: false
+    description:
+      The switch core's MDIO controller. It drives the pins of the port
+      whose external PHY address matches, so the PHY must be the one on
+      port 5.
+
+required:
+  - compatible
+  - reg
+  - interrupts
+  - clocks
+  - resets
+  - realtek,sb2
+  - phy-mode
+  - phy-handle
+  - mdio
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/interrupt-controller/arm-gic.h>
+    #include <dt-bindings/reset/realtek,rtd1295.h>
+
+    ethernet@98060000 {
+        compatible = "realtek,rtd1295-hwnat";
+        reg = <0x98060000 0x170000>;
+        interrupts = <GIC_SPI 24 IRQ_TYPE_LEVEL_HIGH>;
+        clocks = <&crt_clk 32>;
+        resets = <&reset1 RTD1295_RSTN_NAT>;
+        realtek,sb2 = <&sb2>;
+        phy-mode = "rgmii-id";
+        phy-handle = <&nat_phy>;
+
+        mdio {
+            #address-cells = <1>;
+            #size-cells = <0>;
+
+            nat_phy: ethernet-phy@1 {
+                reg = <1>;
+                realtek,clkout-disable;
+            };
+        };
+    };
+...
