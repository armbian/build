+	depends on ARCH_REALTEK || COMPILE_TEST
+	depends on OF && HAS_IOMEM && HAS_DMA
+	select MFD_SYSCON
+	select PHYLIB
+	select OF_MDIO
+	help
+	  The RTD1295/RTD1296 hardware NAT engine is a small switch core
+	  (an RTL8197F-style one) with a CPU port. This driver uses it as a
+	  plain network interface on its port 5 (RGMII0), with an external
+	  PHY: the second RJ45 of the Banana Pi BPI-W2.
+
+	  To compile this driver as a module, choose M here: the module
+	  will be called rtd1295-hwnat.
+
 config RTASE
 	tristate "Realtek Automotive Switch 9054/9068/9072/9075/9068/9071 PCIe Interface support"
 	depends on PCI
