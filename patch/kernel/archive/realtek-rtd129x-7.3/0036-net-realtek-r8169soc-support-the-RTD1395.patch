+/*
+ * ISO_CLK_EN bits 12:11 gate the ETN system and 250 MHz clocks, and
+ * ISO_SOFT_RESET bits 10:9 hold the GPHY and GMAC in reset (active low).
+ * With no clock driver the vendor's clk_prepare_enable() calls do nothing,
+ * which only works if the bootloader happened to leave the clocks on --
+ * true on the WD box this copy came from, not something to rely on here.
+ * The RTD139x has the same bits.
+ */
+#define ISO_SOFT_RESET		0x088
+#define ISO_CLK_EN		0x08c
+#define ISO_CLK_EN_ETN		(BIT(12) | BIT(11))
+#define ISO_RSTN_ETN		(BIT(10) | BIT(9))
+
+static void rtd_etn_clk(void __iomem *clkaddr, struct clk *sys,
+			    struct clk *c250m, bool on)
+{
+	u32 tmp;
+
+	if (sys && c250m) {
+		if (on) {
+			clk_prepare_enable(sys);
+			clk_prepare_enable(c250m);
+		} else {
+			clk_disable_unprepare(sys);
+			clk_disable_unprepare(c250m);
+		}
+		return;
+	}
+
+	tmp = readl(clkaddr + ISO_CLK_EN);
+	if (on)
+		tmp |= ISO_CLK_EN_ETN;
+	else
+		tmp &= ~ISO_CLK_EN_ETN;
+	writel(tmp, clkaddr + ISO_CLK_EN);
+}
+
+static bool rtd_etn_ready(void __iomem *clkaddr, struct clk *sys,
+			      struct clk *c250m)
+{
+	if (sys && c250m)
+		return __clk_is_enabled(sys) && __clk_is_enabled(c250m);
+
+	return (readl(clkaddr + ISO_CLK_EN) & ISO_CLK_EN_ETN) == ISO_CLK_EN_ETN &&
+	       (readl(clkaddr + ISO_SOFT_RESET) & ISO_RSTN_ETN) == ISO_RSTN_ETN;
+}
