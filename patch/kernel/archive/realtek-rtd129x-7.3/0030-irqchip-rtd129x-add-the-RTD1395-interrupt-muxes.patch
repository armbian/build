From 70504d560bc48779ed697f6ed1b811a782669603 Mon Sep 17 00:00:00 2001
From: Igor Pecovnik <igor@armbian.com>
Date: Wed, 21 Oct 2026 10:37:07 +0000
Subject: [PATCH 30/46] irqchip: rtd129x: add the RTD1395 interrupt muxes

The RTD1395 has the same ISO and MISC muxes as the RTD1295.
Some status bits map to other sources. Add tables for them.

Assisted-by: Claude Opus 5.5
Signed-off-by: Igor Pecovnik <igor@armbian.com>
---
 drivers/irqchip/irq-rtd129x.c | 63 +++++++++++++++++++++++++++++++++++
 1 file changed, 63 insertions(+)

diff --git a/drivers/irqchip/irq-rtd129x.c b/drivers/irqchip/irq-rtd129x.c
index 40403cca2..a7398e15b 100644
--- a/drivers/irqchip/irq-rtd129x.c
+++ b/drivers/irqchip/irq-rtd129x.c
@@ -295,6 +295,53 @@ static int __init rtd129x_irq_mux_init(struct device_node *np,
 	return ret;
 }
 
+/* RTD1395: no MISC GPIO, RTC or I2C2-4; LSADC and GPHY HV moved to ISO */
+static const struct rtd129x_irq_mux_info rtd1395_misc_irq_mux = {
+	.name = "misc",
+	.enable_bit = {
+		[0 ... 31] = RTD129X_IRQ_NONE,
+		[2]  = RTD129X_IRQ_UNGATED,
+		[3]  = 3,			/* UART1 */
+		[5]  = 5,			/* UART1 timeout */
+		[6]  = RTD129X_IRQ_UNGATED,
+		[7]  = RTD129X_IRQ_UNGATED,
+		[8]  = 7,			/* UART2 */
+		[13] = 6,			/* UART2 timeout */
+		[14] = 14,			/* I2C5 */
+		[24] = 24,			/* smartcard 0 */
+		[27] = 27,			/* GSPI */
+		[29] = 29,			/* fan */
+	},
+};
+
+static const struct rtd129x_irq_mux_info rtd1395_iso_irq_mux = {
+	.name = "iso",
+	.enable_bit = {
+		[0 ... 31] = RTD129X_IRQ_NONE,
+		[1]  = RTD129X_IRQ_UNGATED,
+		[2]  = 2,			/* UART0 */
+		[5]  = 5,			/* IrDA */
+		[7]  = RTD129X_IRQ_UNGATED,
+		[8]  = 8,			/* I2C0 */
+		[9]  = RTD129X_IRQ_UNGATED,
+		[11] = 11,			/* I2C1 */
+		[12] = 12,			/* RTC half-second */
+		[13] = 13,			/* RTC alarm */
+		[16] = 16,			/* LSADC0 */
+		[17] = 17,			/* LSADC1 */
+		[19] = 19,			/* GPIO assert */
+		[20] = 20,			/* GPIO deassert */
+		[21] = RTD129X_IRQ_UNGATED,
+		[22] = RTD129X_IRQ_UNGATED,
+		[23] = RTD129X_IRQ_UNGATED,
+		[24] = RTD129X_IRQ_UNGATED,
+		[28] = 28,			/* GPHY HV */
+		[29] = 29,			/* GPHY digital */
+		[30] = 30,			/* GPHY analog */
+		[31] = 31,			/* I2C1 request */
+	},
+};
+
 static int __init rtd1295_misc_irq_mux_init(struct device_node *np,
 					    struct device_node *parent)
 {
@@ -307,6 +354,22 @@ static int __init rtd1295_iso_irq_mux_init(struct device_node *np,
 	return rtd129x_irq_mux_init(np, parent, &rtd1295_iso_irq_mux);
 }
 
+static int __init rtd1395_misc_irq_mux_init(struct device_node *np,
+					    struct device_node *parent)
+{
+	return rtd129x_irq_mux_init(np, parent, &rtd1395_misc_irq_mux);
+}
+
+static int __init rtd1395_iso_irq_mux_init(struct device_node *np,
+					   struct device_node *parent)
+{
+	return rtd129x_irq_mux_init(np, parent, &rtd1395_iso_irq_mux);
+}
+
+IRQCHIP_DECLARE(rtd1395_misc_irq_mux, "realtek,rtd1395-misc-irq-mux",
+		rtd1395_misc_irq_mux_init);
+IRQCHIP_DECLARE(rtd1395_iso_irq_mux, "realtek,rtd1395-iso-irq-mux",
+		rtd1395_iso_irq_mux_init);
 IRQCHIP_DECLARE(rtd1295_misc_irq_mux, "realtek,rtd1295-misc-irq-mux",
 		rtd1295_misc_irq_mux_init);
 IRQCHIP_DECLARE(rtd1295_iso_irq_mux, "realtek,rtd1295-iso-irq-mux",
-- 
2.53.0

