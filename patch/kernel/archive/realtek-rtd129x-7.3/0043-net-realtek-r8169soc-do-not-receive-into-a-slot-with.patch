From 94fc6697cc3de05c27f2cd87e43230eee2251c8e Mon Sep 17 00:00:00 2001
From: Igor Pecovnik <igor@armbian.com>
Date: Wed, 21 Oct 2026 15:40:34 +0000
Subject: [PATCH 43/60] net: realtek: r8169soc: do not receive into a slot
 without a buffer

A ring reset that cannot refill the ring (no memory) enables NAPI on
a partly empty ring. Its zeroed descriptors look done, and RX then
syncs DMA address 0. Stop at such a slot until a reset refills it.

Assisted-by: Claude Opus 5.5
Signed-off-by: Igor Pecovnik <igor@armbian.com>
---
 drivers/net/ethernet/realtek/r8169soc.c | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/drivers/net/ethernet/realtek/r8169soc.c b/drivers/net/ethernet/realtek/r8169soc.c
index 67f96ca08..17f7f258f 100644
--- a/drivers/net/ethernet/realtek/r8169soc.c
+++ b/drivers/net/ethernet/realtek/r8169soc.c
@@ -4080,6 +4080,19 @@ static int rtl_rx(struct net_device *dev, struct rtl8169_private *tp,
 process_pkt:
 
 			skb = tp->Rx_databuff[entry];
+			/*
+			 * A slot without a buffer: a ring reset could not
+			 * refill it (no memory). Its descriptor is zeroed and
+			 * looks done. Stop here and reset the ring to refill it.
+			 */
+			if (unlikely(!skb)) {
+				if (net_ratelimit())
+					netif_err(tp, rx_err, dev,
+						  "Rx slot %u has no buffer\n",
+						  entry);
+				rtl_schedule_task(tp, RTL_FLAG_TASK_RESET_PENDING);
+				break;
+			}
 			addr = le64_to_cpu(desc->addr);
 			if (likely(!(dev->features & NETIF_F_RXFCS)))
 				pkt_size = (status & 0x00003fff) - 4;
