From 8f514a70b2e475b01c11e3db3a2eea20b5d720c2 Mon Sep 17 00:00:00 2001
From: Igor Pecovnik <igor@armbian.com>
Date: Thu, 22 Oct 2026 07:00:41 +0000
Subject: [PATCH 51/51] arm64: dts: realtek: bpi-m4: add the HDMI framebuffer

U-Boot has the audio firmware show a framebuffer as its boot logo, and
the firmware keeps reading it. Reserve it and describe it as a simple
framebuffer: 1920x1080 at the firmware default 1080p60.

Assisted-by: Claude Opus 5.5
Signed-off-by: Igor Pecovnik <igor@armbian.com>
---
 .../arm64/boot/dts/realtek/rtd1395-bpi-m4.dts | 28 +++++++++++++------
 1 file changed, 20 insertions(+), 8 deletions(-)

diff --git a/arch/arm64/boot/dts/realtek/rtd1395-bpi-m4.dts b/arch/arm64/boot/dts/realtek/rtd1395-bpi-m4.dts
index e2aec532f..9ca72af3b 100644
--- a/arch/arm64/boot/dts/realtek/rtd1395-bpi-m4.dts
+++ b/arch/arm64/boot/dts/realtek/rtd1395-bpi-m4.dts
@@ -28,7 +28,20 @@ aliases {
 	};
 
 	chosen {
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges;
 		stdout-path = "serial0:115200n8";
+
+		/* the buffer the audio firmware shows on HDMI, at 1080p60 */
+		framebuffer@14200000 {
+			compatible = "simple-framebuffer";
+			reg = <0x14200000 0x007e9000>;
+			width = <1920>;
+			height = <1080>;
+			stride = <7680>;
+			format = "x8b8g8r8";
+		};
 	};
 
 	/* VBUS of the USB host port 2, ISO GPIO 49, low active */
@@ -76,12 +89,12 @@ acpu_idmem: acpu-idmem@10000000 {
 		};
 
 		/*
-		 * Scanout buffers for the HDMI output (rtd129x-vo). The audio
-		 * CPU reads them, so they must be below 512 MiB.
+		 * The HDMI framebuffer: U-Boot has the audio firmware show it
+		 * as its boot logo, and the firmware keeps reading it. 1920x1080,
+		 * then the firmware's secure VO area.
 		 */
-		vo_pool: vo-pool@11000000 {
-			compatible = "shared-dma-pool";
-			reg = <0x11000000 0x03200000>;
+		hdmi_fb: framebuffer@14200000 {
+			reg = <0x14200000 0x00900000>;
 			no-map;
 		};
 
@@ -435,10 +448,9 @@ acpu: audio-cpu@1a104 {
 		reg = <0x1a104 0xc>;
 		interrupts = <GIC_SPI 33 IRQ_TYPE_LEVEL_HIGH>;
 		memory-region = <&rpc_comm>, <&rpc_ringbuf>,
-				<&acpu_audio_heap>, <&ion_media1>, <&acpu_fw>,
-				<&vo_pool>;
+				<&acpu_audio_heap>, <&ion_media1>, <&acpu_fw>;
 		memory-region-names = "comm", "ring", "audio", "media",
-				      "firmware", "vo";
+				      "firmware";
 	};
 };
 
