From a0a7e45f1e103bd7d9af7f354a041cfde1ec5a0b Mon Sep 17 00:00:00 2001
From: Igor Pecovnik <igor@armbian.com>
Date: Thu, 22 Oct 2026 07:35:20 +0000
Subject: [PATCH 55/55] sound: rtd129x-acpu: route the HDMI audio output to
 HDMI

The firmware sends its audio output to HDMI only after the system CPU
enables it, as the BSP HDMI service does. Enable the output and set the
1080p60 TMDS clock when the PCM opens.

Assisted-by: Claude Opus 5.5
Signed-off-by: Igor Pecovnik <igor@armbian.com>
---
 sound/realtek-rtd129x-acpu/acpu-ao.c | 27 +++++++++++++++++++++++++++
 1 file changed, 27 insertions(+)

diff --git a/sound/realtek-rtd129x-acpu/acpu-ao.c b/sound/realtek-rtd129x-acpu/acpu-ao.c
index c3731f433..df89c4929 100644
--- a/sound/realtek-rtd129x-acpu/acpu-ao.c
+++ b/sound/realtek-rtd129x-acpu/acpu-ao.c
@@ -182,6 +182,31 @@ static int ho_call(struct hdmi_out *ho, u32 cmd, bool check)
 	return 0;
 }
 
+/*
+ * Route the audio output to HDMI, as the BSP HDMI service does when a sink
+ * is connected: AUDIO_HDMI_OUT_EDID_DATA2 { Version, HDMI_output_enable,
+ * EDID_DATA_addr } and AUDIO_HDMI_SET { HDMI_Frequency }, the TMDS clock
+ * in MHz (148 for 1080p60). No EDID: the firmware takes 2 ch LPCM.
+ */
+#define RTD_ACPU_HDMI_OUT_EDID2	14
+#define RTD_ACPU_HDMI_SET	15
+
+static int ho_hdmi_enable(struct hdmi_out *ho)
+{
+	int ret;
+
+	ho_begin(ho);
+	*ho_arg(ho, 0) = cpu_to_be32(1);
+	*ho_arg(ho, 1) = cpu_to_be32(1);
+	*ho_arg(ho, 2) = 0;
+	ret = ho_call(ho, RTD_ACPU_HDMI_OUT_EDID2, false);
+	if (ret)
+		return ret;
+	ho_begin(ho);
+	*ho_arg(ho, 0) = cpu_to_be32(148);
+	return ho_call(ho, RTD_ACPU_HDMI_SET, false);
+}
+
 /* RPC_DEFAULT_INPUT_T: the firmware sets info when it is ready */
 static int ho_check_ready(struct hdmi_out *ho)
 {
@@ -191,6 +216,8 @@ static int ho_check_ready(struct hdmi_out *ho)
 	ret = ho_call(ho, RTD_ACPU_CHECK_READY, false);
 	if (!ret && !*ho_arg(ho, 0))
 		dev_warn(ho->dev, "audio firmware not ready\n");
+	if (!ret)
+		ret = ho_hdmi_enable(ho);
 	return ret;
 }
 
