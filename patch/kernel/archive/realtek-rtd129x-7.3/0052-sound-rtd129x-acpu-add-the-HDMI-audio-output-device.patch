From 5bb4e5c37df63897638c7bc050cf2549261ded74 Mon Sep 17 00:00:00 2001
From: Igor Pecovnik <igor@armbian.com>
Date: Thu, 22 Oct 2026 07:19:33 +0000
Subject: [PATCH 52/55] sound: rtd129x-acpu: add the HDMI audio output device

Add an auxiliary device for HDMI audio playback. The core adds it only
when the DT has the realtek,hdmi-audio-out property. Boards without the
property keep their behaviour.

Also add the kernel RPC numbers that playback uses: FLUSH, CONNECT and
DESTROY.

Assisted-by: Claude Opus 5.5
Signed-off-by: Igor Pecovnik <igor@armbian.com>
---
 sound/realtek-rtd129x-acpu/acpu-rpc.c     | 7 +++++++
 sound/realtek-rtd129x-acpu/rtd129x-acpu.h | 8 ++++++--
 2 files changed, 13 insertions(+), 2 deletions(-)

diff --git a/sound/realtek-rtd129x-acpu/acpu-rpc.c b/sound/realtek-rtd129x-acpu/acpu-rpc.c
index 3bf2fa62d..9419ed5e8 100644
--- a/sound/realtek-rtd129x-acpu/acpu-rpc.c
+++ b/sound/realtek-rtd129x-acpu/acpu-rpc.c
@@ -160,6 +160,7 @@ struct rtd_acpu {
 
 	struct rtd_acpu_adev *pcm;
 	struct rtd_acpu_adev *vo;
+	struct rtd_acpu_adev *ao;
 };
 
 static void __iomem *ring_ptr(struct rtd_acpu *acpu, u32 addr)
@@ -823,6 +824,12 @@ static int acpu_probe(struct platform_device *pdev)
 	ret = acpu_add_adev(acpu, RTD_ACPU_PCM_NAME, &acpu->pcm);
 	if (ret)
 		return ret;
+	/* HDMI audio playback, on the boards that ask for it */
+	if (of_property_read_bool(dev->of_node, "realtek,hdmi-audio-out")) {
+		ret = acpu_add_adev(acpu, RTD_ACPU_AO_NAME, &acpu->ao);
+		if (ret)
+			return ret;
+	}
 	/* without a scanout pool the firmware shows a framebuffer of its own */
 	if (of_property_match_string(dev->of_node, "memory-region-names",
 				     "vo") < 0)
diff --git a/sound/realtek-rtd129x-acpu/rtd129x-acpu.h b/sound/realtek-rtd129x-acpu/rtd129x-acpu.h
index 79be27548..379a48a15 100644
--- a/sound/realtek-rtd129x-acpu/rtd129x-acpu.h
+++ b/sound/realtek-rtd129x-acpu/rtd129x-acpu.h
@@ -38,6 +38,9 @@ enum {
 	RTD_ACPU_PRIVATEINFO	= 2,
 	RTD_ACPU_RUN		= 3,
 	RTD_ACPU_PAUSE		= 4,
+	RTD_ACPU_FLUSH		= 8,
+	RTD_ACPU_CONNECT	= 9,
+	RTD_ACPU_DESTROY	= 18,
 	RTD_ACPU_STOP		= 19,
 	RTD_ACPU_CHECK_READY	= 20,
 	RTD_ACPU_ADC0_CONFIG	= 23,
@@ -55,13 +58,14 @@ void rtd_acpu_media_free(struct rtd_acpu *acpu, phys_addr_t phys, size_t size);
 int rtd_acpu_alloc(struct rtd_acpu *acpu, size_t size, struct rtd_acpu_buf *buf);
 void rtd_acpu_free(struct rtd_acpu *acpu, struct rtd_acpu_buf *buf);
 
-/* The auxiliary device the core creates for the HDMI audio capture */
+/* The auxiliary devices the core creates for the drivers on top */
 struct rtd_acpu_adev {
 	struct auxiliary_device adev;
 	struct rtd_acpu *acpu;
 };
 
-#define RTD_ACPU_PCM_NAME	"pcm"
+#define RTD_ACPU_PCM_NAME	"pcm"	/* the HDMI receiver's audio */
 #define RTD_ACPU_VO_NAME	"vo"	/* the video output */
+#define RTD_ACPU_AO_NAME	"ao"	/* the HDMI audio output */
 
 #endif
-- 
