From e10c622f070a4283ca9a5a5da10670bdcd041979 Mon Sep 17 00:00:00 2001
From: Igor Pecovnik <igor@armbian.com>
Date: Wed, 21 Oct 2026 10:37:07 +0000
Subject: [PATCH 31/46] arm64: drain the SB2 bridge on the RTD1395 too

The RTD1395 has the same SB2 bridge and sync register.

Assisted-by: Claude Opus 5.5
Signed-off-by: Igor Pecovnik <igor@armbian.com>
---
 arch/arm64/kernel/rtd129x-sb2-sync.c | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/kernel/rtd129x-sb2-sync.c b/arch/arm64/kernel/rtd129x-sb2-sync.c
index 0c425787c..4a5ecbc7b 100644
--- a/arch/arm64/kernel/rtd129x-sb2-sync.c
+++ b/arch/arm64/kernel/rtd129x-sb2-sync.c
@@ -58,7 +58,8 @@ static int __init rtd_sb2_sync_init(void)
 {
 	if (!of_machine_is_compatible("realtek,rtd1293") &&
 	    !of_machine_is_compatible("realtek,rtd1295") &&
-	    !of_machine_is_compatible("realtek,rtd1296"))
+	    !of_machine_is_compatible("realtek,rtd1296") &&
+	    !of_machine_is_compatible("realtek,rtd1395"))
 		return 0;
 
 	sb2_sync_map = ioremap(RTD129X_SB2_SYNC, 4);
-- 
2.53.0

