From 9b66577b619e74aa8779554b2563b015ca316d92 Mon Sep 17 00:00:00 2001
From: Igor Pecovnik <igor@armbian.com>
Date: Wed, 21 Oct 2026 15:40:34 +0000
Subject: [PATCH 42/46] arm64: dts: realtek: bpi-m4: add the CPU thermal sensor

Add the sensor and a thermal zone with a critical trip at 110 C. The
board has no CPU frequency scaling yet, so there is no passive trip.

Assisted-by: Claude Opus 5.5
Signed-off-by: Igor Pecovnik <igor@armbian.com>
---
 .../arm64/boot/dts/realtek/rtd1395-bpi-m4.dts | 31 +++++++++++++++++++
 1 file changed, 31 insertions(+)

diff --git a/arch/arm64/boot/dts/realtek/rtd1395-bpi-m4.dts b/arch/arm64/boot/dts/realtek/rtd1395-bpi-m4.dts
index 503c09113..cc41ce174 100644
--- a/arch/arm64/boot/dts/realtek/rtd1395-bpi-m4.dts
+++ b/arch/arm64/boot/dts/realtek/rtd1395-bpi-m4.dts
@@ -158,6 +158,37 @@ usb@29000 {
 	};
 };
 
+/*
+ * No CPU frequency scaling yet: the critical trip shuts the board down
+ * before it hangs. 130 C is the BSP's cpu-crit.
+ */
+/ {
+	thermal-zones {
+		cpu-thermal {
+			polling-delay-passive = <250>;
+			polling-delay = <1000>;
+			thermal-sensors = <&cpu_tm>;
+
+			trips {
+				cpu-crit {
+					temperature = <110000>;
+					hysteresis = <2000>;
+					type = "critical";
+				};
+			};
+		};
+	};
+};
+
+/* The sensor next to the CPUs; the wrapper syscon does not claim its range. */
+&scpu_wrapper {
+	cpu_tm: thermal-sensor@150 {
+		compatible = "realtek,rtd1395-thermal";
+		reg = <0x150 0x20>;
+		#thermal-sensor-cells = <0>;
+	};
+};
+
 &uart0 {
 	status = "okay";
 };
