From a87957bd24567c44ef450977d61b82ab0eacf1f0 Mon Sep 17 00:00:00 2001
From: Igor Pecovnik <igor@armbian.com>
Date: Wed, 21 Oct 2026 12:52:59 +0000
Subject: [PATCH 38/46] usb: dwc3: rtk: apply the RTD1395 quirk by compatible

Mainline has no Realtek SoC info driver, so the RTD1395 PHY PLL quirk
never ran. Also match the RTD1395 by its compatible.

Assisted-by: Claude Opus 5.5
Signed-off-by: Igor Pecovnik <igor@armbian.com>
---
 drivers/usb/dwc3/dwc3-rtk.c | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/drivers/usb/dwc3/dwc3-rtk.c b/drivers/usb/dwc3/dwc3-rtk.c
index 3e448c2a9..7e4ecafbb 100644
--- a/drivers/usb/dwc3/dwc3-rtk.c
+++ b/drivers/usb/dwc3/dwc3-rtk.c
@@ -212,7 +212,9 @@ static int dwc3_rtk_init(struct dwc3_rtk *rtk)
 		dev_info(dev, "[bug fixed] 1295/1296 A00: add workaround to disable multiple request for D-Bus");
 	}
 
-	if (soc_device_match(rtk_soc_hercules)) {
+	/* there is no Realtek SoC info driver in mainline: match the RTD1395 by compatible */
+	if (soc_device_match(rtk_soc_hercules) ||
+	    of_device_is_compatible(dev->of_node, "realtek,rtd1395-dwc3")) {
 		reg = rtk->regs + WRAP_USB2_PHY_REG;
 		val = readl(reg);
 		writel(USB2_PHY_EN_PHY_PLL_PORT1 | val, reg);
-- 
2.53.0

