From a193ea05dc1c966dc308c727cc2547bc7e4aa9b6 Mon Sep 17 00:00:00 2001
From: Igor Pecovnik <igor@armbian.com>
Date: Wed, 21 Oct 2026 12:52:59 +0000
Subject: [PATCH 39/46] phy: realtek: usb2: fix the PHY register of the second
 port

Each port has its own GUSB2PHYACC register, 4 bytes apart. The driver
added the port index in bytes, so port 1 used an unaligned address.

Assisted-by: Claude Opus 5.5
Signed-off-by: Igor Pecovnik <igor@armbian.com>
---
 drivers/phy/realtek/phy-rtk-usb2.c | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/drivers/phy/realtek/phy-rtk-usb2.c b/drivers/phy/realtek/phy-rtk-usb2.c
index 248550ef9..89046cb43 100644
--- a/drivers/phy/realtek/phy-rtk-usb2.c
+++ b/drivers/phy/realtek/phy-rtk-usb2.c
@@ -972,7 +972,8 @@ static int parse_phy_data(struct rtk_phy *rtk_phy)
 		phy_parameter = &((struct phy_parameter *)rtk_phy->phy_parameter)[index];
 
 		phy_parameter->phy_reg.reg_wrap_vstatus = of_iomap(np, 0);
-		phy_parameter->phy_reg.reg_gusb2phyacc0 = of_iomap(np, 1) + index;
+		/* one GUSB2PHYACC register per port, 4 bytes apart */
+		phy_parameter->phy_reg.reg_gusb2phyacc0 = of_iomap(np, 1) + index * 4;
 		phy_parameter->phy_reg.vstatus_index = index;
 
 		if (of_property_read_bool(np, "realtek,inverse-hstx-sync-clock"))
-- 
