From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: JalenLin <jalen.lin@gmail.com>
Date: Mon, 12 Oct 2026 18:04:57 +0200
Subject: [PATCH 04/22] arm64: dts: realtek: wire up the RTD129x interrupt
 muxes

rtd129x.dtsi carries exactly two interrupts today -- the GIC's own
maintenance PPI and the arch timer -- so every peripheral below the GIC is
interruptless and any driver that can falls back to polling. uart0 says so
on every boot:

    dw-apb-uart 98007800.serial: error -ENXIO: IRQ index 0 not found

Add the two muxes and point the three UARTs at them. The number in each
"interrupts" property is the source's bit in that mux's status register; the
enable bit is frequently a different number (UART2 is status bit 8, enable
bit 7), which is why the mapping lives in the driver.

The muxes sit at offset 0 of their syscon blocks and claim only the two
registers they use, so they do not overlap iso_reset@88 or the UARTs.

Source: https://github.com/JalenLin/BPI-W2-linux

Signed-off-by: Igor Pecovnik <igor@armbian.com>
---
 arch/arm64/boot/dts/realtek/rtd129x.dtsi | 22 ++++++++++++++++++++++
 1 file changed, 22 insertions(+)

diff --git a/arch/arm64/boot/dts/realtek/rtd129x.dtsi b/arch/arm64/boot/dts/realtek/rtd129x.dtsi
index ba50e292bdbb..e71dec4b7924 100644
--- a/arch/arm64/boot/dts/realtek/rtd129x.dtsi
+++ b/arch/arm64/boot/dts/realtek/rtd129x.dtsi
@@ -149,6 +149,14 @@
 };
 
 &iso {
+	iso_irq_mux: interrupt-controller@0 {
+		compatible = "realtek,rtd1295-iso-irq-mux";
+		reg = <0x0 0x4>, <0x40 0x4>;
+		interrupts = <GIC_SPI 41 IRQ_TYPE_LEVEL_HIGH>;
+		interrupt-controller;
+		#interrupt-cells = <1>;
+	};
+
 	iso_reset: reset-controller@88 {
 		compatible = "snps,dw-low-reset";
 		reg = <0x88 0x4>;
@@ -164,6 +172,8 @@
 	uart0: serial@800 {
 		compatible = "snps,dw-apb-uart";
 		reg = <0x800 0x400>;
+		interrupt-parent = <&iso_irq_mux>;
+		interrupts = <2>;
 		reg-shift = <2>;
 		reg-io-width = <4>;
 		clock-frequency = <27000000>;
@@ -173,9 +183,19 @@
 };
 
 &misc {
+	misc_irq_mux: interrupt-controller@c {
+		compatible = "realtek,rtd1295-misc-irq-mux";
+		reg = <0xc 0x4>, <0x80 0x4>;
+		interrupts = <GIC_SPI 40 IRQ_TYPE_LEVEL_HIGH>;
+		interrupt-controller;
+		#interrupt-cells = <1>;
+	};
+
 	uart1: serial@200 {
 		compatible = "snps,dw-apb-uart";
 		reg = <0x200 0x100>;
+		interrupt-parent = <&misc_irq_mux>;
+		interrupts = <3>;
 		reg-shift = <2>;
 		reg-io-width = <4>;
 		clock-frequency = <432000000>;
@@ -186,6 +206,8 @@
 	uart2: serial@400 {
 		compatible = "snps,dw-apb-uart";
 		reg = <0x400 0x100>;
+		interrupt-parent = <&misc_irq_mux>;
+		interrupts = <8>;
 		reg-shift = <2>;
 		reg-io-width = <4>;
 		clock-frequency = <432000000>;
