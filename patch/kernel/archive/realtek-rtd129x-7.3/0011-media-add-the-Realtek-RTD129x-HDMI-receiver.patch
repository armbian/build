+void SetClockBoundary(void)
+{
+	clock_bound_3g = TMDS_3G;
+	clock_bound_1p5g = TMDS_1p5G;
+	clock_bound_45m = 430;
+	clock_bound_110m = 1042;
+	HDMI_PRINTF("[HDMI] clock_bound_3g=%d\n", clock_bound_3g);
+}
