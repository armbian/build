+unsigned char hdmirx_wrapper_convert_color_fmt(HDMI_COLOR_SPACE_T color)
+{
+	unsigned char yuv_fmt;
+
+	switch (color) {
+	case COLOR_RGB:
+		yuv_fmt = 0;
+		break;
+	case COLOR_YUV422:
+		yuv_fmt = 2;
+		break;
+	case COLOR_YUV444:
+	case COLOR_YUV420:/* YUV420to444 */
+		yuv_fmt = 1;
+		break;
+	default:
+		yuv_fmt = 0;
+		HDMIRX_ERROR("[%s] Unsupported color(%u)", __func__, color);
+		break;
+	}
+
+	return yuv_fmt;
+}
