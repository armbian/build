+unsigned int Hdmi_GetVSyncCount(void)
+{
+	if (TMDS_CTRL_get_yo(hdmi_rx_reg_read32(TMDS_CTRL, HDMI_RX_MAC))) {
+		hdmi_rx_reg_mask32(TMDS_CTRL, ~TMDS_CTRL_yo_mask, TMDS_CTRL_yo(1), HDMI_RX_MAC);
+		hdmi.vsync_cnt++;
+	}
+
+	return hdmi.vsync_cnt;
+}
