From 2707fd640bb583347669c97656b88d4bc862f6c1 Mon Sep 17 00:00:00 2001
From: Igor Pecovnik <igor@armbian.com>
Date: Wed, 21 Oct 2026 16:02:10 +0000
Subject: [PATCH 46/46] arm64: dts: realtek: bpi-m4: add CPU frequency scaling

Add the PMIC bus, the G2237, the CPU clock and the CPU OPPs from
300 MHz to 1.3 GHz. The CPU rail stays at 1.0 V or above, its power-on
level: a reset keeps the PMIC voltage. Throttle the CPUs at 95 C.

Assisted-by: Claude Opus 5.5
Signed-off-by: Igor Pecovnik <igor@armbian.com>
---
 .../arm64/boot/dts/realtek/rtd1395-bpi-m4.dts | 177 +++++++++++++++++-
 1 file changed, 175 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/realtek/rtd1395-bpi-m4.dts b/arch/arm64/boot/dts/realtek/rtd1395-bpi-m4.dts
index cc41ce174..fd86df0b7 100644
--- a/arch/arm64/boot/dts/realtek/rtd1395-bpi-m4.dts
+++ b/arch/arm64/boot/dts/realtek/rtd1395-bpi-m4.dts
@@ -7,6 +7,7 @@
 
 #include <dt-bindings/gpio/gpio.h>
 #include <dt-bindings/leds/common.h>
+#include <dt-bindings/thermal/thermal.h>
 #include "rtd1395.dtsi"
 
 / {
@@ -159,8 +160,8 @@ usb@29000 {
 };
 
 /*
- * No CPU frequency scaling yet: the critical trip shuts the board down
- * before it hangs. 130 C is the BSP's cpu-crit.
+ * The BSP throttles at 105 C and has its cpu-crit at 130 C. The BPI-M4 has
+ * a small heatsink: throttle at 95 C, shut down at 110 C.
  */
 / {
 	thermal-zones {
@@ -170,12 +171,184 @@ cpu-thermal {
 			thermal-sensors = <&cpu_tm>;
 
 			trips {
+				cpu_alert: cpu-alert {
+					temperature = <95000>;
+					hysteresis = <3000>;
+					type = "passive";
+				};
 				cpu-crit {
 					temperature = <110000>;
 					hysteresis = <2000>;
 					type = "critical";
 				};
 			};
+
+			cooling-maps {
+				map0 {
+					trip = <&cpu_alert>;
+					cooling-device =
+						<&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
+						<&cpu1 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
+						<&cpu2 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
+						<&cpu3 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
+				};
+			};
+		};
+	};
+
+	/*
+	 * The BSP's table (rtd-139x-cpu-dvfs.dtsi), at the highest voltage of
+	 * its chip cuts, and never below 1.0 V: the G2237's power-on level.
+	 * A reset leaves the PMIC where Linux put it, and the boot ROM may not
+	 * start below that (as on the BPI-W2). 1.4 GHz is left out: the BSP
+	 * drops it on the A02 cut.
+	 */
+	cpu_opp: opp-table-cpu {
+		compatible = "operating-points-v2";
+		opp-shared;
+
+		opp-300000000 {
+			opp-hz = /bits/ 64 <300000000>;
+			opp-microvolt = <1000000>;
+			clock-latency-ns = <150000>;
+		};
+		opp-400000000 {
+			opp-hz = /bits/ 64 <400000000>;
+			opp-microvolt = <1000000>;
+			clock-latency-ns = <150000>;
+		};
+		opp-500000000 {
+			opp-hz = /bits/ 64 <500000000>;
+			opp-microvolt = <1000000>;
+			clock-latency-ns = <150000>;
+		};
+		opp-600000000 {
+			opp-hz = /bits/ 64 <600000000>;
+			opp-microvolt = <1000000>;
+			clock-latency-ns = <150000>;
+		};
+		opp-700000000 {
+			opp-hz = /bits/ 64 <700000000>;
+			opp-microvolt = <1000000>;
+			clock-latency-ns = <150000>;
+		};
+		opp-800000000 {
+			opp-hz = /bits/ 64 <800000000>;
+			opp-microvolt = <1000000>;
+			clock-latency-ns = <150000>;
+		};
+		opp-900000000 {
+			opp-hz = /bits/ 64 <900000000>;
+			opp-microvolt = <1000000>;
+			clock-latency-ns = <150000>;
+		};
+		opp-1000000000 {
+			opp-hz = /bits/ 64 <1000000000>;
+			opp-microvolt = <1000000>;
+			clock-latency-ns = <150000>;
+		};
+		opp-1100000000 {
+			opp-hz = /bits/ 64 <1100000000>;
+			opp-microvolt = <1025000>;
+			clock-latency-ns = <150000>;
+		};
+		opp-1200000000 {
+			opp-hz = /bits/ 64 <1200000000>;
+			opp-microvolt = <1087500>;
+			clock-latency-ns = <150000>;
+		};
+		opp-1300000000 {
+			opp-hz = /bits/ 64 <1300000000>;
+			opp-microvolt = <1125000>;
+			clock-latency-ns = <150000>;
+		};
+	};
+};
+
+&cpu0 {
+	clocks = <&scpu_clk>;
+	cpu-supply = <&cpu_supply>;
+	operating-points-v2 = <&cpu_opp>;
+	#cooling-cells = <2>;
+};
+
+&cpu1 {
+	clocks = <&scpu_clk>;
+	cpu-supply = <&cpu_supply>;
+	operating-points-v2 = <&cpu_opp>;
+	#cooling-cells = <2>;
+};
+
+&cpu2 {
+	clocks = <&scpu_clk>;
+	cpu-supply = <&cpu_supply>;
+	operating-points-v2 = <&cpu_opp>;
+	#cooling-cells = <2>;
+};
+
+&cpu3 {
+	clocks = <&scpu_clk>;
+	cpu-supply = <&cpu_supply>;
+	operating-points-v2 = <&cpu_opp>;
+	#cooling-cells = <2>;
+};
+
+/*
+ * The CPU clock, PLL_SCPU (0x500) and its divider (0x30), through this
+ * syscon's regmap.
+ */
+&crt {
+	scpu_clk: clock-controller@500 {
+		compatible = "realtek,rtd1395-scpu-clk";
+		reg = <0x500 0x20>;
+		#clock-cells = <0>;
+	};
+};
+
+/*
+ * The bus to the G2237 PMIC. A DesignWare I2C clocked from the 27 MHz
+ * crystal. U-Boot muxes its pins (ISO GPIO 12 and 13).
+ */
+&iso {
+	i2c0: i2c@d00 {
+		compatible = "snps,designware-i2c";
+		reg = <0xd00 0x100>;
+		interrupt-parent = <&iso_irq_mux>;
+		interrupts = <8>;
+		clocks = <&osc27M>, <&iso_clk 9>;
+		clock-names = "ref", "pclk";
+		resets = <&iso_reset RTD1295_ISO_RSTN_I2C_0>;
+		clock-frequency = <100000>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		/* Only DC3, the CPU rail, can be set; the rest read back. */
+		pmic@12 {
+			compatible = "gmt,g2237";
+			reg = <0x12>;
+
+			regulators {
+				dc1 {
+					regulator-name = "vd33";
+				};
+				dc2 {
+					regulator-name = "vdd-core";
+				};
+				cpu_supply: dc3 {
+					regulator-name = "vdd-cpu";
+					/* never below the power-on level: see cpu_opp */
+					regulator-min-microvolt = <1000000>;
+					regulator-max-microvolt = <1125000>;
+					regulator-always-on;
+					regulator-boot-on;
+				};
+				dc5 {
+					regulator-name = "vd18";
+				};
+				ldo1 {
+					regulator-name = "vd25";
+				};
+			};
 		};
 	};
 };
-- 
2.53.0

