From fb3850c06a45fde6424edde1283309bdc8c790ac Mon Sep 17 00:00:00 2001
From: Igor Pecovnik <igor@armbian.com>
Date: Wed, 21 Oct 2026 12:53:00 +0000
Subject: [PATCH 40/46] arm64: dts: realtek: bpi-m4: add the USB host ports

Enable the DWC3 of USB ports 1 and 2, with VBUS of port 2. Port 1
holds the USB hub, port 2 the RTL8821CU Wi-Fi and Bluetooth module.

Assisted-by: Claude Opus 5.5
Signed-off-by: Igor Pecovnik <igor@armbian.com>
---
 .../arm64/boot/dts/realtek/rtd1395-bpi-m4.dts | 50 +++++++++++++++++++
 1 file changed, 50 insertions(+)

diff --git a/arch/arm64/boot/dts/realtek/rtd1395-bpi-m4.dts b/arch/arm64/boot/dts/realtek/rtd1395-bpi-m4.dts
index aa9e8947d..503c09113 100644
--- a/arch/arm64/boot/dts/realtek/rtd1395-bpi-m4.dts
+++ b/arch/arm64/boot/dts/realtek/rtd1395-bpi-m4.dts
@@ -30,6 +30,16 @@ chosen {
 		stdout-path = "serial0:115200n8";
 	};
 
+	/* VBUS of the USB host port 2, ISO GPIO 49, low active */
+	usb_p2_vbus: regulator-usb-p2-vbus {
+		compatible = "regulator-fixed";
+		regulator-name = "usb_p2_vbus";
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+		gpio = <&iso_gpio 49 GPIO_ACTIVE_LOW>;
+		regulator-always-on;
+	};
+
 	leds {
 		compatible = "gpio-leds";
 
@@ -108,6 +118,46 @@ gmac: ethernet@16000 {
 	};
 };
 
+/*
+ * USB host ports 1 and 2: one DWC3 with a two-port USB 2.0 PHY. The clocks
+ * and resets are in ISO; the boot firmware leaves them off.
+ */
+&rbus {
+	usb_u2host_usb2phy: usb-phy@13c14 {
+		compatible = "realtek,rtd1395-usb2phy-2port";
+		reg = <0x13c14 0x4>, <0x31280 0x8>;
+		#phy-cells = <0>;
+	};
+
+	usb@13c00 {
+		compatible = "realtek,rtd1395-dwc3", "realtek,rtd-dwc3";
+		reg = <0x13c00 0x140>, <0x13d60 0x4>;
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges;
+
+		usb@29000 {
+			compatible = "snps,dwc3";
+			reg = <0x29000 0x9000>;
+			interrupts = <GIC_SPI 21 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&iso_clk 16>,		/* USB */
+				 <&iso_clk 14>,		/* USB_HOST_0 */
+				 <&iso_clk 15>;		/* USB_HOST_1 */
+			clock-names = "bus_early", "ref", "suspend";
+			/* DRD, host, PHY 0-2, USB, Type-C */
+			resets = <&iso_reset 14>, <&iso_reset 15>,
+				 <&iso_reset 16>, <&iso_reset 17>,
+				 <&iso_reset 18>, <&iso_reset 19>,
+				 <&iso_reset 20>;
+			phys = <&usb_u2host_usb2phy>;
+			phy-names = "usb2-phy";
+			dr_mode = "host";
+			maximum-speed = "high-speed";
+			snps,dis_u2_susphy_quirk;
+		};
+	};
+};
+
 &uart0 {
 	status = "okay";
 };
