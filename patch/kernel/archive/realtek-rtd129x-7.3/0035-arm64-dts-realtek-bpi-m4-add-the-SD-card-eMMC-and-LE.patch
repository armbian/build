From 18894d5eb6d14ca89095fdd9ef99860e0f97e6d6 Mon Sep 17 00:00:00 2001
From: Igor Pecovnik <igor@armbian.com>
Date: Wed, 21 Oct 2026 10:37:08 +0000
Subject: [PATCH 35/46] arm64: dts: realtek: bpi-m4: add the SD card, eMMC and
 LED

Add the SD card slot, the 8 GB eMMC and the green heartbeat LED.

Assisted-by: Claude Opus 5.5
Signed-off-by: Igor Pecovnik <igor@armbian.com>
---
 .../arm64/boot/dts/realtek/rtd1395-bpi-m4.dts | 58 +++++++++++++++++++
 1 file changed, 58 insertions(+)

diff --git a/arch/arm64/boot/dts/realtek/rtd1395-bpi-m4.dts b/arch/arm64/boot/dts/realtek/rtd1395-bpi-m4.dts
index 9891967d1..1a533ae36 100644
--- a/arch/arm64/boot/dts/realtek/rtd1395-bpi-m4.dts
+++ b/arch/arm64/boot/dts/realtek/rtd1395-bpi-m4.dts
@@ -5,6 +5,8 @@
 
 /dts-v1/;
 
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/leds/common.h>
 #include "rtd1395.dtsi"
 
 / {
@@ -17,12 +19,68 @@ memory@2f000 {
 	};
 
 	aliases {
+		/* fixed names: the SD card is mmcblk0, the eMMC mmcblk1 */
+		mmc0 = &sdmmc;
+		mmc1 = &emmc;
 		serial0 = &uart0;
 	};
 
 	chosen {
 		stdout-path = "serial0:115200n8";
 	};
+
+	leds {
+		compatible = "gpio-leds";
+
+		led-0 {
+			color = <LED_COLOR_ID_GREEN>;
+			function = LED_FUNCTION_HEARTBEAT;
+			gpios = <&iso_gpio 52 GPIO_ACTIVE_LOW>;
+			linux,default-trigger = "heartbeat";
+		};
+	};
+};
+
+&rbus {
+	/*
+	 * The SD card slot. The second range is the ISO pin controller: the
+	 * pad control of the card pins. The boot firmware sets the pin mux.
+	 */
+	sdmmc: mmc@10400 {
+		compatible = "realtek,rtd1395-sdmmc";
+		reg = <0x10400 0x200>, <0x4e000 0x100>;
+		clocks = <&crt_clk 25>, <&crt_clk 31>;	/* CLK_EN1: CR, SD_IP */
+		clock-names = "cr", "sd_ip";
+		resets = <&reset2 RTD1295_RSTN_CR>;
+		realtek,crt = <&crt>;
+		interrupts = <GIC_SPI 44 IRQ_TYPE_LEVEL_HIGH>;
+		power-gpios = <&iso_gpio 30 GPIO_ACTIVE_LOW>;
+		bus-width = <4>;
+		cap-sd-highspeed;
+	};
+
+	/*
+	 * The 8 GB eMMC. The boot firmware sets up its pins and I/O voltage.
+	 * No resets: RSTN_EMMC also resets the clock generator that the boot
+	 * firmware set. Disabled: the vendor SPI loader leaves the controller
+	 * core open to the secure world only, so Linux reads 0xdeaddead.
+	 */
+	emmc: mmc@12000 {
+		compatible = "realtek,rtd1395-emmc";
+		reg = <0x12000 0x600>;
+		interrupts = <GIC_SPI 42 IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&crt_clk 24>, <&crt_clk 28>;	/* CLK_EN1: EMMC, EMMC_IP */
+		clock-names = "biu", "ip";
+		realtek,crt = <&crt>;
+		realtek,sb2 = <&sb2>;
+		bus-width = <8>;
+		max-frequency = <52000000>;
+		cap-mmc-highspeed;
+		non-removable;
+		no-sd;
+		no-sdio;
+		status = "disabled";
+	};
 };
 
 &uart0 {
