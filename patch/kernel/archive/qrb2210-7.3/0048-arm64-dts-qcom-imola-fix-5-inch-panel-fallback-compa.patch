From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: SuperKali <hello@superkali.me>
Date: Thu, 5 Nov 2026 12:55:07 +0100
Subject: arm64: dts: qcom: imola: fix 5 inch panel fallback compatible

The himax,hx8394 binding pairs waveshare,5.0-dsi-touch-a with the
himax,hx8394 fallback, himax,hx8399c is only valid for the Huiling
panel. The driver matches the Waveshare compatible directly, so this
only fixes the schema.

Signed-off-by: SuperKali <hello@superkali.me>
---
 arch/arm64/boot/dts/qcom/qrb2210-arduino-imola-carrier-media-panel-5in_touch_a-dsi.dtso | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/qcom/qrb2210-arduino-imola-carrier-media-panel-5in_touch_a-dsi.dtso b/arch/arm64/boot/dts/qcom/qrb2210-arduino-imola-carrier-media-panel-5in_touch_a-dsi.dtso
index 111111111111..222222222222 100644
--- a/arch/arm64/boot/dts/qcom/qrb2210-arduino-imola-carrier-media-panel-5in_touch_a-dsi.dtso
+++ b/arch/arm64/boot/dts/qcom/qrb2210-arduino-imola-carrier-media-panel-5in_touch_a-dsi.dtso
@@ -60,7 +60,7 @@ &mdss_dsi0 {
 
 	dsi_panel: dsi_panel@0 {
 		reg = <0>;
-		compatible = "waveshare,5.0-dsi-touch-a", "himax,hx8399c";
+		compatible = "waveshare,5.0-dsi-touch-a", "himax,hx8394";
 		reset-gpio = <&wsgpio 1 GPIO_ACTIVE_LOW>;
 		iovcc-supply = <&panel_iovcc>;
 		vcc-supply = <&panel_avdd>;
-- 
Armbian

