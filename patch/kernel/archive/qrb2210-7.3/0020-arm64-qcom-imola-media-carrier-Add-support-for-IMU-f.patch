From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Riccardo Mereu <r.mereu@arduino.cc>
Date: Thu, 30 Apr 2026 12:30:49 +0200
Subject: arm64:qcom: imola: media carrier: Add support for IMU for
 autorotation feature

Adding support for IMU on both the cci i2c in order to support it for a
user-space service handling autorotation feature for DSI displays.

Signed-off-by: Riccardo Mereu <r.mereu@arduino.cc>
(cherry picked from commit 3b073d65791dfcfeafea10649349b56a55353dc7)
---
 arch/arm64/boot/dts/qcom/qrb2210-arduino-imola-carrier-media-common.dtsi | 15 ++++++++++
 1 file changed, 15 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/qrb2210-arduino-imola-carrier-media-common.dtsi b/arch/arm64/boot/dts/qcom/qrb2210-arduino-imola-carrier-media-common.dtsi
index 111111111111..222222222222 100644
--- a/arch/arm64/boot/dts/qcom/qrb2210-arduino-imola-carrier-media-common.dtsi
+++ b/arch/arm64/boot/dts/qcom/qrb2210-arduino-imola-carrier-media-common.dtsi
@@ -42,4 +42,19 @@ pca9555: gpio@26 {
 		gpio-controller;
 		#gpio-cells = <2>;
 	};
+
+	imu@6a {
+		compatible = "st,lsm6dsox";
+		reg = <0x6a>;
+	};
 };
+
+&cci_i2c1 {
+	#address-cells = <1>;
+	#size-cells = <0>;
+
+	imu@6a {
+		compatible = "st,lsm6dsox";
+		reg = <0x6a>;
+	};
+};
\ No newline at end of file
-- 
Armbian

