From c517be8167daf9a22d74b956990a94d70b2c5df9 Mon Sep 17 00:00:00 2001
From: Rosen Penev <rosenp@gmail.com>
Date: Tue, 24 Nov 2026 14:21:28 -0800
Subject: [PATCH net-next v3 3/3] net: phy: marvell: keep PHY awake with only
 the WoL event unmasked

With WoL enabled, phy_suspend() does not call the 88E1318S/88E1510
suspend callback, so the PHY keeps its full interrupt mask. With the
PHY interrupt now a wake IRQ, a link change during suspend wakes the
system as well as a magic packet does.

Set PHY_ALWAYS_CALL_SUSPEND. When WoL is armed through a wake IRQ,
leave the copper side running, unmask only the WoL event, and clear
latched events so that INTn is not already asserted. On the 88E1510 the
fiber side is also powered down. Every other WoL setup leaves the PHY
running, as before. Resume restores the normal mask through
m88e1318_config_intr(). It does this even when an earlier resume step
fails, because phy_start() carries on after a resume error.

With WoL enabled, mdio_bus_phy_may_suspend() keeps MDIO bus PM from
suspending the PHY. The callbacks therefore run only when the MAC
driver stops the PHY in its own suspend path, as mvneta does through
phylink_stop().

TODO(Igor): Helios4 (Armada 388, 88E1512) test results.

Co-developed-by: Igor Velkov <iav@iav.lv>
Signed-off-by: Igor Velkov <iav@iav.lv>
Signed-off-by: Rosen Penev <rosenp@gmail.com>
---
 drivers/net/phy/marvell.c | 105 ++++++++++++++++++++++++++++++++++----
 1 file changed, 96 insertions(+), 9 deletions(-)

diff --git a/drivers/net/phy/marvell.c b/drivers/net/phy/marvell.c
index c014c39217b1..23b54b5c8418 100644
--- a/drivers/net/phy/marvell.c
+++ b/drivers/net/phy/marvell.c
@@ -1961,6 +1961,86 @@ static int marvell_resume(struct phy_device *phydev)
 	return err;
 }
 
+/* With WoL armed through a wake IRQ, the PHY must keep receiving, and
+ * only the WoL event may assert INTn.
+ */
+static bool m88e1318_wol_wakeup(struct phy_device *phydev)
+{
+	struct marvell_priv *priv = phydev->priv;
+
+	return priv->wol_enabled && device_may_wakeup(&phydev->mdio.dev);
+}
+
+static int m88e1318_wol_suspend(struct phy_device *phydev)
+{
+	bool fiber = linkmode_test_bit(ETHTOOL_LINK_MODE_FIBRE_BIT,
+				       phydev->supported);
+	int err;
+
+	err = phy_write_paged(phydev, MII_MARVELL_COPPER_PAGE, MII_M1011_IMASK,
+			      MII_M1011_IMASK_WOL);
+	if (err < 0)
+		goto restore;
+
+	if (fiber) {
+		err = phy_modify_paged(phydev, MII_MARVELL_FIBER_PAGE, MII_BMCR,
+				       0, BMCR_PDOWN);
+		if (err < 0)
+			goto restore;
+
+		err = phy_read_paged(phydev, MII_MARVELL_FIBER_PAGE,
+				     MII_M1011_IEVENT);
+		if (err < 0)
+			goto restore;
+	}
+
+	/* Clear latched events, so INTn is not asserted already */
+	err = phy_read_paged(phydev, MII_MARVELL_COPPER_PAGE, MII_M1011_IEVENT);
+	if (err >= 0)
+		return 0;
+
+restore:
+	/* phy_suspend() does not call resume after a failed suspend */
+	if (fiber)
+		phy_modify_paged(phydev, MII_MARVELL_FIBER_PAGE, MII_BMCR,
+				 BMCR_PDOWN, 0);
+	m88e1318_config_intr(phydev);
+	return err;
+}
+
+static int m88e1318_suspend(struct phy_device *phydev)
+{
+	if (m88e1318_wol_wakeup(phydev))
+		return m88e1318_wol_suspend(phydev);
+
+	/* Other WoL setups need the PHY running, as before */
+	if (phydev->wol_enabled)
+		return 0;
+
+	return genphy_suspend(phydev);
+}
+
+static int m88e1318_resume(struct phy_device *phydev)
+{
+	int err, ret;
+
+	err = genphy_resume(phydev);
+	ret = m88e1318_config_intr(phydev);
+
+	return err < 0 ? err : ret;
+}
+
+static int m88e1510_suspend(struct phy_device *phydev)
+{
+	if (m88e1318_wol_wakeup(phydev))
+		return m88e1318_wol_suspend(phydev);
+
+	if (phydev->wol_enabled)
+		return 0;
+
+	return marvell_suspend(phydev);
+}
+
 /* m88e1510_resume
  *
  * The 88e1510 PHY has an erratum where the phy downshift counter is not cleared
@@ -1973,29 +2053,35 @@ static int marvell_resume(struct phy_device *phydev)
  */
 static int m88e1510_resume(struct phy_device *phydev)
 {
-	int err;
+	int err, ret;
 	u8 cnt = 0;
 
 	err = marvell_resume(phydev);
 	if (err < 0)
-		return err;
+		goto restore_intrs;
 
 	/* read downshift counter value */
 	err = m88e1011_get_downshift(phydev, &cnt);
 	if (err < 0)
-		return err;
+		goto restore_intrs;
 
 	if (cnt) {
 		/* downshift disabled */
 		err = m88e1011_set_downshift(phydev, 0);
 		if (err < 0)
-			return err;
+			goto restore_intrs;
 
 		/* downshift enabled, with previous counter value */
 		err = m88e1011_set_downshift(phydev, cnt);
 	}
 
-	return err;
+restore_intrs:
+	/* phy_start() carries on after a resume error, so always restore
+	 * the interrupt mask m88e1318_wol_suspend() may have changed.
+	 */
+	ret = m88e1318_config_intr(phydev);
+
+	return err < 0 ? err : ret;
 }
 
 static int marvell_aneg_done(struct phy_device *phydev)
@@ -3962,6 +4048,7 @@ static struct phy_driver marvell_drivers[] = {
 		.phy_id_mask = MARVELL_PHY_ID_MASK,
 		.name = "Marvell 88E1318S",
 		/* PHY_GBIT_FEATURES */
+		.flags = PHY_ALWAYS_CALL_SUSPEND,
 		.probe = m88e1318_probe,
 		.remove = m88e1318_remove,
 		.config_init = m88e1318_config_init,
@@ -3971,8 +4058,8 @@ static struct phy_driver marvell_drivers[] = {
 		.handle_interrupt = m88e1318_handle_interrupt,
 		.get_wol = m88e1318_get_wol,
 		.set_wol = m88e1318_set_wol,
-		.resume = genphy_resume,
-		.suspend = genphy_suspend,
+		.resume = m88e1318_resume,
+		.suspend = m88e1318_suspend,
 		.read_page = marvell_read_page,
 		.write_page = marvell_write_page,
 		.get_sset_count = marvell_get_sset_count,
@@ -4075,7 +4162,7 @@ static struct phy_driver marvell_drivers[] = {
 		.name = "Marvell 88E1510",
 		.driver_data = DEF_MARVELL_HWMON_OPS(m88e1510_hwmon_ops),
 		.features = PHY_GBIT_FIBRE_FEATURES,
-		.flags = PHY_POLL_CABLE_TEST,
+		.flags = PHY_POLL_CABLE_TEST | PHY_ALWAYS_CALL_SUSPEND,
 		.probe = m88e1318_probe,
 		.remove = m88e1318_remove,
 		.config_init = m88e1510_config_init,
@@ -4086,7 +4173,7 @@ static struct phy_driver marvell_drivers[] = {
 		.get_wol = m88e1318_get_wol,
 		.set_wol = m88e1318_set_wol,
 		.resume = m88e1510_resume,
-		.suspend = marvell_suspend,
+		.suspend = m88e1510_suspend,
 		.read_page = marvell_read_page,
 		.write_page = marvell_write_page,
 		.get_sset_count = marvell_get_sset_count,
-- 
