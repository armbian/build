From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Andrei Aldea <andrei1998@gmail.com>
Date: Tue, 4 Aug 2026 10:51:12 -0500
Subject: [PATCH] dt-bindings: display: add Good Display GDEY042T81

Document the SPI and GPIO interface for the Good Display
GDEY042T81 400x300 monochrome e-paper panel.

Developed with assistance from OpenAI Codex.

Signed-off-by: Andrei Aldea <andrei1998@gmail.com>
---
 .../display/gooddisplay,gdey042t81.yaml       | 69 +++++++++++++++++++
 1 file changed, 69 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/display/gooddisplay,gdey042t81.yaml

diff --git a/Documentation/devicetree/bindings/display/gooddisplay,gdey042t81.yaml b/Documentation/devicetree/bindings/display/gooddisplay,gdey042t81.yaml
new file mode 100644
index 000000000000..07e261e6a994
--- /dev/null
+++ b/Documentation/devicetree/bindings/display/gooddisplay,gdey042t81.yaml
@@ -0,0 +1,69 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/display/gooddisplay,gdey042t81.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Good Display GDEY042T81 e-paper display panel
+
+maintainers:
+  - Andrei Aldea <andrei1998@gmail.com>
+
+description:
+  The Good Display GDEY042T81 is a 400x300 monochrome e-paper panel
+  controlled by a Solomon Systech SSD1683 controller over SPI. It uses
+  GPIO signals for reset, controller busy status, and command/data
+  selection.
+
+allOf:
+  - $ref: /schemas/spi/spi-peripheral-props.yaml#
+
+properties:
+  compatible:
+    const: gooddisplay,gdey042t81
+
+  reg:
+    maxItems: 1
+
+  spi-max-frequency:
+    maximum: 2000000
+
+  reset-gpios:
+    maxItems: 1
+    description: Active-low controller reset
+
+  busy-gpios:
+    maxItems: 1
+    description: Active-high controller busy indication
+
+  dc-gpios:
+    maxItems: 1
+    description: Command/data selection signal
+
+required:
+  - compatible
+  - reg
+  - spi-max-frequency
+  - reset-gpios
+  - busy-gpios
+  - dc-gpios
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    spi {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        display@0 {
+            compatible = "gooddisplay,gdey042t81";
+            reg = <0>;
+            spi-max-frequency = <2000000>;
+            reset-gpios = <&gpio0 24 GPIO_ACTIVE_LOW>;
+            busy-gpios = <&gpio0 39 GPIO_ACTIVE_HIGH>;
+            dc-gpios = <&gpio0 90 GPIO_ACTIVE_HIGH>;
+        };
+    };
