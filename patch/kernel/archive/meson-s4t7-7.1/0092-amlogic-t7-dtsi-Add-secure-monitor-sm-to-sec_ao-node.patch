From ace722b0aafd73f95bd8a11849feb6d6c8b93ecb Mon Sep 17 00:00:00 2001
From: Patrick Yavitz <pyavitz@gmail.com>
Date: Sun, 9 Aug 2026 22:53:19 -0400
Subject: [PATCH] amlogic-t7 dtsi: Add secure-monitor = <&sm> to sec_ao node

Signed-off-by: Patrick Yavitz <pyavitz@gmail.com>
---
 arch/arm64/boot/dts/amlogic/amlogic-t7.dtsi | 1 +
 1 file changed, 1 insertion(+)

diff --git a/arch/arm64/boot/dts/amlogic/amlogic-t7.dtsi b/arch/arm64/boot/dts/amlogic/amlogic-t7.dtsi
index 2fffdecc81ac..d00dc8cdfc31 100644
--- a/arch/arm64/boot/dts/amlogic/amlogic-t7.dtsi
+++ b/arch/arm64/boot/dts/amlogic/amlogic-t7.dtsi
@@ -988,6 +988,7 @@ sec_ao: ao-secure@10220 {
 					     "amlogic,meson-gx-ao-secure",
 					     "syscon";
 				reg = <0x0 0x10220 0x0 0x140>;
+				secure-monitor = <&sm>;
 				amlogic,has-chip-id;
 			};
 
