From ffaf3d3e88cc897557c648f71dc45f2408fae1cd Mon Sep 17 00:00:00 2001
From: Patrick Yavitz <pyavitz@gmail.com>
Date: Sun, 23 Aug 2026 08:09:34 -0400
Subject: [PATCH] Khadas VIM4: Add led status support

Signed-off-by: Patrick Yavitz <pyavitz@gmail.com>
---
 .../dts/amlogic/amlogic-t7-a311d2-khadas-vim4.dts    | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/arch/arm64/boot/dts/amlogic/amlogic-t7-a311d2-khadas-vim4.dts b/arch/arm64/boot/dts/amlogic/amlogic-t7-a311d2-khadas-vim4.dts
index fb1aefd3d513..1acabfde0060 100644
--- a/arch/arm64/boot/dts/amlogic/amlogic-t7-a311d2-khadas-vim4.dts
+++ b/arch/arm64/boot/dts/amlogic/amlogic-t7-a311d2-khadas-vim4.dts
@@ -8,6 +8,7 @@
 #include "amlogic-t7.dtsi"
 #include <dt-bindings/gpio/amlogic,t7-periphs-pinctrl.h>
 #include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/leds/common.h>
 
 / {
 	model = "Khadas VIM4";
@@ -26,6 +27,17 @@ chosen {
 		kaslr-seed = <0xfeedbeef 0xc0def00d>;
  	};
 
+	leds {
+		compatible = "gpio-leds";
+ 
+		status {
+			color = <LED_COLOR_ID_WHITE>;
+			function = LED_FUNCTION_STATUS;
+			gpios = <&gpio GPIOD_6 GPIO_ACTIVE_HIGH>;
+			linux,default-trigger = "heartbeat";
+ 		};
+ 	};
+
 	memory@0 {
 		device_type = "memory";
 		reg = <0x0 0x0 0x0 0xE0000000
-- 
2.53.0

