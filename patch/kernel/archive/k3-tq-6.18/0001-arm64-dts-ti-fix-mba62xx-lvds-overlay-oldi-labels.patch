From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Martin Schmiedel <martin.schmiedel@tq-group.com>
Date: Tue, 1 Sep 2026 00:00:00 +0200
Subject: [PATCH] arm64: dts: ti: fix stale oldiN_ports label in mba62xx LVDS
 overlays

k3-am62-main.dtsi labels oldi0/oldi1's two ports individually
(oldiN_port0/oldiN_port1), not as a combined oldiN_ports container.
The two mba62xx LVDS overlays still reference the old combined label,
which FDT_ERR_NOTFOUND's at dtbo-apply time.

Signed-off-by: Martin Schmiedel <martin.schmiedel@tq-group.com>
---
 arch/arm64/boot/dts/ti/k3-am62-tqma62xx-mba62xx-lvds-tm070jdhg30.dtso | 19 +++++--------------
 arch/arm64/boot/dts/ti/k3-am62-tqma62xx-mba62xx-lvds-vesa-fhd.dtso    | 32 ++++++++------------------------
 2 files changed, 13 insertions(+), 38 deletions(-)

--- a/arch/arm64/boot/dts/ti/k3-am62-tqma62xx-mba62xx-lvds-tm070jdhg30.dtso
+++ b/arch/arm64/boot/dts/ti/k3-am62-tqma62xx-mba62xx-lvds-tm070jdhg30.dtso
@@ -37,24 +37,15 @@
 	status = "okay";
 };
 
-&oldi0_ports {
-	#address-cells = <1>;
-	#size-cells = <0>;
-
-	port@0 {
-		reg = <0>;
-
-		oldi_0_in: endpoint {
-			remote-endpoint = <&dpi0_out0>;
-		};
+&oldi0_port0 {
+	oldi_0_in: endpoint {
+		remote-endpoint = <&dpi0_out0>;
 	};
+};
 
-	port@1 {
-		reg = <1>;
-
-		oldi_0_out: endpoint {
-			remote-endpoint = <&panel_in>;
-		};
+&oldi0_port1 {
+	oldi_0_out: endpoint {
+		remote-endpoint = <&panel_in>;
 	};
 };
 
--- a/arch/arm64/boot/dts/ti/k3-am62-tqma62xx-mba62xx-lvds-vesa-fhd.dtso
+++ b/arch/arm64/boot/dts/ti/k3-am62-tqma62xx-mba62xx-lvds-vesa-fhd.dtso
@@ -38,24 +38,15 @@
 	status = "okay";
 };
 
-&oldi0_ports {
-	#address-cells = <1>;
-	#size-cells = <0>;
-
-	port@0 {
-		reg = <0>;
-
-		oldi_0_in: endpoint {
-			remote-endpoint = <&dpi0_out0>;
-		};
+&oldi0_port0 {
+	oldi_0_in: endpoint {
+		remote-endpoint = <&dpi0_out0>;
 	};
+};
 
-	port@1 {
-		reg = <1>;
-
-		oldi_0_out: endpoint {
-			remote-endpoint = <&panel_in0>;
-		};
+&oldi0_port1 {
+	oldi_0_out: endpoint {
+		remote-endpoint = <&panel_in0>;
 	};
 };
 
@@ -65,24 +56,15 @@
 	status = "okay";
 };
 
-&oldi1_ports {
-	#address-cells = <1>;
-	#size-cells = <0>;
-
-	port@0 {
-		reg = <0>;
-
-		oldi_1_in: endpoint {
-			remote-endpoint = <&dpi0_out1>;
-		};
+&oldi1_port0 {
+	oldi_1_in: endpoint {
+		remote-endpoint = <&dpi0_out1>;
 	};
+};
 
-	port@1 {
-		reg = <1>;
-
-		oldi_1_out: endpoint {
-			remote-endpoint = <&panel_in1>;
-		};
+&oldi1_port1 {
+	oldi_1_out: endpoint {
+		remote-endpoint = <&panel_in1>;
 	};
 };
 
-- 
2.43.0
