From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Josema <jomadeto@gmail.com>
Date: Sat, 26 Sep 2026 16:39:18 +0000
Subject: general: aml-c400-plus: pin runtime-PM on panfrost probe and reset
 Documentation/devicetree/bindings/gpu/arm,mali-midgard.yaml
 drivers/gpu/drm/panfrost/panfrost_drv.c

Signed-off-by: Josema <jomadeto@gmail.com>
---
 Documentation/devicetree/bindings/gpu/arm,mali-midgard.yaml |  5 ++++
 drivers/gpu/drm/panfrost/panfrost_drv.c                     | 14 +++++++++-
 2 files changed, 18 insertions(+), 1 deletion(-)

diff --git a/Documentation/devicetree/bindings/gpu/arm,mali-midgard.yaml b/Documentation/devicetree/bindings/gpu/arm,mali-midgard.yaml
index a7192622e120..19f86135a9f7 100644
--- a/Documentation/devicetree/bindings/gpu/arm,mali-midgard.yaml
+++ b/Documentation/devicetree/bindings/gpu/arm,mali-midgard.yaml
@@ -116,10 +116,15 @@ properties:
 
       Pdyn = dynamic-power-coefficient * V^2 * f
 
       where voltage is in V, frequency is in MHz.
 
+  linux,pin-runtime-pm-probe:
+    type: boolean
+    description:
+      Forces the driver to pin runtime-PM resources during the initialization probe sequence.
+
 required:
   - compatible
   - reg
   - interrupts
   - interrupt-names
diff --git a/drivers/gpu/drm/panfrost/panfrost_drv.c b/drivers/gpu/drm/panfrost/panfrost_drv.c
index 784e36d72c2b..add890645593 100644
--- a/drivers/gpu/drm/panfrost/panfrost_drv.c
+++ b/drivers/gpu/drm/panfrost/panfrost_drv.c
@@ -989,29 +989,41 @@ static int panfrost_probe(struct platform_device *pdev)
 	}
 
 	pm_runtime_set_active(pfdev->base.dev);
 	pm_runtime_mark_last_busy(pfdev->base.dev);
 	pm_runtime_enable(pfdev->base.dev);
+	if (of_property_read_bool(pdev->dev.of_node, "linux,pin-runtime-pm-probe")) {
+		err = pm_runtime_resume_and_get(pfdev->base.dev);
+		if (err < 0) {
+			dev_err(&pdev->dev, "Fatal: GPU power interconnect anchor failed: %d\n", err);
+			goto err_out1;
+		}
+		panfrost_mmu_reset(pfdev);
+	}
 	pm_runtime_set_autosuspend_delay(pfdev->base.dev, 50); /* ~3 frames */
 	pm_runtime_use_autosuspend(pfdev->base.dev);
 
 	/*
 	 * Register the DRM device with the core and the connectors with
 	 * sysfs
 	 */
 	err = drm_dev_register(&pfdev->base, 0);
 	if (err < 0)
-		goto err_out1;
+		goto err_out_pm_put;
 
 	err = panfrost_gem_shrinker_init(&pfdev->base);
 	if (err)
 		goto err_out2;
 
 	return 0;
 
 err_out2:
 	drm_dev_unregister(&pfdev->base);
+err_out_pm_put:
+	if (of_property_read_bool(pdev->dev.of_node, "linux,pin-runtime-pm-probe")) {
+		pm_runtime_put_noidle(pfdev->base.dev);
+	}
 err_out1:
 	pm_runtime_disable(pfdev->base.dev);
 	panfrost_device_fini(pfdev);
 	pm_runtime_set_suspended(pfdev->base.dev);
 err_out0:
-- 
