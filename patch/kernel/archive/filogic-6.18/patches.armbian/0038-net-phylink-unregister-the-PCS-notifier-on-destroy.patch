From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Igor Pecovnik <igor@armbian.com>
Date: Mon, 2 Nov 2026 11:14:57 +0100
Subject: [PATCH 38/41] net: phylink: unregister the PCS notifier on destroy

phylink_create() registers a PCS provider notifier, but
phylink_destroy() frees the instance without unregistering it. On
MT7988, a deferred MAC probe destroys the phylink instance. The next
provider registration then calls the notifier on freed memory.

Add unregister_fwnode_pcs_notifier() and call it in phylink_destroy().

Signed-off-by: Igor Pecovnik <igor@armbian.com>
---
 drivers/net/pcs/pcs.c     | 6 ++++++
 drivers/net/phy/phylink.c | 3 +++
 include/linux/pcs/pcs.h   | 7 +++++++
 3 files changed, 16 insertions(+)

diff --git a/drivers/net/pcs/pcs.c b/drivers/net/pcs/pcs.c
index a7352effa92f..2e1b07cba184 100644
--- a/drivers/net/pcs/pcs.c
+++ b/drivers/net/pcs/pcs.c
@@ -30,6 +30,12 @@ int register_fwnode_pcs_notifier(struct notifier_block *nb)
 }
 EXPORT_SYMBOL_GPL(register_fwnode_pcs_notifier);
 
+int unregister_fwnode_pcs_notifier(struct notifier_block *nb)
+{
+	return blocking_notifier_chain_unregister(&fwnode_pcs_notify_list, nb);
+}
+EXPORT_SYMBOL_GPL(unregister_fwnode_pcs_notifier);
+
 struct phylink_pcs *fwnode_pcs_simple_get(struct fwnode_reference_args *pcsspec,
 					  void *data)
 {
diff --git a/drivers/net/phy/phylink.c b/drivers/net/phy/phylink.c
index 22ea4dee6e5d..f4b7749ce43c 100644
--- a/drivers/net/phy/phylink.c
+++ b/drivers/net/phy/phylink.c
@@ -2156,6 +2156,9 @@ void phylink_destroy(struct phylink *pl)
 		gpiod_put(pl->link_gpio);
 
 	/* Remove every PCS from phylink PCS list */
+	if (pl->fwnode_pcs_nb.notifier_call)
+		unregister_fwnode_pcs_notifier(&pl->fwnode_pcs_nb);
+
 	list_for_each_entry_safe(pcs, tmp, &pl->pcs_list, list) {
 		list_del(&pcs->list);
 		pcs->owner = NULL;
diff --git a/include/linux/pcs/pcs.h b/include/linux/pcs/pcs.h
index 480c155a3f03..dc67fa2da6d4 100644
--- a/include/linux/pcs/pcs.h
+++ b/include/linux/pcs/pcs.h
@@ -22,6 +22,8 @@ enum fwnode_pcs_notify_event {
  */
 int register_fwnode_pcs_notifier(struct notifier_block *nb);
 
+int unregister_fwnode_pcs_notifier(struct notifier_block *nb);
+
 /**
  * fwnode_pcs_get - Retrieves a PCS from a firmware node
  * @fwnode: firmware node
@@ -80,6 +82,11 @@ static int register_fwnode_pcs_notifier(struct notifier_block *nb)
 	return -EOPNOTSUPP;
 }
 
+static inline int unregister_fwnode_pcs_notifier(struct notifier_block *nb)
+{
+	return -EOPNOTSUPP;
+}
+
 static inline struct phylink_pcs *fwnode_pcs_get(struct fwnode_handle *fwnode,
 						 int index)
 {
