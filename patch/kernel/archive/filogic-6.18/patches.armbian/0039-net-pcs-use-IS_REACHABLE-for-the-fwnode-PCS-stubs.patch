From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Igor Pecovnik <igor@armbian.com>
Date: Mon, 2 Nov 2026 11:14:58 +0100
Subject: [PATCH 39/41] net: pcs: use IS_REACHABLE() for the fwnode PCS stubs

FWNODE_PCS is tristate. With FWNODE_PCS=m and PHYLINK=y, built-in
phylink references symbols of pcs.ko and the vmlinux link fails. Use
the stubs when the module is not reachable. Make all stubs inline to
avoid unused-function warnings.

Signed-off-by: Igor Pecovnik <igor@armbian.com>
---
 include/linux/pcs/pcs.h | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/include/linux/pcs/pcs.h b/include/linux/pcs/pcs.h
index dc67fa2da6d4..d0e20c2428b5 100644
--- a/include/linux/pcs/pcs.h
+++ b/include/linux/pcs/pcs.h
@@ -8,7 +8,7 @@ enum fwnode_pcs_notify_event {
 	FWNODE_PCS_PROVIDER_ADD,
 };
 
-#if IS_ENABLED(CONFIG_FWNODE_PCS)
+#if IS_REACHABLE(CONFIG_FWNODE_PCS)
 /**
  * register_fwnode_pcs_notifier - Register a notifier block for fwnode
  *				  PCS events
@@ -77,7 +77,7 @@ int fwnode_phylink_pcs_parse(struct fwnode_handle *fwnode,
 			     struct phylink_pcs **available_pcs,
 			     unsigned int *num_pcs);
 #else
-static int register_fwnode_pcs_notifier(struct notifier_block *nb)
+static inline int register_fwnode_pcs_notifier(struct notifier_block *nb)
 {
 	return -EOPNOTSUPP;
 }
@@ -93,7 +93,7 @@ static inline struct phylink_pcs *fwnode_pcs_get(struct fwnode_handle *fwnode,
 	return ERR_PTR(-ENOENT);
 }
 
-static struct phylink_pcs *
+static inline struct phylink_pcs *
 fwnode_phylink_pcs_get_from_fwnode(struct fwnode_handle *fwnode,
 				   struct fwnode_handle *pcs_fwnode)
 {
