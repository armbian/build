From: PancakeTAS <pancake@mgnet.work>
Date: Sat, 22 Nov 2025 08:23:38 +0100
Subject: [PATCH] net: phy: ensure inband is not none for 10GBASE-R

(cherry picked from commit a0182bb78b6dfa5d8dd7ad377ce2a906b2eec7ec)
---
 drivers/net/phy/phylink.c | 1 +
 1 file changed, 1 insertion(+)

diff --git a/drivers/net/phy/phylink.c b/drivers/net/phy/phylink.c
index 0532fd6a8c1cb..2f737477e537a 100644
--- a/drivers/net/phy/phylink.c
+++ b/drivers/net/phy/phylink.c
@@ -1153,6 +1153,7 @@ static enum inband_type phylink_get_inband_type(phy_interface_t interface)
 
 	case PHY_INTERFACE_MODE_1000BASEX:
 	case PHY_INTERFACE_MODE_2500BASEX:
+	case PHY_INTERFACE_MODE_10GBASER:
 		/* 1000base-X is designed for use media-side for Fibre
 		 * connections, and thus the Autoneg bit needs to be
 		 * taken into account. We also do this for 2500base-X
