From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: PancakeTAS <pancake@mgnet.work>
Date: Sat, 22 Nov 2025 09:46:57 +0100
Subject: [PATCH] i2c: muxes: pca954x: select generic reset controller

(cherry picked from commit 0dd3d0c4c8431540cbae50a01678c7fb9340708e)
---
 drivers/i2c/muxes/Kconfig | 1 +
 1 file changed, 1 insertion(+)

diff --git a/drivers/i2c/muxes/Kconfig b/drivers/i2c/muxes/Kconfig
index 6d2f66810cdc5..39c016e8bf9d8 100644
--- a/drivers/i2c/muxes/Kconfig
+++ b/drivers/i2c/muxes/Kconfig
@@ -67,6 +67,7 @@ config I2C_MUX_PCA9541
 config I2C_MUX_PCA954x
 	tristate "NXP PCA954x/PCA984x and Maxim MAX735x/MAX736x I2C Mux/switches"
 	depends on GPIOLIB || COMPILE_TEST
+	select RESET_GPIO
 	help
 	  If you say yes here you get support for NXP PCA954x/PCA984x
 	  and Maxim MAX735x/MAX736x I2C mux/switch devices.
