From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Bo-Cun Chen <bc-bocun.chen@mediatek.com>
Date: Wed, 16 Sep 2026 20:50:24 +0200
Subject: [PATCH] net: pcs: mtk-usxgmii: fix usxgmii link flapping the
 mtk way
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

For the USXGMII link‑flap issue, remove statements that are already
executed inside mtk_usxgmii_pcs_config().

(cherry picked from commit e69eb61a1523c5e993803c05a42c55c7576b07d3)
---
 drivers/net/pcs/pcs-mtk-usxgmii.c | 4 ----
 1 file changed, 4 deletions(-)

diff --git a/drivers/net/pcs/pcs-mtk-usxgmii.c b/drivers/net/pcs/pcs-mtk-usxgmii.c
index c2fa0ba8fcc72..b2378aaf00007 100644
--- a/drivers/net/pcs/pcs-mtk-usxgmii.c
+++ b/drivers/net/pcs/pcs-mtk-usxgmii.c
@@ -313,14 +313,10 @@ static void mtk_usxgmii_pcs_link_up(struct phylink_pcs *pcs, unsigned int neg_mo
 				    phy_interface_t interface,
 				    int speed, int duplex)
 {
-	struct mtk_usxgmii_pcs *mpcs = pcs_to_mtk_usxgmii_pcs(pcs);
-
 	/* Reconfiguring USXGMII to ensure the quality of the RX signal
 	 * after the line side link up.
 	 */
 	mtk_usxgmii_pcs_config(pcs, neg_mode, interface, NULL, false);
-	phy_reset(mpcs->xfi_tphy);
-	phy_set_mode_ext(mpcs->xfi_tphy, PHY_MODE_ETHERNET, interface);
 }
 
 static int mtk_usxgmii_pcs_enable(struct phylink_pcs *pcs)
