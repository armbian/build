From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: SuperKali <hello@superkali.me>
Date: Fri, 4 Sep 2026 13:17:15 +0200
Subject: scsi: ufs: core: Register the UFS RPMB bus

device_register() rejects UFS RPMB children because the bus type is
assigned without being registered. Register it for the UFS core lifetime
and unwind it around SCSI driver registration.

Fixes: b06b8c421485 ("scsi: ufs: core: Add OP-TEE based RPMB driver for UFS devices")
Link: https://patchew.org/linux/20260702-08-k3-ufs-support-v1-0-1a64a3ab128f%40kernel.org/
Signed-off-by: SuperKali <hello@superkali.me>
---
 drivers/ufs/core/ufs-rpmb.c    | 10 +++++++
 drivers/ufs/core/ufshcd-priv.h | 11 ++++++++
 drivers/ufs/core/ufshcd.c      | 14 +++++++++-
 3 files changed, 34 insertions(+), 1 deletion(-)

diff --git a/drivers/ufs/core/ufs-rpmb.c b/drivers/ufs/core/ufs-rpmb.c
index 111111111111..222222222222 100644
--- a/drivers/ufs/core/ufs-rpmb.c
+++ b/drivers/ufs/core/ufs-rpmb.c
@@ -28,6 +28,16 @@ static const struct bus_type ufs_rpmb_bus_type = {
 	.name = "ufs_rpmb",
 };
 
+int ufs_rpmb_init(void)
+{
+	return bus_register(&ufs_rpmb_bus_type);
+}
+
+void ufs_rpmb_exit(void)
+{
+	bus_unregister(&ufs_rpmb_bus_type);
+}
+
 /* UFS RPMB device structure */
 struct ufs_rpmb_dev {
 	u8 region_id;
diff --git a/drivers/ufs/core/ufshcd-priv.h b/drivers/ufs/core/ufshcd-priv.h
index 111111111111..222222222222 100644
--- a/drivers/ufs/core/ufshcd-priv.h
+++ b/drivers/ufs/core/ufshcd-priv.h
@@ -494,9 +494,20 @@ static inline u32 ufshcd_mcq_get_sq_head_slot(struct ufs_hw_queue *q)
 }
 
 #if IS_ENABLED(CONFIG_RPMB)
+int ufs_rpmb_init(void);
+void ufs_rpmb_exit(void);
 int ufs_rpmb_probe(struct ufs_hba *hba);
 void ufs_rpmb_remove(struct ufs_hba *hba);
 #else
+static inline int ufs_rpmb_init(void)
+{
+	return 0;
+}
+
+static inline void ufs_rpmb_exit(void)
+{
+}
+
 static inline int ufs_rpmb_probe(struct ufs_hba *hba)
 {
 	return 0;
diff --git a/drivers/ufs/core/ufshcd.c b/drivers/ufs/core/ufshcd.c
index 111111111111..222222222222 100644
--- a/drivers/ufs/core/ufshcd.c
+++ b/drivers/ufs/core/ufshcd.c
@@ -11500,9 +11500,20 @@ static int __init ufshcd_core_init(void)
 
 	ufs_debugfs_init();
 
+	ret = ufs_rpmb_init();
+	if (ret)
+		goto out_debugfs;
+
 	ret = scsi_register_driver(&ufs_dev_wlun_template);
 	if (ret)
-		ufs_debugfs_exit();
+		goto out_rpmb;
+
+	return 0;
+
+out_rpmb:
+	ufs_rpmb_exit();
+out_debugfs:
+	ufs_debugfs_exit();
 	return ret;
 }
 
@@ -11510,6 +11521,7 @@ static void __exit ufshcd_core_exit(void)
 {
 	ufs_debugfs_exit();
 	scsi_unregister_driver(&ufs_dev_wlun_template);
+	ufs_rpmb_exit();
 }
 
 module_init(ufshcd_core_init);
-- 
Armbian

