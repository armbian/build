From ceea0738c1b44401ddc20203eca66e8959d63d51 Mon Sep 17 00:00:00 2001
From: Frank Wunderlich <frank-w@public-files.de>
Date: Fri, 8 May 2026 18:45:44 +0200
Subject: [PATCH] mtk_eth_dbg: fix some sparse errors

---
 drivers/net/ethernet/mediatek/mtk_eth_dbg.c | 26 ++++++++++-----------
 1 file changed, 13 insertions(+), 13 deletions(-)

diff --git a/drivers/net/ethernet/mediatek/mtk_eth_dbg.c b/drivers/net/ethernet/mediatek/mtk_eth_dbg.c
index 28004a445df1..72748cd90237 100644
--- a/drivers/net/ethernet/mediatek/mtk_eth_dbg.c
+++ b/drivers/net/ethernet/mediatek/mtk_eth_dbg.c
@@ -30,17 +30,17 @@
 #include "mtk_eth_dbg.h"
 #include "mtk_wed_regs.h"
 
-u32 hw_lro_agg_num_cnt[MTK_MAX_RX_RING_NUM][MTK_HW_LRO_MAX_AGG_CNT + 1];
-u32 hw_lro_agg_size_cnt[MTK_MAX_RX_RING_NUM][16];
-u32 hw_lro_tot_agg_cnt[MTK_MAX_RX_RING_NUM];
-u32 hw_lro_tot_flush_cnt[MTK_MAX_RX_RING_NUM];
-u32 hw_lro_agg_flush_cnt[MTK_MAX_RX_RING_NUM];
-u32 hw_lro_age_flush_cnt[MTK_MAX_RX_RING_NUM];
-u32 hw_lro_seq_flush_cnt[MTK_MAX_RX_RING_NUM];
-u32 hw_lro_timestamp_flush_cnt[MTK_MAX_RX_RING_NUM];
-u32 hw_lro_norule_flush_cnt[MTK_MAX_RX_RING_NUM];
+static u32 hw_lro_agg_num_cnt[MTK_MAX_RX_RING_NUM][MTK_HW_LRO_MAX_AGG_CNT + 1];
+static u32 hw_lro_agg_size_cnt[MTK_MAX_RX_RING_NUM][16];
+static u32 hw_lro_tot_agg_cnt[MTK_MAX_RX_RING_NUM];
+static u32 hw_lro_tot_flush_cnt[MTK_MAX_RX_RING_NUM];
+static u32 hw_lro_agg_flush_cnt[MTK_MAX_RX_RING_NUM];
+static u32 hw_lro_age_flush_cnt[MTK_MAX_RX_RING_NUM];
+static u32 hw_lro_seq_flush_cnt[MTK_MAX_RX_RING_NUM];
+static u32 hw_lro_timestamp_flush_cnt[MTK_MAX_RX_RING_NUM];
+static u32 hw_lro_norule_flush_cnt[MTK_MAX_RX_RING_NUM];
 u32 mtk_hwlro_stats_ebl;
-u32 dbg_show_level;
+static u32 dbg_show_level;
 
 static struct proc_dir_entry *proc_hw_lro_stats, *proc_hw_lro_auto_tlb;
 typedef int (*mtk_lro_dbg_func) (int par);
@@ -51,9 +51,9 @@ struct mtk_eth_debug {
 	int direct_access;
 };
 
-struct mtk_eth *g_eth;
+static struct mtk_eth *g_eth;
 
-struct mtk_eth_debug eth_debug;
+static struct mtk_eth_debug eth_debug;
 
 static ssize_t qdma_sched_show(struct file *file, char __user *user_buf,
 			       size_t count, loff_t *ppos)
@@ -2044,7 +2044,7 @@ static const struct proc_ops hw_lro_auto_tlb_fops = {
 	.proc_release = single_release
 };
 
-struct proc_dir_entry *proc_reg_dir;
+static struct proc_dir_entry *proc_reg_dir;
 static struct proc_dir_entry *proc_esw_cnt, *proc_xfi_cnt,
 			     *proc_dbg_regs, *proc_reset_event;
 
