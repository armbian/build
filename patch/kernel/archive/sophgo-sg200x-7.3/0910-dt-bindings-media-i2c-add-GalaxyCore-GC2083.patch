From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Lukasz Sobala <lsobala1@gmail.com>
Date: Wed, 12 Aug 2026 01:45:39 +0200
Subject: [PATCH] dt-bindings: media: i2c: add GalaxyCore GC2083

Add the binding for the GalaxyCore GC2083, a 1920x1080 RAW10 sensor with
a two-lane MIPI CSI-2 output. The supplies and the reset GPIO are
optional: the Milk-V CAM-GC2083 module has fixed rails and brings out
only the reset line.

Signed-off-by: Lukasz Sobala <lsobala1@gmail.com>
---
 .../bindings/media/i2c/galaxycore,gc2083.yaml | 112 ++++++++++++++++++
 1 file changed, 112 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/media/i2c/galaxycore,gc2083.yaml

diff --git a/Documentation/devicetree/bindings/media/i2c/galaxycore,gc2083.yaml b/Documentation/devicetree/bindings/media/i2c/galaxycore,gc2083.yaml
new file mode 100644
index 000000000000..4dcb16f1b159
--- /dev/null
+++ b/Documentation/devicetree/bindings/media/i2c/galaxycore,gc2083.yaml
@@ -0,0 +1,112 @@
+# SPDX-License-Identifier: (GPL-2.0 OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/i2c/galaxycore,gc2083.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: GalaxyCore GC2083 1/2.9" 2M Pixel MIPI CSI-2 sensor
+
+maintainers:
+  - Lukasz Sobala <lsobala1@gmail.com>
+
+description:
+  The GC2083 is a 1920x1080 raw image sensor with a two-lane MIPI CSI-2 data
+  interface and a CCI (I2C compatible) control bus. The output format is raw
+  Bayer, 10 bits per sample.
+
+properties:
+  compatible:
+    const: galaxycore,gc2083
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    maxItems: 1
+    description:
+      Input clock (MCLK). The sensor's timings scale with it. 24MHz gives
+      500Mbit/s per lane and 30fps.
+
+  avdd-supply:
+    description: Analogue power supply, 2.8V.
+
+  dvdd-supply:
+    description: Digital core power supply, 1.2V.
+
+  dovdd-supply:
+    description: Digital I/O power supply, 1.8V.
+
+  reset-gpios:
+    description:
+      Reference to the GPIO connected to the RESETB pin, if any. Active low.
+    maxItems: 1
+
+  port:
+    $ref: /schemas/graph.yaml#/$defs/port-base
+    additionalProperties: false
+    description:
+      Output port node, a single endpoint describing the CSI-2 transmitter.
+
+    properties:
+      endpoint:
+        $ref: /schemas/media/video-interfaces.yaml#
+        unevaluatedProperties: false
+
+        properties:
+          data-lanes:
+            items:
+              - const: 1
+              - const: 2
+
+          link-frequencies: true
+
+        required:
+          - data-lanes
+          - link-frequencies
+
+    required:
+      - endpoint
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - port
+
+allOf:
+  - $ref: /schemas/media/video-interface-devices.yaml#
+
+unevaluatedProperties: false
+
+examples:
+  # The camera on the J1 connector of a Milk-V Duo S: i2c3, MCLK from the
+  # SoC's CAM_MCLK0 output, RESETB on GPIOA_2.
+  - |
+    #include <dt-bindings/clock/sophgo,cv1800.h>
+    #include <dt-bindings/gpio/gpio.h>
+
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        camera@37 {
+            compatible = "galaxycore,gc2083";
+            reg = <0x37>;
+
+            clocks = <&clk CLK_CAM0>;
+            assigned-clocks = <&clk CLK_CAM0>;
+            assigned-clock-rates = <24000000>;
+
+            reset-gpios = <&porta 2 GPIO_ACTIVE_LOW>;
+
+            port {
+                gc2083_out: endpoint {
+                    data-lanes = <1 2>;
+                    link-frequencies = /bits/ 64 <250000000>;
+                    remote-endpoint = <&csi0_in>;
+                };
+            };
+        };
+    };
+
+...
