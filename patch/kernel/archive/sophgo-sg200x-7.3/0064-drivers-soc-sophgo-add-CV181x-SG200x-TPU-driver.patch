+
+struct dma_hdr_t {
+	uint16_t dmabuf_magic_m;
+	uint16_t dmabuf_magic_s;
+	uint32_t dmabuf_size;
+	uint32_t cpu_desc_count;
+	uint32_t bd_desc_count; /* 16 bytes */
+	uint32_t tdma_desc_count;
+	uint32_t tpu_clk_rate;
