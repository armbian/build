new file mode 100644
index 000000000000..111111111111
--- /dev/null
+++ b/drivers/soc/sophgo/tpu/cvi_tpu_interface.c
@@ -0,0 +1,1342 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * Sophgo/Cvitek CV181x (SG200x) TPU driver - chardev interface.
+ *
+ * Ported to mainline from the Cvitek duo-buildroot-sdk-v2 vendor driver
+ * (osdrv/interdrv/tpu, GPL-2.0-or-later, author Wellken Chen).
+ *
+ * Differences from the vendor driver:
+ *  - Android ION is gone; buffers are dma-bufs from the CMA dma-buf heap.
+ *    The driver is a plain dma-buf importer (attach/map/vmap), no poking
+ *    at exporter internals.
+ *  - New CVITPU_GET_DMABUF_PADDR/CVITPU_RELEASE_DMABUF ioctls: with no
+ *    IOMMU the userspace runtime builds descriptors with raw bus
+ *    addresses, which mainline heaps do not expose on their own.
+ *  - Cache flush/invalidate ioctls use dma_sync_sgtable_*() on the
+ *    driver's own mapping instead of vendor-exported arch flush symbols.
+ *  - TEE paths dropped (stubs returning 0 on cv181x in the vendor tree).
+ */
+
+#include <linux/kernel.h>
+#include <linux/init.h>
+#include <linux/sched.h>
+#include <linux/fs.h>
+#include <linux/mm.h>
+#include <linux/freezer.h>
+#include <linux/module.h>
+#include <linux/platform_device.h>
+#include <linux/reset.h>
+#include <linux/uaccess.h>
+#include <linux/dma-buf.h>
+#include <linux/dma-direction.h>
+#include <linux/dma-mapping.h>
+#include <linux/iosys-map.h>
+#include <linux/interrupt.h>
+#include <linux/device.h>
+#include <linux/delay.h>
+#include <linux/timer.h>
+#include <linux/cdev.h>
+#include <linux/kthread.h>
+#include <linux/slab.h>
+#include <linux/vmalloc.h>
+#include <linux/clk.h>
+#include <linux/of.h>
+#include <linux/sched/signal.h>
+#include <linux/proc_fs.h>
+#include <linux/seq_file.h>
+
+#include "cvi_tpu_interface.h"
+#include "cvi_tpu_ioctl.h"
+#include "tpu_platform.h"
+
+#define CVI_TPU_CDEV_NAME "cvi-tpu"
+#define CVI_TPU_CLASS_NAME "cvi-tpu"
+
+enum tpu_submit_path {
+	TPU_PATH_DESNORMAL = 0,
+	TPU_PATH_PIOTDMA = 2,
+};
+
+struct cvi_list_node {
+	struct device *dev;
+	struct list_head list;
+	pid_t pid;
+	uint32_t seq_no;
+	uint32_t pio_seq_no;
+	int dmabuf_fd;
+	struct dma_buf *dma_buf;
+	struct dma_buf_attachment *dma_attach;
+	struct sg_table *dma_sgt;
+	struct iosys_map dma_map;
+	void *dmabuf_vaddr;
+	uint64_t dmabuf_paddr;
+	enum tpu_submit_path tpu_path;
+	int ret;
+	struct tpu_tdma_pio_info pio_info;
+	/*
+	 * Validated snapshot of the command-buffer header. The submitter
+	 * keeps a mapping of the dma-buf, so the copy in the buffer can
+	 * change after validation; the run works from this one.
+	 */
+	struct dma_hdr_t hdr;
+	/* Pins on the buffers a PIO copy reads and writes. */
+	struct dma_buf *pio_src_buf;
+	struct dma_buf *pio_dst_buf;
+};
+
+/* One imported buffer registered through CVITPU_GET_DMABUF_PADDR. */
+struct cvi_tpu_buf {
+	struct list_head list;
+	struct dma_buf *dmabuf;
+	struct dma_buf_attachment *attach;
+	struct sg_table *sgt;
+	dma_addr_t daddr;
+};
+
+/* Per-open context. */
+struct cvi_tpu_ctx {
+	struct cvi_tpu_device *ndev;
+	struct list_head bufs;
+	struct mutex bufs_lock;
+};
+
+struct tpu_profiling_info {
+	uint32_t enable_usage_profiling;
+	uint32_t run_current_us;
+	uint64_t run_sum_us;
+	struct timespec64 timer_start;
+	uint32_t timer_current_us;
+	uint32_t usage;
+};
+
+struct tpu_suspend_info {
+	spinlock_t spin_lock;
+	uint8_t running_cnt;
+};
+
+static struct class *npu_class;
+static dev_t npu_cdev_id;
+static struct proc_dir_entry *tpu_proc_dir;
+static struct tpu_suspend_info tpu_suspend;
+
+#define TASK_LIST_MAX 100
+#define DONE_LIST_MAX 1000
+
+static struct tpu_profiling_info info;
+static struct timer_list profile_timer;
+#define PROFILING_INTERVAL_MS 1000
+
+static uint32_t get_duration_us(const struct timespec64 *start,
+				const struct timespec64 *end)
+{
+	return (uint32_t)((end->tv_sec - start->tv_sec) * 1000000 +
+			  (end->tv_nsec - start->tv_nsec) / 1000);
+}
+
+#define SUAGE_LOOP 2
+static void tpu_profile_timer_handler(struct timer_list *t)
+{
+	struct timespec64 timer_end;
+	static uint64_t last_sum_us, dividend;
+
+	ktime_get_ts64(&timer_end);
+	info.timer_current_us = get_duration_us(&info.timer_start, &timer_end);
+
+	if (info.timer_current_us) {
+		dividend = (info.run_sum_us - last_sum_us) * 100;
+		last_sum_us = info.run_sum_us;
+		do_div(dividend, info.timer_current_us);
+		info.usage = (uint32_t)dividend;
+	} else {
+		info.usage = 0;
+	}
+	if (info.enable_usage_profiling == SUAGE_LOOP)
+		pr_err("timer_dur=%d, sum_us=%lld, usage=%d%%\n",
+		       info.timer_current_us, last_sum_us, info.usage);
+
+	mod_timer(&profile_timer, jiffies + msecs_to_jiffies(PROFILING_INTERVAL_MS));
+	ktime_get_ts64(&info.timer_start);
+}
+
+static void tpu_profile_timer_remove(void)
+{
+	/*
+	 * No timer_pending() guard: it does not see a handler that is
+	 * already running, and the handler re-arms the timer.
+	 */
+	timer_delete_sync(&profile_timer);
+}
+
+static int tpu_profile_timer_init(void)
+{
+	tpu_profile_timer_remove();
+	profile_timer.expires = jiffies + msecs_to_jiffies(PROFILING_INTERVAL_MS);
+	add_timer(&profile_timer);
+	return 0;
+}
+
+static int tpu_proc_show(struct seq_file *m, void *v)
+{
+	if (info.enable_usage_profiling) {
+		seq_puts(m, "profiling is running\n");
+		seq_printf(m, "interval=%dms usage=%d%%\n",
+			   PROFILING_INTERVAL_MS, info.usage);
+	} else {
+		seq_puts(m, "profiling is disabled\n");
+	}
+	return 0;
+}
+
+static ssize_t tpu_proc_write(struct file *file, const char __user *user_buf,
+			      size_t count, loff_t *ppos)
+{
+	uint32_t input_param = 0;
+
+	if (kstrtouint_from_user(user_buf, count, 0, &input_param)) {
+		pr_err("input parameter incorrect, e.g.: echo 1 > /proc/tpu/usage_profiling\n");
+		return count;
+	}
+
+	tpu_profile_timer_remove();
+	memset(&info, 0, sizeof(struct tpu_profiling_info));
+
+	info.enable_usage_profiling = input_param;
+	if (info.enable_usage_profiling) {
+		tpu_profile_timer_init();
+		ktime_get_ts64(&info.timer_start);
+		pr_info("tpu usage profiling started\n");
+	} else {
+		pr_info("tpu usage profiling ended\n");
+	}
+
+	return count;
+}
+
+static int tpu_proc_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, tpu_proc_show, pde_data(inode));
+}
+
+static const struct proc_ops tpu_proc_ops = {
+	.proc_open = tpu_proc_open,
+	.proc_read = seq_read,
+	.proc_write = tpu_proc_write,
+	.proc_release = single_release,
+};
+
+static irqreturn_t cvi_tpu_tdma_irq(int irq, void *data)
+{
+	struct cvi_tpu_device *ndev = data;
+
+	/*
+	 * The TPU clocks are only on while the worker executes a job
+	 * (platform_tpu_init/deinit bracket every run), so gate on that,
+	 * not on open file handles: a job whose submitter has already
+	 * closed its fd still needs its completion interrupt acknowledged,
+	 * or this level-triggered line is never deasserted.
+	 */
+	if (!READ_ONCE(tpu_suspend.running_cnt))
+		return IRQ_NONE;
+
+	return platform_tdma_irq(ndev);
+}
+
+/* Import a dma-buf for one submit: map for DMA and vmap for the CPU. */
+static int cvi_tpu_prepare_buffer(struct cvi_list_node *node)
+{
+	struct dma_hdr_t *header;
+	size_t buf_size;
+	int ret;
+
+	node->dma_buf = dma_buf_get(node->dmabuf_fd);
+	if (IS_ERR(node->dma_buf)) {
+		pr_err("cvi-tpu: bad dmabuf fd %d\n", node->dmabuf_fd);
+		return PTR_ERR(node->dma_buf);
+	}
+
+	node->dma_attach = dma_buf_attach(node->dma_buf, node->dev);
+	if (IS_ERR(node->dma_attach)) {
+		ret = PTR_ERR(node->dma_attach);
+		goto err_put;
+	}
+
+	node->dma_sgt = dma_buf_map_attachment_unlocked(node->dma_attach,
+							DMA_BIDIRECTIONAL);
+	if (IS_ERR(node->dma_sgt)) {
+		ret = PTR_ERR(node->dma_sgt);
+		goto err_detach;
+	}
+
+	if (node->dma_sgt->nents != 1) {
+		pr_err("cvi-tpu: dmabuf is not contiguous (nents=%d), use the CMA heap\n",
+		       node->dma_sgt->nents);
+		ret = -EINVAL;
+		goto err_unmap;
+	}
+	node->dmabuf_paddr = sg_dma_address(node->dma_sgt->sgl);
+
+	ret = dma_buf_vmap_unlocked(node->dma_buf, &node->dma_map);
+	if (ret) {
+		pr_err("cvi-tpu: vmap failed (%d)\n", ret);
+		goto err_unmap;
+	}
+	node->dmabuf_vaddr = node->dma_map.vaddr;
+
+	/*
+	 * Validate the header against the buffer's real size, then work
+	 * from a snapshot: the submitter still has the buffer mapped, so
+	 * the live copy can change after these checks.
+	 */
+	buf_size = node->dma_buf->size;
+	if (buf_size < sizeof(struct dma_hdr_t)) {
+		pr_err("cvi-tpu: dmabuf (%zu bytes) smaller than the header\n",
+		       buf_size);
+		ret = -EINVAL;
+		goto err_vunmap;
+	}
+	node->hdr = *(struct dma_hdr_t *)node->dmabuf_vaddr;
+	header = &node->hdr;
+
+	if (header->dmabuf_magic_m != TPU_DMABUF_HEADER_M) {
+		pr_err("cvi-tpu: bad dmabuf header magic 0x%x\n",
+		       header->dmabuf_magic_m);
+		ret = -EINVAL;
+		goto err_vunmap;
+	}
+
+	if ((u64)header->cpu_desc_count >
+	    (buf_size - sizeof(struct dma_hdr_t)) /
+		    sizeof(struct cvi_cpu_sync_desc_t)) {
+		pr_err("cvi-tpu: %u sync descriptors do not fit a %zu-byte dmabuf\n",
+		       header->cpu_desc_count, buf_size);
+		ret = -EINVAL;
+		goto err_vunmap;
+	}
+
+	if ((header->pmubuf_offset || header->pmubuf_size) &&
+	    (header->pmubuf_offset > buf_size ||
+	     header->pmubuf_size > buf_size - header->pmubuf_offset)) {
+		pr_err("cvi-tpu: pmu buffer 0x%x+0x%x outside the dmabuf\n",
+		       header->pmubuf_offset, header->pmubuf_size);
+		ret = -EINVAL;
+		goto err_vunmap;
+	}
+
+	if ((header->pmubuf_offset & 0xF) || (header->pmubuf_size & 0xF))
+		pr_err("cvi-tpu: pmubuf_offset=0x%x pmubuf_size=0x%x misaligned\n",
+		       header->pmubuf_offset, header->pmubuf_size);
+
+	if (node->dmabuf_paddr & 0xFFF)
+		pr_err("cvi-tpu: dmabuf_paddr=0x%llx misaligned\n",
+		       node->dmabuf_paddr);
+
+	return 0;
+
+err_vunmap:
+	dma_buf_vunmap_unlocked(node->dma_buf, &node->dma_map);
+err_unmap:
+	dma_buf_unmap_attachment_unlocked(node->dma_attach, node->dma_sgt,
+					  DMA_BIDIRECTIONAL);
+err_detach:
+	dma_buf_detach(node->dma_buf, node->dma_attach);
+err_put:
+	dma_buf_put(node->dma_buf);
+	node->dma_buf = NULL;
+	return ret;
+}
+
+static void cvi_tpu_cleanup_buffer(struct cvi_list_node *node)
+{
+	if (node->tpu_path == TPU_PATH_PIOTDMA) {
+		if (node->pio_src_buf)
+			dma_buf_put(node->pio_src_buf);
+		if (node->pio_dst_buf)
+			dma_buf_put(node->pio_dst_buf);
+		node->pio_src_buf = NULL;
+		node->pio_dst_buf = NULL;
+		return;
+	}
+
+	if (node->tpu_path != TPU_PATH_DESNORMAL || !node->dma_buf)
+		return;
+
+	/*
+	 * The run wrote tpu_clk_rate into the header through the vmap;
+	 * write it back to DRAM before the unmap invalidates CPU caches.
+	 */
+	dma_sync_sgtable_for_device(node->dev, node->dma_sgt, DMA_TO_DEVICE);
+
+	dma_buf_vunmap_unlocked(node->dma_buf, &node->dma_map);
+	dma_buf_unmap_attachment_unlocked(node->dma_attach, node->dma_sgt,
+					  DMA_BIDIRECTIONAL);
+	dma_buf_detach(node->dma_buf, node->dma_attach);
+	dma_buf_put(node->dma_buf);
+	node->dma_buf = NULL;
+}
+
+/* Look up and unlink atomically; the caller owns and frees the node. */
+static struct cvi_list_node *
+take_from_done_list(struct cvi_kernel_work *kernel_work, u32 seq_no,
+		    enum tpu_submit_path path)
+{
+	struct cvi_list_node *node;
+
+	spin_lock(&kernel_work->done_list_lock);
+	node = NULL;
+	{
+		struct cvi_list_node *pos;
+
+		list_for_each_entry(pos, &kernel_work->done_list, list) {
+			u32 pos_seq = (path == TPU_PATH_PIOTDMA) ?
+					      pos->pio_seq_no : pos->seq_no;
+
+			if (pos->pid == current->pid &&
+			    pos->tpu_path == path && pos_seq == seq_no) {
+				node = pos;
+				list_del(&pos->list);
+				break;
+			}
+		}
+	}
+	spin_unlock(&kernel_work->done_list_lock);
+
+	return node;
+}
+
+static int wait_task_list_space(struct cvi_tpu_device *ndev)
+{
+	struct cvi_kernel_work *kernel_work = &ndev->kernel_work;
+	struct cvi_list_node *pos;
+	u32 task_list_count;
+
+	while (1) {
+		task_list_count = 0;
+		spin_lock(&kernel_work->task_list_lock);
+		list_for_each_entry(pos, &kernel_work->task_list, list)
+			task_list_count++;
+		spin_unlock(&kernel_work->task_list_lock);
+		if (task_list_count <= TASK_LIST_MAX)
+			return 0;
+		dev_info(ndev->dev, "too many tasks in task list\n");
+		/* Jobs drain at up to 60s each; stay killable meanwhile. */
+		if (msleep_interruptible(20))
+			return -EINTR;
+	}
+}
+
+static void queue_task(struct cvi_tpu_device *ndev, struct cvi_list_node *node)
+{
+	spin_lock(&ndev->kernel_work.task_list_lock);
+	list_add_tail(&node->list, &ndev->kernel_work.task_list);
+	wake_up_interruptible(&ndev->kernel_work.task_wait_queue);
+	spin_unlock(&ndev->kernel_work.task_list_lock);
+}
+
+static int cvi_tpu_submit(struct cvi_tpu_device *ndev, unsigned long arg)
+{
+	int ret = 0;
+	struct cvi_submit_dma_arg run_dmabuf_arg;
+	struct cvi_list_node *node;
+
+	ret = copy_from_user(&run_dmabuf_arg,
+			     (struct cvi_submit_dma_arg __user *)arg,
+			     sizeof(struct cvi_submit_dma_arg));
+	if (ret) {
+		dev_err(ndev->dev, "copy from user fail\n");
+		return -EFAULT;
+	}
+
+	ret = wait_task_list_space(ndev);
+	if (ret)
+		return ret;
+
+	node = vmalloc(sizeof(struct cvi_list_node));
+	if (!node)
+		return -ENOMEM;
+	memset(node, 0, sizeof(struct cvi_list_node));
+
+	node->pid = current->pid;
+	node->seq_no = run_dmabuf_arg.seq_no;
+	node->dmabuf_fd = run_dmabuf_arg.fd;
+	node->dev = ndev->dev;
+	node->tpu_path = TPU_PATH_DESNORMAL;
+	ret = cvi_tpu_prepare_buffer(node);
+	if (ret) {
+		vfree(node);
+		return ret;
+	}
+
+	queue_task(ndev, node);
+
+	return 0;
+}
+
+static int cvi_tpu_run_dmabuf(struct cvi_tpu_device *ndev,
+			      struct cvi_list_node *node)
+{
+	int ret = 0;
+	struct timespec64 ts_start, ts_end;
+
+	mutex_lock(&ndev->dev_lock);
+
+	if (info.enable_usage_profiling)
+		ktime_get_ts64(&ts_start);
+
+	switch (node->tpu_path) {
+	case TPU_PATH_DESNORMAL:
+		ret = platform_run_dmabuf(ndev, node->dmabuf_vaddr,
+					  node->dmabuf_paddr, &node->hdr,
+					  node->dma_buf->size);
+		break;
+	case TPU_PATH_PIOTDMA:
+		ret = platform_run_pio(ndev, &node->pio_info);
+		break;
+	default:
+		break;
+	}
+
+	if (info.enable_usage_profiling) {
+		ktime_get_ts64(&ts_end);
+		info.run_current_us = get_duration_us(&ts_start, &ts_end);
+		info.run_sum_us += info.run_current_us;
+	}
+
+	if (ret == -ETIMEDOUT)
+		platform_tpu_reset(ndev);
+	mutex_unlock(&ndev->dev_lock);
+
+	return ret;
+}
+
+static int cvi_tpu_wait_generic(struct cvi_tpu_device *ndev, unsigned long arg,
+				enum tpu_submit_path path)
+{
+	int ret = 0;
+	struct cvi_kernel_work *kernel_work = &ndev->kernel_work;
+	struct cvi_wait_dma_arg wait_arg;
+	struct cvi_list_node *node;
+
+	ret = copy_from_user(&wait_arg, (struct cvi_wait_dma_arg __user *)arg,
+			     sizeof(struct cvi_wait_dma_arg));
+	if (ret) {
+		dev_err(ndev->dev, "copy from user fail\n");
+		return -EFAULT;
+	}
+
+	/*
+	 * take_from_done_list() looks up and unlinks in one locked
+	 * section: two threads waiting on the same seq_no must not both
+	 * get the same node, or it is freed twice.
+	 */
+	ret = wait_event_interruptible(
+		kernel_work->done_wait_queue,
+		(node = take_from_done_list(kernel_work, wait_arg.seq_no,
+					    path)));
+	if (ret)
+		return -EINTR;
+
+	wait_arg.ret = node->ret;
+	ret = copy_to_user((void __user *)arg, &wait_arg, sizeof(wait_arg));
+	if (ret)
+		dev_err(ndev->dev, "copy to user fail\n");
+
+	vfree(node);
+	return ret ? -EFAULT : 0;
+}
+
+/*
+ * The TPU sits on the bus with no IOMMU, so a PIO copy is DMA to
+ * caller-chosen physical addresses. Only accept a range that lies
+ * entirely inside a dma-buf this fd has registered through
+ * CVITPU_GET_DMABUF_PADDR, and take a reference so the pages cannot
+ * be freed and reused while the copy is still queued or running.
+ */
+static struct dma_buf *cvi_tpu_pin_pio_range(struct cvi_tpu_ctx *ctx,
+					     u64 paddr, u64 len)
+{
+	struct cvi_tpu_buf *pos;
+	struct dma_buf *found = NULL;
+
+	mutex_lock(&ctx->bufs_lock);
+	list_for_each_entry(pos, &ctx->bufs, list) {
+		u64 base = pos->daddr;
+		u64 size = pos->dmabuf->size;
+
+		if (paddr >= base && len <= size &&
+		    paddr - base <= size - len) {
+			found = pos->dmabuf;
+			get_dma_buf(found);
+			break;
+		}
+	}
+	mutex_unlock(&ctx->bufs_lock);
+
+	return found;
+}
+
+static int cvi_tpu_submit_pio(struct cvi_tpu_ctx *ctx, unsigned long arg)
+{
+	struct cvi_tpu_device *ndev = ctx->ndev;
+	int ret = 0;
+	struct cvi_tdma_copy_arg ioctl_arg;
+	struct cvi_list_node *node;
+	struct dma_buf *src_buf, *dst_buf;
+	u64 src_len, dst_len;
+
+	ret = copy_from_user(&ioctl_arg,
+			     (struct cvi_tdma_copy_arg __user *)arg,
+			     sizeof(struct cvi_tdma_copy_arg));
+	if (ret) {
+		dev_err(ndev->dev, "copy from user fail\n");
+		return -EFAULT;
+	}
+
+	if (ioctl_arg.enable_2d) {
+		if (!ioctl_arg.h || !ioctl_arg.w_bytes ||
+		    ioctl_arg.stride_bytes_src < ioctl_arg.w_bytes ||
+		    ioctl_arg.stride_bytes_dst < ioctl_arg.w_bytes)
+			return -EINVAL;
+		/* The TDMA descriptor keeps 16 bits of each of these. */
+		if (ioctl_arg.h > 0xFFFF || ioctl_arg.w_bytes > 0xFFFF ||
+		    ioctl_arg.stride_bytes_src > 0xFFFF ||
+		    ioctl_arg.stride_bytes_dst > 0xFFFF)
+			return -EINVAL;
+		src_len = (u64)(ioctl_arg.h - 1) * ioctl_arg.stride_bytes_src +
+			  ioctl_arg.w_bytes;
+		dst_len = (u64)(ioctl_arg.h - 1) * ioctl_arg.stride_bytes_dst +
+			  ioctl_arg.w_bytes;
+	} else {
+		if (!ioctl_arg.leng_bytes)
+			return -EINVAL;
+		src_len = ioctl_arg.leng_bytes;
+		dst_len = ioctl_arg.leng_bytes;
+	}
+
+	src_buf = cvi_tpu_pin_pio_range(ctx, ioctl_arg.paddr_src, src_len);
+	dst_buf = cvi_tpu_pin_pio_range(ctx, ioctl_arg.paddr_dst, dst_len);
+	if (!src_buf || !dst_buf) {
+		dev_err(ndev->dev,
+			"pio range src 0x%llx+0x%llx / dst 0x%llx+0x%llx not within a registered dmabuf\n",
+			ioctl_arg.paddr_src, src_len, ioctl_arg.paddr_dst,
+			dst_len);
+		ret = -EINVAL;
+		goto err_put;
+	}
+
+	ret = wait_task_list_space(ndev);
+	if (ret)
+		goto err_put;
+
+	node = vmalloc(sizeof(struct cvi_list_node));
+	if (!node) {
+		ret = -ENOMEM;
+		goto err_put;
+	}
+	memset(node, 0, sizeof(struct cvi_list_node));
+
+	node->pid = current->pid;
+	node->pio_seq_no = ioctl_arg.seq_no;
+	node->dev = ndev->dev;
+	node->tpu_path = TPU_PATH_PIOTDMA;
+	node->pio_src_buf = src_buf;
+	node->pio_dst_buf = dst_buf;
+	if (ioctl_arg.enable_2d) {
+		node->pio_info.enable_2d = 1;
+		node->pio_info.paddr_src = ioctl_arg.paddr_src;
+		node->pio_info.paddr_dst = ioctl_arg.paddr_dst;
+		node->pio_info.h = ioctl_arg.h;
+		node->pio_info.w_bytes = ioctl_arg.w_bytes;
+		node->pio_info.stride_bytes_src = ioctl_arg.stride_bytes_src;
+		node->pio_info.stride_bytes_dst = ioctl_arg.stride_bytes_dst;
+	} else {
+		node->pio_info.paddr_src = ioctl_arg.paddr_src;
+		node->pio_info.paddr_dst = ioctl_arg.paddr_dst;
+		node->pio_info.leng_bytes = ioctl_arg.leng_bytes;
+	}
+
+	queue_task(ndev, node);
+	return 0;
+
+err_put:
+	if (src_buf)
+		dma_buf_put(src_buf);
+	if (dst_buf)
+		dma_buf_put(dst_buf);
+	return ret;
+}
+
+static void cvi_tpu_cleanup_done_list(struct cvi_tpu_device *ndev,
+				      struct cvi_kernel_work *kernel_work)
+{
+	u32 done_list_count = 0;
+	struct cvi_list_node *pos, *tmp;
+	bool alive;
+
+	spin_lock(&kernel_work->done_list_lock);
+
+	list_for_each_entry(pos, &kernel_work->done_list, list)
+		done_list_count++;
+
+	if (done_list_count < DONE_LIST_MAX) {
+		spin_unlock(&kernel_work->done_list_lock);
+		return;
+	}
+
+	dev_info(ndev->dev, "done list has too many nodes, cleaning up\n");
+
+	list_for_each_entry_safe(pos, tmp, &kernel_work->done_list, list) {
+		rcu_read_lock();
+		alive = pid_task(find_vpid(pos->pid), PIDTYPE_PID) != NULL;
+		rcu_read_unlock();
+		if (!alive) {
+			list_del(&pos->list);
+			vfree(pos);
+		}
+	}
+
+	spin_unlock(&kernel_work->done_list_lock);
+}
+
+static void work_thread_run(struct cvi_tpu_device *ndev)
+{
+	struct cvi_kernel_work *kernel_work = &ndev->kernel_work;
+	struct cvi_list_node *first_node;
+	int ret = 0;
+
+	spin_lock(&kernel_work->task_list_lock);
+	first_node = list_first_entry(&kernel_work->task_list,
+				      struct cvi_list_node, list);
+	list_del(&first_node->list);
+	spin_unlock(&kernel_work->task_list_lock);
+
+	/*
+	 * Clocks on before the interrupt handler is ungated: with
+	 * running_cnt set, the handler touches TDMA registers, and a
+	 * register access while the clocks are gated stalls the bus.
+	 */
+	platform_tpu_init(ndev);
+	WRITE_ONCE(tpu_suspend.running_cnt, 1);
+
+	ret = cvi_tpu_run_dmabuf(ndev, first_node);
+	first_node->ret = ret;
+	cvi_tpu_cleanup_buffer(first_node);
+
+	WRITE_ONCE(tpu_suspend.running_cnt, 0);
+	platform_tpu_deinit(ndev);
+
+	spin_lock(&kernel_work->done_list_lock);
+	list_add_tail(&first_node->list, &kernel_work->done_list);
+	spin_unlock(&kernel_work->done_list_lock);
+
+	wake_up_all(&kernel_work->done_wait_queue);
+
+	cvi_tpu_cleanup_done_list(ndev, kernel_work);
+}
+
+static int task_list_empty(struct cvi_kernel_work *kernel_work)
+{
+	int ret;
+
+	spin_lock(&kernel_work->task_list_lock);
+	ret = list_empty(&kernel_work->task_list);
+	spin_unlock(&kernel_work->task_list_lock);
+
+	return ret;
+}
+
+static void work_thread_exit(struct cvi_tpu_device *ndev)
+{
+	struct cvi_kernel_work *kernel_work = &ndev->kernel_work;
+	struct cvi_list_node *pos, *tmp;
+	LIST_HEAD(reap);
+
+	spin_lock(&kernel_work->task_list_lock);
+	list_splice_init(&kernel_work->task_list, &reap);
+	spin_unlock(&kernel_work->task_list_lock);
+
+	spin_lock(&kernel_work->done_list_lock);
+	list_splice_tail_init(&kernel_work->done_list, &reap);
+	spin_unlock(&kernel_work->done_list_lock);
+
+	/*
+	 * Cleanup outside the spinlocks - it unmaps and sleeps. Never-run
+	 * task nodes still hold their buffer references; for already-run
+	 * nodes the cleanup is a no-op.
+	 */
+	list_for_each_entry_safe(pos, tmp, &reap, list) {
+		cvi_tpu_cleanup_buffer(pos);
+		vfree(pos);
+	}
+}
+
+static int work_thread_main(void *data)
+{
+	struct cvi_tpu_device *ndev = data;
+	struct cvi_kernel_work *kernel_work = &ndev->kernel_work;
+
+	set_freezable();
+	while (!kthread_should_stop()) {
+		wait_event_freezable(kernel_work->task_wait_queue,
+				     !task_list_empty(kernel_work) ||
+					     kthread_should_stop());
+
+		if (!task_list_empty(kernel_work))
+			work_thread_run(ndev);
+	}
+
+	work_thread_exit(ndev);
+
+	return 0;
+}
+
+static int work_thread_init(struct cvi_tpu_device *ndev)
+{
+	struct cvi_kernel_work *kernel_work = &ndev->kernel_work;
+
+	init_waitqueue_head(&kernel_work->task_wait_queue);
+	init_waitqueue_head(&kernel_work->done_wait_queue);
+	INIT_LIST_HEAD(&kernel_work->task_list);
+	spin_lock_init(&kernel_work->task_list_lock);
+	INIT_LIST_HEAD(&kernel_work->done_list);
+	spin_lock_init(&kernel_work->done_list_lock);
+
+	kernel_work->work_thread =
+		kthread_run(work_thread_main, ndev, "cvitask_tpu_wor");
+	if (IS_ERR(kernel_work->work_thread)) {
+		dev_err(ndev->dev, "kthread run fail\n");
+		return PTR_ERR(kernel_work->work_thread);
+	}
+
+	return 0;
+}
+
+/* --- imported-buffer registry (GET_PADDR / RELEASE / FLUSH / INVLD) --- */
+
+static struct cvi_tpu_buf *cvi_tpu_find_buf(struct cvi_tpu_ctx *ctx,
+					    struct dma_buf *dmabuf)
+{
+	struct cvi_tpu_buf *pos;
+
+	list_for_each_entry(pos, &ctx->bufs, list) {
+		if (pos->dmabuf == dmabuf)
+			return pos;
+	}
+	return NULL;
+}
+
+static void cvi_tpu_release_buf(struct cvi_tpu_buf *buf)
+{
+	list_del(&buf->list);
+	dma_buf_unmap_attachment_unlocked(buf->attach, buf->sgt,
+					  DMA_BIDIRECTIONAL);
+	dma_buf_detach(buf->dmabuf, buf->attach);
+	dma_buf_put(buf->dmabuf);
+	kfree(buf);
+}
+
+static int cvi_tpu_get_paddr(struct cvi_tpu_ctx *ctx, unsigned long arg)
+{
+	struct cvi_tpu_device *ndev = ctx->ndev;
+	struct cvi_dmabuf_paddr_arg ioctl_arg;
+	struct cvi_tpu_buf *buf;
+	struct dma_buf *dmabuf;
+	int ret;
+
+	ret = copy_from_user(&ioctl_arg,
+			     (struct cvi_dmabuf_paddr_arg __user *)arg,
+			     sizeof(ioctl_arg));
+	if (ret)
+		return -EFAULT;
+
+	dmabuf = dma_buf_get(ioctl_arg.fd);
+	if (IS_ERR(dmabuf))
+		return PTR_ERR(dmabuf);
+
+	mutex_lock(&ctx->bufs_lock);
+
+	buf = cvi_tpu_find_buf(ctx, dmabuf);
+	if (buf) {
+		dma_buf_put(dmabuf);
+		goto found;
+	}
+
+	buf = kzalloc(sizeof(*buf), GFP_KERNEL);
+	if (!buf) {
+		ret = -ENOMEM;
+		goto err_put;
+	}
+
+	buf->dmabuf = dmabuf;
+	buf->attach = dma_buf_attach(dmabuf, ndev->dev);
+	if (IS_ERR(buf->attach)) {
+		ret = PTR_ERR(buf->attach);
+		goto err_free;
+	}
+
+	buf->sgt = dma_buf_map_attachment_unlocked(buf->attach,
+						   DMA_BIDIRECTIONAL);
+	if (IS_ERR(buf->sgt)) {
+		ret = PTR_ERR(buf->sgt);
+		dma_buf_detach(dmabuf, buf->attach);
+		goto err_free;
+	}
+
+	if (buf->sgt->nents != 1) {
+		dev_err(ndev->dev,
+			"dmabuf not contiguous (nents=%d), use the CMA heap\n",
+			buf->sgt->nents);
+		dma_buf_unmap_attachment_unlocked(buf->attach, buf->sgt,
+						  DMA_BIDIRECTIONAL);
+		dma_buf_detach(dmabuf, buf->attach);
+		ret = -EINVAL;
+		goto err_free;
+	}
+
+	buf->daddr = sg_dma_address(buf->sgt->sgl);
+	list_add_tail(&buf->list, &ctx->bufs);
+
+found:
+	/* Read before unlock: a concurrent RELEASE_DMABUF frees buf. */
+	ioctl_arg.paddr = buf->daddr;
+	mutex_unlock(&ctx->bufs_lock);
+	if (copy_to_user((struct cvi_dmabuf_paddr_arg __user *)arg, &ioctl_arg,
+			 sizeof(ioctl_arg)))
+		return -EFAULT;
+	return 0;
+
+err_free:
+	kfree(buf);
+err_put:
+	dma_buf_put(dmabuf);
+	mutex_unlock(&ctx->bufs_lock);
+	return ret;
+}
+
+static int cvi_tpu_release_dmabuf(struct cvi_tpu_ctx *ctx, unsigned long arg)
+{
+	struct cvi_tpu_buf *buf;
+	struct dma_buf *dmabuf;
+	int fd, ret = 0;
+
+	if (get_user(fd, (int __user *)arg))
+		return -EFAULT;
+
+	dmabuf = dma_buf_get(fd);
+	if (IS_ERR(dmabuf))
+		return PTR_ERR(dmabuf);
+
+	mutex_lock(&ctx->bufs_lock);
+	buf = cvi_tpu_find_buf(ctx, dmabuf);
+	if (buf)
+		cvi_tpu_release_buf(buf);
+	else
+		ret = -ENOENT;
+	mutex_unlock(&ctx->bufs_lock);
+
+	dma_buf_put(dmabuf);
+	return ret;
+}
+
+/*
+ * Flush/invalidate through the registered mapping. Falls back to a
+ * transient attach/map cycle (whose implicit syncs do the same job)
+ * when the fd was never registered with GET_PADDR.
+ */
+static int cvi_tpu_cache_sync(struct cvi_tpu_ctx *ctx, unsigned long arg,
+			      bool to_device)
+{
+	struct cvi_tpu_device *ndev = ctx->ndev;
+	struct cvi_cache_op_arg sync_arg;
+	struct cvi_tpu_buf *buf;
+	struct dma_buf *dmabuf;
+	int ret;
+
+	ret = copy_from_user(&sync_arg, (struct cvi_cache_op_arg __user *)arg,
+			     sizeof(sync_arg));
+	if (ret)
+		return -EFAULT;
+
+	dmabuf = dma_buf_get(sync_arg.dma_fd);
+	if (IS_ERR(dmabuf))
+		return -EINVAL;
+
+	mutex_lock(&ctx->bufs_lock);
+	buf = cvi_tpu_find_buf(ctx, dmabuf);
+	if (buf) {
+		if (to_device)
+			dma_sync_sgtable_for_device(ndev->dev, buf->sgt,
+						    DMA_TO_DEVICE);
+		else
+			dma_sync_sgtable_for_cpu(ndev->dev, buf->sgt,
+						 DMA_FROM_DEVICE);
+	}
+	mutex_unlock(&ctx->bufs_lock);
+
+	if (!buf) {
+		struct dma_buf_attachment *attach;
+		struct sg_table *sgt;
+		enum dma_data_direction dir =
+			to_device ? DMA_TO_DEVICE : DMA_FROM_DEVICE;
+
+		attach = dma_buf_attach(dmabuf, ndev->dev);
+		if (IS_ERR(attach)) {
+			ret = PTR_ERR(attach);
+			goto out;
+		}
+		sgt = dma_buf_map_attachment_unlocked(attach, dir);
+		if (IS_ERR(sgt)) {
+			ret = PTR_ERR(sgt);
+			dma_buf_detach(dmabuf, attach);
+			goto out;
+		}
+		dma_buf_unmap_attachment_unlocked(attach, sgt, dir);
+		dma_buf_detach(dmabuf, attach);
+	}
+
+out:
+	dma_buf_put(dmabuf);
+	return ret;
+}
+
+/* Vendor FLUSH_FD/INVLD_FD: transient map/unmap for its sync side effect. */
+static int cvi_tpu_map_dmabuf(struct cvi_tpu_device *ndev, unsigned long arg,
+			      enum dma_data_direction direction)
+{
+	int ret = 0;
+	int dmabuf_fd;
+	struct dma_buf *dma_buf;
+	struct dma_buf_attachment *attachment;
+	struct sg_table *sgt;
+
+	ret = get_user(dmabuf_fd, (int __user *)arg);
+	if (ret)
+		return ret;
+
+	dma_buf = dma_buf_get(dmabuf_fd);
+	if (IS_ERR(dma_buf))
+		return -EINVAL;
+
+	attachment = dma_buf_attach(dma_buf, ndev->dev);
+	if (IS_ERR(attachment)) {
+		ret = -EINVAL;
+		goto err_attach;
+	}
+
+	sgt = dma_buf_map_attachment_unlocked(attachment, direction);
+	if (IS_ERR(sgt)) {
+		ret = -EINVAL;
+		goto err_map;
+	}
+
+	dma_buf_unmap_attachment_unlocked(attachment, sgt, direction);
+
+err_map:
+	dma_buf_detach(dma_buf, attachment);
+
+err_attach:
+	dma_buf_put(dma_buf);
+
+	return ret;
+}
+
+static int cvi_tpu_usage_get(struct cvi_tpu_device *ndev, unsigned long arg)
+{
+	if (copy_to_user((uint64_t __user *)arg, &info.run_sum_us,
+			 sizeof(uint64_t)))
+		return -EFAULT;
+	return 0;
+}
+
+static long cvi_tpu_ioctl(struct file *filp, unsigned int cmd,
+			  unsigned long arg)
+{
+	struct cvi_tpu_ctx *ctx = filp->private_data;
+	struct cvi_tpu_device *ndev = ctx->ndev;
+	long ret = 0;
+
+	switch (cmd) {
+	case CVITPU_SUBMIT_DMABUF:
+		ret = cvi_tpu_submit(ndev, arg);
+		break;
+	case CVITPU_DMABUF_FLUSH_FD:
+		ret = cvi_tpu_map_dmabuf(ndev, arg, DMA_TO_DEVICE);
+		break;
+	case CVITPU_DMABUF_INVLD_FD:
+		ret = cvi_tpu_map_dmabuf(ndev, arg, DMA_FROM_DEVICE);
+		break;
+	case CVITPU_DMABUF_FLUSH:
+		ret = cvi_tpu_cache_sync(ctx, arg, true);
+		break;
+	case CVITPU_DMABUF_INVLD:
+		ret = cvi_tpu_cache_sync(ctx, arg, false);
+		break;
+	case CVITPU_WAIT_DMABUF:
+		ret = cvi_tpu_wait_generic(ndev, arg, TPU_PATH_DESNORMAL);
+		break;
+	case CVITPU_SUBMIT_PIO:
+		ret = cvi_tpu_submit_pio(ctx, arg);
+		break;
+	case CVITPU_WAIT_PIO:
+		ret = cvi_tpu_wait_generic(ndev, arg, TPU_PATH_PIOTDMA);
+		break;
+	case CVITPU_GET_USAGE:
+		ret = cvi_tpu_usage_get(ndev, arg);
+		break;
+	case CVITPU_GET_DMABUF_PADDR:
+		ret = cvi_tpu_get_paddr(ctx, arg);
+		break;
+	case CVITPU_RELEASE_DMABUF:
+		ret = cvi_tpu_release_dmabuf(ctx, arg);
+		break;
+	default:
+		return -ENOTTY;
+	}
+
+	return ret;
+}
+
+static int cvi_tpu_open(struct inode *inode, struct file *filp)
+{
+	struct cvi_tpu_device *ndev =
+		container_of(inode->i_cdev, struct cvi_tpu_device, cdev);
+	struct cvi_tpu_ctx *ctx;
+
+	ctx = kzalloc(sizeof(*ctx), GFP_KERNEL);
+	if (!ctx)
+		return -ENOMEM;
+	ctx->ndev = ndev;
+	INIT_LIST_HEAD(&ctx->bufs);
+	mutex_init(&ctx->bufs_lock);
+
+	filp->private_data = ctx;
+
+	return 0;
+}
+
+static int cvi_tpu_close(struct inode *inode, struct file *filp)
+{
+	struct cvi_tpu_ctx *ctx = filp->private_data;
+	struct cvi_tpu_buf *pos, *tmp;
+
+	mutex_lock(&ctx->bufs_lock);
+	list_for_each_entry_safe(pos, tmp, &ctx->bufs, list)
+		cvi_tpu_release_buf(pos);
+	mutex_unlock(&ctx->bufs_lock);
+
+	kfree(ctx);
+	filp->private_data = NULL;
+
+	return 0;
+}
+
+static const struct file_operations npu_fops = {
+	.owner = THIS_MODULE,
+	.open = cvi_tpu_open,
+	.release = cvi_tpu_close,
+	.unlocked_ioctl = cvi_tpu_ioctl,
+	.compat_ioctl = cvi_tpu_ioctl,
+};
+
+static int cvi_tpu_register_cdev(struct cvi_tpu_device *ndev)
+{
+	struct device *cd;
+	int ret;
+
+	npu_class = class_create(CVI_TPU_CLASS_NAME);
+	if (IS_ERR(npu_class)) {
+		pr_err("create class failed\n");
+		return PTR_ERR(npu_class);
+	}
+
+	ret = alloc_chrdev_region(&npu_cdev_id, 0, 1, CVI_TPU_CDEV_NAME);
+	if (ret < 0) {
+		pr_err("alloc chrdev failed\n");
+		goto err_class;
+	}
+
+	cdev_init(&ndev->cdev, &npu_fops);
+	ndev->cdev.owner = THIS_MODULE;
+	ret = cdev_add(&ndev->cdev, npu_cdev_id, 1);
+	if (ret < 0) {
+		pr_err("cdev_add failed\n");
+		goto err_region;
+	}
+
+	cd = device_create(npu_class, ndev->dev, npu_cdev_id, NULL, "%s%d",
+			   CVI_TPU_CDEV_NAME, 0);
+	if (IS_ERR(cd)) {
+		ret = PTR_ERR(cd);
+		goto err_cdev;
+	}
+
+	return 0;
+
+err_cdev:
+	cdev_del(&ndev->cdev);
+err_region:
+	unregister_chrdev_region(npu_cdev_id, 1);
+err_class:
+	class_destroy(npu_class);
+	return ret;
+}
+
+static void cvi_tpu_unregister_cdev(struct cvi_tpu_device *ndev)
+{
+	device_destroy(npu_class, npu_cdev_id);
+	cdev_del(&ndev->cdev);
+	unregister_chrdev_region(npu_cdev_id, 1);
+	class_destroy(npu_class);
+}
+
+static int cvi_tpu_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct cvi_tpu_device *ndev;
+	int ret;
+
+	ret = dma_set_mask_and_coherent(dev, DMA_BIT_MASK(40));
+	if (ret)
+		return ret;
+
+	ndev = devm_kzalloc(dev, sizeof(*ndev), GFP_KERNEL);
+	if (!ndev)
+		return -ENOMEM;
+	ndev->dev = dev;
+
+	ndev->tdma_vaddr = devm_platform_ioremap_resource_byname(pdev, "tdma");
+	if (IS_ERR(ndev->tdma_vaddr))
+		return PTR_ERR(ndev->tdma_vaddr);
+
+	ndev->tiu_vaddr = devm_platform_ioremap_resource_byname(pdev, "tiu");
+	if (IS_ERR(ndev->tiu_vaddr))
+		return PTR_ERR(ndev->tiu_vaddr);
+
+	ndev->tdma_irq = platform_get_irq(pdev, 1);
+	if (ndev->tdma_irq < 0)
+		return ndev->tdma_irq;
+
+	ret = devm_request_irq(dev, ndev->tdma_irq, cvi_tpu_tdma_irq, 0,
+			       "cvi-tpu-tdma", ndev);
+	if (ret)
+		return ret;
+
+	ndev->clk_tpu_axi = devm_clk_get(dev, "clk_tpu_axi");
+	if (IS_ERR(ndev->clk_tpu_axi)) {
+		dev_warn(dev, "cannot get clk_tpu_axi\n");
+		ndev->clk_tpu_axi = NULL;
+	}
+
+	ndev->clk_tpu_fab = devm_clk_get(dev, "clk_tpu_fab");
+	if (IS_ERR(ndev->clk_tpu_fab)) {
+		dev_warn(dev, "cannot get clk_tpu_fab\n");
+		ndev->clk_tpu_fab = NULL;
+	}
+
+	/* Resets are only used for timeout recovery; optional. */
+	ndev->rst_tdma = devm_reset_control_get_optional(dev, "res_tdma");
+	if (IS_ERR(ndev->rst_tdma))
+		ndev->rst_tdma = NULL;
+	ndev->rst_tpu = devm_reset_control_get_optional(dev, "res_tpu");
+	if (IS_ERR(ndev->rst_tpu))
+		ndev->rst_tpu = NULL;
+	ndev->rst_tpusys = devm_reset_control_get_optional(dev, "res_tpusys");
+	if (IS_ERR(ndev->rst_tpusys))
+		ndev->rst_tpusys = NULL;
+
+	spin_lock_init(&tpu_suspend.spin_lock);
+	tpu_suspend.running_cnt = 0;
+
+	platform_tpu_probe_setting();
+
+	init_completion(&ndev->tdma_done);
+	mutex_init(&ndev->dev_lock);
+
+	ret = cvi_tpu_register_cdev(ndev);
+	if (ret < 0)
+		return ret;
+
+	ret = work_thread_init(ndev);
+	if (ret < 0) {
+		cvi_tpu_unregister_cdev(ndev);
+		return ret;
+	}
+
+	platform_set_drvdata(pdev, ndev);
+
+	timer_setup(&profile_timer, tpu_profile_timer_handler, 0);
+
+	tpu_proc_dir = proc_mkdir("tpu", NULL);
+	if (proc_create_data("usage_profiling", 0644, tpu_proc_dir,
+			     &tpu_proc_ops, ndev) == NULL)
+		dev_warn(dev, "tpu usage_profiling proc creation failed\n");
+
+	dev_info(dev, "cvitek tpu registered (/dev/%s0)\n", CVI_TPU_CDEV_NAME);
+	return 0;
+}
+
+static void cvi_tpu_remove(struct platform_device *pdev)
+{
+	struct cvi_tpu_device *ndev = platform_get_drvdata(pdev);
+	struct cvi_kernel_work *kernel_work = &ndev->kernel_work;
+
+	/*
+	 * The proc file goes first: a write there re-arms the profiling
+	 * timer, which must not happen after the shutdown below.
+	 */
+	proc_remove(tpu_proc_dir);
+
+	/* Final teardown: also keep the handler from ever re-arming. */
+	timer_shutdown_sync(&profile_timer);
+	kthread_stop(kernel_work->work_thread);
+
+	cvi_tpu_unregister_cdev(ndev);
+
+	platform_set_drvdata(pdev, NULL);
+}
+
+#ifdef CONFIG_PM_SLEEP
+static int cvi_tpu_suspend(struct device *dev)
+{
+	if (tpu_suspend.running_cnt) {
+		struct cvi_tpu_device *ndev = dev_get_drvdata(dev);
+
+		platform_tpu_suspend(ndev);
+	}
+
+	return 0;
+}
+
+static int cvi_tpu_resume(struct device *dev)
+{
+	if (tpu_suspend.running_cnt) {
+		struct cvi_tpu_device *ndev = dev_get_drvdata(dev);
+
+		platform_tpu_resume(ndev);
+	}
+	return 0;
+}
+#endif
+
+static SIMPLE_DEV_PM_OPS(cvi_tpu_pm_ops, cvi_tpu_suspend, cvi_tpu_resume);
+
+static const struct of_device_id cvi_tpu_match[] = {
+	{ .compatible = "cvitek,tpu" },
+	{},
+};
+MODULE_DEVICE_TABLE(of, cvi_tpu_match);
+
+static struct platform_driver cvi_tpu_driver = {
+	.probe = cvi_tpu_probe,
+	.remove = cvi_tpu_remove,
+	.driver = {
+			.name = "cvi-tpu",
+			.pm = &cvi_tpu_pm_ops,
+			.of_match_table = cvi_tpu_match,
+		},
+};
+module_platform_driver(cvi_tpu_driver);
+
+MODULE_IMPORT_NS("DMA_BUF");
+MODULE_AUTHOR("Wellken Chen<wellken.chen@cvitek.com.tw>");
+MODULE_DESCRIPTION("Cvitek SoC TPU driver");
+MODULE_LICENSE("GPL");
