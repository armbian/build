From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: morikon <leafpmpmp@gmail.com>
Date: Thu, 17 Sep 2026 10:08:28 +0000
Subject: riscv: dts: sophgo: reserve a default CMA pool on the Milk-V Duo S

The TPU has no IOMMU and consumes large physically contiguous buffers
allocated by userspace from the CMA dma-buf heap. Reserve a reusable
128MiB default CMA area; unlike the vendor 170MiB ION carveout, CMA
pages remain available to the page allocator while the TPU is idle.

Signed-off-by: morikon <leafpmpmp@gmail.com>
---
 arch/riscv/boot/dts/sophgo/sg2000-milkv-duo-s.dts | 15 ++++++++++
 1 file changed, 15 insertions(+)

diff --git a/arch/riscv/boot/dts/sophgo/sg2000-milkv-duo-s.dts b/arch/riscv/boot/dts/sophgo/sg2000-milkv-duo-s.dts
index 111111111111..222222222222 100644
--- a/arch/riscv/boot/dts/sophgo/sg2000-milkv-duo-s.dts
+++ b/arch/riscv/boot/dts/sophgo/sg2000-milkv-duo-s.dts
@@ -36,6 +36,21 @@ ramoops@90000000 {
 			record-size = <0x8000>;
 			console-size = <0x20000>;
 		};
+
+		/*
+		 * Default CMA pool, exposed to userspace as the CMA dma-buf
+		 * heap. The TPU has no IOMMU and needs large physically
+		 * contiguous buffers; 128MiB matches typical cvimodel working
+		 * sets while staying reusable by the page allocator when the
+		 * TPU is idle. Override with cma=<size> on the command line.
+		 */
+		linux,cma {
+			compatible = "shared-dma-pool";
+			reusable;
+			size = <0x8000000>;
+			alignment = <0x400000>;
+			linux,cma-default;
+		};
 	};
 
 	aliases {
