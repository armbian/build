+#include <linux/clk.h>
+#include <linux/debugfs.h>
+#include <linux/delay.h>
+#include <linux/dma-mapping.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/iopoll.h>
+#include <linux/mfd/syscon.h>
+#include <linux/module.h>
+#include <linux/mod_devicetable.h>
+#include <linux/platform_device.h>
+#include <linux/pm_runtime.h>
+#include <linux/property.h>
+#include <linux/regmap.h>
+#include <linux/reset.h>
+#include <linux/seq_file.h>
+
+#include <media/media-device.h>
+#include <media/v4l2-async.h>
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-device.h>
+#include <media/v4l2-event.h>
+#include <media/v4l2-fwnode.h>
+#include <media/v4l2-ioctl.h>
+#include <media/v4l2-mc.h>
+#include <media/v4l2-subdev.h>
+#include <media/videobuf2-dma-contig.h>
+
+#define CV1800_VI_NAME			"cv1800-vi"
+
+/* vip_sys, shared with the CSI-2 receiver */
+#define VIP_SYS_RESETS			0x00
+#define   VIP_RST_ISP_TOP		BIT(1)
+#define   VIP_RST_ISP_TOP_APB		BIT(17)
+#define VIP_SYS_RESERVE			0x04
+#define   VIP_AXI_ISP_TOP_CLK_EN	BIT(0)
+#define VIP_SYS_AXI_SW			0x10
+#define   VIP_AXI_SW_SC_TOP		BIT(0)
+#define   VIP_AXI_SW_ISP_RAW		BIT(1)
+#define   VIP_AXI_SW_ISP_YUV		BIT(2)
+#define VIP_SYS_CLK_CTRL1		0x1c
+#define   VIP_CLK_MAC0_SRC		GENMASK(5, 4)
+#define     VIP_CLK_SRC_VIP_SYS_2	2
+#define VIP_SYS_DIV_CSI_MAC0		0x38
+#define   VIP_DIV_EN			BIT(0)
+#define   VIP_DIV_UPDATE		BIT(2)
+#define   VIP_DIV_RATIO			GENMASK(20, 16)
+
+/* Block offsets in the VI register window */
+#define VI_FE0				0x00000
+#define VI_CSIBDG0			0x00800
+#define VI_DMA_CTL6			0x00b00
+#define VI_ISPTOP			0x70000
+
+/* ISP top */
+#define TOP_INT_EVENT0			(VI_ISPTOP + 0x00)
+#define   EV0_FRAME_DONE_FE0_CH0	BIT(0)
+#define TOP_INT_EVENT1			(VI_ISPTOP + 0x04)
+#define TOP_INT_EVENT2			(VI_ISPTOP + 0x08)
+#define   EV2_FRAME_START_FE0_CH0	BIT(0)
+#define   EV2_FRAME_ERR			BIT(8)
+#define   EV2_INT_DMA_ERR		BIT(16)
+#define TOP_INT_EVENT0_EN		(VI_ISPTOP + 0x10)
+#define TOP_INT_EVENT1_EN		(VI_ISPTOP + 0x14)
+#define TOP_INT_EVENT2_EN		(VI_ISPTOP + 0x18)
+#define TOP_SW_CTRL_0			(VI_ISPTOP + 0x20)
+#define   SW0_SHAW_UP_FE0		GENMASK(19, 16)
+#define TOP_SW_CTRL_1			(VI_ISPTOP + 0x24)
+#define   SW1_PQ_UP_FE0			GENMASK(3, 0)
+#define TOP_CTRL_MODE_SEL0		(VI_ISPTOP + 0x28)
+#define   SEL0_TRIG_STR_SEL_FE0		GENMASK(3, 0)
+#define   SEL0_SHAW_UP_SEL_FE0		GENMASK(19, 16)
+#define TOP_CTRL_MODE_SEL1		(VI_ISPTOP + 0x2c)
+#define   SEL1_PQ_UP_SEL_FE0		GENMASK(3, 0)
+#define TOP_SCENARIOS_CTRL		(VI_ISPTOP + 0x30)
+#define   SCN_ROUTING			GENMASK(21, 0)
+#define   SCN_FE_DMA_SHARE_ENABLE	BIT(22)
+#define TOP_SW_RST			(VI_ISPTOP + 0x34)
+#define   SW_RST_AXI			BIT(6)
+#define   SW_RST_ALL			0x37f
+#define TOP_BLK_IDLE			(VI_ISPTOP + 0x38)
+#define   BLK_IDLE_FE0			BIT(0)
+#define   BLK_IDLE_WDMA0		BIT(8)
+#define   BLK_IDLE_WDMA1		BIT(9)
+#define   BLK_IDLE_RAW			(BLK_IDLE_FE0 | BLK_IDLE_WDMA0 | BLK_IDLE_WDMA1)
+#define TOP_SVN_VERSION			(VI_ISPTOP + 0x74)
+
+/* Pre-raw front end 0 */
+#define FE_CTRL				(VI_FE0 + 0x00)
+#define   FE_BAYER_TYPE_LE		GENMASK(3, 0)
+#define   FE_BAYER_TYPE_SE		GENMASK(7, 4)
+#define FE_FRAME_SIZE			(VI_FE0 + 0x04)
+#define FE_FRAME_VLD			(VI_FE0 + 0x28)
+#define   FE_FRAME_VLD_CH0		BIT(0)
+#define   FE_PQ_VLD_CH0			BIT(4)
+
+/* CSI bridge 0 */
+#define BDG_TOP_CTRL			(VI_CSIBDG0 + 0x00)
+#define   BDG_CSI_MODE			GENMASK(1, 0)
+#define     BDG_CSI_MODE_SENSOR		1
+#define     BDG_CSI_MODE_PATGEN		3
+#define   BDG_CSI_IN_FORMAT		BIT(2)
+#define   BDG_CH_NUM			GENMASK(5, 4)
+#define   BDG_CH0_DMA_WR_ENABLE		BIT(6)
+#define   BDG_PXL_DATA_SEL		BIT(10)
+#define   BDG_RESET_MODE		BIT(13)
+#define   BDG_VS_MODE			BIT(14)
+#define   BDG_ABORT_MODE		BIT(15)
+#define   BDG_ABORT			BIT(17)
+#define   BDG_CSI_ENABLE		BIT(24)
+#define   BDG_TGEN_ENABLE		BIT(25)
+#define   BDG_CSI_UP_REG		BIT(31)
+#define BDG_INT_CTRL			(VI_CSIBDG0 + 0x04)
+#define   BDG_CH0_VS_INT_EN		BIT(0)
+#define   BDG_DMA_ERROR_INT_EN		BIT(29)
+#define   BDG_FIFO_OVERFLOW_INT_EN	BIT(31)
+#define BDG_DMA_DPCM_MODE		(VI_CSIBDG0 + 0x08)
+#define BDG_CH_SIZE(n)			(VI_CSIBDG0 + 0x10 + 4 * (n))
+#define BDG_CH0_CROP_EN			(VI_CSIBDG0 + 0x20)
+#define BDG_PAT_GEN_CTRL		(VI_CSIBDG0 + 0x60)
+#define   BDG_PAT_EN			BIT(0)
+#define   BDG_PAT_BAYER_ID		GENMASK(13, 12)
+#define BDG_PAT_IDX_CTRL		(VI_CSIBDG0 + 0x64)
+#define   BDG_PAT_IDX			GENMASK(12, 8)
+#define BDG_PAT_COLOR_0			(VI_CSIBDG0 + 0x68)
+#define BDG_PAT_COLOR_1			(VI_CSIBDG0 + 0x6c)
+#define BDG_BACKGROUND_COLOR_0		(VI_CSIBDG0 + 0x70)
+#define BDG_BACKGROUND_COLOR_1		(VI_CSIBDG0 + 0x74)
+#define BDG_MDE_V_SIZE			(VI_CSIBDG0 + 0x80)
+#define BDG_MDE_H_SIZE			(VI_CSIBDG0 + 0x84)
+#define BDG_FDE_V_SIZE			(VI_CSIBDG0 + 0x88)
+#define BDG_FDE_H_SIZE			(VI_CSIBDG0 + 0x8c)
+#define BDG_HSYNC_CTRL			(VI_CSIBDG0 + 0x90)
+#define BDG_VSYNC_CTRL			(VI_CSIBDG0 + 0x94)
+#define BDG_TGEN_TT_SIZE		(VI_CSIBDG0 + 0x98)
+#define BDG_CH0_DEBUG_0			(VI_CSIBDG0 + 0xa0)	/* pixel count */
+#define BDG_CH0_DEBUG_1			(VI_CSIBDG0 + 0xa4)	/* line count */
+#define BDG_CH0_DEBUG_2			(VI_CSIBDG0 + 0xa8)
+#define   BDG_CH0_VS_CNT		GENMASK(15, 0)
+#define   BDG_CH0_TRIG_CNT		GENMASK(31, 16)
+#define BDG_CH0_DEBUG_3			(VI_CSIBDG0 + 0xac)	/* idle flags */
+#define BDG_INT_STATUS_0		(VI_CSIBDG0 + 0xe0)
+#define   BDG_CH0_FRAME_DROP_INT	BIT(0)
+#define   BDG_CH0_VS_INT		BIT(1)
+#define   BDG_CH0_TRIG_INT		BIT(2)
+#define   BDG_CH0_WIDTH_GT_INT		BIT(4)
+#define   BDG_CH0_WIDTH_LS_INT		BIT(5)
+#define   BDG_CH0_HEIGHT_GT_INT		BIT(6)
+#define   BDG_CH0_HEIGHT_LS_INT		BIT(7)
+#define   BDG_CH0_SIZE_ERR		(BDG_CH0_WIDTH_GT_INT | BDG_CH0_WIDTH_LS_INT | \
+					 BDG_CH0_HEIGHT_GT_INT | BDG_CH0_HEIGHT_LS_INT)
+#define BDG_INT_STATUS_1		(VI_CSIBDG0 + 0xe4)
+#define   BDG_FIFO_OVERFLOW_INT		BIT(0)
+#define   BDG_RES_OVER_MAX_INT		BIT(1)
+#define   BDG_DMA_ERROR_INT		BIT(4)
+#define BDG_WDMA_CH0_CROP_EN		(VI_CSIBDG0 + 0x110)
+
+/* Raw write DMA 6, fed by CSIBDG0 channel 0 */
+#define DMA_SYS_CONTROL			(VI_DMA_CTL6 + 0x00)
+#define   DMA_BASEH			GENMASK(15, 8)
+#define   DMA_BASE_SEL			BIT(16)
+#define   DMA_STRIDE_SEL		BIT(17)
+#define   DMA_SEGLEN_SEL		BIT(18)
+#define   DMA_SEGNUM_SEL		BIT(19)
+#define DMA_BASE_ADDR			(VI_DMA_CTL6 + 0x04)
+#define DMA_SEGLEN			(VI_DMA_CTL6 + 0x08)
+#define DMA_STRIDE			(VI_DMA_CTL6 + 0x0c)
+#define DMA_SEGNUM			(VI_DMA_CTL6 + 0x10)
+
+/* Most sizes are a start/end or width/height pair of 13-bit fields */
+#define PAIR13(lo, hi)			(FIELD_PREP(GENMASK(12, 0), lo) | \
+					 FIELD_PREP(GENMASK(28, 16), hi))
+#define PAIR12(lo, hi)			(FIELD_PREP(GENMASK(11, 0), lo) | \
+					 FIELD_PREP(GENMASK(27, 16), hi))
+
+#define CV1800_VI_MIN_SIZE		32
+#define CV1800_VI_MAX_SIZE		8064
+#define CV1800_VI_DEF_WIDTH		1920
+#define CV1800_VI_DEF_HEIGHT		1080
+
+/* Pattern generator active window offset inside its frame */
+#define PATGEN_OFFSET			0x10
+#define PATGEN_FPS			30
+
+/* CSI MAC 0 clock: vip_sys_2 * (ratio + 1) / 32 */
+#define CV1800_VI_MAC_RATIO		15
+
+enum {
+	CV1800_VI_PAD_SINK,
+	CV1800_VI_PAD_SOURCE,
+	CV1800_VI_NUM_PADS
+};
+
+enum cv1800_vi_bayer {
+	CV1800_VI_BAYER_BG,
+	CV1800_VI_BAYER_GB,
+	CV1800_VI_BAYER_GR,
+	CV1800_VI_BAYER_RG,
+};
+
+struct cv1800_vi_format {
+	u32 fourcc;
+	u32 code;			/* source pad, always 12 bit */
+	u32 sink_codes[3];		/* 8, 10 and 12 bit with the same order */
+	enum cv1800_vi_bayer bayer;
+};
+
+static const struct cv1800_vi_format cv1800_vi_formats[] = {
+	{
+		.fourcc = V4L2_PIX_FMT_SBGGR12P,
+		.code = MEDIA_BUS_FMT_SBGGR12_1X12,
+		.sink_codes = { MEDIA_BUS_FMT_SBGGR8_1X8, MEDIA_BUS_FMT_SBGGR10_1X10,
+				MEDIA_BUS_FMT_SBGGR12_1X12 },
+		.bayer = CV1800_VI_BAYER_BG,
+	}, {
+		.fourcc = V4L2_PIX_FMT_SGBRG12P,
+		.code = MEDIA_BUS_FMT_SGBRG12_1X12,
+		.sink_codes = { MEDIA_BUS_FMT_SGBRG8_1X8, MEDIA_BUS_FMT_SGBRG10_1X10,
+				MEDIA_BUS_FMT_SGBRG12_1X12 },
+		.bayer = CV1800_VI_BAYER_GB,
+	}, {
+		.fourcc = V4L2_PIX_FMT_SGRBG12P,
+		.code = MEDIA_BUS_FMT_SGRBG12_1X12,
+		.sink_codes = { MEDIA_BUS_FMT_SGRBG8_1X8, MEDIA_BUS_FMT_SGRBG10_1X10,
+				MEDIA_BUS_FMT_SGRBG12_1X12 },
+		.bayer = CV1800_VI_BAYER_GR,
+	}, {
+		.fourcc = V4L2_PIX_FMT_SRGGB12P,
+		.code = MEDIA_BUS_FMT_SRGGB12_1X12,
+		.sink_codes = { MEDIA_BUS_FMT_SRGGB8_1X8, MEDIA_BUS_FMT_SRGGB10_1X10,
+				MEDIA_BUS_FMT_SRGGB12_1X12 },
+		.bayer = CV1800_VI_BAYER_RG,
+	},
+};
+
+/* V4L2_CID_TEST_PATTERN menu and the generator pattern index for each */
+static const char * const cv1800_vi_test_patterns[] = {
+	"Disabled",
+	"Color Bars",
+	"Horizontal Ramp",
+	"Vertical Ramp",
+	"Solid White",
+};
+
+static const u8 cv1800_vi_pattern_index[] = { 0, 7, 8, 16, 0 };
+
+struct cv1800_vi_buffer {
+	struct vb2_v4l2_buffer vb;
+	struct list_head list;
+};
+
+struct cv1800_vi {
+	struct device *dev;
+	void __iomem *base;
+	struct regmap *vip_sys;
+	struct clk_bulk_data *clks;
+	int num_clks;
+	struct clk *mac_src;		/* vip_sys_2, the CSI MAC clock source */
+	struct reset_control *rst;
+	int irq;
+
+	struct media_device mdev;
+	struct v4l2_device v4l2_dev;
+	struct v4l2_async_notifier notifier;
+	struct v4l2_subdev *source;
+	u32 source_pad;
+
+	struct v4l2_subdev sd;
+	struct media_pad pads[CV1800_VI_NUM_PADS];
+	struct v4l2_ctrl_handler ctrls;
+	struct v4l2_ctrl *test_pattern;
+
+	struct video_device vdev;
+	struct media_pad vdev_pad;
+	struct vb2_queue queue;
+	struct mutex lock;		/* video node and queue */
+	struct v4l2_pix_format pix;
+	const struct cv1800_vi_format *fmt;
+
+	spinlock_t qlock;		/* buffer list and DMA arming */
+	struct list_head buffers;
+	struct cv1800_vi_buffer *active;
+	bool running;
+	unsigned int pattern;		/* test pattern latched at stream start */
+	u16 last_vs;
+	u32 frames;
+	u64 sof_ts;
+	unsigned int errors;
+	unsigned int skip;		/* frames to let pass before arming */
+	struct work_struct recover;	/* resets the bridge after a bad frame */
+	unsigned int recoveries;
+
+	/* Every status bit seen since stream start, for debugfs */
+	u32 ev0_seen, ev2_seen, s0_seen, s1_seen;
+	unsigned int irq_log;		/* interrupts left to log */
+	struct dentry *debugfs;
+};
+
+static unsigned int irq_log;
+module_param(irq_log, uint, 0644);
+MODULE_PARM_DESC(irq_log, "log this many interrupts after each stream start");
+static unsigned int skip_frames = 1;
+module_param(skip_frames, uint, 0644);
+MODULE_PARM_DESC(skip_frames, "sensor frames to let pass before arming the front end");
+
+static inline struct cv1800_vi *sd_to_vi(struct v4l2_subdev *sd)
+{
+	return container_of(sd, struct cv1800_vi, sd);
+}
+
+static inline struct cv1800_vi_buffer *to_vi_buffer(struct vb2_v4l2_buffer *vb)
+{
+	return container_of(vb, struct cv1800_vi_buffer, vb);
+}
+
+static u32 vi_read(struct cv1800_vi *vi, u32 reg)
+{
+	return readl(vi->base + reg);
+}
+
+static void vi_write(struct cv1800_vi *vi, u32 reg, u32 val)
+{
+	writel(val, vi->base + reg);
+}
+
+static void vi_update(struct cv1800_vi *vi, u32 reg, u32 mask, u32 val)
+{
+	vi_write(vi, reg, (vi_read(vi, reg) & ~mask) | (val & mask));
+}
+
+static u32 cv1800_vi_stride(u32 width)
+{
+	return ALIGN(3 * DIV_ROUND_UP(width, 2), 16);
+}
+
+static const struct cv1800_vi_format *cv1800_vi_find_fourcc(u32 fourcc)
+{
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(cv1800_vi_formats); i++)
+		if (cv1800_vi_formats[i].fourcc == fourcc)
+			return &cv1800_vi_formats[i];
+	return NULL;
+}
+
+static const struct cv1800_vi_format *cv1800_vi_find_code(u32 code)
+{
+	unsigned int i, j;
+
+	for (i = 0; i < ARRAY_SIZE(cv1800_vi_formats); i++) {
+		if (cv1800_vi_formats[i].code == code)
+			return &cv1800_vi_formats[i];
+		for (j = 0; j < ARRAY_SIZE(cv1800_vi_formats[i].sink_codes); j++)
+			if (cv1800_vi_formats[i].sink_codes[j] == code)
+				return &cv1800_vi_formats[i];
+	}
+	return NULL;
+}
+
+/* -----------------------------------------------------------------------------
+ * Hardware
+ */
+
+static void cv1800_vi_quiesce_irqs(struct cv1800_vi *vi)
+{
+	vi_write(vi, TOP_INT_EVENT0_EN, 0);
+	vi_write(vi, TOP_INT_EVENT1_EN, 0);
+	vi_write(vi, TOP_INT_EVENT2_EN, 0);
+	vi_write(vi, TOP_INT_EVENT0, ~0U);
+	vi_write(vi, TOP_INT_EVENT1, ~0U);
+	vi_write(vi, TOP_INT_EVENT2, ~0U);
+	vi_write(vi, BDG_INT_STATUS_0, ~0U);
+	vi_write(vi, BDG_INT_STATUS_1, ~0U);
+}
+
+static void cv1800_vi_hw_reset(struct cv1800_vi *vi)
+{
+	u32 rst = VIP_RST_ISP_TOP | VIP_RST_ISP_TOP_APB;
+
+	regmap_set_bits(vi->vip_sys, VIP_SYS_RESERVE, VIP_AXI_ISP_TOP_CLK_EN);
+	/* Raw traffic on the offline AXI port, as the vendor stack sets it */
+	regmap_update_bits(vi->vip_sys, VIP_SYS_AXI_SW,
+			   VIP_AXI_SW_SC_TOP | VIP_AXI_SW_ISP_RAW | VIP_AXI_SW_ISP_YUV,
+			   VIP_AXI_SW_SC_TOP | VIP_AXI_SW_ISP_RAW);
+
+	regmap_set_bits(vi->vip_sys, VIP_SYS_RESETS, rst);
+	udelay(20);
+	regmap_clear_bits(vi->vip_sys, VIP_SYS_RESETS, rst);
+
+	/* ISP top soft reset, AXI first */
+	vi_write(vi, TOP_INT_EVENT0_EN, 0);
+	vi_write(vi, TOP_INT_EVENT1_EN, 0);
+	vi_write(vi, TOP_INT_EVENT2_EN, 0);
+	vi_write(vi, TOP_SW_RST, SW_RST_AXI);
+	vi_write(vi, TOP_SW_RST, SW_RST_ALL);
+	vi_write(vi, TOP_SW_RST, SW_RST_AXI);
+	vi_write(vi, TOP_SW_RST, 0);
+	cv1800_vi_quiesce_irqs(vi);
+}
+
+static void cv1800_vi_mac_clock(struct cv1800_vi *vi)
+{
+	/*
+	 * The bridge runs on the CSI MAC 0 clock, which the CSI-2 receiver
+	 * owns while a sensor streams. The pattern generator needs it
+	 * running without one.
+	 */
+	regmap_update_bits(vi->vip_sys, VIP_SYS_CLK_CTRL1, VIP_CLK_MAC0_SRC,
+			   FIELD_PREP(VIP_CLK_MAC0_SRC, VIP_CLK_SRC_VIP_SYS_2));
+	regmap_update_bits(vi->vip_sys, VIP_SYS_DIV_CSI_MAC0,
+			   VIP_DIV_RATIO | VIP_DIV_EN,
+			   FIELD_PREP(VIP_DIV_RATIO, CV1800_VI_MAC_RATIO) | VIP_DIV_EN);
+	regmap_write_bits(vi->vip_sys, VIP_SYS_DIV_CSI_MAC0, VIP_DIV_UPDATE,
+			  VIP_DIV_UPDATE);
+	udelay(5);
+}
+
+static void cv1800_vi_setup_patgen(struct cv1800_vi *vi, u32 w, u32 h,
+				   enum cv1800_vi_bayer bayer, unsigned int pattern)
+{
+	unsigned long mac_rate;
+	u32 htt, vtt;
+
+	vi_write(vi, BDG_PAT_GEN_CTRL, BDG_PAT_EN |
+		 FIELD_PREP(BDG_PAT_BAYER_ID, bayer));
+	vi_write(vi, BDG_PAT_IDX_CTRL,
+		 FIELD_PREP(BDG_PAT_IDX, cv1800_vi_pattern_index[pattern]));
+	vi_write(vi, BDG_PAT_COLOR_0, PAIR12(0xfff, 0xfff));
+	vi_write(vi, BDG_PAT_COLOR_1, 0xfff);
+	vi_write(vi, BDG_BACKGROUND_COLOR_0, PAIR12(0, 0));
+	vi_write(vi, BDG_BACKGROUND_COLOR_1, 0);
+
+	/* Size the generated frame for about PATGEN_FPS on the MAC clock */
+	mac_rate = clk_get_rate(vi->mac_src) / 32 * (CV1800_VI_MAC_RATIO + 1);
+	htt = w + 2 * PATGEN_OFFSET + 64;
+	vtt = mac_rate ? mac_rate / PATGEN_FPS / htt : 0;
+	vtt = clamp(vtt, h + 2 * PATGEN_OFFSET + 16, 8191U);
+
+	vi_write(vi, BDG_MDE_V_SIZE, PAIR13(0, h - 1));
+	vi_write(vi, BDG_MDE_H_SIZE, PAIR13(0, w - 1));
+	vi_write(vi, BDG_FDE_V_SIZE, PAIR13(PATGEN_OFFSET, PATGEN_OFFSET + h - 1));
+	vi_write(vi, BDG_FDE_H_SIZE, PAIR13(PATGEN_OFFSET, PATGEN_OFFSET + w - 1));
+	vi_write(vi, BDG_HSYNC_CTRL, PAIR13(4, 5));
+	vi_write(vi, BDG_VSYNC_CTRL, PAIR13(4, 5));
+	vi_write(vi, BDG_TGEN_TT_SIZE, PAIR13(htt - 1, vtt - 1));
+}
+
+static void cv1800_vi_hw_setup(struct cv1800_vi *vi, unsigned int pattern)
+{
+	u32 w = vi->pix.width, h = vi->pix.height;
+	u32 ctrl, sys;
+	int ch;
+
+	cv1800_vi_hw_reset(vi);
+	if (pattern)
+		cv1800_vi_mac_clock(vi);
+
+	ctrl = vi_read(vi, BDG_TOP_CTRL);
+	ctrl &= ~(BDG_CSI_MODE | BDG_CSI_IN_FORMAT | BDG_CH_NUM | BDG_PXL_DATA_SEL |
+		  BDG_RESET_MODE | BDG_VS_MODE | BDG_ABORT_MODE | BDG_ABORT |
+		  BDG_CSI_ENABLE | BDG_TGEN_ENABLE | BDG_CSI_UP_REG);
+	ctrl |= BDG_CH0_DMA_WR_ENABLE;
+	if (pattern) {
+		ctrl |= FIELD_PREP(BDG_CSI_MODE, BDG_CSI_MODE_PATGEN) | BDG_PXL_DATA_SEL;
+		cv1800_vi_setup_patgen(vi, w, h, vi->fmt->bayer, pattern);
+	} else {
+		ctrl |= FIELD_PREP(BDG_CSI_MODE, BDG_CSI_MODE_SENSOR);
+		vi_write(vi, BDG_PAT_GEN_CTRL, 0);
+	}
+	vi_write(vi, BDG_TOP_CTRL, ctrl);
+
+	for (ch = 0; ch < 4; ch++)
+		vi_write(vi, BDG_CH_SIZE(ch), PAIR13(w - 1, h - 1));
+	vi_write(vi, BDG_DMA_DPCM_MODE, 0);
+	vi_write(vi, BDG_CH0_CROP_EN, 0);
+	vi_write(vi, BDG_WDMA_CH0_CROP_EN, 0);
+	vi_write(vi, BDG_INT_CTRL, BDG_CH0_VS_INT_EN | BDG_DMA_ERROR_INT_EN |
+		 BDG_FIFO_OVERFLOW_INT_EN);
+
+	vi_update(vi, FE_CTRL, FE_BAYER_TYPE_LE | FE_BAYER_TYPE_SE,
+		  FIELD_PREP(FE_BAYER_TYPE_LE, vi->fmt->bayer) |
+		  FIELD_PREP(FE_BAYER_TYPE_SE, vi->fmt->bayer));
+	vi_write(vi, FE_FRAME_SIZE, PAIR13(w - 1, h - 1));
+
+	/* Front end 0 triggered and shadow-updated by its own frame timing */
+	vi_write(vi, TOP_CTRL_MODE_SEL0, FIELD_PREP(SEL0_TRIG_STR_SEL_FE0, 1) |
+		 FIELD_PREP(SEL0_SHAW_UP_SEL_FE0, 1));
+	vi_write(vi, TOP_CTRL_MODE_SEL1, FIELD_PREP(SEL1_PQ_UP_SEL_FE0, 1));
+	/* No pre-raw to back end link: the front end only feeds the DMA */
+	vi_update(vi, TOP_SCENARIOS_CTRL, SCN_ROUTING | SCN_FE_DMA_SHARE_ENABLE,
+		  SCN_FE_DMA_SHARE_ENABLE);
+
+	vi_write(vi, DMA_SEGLEN, cv1800_vi_stride(w));
+	vi_write(vi, DMA_STRIDE, vi->pix.bytesperline);
+	vi_write(vi, DMA_SEGNUM, h);
+	sys = vi_read(vi, DMA_SYS_CONTROL);
+	sys |= DMA_BASE_SEL | DMA_STRIDE_SEL | DMA_SEGLEN_SEL | DMA_SEGNUM_SEL;
+	vi_write(vi, DMA_SYS_CONTROL, sys);
+
+	cv1800_vi_quiesce_irqs(vi);
+	vi_write(vi, TOP_INT_EVENT0_EN, EV0_FRAME_DONE_FE0_CH0);
+	vi_write(vi, TOP_INT_EVENT2_EN, EV2_FRAME_START_FE0_CH0 | EV2_FRAME_ERR |
+		 EV2_INT_DMA_ERR);
+}
+
+/* Called with qlock held */
+static void cv1800_vi_arm(struct cv1800_vi *vi)
+{
+	vi_update(vi, FE_FRAME_VLD, FE_PQ_VLD_CH0, FE_PQ_VLD_CH0);
+	vi_update(vi, FE_FRAME_VLD, FE_FRAME_VLD_CH0, FE_FRAME_VLD_CH0);
+}
+
+/* Call with qlock held. While frames are skipped, the VS interrupt arms. */
+static void cv1800_vi_arm_next(struct cv1800_vi *vi)
+{
+	struct cv1800_vi_buffer *buf;
+	dma_addr_t addr;
+
+	buf = list_first_entry_or_null(&vi->buffers, struct cv1800_vi_buffer, list);
+	if (!buf)
+		return;
+	list_del(&buf->list);
+	vi->active = buf;
+
+	addr = vb2_dma_contig_plane_dma_addr(&buf->vb.vb2_buf, 0);
+	vi_write(vi, DMA_BASE_ADDR, lower_32_bits(addr));
+	vi_update(vi, DMA_SYS_CONTROL, DMA_BASEH,
+		  FIELD_PREP(DMA_BASEH, upper_32_bits(addr)));
+	if (!vi->skip)
+		cv1800_vi_arm(vi);
+}
+
+static void cv1800_vi_hw_enable(struct cv1800_vi *vi, bool pattern)
+{
+	u32 en = BDG_CSI_UP_REG | BDG_CSI_ENABLE;
+
+	if (pattern)
+		en |= BDG_TGEN_ENABLE;
+
+	vi_write(vi, TOP_SW_CTRL_1, FIELD_PREP(SW1_PQ_UP_FE0, 1));
+	vi_write(vi, TOP_SW_CTRL_0, FIELD_PREP(SW0_SHAW_UP_FE0, 1));
+	vi->last_vs = FIELD_GET(BDG_CH0_VS_CNT, vi_read(vi, BDG_CH0_DEBUG_2));
+	vi_update(vi, BDG_TOP_CTRL, en, en);
+}
+
+static void cv1800_vi_hw_start(struct cv1800_vi *vi, bool pattern)
+{
+	vi->frames = 0;
+	vi->recoveries = 0;
+	vi->ev0_seen = vi->ev2_seen = vi->s0_seen = vi->s1_seen = 0;
+	vi->irq_log = irq_log;
+	cv1800_vi_hw_enable(vi, pattern);
+}
+
+static void cv1800_vi_hw_stop(struct cv1800_vi *vi)
+{
+	u32 idle;
+
+	/*
+	 * Disarm the front end while the source still runs: after a frame
+	 * cut short, the front end never goes idle.
+	 */
+	vi_update(vi, FE_FRAME_VLD, FE_FRAME_VLD_CH0 | FE_PQ_VLD_CH0, 0);
+	if (readl_poll_timeout(vi->base + TOP_BLK_IDLE, idle,
+			       (idle & BLK_IDLE_RAW) == BLK_IDLE_RAW, 10, 200000))
+		dev_warn(vi->dev, "front end did not go idle\n");
+	vi_update(vi, BDG_TOP_CTRL, BDG_CSI_ENABLE | BDG_TGEN_ENABLE, 0);
+
+	vi_write(vi, TOP_INT_EVENT0_EN, 0);
+	vi_write(vi, TOP_INT_EVENT1_EN, 0);
+	vi_write(vi, TOP_INT_EVENT2_EN, 0);
+}
+
+static irqreturn_t cv1800_vi_irq(int irq, void *data)
+{
+	struct cv1800_vi *vi = data;
+	struct cv1800_vi_buffer *buf;
+	u32 ev0, ev1, ev2, s0, s1;
+	u64 sof = 0;
+	u16 vs;
+
+	ev0 = vi_read(vi, TOP_INT_EVENT0);
+	ev1 = vi_read(vi, TOP_INT_EVENT1);
+	ev2 = vi_read(vi, TOP_INT_EVENT2);
+	s0 = vi_read(vi, BDG_INT_STATUS_0);
+	s1 = vi_read(vi, BDG_INT_STATUS_1);
+	if (!(ev0 | ev1 | ev2 | s0 | s1))
+		return IRQ_NONE;
+
+	vi_write(vi, TOP_INT_EVENT0, ev0);
+	vi_write(vi, TOP_INT_EVENT1, ev1);
+	vi_write(vi, TOP_INT_EVENT2, ev2);
+	vi_write(vi, BDG_INT_STATUS_0, s0);
+	vi_write(vi, BDG_INT_STATUS_1, s1);
+	vi->ev0_seen |= ev0;
+	vi->ev2_seen |= ev2;
+	vi->s0_seen |= s0;
+	vi->s1_seen |= s1;
+	if (vi->irq_log) {
+		vi->irq_log--;
+		dev_info(vi->dev, "irq ev0 %08x ev2 %08x bdg %08x %08x px %u lines %u vs/trig %08x\n",
+			 ev0, ev2, s0, s1, vi_read(vi, BDG_CH0_DEBUG_0),
+			 vi_read(vi, BDG_CH0_DEBUG_1), vi_read(vi, BDG_CH0_DEBUG_2));
+	}
+
+	/*
+	 * After a frame of the wrong size the bridge can drop every frame
+	 * that follows. Disarm the front end and reset the block from
+	 * process context; the sensor keeps streaming meanwhile.
+	 */
+	if ((s0 & BDG_CH0_SIZE_ERR) && vi->running && !vi->skip) {
+		vi_update(vi, FE_FRAME_VLD, FE_FRAME_VLD_CH0 | FE_PQ_VLD_CH0, 0);
+		schedule_work(&vi->recover);
+		return IRQ_HANDLED;
+	}
+
+	/* A frame start handled together with a frame done belongs to the next frame */
+	if (ev2 & EV2_FRAME_START_FE0_CH0)
+		sof = ktime_get_ns();
+
+	if ((ev2 & (EV2_FRAME_ERR | EV2_INT_DMA_ERR)) ||
+	    (s1 & (BDG_FIFO_OVERFLOW_INT | BDG_RES_OVER_MAX_INT | BDG_DMA_ERROR_INT))) {
+		vi->errors++;
+		dev_err_ratelimited(vi->dev, "error: event2 %08x bridge %08x %08x\n",
+				    ev2, s0, s1);
+	}
+
+	/*
+	 * The first frame after the sensor starts is usually short. The
+	 * bridge drops it, but a front end armed for it never finishes and
+	 * capture stalls, so only arm once that frame has gone by.
+	 */
+	if ((s0 & BDG_CH0_VS_INT) && vi->skip) {
+		spin_lock(&vi->qlock);
+		if (!--vi->skip && vi->running) {
+			if (vi->active)
+				cv1800_vi_arm(vi);
+			else
+				cv1800_vi_arm_next(vi);
+		}
+		spin_unlock(&vi->qlock);
+	}
+
+	if (!(ev0 & EV0_FRAME_DONE_FE0_CH0))
+		goto out;
+
+	spin_lock(&vi->qlock);
+	buf = vi->active;
+	vi->active = NULL;
+	if (buf) {
+		/* The bridge counts every input frame, armed or not */
+		vs = FIELD_GET(BDG_CH0_VS_CNT, vi_read(vi, BDG_CH0_DEBUG_2));
+		vi->frames += (u16)(vs - vi->last_vs);
+		vi->last_vs = vs;
+		buf->vb.vb2_buf.timestamp = vi->sof_ts;
+		buf->vb.sequence = vi->frames - 1;
+		buf->vb.field = V4L2_FIELD_NONE;
+		vb2_buffer_done(&buf->vb.vb2_buf, vi->errors ?
+				VB2_BUF_STATE_ERROR : VB2_BUF_STATE_DONE);
+		vi->errors = 0;
+	}
+	if (vi->running)
+		cv1800_vi_arm_next(vi);
+	spin_unlock(&vi->qlock);
+
+out:
+	if (sof)
+		vi->sof_ts = sof;
+
+	return IRQ_HANDLED;
+}
+
+/* -----------------------------------------------------------------------------
+ * Bridge subdevice
+ */
+
+static void cv1800_vi_source_fmt(const struct v4l2_mbus_framefmt *sink,
+				 struct v4l2_mbus_framefmt *src)
+{
+	const struct cv1800_vi_format *f = cv1800_vi_find_code(sink->code);
+
+	*src = *sink;
+	src->code = f->code;
+}
+
+static int cv1800_vi_sd_init_state(struct v4l2_subdev *sd,
+				   struct v4l2_subdev_state *state)
+{
+	struct v4l2_mbus_framefmt *sink, *src;
+
+	sink = v4l2_subdev_state_get_format(state, CV1800_VI_PAD_SINK);
+	src = v4l2_subdev_state_get_format(state, CV1800_VI_PAD_SOURCE);
+
+	*sink = (struct v4l2_mbus_framefmt) {
+		.width = CV1800_VI_DEF_WIDTH,
+		.height = CV1800_VI_DEF_HEIGHT,
+		.code = MEDIA_BUS_FMT_SBGGR10_1X10,
+		.field = V4L2_FIELD_NONE,
+		.colorspace = V4L2_COLORSPACE_RAW,
+		.ycbcr_enc = V4L2_YCBCR_ENC_601,
+		.quantization = V4L2_QUANTIZATION_FULL_RANGE,
+		.xfer_func = V4L2_XFER_FUNC_NONE,
+	};
+	cv1800_vi_source_fmt(sink, src);
+
+	return 0;
+}
+
+static int cv1800_vi_sd_enum_mbus_code(struct v4l2_subdev *sd,
+				       struct v4l2_subdev_state *state,
+				       struct v4l2_subdev_mbus_code_enum *code)
+{
+	const struct cv1800_vi_format *f;
+	struct v4l2_mbus_framefmt *sink;
+	unsigned int n = ARRAY_SIZE(cv1800_vi_formats[0].sink_codes);
+
+	if (code->pad == CV1800_VI_PAD_SOURCE) {
+		if (code->index)
+			return -EINVAL;
+		sink = v4l2_subdev_state_get_format(state, CV1800_VI_PAD_SINK);
+		code->code = cv1800_vi_find_code(sink->code)->code;
+		return 0;
+	}
+
+	if (code->index >= ARRAY_SIZE(cv1800_vi_formats) * n)
+		return -EINVAL;
+	f = &cv1800_vi_formats[code->index / n];
+	code->code = f->sink_codes[code->index % n];
+
+	return 0;
+}
+
+static int cv1800_vi_sd_enum_frame_size(struct v4l2_subdev *sd,
+					struct v4l2_subdev_state *state,
+					struct v4l2_subdev_frame_size_enum *fse)
+{
+	if (fse->index || !cv1800_vi_find_code(fse->code))
+		return -EINVAL;
+
+	fse->min_width = CV1800_VI_MIN_SIZE;
+	fse->max_width = CV1800_VI_MAX_SIZE;
+	fse->min_height = CV1800_VI_MIN_SIZE;
+	fse->max_height = CV1800_VI_MAX_SIZE;
+
+	return 0;
+}
+
+static int cv1800_vi_sd_set_fmt(struct v4l2_subdev *sd,
+				struct v4l2_subdev_state *state,
+				struct v4l2_subdev_format *format)
+{
+	struct cv1800_vi *vi = sd_to_vi(sd);
+	struct v4l2_mbus_framefmt *sink, *src;
+
+	if (format->which == V4L2_SUBDEV_FORMAT_ACTIVE && vb2_is_busy(&vi->queue))
+		return -EBUSY;
+
+	/* The source follows the sink */
+	if (format->pad == CV1800_VI_PAD_SOURCE)
+		return v4l2_subdev_get_fmt(sd, state, format);
+
+	if (!cv1800_vi_find_code(format->format.code))
+		format->format.code = MEDIA_BUS_FMT_SBGGR10_1X10;
+	format->format.width = clamp_t(u32, ALIGN(format->format.width, 2),
+				       CV1800_VI_MIN_SIZE, CV1800_VI_MAX_SIZE);
+	format->format.height = clamp_t(u32, ALIGN(format->format.height, 2),
+					CV1800_VI_MIN_SIZE, CV1800_VI_MAX_SIZE);
+	format->format.field = V4L2_FIELD_NONE;
+	format->format.colorspace = V4L2_COLORSPACE_RAW;
+	format->format.ycbcr_enc = V4L2_YCBCR_ENC_601;
+	format->format.quantization = V4L2_QUANTIZATION_FULL_RANGE;
+	format->format.xfer_func = V4L2_XFER_FUNC_NONE;
+
+	sink = v4l2_subdev_state_get_format(state, CV1800_VI_PAD_SINK);
+	src = v4l2_subdev_state_get_format(state, CV1800_VI_PAD_SOURCE);
+	*sink = format->format;
+	cv1800_vi_source_fmt(sink, src);
+
+	return 0;
+}
+
+static int cv1800_vi_sd_enable_streams(struct v4l2_subdev *sd,
+				       struct v4l2_subdev_state *state,
+				       u32 pad, u64 streams_mask)
+{
+	struct cv1800_vi *vi = sd_to_vi(sd);
+	int ret;
+
+	cv1800_vi_hw_start(vi, vi->pattern);
+	if (vi->pattern || !vi->source)
+		return 0;
+
+	ret = v4l2_subdev_enable_streams(vi->source, vi->source_pad, BIT_ULL(0));
+	if (ret)
+		cv1800_vi_hw_stop(vi);
+
+	return ret;
+}
+
+static int cv1800_vi_sd_disable_streams(struct v4l2_subdev *sd,
+					struct v4l2_subdev_state *state,
+					u32 pad, u64 streams_mask)
+{
+	struct cv1800_vi *vi = sd_to_vi(sd);
+
+	cv1800_vi_hw_stop(vi);
+	if (!vi->pattern && vi->source)
+		v4l2_subdev_disable_streams(vi->source, vi->source_pad, BIT_ULL(0));
+
+	return 0;
+}
+
+static const struct v4l2_subdev_pad_ops cv1800_vi_sd_pad_ops = {
+	.enum_mbus_code = cv1800_vi_sd_enum_mbus_code,
+	.enum_frame_size = cv1800_vi_sd_enum_frame_size,
+	.get_fmt = v4l2_subdev_get_fmt,
+	.set_fmt = cv1800_vi_sd_set_fmt,
+	.link_validate = v4l2_subdev_link_validate_default,
+	.enable_streams = cv1800_vi_sd_enable_streams,
+	.disable_streams = cv1800_vi_sd_disable_streams,
+};
+
+static const struct v4l2_subdev_video_ops cv1800_vi_sd_video_ops = {
+	.s_stream = v4l2_subdev_s_stream_helper,
+};
+
+static const struct v4l2_subdev_core_ops cv1800_vi_sd_core_ops = {
+	.subscribe_event = v4l2_ctrl_subdev_subscribe_event,
+	.unsubscribe_event = v4l2_event_subdev_unsubscribe,
+};
+
+static const struct v4l2_subdev_ops cv1800_vi_sd_ops = {
+	.core = &cv1800_vi_sd_core_ops,
+	.video = &cv1800_vi_sd_video_ops,
+	.pad = &cv1800_vi_sd_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops cv1800_vi_sd_internal_ops = {
+	.init_state = cv1800_vi_sd_init_state,
+};
+
+static int cv1800_vi_sd_link_validate(struct media_link *link)
+{
+	struct v4l2_subdev *sd = media_entity_to_v4l2_subdev(link->sink->entity);
+	struct cv1800_vi *vi = sd_to_vi(sd);
+
+	/* The generator replaces the input; what is upstream does not matter */
+	if (vi->pattern)
+		return 0;
+
+	return v4l2_subdev_link_validate(link);
+}
+
+static const struct media_entity_operations cv1800_vi_sd_entity_ops = {
+	.link_validate = cv1800_vi_sd_link_validate,
+};
+
+/* -----------------------------------------------------------------------------
+ * Video node
+ */
+
+static void cv1800_vi_try_pix(struct v4l2_pix_format *pix,
+			      const struct cv1800_vi_format **fmt)
+{
+	const struct cv1800_vi_format *f = cv1800_vi_find_fourcc(pix->pixelformat);
+	u32 min_bpl, max_bpl;
+
+	if (!f)
+		f = &cv1800_vi_formats[0];
+
+	pix->pixelformat = f->fourcc;
+	pix->width = clamp_t(u32, ALIGN(pix->width, 2), CV1800_VI_MIN_SIZE,
+			     CV1800_VI_MAX_SIZE);
+	pix->height = clamp_t(u32, ALIGN(pix->height, 2), CV1800_VI_MIN_SIZE,
+			      CV1800_VI_MAX_SIZE);
+	min_bpl = cv1800_vi_stride(pix->width);
+	max_bpl = cv1800_vi_stride(CV1800_VI_MAX_SIZE);
+	pix->bytesperline = clamp_t(u32, ALIGN(pix->bytesperline, 16), min_bpl,
+				    max_bpl);
+	pix->sizeimage = pix->bytesperline * pix->height;
+	pix->field = V4L2_FIELD_NONE;
+	pix->colorspace = V4L2_COLORSPACE_RAW;
+	pix->ycbcr_enc = V4L2_YCBCR_ENC_601;
+	pix->quantization = V4L2_QUANTIZATION_FULL_RANGE;
+	pix->xfer_func = V4L2_XFER_FUNC_NONE;
+
+	if (fmt)
+		*fmt = f;
+}
+
+static int cv1800_vi_querycap(struct file *file, void *priv,
+			      struct v4l2_capability *cap)
+{
+	strscpy(cap->driver, CV1800_VI_NAME, sizeof(cap->driver));
+	strscpy(cap->card, "Sophgo CV1800 video input", sizeof(cap->card));
+
+	return 0;
+}
+
+static int cv1800_vi_enum_fmt(struct file *file, void *priv,
+			      struct v4l2_fmtdesc *f)
+{
+	const struct cv1800_vi_format *fmt;
+
+	if (f->mbus_code) {
+		fmt = cv1800_vi_find_code(f->mbus_code);
+		if (!fmt || f->index)
+			return -EINVAL;
+	} else {
+		if (f->index >= ARRAY_SIZE(cv1800_vi_formats))
+			return -EINVAL;
+		fmt = &cv1800_vi_formats[f->index];
+	}
+	f->pixelformat = fmt->fourcc;
+
+	return 0;
+}
+
+static int cv1800_vi_enum_framesizes(struct file *file, void *priv,
+				     struct v4l2_frmsizeenum *fsize)
+{
+	if (fsize->index || !cv1800_vi_find_fourcc(fsize->pixel_format))
+		return -EINVAL;
+
+	fsize->type = V4L2_FRMSIZE_TYPE_STEPWISE;
+	fsize->stepwise.min_width = CV1800_VI_MIN_SIZE;
+	fsize->stepwise.max_width = CV1800_VI_MAX_SIZE;
+	fsize->stepwise.step_width = 2;
+	fsize->stepwise.min_height = CV1800_VI_MIN_SIZE;
+	fsize->stepwise.max_height = CV1800_VI_MAX_SIZE;
+	fsize->stepwise.step_height = 2;
+
+	return 0;
+}
+
+static int cv1800_vi_g_fmt(struct file *file, void *priv, struct v4l2_format *f)
+{
+	struct cv1800_vi *vi = video_drvdata(file);
+
+	f->fmt.pix = vi->pix;
+
+	return 0;
+}
+
+static int cv1800_vi_try_fmt(struct file *file, void *priv, struct v4l2_format *f)
+{
+	cv1800_vi_try_pix(&f->fmt.pix, NULL);
+
+	return 0;
+}
+
+static int cv1800_vi_s_fmt(struct file *file, void *priv, struct v4l2_format *f)
+{
+	struct cv1800_vi *vi = video_drvdata(file);
+
+	if (vb2_is_busy(&vi->queue))
+		return -EBUSY;
+
+	cv1800_vi_try_pix(&f->fmt.pix, &vi->fmt);
+	vi->pix = f->fmt.pix;
+
+	return 0;
+}
