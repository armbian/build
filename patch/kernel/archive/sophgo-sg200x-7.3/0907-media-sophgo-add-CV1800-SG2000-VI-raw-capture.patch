+static int cv1800_vi_video_link_validate(struct media_link *link)
+{
+	struct video_device *vdev = media_entity_to_video_device(link->sink->entity);
+	struct cv1800_vi *vi = video_get_drvdata(vdev);
+	struct v4l2_subdev_state *state;
+	struct v4l2_mbus_framefmt *src;
+	int ret = 0;
+
+	state = v4l2_subdev_lock_and_get_active_state(&vi->sd);
+	src = v4l2_subdev_state_get_format(state, CV1800_VI_PAD_SOURCE);
+	if (src->width != vi->pix.width || src->height != vi->pix.height ||
+	    src->code != vi->fmt->code) {
+		dev_dbg(vi->dev, "format mismatch: %ux%u %04x vs %ux%u %04x\n",
+			src->width, src->height, src->code,
+			vi->pix.width, vi->pix.height, vi->fmt->code);
+		ret = -EPIPE;
+	}
+	v4l2_subdev_unlock_state(state);
+
+	return ret;
+}
+
+static const struct media_entity_operations cv1800_vi_video_entity_ops = {
+	.link_validate = cv1800_vi_video_link_validate,
+};
