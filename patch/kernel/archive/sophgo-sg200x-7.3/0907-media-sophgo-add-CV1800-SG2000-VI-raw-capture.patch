+/* -----------------------------------------------------------------------------
+ * Buffer queue
+ */
+
+static int cv1800_vi_queue_setup(struct vb2_queue *q, unsigned int *nbuffers,
+				 unsigned int *nplanes, unsigned int sizes[],
+				 struct device *alloc_devs[])
+{
+	struct cv1800_vi *vi = vb2_get_drv_priv(q);
+
+	if (*nplanes)
+		return sizes[0] < vi->pix.sizeimage ? -EINVAL : 0;
+
+	*nplanes = 1;
+	sizes[0] = vi->pix.sizeimage;
+
+	return 0;
+}
+
+static int cv1800_vi_buf_prepare(struct vb2_buffer *vb)
+{
+	struct cv1800_vi *vi = vb2_get_drv_priv(vb->vb2_queue);
+
+	if (vb2_plane_size(vb, 0) < vi->pix.sizeimage)
+		return -EINVAL;
+	vb2_set_plane_payload(vb, 0, vi->pix.sizeimage);
+
+	return 0;
+}
+
+static void cv1800_vi_buf_queue(struct vb2_buffer *vb)
+{
+	struct cv1800_vi *vi = vb2_get_drv_priv(vb->vb2_queue);
+	struct cv1800_vi_buffer *buf = to_vi_buffer(to_vb2_v4l2_buffer(vb));
+	unsigned long flags;
+
+	spin_lock_irqsave(&vi->qlock, flags);
+	list_add_tail(&buf->list, &vi->buffers);
+	if (vi->running && !vi->active)
+		cv1800_vi_arm_next(vi);
+	spin_unlock_irqrestore(&vi->qlock, flags);
+}
+
+static void cv1800_vi_return_buffers(struct cv1800_vi *vi,
+				     enum vb2_buffer_state state)
+{
+	struct cv1800_vi_buffer *buf, *tmp;
+	unsigned long flags;
+
+	spin_lock_irqsave(&vi->qlock, flags);
+	if (vi->active) {
+		list_add(&vi->active->list, &vi->buffers);
+		vi->active = NULL;
+	}
+	list_for_each_entry_safe(buf, tmp, &vi->buffers, list) {
+		list_del(&buf->list);
+		vb2_buffer_done(&buf->vb.vb2_buf, state);
+	}
+	spin_unlock_irqrestore(&vi->qlock, flags);
+}
+
+static int cv1800_vi_start_streaming(struct vb2_queue *q, unsigned int count)
+{
+	struct cv1800_vi *vi = vb2_get_drv_priv(q);
+	unsigned long flags;
+	int ret;
+
+	ret = pm_runtime_resume_and_get(vi->dev);
+	if (ret)
+		goto err_return;
+
+	vi->pattern = v4l2_ctrl_g_ctrl(vi->test_pattern);
+	if (!vi->pattern && !vi->source) {
+		dev_dbg(vi->dev, "no source connected and no test pattern\n");
+		ret = -EPIPE;
+		goto err_pm;
+	}
+
+	ret = video_device_pipeline_alloc_start(&vi->vdev);
+	if (ret)
+		goto err_pm;
+	v4l2_ctrl_grab(vi->test_pattern, true);
+
+	cv1800_vi_hw_setup(vi, vi->pattern);
+
+	spin_lock_irqsave(&vi->qlock, flags);
+	vi->errors = 0;
+	vi->running = true;
+	vi->skip = vi->pattern ? 0 : skip_frames;
+	cv1800_vi_arm_next(vi);
+	spin_unlock_irqrestore(&vi->qlock, flags);
+
+	ret = v4l2_subdev_enable_streams(&vi->sd, CV1800_VI_PAD_SOURCE, BIT_ULL(0));
+	if (ret)
+		goto err_stop;
+
+	return 0;
+
+err_stop:
+	spin_lock_irqsave(&vi->qlock, flags);
+	vi->running = false;
+	spin_unlock_irqrestore(&vi->qlock, flags);
+	cv1800_vi_hw_stop(vi);
+	v4l2_ctrl_grab(vi->test_pattern, false);
+	video_device_pipeline_stop(&vi->vdev);
+err_pm:
+	pm_runtime_put(vi->dev);
+err_return:
+	cv1800_vi_return_buffers(vi, VB2_BUF_STATE_QUEUED);
+	return ret;
+}
+
+/* What the vendor driver does on a bridge size error, minus its other pipes */
+static void cv1800_vi_recover(struct work_struct *work)
+{
+	struct cv1800_vi *vi = container_of(work, struct cv1800_vi, recover);
+	unsigned long flags;
+
+	disable_irq(vi->irq);
+	spin_lock_irqsave(&vi->qlock, flags);
+	if (!vi->running) {
+		spin_unlock_irqrestore(&vi->qlock, flags);
+		enable_irq(vi->irq);
+		return;
+	}
+	/* Keep buf_queue from arming the front end during the reset */
+	vi->skip = 1;
+	spin_unlock_irqrestore(&vi->qlock, flags);
+
+	vi_update(vi, BDG_TOP_CTRL, BDG_ABORT, BDG_ABORT);
+	usleep_range(1000, 2000);
+	cv1800_vi_hw_setup(vi, vi->pattern);
+
+	spin_lock_irqsave(&vi->qlock, flags);
+	/* Arm the interrupted buffer again; it was never completed */
+	if (vi->active) {
+		list_add(&vi->active->list, &vi->buffers);
+		vi->active = NULL;
+	}
+	vi->skip = skip_frames;
+	if (vi->running)
+		cv1800_vi_arm_next(vi);
+	vi->recoveries++;
+	spin_unlock_irqrestore(&vi->qlock, flags);
+
+	cv1800_vi_hw_enable(vi, vi->pattern);
+	enable_irq(vi->irq);
+	dev_warn_ratelimited(vi->dev, "reset the bridge after a frame of the wrong size\n");
+}
+
+static void cv1800_vi_stop_streaming(struct vb2_queue *q)
+{
+	struct cv1800_vi *vi = vb2_get_drv_priv(q);
+	unsigned long flags;
+
+	spin_lock_irqsave(&vi->qlock, flags);
+	vi->running = false;
+	spin_unlock_irqrestore(&vi->qlock, flags);
+	/* A handler that saw running set may still schedule the work */
+	synchronize_irq(vi->irq);
+	cancel_work_sync(&vi->recover);
+
+	v4l2_subdev_disable_streams(&vi->sd, CV1800_VI_PAD_SOURCE, BIT_ULL(0));
+	cv1800_vi_return_buffers(vi, VB2_BUF_STATE_ERROR);
+	v4l2_ctrl_grab(vi->test_pattern, false);
+	video_device_pipeline_stop(&vi->vdev);
+	pm_runtime_put_sync(vi->dev);
+}
+
+static const struct vb2_ops cv1800_vi_qops = {
+	.queue_setup = cv1800_vi_queue_setup,
+	.buf_prepare = cv1800_vi_buf_prepare,
+	.buf_queue = cv1800_vi_buf_queue,
+	.start_streaming = cv1800_vi_start_streaming,
+	.stop_streaming = cv1800_vi_stop_streaming,
+};
+
+/* -----------------------------------------------------------------------------
+ * Source subdevice (sensor or CSI-2 receiver)
+ */
+
+static int cv1800_vi_notify_bound(struct v4l2_async_notifier *notifier,
+				  struct v4l2_subdev *sd,
+				  struct v4l2_async_connection *asc)
+{
+	struct cv1800_vi *vi = container_of(notifier, struct cv1800_vi, notifier);
+	int pad;
+
+	pad = media_entity_get_fwnode_pad(&sd->entity, asc->match.fwnode,
+					  MEDIA_PAD_FL_SOURCE);
+	if (pad < 0)
+		return dev_err_probe(vi->dev, pad, "no source pad on %s\n", sd->name);
+
+	vi->source = sd;
+	vi->source_pad = pad;
+
+	return media_create_pad_link(&sd->entity, pad, &vi->sd.entity,
+				     CV1800_VI_PAD_SINK,
+				     MEDIA_LNK_FL_ENABLED | MEDIA_LNK_FL_IMMUTABLE);
+}
+
+static void cv1800_vi_notify_unbind(struct v4l2_async_notifier *notifier,
+				    struct v4l2_subdev *sd,
+				    struct v4l2_async_connection *asc)
+{
+	struct cv1800_vi *vi = container_of(notifier, struct cv1800_vi, notifier);
+
+	vi->source = NULL;
+}
+
+static int cv1800_vi_notify_complete(struct v4l2_async_notifier *notifier)
+{
+	struct cv1800_vi *vi = container_of(notifier, struct cv1800_vi, notifier);
+
+	return v4l2_device_register_subdev_nodes(&vi->v4l2_dev);
+}
+
+static const struct v4l2_async_notifier_operations cv1800_vi_notify_ops = {
+	.bound = cv1800_vi_notify_bound,
+	.unbind = cv1800_vi_notify_unbind,
+	.complete = cv1800_vi_notify_complete,
+};
+
+/* Returns 1 when a source is described and will bind later, 0 when none is */
+static int cv1800_vi_parse_dt(struct cv1800_vi *vi)
+{
+	struct v4l2_async_connection *asc;
+	struct fwnode_handle *ep;
+	int ret;
+
+	v4l2_async_nf_init(&vi->notifier, &vi->v4l2_dev);
+	vi->notifier.ops = &cv1800_vi_notify_ops;
+
+	ep = fwnode_graph_get_endpoint_by_id(dev_fwnode(vi->dev), 0, 0, 0);
+	if (!ep)
+		return 0;
+
+	asc = v4l2_async_nf_add_fwnode_remote(&vi->notifier, ep,
+					      struct v4l2_async_connection);
+	fwnode_handle_put(ep);
+	if (IS_ERR(asc))
+		return PTR_ERR(asc);
+
+	ret = v4l2_async_nf_register(&vi->notifier);
+	if (ret) {
+		v4l2_async_nf_cleanup(&vi->notifier);
+		return ret;
+	}
+
+	return 1;
+}
+
+/* -----------------------------------------------------------------------------
+ * Probe
+ */
+
+static int cv1800_vi_init_subdev(struct cv1800_vi *vi)
+{
+	struct v4l2_subdev *sd = &vi->sd;
+	int ret;
+
+	v4l2_subdev_init(sd, &cv1800_vi_sd_ops);
+	sd->internal_ops = &cv1800_vi_sd_internal_ops;
+	sd->owner = THIS_MODULE;
+	sd->dev = vi->dev;
+	sd->flags |= V4L2_SUBDEV_FL_HAS_DEVNODE | V4L2_SUBDEV_FL_HAS_EVENTS;
+	strscpy(sd->name, "cv1800-vi-bridge", sizeof(sd->name));
+	v4l2_set_subdevdata(sd, vi);
+
+	v4l2_ctrl_handler_init(&vi->ctrls, 1);
+	vi->test_pattern =
+		v4l2_ctrl_new_std_menu_items(&vi->ctrls, NULL, V4L2_CID_TEST_PATTERN,
+					     ARRAY_SIZE(cv1800_vi_test_patterns) - 1,
+					     0, 0, cv1800_vi_test_patterns);
+	if (vi->ctrls.error) {
+		ret = vi->ctrls.error;
+		goto err_ctrls;
+	}
+	sd->ctrl_handler = &vi->ctrls;
+
+	sd->entity.function = MEDIA_ENT_F_VID_IF_BRIDGE;
+	sd->entity.ops = &cv1800_vi_sd_entity_ops;
+	vi->pads[CV1800_VI_PAD_SINK].flags = MEDIA_PAD_FL_SINK;
+	vi->pads[CV1800_VI_PAD_SOURCE].flags = MEDIA_PAD_FL_SOURCE |
+					       MEDIA_PAD_FL_MUST_CONNECT;
+	ret = media_entity_pads_init(&sd->entity, CV1800_VI_NUM_PADS, vi->pads);
+	if (ret)
+		goto err_ctrls;
+
+	ret = v4l2_subdev_init_finalize(sd);
+	if (ret)
+		goto err_entity;
+
+	ret = v4l2_device_register_subdev(&vi->v4l2_dev, sd);
+	if (ret)
+		goto err_state;
+
+	return 0;
+
+err_state:
+	v4l2_subdev_cleanup(sd);
+err_entity:
+	media_entity_cleanup(&sd->entity);
+err_ctrls:
+	v4l2_ctrl_handler_free(&vi->ctrls);
+	return ret;
+}
+
+static void cv1800_vi_cleanup_subdev(struct cv1800_vi *vi)
+{
+	v4l2_device_unregister_subdev(&vi->sd);
+	v4l2_subdev_cleanup(&vi->sd);
+	media_entity_cleanup(&vi->sd.entity);
+	v4l2_ctrl_handler_free(&vi->ctrls);
+}
+
+static int cv1800_vi_init_video(struct cv1800_vi *vi)
+{
+	struct video_device *vdev = &vi->vdev;
+	struct vb2_queue *q = &vi->queue;
+	int ret;
+
+	vi->pix.pixelformat = V4L2_PIX_FMT_SBGGR12P;
+	vi->pix.width = CV1800_VI_DEF_WIDTH;
+	vi->pix.height = CV1800_VI_DEF_HEIGHT;
+	cv1800_vi_try_pix(&vi->pix, &vi->fmt);
+
+	q->type = V4L2_BUF_TYPE_VIDEO_CAPTURE;
+	q->io_modes = VB2_MMAP | VB2_DMABUF | VB2_READ;
+	q->drv_priv = vi;
+	q->buf_struct_size = sizeof(struct cv1800_vi_buffer);
+	q->ops = &cv1800_vi_qops;
+	q->mem_ops = &vb2_dma_contig_memops;
+	/* Full-size frames can exhaust CMA: REQBUFS then returns fewer buffers */
+	q->gfp_flags = __GFP_NOWARN;
+	q->timestamp_flags = V4L2_BUF_FLAG_TIMESTAMP_MONOTONIC |
+			     V4L2_BUF_FLAG_TSTAMP_SRC_SOE;
+	q->lock = &vi->lock;
+	q->min_queued_buffers = 1;
+	q->dev = vi->dev;
+	q->allow_cache_hints = 1;
+	ret = vb2_queue_init(q);
+	if (ret)
+		return ret;
+
+	strscpy(vdev->name, "cv1800-vi-raw", sizeof(vdev->name));
+	vdev->release = video_device_release_empty;
+	vdev->fops = &cv1800_vi_fops;
+	vdev->ioctl_ops = &cv1800_vi_ioctl_ops;
+	vdev->v4l2_dev = &vi->v4l2_dev;
+	vdev->queue = q;
+	vdev->lock = &vi->lock;
+	vdev->device_caps = V4L2_CAP_VIDEO_CAPTURE | V4L2_CAP_STREAMING |
+			    V4L2_CAP_READWRITE | V4L2_CAP_IO_MC;
+	vdev->vfl_dir = VFL_DIR_RX;
+	vdev->entity.ops = &cv1800_vi_video_entity_ops;
+	video_set_drvdata(vdev, vi);
+
+	vi->vdev_pad.flags = MEDIA_PAD_FL_SINK | MEDIA_PAD_FL_MUST_CONNECT;
+	ret = media_entity_pads_init(&vdev->entity, 1, &vi->vdev_pad);
+	if (ret)
+		return ret;
+
+	ret = video_register_device(vdev, VFL_TYPE_VIDEO, -1);
+	if (ret)
+		goto err_entity;
+
+	ret = media_create_pad_link(&vi->sd.entity, CV1800_VI_PAD_SOURCE,
+				    &vdev->entity, 0,
+				    MEDIA_LNK_FL_ENABLED | MEDIA_LNK_FL_IMMUTABLE);
+	if (ret)
+		goto err_video;
+
+	return 0;
+
+err_video:
+	vb2_video_unregister_device(vdev);
+err_entity:
+	media_entity_cleanup(&vdev->entity);
+	return ret;
+}
+
+static int cv1800_vi_runtime_suspend(struct device *dev)
+{
+	struct cv1800_vi *vi = dev_get_drvdata(dev);
+
+	disable_irq(vi->irq);
+	cv1800_vi_quiesce_irqs(vi);
+	clk_bulk_disable_unprepare(vi->num_clks, vi->clks);
+
+	return 0;
+}
+
+static int cv1800_vi_runtime_resume(struct device *dev)
+{
+	struct cv1800_vi *vi = dev_get_drvdata(dev);
+	int ret;
+
+	ret = clk_bulk_prepare_enable(vi->num_clks, vi->clks);
+	if (ret)
+		return ret;
+
+	cv1800_vi_hw_reset(vi);
+	enable_irq(vi->irq);
+
+	return 0;
+}
+
+/*
+ * Bring-up aid: what the bridge measured in the incoming frames. The block
+ * is only clocked while the device is active, so nothing is read otherwise.
+ */
+static int cv1800_vi_status_show(struct seq_file *s, void *unused)
+{
+	struct cv1800_vi *vi = s->private;
+	u32 dbg2;
+
+	if (pm_runtime_get_if_active(vi->dev) <= 0) {
+		seq_puts(s, "powered down\n");
+		return 0;
+	}
+
+	dbg2 = vi_read(vi, BDG_CH0_DEBUG_2);
+	seq_printf(s, "bridge ctrl        %08x  ch0 size %08x (w-1, h-1)\n",
+		   vi_read(vi, BDG_TOP_CTRL), vi_read(vi, BDG_CH_SIZE(0)));
+	seq_printf(s, "ch0 pixels/lines   %u / %u\n",
+		   vi_read(vi, BDG_CH0_DEBUG_0), vi_read(vi, BDG_CH0_DEBUG_1));
+	seq_printf(s, "ch0 vs/trig count  %lu / %lu  idle %08x\n",
+		   FIELD_GET(BDG_CH0_VS_CNT, dbg2), FIELD_GET(BDG_CH0_TRIG_CNT, dbg2),
+		   vi_read(vi, BDG_CH0_DEBUG_3));
+	seq_printf(s, "bridge status now  %08x %08x\n",
+		   vi_read(vi, BDG_INT_STATUS_0), vi_read(vi, BDG_INT_STATUS_1));
+	seq_printf(s, "bridge status seen %08x %08x%s%s%s%s%s\n",
+		   vi->s0_seen, vi->s1_seen,
+		   vi->s0_seen & BDG_CH0_FRAME_DROP_INT ? " drop" : "",
+		   vi->s0_seen & BDG_CH0_WIDTH_GT_INT ? " wider" : "",
+		   vi->s0_seen & BDG_CH0_WIDTH_LS_INT ? " narrower" : "",
+		   vi->s0_seen & BDG_CH0_HEIGHT_GT_INT ? " taller" : "",
+		   vi->s0_seen & BDG_CH0_HEIGHT_LS_INT ? " shorter" : "");
+	seq_printf(s, "top events seen    ev0 %08x ev2 %08x\n",
+		   vi->ev0_seen, vi->ev2_seen);
+	seq_printf(s, "front end          vld %08x idle %08x\n",
+		   vi_read(vi, FE_FRAME_VLD), vi_read(vi, TOP_BLK_IDLE));
+	seq_printf(s, "frames %u, errors %u, bridge resets %u\n",
+		   vi->frames, vi->errors, vi->recoveries);
+
+	pm_runtime_put(vi->dev);
+
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(cv1800_vi_status);
+
+static int cv1800_vi_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct cv1800_vi *vi;
+	int ret, i;
+
+	vi = devm_kzalloc(dev, sizeof(*vi), GFP_KERNEL);
+	if (!vi)
+		return -ENOMEM;
+	vi->dev = dev;
+	mutex_init(&vi->lock);
+	spin_lock_init(&vi->qlock);
+	INIT_LIST_HEAD(&vi->buffers);
+	INIT_WORK(&vi->recover, cv1800_vi_recover);
+	platform_set_drvdata(pdev, vi);
+
+	vi->base = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(vi->base))
+		return PTR_ERR(vi->base);
+
+	vi->vip_sys = syscon_regmap_lookup_by_phandle(dev->of_node, "sophgo,vip-sys");
+	if (IS_ERR(vi->vip_sys))
+		return dev_err_probe(dev, PTR_ERR(vi->vip_sys), "vip_sys syscon\n");
+
+	vi->num_clks = devm_clk_bulk_get_all(dev, &vi->clks);
+	if (vi->num_clks < 0)
+		return dev_err_probe(dev, vi->num_clks, "clocks\n");
+	for (i = 0; i < vi->num_clks; i++)
+		if (!strcmp(vi->clks[i].id, "sys2"))
+			vi->mac_src = vi->clks[i].clk;
+	if (!vi->mac_src)
+		return dev_err_probe(dev, -EINVAL, "no sys2 clock\n");
+
+	vi->rst = devm_reset_control_get_optional_shared_deasserted(dev, NULL);
+	if (IS_ERR(vi->rst))
+		return dev_err_probe(dev, PTR_ERR(vi->rst), "reset\n");
+
+	vi->irq = platform_get_irq(pdev, 0);
+	if (vi->irq < 0)
+		return vi->irq;
+	ret = devm_request_irq(dev, vi->irq, cv1800_vi_irq, IRQF_NO_AUTOEN,
+			       dev_name(dev), vi);
+	if (ret)
+		return ret;
+
+	ret = dma_set_mask_and_coherent(dev, DMA_BIT_MASK(40));
+	if (ret)
+		return ret;
+
+	ret = devm_pm_runtime_enable(dev);
+	if (ret)
+		return ret;
+	ret = pm_runtime_resume_and_get(dev);
+	if (ret)
+		return ret;
+	dev_info(dev, "ISP revision %#x\n", vi_read(vi, TOP_SVN_VERSION));
+	pm_runtime_put_sync(dev);
+
+	vi->mdev.dev = dev;
+	strscpy(vi->mdev.model, "Sophgo CV1800 VI", sizeof(vi->mdev.model));
+	media_device_init(&vi->mdev);
+	vi->v4l2_dev.mdev = &vi->mdev;
+
+	ret = v4l2_device_register(dev, &vi->v4l2_dev);
+	if (ret)
+		goto err_media;
+
+	ret = cv1800_vi_init_subdev(vi);
+	if (ret)
+		goto err_v4l2;
+
+	ret = cv1800_vi_init_video(vi);
+	if (ret)
+		goto err_subdev;
+
+	ret = cv1800_vi_parse_dt(vi);
+	if (ret < 0)
+		goto err_video;
+
+	/* Without a source only the pattern generator can feed the bridge */
+	if (!ret) {
+		v4l2_ctrl_s_ctrl(vi->test_pattern, 1);
+		ret = v4l2_device_register_subdev_nodes(&vi->v4l2_dev);
+		if (ret)
+			goto err_notifier;
+	}
+
+	ret = media_device_register(&vi->mdev);
+	if (ret)
+		goto err_notifier;
+
+	vi->debugfs = debugfs_create_dir(dev_name(vi->dev), NULL);
+	debugfs_create_file("status", 0444, vi->debugfs, vi, &cv1800_vi_status_fops);
+
+	return 0;
+
+err_notifier:
+	v4l2_async_nf_unregister(&vi->notifier);
+	v4l2_async_nf_cleanup(&vi->notifier);
+err_video:
+	vb2_video_unregister_device(&vi->vdev);
+	media_entity_cleanup(&vi->vdev.entity);
+err_subdev:
+	cv1800_vi_cleanup_subdev(vi);
+err_v4l2:
+	v4l2_device_unregister(&vi->v4l2_dev);
+err_media:
+	media_device_cleanup(&vi->mdev);
+	return ret;
+}
+
+static void cv1800_vi_remove(struct platform_device *pdev)
+{
+	struct cv1800_vi *vi = platform_get_drvdata(pdev);
+
+	debugfs_remove_recursive(vi->debugfs);
+	/* Stop a running stream first: it needs the media graph and the source */
+	vb2_video_unregister_device(&vi->vdev);
+	v4l2_async_nf_unregister(&vi->notifier);
+	v4l2_async_nf_cleanup(&vi->notifier);
+	media_device_unregister(&vi->mdev);
+	media_entity_cleanup(&vi->vdev.entity);
+	cv1800_vi_cleanup_subdev(vi);
+	v4l2_device_unregister(&vi->v4l2_dev);
+	media_device_cleanup(&vi->mdev);
+}
+
+static DEFINE_RUNTIME_DEV_PM_OPS(cv1800_vi_pm_ops, cv1800_vi_runtime_suspend,
+				 cv1800_vi_runtime_resume, NULL);
+
+static const struct of_device_id cv1800_vi_of_match[] = {
+	{ .compatible = "sophgo,sg2000-vi" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, cv1800_vi_of_match);
+
+static struct platform_driver cv1800_vi_driver = {
+	.probe = cv1800_vi_probe,
+	.remove = cv1800_vi_remove,
+	.driver = {
+		.name = CV1800_VI_NAME,
+		.of_match_table = cv1800_vi_of_match,
+		.pm = pm_ptr(&cv1800_vi_pm_ops),
+	},
+};
+module_platform_driver(cv1800_vi_driver);
+
+MODULE_DESCRIPTION("Sophgo CV1800/SG2000 video input raw capture");
+MODULE_LICENSE("GPL");
