From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Lukasz Sobala <lsobala1@gmail.com>
Date: Wed, 14 Oct 2026 23:50:23 +0200
Subject: riscv: dts: sophgo: add the Milk-V Duo S J1 GC2083 camera
 overlay

Add an overlay for the Milk-V CAM-GC2083 on the J1 connector. It uses
the SG2000 CSI-2 receiver and VI capture drivers. Enable it with
overlays=camera-j1-gc2083. Do not combine it with a J2 camera overlay.
---
 arch/riscv/boot/dts/sophgo/Makefile           |   5 +
 .../overlay/sg2000-camera-j1-gc2083.dtso      | 125 ++++++++++++++++++
 2 files changed, 130 insertions(+)
 create mode 100644 arch/riscv/boot/dts/sophgo/overlay/sg2000-camera-j1-gc2083.dtso

diff --git a/arch/riscv/boot/dts/sophgo/Makefile b/arch/riscv/boot/dts/sophgo/Makefile
index cde9dfc..7bdd5c6 100644
--- a/arch/riscv/boot/dts/sophgo/Makefile
+++ b/arch/riscv/boot/dts/sophgo/Makefile
@@ -62,3 +62,8 @@ dtb-$(CONFIG_ARCH_SOPHGO) += sg2000-milkv-duo-s-camera-j2-imx708.dtb
 dtb-$(CONFIG_ARCH_SOPHGO) += sg2000-milkv-duo-s-camera-j2-ov5647.dtb
 dtb-$(CONFIG_ARCH_SOPHGO) += overlay/sg2000-camera-j2-imx708.dtbo
 dtb-$(CONFIG_ARCH_SOPHGO) += overlay/sg2000-camera-j2-ov5647.dtbo
+
+# The Milk-V Duo S J1 camera overlay
+sg2000-milkv-duo-s-camera-j1-gc2083-dtbs := sg2000-milkv-duo-s.dtb overlay/sg2000-camera-j1-gc2083.dtbo
+dtb-$(CONFIG_ARCH_SOPHGO) += sg2000-milkv-duo-s-camera-j1-gc2083.dtb
+dtb-$(CONFIG_ARCH_SOPHGO) += overlay/sg2000-camera-j1-gc2083.dtbo
diff --git a/arch/riscv/boot/dts/sophgo/overlay/sg2000-camera-j1-gc2083.dtso b/arch/riscv/boot/dts/sophgo/overlay/sg2000-camera-j1-gc2083.dtso
new file mode 100644
index 0000000..6e18c9e
--- /dev/null
+++ b/arch/riscv/boot/dts/sophgo/overlay/sg2000-camera-j1-gc2083.dtso
@@ -0,0 +1,125 @@
+// SPDX-License-Identifier: (GPL-2.0 OR MIT)
+/*
+ * Milk-V CAM-GC2083 (GalaxyCore GC2083) on the Milk-V Duo S J1 connector.
+ *
+ * Enable with overlays=camera-j1-gc2083 in /boot/armbianEnv.txt.
+ * Do not combine with a J2 camera overlay: both use CSI-2 MAC 0.
+ *
+ * J1 wiring, from the vendor's sensor_cfg_GC2083.ini for this board:
+ *
+ *   I2C3, sensor at 0x37
+ *   CAM_MCLK0 (CLK_CAM0), 24 MHz requested, 23.76 MHz delivered
+ *   CAM_RST0 = GPIOA2, active low
+ *   MIPI RX lane 2 clock, lanes 0/1 data (lane_id = 2, 0, 1)
+ *
+ * The lane_id default in the vendor's GC2083 driver is 1, 0, 2. It is wrong
+ * for this board, and the board's ini file replaces it at runtime.
+ *
+ * U-Boot sets the pinmux of the J1 pads. Do not add a pinctrl-0 to &i2c3:
+ * the pull-ups on the board override the pull-down default of the pads.
+ */
+/dts-v1/;
+/plugin/;
+
+#include <dt-bindings/clock/sophgo,cv1800.h>
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+#include <riscv/sophgo/cv18xx-reset.h>
+
+/* The arm64 overlay defines these first, for the GIC */
+#ifndef SOC_PERIPHERAL_IRQ
+#define SOC_PERIPHERAL_IRQ(nr)	((nr) + 16)
+#define SOC_INTC		&plic
+#endif
+
+&i2c3 {
+	#address-cells = <1>;
+	#size-cells = <0>;
+
+	camera@37 {
+		compatible = "galaxycore,gc2083";
+		reg = <0x37>;
+		/* cam0pll is fractional: set the divider only, never the PLL */
+		clocks = <&clk CLK_CAM0>;
+		assigned-clocks = <&clk CLK_CAM0>;
+		assigned-clock-rates = <24000000>;
+		reset-gpios = <&porta 2 GPIO_ACTIVE_LOW>;
+
+		port {
+			sensor_out: endpoint {
+				remote-endpoint = <&csi2_in>;
+				data-lanes = <1 2>;
+				link-frequencies = /bits/ 64 <247500000>;
+			};
+		};
+	};
+};
+
+&{/soc} {
+	#address-cells = <1>;
+	#size-cells = <1>;
+
+	vip_sys: syscon@a0c8000 {
+		compatible = "sophgo,sg2000-vip-sys", "syscon";
+		reg = <0x0a0c8000 0x100>;
+	};
+
+	csi@a0c2000 {
+		compatible = "sophgo,sg2000-csi2";
+		reg = <0x0a0c2000 0x2000>, <0x0a0d0000 0x1000>,
+		      <0x03001c30 0x30>;
+		reg-names = "mac", "phy", "pad";
+		interrupt-parent = <SOC_INTC>;
+		interrupts = <SOC_PERIPHERAL_IRQ(10) IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&clk CLK_SRC_VIP_SYS_2>, <&clk CLK_AXI_VIP>,
+			 <&clk CLK_CFG_REG_VIP>, <&clk CLK_CSI_MAC0_VIP>,
+			 <&clk CLK_CSI0_RX_VIP>;
+		clock-names = "sys2", "axi", "cfg", "mac", "rx";
+		resets = <&rst 70>, <&rst 71>;
+		reset-names = "phy", "phy-apb";
+		sophgo,vip-sys = <&vip_sys>;
+
+		ports {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			port@0 {
+				reg = <0>;
+				csi2_in: endpoint {
+					remote-endpoint = <&sensor_out>;
+					clock-lanes = <2>;
+					data-lanes = <0 1>;
+				};
+			};
+
+			port@1 {
+				reg = <1>;
+				csi2_out: endpoint {
+					remote-endpoint = <&vi_in>;
+				};
+			};
+		};
+	};
+
+	video-input@a000000 {
+		compatible = "sophgo,sg2000-vi";
+		reg = <0x0a000000 0x80000>;
+		interrupt-parent = <SOC_INTC>;
+		interrupts = <SOC_PERIPHERAL_IRQ(8) IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&clk CLK_SRC_VIP_SYS_0>, <&clk CLK_SRC_VIP_SYS_1>,
+			 <&clk CLK_SRC_VIP_SYS_2>, <&clk CLK_SRC_VIP_SYS_3>,
+			 <&clk CLK_AXI_VIP>, <&clk CLK_CFG_REG_VIP>,
+			 <&clk CLK_ISP_TOP_VIP>, <&clk CLK_CSI_BE_VIP>,
+			 <&clk CLK_RAW_VIP>, <&clk CLK_CSI_MAC0_VIP>;
+		clock-names = "sys0", "sys1", "sys2", "sys3", "axi", "cfg",
+			      "isp_top", "csi_be", "raw", "csi_mac0";
+		resets = <&rst RST_VIPSYS>;
+		sophgo,vip-sys = <&vip_sys>;
+
+		port {
+			vi_in: endpoint {
+				remote-endpoint = <&csi2_out>;
+			};
+		};
+	};
+};
