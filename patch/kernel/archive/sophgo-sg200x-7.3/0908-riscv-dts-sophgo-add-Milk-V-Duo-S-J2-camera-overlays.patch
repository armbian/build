From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: morikon <leafpmpmp@gmail.com>
Date: Tue, 13 Oct 2026 14:00:00 +0800
Subject: riscv: dts: sophgo: add Milk-V Duo S J2 camera overlays

Add overlays for the Raspberry Pi Camera Module 3 (IMX708) and v1
(OV5647) on the J2 connector. Enable one with overlays=camera-j2-imx708
or overlays=camera-j2-ov5647. Use a ribbon cable of 150 mm or less.
Longer cables cause I2C errors on J2. sg2000-camera.dtsi holds the CSI-2
receiver and VI nodes, which every camera overlay includes.
---
 arch/riscv/boot/dts/sophgo/Makefile           |  9 ++
 .../overlay/sg2000-camera-j2-imx708.dtso      | 46 ++++++++++
 .../overlay/sg2000-camera-j2-ov5647.dtso      | 35 ++++++++
 .../dts/sophgo/overlay/sg2000-camera-j2.dtsi  | 85 ++++++++++++++++++
 .../dts/sophgo/overlay/sg2000-camera.dtsi     | 86 +++++++++++++++++++
 5 files changed, 261 insertions(+)
 create mode 100644 arch/riscv/boot/dts/sophgo/overlay/sg2000-camera-j2-imx708.dtso
 create mode 100644 arch/riscv/boot/dts/sophgo/overlay/sg2000-camera-j2-ov5647.dtso
 create mode 100644 arch/riscv/boot/dts/sophgo/overlay/sg2000-camera-j2.dtsi
 create mode 100644 arch/riscv/boot/dts/sophgo/overlay/sg2000-camera.dtsi

diff --git a/arch/riscv/boot/dts/sophgo/Makefile b/arch/riscv/boot/dts/sophgo/Makefile
index 111111111111..222222222222 100644
--- a/arch/riscv/boot/dts/sophgo/Makefile
+++ b/arch/riscv/boot/dts/sophgo/Makefile
@@ -53,3 +53,12 @@ dtb-$(CONFIG_ARCH_SOPHGO) += overlay/sg2000-uart1.dtbo
 dtb-$(CONFIG_ARCH_SOPHGO) += overlay/sg2000-uart2.dtbo
 dtb-$(CONFIG_ARCH_SOPHGO) += overlay/sg2000-pwm0.dtbo
 dtb-$(CONFIG_ARCH_SOPHGO) += overlay/sg2000-pwm1.dtbo
+
+# The Milk-V Duo S J2 camera overlays. The composite targets only check
+# that the overlays apply to the base.
+sg2000-milkv-duo-s-camera-j2-imx708-dtbs := sg2000-milkv-duo-s.dtb overlay/sg2000-camera-j2-imx708.dtbo
+sg2000-milkv-duo-s-camera-j2-ov5647-dtbs := sg2000-milkv-duo-s.dtb overlay/sg2000-camera-j2-ov5647.dtbo
+dtb-$(CONFIG_ARCH_SOPHGO) += sg2000-milkv-duo-s-camera-j2-imx708.dtb
+dtb-$(CONFIG_ARCH_SOPHGO) += sg2000-milkv-duo-s-camera-j2-ov5647.dtb
+dtb-$(CONFIG_ARCH_SOPHGO) += overlay/sg2000-camera-j2-imx708.dtbo
+dtb-$(CONFIG_ARCH_SOPHGO) += overlay/sg2000-camera-j2-ov5647.dtbo
diff --git a/arch/riscv/boot/dts/sophgo/overlay/sg2000-camera-j2-imx708.dtso b/arch/riscv/boot/dts/sophgo/overlay/sg2000-camera-j2-imx708.dtso
new file mode 100644
index 000000000000..111111111111
--- /dev/null
+++ b/arch/riscv/boot/dts/sophgo/overlay/sg2000-camera-j2-imx708.dtso
@@ -0,0 +1,46 @@
+// SPDX-License-Identifier: (GPL-2.0 OR MIT)
+/*
+ * Raspberry Pi Camera Module 3 (Sony IMX708 with a DW9817 focus driver) on
+ * the Milk-V Duo S J2 connector. Sensor at 0x1a, focus driver at 0x0c.
+ *
+ * Enable with overlays=camera-j2-imx708 in /boot/armbianEnv.txt.
+ * Use a ribbon cable of 150 mm or less: longer cables cause I2C errors on J2.
+ */
+/dts-v1/;
+/plugin/;
+
+#define J2_CAM_CLOCK_HZ 24000000
+#include "sg2000-camera-j2.dtsi"
+
+&i2c2 {
+	#address-cells = <1>;
+	#size-cells = <0>;
+
+	imx708: camera@1a {
+		compatible = "sony,imx708";
+		reg = <0x1a>;
+		clocks = <&cam1_clk>;
+		vana1-supply = <&cam1_reg>;
+		vana2-supply = <&cam1_reg>;
+		vdig-supply = <&cam1_reg>;
+		vddl-supply = <&cam1_reg>;
+		lens-focus = <&vcm>;
+		/* Camera Module 3 on a ribbon cable; its sensor is mounted upside down */
+		orientation = <2>;
+		rotation = <180>;
+
+		port {
+			sensor_out: endpoint {
+				remote-endpoint = <&csi2_in>;
+				data-lanes = <1 2>;
+				link-frequencies = /bits/ 64 <450000000>;
+			};
+		};
+	};
+
+	vcm: focus@c {
+		compatible = "dongwoon,dw9817-vcm";
+		reg = <0x0c>;
+		vdd-supply = <&cam1_reg>;
+	};
+};
diff --git a/arch/riscv/boot/dts/sophgo/overlay/sg2000-camera-j2-ov5647.dtso b/arch/riscv/boot/dts/sophgo/overlay/sg2000-camera-j2-ov5647.dtso
new file mode 100644
index 000000000000..111111111111
--- /dev/null
+++ b/arch/riscv/boot/dts/sophgo/overlay/sg2000-camera-j2-ov5647.dtso
@@ -0,0 +1,35 @@
+// SPDX-License-Identifier: (GPL-2.0 OR MIT)
+/*
+ * Raspberry Pi Camera Module v1 (OmniVision OV5647) on the Milk-V Duo S J2
+ * connector. Sensor at 0x36, clocked by the module's 25 MHz oscillator.
+ *
+ * Enable with overlays=camera-j2-ov5647 in /boot/armbianEnv.txt.
+ * Use a ribbon cable of 150 mm or less: longer cables cause I2C errors on J2.
+ */
+/dts-v1/;
+/plugin/;
+
+#define J2_CAM_CLOCK_HZ 25000000
+#include "sg2000-camera-j2.dtsi"
+
+&i2c2 {
+	#address-cells = <1>;
+	#size-cells = <0>;
+
+	ov5647: camera@36 {
+		compatible = "ovti,ov5647";
+		reg = <0x36>;
+		clocks = <&cam1_clk>;
+		avdd-supply = <&cam1_reg>;
+		dovdd-supply = <&cam1_reg>;
+		dvdd-supply = <&cam1_reg>;
+		orientation = <2>;
+
+		port {
+			sensor_out: endpoint {
+				remote-endpoint = <&csi2_in>;
+				data-lanes = <1 2>;
+			};
+		};
+	};
+};
diff --git a/arch/riscv/boot/dts/sophgo/overlay/sg2000-camera-j2.dtsi b/arch/riscv/boot/dts/sophgo/overlay/sg2000-camera-j2.dtsi
new file mode 100644
index 000000000000..111111111111
--- /dev/null
+++ b/arch/riscv/boot/dts/sophgo/overlay/sg2000-camera-j2.dtsi
@@ -0,0 +1,85 @@
+// SPDX-License-Identifier: (GPL-2.0 OR MIT)
+/*
+ * J2 part of the Milk-V Duo S camera overlays: power, I2C and the receiver
+ * lanes. Each J2 overlay sets J2_CAM_CLOCK_HZ to its module's oscillator,
+ * includes this file and adds the sensor under &i2c2 with its endpoint
+ * labelled sensor_out. sg2000-camera.dtsi adds the CSI-2 receiver and the
+ * VI capture block.
+ *
+ * J2 is wired like the Raspberry Pi 15-pin camera connector:
+ *
+ *   I2C2 (IIC2_SCL/IIC2_SDA, 3.3V)  the camera's control bus
+ *   SENSOR_RSTN1 = CAM_PD1 = GPIOA4  the module's power enable (CAM_IO0)
+ *   MIPI RX lanes 3/4 data, 5 clock  CSI-2 MAC 0, port 1 of the PHY
+ *
+ * Raspberry Pi camera modules carry their own oscillator, so CAM_MCLK1 is
+ * unused.
+ */
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/pinctrl/pinctrl-sg2000.h>
+
+#include "sg2000-camera.dtsi"
+
+&{/} {
+	cam1_clk: cam1-clock {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <J2_CAM_CLOCK_HZ>;
+	};
+
+	cam1_reg: cam1-regulator {
+		compatible = "regulator-fixed";
+		regulator-name = "cam1-power";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		gpio = <&porta 4 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		startup-delay-us = <70000>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&cam1_power_cfg>;
+	};
+};
+
+&pinctrl {
+	cam1_power_cfg: cam1-power-cfg {
+		cam1-power-pins {
+			/* keep the pull-down: the camera stays off until driven */
+			pinmux = <PINMUX(PIN_CAM_PD1, 3)>;
+			bias-pull-down;
+			power-source = <1800>;
+		};
+	};
+
+	i2c2_cfg: i2c2-cfg {
+		i2c2-pins {
+			pinmux = <PINMUX(PIN_IIC2_SCL, 0)>,
+				 <PINMUX(PIN_IIC2_SDA, 0)>;
+			bias-pull-up;
+			/* pull-up alone leaves PD as is; pinconf-generic warns, applies both */
+			bias-pull-down = <0>;
+			power-source = <3300>;
+		};
+	};
+};
+
+&i2c2 {
+	#address-cells = <1>;
+	#size-cells = <0>;
+	pinctrl-names = "default";
+	pinctrl-0 = <&i2c2_cfg>;
+	/*
+	 * J2's I2C goes through a UM3204H auto-direction level shifter. On a
+	 * 500 mm cable SCL's rising edge crawls up to the shifter's one-shot
+	 * threshold with tens-of-MHz ringing on top and crosses it more than
+	 * once, so the sensor counts extra clocks and transfers fail at random
+	 * at any bus speed. Use a short (<= 150 mm) cable.
+	 */
+	clock-frequency = <100000>;
+	status = "okay";
+};
+
+&csi2_in {
+	clock-lanes = <5>;
+	data-lanes = <3 4>;
+};
diff --git a/arch/riscv/boot/dts/sophgo/overlay/sg2000-camera.dtsi b/arch/riscv/boot/dts/sophgo/overlay/sg2000-camera.dtsi
new file mode 100644
index 000000000000..111111111111
--- /dev/null
+++ b/arch/riscv/boot/dts/sophgo/overlay/sg2000-camera.dtsi
@@ -0,0 +1,86 @@
+// SPDX-License-Identifier: (GPL-2.0 OR MIT)
+/*
+ * Shared part of the Milk-V Duo S camera overlays: the CSI-2 receiver
+ * (MAC 0) and the VI capture block. A camera overlay includes this file,
+ * adds its sensor with the endpoint labelled sensor_out, and sets the
+ * receiver lanes of its connector in &csi2_in.
+ *
+ * Only one camera overlay can be active: all of them use CSI-2 MAC 0.
+ */
+
+#include <dt-bindings/clock/sophgo,cv1800.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+#include <riscv/sophgo/cv18xx-reset.h>
+
+/* The arm64 overlays define these first, for the GIC */
+#ifndef SOC_PERIPHERAL_IRQ
+#define SOC_PERIPHERAL_IRQ(nr)	((nr) + 16)
+#define SOC_INTC		&plic
+#endif
+
+&{/soc} {
+	#address-cells = <1>;
+	#size-cells = <1>;
+
+	vip_sys: syscon@a0c8000 {
+		compatible = "sophgo,sg2000-vip-sys", "syscon";
+		reg = <0x0a0c8000 0x100>;
+	};
+
+	csi@a0c2000 {
+		compatible = "sophgo,sg2000-csi2";
+		reg = <0x0a0c2000 0x2000>, <0x0a0d0000 0x1000>,
+		      <0x03001c30 0x30>;
+		reg-names = "mac", "phy", "pad";
+		interrupt-parent = <SOC_INTC>;
+		interrupts = <SOC_PERIPHERAL_IRQ(10) IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&clk CLK_SRC_VIP_SYS_2>, <&clk CLK_AXI_VIP>,
+			 <&clk CLK_CFG_REG_VIP>, <&clk CLK_CSI_MAC0_VIP>,
+			 <&clk CLK_CSI0_RX_VIP>;
+		clock-names = "sys2", "axi", "cfg", "mac", "rx";
+		resets = <&rst 70>, <&rst 71>;
+		reset-names = "phy", "phy-apb";
+		sophgo,vip-sys = <&vip_sys>;
+
+		ports {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			port@0 {
+				reg = <0>;
+				csi2_in: endpoint {
+					remote-endpoint = <&sensor_out>;
+				};
+			};
+
+			port@1 {
+				reg = <1>;
+				csi2_out: endpoint {
+					remote-endpoint = <&vi_in>;
+				};
+			};
+		};
+	};
+
+	video-input@a000000 {
+		compatible = "sophgo,sg2000-vi";
+		reg = <0x0a000000 0x80000>;
+		interrupt-parent = <SOC_INTC>;
+		interrupts = <SOC_PERIPHERAL_IRQ(8) IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&clk CLK_SRC_VIP_SYS_0>, <&clk CLK_SRC_VIP_SYS_1>,
+			 <&clk CLK_SRC_VIP_SYS_2>, <&clk CLK_SRC_VIP_SYS_3>,
+			 <&clk CLK_AXI_VIP>, <&clk CLK_CFG_REG_VIP>,
+			 <&clk CLK_ISP_TOP_VIP>, <&clk CLK_CSI_BE_VIP>,
+			 <&clk CLK_RAW_VIP>, <&clk CLK_CSI_MAC0_VIP>;
+		clock-names = "sys0", "sys1", "sys2", "sys3", "axi", "cfg",
+			      "isp_top", "csi_be", "raw", "csi_mac0";
+		resets = <&rst RST_VIPSYS>;
+		sophgo,vip-sys = <&vip_sys>;
+
+		port {
+			vi_in: endpoint {
+				remote-endpoint = <&csi2_out>;
+			};
+		};
+	};
+};
-- 
