From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: queenkjuul <queenkjuul@pm.me>
Date: Tue, 24 Mar 2026 09:28:10 +0000
Subject: riscv: dts: sophgo: enable all peripherals for sg2000

---
 arch/riscv/boot/dts/sophgo/sg2000-milkv-duo-s.dts | 45 ++++++++++
 1 file changed, 45 insertions(+)

diff --git a/arch/riscv/boot/dts/sophgo/sg2000-milkv-duo-s.dts b/arch/riscv/boot/dts/sophgo/sg2000-milkv-duo-s.dts
index 111111111111..222222222222 100644
--- a/arch/riscv/boot/dts/sophgo/sg2000-milkv-duo-s.dts
+++ b/arch/riscv/boot/dts/sophgo/sg2000-milkv-duo-s.dts
@@ -10,12 +10,17 @@ / {
 	compatible = "milkv,duo-s", "sophgo,sg2000";
 
 	aliases {
+		i2c1 = &i2c1;
+		i2c2 = &i2c2;
+		i2c3 = &i2c3;
 		i2c4 = &i2c4;
 		mmc0 = &sdhci0;
 		mmc1 = &emmc;
 		mmc2 = &sdhci1;
 		serial0 = &uart0;
 		serial4 = &uart4;
+		spi0 = &spi0;
+		spi3 = &spi3;
 	};
 
 	chosen {
@@ -185,6 +190,18 @@ &gmac0 {
 	status = "okay";
 };
 
+&i2c1 {
+	status = "okay";
+};
+
+&i2c2 {
+	status = "okay";
+};
+
+&i2c3 {
+	status = "okay";
+};
+
 &i2c4 {
 	pinctrl-0 = <&i2c4_cfg>;
 	pinctrl-names = "default";
@@ -225,6 +242,22 @@ &sdhci1 {
 	status = "okay";
 };
 
+&spi0 {
+	status = "okay";
+};
+
+&spi1 {
+	status = "okay";
+};
+
+&spi2 {
+	status = "okay";
+};
+
+&spi3 {
+	status = "okay";
+};
+
 &uart0 {
 	pinctrl-0 = <&uart0_cfg>;
 	pinctrl-names = "default";
@@ -238,6 +271,18 @@ &uart4 {
 	status = "okay";
 };
 
+&uart1 {
+	status = "okay";
+};
+
+&uart2 {
+	status = "okay";
+};
+
+&uart3 {
+	status = "okay";
+};
+
 &uart4 {
 	status = "okay";
 };
-- 
Armbian

