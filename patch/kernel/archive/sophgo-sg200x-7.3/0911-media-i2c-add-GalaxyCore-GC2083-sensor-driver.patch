+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Driver for the GalaxyCore GC2083 image sensor
+ *
+ * 1920x1080 10-bit Bayer, 2-lane MIPI CSI-2, 30fps. Found on the Milk-V
+ * CAM-GC2083 module, which is what the Milk-V Duo and Duo S ship with.
+ *
+ * The register tables here are derived from GalaxyCore's reference settings as
+ * carried in Sophgo's duo-buildroot-sdk-v2, where the sensor is driven entirely
+ * from userspace by the CVI MPI stack rather than by a kernel driver. There is
+ * no public GC2083 datasheet, so the meaning of most registers in
+ * gc2083_1080p_regs[] is not known and the sequence is reproduced verbatim.
+ * Ingenic's GPL-2.0+ gc2083.c carries the same table for a 27MHz input, apart
+ * from the PLL, frame timing and analogue settings, and documents the PLL
+ * rates used below.
+ * Where a register's purpose *is* known - exposure, gain, frame length, flips -
+ * it is named and driven from V4L2 controls instead.
+ */
+
+#include <linux/array_size.h>
+#include <linux/bits.h>
+#include <linux/clk.h>
+#include <linux/container_of.h>
+#include <linux/delay.h>
+#include <linux/device.h>
+#include <linux/err.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/math64.h>
+#include <linux/module.h>
+#include <linux/pm_runtime.h>
+#include <linux/property.h>
+#include <linux/regulator/consumer.h>
+#include <linux/types.h>
+
+#include <media/v4l2-cci.h>
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-fwnode.h>
+#include <media/v4l2-subdev.h>
+
+#define GC2083_REG_CHIP_ID		CCI_REG16(0x03f0)
+#define GC2083_CHIP_ID			0x2083
+
+/*
+ * Exposure, in lines. 14 bits wide: the top two bits of the high byte are
+ * something else, so the value has to be masked rather than written whole.
+ */
+#define GC2083_REG_EXPOSURE		CCI_REG16(0x0d03)
+#define GC2083_EXPOSURE_MASK		GENMASK(13, 0)
+#define GC2083_EXPOSURE_MIN		1
+#define GC2083_EXPOSURE_STEP		1
+/* The vendor caps exposure at VTS - 8 lines. */
+#define GC2083_EXPOSURE_MARGIN		8
+
+/* Frame length (VTS), in lines. */
+#define GC2083_REG_VTS			CCI_REG16(0x0d41)
+#define GC2083_VTS_MAX			0x3fff
+
+/*
+ * Analogue gain is a 13-register affair with no arithmetic relationship to the
+ * gain it produces - see gc2083_again_table[]. Two of those registers are
+ * bracketed by writes to 0x031d, which the vendor code calls a hold/release.
+ */
+#define GC2083_REG_AGAIN_LOW		CCI_REG8(0x00d0)
+#define GC2083_REG_AGAIN_HIGH		CCI_REG8(0x0dc1)
+#define GC2083_REG_GAIN_LATCH		CCI_REG8(0x031d)
+#define GC2083_GAIN_LATCH_HOLD		0x2e
+#define GC2083_GAIN_LATCH_RELEASE	0x28
+
+/*
+ * Digital fine gain, Q6 (0x40 = 1.00x). The integer part goes to 0x00b1 and the
+ * six fraction bits to 0x00b2, left-aligned into bits 7:2 - the fraction
+ * register is not a bare Q6 remainder. See gc2083_set_gain().
+ */
+#define GC2083_REG_DGAIN_INT		CCI_REG8(0x00b1)
+#define GC2083_REG_DGAIN_FRAC		CCI_REG8(0x00b2)
+#define GC2083_DGAIN_FRAC_SHIFT		2
+
+/*
+ * Mirror and flip. Written to two registers, both of which the vendor updates
+ * together; 0x0d15 appears to be the shadow the sensor actually latches.
+ */
+#define GC2083_REG_FLIP			CCI_REG8(0x0015)
+#define GC2083_REG_FLIP_SHADOW		CCI_REG8(0x0d15)
+#define GC2083_FLIP_H			BIT(0)
+#define GC2083_FLIP_V			BIT(1)
+
+/* MIPI output on/off, the last step of stream on and the first of stream off */
+#define GC2083_REG_STREAM		CCI_REG8(0x023e)
+#define GC2083_STREAM_ON		0x99
+#define GC2083_STREAM_OFF		0x00
+
+/* Registers touched by the vendor's standby sequence. */
+#define GC2083_REG_MIPI_EN		CCI_REG8(0x003e)
+#define GC2083_REG_PLL_CTRL		CCI_REG8(0x03f7)
+#define GC2083_REG_PLL_MODE		CCI_REG8(0x03f9)
+#define GC2083_REG_PWR_CTRL		CCI_REG8(0x03fc)
+
+#define GC2083_NATIVE_WIDTH		1920
+#define GC2083_NATIVE_HEIGHT		1080
+
+#define GC2083_DATA_LANES		2
+#define GC2083_RGB_DEPTH		10
+
+/*
+ * The PLL multiplies the input clock by 50 (0x03f8 = 0x32): 1200MHz from
+ * 24MHz. The MIPI lanes run at 5/12 of that, 500Mbit/s each, so a 250MHz DDR
+ * link clock, and the pixel clock is 100MHz. A line is 2 * 0x05c9 = 2962
+ * pixel clocks, so 1125 lines make 30fps. The Milk-V Duo S can only produce
+ * 23.76MHz, which gives a 1188MHz PLL, 495Mbit/s per lane and 29.7fps: the
+ * rates that Ingenic's driver documents for its 27MHz table with a multiplier
+ * of 44. The two arrays below are indexed together.
+ */
+static const unsigned long gc2083_xclk_freqs[] = {
+	23760000,
+	24000000,
+};
+
+static const s64 gc2083_link_freq_menu[] = {
+	247500000,
+	250000000,
+};
+
+#define GC2083_SLEEP_US			(2 * USEC_PER_MSEC)
+/* The vendor waits this long after the init table before doing anything else. */
+#define GC2083_INIT_SETTLE_US		(80 * USEC_PER_MSEC)
+
+static const char * const gc2083_supply_names[] = {
+	"avdd",		/* analogue */
+	"dvdd",		/* digital core */
+	"dovdd",	/* digital I/O */
+};
+
+/*
+ * 1920x1080 30fps, 10-bit, 2 lanes. Verbatim from the vendor's
+ * gc2083_linear_1080p30_init(), minus the exposure, gain and frame-length
+ * writes at the end of it, which V4L2 controls own instead, and minus its
+ * last write, 0x023e = 0x99, which turns the MIPI output on:
+ * gc2083_start_streaming() writes that after the controls.
+ *
+ * The first four writes are the documented soft reset: 0x03fe is poked with
+ * 0xf0 three times and then cleared.
+ */
