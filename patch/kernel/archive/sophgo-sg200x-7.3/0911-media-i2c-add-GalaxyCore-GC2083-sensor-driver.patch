+	{ 1293, { 0x14, 0x01, 0x13, 0x04, 0x19, 0x16, 0x16, 0x16, 0x16, 0x6f, 0x6f, 0x6f, 0x6f } },
+	{ 1541, { 0x24, 0x01, 0x16, 0x1a, 0x19, 0x16, 0x16, 0x16, 0x16, 0x6f, 0x6f, 0x6f, 0x6f } },
+	{ 1849, { 0x34, 0x01, 0x1a, 0x2b, 0x19, 0x16, 0x16, 0x16, 0x16, 0x6f, 0x6f, 0x6f, 0x6f } },
+	{ 2177, { 0x44, 0x01, 0x20, 0x00, 0x36, 0x18, 0x18, 0x18, 0x18, 0x6f, 0x6f, 0x6f, 0x6f } },
+	{ 2612, { 0x54, 0x01, 0x26, 0x07, 0x36, 0x18, 0x18, 0x18, 0x18, 0x6f, 0x6f, 0x6f, 0x6f } },
+	{ 3136, { 0x64, 0x01, 0x2c, 0x33, 0x36, 0x18, 0x18, 0x18, 0x18, 0x6f, 0x6f, 0x6f, 0x6f } },
+	{ 3764, { 0x74, 0x01, 0x35, 0x17, 0x36, 0x18, 0x18, 0x18, 0x18, 0x6f, 0x6f, 0x6f, 0x6f } },
+	{ 4504, { 0x84, 0x01, 0x35, 0x17, 0x64, 0x16, 0x16, 0x16, 0x16, 0x72, 0x72, 0x72, 0x72 } },
+	{ 5376, { 0x94, 0x01, 0x35, 0x17, 0x64, 0x16, 0x16, 0x16, 0x16, 0x72, 0x72, 0x72, 0x72 } },
+	{ 6656, { 0x85, 0x01, 0x35, 0x17, 0x64, 0x16, 0x16, 0x16, 0x16, 0x72, 0x72, 0x72, 0x72 } },
+	{ 7988, { 0x95, 0x01, 0x35, 0x17, 0x64, 0x16, 0x16, 0x16, 0x16, 0x72, 0x72, 0x72, 0x72 } },
+	{ 9474, { 0xa5, 0x01, 0x35, 0x17, 0x64, 0x16, 0x16, 0x16, 0x16, 0x72, 0x72, 0x72, 0x72 } },
+};
+
+#define GC2083_AGAIN_MIN	(gc2083_again_table[0].gain)
+#define GC2083_AGAIN_MAX	(gc2083_again_table[ARRAY_SIZE(gc2083_again_table) - 1].gain)
+#define GC2083_AGAIN_STEP	1
+
+/* Digital fine gain is Q6 as well, and never has to reach the next step. */
+#define GC2083_DGAIN_UNITY	64
+
+struct gc2083_mode {
+	u32 width;
+	u32 height;
+	u32 hts;
+	u32 vts_def;
+	u32 vts_min;
+	const struct cci_reg_sequence *regs;
+	unsigned int num_regs;
+};
+
+static const struct gc2083_mode gc2083_modes[] = {
+	{
+		.width = GC2083_NATIVE_WIDTH,
+		.height = GC2083_NATIVE_HEIGHT,
+		.hts = 2962,
+		.vts_def = 1125,
+		.vts_min = 1125,
+		.regs = gc2083_1080p_regs,
+		.num_regs = ARRAY_SIZE(gc2083_1080p_regs),
+	},
+};
+
+/*
+ * Bayer order with neither flip applied is RGGB - that is what Sophgo's own
+ * per-sensor table in the SDK says for GCORE_GC2083_MIPI_2M_30FPS_10BIT.
+ * Mirroring shifts the window by a column and flipping by a row, so the order
+ * changes with the flip controls; index this with hflip | (vflip << 1).
+ */
+static const u32 gc2083_mbus_codes[] = {
+	MEDIA_BUS_FMT_SRGGB10_1X10,
+	MEDIA_BUS_FMT_SGRBG10_1X10,
+	MEDIA_BUS_FMT_SGBRG10_1X10,
+	MEDIA_BUS_FMT_SBGGR10_1X10,
+};
+
+struct gc2083 {
+	struct device *dev;
+	struct regmap *regmap;
+	struct clk *xclk;
+	struct gpio_desc *reset_gpio;
+	struct regulator_bulk_data supplies[ARRAY_SIZE(gc2083_supply_names)];
+
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+
+	struct v4l2_ctrl_handler ctrls;
+	struct v4l2_ctrl *exposure;
+	struct v4l2_ctrl *again;
+	struct v4l2_ctrl *hblank;
+	struct v4l2_ctrl *vblank;
+	struct v4l2_ctrl *hflip;
+	struct v4l2_ctrl *vflip;
+	struct v4l2_ctrl *link_freq;
+	struct v4l2_ctrl *pixel_rate;
+
+	const struct gc2083_mode *cur_mode;
+	unsigned long link_freq_bitmap;
+	unsigned int link_freq_index;
+	bool identified;
+};
+
+static inline struct gc2083 *to_gc2083(struct v4l2_subdev *sd)
+{
+	return container_of(sd, struct gc2083, sd);
+}
+
+static u32 gc2083_get_mbus_code(struct gc2083 *gc2083)
+{
+	unsigned int i = 0;
+
+	if (gc2083->hflip && gc2083->hflip->val)
+		i |= BIT(0);
+	if (gc2083->vflip && gc2083->vflip->val)
+		i |= BIT(1);
+
+	return gc2083_mbus_codes[i];
+}
+
+static int gc2083_power_on(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct gc2083 *gc2083 = to_gc2083(sd);
+	int ret;
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(gc2083_supply_names),
+				    gc2083->supplies);
+	if (ret < 0) {
+		dev_err(dev, "failed to enable regulators: %d\n", ret);
+		return ret;
+	}
+
+	ret = clk_prepare_enable(gc2083->xclk);
+	if (ret < 0) {
+		dev_err(dev, "failed to enable xclk: %d\n", ret);
+		regulator_bulk_disable(ARRAY_SIZE(gc2083_supply_names),
+				       gc2083->supplies);
+		return ret;
+	}
+
+	/* The sensor needs MCLK before it will come out of reset. */
+	fsleep(GC2083_SLEEP_US);
+	gpiod_set_value_cansleep(gc2083->reset_gpio, 0);
+	fsleep(GC2083_SLEEP_US);
+
+	return 0;
+}
+
+static int gc2083_power_off(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct gc2083 *gc2083 = to_gc2083(sd);
+
+	gpiod_set_value_cansleep(gc2083->reset_gpio, 1);
+	clk_disable_unprepare(gc2083->xclk);
+	regulator_bulk_disable(ARRAY_SIZE(gc2083_supply_names),
+			       gc2083->supplies);
+
+	return 0;
+}
+
+static int gc2083_identify_module(struct gc2083 *gc2083)
+{
+	u64 val;
+	int ret;
+
+	if (gc2083->identified)
+		return 0;
+
+	ret = cci_read(gc2083->regmap, GC2083_REG_CHIP_ID, &val, NULL);
+	if (ret)
+		return ret;
+
+	if (val != GC2083_CHIP_ID) {
+		dev_err(gc2083->dev, "chip id mismatch: expected 0x%04x, got 0x%04llx\n",
+			GC2083_CHIP_ID, val);
+		return -ENXIO;
+	}
+
+	gc2083->identified = true;
+
+	return 0;
+}
+
+/*
+ * Program one rung of the analogue gain ladder. The vendor's write order is
+ * reproduced exactly, including the 0x031d hold/release either side of the
+ * 0x0dc1 write; the sensor is not documented, so there is no way to tell which
+ * parts of that ordering matter.
+ */
+static int gc2083_write_again(struct gc2083 *gc2083, unsigned int idx)
+{
+	const u8 *v = gc2083_again_table[idx].regs;
+	unsigned int i;
+	int ret = 0;
+
+	cci_write(gc2083->regmap, GC2083_REG_AGAIN_LOW, v[0], &ret);
+	cci_write(gc2083->regmap, GC2083_REG_GAIN_LATCH,
+		  GC2083_GAIN_LATCH_HOLD, &ret);
+	cci_write(gc2083->regmap, GC2083_REG_AGAIN_HIGH, v[1], &ret);
+	cci_write(gc2083->regmap, GC2083_REG_GAIN_LATCH,
+		  GC2083_GAIN_LATCH_RELEASE, &ret);
+
+	for (i = 2; i < GC2083_AGAIN_NUM_REGS; i++)
+		cci_write(gc2083->regmap, gc2083_again_regs[i], v[i], &ret);
+
+	return ret;
+}
+
+/*
+ * @gain is Q6, so 64 is 1.00x. Pick the highest analogue step that does not
+ * overshoot, then trim the rest in digital gain.
+ */
+static int gc2083_set_gain(struct gc2083 *gc2083, u32 gain)
+{
+	unsigned int idx = ARRAY_SIZE(gc2083_again_table) - 1;
+	unsigned int dgain;
+	unsigned int i;
+	int ret;
+
+	for (i = 1; i < ARRAY_SIZE(gc2083_again_table); i++) {
+		if (gain < gc2083_again_table[i].gain) {
+			idx = i - 1;
+			break;
+		}
+	}
+
+	ret = gc2083_write_again(gc2083, idx);
+	if (ret)
+		return ret;
+
+	dgain = gain * GC2083_DGAIN_UNITY / gc2083_again_table[idx].gain;
+
+	/*
+	 * The fraction is left-aligned in its register, exactly as the vendor's
+	 * cmos_gains_update() writes it: (dgain & 0x3f) << 2.
+	 */
+	cci_write(gc2083->regmap, GC2083_REG_DGAIN_INT,
+		  dgain / GC2083_DGAIN_UNITY, &ret);
+	cci_write(gc2083->regmap, GC2083_REG_DGAIN_FRAC,
+		  (dgain % GC2083_DGAIN_UNITY) << GC2083_DGAIN_FRAC_SHIFT,
+		  &ret);
+
+	return ret;
+}
+
+static int gc2083_set_flip(struct gc2083 *gc2083)
+{
+	u8 val = 0;
+	int ret = 0;
+
+	if (gc2083->hflip->val)
+		val |= GC2083_FLIP_H;
+	if (gc2083->vflip->val)
+		val |= GC2083_FLIP_V;
+
+	cci_write(gc2083->regmap, GC2083_REG_FLIP, val, &ret);
+	cci_write(gc2083->regmap, GC2083_REG_FLIP_SHADOW, val, &ret);
+
+	return ret;
+}
+
+static int gc2083_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct gc2083 *gc2083 = container_of(ctrl->handler, struct gc2083, ctrls);
+	struct v4l2_subdev_state *state;
+	struct v4l2_mbus_framefmt *format;
+	s64 exposure_max;
+	int ret = 0;
+
+	/*
+	 * The handler lock is the subdev state lock (see gc2083_probe()), so the
+	 * active state is held for us here and can be read and updated directly.
+	 */
+	state = v4l2_subdev_get_locked_active_state(&gc2083->sd);
+	format = v4l2_subdev_state_get_format(state, 0);
+
+	switch (ctrl->id) {
+	case V4L2_CID_VBLANK:
+		/* Exposure has to stay inside the new frame length. */
+		exposure_max = format->height + ctrl->val -
+			       GC2083_EXPOSURE_MARGIN;
+		ret = __v4l2_ctrl_modify_range(gc2083->exposure,
+					       gc2083->exposure->minimum,
+					       exposure_max,
+					       gc2083->exposure->step,
+					       min(gc2083->exposure->val,
+						   exposure_max));
+		if (ret)
+			return ret;
+		break;
+	case V4L2_CID_HFLIP:
+	case V4L2_CID_VFLIP:
+		/*
+		 * Both flips move the Bayer phase, so the media code changes.
+		 * The flips are grabbed while streaming, so this runs only
+		 * while stopped; updating the active format here keeps
+		 * get_fmt() in step with them without a set_fmt() round trip.
+		 */
+		format->code = gc2083_get_mbus_code(gc2083);
+		break;
+	default:
+		break;
+	}
+
+	/*
+	 * Only touch the sensor when it is powered up. Anything set while it is
+	 * suspended is applied by the __v4l2_ctrl_handler_setup() in
+	 * gc2083_start_streaming().
+	 */
+	if (!pm_runtime_get_if_active(gc2083->dev))
+		return 0;
+
+	switch (ctrl->id) {
+	case V4L2_CID_EXPOSURE:
+		cci_write(gc2083->regmap, GC2083_REG_EXPOSURE,
+			  ctrl->val & GC2083_EXPOSURE_MASK, &ret);
+		break;
+	case V4L2_CID_ANALOGUE_GAIN:
+		ret = gc2083_set_gain(gc2083, ctrl->val);
+		break;
+	case V4L2_CID_VBLANK:
+		cci_write(gc2083->regmap, GC2083_REG_VTS,
+			  format->height + ctrl->val, &ret);
+		break;
+	case V4L2_CID_HFLIP:
+	case V4L2_CID_VFLIP:
+		ret = gc2083_set_flip(gc2083);
+		break;
+	default:
+		break;
+	}
+
+	pm_runtime_put_autosuspend(gc2083->dev);
+
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops gc2083_ctrl_ops = {
+	.s_ctrl = gc2083_set_ctrl,
+};
+
+static int gc2083_enum_mbus_code(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_mbus_code_enum *code)
+{
+	struct gc2083 *gc2083 = to_gc2083(sd);
+
+	if (code->index > 0)
+		return -EINVAL;
+
+	code->code = gc2083_get_mbus_code(gc2083);
+
+	return 0;
+}
+
+static int gc2083_enum_frame_size(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state,
+				  struct v4l2_subdev_frame_size_enum *fse)
+{
+	struct gc2083 *gc2083 = to_gc2083(sd);
+
+	if (fse->index >= ARRAY_SIZE(gc2083_modes))
+		return -EINVAL;
+
+	if (fse->code != gc2083_get_mbus_code(gc2083))
+		return -EINVAL;
+
+	fse->min_width = gc2083_modes[fse->index].width;
+	fse->max_width = gc2083_modes[fse->index].width;
+	fse->min_height = gc2083_modes[fse->index].height;
+	fse->max_height = gc2083_modes[fse->index].height;
+
+	return 0;
+}
+
+static void gc2083_update_pad_format(struct gc2083 *gc2083,
+				     const struct gc2083_mode *mode,
+				     struct v4l2_mbus_framefmt *fmt)
+{
+	fmt->width = mode->width;
+	fmt->height = mode->height;
+	fmt->code = gc2083_get_mbus_code(gc2083);
+	fmt->field = V4L2_FIELD_NONE;
+	fmt->colorspace = V4L2_COLORSPACE_RAW;
+	fmt->ycbcr_enc = V4L2_MAP_YCBCR_ENC_DEFAULT(fmt->colorspace);
+	fmt->quantization = V4L2_QUANTIZATION_FULL_RANGE;
+	fmt->xfer_func = V4L2_XFER_FUNC_NONE;
+}
+
+static int gc2083_update_controls(struct gc2083 *gc2083,
+				  const struct gc2083_mode *mode)
+{
+	s64 exposure_max, hblank;
+	int ret;
+
+	ret = __v4l2_ctrl_modify_range(gc2083->vblank,
+				       mode->vts_min - mode->height,
+				       GC2083_VTS_MAX - mode->height, 1,
+				       mode->vts_def - mode->height);
+	if (ret)
+		return ret;
+
+	hblank = mode->hts - mode->width;
+	ret = __v4l2_ctrl_modify_range(gc2083->hblank, hblank, hblank, 1,
+				       hblank);
+	if (ret)
+		return ret;
+
+	exposure_max = mode->vts_def - GC2083_EXPOSURE_MARGIN;
+
+	return __v4l2_ctrl_modify_range(gc2083->exposure, GC2083_EXPOSURE_MIN,
+					exposure_max, GC2083_EXPOSURE_STEP,
+					exposure_max);
+}
+
+static int gc2083_set_format(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *state,
+			     struct v4l2_subdev_format *fmt)
+{
+	struct gc2083 *gc2083 = to_gc2083(sd);
+	struct v4l2_mbus_framefmt *mbus_fmt;
+	const struct gc2083_mode *mode;
+	struct v4l2_rect *crop;
+
+	mode = v4l2_find_nearest_size(gc2083_modes, ARRAY_SIZE(gc2083_modes),
+				      width, height, fmt->format.width,
+				      fmt->format.height);
+
+	crop = v4l2_subdev_state_get_crop(state, 0);
+	crop->left = 0;
+	crop->top = 0;
+	crop->width = mode->width;
+	crop->height = mode->height;
+
+	gc2083_update_pad_format(gc2083, mode, &fmt->format);
+	mbus_fmt = v4l2_subdev_state_get_format(state, 0);
+	*mbus_fmt = fmt->format;
+
+	if (fmt->which == V4L2_SUBDEV_FORMAT_TRY)
+		return 0;
+
+	gc2083->cur_mode = mode;
+
+	return gc2083_update_controls(gc2083, mode);
+}
+
+static int gc2083_get_selection(struct v4l2_subdev *sd,
+				struct v4l2_subdev_state *state,
+				struct v4l2_subdev_selection *sel)
+{
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP:
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+		sel->r = *v4l2_subdev_state_get_crop(state, 0);
+		break;
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+		sel->r.left = 0;
+		sel->r.top = 0;
+		sel->r.width = GC2083_NATIVE_WIDTH;
+		sel->r.height = GC2083_NATIVE_HEIGHT;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+static int gc2083_init_state(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *state)
+{
+	struct gc2083 *gc2083 = to_gc2083(sd);
+	struct v4l2_subdev_format fmt = {
+		.which = V4L2_SUBDEV_FORMAT_TRY,
+		.pad = 0,
+		.format = {
+			.code = gc2083_get_mbus_code(gc2083),
+			.width = gc2083_modes[0].width,
+			.height = gc2083_modes[0].height,
+		},
+	};
+
+	return gc2083_set_format(sd, state, &fmt);
+}
+
+static int gc2083_start_streaming(struct gc2083 *gc2083)
+{
+	const struct gc2083_mode *mode = gc2083->cur_mode;
+	int ret;
+
+	ret = pm_runtime_resume_and_get(gc2083->dev);
+	if (ret < 0)
+		return ret;
+
+	ret = gc2083_identify_module(gc2083);
+	if (ret)
+		goto err_rpm_put;
+
+	ret = cci_multi_reg_write(gc2083->regmap, mode->regs, mode->num_regs,
+				  NULL);
+	if (ret)
+		goto err_rpm_put;
+
+	ret = __v4l2_ctrl_handler_setup(&gc2083->ctrls);
+	if (ret) {
+		dev_err(gc2083->dev, "could not sync v4l2 controls: %d\n", ret);
+		goto err_rpm_put;
+	}
+
+	/*
+	 * The vendor's own settle delay, at the end of
+	 * gc2083_linear_1080p30_init() and after its equivalent of the control
+	 * sync above.
+	 */
+	fsleep(GC2083_INIT_SETTLE_US);
+
+	/*
+	 * Turn the MIPI output on only now, so that the first frame already has
+	 * the exposure, gain and flips set above.
+	 */
+	cci_write(gc2083->regmap, GC2083_REG_STREAM, GC2083_STREAM_ON, &ret);
+	if (ret)
+		goto err_rpm_put;
+
+	/* The flips change the Bayer order, so they must not move now. */
+	__v4l2_ctrl_grab(gc2083->hflip, true);
+	__v4l2_ctrl_grab(gc2083->vflip, true);
+
+	/*
+	 * That is the whole start sequence: in the vendor SDK gc2083_init()
+	 * calls gc2083_linear_1080p30_init() and nothing else.
+	 *
+	 * In particular the vendor's gc2083_restart() is not part of it.
+	 * cvi_sns_ctrl.h documents pfnRestart as "restart sensor from standby
+	 * mode", and the middleware only calls it out of
+	 * SAMPLE_COMM_VI_ResumeSensor(), paired with pfnStandby - it is a resume
+	 * path, not a start path. Its register values contradict the mode
+	 * table's: 0x03f7 0x11 against the table's 0x01, and 0x03f9 0x42 against
+	 * the table's 0x43. Applying it on a cold start leaves the sensor in
+	 * LP-11 idle, never transmitting.
+	 */
+
+	return 0;
+
+err_rpm_put:
+	pm_runtime_put_autosuspend(gc2083->dev);
+
+	return ret;
+}
+
+static int gc2083_stop_streaming(struct gc2083 *gc2083)
+{
+	int ret = 0;
+
+	__v4l2_ctrl_grab(gc2083->hflip, false);
+	__v4l2_ctrl_grab(gc2083->vflip, false);
+
+	/*
+	 * MIPI output off first, then the vendor's gc2083_standby().
+	 * cci_write() short-circuits once @ret is set, so the first failure
+	 * stops the sequence rather than hammering a bus that is not answering;
+	 * the sensor is powered down by runtime PM below in any case.
+	 */
+	cci_write(gc2083->regmap, GC2083_REG_STREAM, GC2083_STREAM_OFF, &ret);
+	cci_write(gc2083->regmap, GC2083_REG_MIPI_EN, 0x00, &ret);
+	cci_write(gc2083->regmap, GC2083_REG_PLL_CTRL, 0x00, &ret);
+	cci_write(gc2083->regmap, GC2083_REG_PWR_CTRL, 0x01, &ret);
+	cci_write(gc2083->regmap, GC2083_REG_PLL_MODE, 0x41, &ret);
+	if (ret)
+		dev_err(gc2083->dev, "failed to stop streaming: %d\n", ret);
+
+	pm_runtime_put_autosuspend(gc2083->dev);
+
+	return ret;
+}
+
+static int gc2083_s_stream(struct v4l2_subdev *sd, int enable)
+{
+	struct gc2083 *gc2083 = to_gc2083(sd);
+	struct v4l2_subdev_state *state;
+	int ret;
+
+	state = v4l2_subdev_lock_and_get_active_state(sd);
+
+	if (enable)
+		ret = gc2083_start_streaming(gc2083);
+	else
+		ret = gc2083_stop_streaming(gc2083);
+
+	v4l2_subdev_unlock_state(state);
+
+	return ret;
+}
+
+static const struct v4l2_subdev_video_ops gc2083_video_ops = {
+	.s_stream = gc2083_s_stream,
+};
+
+static const struct v4l2_subdev_pad_ops gc2083_pad_ops = {
+	.enum_mbus_code = gc2083_enum_mbus_code,
+	.enum_frame_size = gc2083_enum_frame_size,
+	.get_fmt = v4l2_subdev_get_fmt,
+	.set_fmt = gc2083_set_format,
+	.get_selection = gc2083_get_selection,
+};
+
+static const struct v4l2_subdev_ops gc2083_subdev_ops = {
+	.video = &gc2083_video_ops,
+	.pad = &gc2083_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops gc2083_internal_ops = {
+	.init_state = gc2083_init_state,
+};
+
+static int gc2083_get_regulators(struct gc2083 *gc2083)
+{
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(gc2083_supply_names); i++)
+		gc2083->supplies[i].supply = gc2083_supply_names[i];
+
+	return devm_regulator_bulk_get(gc2083->dev,
+				       ARRAY_SIZE(gc2083_supply_names),
+				       gc2083->supplies);
+}
+
+static int gc2083_parse_fwnode(struct gc2083 *gc2083)
+{
+	struct v4l2_fwnode_endpoint bus_cfg = {
+		.bus_type = V4L2_MBUS_CSI2_DPHY,
+	};
+	struct device *dev = gc2083->dev;
+	struct fwnode_handle *endpoint;
+	int ret;
+
+	endpoint = fwnode_graph_get_endpoint_by_id(dev_fwnode(dev), 0, 0,
+						   FWNODE_GRAPH_ENDPOINT_NEXT);
+	if (!endpoint)
+		return dev_err_probe(dev, -EINVAL, "missing endpoint node\n");
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(endpoint, &bus_cfg);
+	if (ret) {
+		dev_err_probe(dev, ret, "failed to parse endpoint\n");
+		goto done;
+	}
+
+	if (bus_cfg.bus.mipi_csi2.num_data_lanes != GC2083_DATA_LANES) {
+		ret = dev_err_probe(dev, -EINVAL,
+				    "only %u data lanes are supported\n",
+				    GC2083_DATA_LANES);
+		goto done;
+	}
+
+	ret = v4l2_link_freq_to_bitmap(dev, bus_cfg.link_frequencies,
+				       bus_cfg.nr_of_link_frequencies,
+				       gc2083_link_freq_menu,
+				       ARRAY_SIZE(gc2083_link_freq_menu),
+				       &gc2083->link_freq_bitmap);
+
+done:
+	v4l2_fwnode_endpoint_free(&bus_cfg);
+	fwnode_handle_put(endpoint);
+
+	return ret;
+}
+
+static u64 gc2083_to_pixel_rate(unsigned int f_index)
+{
+	u64 pixel_rate = gc2083_link_freq_menu[f_index] * 2 * GC2083_DATA_LANES;
+
+	return div_u64(pixel_rate, GC2083_RGB_DEPTH);
+}
+
+static int gc2083_init_controls(struct gc2083 *gc2083)
+{
+	struct i2c_client *client = v4l2_get_subdevdata(&gc2083->sd);
+	const struct gc2083_mode *mode = &gc2083_modes[0];
+	struct v4l2_ctrl_handler *hdl = &gc2083->ctrls;
+	struct v4l2_fwnode_device_properties props;
+	s64 exposure_max, hblank;
+	int ret;
+
+	ret = v4l2_ctrl_handler_init(hdl, 10);
+	if (ret)
+		return ret;
+
+	gc2083->hflip = v4l2_ctrl_new_std(hdl, &gc2083_ctrl_ops,
+					  V4L2_CID_HFLIP, 0, 1, 1, 0);
+	gc2083->vflip = v4l2_ctrl_new_std(hdl, &gc2083_ctrl_ops,
+					  V4L2_CID_VFLIP, 0, 1, 1, 0);
+	/* Both change the Bayer order: gc2083_start_streaming() grabs them. */
+	if (gc2083->hflip)
+		gc2083->hflip->flags |= V4L2_CTRL_FLAG_MODIFY_LAYOUT;
+	if (gc2083->vflip)
+		gc2083->vflip->flags |= V4L2_CTRL_FLAG_MODIFY_LAYOUT;
+	v4l2_ctrl_cluster(2, &gc2083->hflip);
+
+	gc2083->link_freq =
+		v4l2_ctrl_new_int_menu(hdl, &gc2083_ctrl_ops,
+				       V4L2_CID_LINK_FREQ,
+				       ARRAY_SIZE(gc2083_link_freq_menu) - 1,
+				       gc2083->link_freq_index,
+				       gc2083_link_freq_menu);
+	if (gc2083->link_freq)
+		gc2083->link_freq->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	gc2083->pixel_rate =
+		v4l2_ctrl_new_std(hdl, &gc2083_ctrl_ops, V4L2_CID_PIXEL_RATE,
+				  gc2083_to_pixel_rate(gc2083->link_freq_index),
+				  gc2083_to_pixel_rate(gc2083->link_freq_index), 1,
+				  gc2083_to_pixel_rate(gc2083->link_freq_index));
+	if (gc2083->pixel_rate)
+		gc2083->pixel_rate->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	gc2083->vblank = v4l2_ctrl_new_std(hdl, &gc2083_ctrl_ops,
+					   V4L2_CID_VBLANK,
+					   mode->vts_min - mode->height,
+					   GC2083_VTS_MAX - mode->height, 1,
+					   mode->vts_def - mode->height);
+
+	hblank = mode->hts - mode->width;
+	gc2083->hblank = v4l2_ctrl_new_std(hdl, &gc2083_ctrl_ops,
+					   V4L2_CID_HBLANK, hblank, hblank, 1,
+					   hblank);
+	if (gc2083->hblank)
+		gc2083->hblank->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	gc2083->again = v4l2_ctrl_new_std(hdl, &gc2083_ctrl_ops,
+					  V4L2_CID_ANALOGUE_GAIN,
+					  GC2083_AGAIN_MIN, GC2083_AGAIN_MAX,
+					  GC2083_AGAIN_STEP, GC2083_AGAIN_MIN);
+
+	exposure_max = mode->vts_def - GC2083_EXPOSURE_MARGIN;
+	gc2083->exposure = v4l2_ctrl_new_std(hdl, &gc2083_ctrl_ops,
+					     V4L2_CID_EXPOSURE,
+					     GC2083_EXPOSURE_MIN, exposure_max,
+					     GC2083_EXPOSURE_STEP,
+					     exposure_max);
+
+	ret = v4l2_fwnode_device_parse(&client->dev, &props);
+	if (ret)
+		goto error;
+
+	ret = v4l2_ctrl_new_fwnode_properties(hdl, &gc2083_ctrl_ops, &props);
+	if (ret)
+		goto error;
+
+	if (hdl->error) {
+		ret = hdl->error;
+		goto error;
+	}
+
+	gc2083->sd.ctrl_handler = hdl;
+
+	return 0;
+
+error:
+	v4l2_ctrl_handler_free(hdl);
+
+	return ret;
+}
+
+static int gc2083_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct gc2083 *gc2083;
+	unsigned long rate;
+	unsigned int i;
+	int ret;
+
+	gc2083 = devm_kzalloc(dev, sizeof(*gc2083), GFP_KERNEL);
+	if (!gc2083)
+		return -ENOMEM;
+
+	gc2083->dev = dev;
+
+	ret = gc2083_parse_fwnode(gc2083);
+	if (ret)
+		return ret;
+
+	gc2083->regmap = devm_cci_regmap_init_i2c(client, 16);
+	if (IS_ERR(gc2083->regmap))
+		return dev_err_probe(dev, PTR_ERR(gc2083->regmap),
+				     "failed to init CCI\n");
+
+	gc2083->xclk = devm_v4l2_sensor_clk_get(dev, NULL);
+	if (IS_ERR(gc2083->xclk))
+		return dev_err_probe(dev, PTR_ERR(gc2083->xclk),
+				     "failed to get xclk\n");
+
+	/* The link frequency follows the input clock, see gc2083_xclk_freqs[] */
+	rate = clk_get_rate(gc2083->xclk);
+	for (i = 0; i < ARRAY_SIZE(gc2083_xclk_freqs); i++)
+		if (rate == gc2083_xclk_freqs[i])
+			break;
+	if (i == ARRAY_SIZE(gc2083_xclk_freqs))
+		return dev_err_probe(dev, -EINVAL, "unsupported xclk rate %lu Hz\n",
+				     rate);
+	if (!(gc2083->link_freq_bitmap & BIT(i)))
+		return dev_err_probe(dev, -EINVAL,
+				     "link-frequencies does not list %lld Hz for a %lu Hz xclk\n",
+				     gc2083_link_freq_menu[i], rate);
+	gc2083->link_freq_index = i;
+
+	ret = gc2083_get_regulators(gc2083);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get regulators\n");
+
+	/* Held asserted until the clock is running - see gc2083_power_on(). */
+	gc2083->reset_gpio = devm_gpiod_get_optional(dev, "reset",
+						     GPIOD_OUT_HIGH);
+	if (IS_ERR(gc2083->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(gc2083->reset_gpio),
+				     "failed to get reset gpio\n");
+
+	v4l2_i2c_subdev_init(&gc2083->sd, client, &gc2083_subdev_ops);
+	gc2083->sd.internal_ops = &gc2083_internal_ops;
+	gc2083->cur_mode = &gc2083_modes[0];
+
+	ret = gc2083_init_controls(gc2083);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to init controls\n");
+
+	gc2083->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	gc2083->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	gc2083->pad.flags = MEDIA_PAD_FL_SOURCE;
+
+	ret = media_entity_pads_init(&gc2083->sd.entity, 1, &gc2083->pad);
+	if (ret) {
+		dev_err_probe(dev, ret, "failed to init media entity\n");
+		goto err_ctrl_handler_free;
+	}
+
+	gc2083->sd.state_lock = gc2083->ctrls.lock;
+	ret = v4l2_subdev_init_finalize(&gc2083->sd);
+	if (ret) {
+		dev_err_probe(dev, ret, "failed to finalize subdev\n");
+		goto err_media_entity_cleanup;
+	}
+
+	/*
+	 * Identify the sensor now rather than at first stream: a wrong or
+	 * absent module should fail probe, not a capture attempt.
+	 */
+	ret = gc2083_power_on(dev);
+	if (ret)
+		goto err_subdev_cleanup;
+
+	ret = gc2083_identify_module(gc2083);
+	if (ret) {
+		dev_err_probe(dev, ret, "failed to identify sensor\n");
+		goto err_power_off;
+	}
+
+	pm_runtime_set_active(dev);
+	pm_runtime_enable(dev);
+	pm_runtime_set_autosuspend_delay(dev, 1000);
+	pm_runtime_use_autosuspend(dev);
+
+	ret = v4l2_async_register_subdev_sensor(&gc2083->sd);
+	if (ret) {
+		dev_err_probe(dev, ret, "failed to register subdev\n");
+		goto err_rpm_disable;
+	}
+
+	/*
+	 * The sensor is powered and marked active, and nothing below can fail:
+	 * hand it to runtime PM to be suspended after the autosuspend delay.
+	 * Doing this any earlier races the error path below, which powers the
+	 * sensor off itself and must not find that autosuspend got there first.
+	 */
+	pm_runtime_idle(dev);
+
+	return 0;
+
+err_rpm_disable:
+	pm_runtime_dont_use_autosuspend(dev);
+	pm_runtime_disable(dev);
+	pm_runtime_set_suspended(dev);
+
+err_power_off:
+	gc2083_power_off(dev);
+
+err_subdev_cleanup:
+	v4l2_subdev_cleanup(&gc2083->sd);
+
+err_media_entity_cleanup:
+	media_entity_cleanup(&gc2083->sd.entity);
+
+err_ctrl_handler_free:
+	v4l2_ctrl_handler_free(&gc2083->ctrls);
+
+	return ret;
+}
+
+static void gc2083_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct gc2083 *gc2083 = to_gc2083(sd);
+
+	v4l2_async_unregister_subdev(sd);
+	v4l2_subdev_cleanup(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(&gc2083->ctrls);
+
+	pm_runtime_dont_use_autosuspend(gc2083->dev);
+	pm_runtime_disable(gc2083->dev);
+	if (!pm_runtime_status_suspended(gc2083->dev))
+		gc2083_power_off(gc2083->dev);
+	pm_runtime_set_suspended(gc2083->dev);
+}
+
+static const struct of_device_id gc2083_of_match[] = {
+	{ .compatible = "galaxycore,gc2083" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, gc2083_of_match);
+
+static DEFINE_RUNTIME_DEV_PM_OPS(gc2083_pm_ops, gc2083_power_off,
+				 gc2083_power_on, NULL);
+
+static struct i2c_driver gc2083_i2c_driver = {
+	.driver = {
+		.name = "gc2083",
+		.of_match_table = gc2083_of_match,
+		.pm = pm_ptr(&gc2083_pm_ops),
+	},
+	.probe = gc2083_probe,
+	.remove = gc2083_remove,
+};
+module_i2c_driver(gc2083_i2c_driver);
+
+MODULE_DESCRIPTION("GalaxyCore GC2083 sensor driver");
