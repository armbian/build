+/*
+ * The 13 registers that together select an analogue gain step, in the order the
+ * vendor writes them. Indices 0 and 1 are handled separately in
+ * gc2083_write_again() because of the latch bracket between them.
+ */
+static const u32 gc2083_again_regs[] = {
+	CCI_REG8(0x00d0), CCI_REG8(0x0dc1), CCI_REG8(0x00b8), CCI_REG8(0x00b9),
+	CCI_REG8(0x0155), CCI_REG8(0x0410), CCI_REG8(0x0411), CCI_REG8(0x0412),
+	CCI_REG8(0x0413), CCI_REG8(0x0414), CCI_REG8(0x0415), CCI_REG8(0x0416),
+	CCI_REG8(0x0417),
+};
+
+#define GC2083_AGAIN_NUM_REGS ARRAY_SIZE(gc2083_again_regs)
+
+struct gc2083_again {
+	u32 gain;	/* Q6: 0x40 is 1.00x */
+	u8 regs[GC2083_AGAIN_NUM_REGS];
+};
+
+/*
+ * The analogue gain ladder. Steps are roughly 1.2x apart, which is too coarse
+ * to hand to an AE loop on its own, so gc2083_set_gain() picks the step at or
+ * below the requested gain and makes up the remainder in digital fine gain -
+ * the same thing the vendor's AE does. That is why there is one
+ * V4L2_CID_ANALOGUE_GAIN covering the whole 1x..148x range rather than a menu
+ * of 29 steps: the gain userspace asks for is the gain it gets.
+ */
