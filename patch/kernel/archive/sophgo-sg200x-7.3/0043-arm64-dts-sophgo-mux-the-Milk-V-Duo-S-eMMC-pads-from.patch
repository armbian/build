From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Lukasz Sobala <lsobala1@gmail.com>
Date: Thu, 30 Jul 2026 23:37:03 +0200
Subject: arm64: dts: sophgo: mux the Milk-V Duo S eMMC pads from the DT

The arm64 counterpart of 0042; the reasoning is there.
---
 arch/arm64/boot/dts/sophgo/sg2000-milkv-duo-s.dts | 82 +++++-----
 1 file changed, 49 insertions(+), 33 deletions(-)

diff --git a/arch/arm64/boot/dts/sophgo/sg2000-milkv-duo-s.dts b/arch/arm64/boot/dts/sophgo/sg2000-milkv-duo-s.dts
index 111111111111..222222222222 100644
--- a/arch/arm64/boot/dts/sophgo/sg2000-milkv-duo-s.dts
+++ b/arch/arm64/boot/dts/sophgo/sg2000-milkv-duo-s.dts
@@ -119,39 +119,6 @@ &osc {
 };
 
 &pinctrl {
-	emmc_cfg: emmc-cfg {
-		emmc-rstn-pins {
-			pinmux = <PINMUX(PIN_EMMC_RSTN, 0)>;
-			bias-pull-up;
-			drive-strength-microamp = <10800>;
-			power-source = <1800>;
-		};
-
-		emmc-clk-pins {
-			pinmux = <PINMUX(PIN_EMMC_CLK, 0)>;
-			bias-pull-up;
-			drive-strength-microamp = <10800>;
-			power-source = <1800>;
-		};
-
-		emmc-cmd-pins {
-			pinmux = <PINMUX(PIN_EMMC_CMD, 0)>;
-			bias-pull-up;
-			drive-strength-microamp = <10800>;
-			power-source = <1800>;
-		};
-
-		emmc-data-pins {
-			pinmux = <PINMUX(PIN_EMMC_DAT0, 0)>,
-				 <PINMUX(PIN_EMMC_DAT1, 0)>,
-				 <PINMUX(PIN_EMMC_DAT2, 0)>,
-				 <PINMUX(PIN_EMMC_DAT3, 0)>;
-			bias-pull-up;
-			drive-strength-microamp = <10800>;
-			power-source = <1800>;
-		};
-	};
-
 	i2c4_cfg: i2c4-cfg {
 		i2c4-pins {
 			pinmux = <PINMUX(PIN_VIVO_D1, 7)>,
@@ -257,9 +224,58 @@ &efuse {
 	status = "okay";
 };
 
+/*
+ * Route the eMMC pads ourselves instead of inheriting them. The vendor U-Boot
+ * only muxes this group when it was built for eMMC storage
+ * (board/cvitek/cv181x/board.c, guarded by CONFIG_EMMC_SUPPORT), and the same
+ * seven pads are shared with SPI-NAND and SPI-NOR. So after booting the SD build
+ * of the bootloader they are left in whatever the BootROM set, and Linux cannot
+ * talk to the eMMC: "mmc2: Failed to initialize a non-removable card".
+ *
+ * Mux and power-source only. PINMUX_CONFIG() in the vendor bootloader sets the
+ * function select and nothing else, and the eMMC works with those defaults when
+ * it is the boot device - but power-source is not optional here:
+ * cv1800_dt_node_to_map_post() rejects any group without it, which fails the
+ * consumer's probe outright.
+ *
+ * power-source is 3300 because VDDIO_EMMC is the 3.3V rail on this board: the
+ * domain also holds UART0_TX/RX, the console on header pins 8 and 10, along
+ * with AUX0, SD0_CD, SD0_PWR_EN and the JTAG_CPU pads. cv1800_set_power_cfg()
+ * keeps one value per domain - the first group to probe sets it, and any later
+ * group that disagrees fails its pin map and never probes, silently. Mainline
+ * declares this group 1800 and uart0 3300, so there uart0 wins and the eMMC is
+ * simply gone.
+ *
+ * no-1-8-v stays. Dropping it and asking for mmc-hs200-1_8v was tried on a Duo
+ * S with the eMMC fitted, and the card then never enumerates at all: the
+ * controller registers and no card line ever follows, which is the non-graceful
+ * failure mmc_select_hs200() has when the voltage switch does not take - as it
+ * cannot, on pads powered from a 3.3V rail. High speed on a 4-bit bus it is.
+ * mmc-ddr-1_8v on its own is untried, and would need 1.8V I/O just the same.
+ *
+ * max-frequency matches the vendor DTS. It is inert while no-1-8-v holds the
+ * card at high speed - the clock is set from ext_csd.hs_max_dtr either way -
+ * and is here because it was in the tree that was booted and verified.
+ */
+&pinctrl {
+	emmc_cfg: emmc-cfg {
+		emmc-pins {
+			pinmux = <PINMUX(PIN_EMMC_CLK, 0)>,
+				 <PINMUX(PIN_EMMC_CMD, 0)>,
+				 <PINMUX(PIN_EMMC_DAT0, 0)>,
+				 <PINMUX(PIN_EMMC_DAT1, 0)>,
+				 <PINMUX(PIN_EMMC_DAT2, 0)>,
+				 <PINMUX(PIN_EMMC_DAT3, 0)>,
+				 <PINMUX(PIN_EMMC_RSTN, 0)>;
+			power-source = <3300>;
+		};
+	};
+};
+
 &emmc {
 	bus-width = <4>;
 	no-1-8-v;
+	max-frequency = <200000000>;
 	cap-mmc-hw-reset;
 	no-sd;
 	no-sdio;
-- 
Armbian

