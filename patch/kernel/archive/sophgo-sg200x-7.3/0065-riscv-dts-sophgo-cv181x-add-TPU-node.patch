From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: morikon <leafpmpmp@gmail.com>
Date: Thu, 17 Sep 2026 10:08:27 +0000
Subject: riscv: dts: sophgo: cv181x: add TPU node

Add the tensor processing unit of CV181x-family SoCs (8-lane TIU +
TDMA). Registers, clocks, resets and interrupt numbers follow the
vendor devicetree from duo-buildroot-sdk-v2; the clock and reset IDs
already exist in the mainline sg2000 clk driver and cv18xx-reset.h.

Signed-off-by: morikon <leafpmpmp@gmail.com>
---
 arch/riscv/boot/dts/sophgo/cv181x.dtsi | 17 ++++++++++
 1 file changed, 17 insertions(+)

diff --git a/arch/riscv/boot/dts/sophgo/cv181x.dtsi b/arch/riscv/boot/dts/sophgo/cv181x.dtsi
index 111111111111..222222222222 100644
--- a/arch/riscv/boot/dts/sophgo/cv181x.dtsi
+++ b/arch/riscv/boot/dts/sophgo/cv181x.dtsi
@@ -17,5 +17,22 @@ emmc: mmc@4300000 {
 			clock-names = "core", "bus";
 			status = "disabled";
 		};
+
+		tpu: tpu@c100000 {
+			compatible = "cvitek,tpu";
+			reg = <0x0c100000 0x1000>,
+			      <0x0c101000 0x1000>;
+			reg-names = "tdma", "tiu";
+			clocks = <&clk CLK_TPU>,
+				 <&clk CLK_TPU_FAB>;
+			clock-names = "clk_tpu_axi", "clk_tpu_fab";
+			resets = <&rst RST_TDMA>,
+				 <&rst RST_TPU>,
+				 <&rst RST_TPUSYS>;
+			reset-names = "res_tdma", "res_tpu", "res_tpusys";
+			interrupts = <SOC_PERIPHERAL_IRQ(59) IRQ_TYPE_LEVEL_HIGH>,
+				     <SOC_PERIPHERAL_IRQ(60) IRQ_TYPE_LEVEL_HIGH>;
+			interrupt-names = "tiu_irq", "tdma_irq";
+		};
 	};
 };
-- 
Armbian

