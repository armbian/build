From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Lukasz Sobala <lsobala1@gmail.com>
Date: Fri, 16 Oct 2026 02:49:54 +0200
Subject: [PATCH 921/922] riscv: dts: sophgo: add the SG2000 H.264 encoder
 overlay

Add an overlay for the CODA980 H.264 encoder of the SG2000. It uses
overlays=video-codec.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/riscv/boot/dts/sophgo/Makefile           |  5 +++
 .../sophgo/overlay/sg2000-video-codec.dtso    | 39 +++++++++++++++++++
 2 files changed, 44 insertions(+)
 create mode 100644 arch/riscv/boot/dts/sophgo/overlay/sg2000-video-codec.dtso

diff --git a/arch/riscv/boot/dts/sophgo/Makefile b/arch/riscv/boot/dts/sophgo/Makefile
index 38535ae..9a3614a 100644
--- a/arch/riscv/boot/dts/sophgo/Makefile
+++ b/arch/riscv/boot/dts/sophgo/Makefile
@@ -53,3 +53,8 @@ dtb-$(CONFIG_ARCH_SOPHGO) += overlay/sg2000-uart1.dtbo
 dtb-$(CONFIG_ARCH_SOPHGO) += overlay/sg2000-uart2.dtbo
 dtb-$(CONFIG_ARCH_SOPHGO) += overlay/sg2000-pwm0.dtbo
 dtb-$(CONFIG_ARCH_SOPHGO) += overlay/sg2000-pwm1.dtbo
+
+# The SG2000 H.264 encoder overlay
+sg2000-milkv-duo-s-video-codec-dtbs := sg2000-milkv-duo-s.dtb overlay/sg2000-video-codec.dtbo
+dtb-$(CONFIG_ARCH_SOPHGO) += sg2000-milkv-duo-s-video-codec.dtb
+dtb-$(CONFIG_ARCH_SOPHGO) += overlay/sg2000-video-codec.dtbo
diff --git a/arch/riscv/boot/dts/sophgo/overlay/sg2000-video-codec.dtso b/arch/riscv/boot/dts/sophgo/overlay/sg2000-video-codec.dtso
new file mode 100644
index 0000000..8936f73
--- /dev/null
+++ b/arch/riscv/boot/dts/sophgo/overlay/sg2000-video-codec.dtso
@@ -0,0 +1,39 @@
+// SPDX-License-Identifier: (GPL-2.0 OR MIT)
+/*
+ * The SG2000 H.264 encoder, a Chips&Media CODA980.
+ *
+ * Enable with overlays=video-codec in /boot/armbianEnv.txt. The driver loads
+ * the vendor firmware from /lib/firmware/coda980.bin.
+ *
+ * The H.265 encoder (WAVE420L) and the JPEG codec are not in this overlay.
+ */
+/dts-v1/;
+/plugin/;
+
+#include <dt-bindings/clock/sophgo,cv1800.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+
+/* The arm64 overlay defines these first, for the GIC */
+#ifndef SOC_PERIPHERAL_IRQ
+#define SOC_PERIPHERAL_IRQ(nr)	((nr) + 16)
+#define SOC_INTC		&plic
+#endif
+
+&{/soc} {
+	#address-cells = <1>;
+	#size-cells = <1>;
+
+	video-codec@b010000 {
+		compatible = "sophgo,sg2000-vpu";
+		/* The CODA980, and the control block that the codecs share */
+		reg = <0x0b010000 0x10000>, <0x0b030000 0x100>;
+		reg-names = "bit", "ctrl";
+		interrupt-parent = <SOC_INTC>;
+		interrupts = <SOC_PERIPHERAL_IRQ(5) IRQ_TYPE_LEVEL_HIGH>;
+		interrupt-names = "bit";
+		clocks = <&clk CLK_H264C>, <&clk CLK_APB_H264C>,
+			 <&clk CLK_AXI_VIDEO_CODEC>, <&clk CLK_VC_SRC0>,
+			 <&clk CLK_CFG_REG_VC>;
+		clock-names = "per", "ahb", "axi", "src", "cfg";
+	};
+};
