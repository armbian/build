From: morikon <leafpmpmp@gmail.com>
Date: Tue, 13 Oct 2026 14:00:00 +0800
Subject: media: i2c: imx708: power the sensor off when streaming stops

A restart from software standby stalls the sensor. MODE_SELECT reads
back as streaming, but the frame counter stops. Power the sensor off as
soon as streaming stops, so that each start programs it from scratch.
The Raspberry Pi kernel does the same.
---
 drivers/media/i2c/imx708.c | 12 ++++++++++--
 1 file changed, 10 insertions(+), 2 deletions(-)

diff --git a/drivers/media/i2c/imx708.c b/drivers/media/i2c/imx708.c
index 111111111111..222222222222 100644
--- a/drivers/media/i2c/imx708.c
+++ b/drivers/media/i2c/imx708.c
@@ -932,7 +932,8 @@ static int imx708_disable_streams(struct v4l2_subdev *sd,
 	__v4l2_ctrl_grab(imx708->vflip, false);
 	__v4l2_ctrl_grab(imx708->hflip, false);
 
-	pm_runtime_put_autosuspend(&client->dev);
+	/* Power off now: a start before an async suspend runs would cancel it */
+	pm_runtime_put_sync_autosuspend(&client->dev);
 
 	return ret;
 }
@@ -1437,7 +1438,14 @@ static int imx708_probe(struct i2c_client *client)
 	}
 
 	pm_runtime_idle(dev);
-	pm_runtime_set_autosuspend_delay(dev, 5000);
+	/*
+	 * Restarting from software standby stalls the sensor: mode select
+	 * reads back as streaming but the frame counter stops, whether or not
+	 * the PLL is reprogrammed. Power it off as soon as it stops streaming,
+	 * so that every start programs it from scratch, as on the Raspberry Pi
+	 * kernel.
+	 */
+	pm_runtime_set_autosuspend_delay(dev, 0);
 	pm_runtime_use_autosuspend(dev);
 
 	return 0;
