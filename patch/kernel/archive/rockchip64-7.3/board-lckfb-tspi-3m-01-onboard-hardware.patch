From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jiaxing Hu <gahing@gahingwoo.com>
Date: Tue, 10 Nov 2026 20:30:00 +1300
Subject: arm64: dts: rockchip: lckfb-tspi-3m: enable GPU, NPU, fan, audio,
 USB-A power, DP and the mini-PCIe slot

The upstream device tree for the LCKFB TaishanPi 3M covers power, storage,
Ethernet, WiFi/Bluetooth, USB and HDMI. Add the rest of the on-board
hardware that mainline has drivers for:

- Mali-G52 GPU (panfrost) and the NPU cores (rocket)
- PWM fan on pwm2_8ch_3 with active trips on the package thermal zone
- ES8388 codec on I2C3/SAI1: headphones with jack detection and amplifier
  enable, onboard microphone on LINPUT2, headset microphone on RINPUT
- mini-PCIe slot: keep its 3.3 V supply on and release its reset line, so
  an EC20 4G module powers up
- USB-A ports: keep both VBUS supplies on. The usb-a-connector nodes name
  them, but nothing enables them, so the ports have no power
- I2C0 (touch controller of the MIPI DSI screen connector), enabled so the
  attached screen can be detected before its overlay is loaded
- DisplayPort alt mode on the USB-C port (DP controller on VP1)

Wiring is taken from LCKFB's vendor kernel device tree. Each item was
tested on the board with 7.3.3; DisplayPort with a 2560x1440@60 monitor
while the DSI screen was also active.

Signed-off-by: Jiaxing Hu <gahing@gahingwoo.com>
---
 arch/arm64/boot/dts/rockchip/rk3576-lckfb-tspi-3m.dts | 250 ++++++++++
 1 file changed, 250 insertions(+)

diff --git a/arch/arm64/boot/dts/rockchip/rk3576-lckfb-tspi-3m.dts b/arch/arm64/boot/dts/rockchip/rk3576-lckfb-tspi-3m.dts
index 111111111111..222222222222 100644
--- a/arch/arm64/boot/dts/rockchip/rk3576-lckfb-tspi-3m.dts
+++ b/arch/arm64/boot/dts/rockchip/rk3576-lckfb-tspi-3m.dts
@@ -649,6 +649,13 @@
 			power-role = "source";
 			source-pdos = <PDO_FIXED(5000, 500, PDO_FIXED_USB_COMM)>;
 
+			altmodes {
+				displayport {
+					svid = /bits/ 16 <0xff01>;
+					vdo = <0xffffffff>;
+				};
+			};
+
 			ports {
 				#address-cells = <1>;
 				#size-cells = <0>;
@@ -995,3 +1002,246 @@
 		remote-endpoint = <&hdmi_in_vp0>;
 	};
 };
+
+/* Armbian: hardware the upstream device tree does not describe yet */
+
+/ {
+	fan: pwm-fan {
+		compatible = "pwm-fan";
+		#cooling-cells = <2>;
+		cooling-levels = <0 100 150 200 255>;
+		fan-supply = <&vcc_5v0_sys>;
+		pwms = <&pwm2_8ch_3 0 500000 0>;
+	};
+
+	hp_amp: headphone-amplifier {
+		compatible = "simple-audio-amplifier";
+		enable-gpios = <&gpio4 RK_PB2 GPIO_ACTIVE_HIGH>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&hp_ctl>;
+		sound-name-prefix = "Headphone Amp";
+	};
+
+	es8388_sound: es8388-sound {
+		compatible = "simple-audio-card";
+		pinctrl-names = "default";
+		pinctrl-0 = <&hp_det>;
+		simple-audio-card,name = "rockchip-es8388";
+		simple-audio-card,format = "i2s";
+		simple-audio-card,mclk-fs = <256>;
+		simple-audio-card,aux-devs = <&hp_amp>;
+		simple-audio-card,hp-det-gpios = <&gpio4 RK_PB0 GPIO_ACTIVE_HIGH>;
+		simple-audio-card,routing =
+			"Headphones", "Headphone Amp OUTL",
+			"Headphones", "Headphone Amp OUTR",
+			"Headphone Amp INL", "LOUT1",
+			"Headphone Amp INR", "ROUT1",
+			"LINPUT1", "Onboard Microphone",
+			"LINPUT2", "Onboard Microphone",
+			"RINPUT1", "Headset Microphone",
+			"RINPUT2", "Headset Microphone";
+		simple-audio-card,widgets =
+			"Headphone", "Headphones",
+			"Microphone", "Onboard Microphone",
+			"Microphone", "Headset Microphone";
+
+		simple-audio-card,codec {
+			sound-dai = <&es8388>;
+			system-clock-frequency = <12288000>;
+		};
+
+		simple-audio-card,cpu {
+			sound-dai = <&sai1>;
+		};
+	};
+};
+
+/* DisplayPort alt mode on the USB-C port, through the USBDP PHY, on VP1 */
+&dp {
+	status = "okay";
+};
+
+&dp0_in {
+	dp0_in_vp1: endpoint {
+		remote-endpoint = <&vp1_out_dp0>;
+	};
+};
+
+/*
+ * Mini-PCIe slot reset (PERST#). Nothing drives it otherwise, and an EC20 4G
+ * module stays in reset until it is released.
+ */
+&gpio2 {
+	minipcie-reset-hog {
+		gpio-hog;
+		gpios = <RK_PB1 GPIO_ACTIVE_LOW>;
+		output-low;
+		line-name = "minipcie-reset";
+	};
+};
+
+&gpu {
+	mali-supply = <&vdd_gpu_s0>;
+	status = "okay";
+};
+
+/*
+ * I2C0 on i2c0m1 only reaches the touch controller on the MIPI DSI screen
+ * connector. Keep it enabled so userspace can probe which official screen is
+ * attached and pick the matching overlay.
+ */
+&i2c0 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&i2c0m1_xfer>;
+	clock-frequency = <400000>;
+	status = "okay";
+};
+
+&i2c3 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&i2c3m0_xfer>;
+	status = "okay";
+
+	es8388: audio-codec@11 {
+		compatible = "everest,es8388", "everest,es8328";
+		reg = <0x11>;
+		#sound-dai-cells = <0>;
+		clocks = <&cru CLK_SAI1_MCLKOUT_TO_IO>;
+		assigned-clocks = <&cru CLK_SAI1_MCLKOUT_TO_IO>;
+		assigned-clock-rates = <12288000>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&sai1m0_mclk>;
+		AVDD-supply = <&vcca_3v3_s0>;
+		DVDD-supply = <&vcc_3v3_s0>;
+		HPVDD-supply = <&vcca_3v3_s0>;
+		PVDD-supply = <&vcc_3v3_s0>;
+	};
+};
+
+&package_thermal {
+	polling-delay = <1000>;
+
+	trips {
+		package_fan0: package-fan0 {
+			temperature = <35000>;
+			hysteresis = <2000>;
+			type = "active";
+		};
+
+		package_fan1: package-fan1 {
+			temperature = <45000>;
+			hysteresis = <2000>;
+			type = "active";
+		};
+
+		package_fan2: package-fan2 {
+			temperature = <55000>;
+			hysteresis = <2000>;
+			type = "active";
+		};
+
+		package_fan3: package-fan3 {
+			temperature = <65000>;
+			hysteresis = <2000>;
+			type = "active";
+		};
+	};
+
+	cooling-maps {
+		map-fan0 {
+			trip = <&package_fan0>;
+			cooling-device = <&fan 1 1>;
+		};
+
+		map-fan1 {
+			trip = <&package_fan1>;
+			cooling-device = <&fan 2 2>;
+		};
+
+		map-fan2 {
+			trip = <&package_fan2>;
+			cooling-device = <&fan 3 3>;
+		};
+
+		map-fan3 {
+			trip = <&package_fan3>;
+			cooling-device = <&fan 4 4>;
+		};
+	};
+};
+
+&pd_npu {
+	domain-supply = <&vdd_npu_s0>;
+};
+
+&pinctrl {
+	headphone {
+		hp_det: hp-det {
+			rockchip,pins = <4 RK_PB0 RK_FUNC_GPIO &pcfg_pull_up>;
+		};
+
+		hp_ctl: hp-ctl {
+			rockchip,pins = <4 RK_PB2 RK_FUNC_GPIO &pcfg_pull_none>;
+		};
+	};
+};
+
+&pwm2_8ch_3 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pwm2m3_ch3>;
+	status = "okay";
+};
+
+&rknn_core_0 {
+	npu-supply = <&vdd_npu_s0>;
+	status = "okay";
+};
+
+&rknn_core_1 {
+	npu-supply = <&vdd_npu_s0>;
+	status = "okay";
+};
+
+&rknn_mmu_0 {
+	status = "okay";
+};
+
+&rknn_mmu_1 {
+	status = "okay";
+};
+
+&sai1 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&sai1m0_lrck
+		     &sai1m0_sclk
+		     &sai1m0_sdi0
+		     &sai1m0_sdo2>;
+	rockchip,sai-tx-route = <2 1 0 3>;
+	status = "okay";
+};
+
+&vp1 {
+	vp1_out_dp0: endpoint@ROCKCHIP_VOP2_EP_DP0 {
+		reg = <ROCKCHIP_VOP2_EP_DP0>;
+		remote-endpoint = <&dp0_in_vp1>;
+	};
+};
+
+/* The mini-PCIe slot (EC20 4G module) has no driver to claim its supply */
+&vcc_3v3_minipcie {
+	regulator-always-on;
+};
+
+/*
+ * VBUS of the USB-A ports. The usb-a-connector nodes name these supplies, but
+ * nothing turns them on, so devices plugged into the ports get no power.
+ */
+&vcc_5v0_usb2_host {
+	regulator-always-on;
+	regulator-boot-on;
+};
+
+&vcc_5v0_usb3_host {
+	regulator-always-on;
+	regulator-boot-on;
+};
-- 
Armbian

