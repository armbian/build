From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jiaxing Hu <gahing@gahingwoo.com>
Date: Sat, 14 Nov 2026 10:34:28 +1300
Subject: pmdomain: rockchip: switch off the subdomains of a regulator domain at probe

A domain that needs a regulator is switched off at probe, because the
state of its regulator is unknown. Its subdomains are added only after
that, so a subdomain the bootloader left on stays powered and not idled
behind a parent that is off. genpd reads it as off and never touches
it again. When the regulator is later disabled as unused, the bus hangs
on the NIUs of those subdomains.

On the RK3576 this hangs boards that do not enable the NPU: PD_NPU needs
a regulator, U-Boot leaves NPUTOP, NPU0 and NPU1 on, and the SoC locks
up when regulator_late_cleanup() disables vdd_npu_s0.

Mark the domain and everything below it as off when it is added, and
switch the whole subtree off once it is complete, children first.

Reported-by: Vladimir Bely <vlwwwwww@gmail.com>
Closes: https://github.com/gahingwoo/linux-rk3576-npu/issues/4
Signed-off-by: Jiaxing Hu <gahing@gahingwoo.com>
---
 drivers/pmdomain/rockchip/pm-domains.c | 47 ++++++++++++++++++++++----
 1 file changed, 41 insertions(+), 6 deletions(-)

diff --git a/drivers/pmdomain/rockchip/pm-domains.c b/drivers/pmdomain/rockchip/pm-domains.c
index d45821459e91..8479bb5136f0 100644
--- a/drivers/pmdomain/rockchip/pm-domains.c
+++ b/drivers/pmdomain/rockchip/pm-domains.c
@@ -105,6 +105,7 @@ struct rockchip_pm_domain {
 	struct device_node *node;
 	struct regulator *supply;
 	struct reset_control *reset;
+	bool off_at_probe;
 };
 
 struct rockchip_pmu {
@@ -846,7 +847,8 @@ static void rockchip_pd_detach_dev(struct generic_pm_domain *genpd,
 }
 
 static int rockchip_pm_add_one_domain(struct rockchip_pmu *pmu,
-				      struct device_node *node)
+				      struct device_node *node,
+				      struct rockchip_pm_domain *parent)
 {
 	const struct rockchip_domain_info *pd_info;
 	struct rockchip_pm_domain *pd;
@@ -971,9 +973,16 @@ static int rockchip_pm_add_one_domain(struct rockchip_pmu *pmu,
 	 * the regulator state is unknown at probe time. Also the regulator
 	 * state cannot be checked, since that usually requires IP needing
 	 * (a different) power domain.
+	 *
+	 * The domains below such a domain have to start off too, or genpd
+	 * would see them off behind a parent that is off while the
+	 * bootloader left them on, and never idle them before the regulator
+	 * is cut. Only mark them here: the subdomains are not added yet, so
+	 * rockchip_pm_power_off_subtree() switches the whole subtree off,
+	 * children first, once it is complete.
 	 */
-	if (pd->info->need_regulator)
-		rockchip_pd_power(pd, false);
+	pd->off_at_probe = pd->info->need_regulator ||
+			   (parent && parent->off_at_probe);
 
 	pd->genpd.power_off = rockchip_pd_power_off;
 	pd->genpd.power_on = rockchip_pd_power_on;
@@ -988,7 +997,7 @@ static int rockchip_pm_add_one_domain(struct rockchip_pmu *pmu,
 			goto err_unprepare_clocks;
 	}
 	pm_genpd_init(&pd->genpd, NULL,
-		      !rockchip_pmu_domain_is_on(pd) ||
+		      pd->off_at_probe || !rockchip_pmu_domain_is_on(pd) ||
 		      (pd->info->mem_status_mask && !rockchip_pmu_domain_is_mem_on(pd)));
 
 	pmu->genpd_data.domains[id] = &pd->genpd;
@@ -1058,6 +1067,29 @@ static void rockchip_configure_pd_cnt(struct rockchip_pmu *pmu,
 	regmap_write(pmu->regmap, domain_reg_offset + 4, count);
 }
 
+/*
+ * Switch off the domains marked off_at_probe below and including @np,
+ * children before their parent.
+ */
+static void rockchip_pm_power_off_subtree(struct rockchip_pmu *pmu,
+					  struct device_node *np)
+{
+	struct rockchip_pm_domain *pd;
+	u32 idx;
+
+	for_each_child_of_node_scoped(np, child)
+		rockchip_pm_power_off_subtree(pmu, child);
+
+	if (of_property_read_u32(np, "reg", &idx) ||
+	    idx >= pmu->genpd_data.num_domains ||
+	    !pmu->genpd_data.domains[idx])
+		return;
+
+	pd = to_rockchip_pd(pmu->genpd_data.domains[idx]);
+	if (pd->off_at_probe)
+		rockchip_pd_power(pd, false);
+}
+
 static int rockchip_pm_add_subdomain(struct rockchip_pmu *pmu,
 				     struct device_node *parent)
 {
@@ -1076,7 +1108,8 @@ static int rockchip_pm_add_subdomain(struct rockchip_pmu *pmu,
 		}
 		parent_domain = pmu->genpd_data.domains[idx];
 
-		error = rockchip_pm_add_one_domain(pmu, np);
+		error = rockchip_pm_add_one_domain(pmu, np,
+						   to_rockchip_pd(parent_domain));
 		if (error) {
 			dev_err(pmu->dev, "failed to handle node %pOFn: %d\n",
 				np, error);
@@ -1172,7 +1205,7 @@ static int rockchip_pm_domain_probe(struct platform_device *pdev)
 	guard(mutex)(&dmc_pmu_mutex);
 
 	for_each_available_child_of_node_scoped(np, node) {
-		error = rockchip_pm_add_one_domain(pmu, node);
+		error = rockchip_pm_add_one_domain(pmu, node, NULL);
 		if (error) {
 			dev_err(dev, "failed to handle node %pOFn: %d\n",
 				node, error);
@@ -1185,6 +1218,8 @@ static int rockchip_pm_domain_probe(struct platform_device *pdev)
 				node, error);
 			goto err_out;
 		}
+
+		rockchip_pm_power_off_subtree(pmu, node);
 	}
 
 	if (error) {
-- 
Armbian

