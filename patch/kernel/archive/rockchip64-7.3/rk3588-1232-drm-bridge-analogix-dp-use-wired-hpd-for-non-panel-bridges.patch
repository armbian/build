From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: evtest-hash <84323112+evtest-hash@users.noreply.github.com>
Date: Fri, 23 Oct 2026 19:13:04 +0800
Subject: drm/bridge: analogix_dp: use wired HPD for non-panel bridges

Only assume connected for panel bridges or when no HPD GPIO is wired.
For non-panel bridges with an HPD GPIO, use it so hotplug is reported
without changing boards that rely on the old shortcut.

Drop the bridge reference returned by drm_bridge_chain_get_last_bridge().

Signed-off-by: evtest-hash <84323112+evtest-hash@users.noreply.github.com>
---
 drivers/gpu/drm/bridge/analogix/analogix_dp_core.c | 15 +++++++++-
 drivers/gpu/drm/bridge/analogix/analogix_dp_core.h |  1 +
 2 files changed, 15 insertions(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/bridge/analogix/analogix_dp_core.c b/drivers/gpu/drm/bridge/analogix/analogix_dp_core.c
index 111111111111..222222222222 100644
--- a/drivers/gpu/drm/bridge/analogix/analogix_dp_core.c
+++ b/drivers/gpu/drm/bridge/analogix/analogix_dp_core.c
@@ -903,7 +903,12 @@ analogix_dp_bridge_detect(struct drm_bridge *bridge, struct drm_connector *conne
 	struct analogix_dp_device *dp = to_dp(bridge);
 	enum drm_connector_status status = connector_status_disconnected;
 
-	if (dp->plat_data->next_bridge)
+	/*
+	 * Panels have no detect callback. Keep the shortcut when no HPD
+	 * GPIO is wired; otherwise use HPD for non-panel bridges.
+	 */
+	if (dp->plat_data->next_bridge &&
+	    (dp->last_bridge_is_panel || !dp->hpd_gpiod))
 		return connector_status_connected;
 
 	if (!analogix_dp_detect_hpd(dp))
@@ -917,6 +922,7 @@ static int analogix_dp_bridge_attach(struct drm_bridge *bridge,
 				     enum drm_bridge_attach_flags flags)
 {
 	struct analogix_dp_device *dp = to_dp(bridge);
+	struct drm_bridge *last_bridge;
 	int ret = 0;
 
 	if (!(flags & DRM_BRIDGE_ATTACH_NO_CONNECTOR)) {
@@ -931,6 +937,13 @@ static int analogix_dp_bridge_attach(struct drm_bridge *bridge,
 			dev_err(dp->dev, "failed to attach following panel or bridge (%d)\n", ret);
 			return ret;
 		}
+
+		last_bridge = drm_bridge_chain_get_last_bridge(dp->encoder);
+		if (last_bridge) {
+			if (drm_bridge_is_panel(last_bridge))
+				dp->last_bridge_is_panel = true;
+			drm_bridge_put(last_bridge);
+		}
 	}
 
 	return 0;
diff --git a/drivers/gpu/drm/bridge/analogix/analogix_dp_core.h b/drivers/gpu/drm/bridge/analogix/analogix_dp_core.h
index 111111111111..222222222222 100644
--- a/drivers/gpu/drm/bridge/analogix/analogix_dp_core.h
+++ b/drivers/gpu/drm/bridge/analogix/analogix_dp_core.h
@@ -168,6 +168,7 @@ struct analogix_dp_device {
 	bool			force_hpd;
 	bool			fast_train_enable;
 	bool			psr_supported;
+	bool			last_bridge_is_panel;
 
 	u8 dpcd[DP_RECEIVER_CAP_SIZE];
 
-- 
Armbian

