From: retro98boy <retro98boy@qq.com>
Subject: [PATCH] thermal: rockchip: add calibrated RK3562 temperature monitoring

diff --git a/drivers/thermal/rockchip_thermal.c b/drivers/thermal/rockchip_thermal.c
--- a/drivers/thermal/rockchip_thermal.c
+++ b/drivers/thermal/rockchip_thermal.c
@@ -266,6 +266,10 @@
 
 #define RK3528_VPU_GRF_TSADC_CON		0x0030
 
+#define RK3562_GRF_TSADC_CON			0x0580
+#define RK3562_TSADC_PERIOD			3000
+#define RK3562_TSADC_Q_MAX			0xfff
+
 #define RK3568_GRF_TSADC_CON			0x0600
 #define RK3568_GRF_TSADC_ANA_REG0		(0x10001 << 0)
 #define RK3568_GRF_TSADC_ANA_REG1		(0x10001 << 1)
@@ -579,6 +583,47 @@
 	{TSADCV5_DATA_MASK, RK_MAX_TEMP},
 };
 
+static const struct tsadc_table rk3562_code_table[] = {
+	{0, RK_MIN_TEMP},
+	{1385, RK_MIN_TEMP},
+	{1419, -40000},
+	{1428, -35000},
+	{1436, -30000},
+	{1445, -25000},
+	{1453, -20000},
+	{1462, -15000},
+	{1470, -10000},
+	{1479, -5000},
+	{1487, 0},
+	{1496, 5000},
+	{1504, 10000},
+	{1512, 15000},
+	{1521, 20000},
+	{1529, 25000},
+	{1538, 30000},
+	{1546, 35000},
+	{1555, 40000},
+	{1563, 45000},
+	{1572, 50000},
+	{1580, 55000},
+	{1589, 60000},
+	{1598, 65000},
+	{1606, 70000},
+	{1615, 75000},
+	{1623, 80000},
+	{1632, 85000},
+	{1640, 90000},
+	{1648, 95000},
+	{1657, 100000},
+	{1666, 105000},
+	{1674, 110000},
+	{1682, 115000},
+	{1691, 120000},
+	{1699, 125000},
+	{1793, RK_MAX_TEMP},
+	{TSADCV2_DATA_MASK, RK_MAX_TEMP},
+};
+
 static const struct tsadc_table rk3568_code_table[] = {
 	{0, -40000},
 	{1584, -40000},
@@ -916,6 +961,25 @@
 			       regs + TSADCV2_AUTO_CON);
 }
 
+static void rk3562_tsadc_initialize(struct regmap *grf, void __iomem *regs,
+				    enum tshut_polarity tshut_polarity)
+{
+	rk_tsadcv8_initialize(grf, regs, tshut_polarity);
+	writel_relaxed(RK3562_TSADC_PERIOD, regs + TSADCV3_AUTO_PERIOD);
+	writel_relaxed(RK3562_TSADC_PERIOD, regs + TSADCV3_AUTO_PERIOD_HT);
+	writel_relaxed(RK3562_TSADC_Q_MAX, regs + TSADCV9_Q_MAX);
+	writel_relaxed(TSADCV3_AUTO_Q_SEL_EN | TSADCV3_AUTO_Q_SEL_EN_MASK,
+		       regs + TSADCV2_AUTO_CON);
+
+	regmap_write(grf, RK3562_GRF_TSADC_CON, RK3568_GRF_TSADC_TSEN);
+	/* Wait at least 10 us before configuring the analog registers. */
+	udelay(15);
+	regmap_write(grf, RK3562_GRF_TSADC_CON, RK3568_GRF_TSADC_ANA_REG0);
+	regmap_write(grf, RK3562_GRF_TSADC_CON, RK3568_GRF_TSADC_ANA_REG1);
+	regmap_write(grf, RK3562_GRF_TSADC_CON, RK3568_GRF_TSADC_ANA_REG2);
+	usleep_range(100, 200);
+}
+
 static void rk_tsadcv11_initialize(struct regmap *grf, void __iomem *regs,
 				   enum tshut_polarity tshut_polarity)
 {
@@ -1430,6 +1494,37 @@
 	},
 };
 
+static int rk3562_tsadc_get_trim_code(const struct chip_tsadc_table *table,
+				    int code, int trim_base, int trim_base_frac)
+{
+	/* A zero OTP base selects the factory default of 30 degrees Celsius. */
+	return rk_tsadcv3_get_trim_code(table, code, trim_base ?: 30, trim_base_frac);
+}
+
+static const struct rockchip_tsadc_chip rk3562_tsadc_data = {
+	.chn_offset = 0,
+	.chn_num = 1,
+	.grf_required = true,
+	.tshut_mode = TSHUT_MODE_CRU,
+	.tshut_polarity = TSHUT_LOW_ACTIVE,
+	.tshut_temp = 95000,
+	.initialize = rk3562_tsadc_initialize,
+	.irq_ack = rk_tsadcv4_irq_ack,
+	.control = rk_tsadcv4_control,
+	.get_temp = rk_tsadcv4_get_temp,
+	.set_alarm_temp = rk_tsadcv3_alarm_temp,
+	.set_tshut_temp = rk_tsadcv3_tshut_temp,
+	.set_tshut_mode = rk_tsadcv4_tshut_mode,
+	.get_trim_code = rk3562_tsadc_get_trim_code,
+	.trim_slope = 588,
+	.table = {
+		.id = rk3562_code_table,
+		.length = ARRAY_SIZE(rk3562_code_table),
+		.data_mask = TSADCV2_DATA_MASK,
+		.mode = ADC_INCREMENT,
+	},
+};
+
 static const struct rockchip_tsadc_chip rk3568_tsadc_data = {
 	/* cpu, gpu */
 	.chn_offset = 0,
@@ -1542,6 +1637,10 @@
 		.data = (void *)&rk3528_tsadc_data,
 	},
 	{
+		.compatible = "rockchip,rk3562-tsadc",
+		.data = (void *)&rk3562_tsadc_data,
+	},
+	{
 		.compatible = "rockchip,rk3568-tsadc",
 		.data = (void *)&rk3568_tsadc_data,
 	},
