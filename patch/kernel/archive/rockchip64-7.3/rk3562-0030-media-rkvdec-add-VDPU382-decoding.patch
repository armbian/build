 	for (i = 0; !intra_only && i < ARRAY_SIZE(ref_bufs); i++) {
 		unsigned int refw = ref_bufs[i]->vp9.width;
@@ -626,6 +632,31 @@ static void config_registers(struct rkvdec_ctx *ctx,
 		offsetof(struct rkvdec_vp9_priv_tbl, segmap) +
 		(RKVDEC_VP9_MAX_SEGMAP_SIZE * vp9_ctx->cur.segmapid);
 
+	if (ctx->dev->variant->is_vdpu382) {
+		bool update = intra_only || !vp9_ctx->last.valid ||
+			(dec_params->flags & V4L2_VP9_FRAME_FLAG_ERROR_RESILIENT) ||
+			((seg->flags & V4L2_VP9_SEGMENTATION_FLAG_ENABLED) &&
+			 (seg->flags & V4L2_VP9_SEGMENTATION_FLAG_UPDATE_MAP)) ||
+			last->vp9.width != dst->vp9.width ||
+			last->vp9.height != dst->vp9.height;
+		dma_addr_t base = vp9_ctx->priv_tbl.dma +
+			offsetof(struct rkvdec_vp9_priv_tbl, segmap);
+
+		/* Retain the last map until hardware writes its replacement. */
+		regs->vp9_param.reg75.vp9_segment_id_update = update;
+		if (dec_params->flags & V4L2_VP9_FRAME_FLAG_ERROR_RESILIENT) {
