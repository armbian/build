+			.min_height = 64, .max_height = 2304, .step_height = 16,
+		},
+		.ctrls = &vdpu38x_hevc_ctrls,
+		.ops = &rkvdec_vdpu381_hevc_fmt_ops,
+		.num_decoded_fmts = ARRAY_SIZE(vdpu382_decoded_fmts),
+		.decoded_fmts = vdpu382_decoded_fmts,
+		.subsystem_flags = VB2_V4L2_FL_SUPPORTS_M2M_HOLD_CAPTURE_BUF,
+	},
+	{
+		.fourcc = V4L2_PIX_FMT_H264_SLICE,
+		.frmsize = {
+			.min_width = 64, .max_width = 1920, .step_width = 64,
+			.min_height = 64, .max_height = 1088, .step_height = 16,
+		},
+		.ctrls = &vdpu38x_h264_ctrls,
+		.ops = &rkvdec_vdpu381_h264_fmt_ops,
+		.num_decoded_fmts = ARRAY_SIZE(vdpu382_decoded_fmts),
+		.decoded_fmts = vdpu382_decoded_fmts,
+		.subsystem_flags = VB2_V4L2_FL_SUPPORTS_M2M_HOLD_CAPTURE_BUF,
+	},
+};
+
 static const struct rkvdec_coded_fmt_desc vdpu383_coded_fmts[] = {
 	{
 		.fourcc = V4L2_PIX_FMT_HEVC_SLICE,
@@ -1237,6 +1366,13 @@ static void rkvdec_device_run(void *priv)
 		return;
 	}
 
+	if (rkvdec->variant->is_vdpu382) {
+		ret = vdpu382_prepare(rkvdec);
+		if (ret) {
+			rkvdec_job_finish(ctx, VB2_BUF_STATE_ERROR);
+			return;
+		}
+	}
 	ret = desc->ops->run(ctx);
 	if (ret)
 		rkvdec_job_finish(ctx, VB2_BUF_STATE_ERROR);
@@ -1300,9 +1436,20 @@ static int rkvdec_add_ctrls(struct rkvdec_ctx *ctx,
 	unsigned int i;
 
 	for (i = 0; i < ctrls->num_ctrls; i++) {
-		const struct v4l2_ctrl_config *cfg = &ctrls->ctrls[i].cfg;
+		struct v4l2_ctrl_config cfg = ctrls->ctrls[i].cfg;
+
+		if (ctx->dev->variant->is_vdpu382) {
+			if (cfg.id == V4L2_CID_MPEG_VIDEO_HEVC_PROFILE) {
+				cfg.max = V4L2_MPEG_VIDEO_HEVC_PROFILE_MAIN;
+				cfg.menu_skip_mask = 0;
+			} else if (cfg.id == V4L2_CID_MPEG_VIDEO_HEVC_LEVEL) {
+				cfg.max = V4L2_MPEG_VIDEO_HEVC_LEVEL_5;
+			} else if (cfg.id == V4L2_CID_MPEG_VIDEO_H264_PROFILE) {
+				cfg.max = V4L2_MPEG_VIDEO_H264_PROFILE_HIGH;
+			}
+		}
 
-		v4l2_ctrl_new_custom(&ctx->ctrl_hdl, cfg, ctx);
+		v4l2_ctrl_new_custom(&ctx->ctrl_hdl, &cfg, ctx);
 		if (ctx->ctrl_hdl.error)
 			return ctx->ctrl_hdl.error;
 	}
@@ -1584,6 +1731,22 @@ static irqreturn_t rkvdec_irq_handler(int irq, void *priv)
 	struct rkvdec_ctx *ctx = v4l2_m2m_get_curr_priv(rkvdec->m2m_dev);
 	const struct rkvdec_variant *variant = rkvdec->variant;
 
+	if (variant->is_vdpu382) {
+		u32 status = readl(rkvdec->regs + VDPU381_REG_STA_INT);
+		enum vb2_buffer_state state = VB2_BUF_STATE_ERROR;
+
+		writel(0, rkvdec->regs + VDPU381_REG_STA_INT);
+		if (!ctx || !cancel_delayed_work(&rkvdec->watchdog_work))
+			return IRQ_HANDLED;
+		if ((status & VDPU381_STA_INT_DEC_RDY_STA) &&
+		    !(status & GENMASK(7, 3)))
+			state = VB2_BUF_STATE_DONE;
+		else
+			vdpu382_reset(rkvdec);
+		rkvdec_job_finish(ctx, state);
+		return IRQ_HANDLED;
+	}
+
 	return variant->ops->irq_handler(ctx);
 }
 
@@ -1669,7 +1832,10 @@ static void rkvdec_watchdog_func(struct work_struct *work)
 	ctx = v4l2_m2m_get_curr_priv(rkvdec->m2m_dev);
 	if (ctx) {
 		dev_err(rkvdec->dev, "Frame processing timed out!\n");
-		writel(RKVDEC_IRQ_DIS, rkvdec->regs + RKVDEC_REG_INTERRUPT);
+		if (rkvdec->variant->is_vdpu382)
+			vdpu382_reset(rkvdec);
+		else
+			writel(RKVDEC_IRQ_DIS, rkvdec->regs + RKVDEC_REG_INTERRUPT);
 		rkvdec_job_finish(ctx, VB2_BUF_STATE_ERROR);
 	}
 }
@@ -1775,6 +1941,15 @@ static const struct rkvdec_variant vdpu381_variant = {
 	.ops = &vdpu381_variant_ops,
 };
 
+static const struct rkvdec_variant vdpu382_variant = {
