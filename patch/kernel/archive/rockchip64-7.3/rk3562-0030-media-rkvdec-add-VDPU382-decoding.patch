From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: retro98boy <retro98boy@qq.com>
Date: Sat, 24 Oct 2026 09:25:08 +0800
Subject: [PATCH] media: rkvdec: add RK3562 VDPU382 decoding support

Reuse the VDPU381 backends for H.264, HEVC Main and VP9 Profile 0.
Support HEVC and VP9 frames up to 4096x2304 with 8-bit output.
Add VDPU382 cache setup, reset recovery and external IOMMU handling.
Handle VP9 segment maps, stream offsets and stale frame registers.
Limit HEVC profile and level controls to the supported capabilities.
Limit H.264 profile reporting to High for VDPU382's 8-bit 4:2:0 output.
Preserve other decoder variants.

---
diff --git a/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu381-h264.c b/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu381-h264.c
index b961fdd..6f0444a 100644
--- a/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu381-h264.c
+++ b/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu381-h264.c
@@ -15,6 +15,9 @@
 #include "rkvdec-h264-common.h"
 #include "rkvdec-vdpu381-regs.h"
 
+#define VDPU382_REG_MODE			0x034
+#define VDPU382_H264_STREAM_REMOVE	BIT(8)
+
 struct rkvdec_sps {
 	u16 seq_parameter_set_id:			4;
 	u16 profile_idc:				8;
@@ -203,6 +206,12 @@ static void rkvdec_write_regs(struct rkvdec_ctx *ctx)
 	rkvdec_memcpy_toio(rkvdec->regs + OFFSET_POC_HIGHBIT_REGS,
 			   &h264_ctx->regs.h264_highpoc,
 			   sizeof(h264_ctx->regs.h264_highpoc));
+	if (rkvdec->variant->is_vdpu382) {
+		u32 mode = readl(rkvdec->regs + VDPU382_REG_MODE);
+
+		/* VDPU382 removes H.264 emulation-prevention bytes in hardware. */
+		writel(mode | VDPU382_H264_STREAM_REMOVE, rkvdec->regs + VDPU382_REG_MODE);
+	}
 }
 
 static void config_registers(struct rkvdec_ctx *ctx,
@@ -453,6 +462,14 @@ static int rkvdec_h264_run(struct rkvdec_ctx *ctx)
 
 static int rkvdec_h264_try_ctrl(struct rkvdec_ctx *ctx, struct v4l2_ctrl *ctrl)
 {
+	if (ctx->dev->variant->is_vdpu382 &&
+	    ctrl->id == V4L2_CID_STATELESS_H264_SPS) {
+		const struct v4l2_ctrl_h264_sps *sps = ctrl->p_new.p_h264_sps;
+
+		if (sps->chroma_format_idc != 1 || sps->bit_depth_luma_minus8 ||
+		    sps->bit_depth_chroma_minus8)
+			return -EINVAL;
+	}
 	if (ctrl->id == V4L2_CID_STATELESS_H264_SPS)
 		return rkvdec_h264_validate_sps(ctx, ctrl->p_new.p_h264_sps);
 
