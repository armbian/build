 #include <linux/genalloc.h>
 #include <linux/interrupt.h>
 #include <linux/iommu.h>
@@ -20,6 +21,7 @@
 #include <linux/platform_device.h>
 #include <linux/pm.h>
 #include <linux/pm_runtime.h>
+#include <linux/reset.h>
 #include <linux/slab.h>
 #include <linux/videodev2.h>
 #include <linux/workqueue.h>
@@ -34,6 +36,68 @@
 #include "rkvdec-vdpu383-regs.h"
 #include "rkvdec-rcb.h"
 
+#define VDPU382_CACHE_STRIDE	0x40
+#define VDPU382_CACHE_CLEAR	0x00
+#define VDPU382_CACHE_CONFIG	0x0c
+#define VDPU382_CACHE_ENABLE	(BIT(0) | BIT(1) | BIT(4))
+#define VDPU382_REG_RESET_CTRL	0x334
+#define VDPU382_DISABLE_ERROR_RESET	BIT(4)
+
+/* The decoder and its IOMMUs share reset state on RK3562. */
+static int vdpu382_reset(struct rkvdec_dev *rkvdec)
+{
+	int ret;
+
+	ret = iommu_attach_device(rkvdec->empty_domain, rkvdec->dev);
+	if (ret)
+		goto fail;
+
+	ret = reset_control_assert(rkvdec->resets);
+	if (!ret) {
+		udelay(5);
+		ret = reset_control_deassert(rkvdec->resets);
+	}
+
+	iommu_detach_device(rkvdec->empty_domain, rkvdec->dev);
+	if (ret)
+		goto fail;
+
+	writel(0, rkvdec->regs + VDPU381_REG_STA_INT);
+	rkvdec->needs_reset = false;
+	return 0;
+
+fail:
+	/* Do not submit another job with unknown translation or reset state. */
+	reset_control_assert(rkvdec->resets);
+	rkvdec->broken = true;
+	dev_err(rkvdec->dev, "VDPU382 reset failed: %d\n", ret);
+	return ret;
+}
+
+static int vdpu382_prepare(struct rkvdec_dev *rkvdec)
+{
+	unsigned int i;
+	int ret;
+
+	if (rkvdec->broken)
+		return -EIO;
+	if (rkvdec->needs_reset) {
+		ret = vdpu382_reset(rkvdec);
+		if (ret)
+			return ret;
+	}
+
+	for (i = 0; i < 3; i++) {
+		/* Cacheable reads, read allocation, and 64-byte cache lines. */
+		writel(VDPU382_CACHE_ENABLE,
+		       rkvdec->cache + i * VDPU382_CACHE_STRIDE + VDPU382_CACHE_CONFIG);
+		writel(1, rkvdec->cache + i * VDPU382_CACHE_STRIDE + VDPU382_CACHE_CLEAR);
+	}
+	/* Preserve success resets; recover errors with the IOMMU attached. */
+	writel(VDPU382_DISABLE_ERROR_RESET, rkvdec->regs + VDPU382_REG_RESET_CTRL);
+	return 0;
+}
+
 static bool rkvdec_image_fmt_match(enum rkvdec_image_fmt fmt1,
 				   enum rkvdec_image_fmt fmt2)
 {
@@ -601,6 +665,71 @@ static const struct rkvdec_coded_fmt_desc vdpu381_coded_fmts[] = {
