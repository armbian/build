+		regs->vp9_addr.avp9_segidcur_base = base +
+			RKVDEC_VP9_MAX_SEGMAP_SIZE * !vp9_ctx->last.segmapid;
+		vp9_ctx->cur.segmapid = vp9_ctx->last.segmapid ^ update;
