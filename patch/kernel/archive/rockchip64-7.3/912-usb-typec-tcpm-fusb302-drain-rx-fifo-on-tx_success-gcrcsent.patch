From c1970641078dd0ccce3ccecbcc04ceb56ef43c30 Mon Sep 17 00:00:00 2001
From: Ricardo Pardini <ricardo@pardini.net>
Date: Thu, 22 Oct 2026 20:56:52 +0200
Subject: [PATCH] usb: typec: tcpm: fusb302: drain RX FIFO on
 TX_SUCCESS/GCRCSENT

- TX_SUCCESS/GCRCSENT are latched: messages arriving back to back before
  the interrupt registers are read show up as a single event
- only one message was read per event, leaving the rest in the RX FIFO
  already acknowledged with a GoodCRC by the chip
- happens after a sink Soft_Reset, where the source sends Accept then
  Source_Capabilities a few ms later: Source_Capabilities is never seen,
  no Request is sent and the source Hard Resets (VBUS drops)
- seen on a Mixtile Blade 3 (powered only via USB-C) taking over an
  explicit contract from the bootloader; ~75% of boots lost power
- read messages until STATUS1.RX_EMPTY instead, bounded by FIFO size

Assisted-by: Claude Opus 5.5
Signed-off-by: Ricardo Pardini <ricardo@pardini.net>
---
 drivers/usb/typec/tcpm/fusb302.c | 38 +++++++++++++++++++++++++++++---
 1 file changed, 35 insertions(+), 3 deletions(-)

diff --git a/drivers/usb/typec/tcpm/fusb302.c b/drivers/usb/typec/tcpm/fusb302.c
index 3319f6a2b0c9b..3f11e60489a41 100644
--- a/drivers/usb/typec/tcpm/fusb302.c
+++ b/drivers/usb/typec/tcpm/fusb302.c
@@ -43,6 +43,8 @@
  * longer than PD_T_PD_DEBPUNCE (10-20ms).
  */
 #define T_BC_LVL_DEBOUNCE_DELAY_MS 30
+/* 80 byte RX FIFO, smallest message is SOP token + header + CRC = 7 bytes */
+#define FUSB302_RX_FIFO_MAX_MSGS 11
 
 enum toggling_mode {
 	TOGGLING_MODE_OFF,
@@ -1481,6 +1483,37 @@ static int fusb302_pd_read_message(struct fusb302_chip *chip,
 	return ret;
 }
 
+/*
+ * The TX_SUCCESS and GCRCSENT interrupt bits are latched, so if the partner
+ * sends several messages back to back (e.g. Accept followed by
+ * Source_Capabilities after a Soft_Reset) before the interrupt registers are
+ * read, only one event is seen. Reading a single message per event would then
+ * leave the others, already acknowledged by the chip with a GoodCRC, unread
+ * in the RX FIFO, and the partner would eventually Hard Reset. Drain the
+ * whole FIFO instead.
+ */
+static int fusb302_pd_read_messages(struct fusb302_chip *chip)
+{
+	struct pd_message pd_msg;
+	u8 status1;
+	int i, ret;
+
+	for (i = 0; i < FUSB302_RX_FIFO_MAX_MSGS; i++) {
+		ret = fusb302_i2c_read(chip, FUSB_REG_STATUS1, &status1);
+		if (ret < 0)
+			return ret;
+		if (status1 & FUSB_REG_STATUS1_RX_EMPTY)
+			break;
+		ret = fusb302_pd_read_message(chip, &pd_msg);
+		if (ret < 0)
+			return ret;
+	}
+	if (i > 1)
+		fusb302_log(chip, "read %d PD messages from RX FIFO", i);
+
+	return 0;
+}
+
 static irqreturn_t fusb302_irq_intn(int irq, void *dev_id)
 {
 	struct fusb302_chip *chip = dev_id;
@@ -1513,7 +1546,6 @@ static void fusb302_irq_work(struct work_struct *work)
 	bool intr_togdone;
 	bool intr_bc_lvl;
 	bool intr_comp_chng;
-	struct pd_message pd_msg;
 
 	mutex_lock(&chip->lock);
 	/* grab a snapshot of intr flags */
@@ -1602,7 +1634,7 @@ static void fusb302_irq_work(struct work_struct *work)
 
 	if (interrupta & FUSB_REG_INTERRUPTA_TX_SUCCESS) {
 		fusb302_log(chip, "IRQ: PD tx success");
-		ret = fusb302_pd_read_message(chip, &pd_msg);
+		ret = fusb302_pd_read_messages(chip);
 		if (ret < 0) {
 			fusb302_log(chip,
 				    "cannot read in PD message, ret=%d", ret);
@@ -1622,7 +1654,7 @@ static void fusb302_irq_work(struct work_struct *work)
 
 	if (interruptb & FUSB_REG_INTERRUPTB_GCRCSENT) {
 		fusb302_log(chip, "IRQ: PD sent good CRC");
-		ret = fusb302_pd_read_message(chip, &pd_msg);
+		ret = fusb302_pd_read_messages(chip);
 		if (ret < 0) {
 			fusb302_log(chip,
 				    "cannot read in PD message, ret=%d", ret);
-- 
2.56.0

