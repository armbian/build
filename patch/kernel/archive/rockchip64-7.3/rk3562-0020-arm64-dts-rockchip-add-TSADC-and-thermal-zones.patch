From: retro98boy <retro98boy@qq.com>
Subject: [PATCH] arm64: dts: rockchip: add RK3562 TSADC and thermal zones

diff --git a/arch/arm64/boot/dts/rockchip/rk3562.dtsi b/arch/arm64/boot/dts/rockchip/rk3562.dtsi
--- a/arch/arm64/boot/dts/rockchip/rk3562.dtsi
+++ b/arch/arm64/boot/dts/rockchip/rk3562.dtsi
@@ -219,6 +219,40 @@
 		};
 	};
 
+	thermal-zones {
+		soc_thermal: soc-thermal {
+			polling-delay-passive = <100>;
+			polling-delay = <1000>;
+			thermal-sensors = <&tsadc 0>;
+
+			trips {
+				soc_hot: soc-hot {
+					temperature = <85000>;
+					hysteresis = <2000>;
+					type = "passive";
+				};
+
+				soc_crit: soc-crit {
+					temperature = <115000>;
+					hysteresis = <2000>;
+					type = "critical";
+				};
+			};
+
+			cooling-maps {
+				map0 {
+					trip = <&soc_hot>;
+					cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
+				};
+
+				map1 {
+					trip = <&soc_hot>;
+					cooling-device = <&gpu THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
+				};
+			};
+		};
+	};
+
 	arm_pmu: arm-pmu {
 		compatible = "arm,cortex-a53-pmu";
 		interrupts = <GIC_SPI 228 IRQ_TYPE_LEVEL_HIGH>,
@@ -1325,6 +1359,19 @@
 				gpu_leakage: gpu-leakage@1d {
 					reg = <0x1d 0x1>;
 				};
+
+				cpu_tsadc_trim: cpu-tsadc-trim@2a {
+					reg = <0x2a 0x2>;
+				};
+
+				tsadc_trim_base_frac: tsadc-trim-base-frac@2c {
+					reg = <0x2c 0x1>;
+					bits = <4 4>;
+				};
+
+				tsadc_trim_base: tsadc-trim-base@2d {
+					reg = <0x2d 0x1>;
+				};
 			};
 		};
 
@@ -1404,6 +1451,35 @@
 			status = "disabled";
 		};
 
+		tsadc: tsadc@ffa70000 {
+			compatible = "rockchip,rk3562-tsadc";
+			reg = <0x0 0xffa70000 0x0 0x400>;
+			interrupts = <GIC_SPI 125 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&cru CLK_TSADC>, <&cru CLK_TSADC_TSEN>,
+				 <&cru PCLK_TSADC>;
+			clock-names = "tsadc", "tsadc_tsen", "apb_pclk";
+			assigned-clocks = <&cru CLK_TSADC>, <&cru CLK_TSADC_TSEN>;
+			assigned-clock-rates = <1200000>, <12000000>;
+			resets = <&cru SRST_P_TSADC>, <&cru SRST_TSADC>,
+				 <&cru SRST_TSADCPHY>;
+			reset-names = "tsadc-apb", "tsadc", "tsadc-phy";
+			rockchip,grf = <&sys_grf>;
+			rockchip,hw-tshut-temp = <120000>;
+			rockchip,hw-tshut-mode = <0>;
+			rockchip,hw-tshut-polarity = <0>;
+			nvmem-cells = <&tsadc_trim_base>, <&tsadc_trim_base_frac>;
+			nvmem-cell-names = "trim_base", "trim_base_frac";
+			#address-cells = <1>;
+			#size-cells = <0>;
+			#thermal-sensor-cells = <1>;
+
+			sensor@0 {
+				reg = <0>;
+				nvmem-cells = <&cpu_tsadc_trim>;
+				nvmem-cell-names = "trim";
+			};
+		};
+
 		gmac0: ethernet@ffa80000 {
 			compatible = "rockchip,rk3562-gmac", "snps,dwmac-4.20a";
 			reg = <0x0 0xffa80000 0x0 0x10000>;
