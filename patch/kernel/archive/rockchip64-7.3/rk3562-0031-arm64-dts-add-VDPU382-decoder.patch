From: retro98boy <retro98boy@qq.com>
Subject: [PATCH] arm64: dts: rockchip: add RK3562 VDPU382 decoder

---
diff --git a/arch/arm64/boot/dts/rockchip/rk3562.dtsi b/arch/arm64/boot/dts/rockchip/rk3562.dtsi
--- a/arch/arm64/boot/dts/rockchip/rk3562.dtsi
+++ b/arch/arm64/boot/dts/rockchip/rk3562.dtsi
@@ -1578,6 +1578,36 @@
 			};
 		};
 
+		vdec: video-codec@ff340000 {
+			compatible = "rockchip,rk3562-vdec";
+			reg = <0x0 0xff340000 0x0 0x100>,
+			      <0x0 0xff340100 0x0 0x400>,
+			      <0x0 0xff340610 0x0 0x90>;
+			reg-names = "link", "function", "cache";
+			interrupts = <GIC_SPI 122 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&cru ACLK_RKVDEC>, <&cru HCLK_RKVDEC>,
+				 <&cru CLK_RKVDEC_HEVC_CA>;
+			clock-names = "axi", "ahb", "hevc_cabac";
+			assigned-clocks = <&cru ACLK_RKVDEC>, <&cru CLK_RKVDEC_HEVC_CA>;
+			assigned-clock-rates = <198000000>, <396000000>;
+			resets = <&cru SRST_A_RKVDEC>, <&cru SRST_H_RKVDEC>,
+				 <&cru SRST_RKVDEC_HEVC_CA>;
+			reset-names = "axi", "ahb", "hevc_cabac";
+			power-domains = <&power RK3562_PD_VDPU>;
+			iommus = <&vdec_mmu>;
+		};
+
+		vdec_mmu: iommu@ff340800 {
+			compatible = "rockchip,rk3562-iommu", "rockchip,rk3568-iommu";
+			reg = <0x0 0xff340800 0x0 0x40>, <0x0 0xff340900 0x0 0x40>;
+			interrupts = <GIC_SPI 123 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&cru ACLK_RKVDEC>, <&cru HCLK_RKVDEC>,
+				 <&cru CLK_RKVDEC_HEVC_CA>;
+			clock-names = "aclk", "iface", "hevc_cabac";
+			power-domains = <&power RK3562_PD_VDPU>;
+			#iommu-cells = <0>;
+		};
+
 		vop: vop@ff400000 {
 			compatible = "rockchip,rk3562-vop";
 			reg = <0x0 0xff400000 0x0 0x2000>, <0x0 0xff405000 0x0 0x1000>;
