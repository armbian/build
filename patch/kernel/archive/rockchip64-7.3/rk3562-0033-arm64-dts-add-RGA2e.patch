From: retro98boy <retro98boy@qq.com>
Subject: [PATCH] arm64: dts: rockchip: add RK3562 RGA2e

---
diff --git a/arch/arm64/boot/dts/rockchip/rk3562.dtsi b/arch/arm64/boot/dts/rockchip/rk3562.dtsi
--- a/arch/arm64/boot/dts/rockchip/rk3562.dtsi
+++ b/arch/arm64/boot/dts/rockchip/rk3562.dtsi
@@ -866,6 +866,28 @@
 			status = "disabled";
 		};
 
+		rga: rga@ff440000 {
+			compatible = "rockchip,rk3562-rga";
+			reg = <0x0 0xff440000 0x0 0xf00>;
+			interrupts = <GIC_SPI 126 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&cru ACLK_RGA>, <&cru HCLK_RGA>, <&cru CLK_RGA_CORE>;
+			clock-names = "aclk", "hclk", "sclk";
+			resets = <&cru SRST_RGA_CORE>, <&cru SRST_A_RGA>, <&cru SRST_H_RGA>;
+			reset-names = "core", "axi", "ahb";
+			power-domains = <&power RK3562_PD_RGA>;
+			iommus = <&rga_mmu>;
+		};
+
+		rga_mmu: iommu@ff440f00 {
+			compatible = "rockchip,rk3562-iommu", "rockchip,rk3568-iommu";
+			reg = <0x0 0xff440f00 0x0 0x100>;
+			interrupts = <GIC_SPI 126 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&cru ACLK_RGA>, <&cru HCLK_RGA>;
+			clock-names = "aclk", "iface";
+			power-domains = <&power RK3562_PD_RGA>;
+			#iommu-cells = <0>;
+		};
+
 		jpegd: jpeg-decoder@ff450000 {
 			compatible = "rockchip,rk3562-jpegd", "rockchip,rk3568-jpegd";
 			reg = <0x0 0xff450000 0x0 0x400>;
