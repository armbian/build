From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Igor Velkov <iav@iav.lv>
Date: Sun, 25 Oct 2026 19:45:00 +0000
Subject: arm64: dts: rockchip: rock-pi-4: describe the Ethernet PHY

Without an mdio node stmmac scans the whole MDIO bus. The RTL8211E
answers at its strapped address 1 and at the Realtek broadcast address
0, so two phy_devices are created for one chip, and end0 attaches to
the one at address 0. On system suspend phylib suspends the unattached
one, writing BMCR_PDOWN into the same PHY. This intermittently breaks
MAC Wake-on-LAN: with s2idle and WAKE_MAGIC, 17 of 40 cycles did not
wake on the magic packet.

Describe the PHY at address 1 and point phy-handle at it. With this,
ROCK Pi 4A (RTL8211E) woke on the magic packet in 20 of 20 cycles.

Signed-off-by: Igor Velkov <iav@iav.lv>
---
 arch/arm64/boot/dts/rockchip/rk3399-rock-pi-4.dtsi | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/arch/arm64/boot/dts/rockchip/rk3399-rock-pi-4.dtsi b/arch/arm64/boot/dts/rockchip/rk3399-rock-pi-4.dtsi
--- a/arch/arm64/boot/dts/rockchip/rk3399-rock-pi-4.dtsi
+++ b/arch/arm64/boot/dts/rockchip/rk3399-rock-pi-4.dtsi
@@ -202,6 +202,7 @@
 	clock_in_out = "input";
 	phy-supply = <&vcc3v3_lan>;
 	phy-mode = "rgmii";
+	phy-handle = <&rgmii_phy>;
 	pinctrl-names = "default";
 	pinctrl-0 = <&rgmii_pins>;
 	snps,reset-gpio = <&gpio3 RK_PB7 GPIO_ACTIVE_LOW>;
@@ -210,6 +211,16 @@
 	tx_delay = <0x28>;
 	rx_delay = <0x11>;
 	status = "okay";
+
+	mdio {
+		compatible = "snps,dwmac-mdio";
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		rgmii_phy: ethernet-phy@1 {
+			reg = <1>;
+		};
+	};
 };

