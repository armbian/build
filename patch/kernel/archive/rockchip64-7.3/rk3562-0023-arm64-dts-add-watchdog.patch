From: retro98boy <retro98boy@qq.com>
Subject: [PATCH] arm64: dts: rockchip: add the RK3562 non-secure watchdog

Use the DesignWare watchdog with its dedicated clock and reset.
Use the APB reset to clear the watchdog enable bit when stopping it.
The functional reset alone leaves the watchdog enabled and causes an unexpected reboot after close.

diff --git a/arch/arm64/boot/dts/rockchip/rk3562.dtsi b/arch/arm64/boot/dts/rockchip/rk3562.dtsi
--- a/arch/arm64/boot/dts/rockchip/rk3562.dtsi
+++ b/arch/arm64/boot/dts/rockchip/rk3562.dtsi
@@ -1458,6 +1458,15 @@
 			status = "disabled";
 		};
 
+		wdt: watchdog@ffa60000 {
+			compatible = "snps,dw-wdt";
+			reg = <0x0 0xffa60000 0x0 0x100>;
+			interrupts = <GIC_SPI 102 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&cru CLK_WDTNS>, <&cru PCLK_WDTNS>;
+			clock-names = "tclk", "pclk";
+			resets = <&cru SRST_P_WDTNS>;
+		};
+
 		tsadc: tsadc@ffa70000 {
 			compatible = "rockchip,rk3562-tsadc";
 			reg = <0x0 0xffa70000 0x0 0x400>;
