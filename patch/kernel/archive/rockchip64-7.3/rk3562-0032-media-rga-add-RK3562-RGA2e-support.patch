 struct rga_addrs {
@@ -169,6 +175,7 @@ static inline bool rga_has_internal_iommu(const struct rockchip_rga *rga)
 }
 
 extern const struct rga_hw rga2_hw;
+extern const struct rga_hw rga2e_hw;
 extern const struct rga_hw rga3_hw;
 
 #endif
