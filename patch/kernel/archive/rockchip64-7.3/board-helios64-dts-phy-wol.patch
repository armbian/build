From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Igor Velkov <iav@iav.lv>
Date: Wed, 30 Sep 2026 14:51:14 +0000
Subject: arm64: dts: rockchip: helios64: describe the Ethernet PHY for
 Wake-on-LAN

The RTL8211F INTB/PMEB pin reaches GPIO0_B0 through LAN_WAKE#
(schematic Rev1.2, sheets 27 and 29). The device tree has no PHY
node, so the PHY gets no interrupt and cannot wake the system.

Describe the PHY at address 1 (PHYAD strapping) with this interrupt
and as a wakeup source.

Assisted-by: LLM
Signed-off-by: Igor Velkov <iav@iav.lv>
---
 arch/arm64/boot/dts/rockchip/rk3399-kobol-helios64.dts | 15 ++++++++++
 1 file changed, 15 insertions(+)

diff --git a/arch/arm64/boot/dts/rockchip/rk3399-kobol-helios64.dts b/arch/arm64/boot/dts/rockchip/rk3399-kobol-helios64.dts
index 111111111111..222222222222 100644
--- a/arch/arm64/boot/dts/rockchip/rk3399-kobol-helios64.dts
+++ b/arch/arm64/boot/dts/rockchip/rk3399-kobol-helios64.dts
@@ -478,6 +478,7 @@ &gmac {
 	assigned-clock-parents = <&clkin_gmac>;
 	assigned-clocks = <&cru SCLK_RMII_SRC>;
 	clock_in_out = "input";
+	phy-handle = <&rgmii_phy>;
 	phy-mode = "rgmii";
 	phy-supply = <&vcc_lan>;
 	pinctrl-names = "default";
@@ -488,6 +489,20 @@ &gmac {
 	snps,reset-delays-us = <0 10000 50000>;
 	snps,reset-gpio = <&gpio3 RK_PB7 GPIO_ACTIVE_LOW>;
 	status = "okay";
+
+	mdio {
+		compatible = "snps,dwmac-mdio";
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		/* RTL8211F INTB/PMEB reaches GPIO0_B0 through LAN_WAKE# */
+		rgmii_phy: ethernet-phy@1 {
+			reg = <1>;
+			interrupt-parent = <&gpio0>;
+			interrupts = <RK_PB0 IRQ_TYPE_LEVEL_LOW>;
+			wakeup-source;
+		};
+	};
 };
 
 &gpu {
