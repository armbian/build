From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Lukasz Sobala <lsobala1@gmail.com>
Date: Sun, 27 Sep 2026 12:00:00 +0200
Subject: arm64: dts: rockchip: rock-2: Enable OHCI, TSADC and WiFi power

Shared by the Radxa ROCK 2A and ROCK 2F:

- OHCI, so low-/full-speed devices work on the USB 2.0 host port
  (EHCI has no companion controller otherwise).
- TSADC, which provides the SoC thermal zone and CPU/GPU throttling
  (requires rk3528-thermal.patch).
- Keep vcc_wifi on. Nothing consumes it, so reg-fixed drives its enable
  GPIO low at probe and the AIC8800 USB WiFi/BT module never shows up
  on the bus. The Radxa 6.1 DT marks the same rail always-on.

Signed-off-by: Lukasz Sobala <lsobala1@gmail.com>
---
diff --git a/arch/arm64/boot/dts/rockchip/rk3528-rock-2.dtsi b/arch/arm64/boot/dts/rockchip/rk3528-rock-2.dtsi
index 111111111111..222222222222 100644
--- a/arch/arm64/boot/dts/rockchip/rk3528-rock-2.dtsi
+++ b/arch/arm64/boot/dts/rockchip/rk3528-rock-2.dtsi
@@ -94,6 +94,8 @@
 		pinctrl-names = "default";
 		pinctrl-0 = <&usb_wifi_pwr>;
 		regulator-name = "vcc_wifi";
+		regulator-always-on;
+		regulator-boot-on;
 		regulator-min-microvolt = <3300000>;
 		regulator-max-microvolt = <3300000>;
 		vin-supply = <&vcc_3v3>;
@@ -290,6 +292,10 @@
 	status = "okay";
 };
 
+&tsadc {
+	status = "okay";
+};
+
 &uart0 {
 	pinctrl-names = "default";
 	pinctrl-0 = <&uart0m0_xfer>;
@@ -300,6 +306,10 @@
 	status = "okay";
 };
 
+&usb_host0_ohci {
+	status = "okay";
+};
+
 &usb2phy {
 	status = "okay";
 };
-- 
Armbian

