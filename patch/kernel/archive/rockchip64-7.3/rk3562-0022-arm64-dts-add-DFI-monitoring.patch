From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: retro98boy <retro98boy@qq.com>
Date: Sat, 24 Oct 2026 09:25:08 +0800
Subject: [PATCH] arm64: dts: rockchip: add RK3562 DFI monitoring

---
diff --git a/arch/arm64/boot/dts/rockchip/rk3562.dtsi b/arch/arm64/boot/dts/rockchip/rk3562.dtsi
--- a/arch/arm64/boot/dts/rockchip/rk3562.dtsi
+++ b/arch/arm64/boot/dts/rockchip/rk3562.dtsi
@@ -856,6 +856,12 @@
 			status = "disabled";
 		};
 
+		dfi: dfi@ff4c0000 {
+			compatible = "rockchip,rk3562-dfi";
+			reg = <0x0 0xff4c0000 0x0 0x400>;
+			rockchip,pmu = <&pmu_grf>;
+		};
+
 		spi1: spi@ff640000 {
 			compatible = "rockchip,rk3066-spi";
 			reg = <0x0 0xff640000 0x0 0x1000>;
