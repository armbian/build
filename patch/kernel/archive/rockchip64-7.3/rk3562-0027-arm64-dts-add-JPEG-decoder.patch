From: retro98boy <retro98boy@qq.com>
Subject: [PATCH] arm64: dts: rockchip: add the RK3562 JPEG decoder

Describe the VDPU720 decoder and its external v2 IOMMU.
Use the clock and reset names from the V4L2 decoder binding.

diff --git a/arch/arm64/boot/dts/rockchip/rk3562.dtsi b/arch/arm64/boot/dts/rockchip/rk3562.dtsi
--- a/arch/arm64/boot/dts/rockchip/rk3562.dtsi
+++ b/arch/arm64/boot/dts/rockchip/rk3562.dtsi
@@ -866,6 +866,28 @@
 			status = "disabled";
 		};
 
+		jpegd: jpeg-decoder@ff450000 {
+			compatible = "rockchip,rk3562-jpegd", "rockchip,rk3568-jpegd";
+			reg = <0x0 0xff450000 0x0 0x400>;
+			interrupts = <GIC_SPI 121 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&cru ACLK_JDEC>, <&cru HCLK_JDEC>;
+			clock-names = "axi", "ahb";
+			resets = <&cru SRST_A_JDEC>, <&cru SRST_H_JDEC>;
+			reset-names = "axi", "ahb";
+			power-domains = <&power RK3562_PD_RGA>;
+			iommus = <&jpegd_mmu>;
+		};
+
+		jpegd_mmu: iommu@ff450480 {
+			compatible = "rockchip,rk3562-iommu", "rockchip,rk3568-iommu";
+			reg = <0x0 0xff450480 0x0 0x40>;
+			interrupts = <GIC_SPI 120 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&cru ACLK_JDEC>, <&cru HCLK_JDEC>;
+			clock-names = "aclk", "iface";
+			power-domains = <&power RK3562_PD_RGA>;
+			#iommu-cells = <0>;
+		};
+
 		dfi: dfi@ff4c0000 {
 			compatible = "rockchip,rk3562-dfi";
 			reg = <0x0 0xff4c0000 0x0 0x400>;
