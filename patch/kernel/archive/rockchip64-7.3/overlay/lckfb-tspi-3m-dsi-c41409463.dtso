			"I seq=2109",
			"I seq=ff988101",
			"I seq=220a",
			"I seq=3109",
			"I seq=4033",
			"I seq=5337",
			"I seq=5538",
			"I seq=5095",
			"I seq=5195",
			"I seq=6030",
			"I seq=a00f",
			"I seq=a117",
			"I seq=a222",
			"I seq=a319",
			"I seq=a415",
			"I seq=a528",
			"I seq=a61c",
