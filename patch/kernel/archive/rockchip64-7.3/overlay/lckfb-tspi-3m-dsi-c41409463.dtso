/*
 * LCKFB TaishanPi 3M: 10.1 inch 800x1280 MIPI DSI screen with Goodix GT9271
 * touch (LCKFB-TSPI-10.1inch-MIPI-TP, LCSC C41409463).
 *
 * Panel timings and init sequence are from LCKFB's vendor kernel device
 * tree, in the form the rocknix,generic-dsi driver takes.
 */

/dts-v1/;
/plugin/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/pinctrl/rockchip.h>
#include <dt-bindings/soc/rockchip,vop2.h>

&{/} {
	backlight: backlight {
		compatible = "pwm-backlight";
		pwms = <&pwm2_8ch_2 0 25000 0>;
		brightness-levels = <20 255>;
		num-interpolated-steps = <235>;
		default-brightness-level = <180>;
	};
};

&dsi {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	panel@0 {
		compatible = "rocknix,generic-dsi";
		reg = <0>;
		backlight = <&backlight>;
		reset-gpios = <&gpio2 RK_PB4 GPIO_ACTIVE_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&lcd_rst>;
		/* mounted rotated: landscape is the panel's left side up */
		rotation = <270>;
		vdd-supply = <&vcc_3v3_s0>;
		iovcc-supply = <&vcc_1v8_s3>;

		panel_description =
			"G size=135,216 delays=20,30,10,100,20 format=rgb888 lanes=4 flags=0xa03",
			"M clock=71000 horizontal=800,52,8,48 vertical=1280,15,6,16 default=1",
			"I seq=ff988103",
			"I seq=0100",
			"I seq=0200",
			"I seq=0353",
			"I seq=0453",
			"I seq=0513",
			"I seq=0604",
			"I seq=0702",
			"I seq=0802",
			"I seq=0900",
			"I seq=0a00",
			"I seq=0b00",
			"I seq=0c00",
			"I seq=0d00",
			"I seq=0e00",
			"I seq=0f00",
			"I seq=1000",
			"I seq=1100",
			"I seq=1200",
			"I seq=1300",
			"I seq=1400",
			"I seq=1500",
			"I seq=1600",
			"I seq=1700",
			"I seq=1800",
			"I seq=1900",
			"I seq=1a00",
			"I seq=1b00",
			"I seq=1c00",
			"I seq=1d00",
			"I seq=1ec0",
			"I seq=1f00",
			"I seq=2002",
			"I seq=2109",
			"I seq=2200",
			"I seq=2300",
			"I seq=2400",
			"I seq=2500",
			"I seq=2600",
			"I seq=2700",
			"I seq=2855",
			"I seq=2903",
			"I seq=2a00",
			"I seq=2b00",
			"I seq=2c00",
			"I seq=2d00",
			"I seq=2e00",
			"I seq=2f00",
			"I seq=3000",
			"I seq=3100",
			"I seq=3200",
			"I seq=3300",
			"I seq=3400",
			"I seq=3500",
