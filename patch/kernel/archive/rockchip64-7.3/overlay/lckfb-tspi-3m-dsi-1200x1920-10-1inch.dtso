/*
 * LCKFB TaishanPi 3M: 10.1 inch 1200x1920 MIPI DSI screen with Goodix touch
 *
 * Panel timings and init sequence are from LCKFB's vendor kernel device
 * tree, in the form the rocknix,generic-dsi driver takes.
 *
 * Not tested on hardware: converted from the vendor data, structure as in
 * the tested C41409463 overlay.
 */

/dts-v1/;
/plugin/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/pinctrl/rockchip.h>
#include <dt-bindings/soc/rockchip,vop2.h>

&{/} {
	backlight: backlight {
		compatible = "pwm-backlight";
		pwms = <&pwm2_8ch_2 0 25000 0>;
		brightness-levels = <20 255>;
		num-interpolated-steps = <235>;
		default-brightness-level = <180>;
	};
};

&dsi {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	panel@0 {
		compatible = "rocknix,generic-dsi";
		reg = <0>;
		backlight = <&backlight>;
		reset-gpios = <&gpio2 RK_PB4 GPIO_ACTIVE_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&lcd_rst>;
		vdd-supply = <&vcc_3v3_s0>;
		iovcc-supply = <&vcc_1v8_s3>;

		panel_description =
			"G size=135,216 delays=20,100,10,120,20 format=rgb888 lanes=4 flags=0xa03",
			"M clock=120000 horizontal=1200,42,42,32 vertical=1920,35,4,30 default=1",
			"I seq=b001",
			"I seq=c34f",
			"I seq=c440",
			"I seq=c540",
			"I seq=c640",
			"I seq=c740",
			"I seq=c84d",
			"I seq=c952",
			"I seq=ca51",
			"I seq=cd5d",
			"I seq=ce5b",
			"I seq=cf4b",
			"I seq=d049",
			"I seq=d147",
			"I seq=d245",
			"I seq=d341",
			"I seq=d750",
			"I seq=d840",
			"I seq=d940",
			"I seq=da40",
			"I seq=db40",
			"I seq=dc4e",
			"I seq=dd52",
			"I seq=de51",
			"I seq=e15e",
			"I seq=e25c",
			"I seq=e34c",
			"I seq=e44a",
			"I seq=e548",
			"I seq=e646",
			"I seq=e742",
			"I seq=b003",
			"I seq=be03",
			"I seq=cc44",
			"I seq=c807",
			"I seq=c905",
			"I seq=ca42",
			"I seq=cd3e",
			"I seq=cf60",
			"I seq=d204",
			"I seq=d304",
			"I seq=d401",
			"I seq=d500",
			"I seq=d603",
			"I seq=d704",
			"I seq=d901",
			"I seq=db01",
			"I seq=e4f0",
			"I seq=e50a",
			"I seq=b000",
			"I seq=b108",
			"I seq=bd54",
			"I seq=c206",
			"I seq=c40b",
			"I seq=b002",
			"I seq=c000",
			"I seq=c10a",
			"I seq=c220",
			"I seq=c324",
			"I seq=c423",
			"I seq=c529",
			"I seq=c623",
			"I seq=c71c",
			"I seq=c819",
			"I seq=c917",
			"I seq=ca17",
			"I seq=cb18",
			"I seq=cc1a",
			"I seq=cd1e",
			"I seq=ce20",
			"I seq=cf23",
			"I seq=d007",
			"I seq=d100",
			"I seq=d200",
			"I seq=d30a",
			"I seq=d413",
			"I seq=d51c",
			"I seq=d61a",
			"I seq=d713",
			"I seq=d817",
			"I seq=d91c",
			"I seq=da19",
			"I seq=db17",
			"I seq=dc17",
			"I seq=dd18",
			"I seq=de1a",
			"I seq=df1e",
			"I seq=e020",
			"I seq=e123",
			"I seq=e207",
			"I seq=11 wait=78",
			"I seq=29 wait=14";

		port {
			panel_in_dsi: endpoint {
				remote-endpoint = <&dsi_out_panel>;
			};
		};
	};
};

&dsi_in {
	dsi_in_vp2: endpoint {
		remote-endpoint = <&vp2_out_dsi>;
	};
};

&dsi_out {
	dsi_out_panel: endpoint {
		remote-endpoint = <&panel_in_dsi>;
	};
};

&i2c0 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c0m1_xfer>;
	clock-frequency = <400000>;
	status = "okay";

	touchscreen@5d {
		compatible = "goodix,gt911";
		reg = <0x5d>;
		interrupt-parent = <&gpio0>;
		interrupts = <RK_PC5 IRQ_TYPE_LEVEL_LOW>;
		irq-gpios = <&gpio0 RK_PC5 GPIO_ACTIVE_HIGH>;
		/*
		 * The line resets the chip when low, but the goodix driver
		 * writes 0 to reset and 1 to release, so this is ACTIVE_HIGH
		 * like on every other board using it.
		 */
		reset-gpios = <&gpio0 RK_PD0 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&touch_int &touch_rst>;
	};
};

&mipidcphy {
	status = "okay";
};

&pinctrl {
	lcd {
		lcd_rst: lcd-rst {
			rockchip,pins = <2 RK_PB4 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	touch {
		touch_int: touch-int {
			rockchip,pins = <0 RK_PC5 RK_FUNC_GPIO &pcfg_pull_up>;
		};

		touch_rst: touch-rst {
			rockchip,pins = <0 RK_PD0 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
};

&pwm2_8ch_2 {
	pinctrl-names = "default";
	pinctrl-0 = <&pwm2m3_ch2>;
	status = "okay";
};

&vp2 {
	#address-cells = <1>;
	#size-cells = <0>;

	vp2_out_dsi: endpoint@ROCKCHIP_VOP2_EP_MIPI0 {
		reg = <ROCKCHIP_VOP2_EP_MIPI0>;
		remote-endpoint = <&dsi_in_vp2>;
	};
};
