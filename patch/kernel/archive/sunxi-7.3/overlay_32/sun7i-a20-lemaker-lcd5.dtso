/dts-v1/;
/plugin/;

/*
 * LeMaker 5" RGB LCD (800x480) with FT5x06 touch on the LCD connector
 * of the LeMaker Banana Pro. Parameters taken from the vendor fex file
 * (banana_pro_5lcd.fex).
 *
 * The fex file uses a 30 MHz pixel clock. 29.7 MHz (297 MHz / 10) is used
 * here, so the LCD does not flicker with HDMI connected: LCD (TCON0) and
 * HDMI share PLL3 and HDMI sets it to 297 MHz in 720p/1080p. About 61 Hz.
 * HDMI must run at 1080p or 720p, e.g.
 * extraargs=video=HDMI-A-1:1920x1080@60 in armbianEnv.txt.
 */

/ {
	compatible = "allwinner,sun7i-a20";

	fragment@0 {
		target-path = "/";
		__overlay__ {
			/* Panel power, PH12 */
			lemaker_lcd_power: lemaker-lcd-power {
				compatible = "regulator-fixed";
				regulator-name = "lemaker-lcd-power";
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				gpio = <&pio 7 12 0>; /* PH12, active high */
				enable-active-high;
			};

			/* Backlight: PWM0 on PB2, enable on PH8 */
			lemaker_lcd_backlight: lemaker-lcd-backlight {
				compatible = "pwm-backlight";
				pwms = <&pwm 0 50000 0>;
				brightness-levels = <0 255>;
				num-interpolated-steps = <255>;
				default-brightness-level = <200>;
				enable-gpios = <&pio 7 8 0>; /* PH8, active high */
			};

			lemaker-lcd-panel {
				compatible = "lemaker,lcd-5inch-rgb", "panel-dpi";
				width-mm = <108>;
				height-mm = <65>;
				power-supply = <&lemaker_lcd_power>;
				backlight = <&lemaker_lcd_backlight>;

				panel-timing {
					clock-frequency = <29700000>; /* 297 MHz / 10 */
					hactive = <800>;
					vactive = <480>;
					hfront-porch = <40>;
					hback-porch = <40>;
					hsync-len = <48>;
					vfront-porch = <13>;
					vback-porch = <29>;
					vsync-len = <3>;
				};

				port {
					lemaker_lcd_panel_in: endpoint {
						remote-endpoint = <&tcon0_out_lemaker_lcd>;
					};
				};
			};
		};
	};

	/* sun7i-a20.dtsi has no 24-bit RGB pin group for TCON0 */
	fragment@1 {
		target = <&pio>;
		__overlay__ {
			lemaker_lcd_rgb888_pins: lemaker-lcd-rgb888-pins {
				pins = "PD0", "PD1", "PD2", "PD3", "PD4", "PD5",
				       "PD6", "PD7", "PD8", "PD9", "PD10", "PD11",
				       "PD12", "PD13", "PD14", "PD15", "PD16",
				       "PD17", "PD18", "PD19", "PD20", "PD21",
				       "PD22", "PD23", "PD24", "PD25", "PD26",
				       "PD27";
				function = "lcd0";
			};
		};
	};

	fragment@2 {
		target = <&tcon0>;
		__overlay__ {
			pinctrl-names = "default";
			pinctrl-0 = <&lemaker_lcd_rgb888_pins>;
		};
	};

	/* endpoint@1 of tcon0_out is already used by HDMI */
	fragment@3 {
		target = <&tcon0_out>;
		__overlay__ {
			#address-cells = <1>;
			#size-cells = <0>;

			tcon0_out_lemaker_lcd: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&lemaker_lcd_panel_in>;
			};
		};
	};

	fragment@4 {
		target = <&pwm>;
		__overlay__ {
			pinctrl-names = "default";
			pinctrl-0 = <&pwm0_pin>;
			status = "okay";
		};
	};

	/* Touch: FT5x06 on I2C3 (PI0/PI1), IRQ on PH9, reset on PH7 */
	fragment@5 {
		target = <&i2c3>;
		__overlay__ {
			pinctrl-names = "default";
			pinctrl-0 = <&i2c3_pins>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "okay";

			touchscreen@38 {
				compatible = "edt,edt-ft5406";
				reg = <0x38>;
				/*
				 * The controller is powered from the panel line PH12. Without this
				 * the panel driver switches PH12 off on DPMS off and touch cannot
				 * wake the screen.
				 */
				vcc-supply = <&lemaker_lcd_power>;
				interrupt-parent = <&pio>;
				interrupts = <7 9 2>; /* PH9, IRQ_TYPE_EDGE_FALLING */
				/*
				 * PH7 is the controller reset (ctp_wakeup in fex).
				 * As reset-gpios the driver waits 300 ms after
				 * reset, as wake-gpios only 5 ms, too short.
				 */
				reset-gpios = <&pio 7 7 1>; /* PH7, active low */
				touchscreen-size-x = <800>;
				touchscreen-size-y = <480>;
			};
		};
	};
};
