From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ondrej Jirman <megi@xff.cz>
Date: Fri, 24 Jul 2026 19:24:15 +0200
Subject: usb: musb: sunxi: Enable internal DMA on the A83T

The A83T has the same USB-OTG internal DMA engine as the A64. Add a
dedicated match entry for the already existing A83T compatible (which
until now matched via the sun8i-a33 fallback) and declare the idma on
it. DTs that don't describe the "dma" register region keep working
through the existing PIO fallback in probe.

Signed-off-by: Ondrej Jirman <megi@xff.cz>
---
 drivers/usb/musb/sunxi.c | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/drivers/usb/musb/sunxi.c b/drivers/usb/musb/sunxi.c
index 111111111111..222222222222 100644
--- a/drivers/usb/musb/sunxi.c
+++ b/drivers/usb/musb/sunxi.c
@@ -1374,6 +1374,13 @@ static const struct sunxi_musb_cfg sun8i_a33_musb_cfg = {
 	.no_configdata = true,
 };
 
+static const struct sunxi_musb_cfg sun8i_a83t_musb_cfg = {
+	.hdrc_config = &sunxi_musb_hdrc_config_5eps,
+	.has_reset = true,
+	.no_configdata = true,
+	.has_idma = true,
+};
+
 static const struct sunxi_musb_cfg sun8i_h3_musb_cfg = {
 	.hdrc_config = &sunxi_musb_hdrc_config_4eps,
 	.has_reset = true,
@@ -1401,6 +1408,8 @@ static const struct of_device_id sunxi_musb_match[] = {
 	  .data = &sun6i_a31_musb_cfg, },
 	{ .compatible = "allwinner,sun8i-a33-musb",
 	  .data = &sun8i_a33_musb_cfg, },
+	{ .compatible = "allwinner,sun8i-a83t-musb",
+	  .data = &sun8i_a83t_musb_cfg, },
 	{ .compatible = "allwinner,sun8i-h3-musb",
 	  .data = &sun8i_h3_musb_cfg, },
 	{ .compatible = "allwinner,sun50i-a64-musb",
-- 
