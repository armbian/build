From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ondrej Jirman <megi@xff.cz>
Date: Tue, 18 Aug 2026 21:36:14 +0200
Subject: ARM: dts: sun8i-a83t-tbs-a711: Use edge IRQ for the NFC controller

The PN547 NFC controller drives its IRQ line as a rising edge, asserted
when it has data for the host - that is how the vendor stack treats it,
and the nxp-nci driver forces IRQF_TRIGGER_RISING on ACPI for the same
reason. The A711 node instead declared it IRQ_TYPE_LEVEL_HIGH, which on a
marginal line lets the level re-trigger the oneshot handler into reads
that find no data ("NFC: Read failed with error -6" storms). Describe it
as IRQ_TYPE_EDGE_RISING to match the part.

Signed-off-by: Ondrej Jirman <megi@xff.cz>
---
 arch/arm/boot/dts/allwinner/sun8i-a83t-tbs-a711.dts | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/arch/arm/boot/dts/allwinner/sun8i-a83t-tbs-a711.dts b/arch/arm/boot/dts/allwinner/sun8i-a83t-tbs-a711.dts
index 111111111111..222222222222 100644
--- a/arch/arm/boot/dts/allwinner/sun8i-a83t-tbs-a711.dts
+++ b/arch/arm/boot/dts/allwinner/sun8i-a83t-tbs-a711.dts
@@ -377,7 +377,7 @@ npc100: nfc@28 {
 		compatible = "nxp,nxp-nci-i2c";
 		reg = <0x28>;
 		interrupt-parent = <&r_pio>;
-		interrupts = <0 6 IRQ_TYPE_LEVEL_HIGH>; /* PL6 */
+		interrupts = <0 6 IRQ_TYPE_EDGE_RISING>; /* PL6 */
 		enable-gpios = <&pio 3 2 GPIO_ACTIVE_HIGH>; /* PD2 */
 		firmware-gpios = <&pio 3 3 GPIO_ACTIVE_HIGH>; /* PD3 */
 	};
-- 
