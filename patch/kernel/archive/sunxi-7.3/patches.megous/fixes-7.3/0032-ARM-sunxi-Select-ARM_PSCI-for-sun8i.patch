From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ondrej Jirman <megi@xff.cz>
Date: Thu, 3 Sep 2026 20:47:19 +0200
Subject: ARM: sunxi: Select ARM_PSCI for sun8i

H3 boards boot with U-Boot's PSCI, and A83T can now be booted through a
PSCI monitor as well. Until now ARM_PSCI only came in through MACH_SUN7I
(default y), so a sun8i-only configuration would silently lose SMP.

Signed-off-by: Ondrej Jirman <megi@xff.cz>
---
 arch/arm/mach-sunxi/Kconfig | 1 +
 1 file changed, 1 insertion(+)

diff --git a/arch/arm/mach-sunxi/Kconfig b/arch/arm/mach-sunxi/Kconfig
index 111111111111..222222222222 100644
--- a/arch/arm/mach-sunxi/Kconfig
+++ b/arch/arm/mach-sunxi/Kconfig
@@ -60,6 +60,7 @@ config MACH_SUN8I
 	bool "Allwinner sun8i Family SoCs support"
 	default ARCH_SUNXI
 	select ARM_GIC
+	select ARM_PSCI
 	select MFD_SUN6I_PRCM
 	select SUN6I_R_INTC
 	select SUNXI_NMI_INTC
-- 
Armbian

