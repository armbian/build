From 501c14475484d0544fd1115cb23b4a26333f911a Mon Sep 17 00:00:00 2001
From: Ondrej Jirman <megi@xff.cz>
Date: Fri, 4 Sep 2026 22:46:20 +0200
Subject: [PATCH 33/35] rtc: ac100: Allow the alarm to wake the system

The AC100's alarm interrupt reaches the SoC on the NMI line, which
r_intc keeps alive across a system suspend, and on the A83T this is the
only RTC there is -- but the device was never marked wakeup capable, so
/sys/class/rtc/rtc0/device/power/wakeup does not exist and rtcwake
refuses to arm anything:

  rtcwake: /dev/rtc0 not enabled for wakeup events

Mark it wakeup capable and hold the interrupt awake across suspend, as
rtc-sun6i does for the SoC RTC on the other parts.

Signed-off-by: Ondrej Jirman <megi@xff.cz>
---
 drivers/rtc/rtc-ac100.c | 40 ++++++++++++++++++++++++++++++++++++++++
 1 file changed, 40 insertions(+)

diff --git a/drivers/rtc/rtc-ac100.c b/drivers/rtc/rtc-ac100.c
index c579c4bf5578..a27f85363fd9 100644
--- a/drivers/rtc/rtc-ac100.c
+++ b/drivers/rtc/rtc-ac100.c
@@ -17,6 +17,8 @@
 #include <linux/mutex.h>
 #include <linux/of.h>
 #include <linux/platform_device.h>
+#include <linux/pm.h>
+#include <linux/pm_wakeup.h>
 #include <linux/regmap.h>
 #include <linux/rtc.h>
 #include <linux/types.h>
@@ -575,6 +577,14 @@ static int ac100_rtc_probe(struct platform_device *pdev)
 
 	chip->rtc->ops = &ac100_rtc_ops;
 
+	/*
+	 * The alarm is wired to the NMI/R_INTC line, which stays alive
+	 * across a system suspend, so the RTC can wake the system.
+	 */
+	ret = devm_device_init_wakeup(&pdev->dev);
+	if (ret)
+		return ret;
+
 	ret = devm_request_threaded_irq(&pdev->dev, chip->irq, NULL,
 					ac100_rtc_irq,
 					IRQF_SHARED | IRQF_ONESHOT,
@@ -601,6 +611,35 @@ static int ac100_rtc_probe(struct platform_device *pdev)
 	return devm_rtc_register_device(chip->rtc);
 }
 
+#ifdef CONFIG_PM_SLEEP
+
+/* Enable IRQ wake on suspend, to wake up from the RTC alarm. */
+static int ac100_rtc_suspend(struct device *dev)
+{
+	struct ac100_rtc_dev *chip = dev_get_drvdata(dev);
+
+	if (device_may_wakeup(dev))
+		enable_irq_wake(chip->irq);
+
+	return 0;
+}
+
+/* Disable IRQ wake on resume. */
+static int ac100_rtc_resume(struct device *dev)
+{
+	struct ac100_rtc_dev *chip = dev_get_drvdata(dev);
+
+	if (device_may_wakeup(dev))
+		disable_irq_wake(chip->irq);
+
+	return 0;
+}
+
+#endif
+
+static SIMPLE_DEV_PM_OPS(ac100_rtc_pm_ops,
+	ac100_rtc_suspend, ac100_rtc_resume);
+
 static const struct of_device_id ac100_rtc_match[] = {
 	{ .compatible = "x-powers,ac100-rtc" },
 	{ },
@@ -612,6 +651,7 @@ static struct platform_driver ac100_rtc_driver = {
 	.driver		= {
 		.name		= "ac100-rtc",
 		.of_match_table	= of_match_ptr(ac100_rtc_match),
+		.pm		= &ac100_rtc_pm_ops,
 	},
 };
 module_platform_driver(ac100_rtc_driver);
-- 
