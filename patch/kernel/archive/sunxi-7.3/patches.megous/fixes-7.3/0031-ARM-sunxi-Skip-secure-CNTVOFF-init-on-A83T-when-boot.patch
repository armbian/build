From 203961097712fce4bd54fb99e77c2c0821031d80 Mon Sep 17 00:00:00 2001
From: Ondrej Jirman <megi@xff.cz>
Date: Thu, 3 Sep 2026 20:47:18 +0200
Subject: [PATCH 31/35] ARM: sunxi: Skip secure CNTVOFF init on A83T when
 booted via PSCI

The A83T machine descriptor matches the SoC compatible and its
init_early hook calls secure_cntvoff_init() unconditionally. That
function switches to monitor mode and writes SCR and CNTVOFF, which
works only in the secure world.

When the bootloader provides PSCI (and the kernel therefore runs
non-secure), the cores' CNTVOFF is the firmware's business and the
kernel would take an undefined instruction exception in setup_arch()
before the console is up. Skip it when a PSCI cpu_on is available,
which is exactly the case where firmware brought us up non-secure.

Signed-off-by: Ondrej Jirman <megi@xff.cz>
---
 arch/arm/mach-sunxi/sunxi.c | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/arch/arm/mach-sunxi/sunxi.c b/arch/arm/mach-sunxi/sunxi.c
index e1b7945aac99..ec29f16c5986 100644
--- a/arch/arm/mach-sunxi/sunxi.c
+++ b/arch/arm/mach-sunxi/sunxi.c
@@ -15,6 +15,7 @@
 #include <linux/reset/sunxi.h>
 
 #include <asm/mach/arch.h>
+#include <asm/psci.h>
 #include <asm/secure_cntvoff.h>
 
 static const char * const sunxi_board_dt_compat[] = {
@@ -77,6 +78,14 @@ MACHINE_END
 static void __init sun8i_a83t_cntvoff_init(void)
 {
 #ifdef CONFIG_SMP
+	/*
+	 * With PSCI firmware the kernel runs non-secure and CNTVOFF is
+	 * the firmware's to set up; the secure-only accesses below would
+	 * be undefined instructions.
+	 */
+	if (psci_smp_available())
+		return;
+
 	secure_cntvoff_init();
 #endif
 }
