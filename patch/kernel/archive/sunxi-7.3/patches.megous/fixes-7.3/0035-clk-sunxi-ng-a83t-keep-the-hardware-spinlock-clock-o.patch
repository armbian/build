From 308f3aab91b83d8c775a04d5056ebba4fe51f5bc Mon Sep 17 00:00:00 2001
From: Ondrej Jirman <megi@xff.cz>
Date: Sun, 6 Sep 2026 12:47:25 +0200
Subject: [PATCH 35/35] clk: sunxi-ng: a83t: keep the hardware spinlock clock
 on

Nothing claims this block.  It has no device tree node, so the gate has
no consumer, and clk_disable_unused() switches it off during boot.

That did not matter until the GIC quirk on this SoC started taking lock
31 to keep its accesses from overlapping the secure monitor's CPUCFG
accesses.  A gated APB block reads back zero, and zero is what that
protocol means by "the lock is now yours": gated, the lock grants itself
to every caller at once and serialises nothing, with no error anywhere.

Measured on a TBS A711 with the firmware enabling the gate at boot: 0x064
bit 22 clear again by the time userspace is up, and lock 31 at 0x01c1817c
reading 0 on every take.

Signed-off-by: Ondrej Jirman <megi@xff.cz>
---
 drivers/clk/sunxi-ng/ccu-sun8i-a83t.c | 12 +++++++++++-
 1 file changed, 11 insertions(+), 1 deletion(-)

diff --git a/drivers/clk/sunxi-ng/ccu-sun8i-a83t.c b/drivers/clk/sunxi-ng/ccu-sun8i-a83t.c
index 60e918965a72..bc7495d90023 100644
--- a/drivers/clk/sunxi-ng/ccu-sun8i-a83t.c
+++ b/drivers/clk/sunxi-ng/ccu-sun8i-a83t.c
@@ -341,8 +341,18 @@ static SUNXI_CCU_GATE(bus_gpu_clk,	"bus-gpu",	"ahb1",
 		      0x064, BIT(20), 0);
 static SUNXI_CCU_GATE(bus_msgbox_clk,	"bus-msgbox",	"ahb1",
 		      0x064, BIT(21), 0);
+/*
+ * Nothing in the device tree claims the hardware spinlock, so this gate
+ * has no consumer and clk_disable_unused() switches it off during boot.
+ * The GIC quirk on this SoC takes lock 31 to keep its accesses from
+ * overlapping the secure monitor's CPUCFG accesses, and a gated block
+ * reads back zero -- which is what that protocol means by "the lock is
+ * now yours".  Gated, the lock grants itself to every caller at once and
+ * serialises nothing, silently.  Measured on a TBS A711: 0x064 bit 22
+ * clear once userspace is up, lock 31 reading 0 every time.
+ */
 static SUNXI_CCU_GATE(bus_spinlock_clk,	"bus-spinlock",	"ahb1",
-		      0x064, BIT(22), 0);
+		      0x064, BIT(22), CLK_IS_CRITICAL);
 
 static SUNXI_CCU_GATE(bus_spdif_clk,	"bus-spdif",	"apb1",
 		      0x068, BIT(1), 0);
