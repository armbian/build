From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ondrej Jirman <megi@xff.cz>
Date: Sat, 25 Jul 2026 21:56:01 +0200
Subject: clk: sunxi-ng: a64: Set CPUX PLL constraints per the datasheet

The A64 datasheet limits N*K to the 10..88 range and allows use of the
P divider only when the PLL output is below 240 MHz.

Fix the M/P factors (dividers) on A64 CPUX PLL clock, this matches the
BSP CPUX PLL factors table which never uses the pre-divider M. Optimize
the CPUX PLL rate change speed to ~ 300 us by avoiding switching to 24
MHz oscillator and avoiding PLL restarts.

Signed-off-by: Ondrej Jirman <megi@xff.cz>
---
 drivers/clk/sunxi-ng/ccu-sun50i-a64.c | 10 ++++++++--
 1 file changed, 8 insertions(+), 2 deletions(-)

diff --git a/drivers/clk/sunxi-ng/ccu-sun50i-a64.c b/drivers/clk/sunxi-ng/ccu-sun50i-a64.c
index 111111111111..222222222222 100644
--- a/drivers/clk/sunxi-ng/ccu-sun50i-a64.c
+++ b/drivers/clk/sunxi-ng/ccu-sun50i-a64.c
@@ -28,8 +28,12 @@ static struct ccu_nkmp pll_cpux_clk = {
 	.lock		= BIT(28),
 	.n		= _SUNXI_CCU_MULT(8, 5),
 	.k		= _SUNXI_CCU_MULT(4, 2),
-	.m		= _SUNXI_CCU_DIV(0, 2),
-	.p		= _SUNXI_CCU_DIV_MAX(16, 2, 4),
+	.m		= _SUNXI_CCU_DIV_MAX(0, 2, 1),
+	.p		= _SUNXI_CCU_DIV_MAX(16, 2, 1),
+	/* Per the A64 datasheet: VCO range, P usable below 240 MHz only. */
+	.min_nk		= 10,
+	.max_nk		= 88,
+	.max_p_rate	= 240000000,
 	.common		= {
 		.reg		= 0x000,
 		.hw.init	= CLK_HW_INIT("pll-cpux",
@@ -953,6 +957,7 @@ static struct ccu_pll_nb sun50i_a64_pll_cpu_nb = {
 	/* copy from pll_cpux_clk */
 	.enable	= BIT(31),
 	.lock	= BIT(28),
+	.once	= 1,
 };
 
 static struct ccu_mux_nb sun50i_a64_cpu_nb = {
@@ -960,6 +965,7 @@ static struct ccu_mux_nb sun50i_a64_cpu_nb = {
 	.cm		= &cpux_clk.mux,
 	.delay_us	= 1, /* > 8 clock cycles at 24 MHz */
 	.bypass_index	= 1, /* index of 24 MHz oscillator */
+	.once		= 1,
 };
 
 static int sun50i_a64_ccu_probe(struct platform_device *pdev)
-- 
