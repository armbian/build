From 4a0c0d7c45b9a4a961ae9c05a6bd02545f985837 Mon Sep 17 00:00:00 2001
From: Ondrej Jirman <megi@xff.cz>
Date: Mon, 12 Oct 2026 20:43:27 +0200
Subject: [PATCH] ASoC: ac100-codec: Register the component with
 snd_soc_register_component()

snd_soc_component_initialize() and snd_soc_add_component() are no
longer exported (7050ee33c2db8). Set the component device and use the
snd_soc_register_component() variant for embedded components instead.

Signed-off-by: Ondrej Jirman <megi@xff.cz>
---
 sound/soc/sunxi/ac100-codec.c | 11 ++++-------
 1 file changed, 4 insertions(+), 7 deletions(-)

diff --git a/sound/soc/sunxi/ac100-codec.c b/sound/soc/sunxi/ac100-codec.c
index dd30531a3965..d524cd854aa6 100644
--- a/sound/soc/sunxi/ac100-codec.c
+++ b/sound/soc/sunxi/ac100-codec.c
@@ -995,15 +995,12 @@ static int ac100_codec_probe(struct platform_device *pdev)
 	codec->dev = &pdev->dev;
 	platform_set_drvdata(pdev, codec);
 
+	codec->component.dev = &pdev->dev;
 	snd_soc_component_init_regmap(&codec->component, ac100->regmap);
 
-	ret = snd_soc_component_initialize(&codec->component,
-					   &ac100_codec_analog_cmpnt_drv,
-					   &pdev->dev);
-	if (ret < 0)
-		return ret;
-
-	ret = snd_soc_add_component(&codec->component, NULL, 0);
+	ret = snd_soc_register_component(&codec->component,
+					 &ac100_codec_analog_cmpnt_drv,
+					 NULL, 0);
 	if (ret) {
 		dev_err(&pdev->dev,
 			"Failed to register codec component (%d)\n", ret);
-- 
2.43.0

