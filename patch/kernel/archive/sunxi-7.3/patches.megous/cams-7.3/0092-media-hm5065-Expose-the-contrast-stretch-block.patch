From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ondrej Jirman <megi@xff.cz>
Date: Sun, 2 Aug 2026 15:10:35 +0200
Subject: media: hm5065: Expose the contrast stretch block

The histogram stretching block was already described by the register
defines but never used. Enable it through the wide dynamic range
control; the stretch strength stays at the firmware defaults.

Signed-off-by: Ondrej Jirman <megi@xff.cz>
---
 drivers/media/i2c/hm5065.c | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/drivers/media/i2c/hm5065.c b/drivers/media/i2c/hm5065.c
index 111111111111..222222222222 100644
--- a/drivers/media/i2c/hm5065.c
+++ b/drivers/media/i2c/hm5065.c
@@ -562,6 +562,7 @@ struct hm5065_ctrls {
 	struct v4l2_ctrl *saturation;
 	struct v4l2_ctrl *contrast;
 	struct v4l2_ctrl *gamma;
+	struct v4l2_ctrl *wdr;
 	struct v4l2_ctrl *test_pattern;
 	struct v4l2_ctrl *test_data[4];
 };
@@ -1200,6 +1201,10 @@ static int hm5065_s_ctrl_do(struct hm5065_dev *sensor,
 		return cci_write(sensor->regmap, HM5065_REG_P0_GAMMA_GAIN, val,
 				 NULL);
 
+	case V4L2_CID_WIDE_DYNAMIC_RANGE:
+		return cci_write(sensor->regmap, HM5065_REG_CS_ENABLE,
+				 val ? 1 : 0, NULL);
+
 	case V4L2_CID_VFLIP:
 		return cci_write(sensor->regmap, HM5065_REG_VERTICAL_FLIP,
 				 val ? 1 : 0, NULL);
@@ -1356,6 +1361,10 @@ static int hm5065_init_controls(struct hm5065_dev *sensor)
 	ctrls->gamma = v4l2_ctrl_new_std(hdl, ops, V4L2_CID_GAMMA,
 					 0, 31, 1, 20);
 
+	/* the contrast stretch block */
+	ctrls->wdr = v4l2_ctrl_new_std(hdl, ops, V4L2_CID_WIDE_DYNAMIC_RANGE,
+				       0, 1, 1, 0);
+
 	ctrls->colorfx =
 		v4l2_ctrl_new_std_menu(hdl, ops, V4L2_CID_COLORFX, 15,
 				       ~(BIT(V4L2_COLORFX_NONE) |
-- 
Armbian

