-	step = gc2145_params_flicker_step(&params, sensor->power_line_freq,
-					  GC2145_PCLK_RATE);
-
-	gc2145_tx_write16(sensor, GC2145_P1_AEC_ANTI_FLICKER_HI, step);
-
-	/*
-	 * The seven exposure levels are the gears the AEC drops through as
-	 * the light goes, each one stretching the frame further than the
-	 * last. They only avoid flicker if they are whole multiples of the
-	 * step above, so start at the first multiple that covers a frame
