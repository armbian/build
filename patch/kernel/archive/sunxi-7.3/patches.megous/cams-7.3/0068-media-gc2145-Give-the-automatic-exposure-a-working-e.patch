 	if (!pix_fmt) {
@@ -2235,42 +2321,11 @@ static int gc2145_setup_mode(struct gc2145_dev *sensor,
 	if (ret)
 		return ret;
 
-	gc2145_tx_start(sensor);
-
-	/*
