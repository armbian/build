From db752eea4e47a6631620ef293fa5e51673bf6a4d Mon Sep 17 00:00:00 2001
From: Arun Iyengar <aiyengar1990@gmail.com>
Date: Mon, 2 Nov 2026 17:51:22 +0000
Subject: media: cedrus: report only the picture as capture payload

For 10-bit H.265 and VP9 the driver appends private reconstruction
surfaces to every capture buffer (the low-2-bit plane, and for P010 the
hidden 8-bit NV12 reconstruction) and accounts for them in sizeimage via
the extra_cap_size op. buf_prepare then set bytesused to the full
sizeimage, so userspace that copies the payload got 1.625 times a P010
frame per buffer: on the Orange Pi Zero2 (H616) a 3840x2160 P010 buffer
came out of GStreamer as 40435200 bytes instead of 24883200.

Keep sizeimage (the allocation size) as it is and report only the
picture as payload.

Signed-off-by: Arun Iyengar <aiyengar1990@gmail.com>
---
 drivers/staging/media/sunxi/cedrus/cedrus_video.c | 15 ++++++++++++---
 1 file changed, 12 insertions(+), 3 deletions(-)

diff --git a/drivers/staging/media/sunxi/cedrus/cedrus_video.c b/drivers/staging/media/sunxi/cedrus/cedrus_video.c
index 111111111111..222222222222 100644
--- a/drivers/staging/media/sunxi/cedrus/cedrus_video.c
+++ b/drivers/staging/media/sunxi/cedrus/cedrus_video.c
@@ -680,10 +680,19 @@ static int cedrus_buf_prepare(struct vb2_buffer *vb)
 	/*
 	 * Buffer's bytesused must be written by driver for CAPTURE buffers.
 	 * (for OUTPUT buffers, if userspace passes 0 bytesused, v4l2-core sets
-	 * it to buffer length).
+	 * it to buffer length). The private space the decoder appends to a
+	 * capture buffer (the 10-bit reconstruction planes) is not part of
+	 * the picture, so it is not reported as payload.
 	 */
-	if (V4L2_TYPE_IS_CAPTURE(vq->type))
-		vb2_set_plane_payload(vb, 0, pix_fmt->sizeimage);
+	if (V4L2_TYPE_IS_CAPTURE(vq->type)) {
+		unsigned int payload = pix_fmt->sizeimage;
+
+		if (ctx->current_codec && ctx->current_codec->extra_cap_size)
+			payload -= ctx->current_codec->extra_cap_size(ctx,
+								     pix_fmt);
+
+		vb2_set_plane_payload(vb, 0, payload);
+	}
 
 	return 0;
 }
