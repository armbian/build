From a839bc5efa6ade316cf9aa1e8df24d561c03c8e1 Mon Sep 17 00:00:00 2001
From: Arun Iyengar <aiyengar1990@gmail.com>
Date: Mon, 2 Nov 2026 17:19:49 +0000
Subject: media: cedrus: keep 8-bit H.265 AFBC behind the linear
 capture formats

On variants with CEDRUS_CAPABILITY_H265_10_DEC (H6, and H616 once the
P010 work enables it there), the 8-bit AFBC format is the first capture
format that matches an 8-bit H.265 context, so it becomes the default
returned by G_FMT after S_FMT on the OUTPUT queue. Userspace that does
not know AFBC then cannot decode 8-bit H.265 at all: GStreamer
v4l2codecs falls back to the driver default and fails with "Unsupported
V4L2 pixelformat AS12" (seen on the Orange Pi Zero2, H616).

8-bit H.265 has the native tiled format and the linear formats, so make
8-bit AFBC opt-in through S_FMT like the VP9 AFBC formats. Keep the
10-bit AFBC entry ahead of P010: 10-bit has no native format, and GStreamer
already negotiates P010 explicitly in that case.

Assisted-by: LLM
Signed-off-by: Arun Iyengar <aiyengar1990@gmail.com>
---
 .../staging/media/sunxi/cedrus/cedrus_video.c | 23 ++++++++++++-------
 1 file changed, 15 insertions(+), 8 deletions(-)

diff --git a/drivers/staging/media/sunxi/cedrus/cedrus_video.c b/drivers/staging/media/sunxi/cedrus/cedrus_video.c
index 111111111111..222222222222 100644
--- a/drivers/staging/media/sunxi/cedrus/cedrus_video.c
+++ b/drivers/staging/media/sunxi/cedrus/cedrus_video.c
@@ -90,14 +90,6 @@ static struct cedrus_format cedrus_formats[] = {
 		.depth		= 10,
 		.src_format	= V4L2_PIX_FMT_HEVC_SLICE,
 	},
-	{
-		.pixelformat	= V4L2_PIX_FMT_YUV420_8_AFBC_16X16_SPLIT,
-		.directions	= CEDRUS_DECODE_DST,
-		.capabilities	= CEDRUS_CAPABILITY_UNTILED |
-				  CEDRUS_CAPABILITY_H265_10_DEC,
-		.depth		= 8,
-		.src_format	= V4L2_PIX_FMT_HEVC_SLICE,
-	},
 	{
 		.pixelformat	= V4L2_PIX_FMT_NV12,
 		.directions	= CEDRUS_DECODE_DST,
@@ -122,6 +114,21 @@ static struct cedrus_format cedrus_formats[] = {
 		.directions	= CEDRUS_DECODE_DST,
 		.capabilities	= CEDRUS_CAPABILITY_UNTILED,
 	},
+	/*
+	 * 8-bit AFBC for H.265 is opt-in as well: 8-bit H.265 already has the
+	 * native tiled and the linear formats above, and an AFBC default makes
+	 * generic userspace (GStreamer v4l2codecs) fail to negotiate. The
+	 * 10-bit AFBC entry stays ahead of P010, as 10-bit has no native
+	 * format and P010 costs a full extra 16-bit plane write per frame.
+	 */
+	{
+		.pixelformat	= V4L2_PIX_FMT_YUV420_8_AFBC_16X16_SPLIT,
+		.directions	= CEDRUS_DECODE_DST,
+		.capabilities	= CEDRUS_CAPABILITY_UNTILED |
+				  CEDRUS_CAPABILITY_H265_10_DEC,
+		.depth		= 8,
+		.src_format	= V4L2_PIX_FMT_HEVC_SLICE,
+	},
 	/*
 	 * AFBC-compressed output. Only wired up for VP9 (H616) so far and
 	 * opt-in: placed after the plain formats so P010/NV12 stay the
