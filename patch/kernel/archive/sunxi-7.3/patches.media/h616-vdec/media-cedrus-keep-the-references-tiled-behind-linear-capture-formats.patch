From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Arun Iyengar <aiyengar1990@gmail.com>
Date: Sun, 15 Nov 2026 20:00:00 +0000
Subject: [PATCH] media: cedrus: keep the references tiled behind linear
 capture formats

With a linear capture format (NV12, NV21, YU12, YV12) the primary
output writes the picture linear, and the decoders read it back as a
reference. Motion compensation from linear references is several times
slower.

On the H616, decode 8-bit pictures into a hidden NV12_32L32 surface
appended to the capture buffer, as is already done with an AFBC surface
for P010, and let the secondary output write the visible picture, as
the vendor library does. The MPEG engine must then write back its
reconstruction (MC_NO_WRITEBACK cleared), or P and B pictures read
stale references. This covers every decoder. The tiled, AFBC and P010
formats are unchanged.

A 4K H.265 picture in NV12 now takes 23.7 ms (67 ms before, 19.4 ms in
NV12_32L32). The cost is memory: a linear capture buffer is about twice
as large (4K NV12: 12.4 MB -> 25.0 MB of IOMMU-mapped system memory).

Assisted-by: LLM
Signed-off-by: Arun Iyengar <aiyengar1990@gmail.com>
---
 drivers/staging/media/sunxi/cedrus/cedrus.c       |   1 +
 drivers/staging/media/sunxi/cedrus/cedrus.h       | 100 ++++++++++++++++++----
 drivers/staging/media/sunxi/cedrus/cedrus_dec.c   |   9 +-
 drivers/staging/media/sunxi/cedrus/cedrus_h264.c  |  18 ++--
 drivers/staging/media/sunxi/cedrus/cedrus_h265.c  |  11 ++-
 drivers/staging/media/sunxi/cedrus/cedrus_hw.c    |  62 ++++++++++++++
 drivers/staging/media/sunxi/cedrus/cedrus_hw.h    |   6 ++
 drivers/staging/media/sunxi/cedrus/cedrus_mpeg2.c |  19 ++--
 drivers/staging/media/sunxi/cedrus/cedrus_mpeg4.c |  19 ++--
 drivers/staging/media/sunxi/cedrus/cedrus_regs.h  |   5 ++
 drivers/staging/media/sunxi/cedrus/cedrus_vc1.c   |  19 ++--
 drivers/staging/media/sunxi/cedrus/cedrus_video.c |   7 +-
 drivers/staging/media/sunxi/cedrus/cedrus_vp8.c   |  14 +--
 drivers/staging/media/sunxi/cedrus/cedrus_vp9.c   |  23 ++++-
 14 files changed, 259 insertions(+), 54 deletions(-)

diff --git a/drivers/staging/media/sunxi/cedrus/cedrus.c b/drivers/staging/media/sunxi/cedrus/cedrus.c
index aac0ec9..6b817c6 100644
--- a/drivers/staging/media/sunxi/cedrus/cedrus.c
+++ b/drivers/staging/media/sunxi/cedrus/cedrus.c
@@ -1010,6 +1010,7 @@ static const struct cedrus_variant sun50i_h616_cedrus_variant = {
 	/* H.265 Main10@L5.1, up to 6K (H616 user manual, 4.4.1). */
 	.h265_max_width	= 6144,
 	.h265_max_height = 4320,
+	.linear_out_secondary = true,
 };
 
 static const struct of_device_id cedrus_dt_match[] = {
diff --git a/drivers/staging/media/sunxi/cedrus/cedrus.h b/drivers/staging/media/sunxi/cedrus/cedrus.h
index 6fa169d..555e7d8 100644
--- a/drivers/staging/media/sunxi/cedrus/cedrus.h
+++ b/drivers/staging/media/sunxi/cedrus/cedrus.h
@@ -309,6 +309,11 @@ struct cedrus_variant {
 	 * those, which would otherwise fail with -ENOENT (no allwinner,sram).
 	 */
 	bool		quirk_no_sram;
+	/*
+	 * The secondary output writes the linear capture formats while the
+	 * references stay tiled, see cedrus_fmt_is_tiled_behind().
+	 */
+	bool		linear_out_secondary;
 };
 
 struct cedrus_dev {
@@ -338,6 +343,7 @@ struct cedrus_dev {
 	u32			ve_mode_ddr;
 	unsigned int		h265_max_width;
 	unsigned int		h265_max_height;
+	bool			linear_out_secondary;
 
 	struct delayed_work	watchdog_work;
 };
@@ -430,6 +436,37 @@ static inline bool cedrus_recon_is_afbc(struct cedrus_ctx *ctx)
 	return cedrus_dst_is_afbc(ctx) || cedrus_dst_is_p010(ctx);
 }
 
+static inline bool cedrus_is_linear_format(u32 format)
+{
+	switch (format) {
+	case V4L2_PIX_FMT_NV12:
+	case V4L2_PIX_FMT_NV21:
+	case V4L2_PIX_FMT_YUV420:
+	case V4L2_PIX_FMT_YVU420:
+		return true;
+	default:
+		return false;
+	}
+}
+
+/*
+ * 8-bit pictures in a linear capture format: the primary output writes
+ * the picture into a hidden NV12_32L32 surface behind the visible one,
+ * which the decoders read as the reference, and the secondary output
+ * writes the visible picture, as the vendor library does.
+ */
+static inline bool cedrus_fmt_is_tiled_behind(struct cedrus_ctx *ctx,
+					      const struct v4l2_pix_format *fmt)
+{
+	return ctx->dev->linear_out_secondary && ctx->bit_depth <= 8 &&
+	       cedrus_is_linear_format(fmt->pixelformat);
+}
+
+static inline bool cedrus_dst_is_tiled_behind(struct cedrus_ctx *ctx)
+{
+	return cedrus_fmt_is_tiled_behind(ctx, &ctx->dst_fmt);
+}
+
 /*
  * H.265 10-bit pictures from 5K up (the vendor library's threshold: 5120
  * wide or 2880 high) can be written at half their size in each direction
@@ -469,17 +506,44 @@ static inline u32 cedrus_afbc_10_size(unsigned int width, unsigned int height)
 
 /*
  * Offset of the hidden reconstruction surface, which follows the
- * userspace-visible P010 surface at the start of the buffer.
+ * userspace-visible P010 or linear 8-bit surface at the start of the
+ * buffer.
  */
-static inline u32 cedrus_p010_recon_offset(const struct v4l2_pix_format *fmt)
+static inline u32 cedrus_recon_offset(const struct v4l2_pix_format *fmt)
 {
 	return ALIGN(fmt->bytesperline * fmt->height * 3 / 2, SZ_4K);
 }
 
+/* Layout of the NV12_32L32 surface of a picture, as cedrus_prepare_format(). */
+static inline void cedrus_tiled_fmt(struct v4l2_pix_format *fmt)
+{
+	fmt->pixelformat = V4L2_PIX_FMT_NV12_32L32;
+	fmt->bytesperline = ALIGN(fmt->width, 32);
+	fmt->height = ALIGN(fmt->height, 32);
+	fmt->sizeimage = fmt->bytesperline * fmt->height +
+			 fmt->bytesperline * ALIGN(fmt->height, 64) / 2;
+}
+
+static inline unsigned int
+cedrus_dst_tiled_behind_size(struct cedrus_ctx *ctx,
+			     const struct v4l2_pix_format *fmt)
+{
+	struct v4l2_pix_format tiled = *fmt;
+
+	if (!cedrus_fmt_is_tiled_behind(ctx, fmt))
+		return 0;
+
+	cedrus_tiled_fmt(&tiled);
+
+	return cedrus_recon_offset(fmt) -
+	       fmt->bytesperline * fmt->height * 3 / 2 + tiled.sizeimage;
+}
+
 /*
  * Format describing the reconstruction/reference surface.  For P010
  * output this is a hidden 10-bit AFBC surface that follows the visible
- * P010 data; otherwise it is the capture format itself.
+ * P010 data, for cedrus_fmt_is_tiled_behind() a hidden NV12_32L32
+ * surface; otherwise it is the capture format itself.
  *
  * A linear 8-bit NV12 + 2-bit reconstruction would also work, but motion
  * compensation from linear references is slow (several times the read
@@ -487,13 +551,16 @@ static inline u32 cedrus_p010_recon_offset(const struct v4l2_pix_format *fmt)
  * on the H616. AFBC references are read compressed.
  */
 static inline struct v4l2_pix_format
-cedrus_dst_frame_fmt_of(const struct v4l2_pix_format *dst_fmt)
+cedrus_dst_frame_fmt_of(struct cedrus_ctx *ctx,
+			const struct v4l2_pix_format *dst_fmt)
 {
 	struct v4l2_pix_format fmt = *dst_fmt;
 
 	if (fmt.pixelformat == V4L2_PIX_FMT_P010) {
 		fmt.pixelformat = V4L2_PIX_FMT_YUV420_10_AFBC_16X16_SPLIT;
 		fmt.bytesperline = 0;
+	} else if (cedrus_fmt_is_tiled_behind(ctx, dst_fmt)) {
+		cedrus_tiled_fmt(&fmt);
 	}
 
 	return fmt;
@@ -501,7 +568,7 @@ cedrus_dst_frame_fmt_of(const struct v4l2_pix_format *dst_fmt)
 
 static inline struct v4l2_pix_format cedrus_dst_frame_fmt(struct cedrus_ctx *ctx)
 {
-	struct v4l2_pix_format fmt = cedrus_dst_frame_fmt_of(&ctx->dst_fmt);
+	struct v4l2_pix_format fmt = cedrus_dst_frame_fmt_of(ctx, &ctx->dst_fmt);
 
 	/* The references of a scaled-down output have the coded size. */
 	if (cedrus_fmt_is_scaled(ctx, &ctx->dst_fmt)) {
@@ -514,23 +581,24 @@ static inline struct v4l2_pix_format cedrus_dst_frame_fmt(struct cedrus_ctx *ctx
 
 /*
  * Address of a plane of the reconstruction/reference surface of a buffer
- * laid out as @dst_fmt.  Identical to cedrus_buf_addr() for non-P010
- * output; for P010 it points past the visible P010 data to the hidden
- * AFBC surface (which has a single plane).
+ * laid out as @dst_fmt.  Identical to cedrus_buf_addr() unless the
+ * surface is hidden: then it points past the visible picture to the
+ * hidden AFBC (a single plane) or NV12_32L32 surface.
  */
 static inline dma_addr_t
-cedrus_dst_frame_addr_in(const struct v4l2_pix_format *dst_fmt,
+cedrus_dst_frame_addr_in(struct cedrus_ctx *ctx,
+			 const struct v4l2_pix_format *dst_fmt,
 			 struct vb2_buffer *buf, unsigned int plane)
 {
-	struct v4l2_pix_format fmt = cedrus_dst_frame_fmt_of(dst_fmt);
+	struct v4l2_pix_format fmt = cedrus_dst_frame_fmt_of(ctx, dst_fmt);
 	dma_addr_t addr;
 
 	if (!buf)
 		return 0;
 
 	addr = vb2_dma_contig_plane_dma_addr(buf, 0);
-	if (dst_fmt->pixelformat == V4L2_PIX_FMT_P010)
-		addr += cedrus_p010_recon_offset(dst_fmt);
+	if (fmt.pixelformat != dst_fmt->pixelformat)
+		addr += cedrus_recon_offset(dst_fmt);
 
 	return addr + (dma_addr_t)fmt.bytesperline * fmt.height * plane;
 }
@@ -540,7 +608,7 @@ static inline dma_addr_t cedrus_dst_frame_addr(struct cedrus_ctx *ctx,
 					       struct vb2_buffer *buf,
 					       unsigned int plane)
 {
-	return cedrus_dst_frame_addr_in(&ctx->dst_fmt, buf, plane);
+	return cedrus_dst_frame_addr_in(ctx, &ctx->dst_fmt, buf, plane);
 }
 
 /*
@@ -578,7 +646,7 @@ cedrus_dst_10bit_extra_size(struct cedrus_ctx *ctx,
 		}
 
 		/* Hidden AFBC reconstruction surface, 4 KiB aligned. */
-		return cedrus_p010_recon_offset(pix_fmt) - visible +
+		return cedrus_recon_offset(pix_fmt) - visible +
 		       cedrus_afbc_10_size(width, height);
 	}
 
@@ -596,8 +664,8 @@ static inline void cedrus_write_ref_buf_addr(struct cedrus_ctx *ctx,
 	struct cedrus_dev *dev = ctx->dev;
 	struct vb2_buffer *buf = vb2_find_buffer(q, timestamp);
 
-	cedrus_write(dev, luma_reg, cedrus_dst_buf_addr(ctx, buf, 0));
-	cedrus_write(dev, chroma_reg, cedrus_dst_buf_addr(ctx, buf, 1));
+	cedrus_write(dev, luma_reg, cedrus_dst_frame_addr(ctx, buf, 0));
+	cedrus_write(dev, chroma_reg, cedrus_dst_frame_addr(ctx, buf, 1));
 }
 
 static inline struct cedrus_buffer *
diff --git a/drivers/staging/media/sunxi/cedrus/cedrus_dec.c b/drivers/staging/media/sunxi/cedrus/cedrus_dec.c
index 639c337..68bd6ae 100644
--- a/drivers/staging/media/sunxi/cedrus/cedrus_dec.c
+++ b/drivers/staging/media/sunxi/cedrus/cedrus_dec.c
@@ -185,7 +185,14 @@ void cedrus_device_run(void *priv)
 		reset_control_reset(dev->rstc);
 	dev->last_src_pixelformat = ctx->src_fmt.pixelformat;
 
-	cedrus_dst_format_set(dev, &ctx->dst_fmt);
+	if (cedrus_dst_is_tiled_behind(ctx)) {
+		struct v4l2_pix_format recon = cedrus_dst_frame_fmt(ctx);
+
+		cedrus_dst_format_set(dev, &recon);
+		cedrus_dst_tiled_behind_set(dev, &ctx->dst_fmt);
+	} else {
+		cedrus_dst_format_set(dev, &ctx->dst_fmt);
+	}
 
 	error = ctx->current_codec->setup(ctx, &run);
 	if (error)
diff --git a/drivers/staging/media/sunxi/cedrus/cedrus_h264.c b/drivers/staging/media/sunxi/cedrus/cedrus_h264.c
index 2dd7fed..914f13d 100644
--- a/drivers/staging/media/sunxi/cedrus/cedrus_h264.c
+++ b/drivers/staging/media/sunxi/cedrus/cedrus_h264.c
@@ -84,8 +84,8 @@ static void cedrus_fill_ref_pic(struct cedrus_ctx *ctx,
 		frame_info |= BIT(0) | BIT(4);
 	pic->frame_info = cpu_to_le32(frame_info);
 
-	pic->luma_ptr = cpu_to_le32(cedrus_buf_addr(vbuf, &ctx->dst_fmt, 0));
-	pic->chroma_ptr = cpu_to_le32(cedrus_buf_addr(vbuf, &ctx->dst_fmt, 1));
+	pic->luma_ptr = cpu_to_le32(cedrus_dst_frame_addr(ctx, vbuf, 0));
+	pic->chroma_ptr = cpu_to_le32(cedrus_dst_frame_addr(ctx, vbuf, 1));
 	pic->mv_col_top_ptr = cpu_to_le32(cedrus_h264_mv_col_buf_addr(buf, 0));
 	pic->mv_col_bot_ptr = cpu_to_le32(cedrus_h264_mv_col_buf_addr(buf, 1));
 }
@@ -486,10 +486,11 @@ static void cedrus_set_params(struct cedrus_ctx *ctx,
 	cedrus_write(dev, VE_H264_STATUS, cedrus_read(dev, VE_H264_STATUS));
 
 	// enable int
-	cedrus_write(dev, VE_H264_CTRL,
-		     VE_H264_CTRL_SLICE_DECODE_INT |
-		     VE_H264_CTRL_DECODE_ERR_INT |
-		     VE_H264_CTRL_VLD_DATA_REQ_INT);
+	reg = VE_H264_CTRL_SLICE_DECODE_INT | VE_H264_CTRL_DECODE_ERR_INT |
+	      VE_H264_CTRL_VLD_DATA_REQ_INT;
+	if (cedrus_dst_is_tiled_behind(ctx))
+		reg |= VE_H264_CTRL_WRITE_SDROT_PIC;
+	cedrus_write(dev, VE_H264_CTRL, reg);
 }
 
 static enum cedrus_irq_status
@@ -554,7 +555,10 @@ static int cedrus_h264_setup(struct cedrus_ctx *ctx, struct cedrus_run *run)
 
 	cedrus_engine_enable(ctx);
 
-	cedrus_write(dev, VE_H264_SDROT_CTRL, 0);
+	if (cedrus_dst_is_tiled_behind(ctx))
+		cedrus_h264_tiled_behind_set(ctx, &run->dst->vb2_buf);
+	else
+		cedrus_write(dev, VE_H264_SDROT_CTRL, 0);
 	cedrus_write(dev, VE_H264_EXTRA_BUFFER1,
 		     ctx->codec.h264.pic_info_buf_dma);
 	cedrus_write(dev, VE_H264_EXTRA_BUFFER2,
diff --git a/drivers/staging/media/sunxi/cedrus/cedrus_h265.c b/drivers/staging/media/sunxi/cedrus/cedrus_h265.c
index 89f321f..e072a6d 100644
--- a/drivers/staging/media/sunxi/cedrus/cedrus_h265.c
+++ b/drivers/staging/media/sunxi/cedrus/cedrus_h265.c
@@ -839,9 +839,18 @@ static int cedrus_h265_setup(struct cedrus_ctx *ctx, struct cedrus_run *run)
 				     VE_DEC_H265_SDRT_CTRL_SCALE_HORZ(1));
 	}
 
+	if (cedrus_dst_is_tiled_behind(ctx)) {
+		cedrus_write(dev, VE_DEC_H265_10BIT_CONFIGURE, 0);
+		cedrus_write(dev, VE_DEC_H265_SDRT_CTRL, 0);
+		cedrus_write(dev, VE_DEC_H265_SDRT_LUMA_ADDR,
+			     cedrus_dst_buf_addr(ctx, &run->dst->vb2_buf, 0) >> 8);
+		cedrus_write(dev, VE_DEC_H265_SDRT_CHROMA_ADDR,
+			     cedrus_dst_buf_addr(ctx, &run->dst->vb2_buf, 1) >> 8);
+	}
+
 	/* Enable appropriate interruptions. */
 	reg = VE_DEC_H265_CTRL_IRQ_MASK;
-	if (cedrus_dst_is_p010(ctx))
+	if (cedrus_dst_is_p010(ctx) || cedrus_dst_is_tiled_behind(ctx))
 		reg |= VE_DEC_H265_CTRL_ROTATE_SCALE_OUT_EN;
 	cedrus_write(dev, VE_DEC_H265_CTRL, reg);
 
diff --git a/drivers/staging/media/sunxi/cedrus/cedrus_hw.c b/drivers/staging/media/sunxi/cedrus/cedrus_hw.c
index 21e0ee9..2afe55d 100644
--- a/drivers/staging/media/sunxi/cedrus/cedrus_hw.c
+++ b/drivers/staging/media/sunxi/cedrus/cedrus_hw.c
@@ -164,6 +164,67 @@ void cedrus_dst_format_set(struct cedrus_dev *dev,
 	}
 }
 
+/*
+ * The primary output writes the hidden NV12_32L32 surface, the secondary
+ * output the visible picture laid out as @pic (cedrus_fmt_is_tiled_behind()).
+ * The decoders enable the secondary output and give it the addresses of
+ * the visible picture in their own registers.
+ */
+void cedrus_dst_tiled_behind_set(struct cedrus_dev *dev,
+				 const struct v4l2_pix_format *pic)
+{
+	unsigned int bytesperline = pic->bytesperline;
+	u32 chroma_size = bytesperline * ALIGN(pic->height, 16) / 2;
+	u32 reg;
+
+	switch (pic->pixelformat) {
+	case V4L2_PIX_FMT_NV12:
+		reg = VE_SECONDARY_OUT_FMT_EXT_NV12;
+		break;
+	case V4L2_PIX_FMT_NV21:
+		reg = VE_SECONDARY_OUT_FMT_EXT_NV21;
+		break;
+	case V4L2_PIX_FMT_YUV420:
+		reg = VE_SECONDARY_OUT_FMT_EXT_YU12;
+		break;
+	case V4L2_PIX_FMT_YVU420:
+		reg = VE_SECONDARY_OUT_FMT_EXT_YV12;
+		break;
+	default:
+		return;
+	}
+	cedrus_write(dev, VE_PRIMARY_OUT_FMT,
+		     reg | VE_PRIMARY_OUT_FMT_TILED_32_NV12);
+
+	reg = VE_CHROMA_BUF_LEN_SDRT(chroma_size / 2) |
+	      VE_CHROMA_WIDTH_ALIGN_8 |
+	      VE_SECONDARY_OUT_FMT_EXT;
+	cedrus_write(dev, VE_CHROMA_BUF_LEN, reg);
+
+	reg = VE_PRIMARY_FB_LINE_STRIDE_LUMA(bytesperline) |
+	      VE_PRIMARY_FB_LINE_STRIDE_CHROMA(bytesperline / 2);
+	cedrus_write(dev, VE_SECONDARY_FB_LINE_STRIDE, reg);
+}
+
+void cedrus_mpeg_tiled_behind_set(struct cedrus_ctx *ctx, struct vb2_buffer *dst)
+{
+	struct cedrus_dev *dev = ctx->dev;
+
+	cedrus_write(dev, VE_DEC_MPEG_ROT_LUMA, cedrus_dst_buf_addr(ctx, dst, 0));
+	cedrus_write(dev, VE_DEC_MPEG_ROT_CHROMA,
+		     cedrus_dst_buf_addr(ctx, dst, 1));
+	cedrus_write(dev, VE_DEC_MPEG_SD_ROT_DBLK_CTL, 0);
+}
+
+void cedrus_h264_tiled_behind_set(struct cedrus_ctx *ctx, struct vb2_buffer *dst)
+{
+	struct cedrus_dev *dev = ctx->dev;
+
+	cedrus_write(dev, VE_H264_SDROT_CTRL, 0);
+	cedrus_write(dev, VE_H264_SDROT_LUMA, cedrus_dst_buf_addr(ctx, dst, 0));
+	cedrus_write(dev, VE_H264_SDROT_CHROMA, cedrus_dst_buf_addr(ctx, dst, 1));
+}
+
 /*
  * Program the secondary ("scale-down/rotate") output engine to write the
  * userspace-visible P010 surface at the start of the capture buffer.  The
@@ -345,6 +406,7 @@ int cedrus_hw_probe(struct cedrus_dev *dev)
 	dev->ve_mode_ddr = variant->ve_mode_ddr;
 	dev->h265_max_width = variant->h265_max_width;
 	dev->h265_max_height = variant->h265_max_height;
+	dev->linear_out_secondary = variant->linear_out_secondary;
 
 	irq_dec = platform_get_irq(dev->pdev, 0);
 	if (irq_dec <= 0)
diff --git a/drivers/staging/media/sunxi/cedrus/cedrus_hw.h b/drivers/staging/media/sunxi/cedrus/cedrus_hw.h
index e0d4302..40a1cb2 100644
--- a/drivers/staging/media/sunxi/cedrus/cedrus_hw.h
+++ b/drivers/staging/media/sunxi/cedrus/cedrus_hw.h
@@ -20,6 +20,12 @@ int cedrus_engine_enable(struct cedrus_ctx *ctx);
 
 void cedrus_dst_format_set(struct cedrus_dev *dev,
 			   struct v4l2_pix_format *fmt);
+void cedrus_dst_tiled_behind_set(struct cedrus_dev *dev,
+				 const struct v4l2_pix_format *pic);
+void cedrus_mpeg_tiled_behind_set(struct cedrus_ctx *ctx,
+				  struct vb2_buffer *dst);
+void cedrus_h264_tiled_behind_set(struct cedrus_ctx *ctx,
+				  struct vb2_buffer *dst);
 
 void cedrus_dst_p010_output_set(struct cedrus_ctx *ctx,
 				struct vb2_buffer *dst_buf,
diff --git a/drivers/staging/media/sunxi/cedrus/cedrus_mpeg2.c b/drivers/staging/media/sunxi/cedrus/cedrus_mpeg2.c
index 8bb4fcc..d83cba0 100644
--- a/drivers/staging/media/sunxi/cedrus/cedrus_mpeg2.c
+++ b/drivers/staging/media/sunxi/cedrus/cedrus_mpeg2.c
@@ -178,18 +178,18 @@ static int cedrus_mpeg2_setup(struct cedrus_ctx *ctx, struct cedrus_run *run)
 		bwd = &run->dst->vb2_buf;
 
 	cedrus_write(dev, VE_DEC_MPEG_FWD_REF_LUMA_ADDR,
-		     cedrus_dst_buf_addr(ctx, fwd, 0));
+		     cedrus_dst_frame_addr(ctx, fwd, 0));
 	cedrus_write(dev, VE_DEC_MPEG_FWD_REF_CHROMA_ADDR,
-		     cedrus_dst_buf_addr(ctx, fwd, 1));
+		     cedrus_dst_frame_addr(ctx, fwd, 1));
 	cedrus_write(dev, VE_DEC_MPEG_BWD_REF_LUMA_ADDR,
-		     cedrus_dst_buf_addr(ctx, bwd, 0));
+		     cedrus_dst_frame_addr(ctx, bwd, 0));
 	cedrus_write(dev, VE_DEC_MPEG_BWD_REF_CHROMA_ADDR,
-		     cedrus_dst_buf_addr(ctx, bwd, 1));
+		     cedrus_dst_frame_addr(ctx, bwd, 1));
 
 	/* Destination luma and chroma buffers. */
 
-	dst_luma_addr = cedrus_dst_buf_addr(ctx, &run->dst->vb2_buf, 0);
-	dst_chroma_addr = cedrus_dst_buf_addr(ctx, &run->dst->vb2_buf, 1);
+	dst_luma_addr = cedrus_dst_frame_addr(ctx, &run->dst->vb2_buf, 0);
+	dst_chroma_addr = cedrus_dst_frame_addr(ctx, &run->dst->vb2_buf, 1);
 
