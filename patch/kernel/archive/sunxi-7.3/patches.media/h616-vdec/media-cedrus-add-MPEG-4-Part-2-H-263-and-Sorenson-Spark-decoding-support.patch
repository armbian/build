+++ b/drivers/staging/media/sunxi/cedrus/cedrus_dec.c
@@ -115,6 +115,37 @@ void cedrus_device_run(void *priv)
 		}
 		break;
 
+	case V4L2_PIX_FMT_MPEG4_SLICE:
+		run.mpeg4.vol = cedrus_find_control_data(ctx,
