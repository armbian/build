From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jernej Skrabec <jernej.skrabec@gmail.com>
Date: Tue, 6 Oct 2026 21:22:29 +0200
Subject: media: cedrus: h616: use the 256-bit DDR mode for all
 codecs

With the VE_MODE DDR mode set to 128-bit, the value mainline hardcodes,
the H616 H.264 engine reads corrupted reference chroma: H.264 and VP8 P
frames come out with bit-exact luma but about 22 dB chroma, while H.265
and MPEG-2 are unaffected. Selecting the 256-bit DDR mode, as the VP9
path already does, makes every codec bit-exact (BA_MW_D, CABA2_Sony_E,
vp80-00-comprehensive-002, AMP_A_Samsung_7, MEI.stream16). The 2 MiB
reconstruction write mode makes no difference either way.

Make the DDR mode a variant property and use BW_256 on H616.

Signed-off-by: Jernej Skrabec <jernej.skrabec@gmail.com>
---
 drivers/staging/media/sunxi/cedrus/cedrus.c    | 6 ++++++
 drivers/staging/media/sunxi/cedrus/cedrus.h    | 2 ++
 drivers/staging/media/sunxi/cedrus/cedrus_hw.c | 9 +++++++--
 3 files changed, 15 insertions(+), 2 deletions(-)

diff --git a/drivers/staging/media/sunxi/cedrus/cedrus.c b/drivers/staging/media/sunxi/cedrus/cedrus.c
index 111111111111..222222222222 100644
--- a/drivers/staging/media/sunxi/cedrus/cedrus.c
+++ b/drivers/staging/media/sunxi/cedrus/cedrus.c
@@ -27,6 +27,7 @@
 #include "cedrus_video.h"
 #include "cedrus_dec.h"
 #include "cedrus_hw.h"
+#include "cedrus_regs.h"
 
 /*
  * The engine writes whatever picture size the bitstream headers describe:
@@ -759,6 +760,11 @@ static const struct cedrus_variant sun50i_h616_cedrus_variant = {
 			  CEDRUS_CAPABILITY_VP8_DEC |
 			  CEDRUS_CAPABILITY_VP9_DEC,
 	.mod_rate	= 600000000,
+	/*
+	 * With the 128-bit DDR mode, H.264 and VP8 read corrupted reference
+	 * chroma (luma is fine); the 256-bit mode decodes all codecs correctly.
+	 */
+	.ve_mode_ddr	= VE_MODE_DDR_MODE_BW_256,
 };
 
 static const struct of_device_id cedrus_dt_match[] = {
diff --git a/drivers/staging/media/sunxi/cedrus/cedrus.h b/drivers/staging/media/sunxi/cedrus/cedrus.h
index 111111111111..222222222222 100644
--- a/drivers/staging/media/sunxi/cedrus/cedrus.h
+++ b/drivers/staging/media/sunxi/cedrus/cedrus.h
@@ -211,6 +211,7 @@ struct cedrus_dec_ops {
 struct cedrus_variant {
 	unsigned int	capabilities;
 	unsigned int	mod_rate;
+	u32		ve_mode_ddr;
 	/*
 	 * Newer SoCs (e.g. A523/sun55iw3) have no dedicated VE SRAM region to
 	 * remap via the system-control block; the VE does physical DMA from
@@ -241,6 +242,7 @@ struct cedrus_dev {
 	struct reset_control	*rstc;
 
 	unsigned int		capabilities;
+	u32			ve_mode_ddr;
 
 	struct delayed_work	watchdog_work;
 };
diff --git a/drivers/staging/media/sunxi/cedrus/cedrus_hw.c b/drivers/staging/media/sunxi/cedrus/cedrus_hw.c
index 111111111111..222222222222 100644
--- a/drivers/staging/media/sunxi/cedrus/cedrus_hw.c
+++ b/drivers/staging/media/sunxi/cedrus/cedrus_hw.c
@@ -39,8 +39,12 @@ int cedrus_engine_enable(struct cedrus_ctx *ctx)
 	 * FIXME: This is only valid on 32-bits DDR's, we should test
 	 * it on the A13/A33.
 	 */
-	reg |= VE_MODE_REC_WR_MODE_2MB;
-	reg |= VE_MODE_DDR_MODE_BW_128;
+	if (ctx->dev->ve_mode_ddr) {
+		reg |= ctx->dev->ve_mode_ddr;
+	} else {
+		reg |= VE_MODE_REC_WR_MODE_2MB;
+		reg |= VE_MODE_DDR_MODE_BW_128;
+	}
 
 	switch (ctx->src_fmt.pixelformat) {
 	case V4L2_PIX_FMT_MPEG2_SLICE:
@@ -314,6 +318,7 @@ int cedrus_hw_probe(struct cedrus_dev *dev)
 		return -EINVAL;
 
 	dev->capabilities = variant->capabilities;
+	dev->ve_mode_ddr = variant->ve_mode_ddr;
 
 	irq_dec = platform_get_irq(dev->pdev, 0);
 	if (irq_dec <= 0)
-- 
