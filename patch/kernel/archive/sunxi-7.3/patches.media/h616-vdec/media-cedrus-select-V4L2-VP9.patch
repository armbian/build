From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Arun Iyengar <aiyengar1990@gmail.com>
Date: Mon, 2 Nov 2026 05:50:56 +0000
Subject: media: cedrus: select V4L2_VP9

The VP9 decoder uses the v4l2-vp9 helpers for the probability tables
and the backward adaptation. Select V4L2_VP9 instead of relying on
another driver (hantro, rkvdec) selecting it, which would leave a
cedrus-only configuration with unresolved symbols.

Assisted-by: LLM
Signed-off-by: Arun Iyengar <aiyengar1990@gmail.com>
---
 drivers/staging/media/sunxi/cedrus/Kconfig | 1 +
 1 file changed, 1 insertion(+)

diff --git a/drivers/staging/media/sunxi/cedrus/Kconfig b/drivers/staging/media/sunxi/cedrus/Kconfig
index 111111111111..222222222222 100644
--- a/drivers/staging/media/sunxi/cedrus/Kconfig
+++ b/drivers/staging/media/sunxi/cedrus/Kconfig
@@ -9,6 +9,7 @@ config VIDEO_SUNXI_CEDRUS
 	select SUNXI_SRAM
 	select VIDEOBUF2_DMA_CONTIG
 	select V4L2_MEM2MEM_DEV
+	select V4L2_VP9
 	help
 	  Support for the VPU found in Allwinner SoCs, also known as the Cedar
 	  video engine.
-- 
Armbian

