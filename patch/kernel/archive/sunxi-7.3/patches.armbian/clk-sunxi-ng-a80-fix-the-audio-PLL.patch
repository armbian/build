From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Igor Pecovnik <igor@armbian.com>
Date: Mon, 19 Oct 2026 19:31:02 +0200
Subject: clk: sunxi-ng: a80: fix the audio PLL

The A80 audio PLL output divider is P + 1, and the exact audio rates
need sigma-delta modulation. Without both, I2S runs at about 44.4 kHz
for 48 kHz audio (HDMI CTS 160642 instead of 148500). Use the vendor
factors and patterns for 22.5792 MHz and 24.576 MHz, and cap N.

Signed-off-by: Igor Pecovnik <igor@armbian.com>
Assisted-by: Claude Opus 5.5
---
 drivers/clk/sunxi-ng/ccu-sun9i-a80.c | 20 ++++++++--
 1 file changed, 17 insertions(+), 3 deletions(-)

diff --git a/drivers/clk/sunxi-ng/ccu-sun9i-a80.c b/drivers/clk/sunxi-ng/ccu-sun9i-a80.c
index 111111111111..222222222222 100644
--- a/drivers/clk/sunxi-ng/ccu-sun9i-a80.c
+++ b/drivers/clk/sunxi-ng/ccu-sun9i-a80.c
@@ -17,6 +17,7 @@
 #include "ccu_nkmp.h"
 #include "ccu_nm.h"
 #include "ccu_phase.h"
+#include "ccu_sdm.h"
 
 #include "ccu-sun9i-a80.h"
 
@@ -67,15 +68,28 @@ static struct ccu_mult pll_c1cpux_clk = {
  */
 #define SUN9I_A80_PLL_AUDIO_REG	0x008
 
+/*
+ * The output divider is P + 1. The exact audio rates need sigma-delta
+ * modulation, with the vendor patterns. The vendor uses d2 = 1 with
+ * P = 28 and 29; with d2 = 0, P covers the whole divider.
+ */
+static struct ccu_sdm_setting pll_audio_sdm_table[] = {
+	{ .rate = 22579200, .pattern = 0xc00121ff, .m = 58, .n = 54 },
+	{ .rate = 24576000, .pattern = 0xc000e147, .m = 60, .n = 61 },
+};
+
 static struct ccu_nm pll_audio_clk = {
 	.enable		= BIT(31),
 	.lock		= BIT(2),
-	.n		= _SUNXI_CCU_MULT_OFFSET_MIN_MAX(8, 8, 0, 12, 0),
-	.m		= _SUNXI_CCU_DIV_OFFSET(0, 6, 0),
+	.n		= _SUNXI_CCU_MULT_OFFSET_MIN_MAX(8, 8, 0, 12, 100),
+	.m		= _SUNXI_CCU_DIV(0, 6),
+	.sdm		= _SUNXI_CCU_SDM(pll_audio_sdm_table, BIT(24),
+					 0x108, BIT(31)),
 	.common		= {
 		.reg		= 0x008,
 		.lock_reg	= CCU_SUN9I_LOCK_REG,
-		.features	= CCU_FEATURE_LOCK_REG,
+		.features	= CCU_FEATURE_LOCK_REG |
+				  CCU_FEATURE_SIGMA_DELTA_MOD,
 		.hw.init	= CLK_HW_INIT("pll-audio", "osc24M",
 					      &ccu_nm_ops, CLK_SET_RATE_UNGATE),
 	},
-- 
