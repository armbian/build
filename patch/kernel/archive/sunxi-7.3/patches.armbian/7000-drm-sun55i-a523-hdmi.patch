+static const struct inno_phy_elec sun55i_a523_inno_elec[] = {
+	{  25000, 165000, 0x00020202, 0x1c1c1c1c, 0x00000000, 0x00000000 },
+	{ 165000, 340000, 0x02060708, 0x1c1c1c1c, 0x00000000, 0x03030300 },
