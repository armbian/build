From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: serg987 <50438876+serg987@users.noreply.github.com>
Date: Sat, 7 Nov 2026 09:40:04 -0500
Subject: clk: sunxi-ng: add update_bits field (minimal backport of 'generalise
 update bit')

Based on [PATCH v3 1/4] (Andre Przywara) from Andre Przywara's series
"arm64: allwinner: a523: Enable CPU clocks" (v3, 2026-09-26, based on v7.3-rc1),
Link: https://lore.kernel.org/all/20260925225112.14081-1-andre.przywara@arm.com/
Not merged upstream yet; carried in Armbian until it lands.

Minimal additive variant for 6.18: adds ccu_common.update_bits and ORs it into
the nm/div/gate/mux register writes; the existing CCU_FEATURE_UPDATE_BIT and
CCU_FEATURE_KEY_FIELD handling is left untouched (no behaviour change for
existing clocks).

Signed-off-by: serg987 <50438876+serg987@users.noreply.github.com>
---
 drivers/clk/sunxi-ng/ccu_common.h | 1 +
 drivers/clk/sunxi-ng/ccu_div.c    | 1 +
 drivers/clk/sunxi-ng/ccu_gate.c   | 2 ++
 drivers/clk/sunxi-ng/ccu_mux.c    | 1 +
 drivers/clk/sunxi-ng/ccu_nm.c     | 1 +
 5 files changed, 6 insertions(+)

diff --git a/drivers/clk/sunxi-ng/ccu_common.h b/drivers/clk/sunxi-ng/ccu_common.h
index 111111111111..222222222222 100644
--- a/drivers/clk/sunxi-ng/ccu_common.h
+++ b/drivers/clk/sunxi-ng/ccu_common.h
@@ -36,6 +36,7 @@ struct ccu_common {
 	u16		reg;
 	u16		lock_reg;
 	u32		prediv;
+	u32		update_bits;
 
 	unsigned long	min_rate;
 	unsigned long	max_rate;
diff --git a/drivers/clk/sunxi-ng/ccu_div.c b/drivers/clk/sunxi-ng/ccu_div.c
index 111111111111..222222222222 100644
--- a/drivers/clk/sunxi-ng/ccu_div.c
+++ b/drivers/clk/sunxi-ng/ccu_div.c
@@ -121,6 +121,7 @@ static int ccu_div_set_rate(struct clk_hw *hw, unsigned long rate,
 	reg &= ~GENMASK(cd->div.width + cd->div.shift - 1, cd->div.shift);
 	if (cd->common.features & CCU_FEATURE_UPDATE_BIT)
 		reg |= CCU_SUNXI_UPDATE_BIT;
+	reg |= cd->common.update_bits;
 
 	writel(reg | (val << cd->div.shift),
 	       cd->common.base + cd->common.reg);
diff --git a/drivers/clk/sunxi-ng/ccu_gate.c b/drivers/clk/sunxi-ng/ccu_gate.c
index 111111111111..222222222222 100644
--- a/drivers/clk/sunxi-ng/ccu_gate.c
+++ b/drivers/clk/sunxi-ng/ccu_gate.c
@@ -22,6 +22,7 @@ void ccu_gate_helper_disable(struct ccu_common *common, u32 gate)
 	reg = readl(common->base + common->reg);
 	if (common->features & CCU_FEATURE_UPDATE_BIT)
 		reg |= CCU_SUNXI_UPDATE_BIT;
+	reg |= common->update_bits;
 	writel(reg & ~gate, common->base + common->reg);
 
 	spin_unlock_irqrestore(common->lock, flags);
@@ -48,6 +49,7 @@ int ccu_gate_helper_enable(struct ccu_common *common, u32 gate)
 	reg = readl(common->base + common->reg);
 	if (common->features & CCU_FEATURE_UPDATE_BIT)
 		reg |= CCU_SUNXI_UPDATE_BIT;
+	reg |= common->update_bits;
 	writel(reg | gate, common->base + common->reg);
 
 	spin_unlock_irqrestore(common->lock, flags);
diff --git a/drivers/clk/sunxi-ng/ccu_mux.c b/drivers/clk/sunxi-ng/ccu_mux.c
index 111111111111..222222222222 100644
--- a/drivers/clk/sunxi-ng/ccu_mux.c
+++ b/drivers/clk/sunxi-ng/ccu_mux.c
@@ -208,6 +208,7 @@ int ccu_mux_helper_set_parent(struct ccu_common *common,
 		reg |= CCU_MUX_KEY_VALUE;
 	if (common->features & CCU_FEATURE_UPDATE_BIT)
 		reg |= CCU_SUNXI_UPDATE_BIT;
+	reg |= common->update_bits;
 
 	reg &= ~GENMASK(cm->width + cm->shift - 1, cm->shift);
 	writel(reg | (index << cm->shift), common->base + common->reg);
diff --git a/drivers/clk/sunxi-ng/ccu_nm.c b/drivers/clk/sunxi-ng/ccu_nm.c
index 111111111111..222222222222 100644
--- a/drivers/clk/sunxi-ng/ccu_nm.c
+++ b/drivers/clk/sunxi-ng/ccu_nm.c
@@ -219,6 +219,7 @@ static int ccu_nm_set_rate(struct clk_hw *hw, unsigned long rate,
 
 	reg |= (_nm.n - nm->n.offset) << nm->n.shift;
 	reg |= (_nm.m - nm->m.offset) << nm->m.shift;
+	reg |= nm->common.update_bits;
 	writel(reg, nm->common.base + nm->common.reg);
 
 	spin_unlock_irqrestore(nm->common.lock, flags);
-- 
Armbian

