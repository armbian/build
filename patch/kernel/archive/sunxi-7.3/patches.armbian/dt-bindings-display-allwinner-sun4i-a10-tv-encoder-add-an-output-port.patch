From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: "D.R.racer" <drracer@seznam.cz>
Date: Fri, 20 Nov 2026 19:05:45 +0100
Subject: dt-bindings: display: allwinner,sun4i-a10-tv-encoder: add an output
 port

The A10/A20 TV encoder can drive a VGA connector instead of composite
video. Describing that needs an output port next to the input from the
TCON, so allow a ports node with port@0 (input) and port@1 (output) as
an alternative to the single input port.

Only the A10/A20 encoder may use the ports form.

Assisted-by: Claude:claude-opus-5-5
---
 .../allwinner,sun4i-a10-tv-encoder.yaml       | 68 ++++++++++++++++++-
 1 file changed, 67 insertions(+), 1 deletion(-)

diff --git a/Documentation/devicetree/bindings/display/allwinner,sun4i-a10-tv-encoder.yaml b/Documentation/devicetree/bindings/display/allwinner,sun4i-a10-tv-encoder.yaml
index 111111111111..222222222222 100644
--- a/Documentation/devicetree/bindings/display/allwinner,sun4i-a10-tv-encoder.yaml
+++ b/Documentation/devicetree/bindings/display/allwinner,sun4i-a10-tv-encoder.yaml
@@ -32,12 +32,46 @@ properties:
       The first port should be the input endpoint, usually coming from the
       associated TCON.
 
+  ports:
+    $ref: /schemas/graph.yaml#/properties/ports
+
+    properties:
+      port@0:
+        $ref: /schemas/graph.yaml#/properties/port
+        description:
+          Input endpoint, usually coming from the associated TCON.
+
+      port@1:
+        $ref: /schemas/graph.yaml#/properties/port
+        description:
+          Output endpoint, linked to a VGA connector when the A10/A20
+          encoder drives VGA instead of composite video.
+
+    required:
+      - port@0
+
 required:
   - compatible
   - reg
   - clocks
   - resets
-  - port
+
+oneOf:
+  - required:
+      - port
+  - required:
+      - ports
+
+allOf:
+  - if:
+      properties:
+        compatible:
+          not:
+            contains:
+              const: allwinner,sun4i-a10-tv-encoder
+    then:
+      properties:
+        ports: false
 
 additionalProperties: false
 
@@ -56,4 +90,36 @@ examples:
         };
     };
 
+  - |
+    #include <dt-bindings/clock/sun4i-a10-ccu.h>
+    #include <dt-bindings/reset/sun4i-a10-ccu.h>
+
+    tv-encoder@1c0a000 {
+        compatible = "allwinner,sun4i-a10-tv-encoder";
+        reg = <0x01c0a000 0x1000>;
+        clocks = <&ccu CLK_AHB_TVE0>;
+        resets = <&ccu RST_TVE0>;
+
+        ports {
+            #address-cells = <1>;
+            #size-cells = <0>;
+
+            port@0 {
+                reg = <0>;
+
+                endpoint {
+                    remote-endpoint = <&tcon0_out_tve0>;
+                };
+            };
+
+            port@1 {
+                reg = <1>;
+
+                endpoint {
+                    remote-endpoint = <&vga_con_in>;
+                };
+            };
+        };
+    };
+
 ...
