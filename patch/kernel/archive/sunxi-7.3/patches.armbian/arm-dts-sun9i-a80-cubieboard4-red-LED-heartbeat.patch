From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Igor Pecovnik <igor@armbian.com>
Date: Mon, 19 Oct 2026 15:46:59 +0200
Subject: arm: dts: sun9i-a80-cubieboard4: red LED heartbeat

Blink the red LED as a heartbeat, as the vendor configuration does.

Signed-off-by: Igor Pecovnik <igor@armbian.com>
Assisted-by: Claude Opus 5.5
---
 arch/arm/boot/dts/allwinner/sun9i-a80-cubieboard4.dts | 1 +
 1 file changed, 1 insertion(+)

diff --git a/arch/arm/boot/dts/allwinner/sun9i-a80-cubieboard4.dts b/arch/arm/boot/dts/allwinner/sun9i-a80-cubieboard4.dts
index 111111111111..222222222222 100644
--- a/arch/arm/boot/dts/allwinner/sun9i-a80-cubieboard4.dts
+++ b/arch/arm/boot/dts/allwinner/sun9i-a80-cubieboard4.dts
@@ -71,6 +71,7 @@ led-0 {
 		led-1 {
 			label = "cubieboard4:red:usr";
 			gpios = <&pio 7 6 GPIO_ACTIVE_HIGH>; /* PH6 */
+			linux,default-trigger = "heartbeat";
 		};
 	};
 
