From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Arun Iyengar <aiyengar1990@gmail.com>
Date: Mon, 2 Nov 2026 12:00:00 +0000
Subject: arm64: dts: allwinner: h616: add the cpu-sleep idle state

Add the cpu-sleep idle state that TF-A implements on the H616 with the
"offer CPU_SUSPEND natively" patch. The power state ID follows the TF-A
sunxi encoding; the latencies are estimates.

Assisted-by: LLM
Signed-off-by: Arun Iyengar <aiyengar1990@gmail.com>
---
 arch/arm64/boot/dts/allwinner/sun50i-h616.dtsi | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/arch/arm64/boot/dts/allwinner/sun50i-h616.dtsi b/arch/arm64/boot/dts/allwinner/sun50i-h616.dtsi
index 111111111111..222222222222 100644
--- a/arch/arm64/boot/dts/allwinner/sun50i-h616.dtsi
+++ b/arch/arm64/boot/dts/allwinner/sun50i-h616.dtsi
@@ -29,6 +29,7 @@
 			device_type = "cpu";
 			reg = <0>;
 			enable-method = "psci";
+			cpu-idle-states = <&cpu_sleep>;
 			clocks = <&ccu CLK_CPUX>;
 			#cooling-cells = <2>;
 			i-cache-size = <0x8000>;
@@ -45,6 +46,7 @@
 			device_type = "cpu";
 			reg = <1>;
 			enable-method = "psci";
+			cpu-idle-states = <&cpu_sleep>;
 			clocks = <&ccu CLK_CPUX>;
 			#cooling-cells = <2>;
 			i-cache-size = <0x8000>;
@@ -61,6 +63,7 @@
 			device_type = "cpu";
 			reg = <2>;
 			enable-method = "psci";
+			cpu-idle-states = <&cpu_sleep>;
 			clocks = <&ccu CLK_CPUX>;
 			#cooling-cells = <2>;
 			i-cache-size = <0x8000>;
@@ -77,6 +80,7 @@
 			device_type = "cpu";
 			reg = <3>;
 			enable-method = "psci";
+			cpu-idle-states = <&cpu_sleep>;
 			clocks = <&ccu CLK_CPUX>;
 			#cooling-cells = <2>;
 			i-cache-size = <0x8000>;
@@ -88,6 +92,19 @@
 			next-level-cache = <&l2_cache>;
 		};
 
+		idle-states {
+			entry-method = "psci";
+
+			cpu_sleep: cpu-sleep {
+				compatible = "arm,idle-state";
+				arm,psci-suspend-param = <0x00010003>;
+				local-timer-stop;
+				entry-latency-us = <100>;
+				exit-latency-us = <150>;
+				min-residency-us = <4000>;
+			};
+		};
+
 		l2_cache: l2-cache {
 			compatible = "cache";
 			cache-level = <2>;
-- 
Armbian

