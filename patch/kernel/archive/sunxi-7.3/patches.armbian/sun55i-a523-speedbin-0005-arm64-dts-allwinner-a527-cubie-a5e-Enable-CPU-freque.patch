From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: serg987 <50438876+serg987@users.noreply.github.com>
Date: Sat, 7 Nov 2026 20:12:00 -0500
Subject: arm64: dts: allwinner: a527: cubie-a5e: Enable CPU frequency scaling

Include the A523 CPU OPP tables and give every CPU its supply: DCDC1 of
the AXP717 for the little cluster, the dual-phase DCDC1/2 of the AXP323
for the big cluster.

Signed-off-by: serg987 <50438876+serg987@users.noreply.github.com>
---
 arch/arm64/boot/dts/allwinner/sun55i-a527-cubie-a5e.dts | 25 ++++++++++
 1 file changed, 25 insertions(+)

diff --git a/arch/arm64/boot/dts/allwinner/sun55i-a527-cubie-a5e.dts b/arch/arm64/boot/dts/allwinner/sun55i-a527-cubie-a5e.dts
index 111111111111..222222222222 100644
--- a/arch/arm64/boot/dts/allwinner/sun55i-a527-cubie-a5e.dts
+++ b/arch/arm64/boot/dts/allwinner/sun55i-a527-cubie-a5e.dts
@@ -5,6 +5,7 @@
 /dts-v1/;
 
 #include "sun55i-a523.dtsi"
+#include "sun55i-a523-cpu-opp.dtsi"
 
 #include <dt-bindings/gpio/gpio.h>
 #include <dt-bindings/leds/common.h>
@@ -227,10 +228,34 @@ &cpu0 {
 	cpu-supply = <&reg_dcdc1>;
 };
 
+&cpu1 {
+	cpu-supply = <&reg_dcdc1>;
+};
+
+&cpu2 {
+	cpu-supply = <&reg_dcdc1>;
+};
+
+&cpu3 {
+	cpu-supply = <&reg_dcdc1>;
+};
+
 &cpu4 {
 	cpu-supply = <&reg_dcdc1_323>;
 };
 
+&cpu5 {
+	cpu-supply = <&reg_dcdc1_323>;
+};
+
+&cpu6 {
+	cpu-supply = <&reg_dcdc1_323>;
+};
+
+&cpu7 {
+	cpu-supply = <&reg_dcdc1_323>;
+};
+
 &ehci0 {
 	status = "okay";
 };
-- 
Armbian

