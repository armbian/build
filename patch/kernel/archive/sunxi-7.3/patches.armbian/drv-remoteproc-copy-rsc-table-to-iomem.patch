From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Juan Sanchez <juanesf91@gmail.com>
Date: Tue, 20 Oct 2026 22:30:00 +0200
Subject: [PATCH] remoteproc: copy the loaded resource table into MMIO memory

rproc_start() copies the cached resource table into the memory that the
remote processor sees, using a plain memcpy(). Some platform drivers map
that memory as MMIO: sun55i_e906_da_to_va() reports *is_iomem = true for
the RISC-V SRAM windows, and imx_rproc maps the rsc-table region with
devm_ioremap_wc().

On arm64 the plain memcpy() faults with an alignment fault when the
destination is device memory. The ELF segment loader already branches on
is_iomem and uses memcpy_toio()/memset_io(); the resource table copy in
rproc_start() does not.

Plumb the is_iomem flag from rproc_da_to_va() up through
rproc_find_loaded_rsc_table() and rproc_elf_find_loaded_rsc_table(), then
branch on it in rproc_start().

Signed-off-by: Juan Sanchez Fuentes <juanesf91@gmail.com>
Assisted-by: opencode:big-pickle
---
--- a/drivers/remoteproc/remoteproc_core.c	2026-10-12 00:04:55.000000000 -0300
+++ b/drivers/remoteproc/remoteproc_core.c	2026-10-20 22:27:57.840458801 -0300
@@ -1265,6 +1265,7 @@
 {
 	struct resource_table *loaded_table;
 	struct device *dev = &rproc->dev;
+	bool is_iomem = false;
 	int ret;
 
 	/* load the ELF segments to memory */
@@ -1282,9 +1283,14 @@
 	 * this information to device memory. We also update the table_ptr so
 	 * that any subsequent changes will be applied to the loaded version.
 	 */
-	loaded_table = rproc_find_loaded_rsc_table(rproc, fw);
+	loaded_table = rproc_find_loaded_rsc_table(rproc, fw, &is_iomem);
 	if (loaded_table) {
-		memcpy(loaded_table, rproc->cached_table, rproc->table_sz);
+		if (is_iomem)
+			memcpy_toio((void __iomem *)loaded_table,
+				    rproc->cached_table, rproc->table_sz);
+		else
+			memcpy(loaded_table, rproc->cached_table,
+			       rproc->table_sz);
 		rproc->table_ptr = loaded_table;
 	}
 
--- a/drivers/remoteproc/remoteproc_elf_loader.c	2026-10-12 00:04:55.000000000 -0300
+++ b/drivers/remoteproc/remoteproc_elf_loader.c	2026-10-20 22:27:57.838743480 -0300
@@ -370,7 +370,8 @@
  * If the table wasn't loaded yet the result is unspecified.
  */
 struct resource_table *rproc_elf_find_loaded_rsc_table(struct rproc *rproc,
-						       const struct firmware *fw)
+						       const struct firmware *fw,
+						       bool *is_iomem)
 {
 	const void *shdr;
 	u64 sh_addr, sh_size;
@@ -390,6 +391,6 @@
 		return NULL;
 	}
 
-	return rproc_da_to_va(rproc, sh_addr, sh_size, NULL);
+	return rproc_da_to_va(rproc, sh_addr, sh_size, is_iomem);
 }
 EXPORT_SYMBOL(rproc_elf_find_loaded_rsc_table);
--- a/drivers/remoteproc/remoteproc_internal.h	2026-10-12 00:04:55.000000000 -0300
+++ b/drivers/remoteproc/remoteproc_internal.h	2026-10-20 22:27:57.837897507 -0300
@@ -119,7 +119,8 @@
 int rproc_elf_load_segments(struct rproc *rproc, const struct firmware *fw);
 int rproc_elf_load_rsc_table(struct rproc *rproc, const struct firmware *fw);
 struct resource_table *rproc_elf_find_loaded_rsc_table(struct rproc *rproc,
-						       const struct firmware *fw);
+						       const struct firmware *fw,
+						       bool *is_iomem);
 struct rproc_mem_entry *
 rproc_find_carveout_by_name(struct rproc *rproc, const char *name, ...);
 void rproc_add_rvdev(struct rproc *rproc, struct rproc_vdev *rvdev);
@@ -248,10 +249,11 @@
 
 static inline
 struct resource_table *rproc_find_loaded_rsc_table(struct rproc *rproc,
-						   const struct firmware *fw)
+						   const struct firmware *fw,
+						   bool *is_iomem)
 {
 	if (rproc->ops->find_loaded_rsc_table)
-		return rproc->ops->find_loaded_rsc_table(rproc, fw);
+		return rproc->ops->find_loaded_rsc_table(rproc, fw, is_iomem);
 
 	return NULL;
 }
--- a/include/linux/remoteproc.h	2026-10-12 00:04:55.000000000 -0300
+++ b/include/linux/remoteproc.h	2026-10-20 22:27:57.836954709 -0300
@@ -79,6 +79,7 @@
  *		RSC_HANDLED if resource was handled, RSC_IGNORED if not handled
  *		and a negative value on error
  * @find_loaded_rsc_table: find the loaded resource table from firmware image
+ *			   and report whether it lives in MMIO memory
  * @get_loaded_rsc_table: get resource table installed in memory
  *			  by external entity
  * @load:		load firmware to memory, where the remote processor
@@ -102,7 +103,8 @@
 	int (*handle_rsc)(struct rproc *rproc, u32 rsc_type, void *rsc,
 			  int offset, int avail);
 	struct resource_table *(*find_loaded_rsc_table)(struct rproc *rproc,
-							const struct firmware *fw);
+							const struct firmware *fw,
+							bool *is_iomem);
 	struct resource_table *(*get_loaded_rsc_table)(struct rproc *rproc,
 						       size_t *size);
 	int (*load)(struct rproc *rproc, const struct firmware *fw);
--- a/drivers/remoteproc/imx_rproc.c	2026-10-12 00:04:55.000000000 -0300
+++ b/drivers/remoteproc/imx_rproc.c	2026-10-20 22:27:57.841580360 -0300
@@ -750,7 +750,8 @@
 }
 
 static struct resource_table *
-imx_rproc_elf_find_loaded_rsc_table(struct rproc *rproc, const struct firmware *fw)
+imx_rproc_elf_find_loaded_rsc_table(struct rproc *rproc, const struct firmware *fw,
+				    bool *is_iomem)
 {
 	struct imx_rproc *priv = rproc->priv;
 
@@ -758,10 +759,12 @@
 	if (!rproc->table_ptr)
 		return NULL;
 
-	if (priv->rsc_table)
+	if (priv->rsc_table) {
+		*is_iomem = true;
 		return (struct resource_table *)priv->rsc_table;
+	}
 
-	return rproc_elf_find_loaded_rsc_table(rproc, fw);
+	return rproc_elf_find_loaded_rsc_table(rproc, fw, is_iomem);
 }
 
 static const struct rproc_ops imx_rproc_ops = {
-- 
Armbian
