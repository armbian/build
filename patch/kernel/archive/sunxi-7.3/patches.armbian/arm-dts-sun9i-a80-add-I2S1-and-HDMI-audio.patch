From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Igor Pecovnik <igor@armbian.com>
Date: Mon, 19 Oct 2026 19:23:53 +0200
Subject: ARM: dts: sun9i: a80: add I2S1 and HDMI audio

The vendor kernel feeds HDMI audio from I2S1 (DAUDIO1). Its registers
match the A83T I2S. Add I2S1 with DMA request 4 and the HDMI sound card.

Signed-off-by: Igor Pecovnik <igor@armbian.com>
Assisted-by: Claude Opus 5.5
---
 arch/arm/boot/dts/allwinner/sun9i-a80.dtsi | 28 ++++++++++
 1 file changed, 28 insertions(+)

diff --git a/arch/arm/boot/dts/allwinner/sun9i-a80.dtsi b/arch/arm/boot/dts/allwinner/sun9i-a80.dtsi
index 111111111111..222222222222 100644
--- a/arch/arm/boot/dts/allwinner/sun9i-a80.dtsi
+++ b/arch/arm/boot/dts/allwinner/sun9i-a80.dtsi
@@ -283,6 +283,19 @@ r_ir_clk: clk@8001454 {
 		};
 	};
 
+	sound_hdmi: sound-hdmi {
+		compatible = "allwinner,sun9i-a80-hdmi-audio";
+		status = "disabled";
+
+		codec {
+			sound-dai = <&hdmi>;
+		};
+
+		cpu {
+			sound-dai = <&i2s1>;
+		};
+	};
+
 	de: display-engine {
 		compatible = "allwinner,sun9i-a80-display-engine";
 		allwinner,pipelines = <&fe0>, <&fe1>;
@@ -937,6 +950,7 @@ tcon1_out_hdmi: endpoint {
 		};
 
 		hdmi: hdmi@3d00000 {
+			#sound-dai-cells = <0>;
 			compatible = "allwinner,sun9i-a80-dw-hdmi",
 				     "allwinner,sun8i-a83t-dw-hdmi";
 			reg = <0x03d00000 0x10000>;
@@ -1096,6 +1110,20 @@ uart4_pins: uart4-pins {
 			};
 		};
 
+		i2s1: i2s@6002400 {
+			#sound-dai-cells = <0>;
+			compatible = "allwinner,sun9i-a80-i2s",
+				     "allwinner,sun8i-a83t-i2s";
+			reg = <0x06002400 0x400>;
+			interrupts = <GIC_SPI 14 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&ccu CLK_BUS_I2S1>, <&ccu CLK_I2S1>;
+			clock-names = "apb", "mod";
+			resets = <&ccu RST_BUS_I2S1>;
+			dmas = <&dma 4>, <&dma 4>;
+			dma-names = "rx", "tx";
+			status = "disabled";
+		};
+
 		uart0: serial@7000000 {
 			compatible = "snps,dw-apb-uart";
 			reg = <0x07000000 0x400>;
-- 
Armbian

