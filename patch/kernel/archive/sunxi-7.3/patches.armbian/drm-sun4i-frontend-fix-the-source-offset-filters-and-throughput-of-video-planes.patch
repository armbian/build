+/*
+ * Load the filters for the given input sizes of both channels, scaled to
+ * out_w x out_h. The coefficients are double-buffered: COEF_RDY makes the
+ * frontend switch to them at its next frame.
+ */
+static void sun4i_frontend_update_coef(struct sun4i_frontend *frontend,
+				       u32 luma_w, u32 luma_h,
+				       u32 chroma_w, u32 chroma_h,
+				       u32 out_w, u32 out_h)
+{
+	const u32 *ch0h, *ch0v, *ch1h, *ch1v;
+	u8 set[4];
+	int i;
+
+	set[0] = sun4i_frontend_coef_set(luma_w, out_w);
+	set[1] = sun4i_frontend_coef_set(luma_h, out_h);
+	set[2] = sun4i_frontend_coef_set(chroma_w, out_w);
+	set[3] = sun4i_frontend_coef_set(chroma_h, out_h);
+
+	if (!memcmp(set, frontend->coef_set, sizeof(set)))
+		return;
+
+	DRM_DEBUG_DRIVER("Frontend filter sets: ch0 %u/%u, ch1 %u/%u (h/v)\n",
+			 set[0], set[1], set[2], set[3]);
+
+	ch0h = sun4i_frontend_a10_horz_coef[set[0] - 1];
+	ch0v = sun4i_frontend_a10_vert_coef[set[1] - 1];
+	ch1h = sun4i_frontend_a10_horz_coef[set[2] - 1];
+	ch1v = sun4i_frontend_a10_vert_coef[set[3] - 1];
+
+	for (i = 0; i < 32; i++) {
+		regmap_write(frontend->regs, SUN4I_FRONTEND_CH0_HORZCOEF0_REG(i),
+			     ch0h[2 * i]);
+		regmap_write(frontend->regs, SUN4I_FRONTEND_CH0_HORZCOEF1_REG(i),
+			     ch0h[2 * i + 1]);
+		regmap_write(frontend->regs, SUN4I_FRONTEND_CH0_VERTCOEF_REG(i),
+			     ch0v[i]);
+		regmap_write(frontend->regs, SUN4I_FRONTEND_CH1_HORZCOEF0_REG(i),
+			     ch1h[2 * i]);
+		regmap_write(frontend->regs, SUN4I_FRONTEND_CH1_HORZCOEF1_REG(i),
+			     ch1h[2 * i + 1]);
+		regmap_write(frontend->regs, SUN4I_FRONTEND_CH1_VERTCOEF_REG(i),
+			     ch1v[i]);
+	}
+
+	regmap_write_bits(frontend->regs, SUN4I_FRONTEND_FRM_CTRL_REG,
+			  SUN4I_FRONTEND_FRM_CTRL_COEF_RDY,
+			  SUN4I_FRONTEND_FRM_CTRL_COEF_RDY);
+
+	memcpy(frontend->coef_set, set, sizeof(set));
+}
