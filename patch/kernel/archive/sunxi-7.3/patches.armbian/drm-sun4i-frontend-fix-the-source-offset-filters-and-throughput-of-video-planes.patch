diff --git a/drivers/gpu/drm/sun4i/sun4i_backend.c b/drivers/gpu/drm/sun4i/sun4i_backend.c
index 111111111111..222222222222 100644
--- a/drivers/gpu/drm/sun4i/sun4i_backend.c
+++ b/drivers/gpu/drm/sun4i/sun4i_backend.c
@@ -440,11 +440,16 @@ static bool sun4i_backend_plane_uses_frontend(struct drm_plane_state *state)
 }
 
 static bool sun4i_backend_plane_is_supported(struct drm_plane_state *state,
+					     struct drm_crtc_state *crtc_state,
 					     bool *uses_frontend)
 {
 	if (sun4i_backend_plane_uses_frontend(state)) {
+		struct sun4i_layer *layer = plane_to_sun4i_layer(state->plane);
+
 		*uses_frontend = true;
-		return true;
+		return sun4i_frontend_plane_is_supported(layer->backend->frontend,
+							 state,
+							 &crtc_state->adjusted_mode);
 	}
 
 	*uses_frontend = false;
@@ -498,7 +503,7 @@ static int sun4i_backend_atomic_check(struct sunxi_engine *engine,
 			state_to_sun4i_layer_state(plane_state);
 		struct drm_framebuffer *fb = plane_state->fb;
 
-		if (!sun4i_backend_plane_is_supported(plane_state,
+		if (!sun4i_backend_plane_is_supported(plane_state, crtc_state,
 						      &layer_state->uses_frontend))
 			return -EINVAL;
 
