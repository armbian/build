+/*
+ * Filter set for scaling in to out samples, numbered as in the BSP's
+ * DE_SCAL_Set_Scaling_Coef() with its default smoothing: set 1 when
+ * upscaling, then one set per 1/8 of the ratio from 1 to 2 (sets 1-8), per
+ * 1/4 from 2 to 3 (sets 9-12), set 13 from 3 to 4, set 14 from 4 to 5 and
+ * set 15 beyond.
+ */
+static unsigned int sun4i_frontend_coef_set(u32 in, u32 out)
+{
+	u32 ratio = (in << 3) / out;	/* in eighths */
+	u32 frac = ratio & 7;
+
+	switch (ratio >> 3) {
+	case 0:
+		return 1;
+	case 1:
+		return 1 + frac;
+	case 2:
+		return 9 + frac / 2;
+	case 3:
+		return 13;
+	case 4:
+		return 14;
+	default:
+		return 15;
+	}
+}
