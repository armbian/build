From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Igor Pecovnik <igor@armbian.com>
Date: Mon, 19 Oct 2026 16:31:40 +0200
Subject: ARM: dts: sun9i: a80: add CPU OPP tables and thermal trips

Add the cluster clocks and OPP tables for cpufreq-dt. The voltages are the
highest of the three vendor DVFS tables.

Cluster 1 at 1.608 GHz draws more than 17 W at full load, and resets a
board on a 5 V 3 A supply. Mark the 1.416, 1.608 and 1.8 GHz steps as
boost steps. Enable them in /sys/devices/system/cpu/cpufreq/boost.

Throttle all CPUs at 85 C on both CPU sensors, and shut down at 105 C,
as the vendor configuration does.

Signed-off-by: Igor Pecovnik <igor@armbian.com>
Assisted-by: Claude Opus 5.5
---
 arch/arm/boot/dts/allwinner/sun9i-a80.dtsi | 181 ++++++++++
 1 file changed, 181 insertions(+)

diff --git a/arch/arm/boot/dts/allwinner/sun9i-a80.dtsi b/arch/arm/boot/dts/allwinner/sun9i-a80.dtsi
index 111111111111..222222222222 100644
--- a/arch/arm/boot/dts/allwinner/sun9i-a80.dtsi
+++ b/arch/arm/boot/dts/allwinner/sun9i-a80.dtsi
@@ -50,6 +50,7 @@
 #include <dt-bindings/reset/sun9i-a80-ccu.h>
 #include <dt-bindings/reset/sun9i-a80-de.h>
 #include <dt-bindings/reset/sun9i-a80-usb.h>
+#include <dt-bindings/thermal/thermal.h>
 
 / {
 	#address-cells = <2>;
@@ -60,6 +61,90 @@ aliases {
 		ethernet0 = &gmac;
 	};
 
+	/*
+	 * Highest voltage of the three vendor DVFS tables for each step.
+	 * Cluster 1 above 1.2 GHz needs more than a 5 V 3 A supply under full
+	 * load, so these steps are boost (turbo) steps.
+	 */
+	cluster0_opp_table: opp-table-cluster0 {
+		compatible = "operating-points-v2";
+		opp-shared;
+
+		opp-480000000 {
+			opp-hz = /bits/ 64 <480000000>;
+			opp-microvolt = <840000>;
+			clock-latency-ns = <244144>; /* 8 32k periods */
+		};
+
+		opp-720000000 {
+			opp-hz = /bits/ 64 <720000000>;
+			opp-microvolt = <840000>;
+			clock-latency-ns = <244144>; /* 8 32k periods */
+		};
+
+		opp-816000000 {
+			opp-hz = /bits/ 64 <816000000>;
+			opp-microvolt = <900000>;
+			clock-latency-ns = <244144>; /* 8 32k periods */
+		};
+
+		opp-1008000000 {
+			opp-hz = /bits/ 64 <1008000000>;
+			opp-microvolt = <960000>;
+			clock-latency-ns = <244144>; /* 8 32k periods */
+		};
+
+		opp-1200000000 {
+			opp-hz = /bits/ 64 <1200000000>;
+			opp-microvolt = <1060000>;
+			clock-latency-ns = <244144>; /* 8 32k periods */
+		};
+	};
+
+	cluster1_opp_table: opp-table-cluster1 {
+		compatible = "operating-points-v2";
+		opp-shared;
+
+		opp-600000000 {
+			opp-hz = /bits/ 64 <600000000>;
+			opp-microvolt = <840000>;
+			clock-latency-ns = <244144>; /* 8 32k periods */
+		};
+
+		opp-1008000000 {
+			opp-hz = /bits/ 64 <1008000000>;
+			opp-microvolt = <840000>;
+			clock-latency-ns = <244144>; /* 8 32k periods */
+		};
+
+		opp-1200000000 {
+			opp-hz = /bits/ 64 <1200000000>;
+			opp-microvolt = <900000>;
+			clock-latency-ns = <244144>; /* 8 32k periods */
+		};
+
+		opp-1416000000 {
+			opp-hz = /bits/ 64 <1416000000>;
+			turbo-mode;
+			opp-microvolt = <1020000>;
+			clock-latency-ns = <244144>; /* 8 32k periods */
+		};
+
+		opp-1608000000 {
+			opp-hz = /bits/ 64 <1608000000>;
+			turbo-mode;
+			opp-microvolt = <1100000>;
+			clock-latency-ns = <244144>; /* 8 32k periods */
+		};
+
+		opp-1800000000 {
+			opp-hz = /bits/ 64 <1800000000>;
+			turbo-mode;
+			opp-microvolt = <1160000>;
+			clock-latency-ns = <244144>; /* 8 32k periods */
+		};
+	};
+
 	cpus {
 		#address-cells = <1>;
 		#size-cells = <0>;
@@ -71,6 +156,9 @@ cpu0: cpu@0 {
 			clock-frequency = <12000000>;
 			enable-method = "allwinner,sun9i-a80-smp";
 			reg = <0x0>;
+			clocks = <&ccu CLK_C0CPUX>;
+			operating-points-v2 = <&cluster0_opp_table>;
+			#cooling-cells = <2>;
 		};
 
 		cpu1: cpu@1 {
@@ -80,6 +168,9 @@ cpu1: cpu@1 {
 			clock-frequency = <12000000>;
 			enable-method = "allwinner,sun9i-a80-smp";
 			reg = <0x1>;
+			clocks = <&ccu CLK_C0CPUX>;
+			operating-points-v2 = <&cluster0_opp_table>;
+			#cooling-cells = <2>;
 		};
 
 		cpu2: cpu@2 {
@@ -89,6 +180,9 @@ cpu2: cpu@2 {
 			clock-frequency = <12000000>;
 			enable-method = "allwinner,sun9i-a80-smp";
 			reg = <0x2>;
+			clocks = <&ccu CLK_C0CPUX>;
+			operating-points-v2 = <&cluster0_opp_table>;
+			#cooling-cells = <2>;
 		};
 
 		cpu3: cpu@3 {
@@ -98,6 +192,9 @@ cpu3: cpu@3 {
 			clock-frequency = <12000000>;
 			enable-method = "allwinner,sun9i-a80-smp";
 			reg = <0x3>;
+			clocks = <&ccu CLK_C0CPUX>;
+			operating-points-v2 = <&cluster0_opp_table>;
+			#cooling-cells = <2>;
 		};
 
 		cpu4: cpu@100 {
@@ -107,6 +204,9 @@ cpu4: cpu@100 {
 			clock-frequency = <18000000>;
 			enable-method = "allwinner,sun9i-a80-smp";
 			reg = <0x100>;
+			clocks = <&ccu CLK_C1CPUX>;
+			operating-points-v2 = <&cluster1_opp_table>;
+			#cooling-cells = <2>;
 		};
 
 		cpu5: cpu@101 {
@@ -116,6 +216,9 @@ cpu5: cpu@101 {
 			clock-frequency = <18000000>;
 			enable-method = "allwinner,sun9i-a80-smp";
 			reg = <0x101>;
+			clocks = <&ccu CLK_C1CPUX>;
+			operating-points-v2 = <&cluster1_opp_table>;
+			#cooling-cells = <2>;
 		};
 
 		cpu6: cpu@102 {
@@ -125,6 +228,9 @@ cpu6: cpu@102 {
 			clock-frequency = <18000000>;
 			enable-method = "allwinner,sun9i-a80-smp";
 			reg = <0x102>;
+			clocks = <&ccu CLK_C1CPUX>;
+			operating-points-v2 = <&cluster1_opp_table>;
+			#cooling-cells = <2>;
 		};
 
 		cpu7: cpu@103 {
@@ -134,6 +240,9 @@ cpu7: cpu@103 {
 			clock-frequency = <18000000>;
 			enable-method = "allwinner,sun9i-a80-smp";
 			reg = <0x103>;
+			clocks = <&ccu CLK_C1CPUX>;
+			operating-points-v2 = <&cluster1_opp_table>;
+			#cooling-cells = <2>;
 		};
 	};
 
@@ -1359,24 +1468,96 @@ cpu0_thermal: cpu0-thermal {
 			polling-delay-passive = <1000>;
 			polling-delay = <5000>;
 			thermal-sensors = <&ths 0>;
+
+			trips {
+				cpu0_alert: cpu0-alert {
+					temperature = <85000>;
+					hysteresis = <2000>;
+					type = "passive";
+				};
+
+				cpu0_crit: cpu0-crit {
+					temperature = <105000>;
+					hysteresis = <2000>;
+					type = "critical";
+				};
+			};
+
+			cooling-maps {
+				map0 {
+					trip = <&cpu0_alert>;
+					cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
+							 <&cpu1 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
+							 <&cpu2 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
+							 <&cpu3 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
+							 <&cpu4 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
+							 <&cpu5 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
+							 <&cpu6 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
+							 <&cpu7 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
+				};
+			};
 		};
 
 		dram_thermal: dram-thermal {
 			polling-delay-passive = <1000>;
 			polling-delay = <5000>;
 			thermal-sensors = <&ths 1>;
+
+			trips {
+				dram_crit: dram-crit {
+					temperature = <105000>;
+					hysteresis = <2000>;
+					type = "critical";
+				};
+			};
 		};
 
 		gpu_thermal: gpu-thermal {
 			polling-delay-passive = <1000>;
 			polling-delay = <5000>;
 			thermal-sensors = <&ths 2>;
+
+			trips {
+				gpu_crit: gpu-crit {
+					temperature = <105000>;
+					hysteresis = <2000>;
+					type = "critical";
+				};
+			};
 		};
 
 		cpu2_thermal: cpu2-thermal {
 			polling-delay-passive = <1000>;
 			polling-delay = <5000>;
 			thermal-sensors = <&ths 3>;
+
+			trips {
+				cpu2_alert: cpu2-alert {
+					temperature = <85000>;
+					hysteresis = <2000>;
+					type = "passive";
+				};
+
+				cpu2_crit: cpu2-crit {
+					temperature = <105000>;
+					hysteresis = <2000>;
+					type = "critical";
+				};
+			};
+
+			cooling-maps {
+				map0 {
+					trip = <&cpu2_alert>;
+					cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
+							 <&cpu1 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
+							 <&cpu2 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
+							 <&cpu3 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
+							 <&cpu4 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
+							 <&cpu5 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
+							 <&cpu6 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
+							 <&cpu7 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
+				};
+			};
 		};
 	};
 };
