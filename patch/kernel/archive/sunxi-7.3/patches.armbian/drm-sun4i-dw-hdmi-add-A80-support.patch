From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Igor Pecovnik <igor@armbian.com>
Date: Mon, 19 Oct 2026 18:55:44 +0200
Subject: drm/sun4i: dw-hdmi: add A80 support

The A80 HDMI is the same DesignWare controller and PHY as on the A83T.
Limit the pixel clock to 148.5 MHz: 4K modes reach the HDMI, but the
DE 1.0 backend output is garbled.

Signed-off-by: Igor Pecovnik <igor@armbian.com>
Assisted-by: Claude Opus 5.5
---
 drivers/gpu/drm/sun4i/sun8i_dw_hdmi.c | 20 ++++++++++
 1 file changed, 20 insertions(+)

diff --git a/drivers/gpu/drm/sun4i/sun8i_dw_hdmi.c b/drivers/gpu/drm/sun4i/sun8i_dw_hdmi.c
index 111111111111..222222222222 100644
--- a/drivers/gpu/drm/sun4i/sun8i_dw_hdmi.c
+++ b/drivers/gpu/drm/sun4i/sun8i_dw_hdmi.c
@@ -43,6 +43,18 @@ sun8i_dw_hdmi_mode_valid_a83t(struct dw_hdmi *hdmi, void *data,
 	return MODE_OK;
 }
 
+static enum drm_mode_status
+sun8i_dw_hdmi_mode_valid_a80(struct dw_hdmi *hdmi, void *data,
+			     const struct drm_display_info *info,
+			     const struct drm_display_mode *mode)
+{
+	/* The A80 DE 1.0 backend does not scan out above 1080p60 cleanly */
+	if (mode->clock > 148500)
+		return MODE_CLOCK_HIGH;
+
+	return MODE_OK;
+}
+
 static enum drm_mode_status
 sun8i_dw_hdmi_mode_valid_h6(struct dw_hdmi *hdmi, void *data,
 			    const struct drm_display_info *info,
@@ -250,6 +262,10 @@ static const struct sun8i_dw_hdmi_quirks sun8i_a83t_quirks = {
 	.mode_valid = sun8i_dw_hdmi_mode_valid_a83t,
 };
 
+static const struct sun8i_dw_hdmi_quirks sun9i_a80_quirks = {
+	.mode_valid = sun8i_dw_hdmi_mode_valid_a80,
+};
+
 static const struct sun8i_dw_hdmi_quirks sun50i_h6_quirks = {
 	.mode_valid = sun8i_dw_hdmi_mode_valid_h6,
 	.use_drm_infoframe = true,
@@ -260,6 +276,10 @@ static const struct of_device_id sun8i_dw_hdmi_dt_ids[] = {
 		.compatible = "allwinner,sun8i-a83t-dw-hdmi",
 		.data = &sun8i_a83t_quirks,
 	},
+	{
+		.compatible = "allwinner,sun9i-a80-dw-hdmi",
+		.data = &sun9i_a80_quirks,
+	},
 	{
 		.compatible = "allwinner,sun50i-h6-dw-hdmi",
 		.data = &sun50i_h6_quirks,
-- 
