From 6e64416a8bf834e1b40e25b3434fad0f6d107c68 Mon Sep 17 00:00:00 2001
From: serg987 <50438876+serg987@users.noreply.github.com>
Date: Sat, 7 Nov 2026 20:12:00 -0500
Subject: [PATCH 2/5] cpufreq: dt-platdev: Blocklist Allwinner A523 family

The A523, A527 and T527 select their OPP voltages from the speed grade
fuse through the sun50i-cpufreq-nvmem driver, which registers the
cpufreq-dt device itself.

Signed-off-by: serg987 <50438876+serg987@users.noreply.github.com>
---
 drivers/cpufreq/cpufreq-dt-platdev.c | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/drivers/cpufreq/cpufreq-dt-platdev.c b/drivers/cpufreq/cpufreq-dt-platdev.c
index 371ca1f..f191a7b 100644
--- a/drivers/cpufreq/cpufreq-dt-platdev.c
+++ b/drivers/cpufreq/cpufreq-dt-platdev.c
@@ -114,6 +114,9 @@ static const struct of_device_id blocklist[] __initconst = {
 	{ .compatible = "allwinner,sun50i-h616", },
 	{ .compatible = "allwinner,sun50i-h618", },
 	{ .compatible = "allwinner,sun50i-h700", },
+	{ .compatible = "allwinner,sun55i-a523", },
+	{ .compatible = "allwinner,sun55i-a527", },
+	{ .compatible = "allwinner,sun55i-t527", },
 
 	{ .compatible = "apple,arm-platform", },
 
