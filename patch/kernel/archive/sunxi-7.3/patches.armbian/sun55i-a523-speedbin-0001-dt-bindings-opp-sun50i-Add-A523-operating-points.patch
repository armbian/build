From ba5108ddff2051d9e513d1a331d6603e4ee74ff9 Mon Sep 17 00:00:00 2001
From: serg987 <50438876+serg987@users.noreply.github.com>
Date: Sat, 7 Nov 2026 20:12:00 -0500
Subject: [PATCH 1/5] dt-bindings: opp: sun50i: Add A523 operating points

The Allwinner A523 family (A523, A527, T527) stores its CPU speed grade
in the SID at offset 0x48. Add a compatible for its OPP tables so the
sun50i-cpufreq-nvmem driver can select the matching voltages.

Signed-off-by: serg987 <50438876+serg987@users.noreply.github.com>
---
 .../bindings/opp/allwinner,sun50i-h6-operating-points.yaml       | 1 +
 1 file changed, 1 insertion(+)

diff --git a/Documentation/devicetree/bindings/opp/allwinner,sun50i-h6-operating-points.yaml b/Documentation/devicetree/bindings/opp/allwinner,sun50i-h6-operating-points.yaml
index 75ab552..4076db3 100644
--- a/Documentation/devicetree/bindings/opp/allwinner,sun50i-h6-operating-points.yaml
+++ b/Documentation/devicetree/bindings/opp/allwinner,sun50i-h6-operating-points.yaml
@@ -25,6 +25,7 @@ properties:
       - allwinner,sun50i-a100-operating-points
       - allwinner,sun50i-h6-operating-points
       - allwinner,sun50i-h616-operating-points
+      - allwinner,sun55i-a523-operating-points
 
   nvmem-cells:
     description: |
-- 
