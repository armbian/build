From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Igor Pecovnik <igor@armbian.com>
Date: Mon, 19 Oct 2026 19:23:53 +0200
Subject: ARM: dts: sun9i: a80-cubieboard4: enable HDMI audio

Enable I2S1 and the HDMI sound card.

Signed-off-by: Igor Pecovnik <igor@armbian.com>
Assisted-by: Claude Opus 5.5
---
 arch/arm/boot/dts/allwinner/sun9i-a80-cubieboard4.dts | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/arch/arm/boot/dts/allwinner/sun9i-a80-cubieboard4.dts b/arch/arm/boot/dts/allwinner/sun9i-a80-cubieboard4.dts
index 111111111111..222222222222 100644
--- a/arch/arm/boot/dts/allwinner/sun9i-a80-cubieboard4.dts
+++ b/arch/arm/boot/dts/allwinner/sun9i-a80-cubieboard4.dts
@@ -166,6 +166,10 @@ &gmac {
 	status = "okay";
 };
 
+&i2s1 {
+	status = "okay";
+};
+
 &i2c3 {
 	pinctrl-names = "default";
 	pinctrl-0 = <&i2c3_pins>;
@@ -542,6 +546,10 @@ tcon0_out_vga: endpoint {
 	};
 };
 
+&sound_hdmi {
+	status = "okay";
+};
+
 &uart0 {
 	pinctrl-names = "default";
 	pinctrl-0 = <&uart0_ph_pins>;
-- 
Armbian

