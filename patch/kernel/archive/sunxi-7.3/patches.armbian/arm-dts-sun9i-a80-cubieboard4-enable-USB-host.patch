From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Igor Pecovnik <igor@armbian.com>
Date: Mon, 19 Oct 2026 15:46:59 +0200
Subject: arm: dts: sun9i-a80-cubieboard4: enable USB host

Enable USB1 (EHCI0/OHCI0) and USB3 (EHCI2/OHCI2). The onboard hub sits on
USB1. PH14 switches VBUS of the back ports, PH15 of the front ports.

Signed-off-by: Igor Pecovnik <igor@armbian.com>
Assisted-by: Claude Opus 5.5
---
 arch/arm/boot/dts/allwinner/sun9i-a80-cubieboard4.dts | 46 ++++++++++
 1 file changed, 46 insertions(+)

diff --git a/arch/arm/boot/dts/allwinner/sun9i-a80-cubieboard4.dts b/arch/arm/boot/dts/allwinner/sun9i-a80-cubieboard4.dts
index 111111111111..222222222222 100644
--- a/arch/arm/boot/dts/allwinner/sun9i-a80-cubieboard4.dts
+++ b/arch/arm/boot/dts/allwinner/sun9i-a80-cubieboard4.dts
@@ -74,6 +74,27 @@ led-1 {
 		};
 	};
 
+	/* VBUS of the hub ports at the back */
+	reg_usb1_vbus: usb1-vbus {
+		compatible = "regulator-fixed";
+		regulator-name = "usb1-vbus";
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+		enable-active-high;
+		gpio = <&pio 7 14 GPIO_ACTIVE_HIGH>; /* PH14 */
+	};
+
+	/* VBUS of the hub ports at the front */
+	reg_usb1_vbus_front: usb1-vbus-front {
+		compatible = "regulator-fixed";
+		regulator-name = "usb1-vbus-front";
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+		regulator-always-on;
+		enable-active-high;
+		gpio = <&pio 7 15 GPIO_ACTIVE_HIGH>; /* PH15 */
+	};
+
 	hdmi-connector {
 		compatible = "hdmi-connector";
 		type = "a";
@@ -168,6 +189,14 @@ &de {
 	status = "okay";
 };
 
+&ehci0 {
+	status = "okay";
+};
+
+&ehci2 {
+	status = "okay";
+};
+
 &gmac {
 	pinctrl-names = "default";
 	pinctrl-0 = <&gmac_rgmii_pins>;
@@ -242,6 +271,14 @@ &mmc2_8bit_pins {
 	drive-strength = <40>;
 };
 
+&ohci0 {
+	status = "okay";
+};
+
+&ohci2 {
+	status = "okay";
+};
+
 &osc32k {
 	/* osc32k input is from AC100 */
 	clocks = <&ac100_rtc 0>;
@@ -594,3 +631,12 @@ bluetooth {
 		shutdown-gpios = <&r_pio 0 5 GPIO_ACTIVE_HIGH>; /* PL5 */
 	};
 };
+
+&usbphy1 {
+	phy-supply = <&reg_usb1_vbus>;
+	status = "okay";
+};
+
+&usbphy3 {
+	status = "okay";
+};
-- 
Armbian

