From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Akash Sukhavasi <akash.sukhavasi@gmail.com>
Date: Wed, 20 May 2026 16:53:25 -0500
Subject: [PATCH] arm64: dts: hisilicon: hikey960: Fix USB role-switch endpoint

Move the RT1711H USB role-switch endpoint into the Type-C
connector's port@0, as required by the connector binding.

Backport of upstream commit:
b54fcf7a2df1124a21195afde508369e47067a1f

Adapted for Armbian's board-hikey960-usb.patch, which routes
the USB role switch through the onboard USB hub. Preserve the
remote-endpoint reference to hikey_usb_ep1.

Signed-off-by: Akash Sukhavasi <akash.sukhavasi@gmail.com>
Signed-off-by: Wei Xu <xuwei5@hisilicon.com>
Signed-off-by: Yating Zhou <tingsyscl@icloud.com>
---
 arch/arm64/boot/dts/hisilicon/hi3660-hikey960.dts | 15 ++++------
 1 file changed, 6 insertions(+), 9 deletions(-)

diff --git a/arch/arm64/boot/dts/hisilicon/hi3660-hikey960.dts b/arch/arm64/boot/dts/hisilicon/hi3660-hikey960.dts
index f05edfe378e6..11beb720375c 100644
--- a/arch/arm64/boot/dts/hisilicon/hi3660-hikey960.dts
+++ b/arch/arm64/boot/dts/hisilicon/hi3660-hikey960.dts
@@ -579,27 +579,24 @@ usb_con: connector {
 			op-sink-microwatt = <10000000>;
 
 			ports {
 				#address-cells = <1>;
 				#size-cells = <0>;
+				port@0 {
+					reg = <0>;
+					rt1711h_ep: endpoint {
+						remote-endpoint = <&hikey_usb_ep1>;
+					};
+				};
 				port@1 {
 					reg = <1>;
 					usb_con_ss: endpoint {
 						remote-endpoint = <&dwc3_ss>;
 					};
 				};
 			};
 		};
-		port {
-			#address-cells = <1>;
-			#size-cells = <0>;
-
-			rt1711h_ep: endpoint@0 {
-				reg = <0>;
-				remote-endpoint = <&hikey_usb_ep1>;
-			};
-		};
 	};
 
 	adv7533: adv7533@39 {
 		status = "okay";
 		compatible = "adi,adv7533";
-- 
