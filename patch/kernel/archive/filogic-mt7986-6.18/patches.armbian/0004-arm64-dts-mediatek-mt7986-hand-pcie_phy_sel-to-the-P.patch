From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: SuperKali <hello@superkali.me>
Date: Fri, 16 Oct 2026 21:06:43 +0200
Subject: [PATCH] arm64: dts: mediatek: mt7986: hand pcie_phy_sel to the PCIe
 PHY

Nothing references the pcie_phy_sel clock, so clk_disable_unused gates
it at late init. When that lands while the PCIe link is training, or on
any later re-probe, the PHY can no longer detect the endpoint and the
link stays in detect.quiet. Pass it to the PHY as its da_ref clock.

Signed-off-by: SuperKali <hello@superkali.me>
---
 arch/arm64/boot/dts/mediatek/mt7986a.dtsi | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/mediatek/mt7986a.dtsi b/arch/arm64/boot/dts/mediatek/mt7986a.dtsi
index 6786e5b..dac4c5b 100644
--- a/arch/arm64/boot/dts/mediatek/mt7986a.dtsi
+++ b/arch/arm64/boot/dts/mediatek/mt7986a.dtsi
@@ -438,8 +438,9 @@
 
 			pcie_port: pcie-phy@0 {
 				reg = <0 0x20000>;
-				clocks = <&clk40m>;
-				clock-names = "ref";
+				clocks = <&clk40m>,
+					 <&topckgen CLK_TOP_PCIE_PHY_SEL>;
+				clock-names = "ref", "da_ref";
 				#phy-cells = <1>;
 			};
 		};
