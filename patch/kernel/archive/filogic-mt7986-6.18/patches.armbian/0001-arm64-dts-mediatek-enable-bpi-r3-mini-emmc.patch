From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: SuperKali <hello@superkali.me>
Date: Thu, 10 Sep 2026 19:33:32 +0200
Subject: arm64: dts: mediatek: enable BPI-R3 Mini eMMC

The board DTS supplies pins and regulators but leaves mmc0 disabled with
inherited 1-bit capabilities, so the only writable boot medium never
probes. Enable 8-bit HS200 and keep unvalidated HS400 disabled.

Signed-off-by: SuperKali <hello@superkali.me>
---
 arch/arm64/boot/dts/mediatek/mt7986a-bananapi-bpi-r3-mini.dts | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/arch/arm64/boot/dts/mediatek/mt7986a-bananapi-bpi-r3-mini.dts b/arch/arm64/boot/dts/mediatek/mt7986a-bananapi-bpi-r3-mini.dts
index 111111111111..222222222222 100644
--- a/arch/arm64/boot/dts/mediatek/mt7986a-bananapi-bpi-r3-mini.dts
+++ b/arch/arm64/boot/dts/mediatek/mt7986a-bananapi-bpi-r3-mini.dts
@@ -171,11 +171,21 @@ mdio: mdio-bus {
 };
 
 &mmc0 {
+	bus-width = <8>;
+	max-frequency = <200000000>;
 	pinctrl-names = "default", "state_uhs";
 	pinctrl-0 = <&mmc0_pins_default>;
 	pinctrl-1 = <&mmc0_pins_uhs>;
+	cap-mmc-highspeed;
+	cap-mmc-hw-reset;
+	mmc-hs200-1_8v;
+	no-mmc-hs400;
+	no-sd;
+	no-sdio;
+	non-removable;
 	vmmc-supply = <&reg_3p3v>;
 	vqmmc-supply = <&reg_1p8v>;
+	status = "okay";
 };
 
 
-- 
Armbian

