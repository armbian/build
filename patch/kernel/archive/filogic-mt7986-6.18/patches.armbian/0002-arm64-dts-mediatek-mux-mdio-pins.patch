From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: SuperKali <hello@superkali.me>
Date: Thu, 10 Sep 2026 19:33:42 +0200
Subject: arm64: dts: mediatek: mux MDIO pins on BPI-R3 Mini

Both Airoha EN8811H PHYs sit behind the MDC/MDIO pair on GPIO 67 and 68,
but the board applies no pinmux and relies on whatever the bootloader
left behind. Claim the mdc_mdio group explicitly.

Signed-off-by: SuperKali <hello@superkali.me>
---
 arch/arm64/boot/dts/mediatek/mt7986a-bananapi-bpi-r3-mini.dts | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/arch/arm64/boot/dts/mediatek/mt7986a-bananapi-bpi-r3-mini.dts b/arch/arm64/boot/dts/mediatek/mt7986a-bananapi-bpi-r3-mini.dts
index 111111111111..222222222222 100644
--- a/arch/arm64/boot/dts/mediatek/mt7986a-bananapi-bpi-r3-mini.dts
+++ b/arch/arm64/boot/dts/mediatek/mt7986a-bananapi-bpi-r3-mini.dts
@@ -149,6 +149,8 @@ &crypto {
 
 &eth {
 	status = "okay";
+	pinctrl-names = "default";
+	pinctrl-0 = <&eth_pins>;
 
 	gmac0: mac@0 {
 		compatible = "mediatek,eth-mac";
@@ -282,6 +284,13 @@ &pcie_phy {
 };
 
 &pio {
+	eth_pins: eth-pins {
+		mux {
+			function = "eth";
+			groups = "mdc_mdio";
+		};
+	};
+
 	i2c_pins: i2c-pins {
 		mux {
 			function = "i2c";
-- 
Armbian

