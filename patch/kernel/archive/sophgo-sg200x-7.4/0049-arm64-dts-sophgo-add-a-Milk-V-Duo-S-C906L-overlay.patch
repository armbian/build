From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Lukasz Sobala <lsobala1@gmail.com>
Date: Fri, 31 Jul 2026 00:42:10 +0200
Subject: arm64: dts: sophgo: add a Milk-V Duo S C906L overlay

The arm64 counterpart of 0048; the reasoning is there.
---
 arch/arm64/boot/dts/sophgo/Makefile                  |  9 ++
 arch/arm64/boot/dts/sophgo/overlay/sg2000-c906l.dtso | 51 ++++++++++
 2 files changed, 60 insertions(+)

diff --git a/arch/arm64/boot/dts/sophgo/Makefile b/arch/arm64/boot/dts/sophgo/Makefile
index 111111111111..222222222222 100644
--- a/arch/arm64/boot/dts/sophgo/Makefile
+++ b/arch/arm64/boot/dts/sophgo/Makefile
@@ -1,3 +1,12 @@
 # SPDX-License-Identifier: GPL-2.0
 dtb-$(CONFIG_ARCH_SOPHGO) += sg2000-milkv-duo-module-01-evb.dtb
 dtb-$(CONFIG_ARCH_SOPHGO) += sg2000-milkv-duo-s.dtb
+
+# The C906L coprocessor overlay, selectable at runtime through armbianEnv.txt.
+# The composite target below is never booted: it exists so the build applies the
+# overlay to the base with fdtoverlay, which both validates that it still fits
+# and is what makes Makefile.dtbs pass -@ to the base DTB. Without those
+# symbols, "fdt apply" in U-Boot cannot resolve &remoteproc at boot.
+sg2000-milkv-duo-s-c906l-dtbs := sg2000-milkv-duo-s.dtb overlay/sg2000-c906l.dtbo
+dtb-$(CONFIG_ARCH_SOPHGO) += sg2000-milkv-duo-s-c906l.dtb
+dtb-$(CONFIG_ARCH_SOPHGO) += overlay/sg2000-c906l.dtbo
diff --git a/arch/arm64/boot/dts/sophgo/overlay/sg2000-c906l.dtso b/arch/arm64/boot/dts/sophgo/overlay/sg2000-c906l.dtso
new file mode 100644
index 000000000000..111111111111
--- /dev/null
+++ b/arch/arm64/boot/dts/sophgo/overlay/sg2000-c906l.dtso
@@ -0,0 +1,51 @@
+// SPDX-License-Identifier: (GPL-2.0 OR MIT)
+/*
+ * Milk-V Duo S: hand the C906L coprocessor back to Linux.
+ *
+ * The SG2000 carries a second, much smaller RISC-V core (C906L) meant for
+ * real-time work with no operating system in the way - it is what Milk-V's
+ * "Arduino on the Duo" runs sketches on, under FreeRTOS. remoteproc is how
+ * Linux loads firmware onto it and starts it.
+ *
+ * The base device tree disables it and deletes its reserved-memory region,
+ * because Armbian builds no FreeRTOS image and installs no cvirtos.elf, so the
+ * core never starts and the region is 2MiB of a 512MiB board held for nothing.
+ * This overlay puts both back for people who do have firmware to run.
+ *
+ * Enable with, in /boot/armbianEnv.txt:
+ *
+ *     overlays=c906l
+ *
+ * Then put your firmware at /lib/firmware/cvirtos.elf. Without it remoteproc
+ * still registers and simply reports the missing file:
+ *
+ *     remoteproc remoteproc0: c906l-rproc is available
+ *     remoteproc remoteproc0: Direct firmware load for cvirtos.elf failed with error -2
+ *
+ * The region is fixed at the top of DRAM to match CVIMMAP_FREERTOS_ADDR in the
+ * vendor's cvi_board_memmap.h, which is where the FSBL would load a C906L image
+ * from fip.bin, so a firmware built by the vendor SDK expects it there.
+ */
+
+/dts-v1/;
+/plugin/;
+
+&{/reserved-memory} {
+	/*
+	 * Restated to match the base node. dtc cannot see the target's cell counts
+	 * when an overlay is compiled on its own, and defaults to <2>/<1>, which
+	 * makes it warn that this reg is the wrong length.
+	 */
+	#address-cells = <1>;
+	#size-cells = <1>;
+
+	coprocessor_rtos: region@9fe00000 {
+		reg = <0x9fe00000 0x200000>;
+		no-map;
+	};
+};
+
+&remoteproc {
+	memory-region = <&coprocessor_rtos>;
+	status = "okay";
+};
-- 
Armbian

