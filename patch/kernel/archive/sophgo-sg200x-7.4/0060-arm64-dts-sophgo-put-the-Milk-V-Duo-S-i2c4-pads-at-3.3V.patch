From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Lukasz Sobala <lsobala1@gmail.com>
Date: Wed, 16 Sep 2026 18:56:23 +0200
Subject: arm64: dts: sophgo: put the Milk-V Duo S i2c4 pads at 3.3V

The arm64 counterpart of 0059; the reasoning is there.
---
 arch/arm64/boot/dts/sophgo/sg2000-milkv-duo-s.dts | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/sophgo/sg2000-milkv-duo-s.dts b/arch/arm64/boot/dts/sophgo/sg2000-milkv-duo-s.dts
index 111111111111..222222222222 100644
--- a/arch/arm64/boot/dts/sophgo/sg2000-milkv-duo-s.dts
+++ b/arch/arm64/boot/dts/sophgo/sg2000-milkv-duo-s.dts
@@ -148,13 +148,19 @@ &osc {
 };
 
 &pinctrl {
+	/*
+	 * VDDIO_VIVO is 3.3V: these are pins 3 and 5 of the 26-pin header, and the
+	 * header overlays that take other VIVO pads declare 3300. The domain keeps a
+	 * single power-source, so at 1800 this group and those overlays cannot
+	 * coexist - whichever probes second is refused and never probes.
+	 */
 	i2c4_cfg: i2c4-cfg {
 		i2c4-pins {
 			pinmux = <PINMUX(PIN_VIVO_D1, 7)>,
 				 <PINMUX(PIN_VIVO_D0, 7)>;
 			bias-pull-up;
 			drive-strength-microamp = <4000>;
-			power-source = <1800>;
+			power-source = <3300>;
 		};
 	};
 
-- 
Armbian

