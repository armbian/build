+int axp_regu_create_attrs(struct platform_device *pdev)
+{
+	int j, ret;
+
+	for (j = 0; j < ARRAY_SIZE(axp_regu_attrs); j++) {
+		ret = device_create_file(&pdev->dev, &axp_regu_attrs[j]);
+		if (ret)
+			goto sysfs_failed;
+	}
+
+	return ret;
+
+sysfs_failed:
+	while (j--)
+		device_remove_file(&pdev->dev, &axp_regu_attrs[j]);
+
+	return ret;
+}
