+static int snd_card_probe(struct platform_device *pdev)
+{
+	struct snd_soc_card *card = &snd_null_card[0];
+	struct snd_soc_dai_driver *cpudrv = NULL;
+	unsigned int rates = 0, format = 0;
+	int ret;
+	int ch;
