+	[ID_CCI_BCLK] = {.id = ID_CCI_BCLK,
+		.name = CLK_CCI_BCLK,
+		.div = DIV_CCI4},
+	[ID_CCI_PCLK] = {.id = ID_CCI_PCLK,
+		.name = CLK_CCI_PCLK,
