+		writel((((u32) sy & 0xffful) << 16) | ((u32) ey & 0xffful),
+		       &pregister->mlcrgblayer2.mlctopbottom);
+	} else if (3 == layer) {
+		writel((((u32) sx & 0xffful) << 16) | ((u32) ex & 0xffful),
+		       &pregister->mlcvideolayer.mlcleftright);
+
+		writel((((u32) sy & 0xffful) << 16) | ((u32) ey & 0xffful),
+		       &pregister->mlcvideolayer.mlctopbottom);
+	}
