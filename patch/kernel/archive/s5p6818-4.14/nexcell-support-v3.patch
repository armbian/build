+
+/* Define Codec Standard */
+enum {
+	CODEC_STD_AVC	= 0,
+	CODEC_STD_VC1	= 1,
+	CODEC_STD_MPEG2	= 2,
+	CODEC_STD_MPEG4	= 3,
+	CODEC_STD_H263	= 4,
+	CODEC_STD_DIV3	= 5,
