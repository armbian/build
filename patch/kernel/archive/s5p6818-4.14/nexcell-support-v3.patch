+#define CLK_EVENT_HZ (10 * 1000000)  /* or 1MHZ */
+
+/* timer register */
+#define REG_TCFG0 (0x00)
+#define REG_TCFG1 (0x04)
+#define REG_TCON (0x08)
+#define REG_TCNTB0 (0x0C)
+#define REG_TCMPB0 (0x10)
