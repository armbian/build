+
+/* DRAM configuration for TileMap access */
+#define EM_RAS                          13
+#define EM_BANK                         3
+#define EM_CAS                          10
+#define EM_WIDTH                        2
+
+
+struct gdi_tiled_map {
+	int xy2ca_map[16];
+	int xy2ba_map[16];
+	int xy2ra_map[16];
+	int rbc2axi_map[32];
+	int MapType;
+
+	int xy2rbc_config;
+	int tb_separate_map;
+	int top_bot_split;
+	int tiledMap;
+	int ca_inc_hor;
+	int val;
+};
+
+enum {
+	CA_SEL  = 0,
+	BA_SEL  = 1,
+	RA_SEL  = 2,
+	Z_SEL   = 3,
+};
+
+enum {
+	X_SEL   = 0,
+	Y_SEL   = 1,
+};
+
+struct tiled_map_config {
+	int  xy2caMap[16];
+	int  xy2baMap[16];
+	int  xy2raMap[16];
+	int  rbc2axiMap[32];
+	int  mapType;
+	int  xy2rbcConfig;
+
+	int  tiledBaseAddr;
