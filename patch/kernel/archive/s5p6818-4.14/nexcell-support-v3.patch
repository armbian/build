+#ifndef _NX_DRM_FB_H_
+#define _NX_DRM_FB_H_
+
+#include <drm/drm_fb_helper.h>
+#include <linux/fb.h>
+#include <video/videomode.h>
+
+struct nx_drm_fb {
+	struct drm_framebuffer	fb;
