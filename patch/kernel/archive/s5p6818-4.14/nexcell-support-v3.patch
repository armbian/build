--- a/drivers/cpuidle/cpuidle-nexell.c	1970-01-01 01:00:00.000000000 +0100
+++ b/drivers/cpuidle/cpuidle-nexell.c	2018-05-06 08:49:49.094692010 +0200
@@ -0,0 +1,105 @@
