+static int cpufreq_min_qos_handler(struct notifier_block *b,
+		unsigned long val, void *v)
+{
+	struct cpufreq_policy *policy;
+	int ret;
+
+	policy = cpufreq_cpu_get(0);
+
+	if (!policy)
+		goto bad;
+
+	if (policy->cur >= val) {
+		cpufreq_cpu_put(policy);
+		goto good;
+	}
+
+	if (!policy->governor) {
+		cpufreq_cpu_put(policy);
+		goto bad;
+	}
+
+	ret = __cpufreq_driver_target(policy, val, CPUFREQ_RELATION_L);
+
+	cpufreq_cpu_put(policy);
+
+	if (ret < 0)
+	    goto bad;
+
+good:
+	return NOTIFY_OK;
+bad:
+	return NOTIFY_BAD;
+}
+
+static int cpufreq_max_qos_handler(struct notifier_block *b,
+		unsigned long val, void *v)
+{
+	struct cpufreq_policy *policy;
+	int ret;
+
+	policy = cpufreq_cpu_get(0);
+
+	if (!policy)
+		goto bad;
+
+	if (policy->cur <= val) {
+		cpufreq_cpu_put(policy);
+		goto good;
+	}
+
+	if (!policy->governor) {
+		cpufreq_cpu_put(policy);
+		goto bad;
+	}
+
+	ret = __cpufreq_driver_target(policy, val, CPUFREQ_RELATION_H);
+
+	cpufreq_cpu_put(policy);
+
+	if (ret < 0)
+		goto bad;
+
+good:
+	return NOTIFY_OK;
+bad:
+	return NOTIFY_BAD;
+}
