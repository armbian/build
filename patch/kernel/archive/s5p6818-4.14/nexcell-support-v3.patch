+#include <drm/drmP.h>
+#include <drm/drm_crtc_helper.h>
+#include <linux/of.h>
+#include <linux/of_graph.h>
+#include <linux/of_address.h>
+
+#include "nx_drm_drv.h"
+#include "nx_drm_crtc.h"
