+static struct v4l2_queryctrl *get_ctrl(int id)
+{
+	int i;
+
+	FUNC_IN();
+
+	for (i = 0; i < NUM_CTRLS; ++i)
+		if (id == controls[i].id)
+			return &controls[i];
+	return NULL;
+}
