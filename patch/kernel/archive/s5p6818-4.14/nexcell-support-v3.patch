+#define XY2CONFIG(A, B, C, D, E, F, G, H, I) \
+	((A)<<20 | (B)<<19 | (C)<<18 | (D)<<17 | (E)<<16 | (F)<<12 | (G)<<8 | \
+	 (H)<<4 | (I))
+#define XY2(A, B, C, D)                 ((A)<<12 | (B)<<8 | (C)<<4 | (D))
+#define XY2BANK(A, B, C, D, E, F) \
+	((A)<<13 | (B)<<12 | (C)<<8 | (D)<<5 | (E)<<4 | (F))
+#define RBC(A, B, C, D)                 ((A)<<10 | (B)<<6 | (C)<<4 | (D))
