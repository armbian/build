+
+	/* speaker connected to HPOL, HPOR */
+	{"Ext Spk", NULL, "HPOL"},
+	{"Ext Spk", NULL, "HPOR"},
+};
+
+/* Headphones jack detection DAPM pin */
+static struct snd_soc_jack_pin jack_pins[] = {
+	{
