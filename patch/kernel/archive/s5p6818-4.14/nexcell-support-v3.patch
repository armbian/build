+}
+
+static ssize_t axp22_pekclose_store(struct device *dev,
+				    struct device_attribute *attr,
+				    const char *buf, size_t count)
+{
+	unsigned long tmp;
+	uint8_t val;
+	int err;
+
+	err = kstrtoul(buf, 10, &tmp);
+	if (err)
+		return err;
+
+	if (tmp < 4000)
+		tmp = 4000;
+	if (tmp > 10000)
+		tmp = 10000;
+	tmp = (tmp - 4000) / 2000;
+	axp_read(dev, AXP22_POK_SET, &val);
+	val &= 0xfc;
+	val |= tmp;
+	axp_write(dev, AXP22_POK_SET, val);
+	return count;
+}
