+	axp_set_bits(axp_dev, 0x8C, 0x0f);
+	axp_set_bits(axp_dev, 0x92, 0x07);
+	axp_set_bits(axp_dev, 0x100, 0x04);
+	dev_dbg(axp_dev, "[AXP228] :Set PMIC sleep mode\n");
+	return 0;
