+	pr_debug("%s (%d)\n", __func__, bit);
+
+	IO_LOCK(ALIVE_INDEX);
+
+	nx_alive_set_output_enable(bit, false);
+	nx_alive_set_detect_enable(bit, on ? true : false);
+
+	IO_UNLOCK(ALIVE_INDEX);
+}
