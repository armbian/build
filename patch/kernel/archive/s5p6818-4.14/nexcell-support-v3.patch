+static inline struct axp_regulator_info *find_regulator_info(int id)
+{
+	struct axp_regulator_info *ri;
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(axp_regulator_info); i++) {
+		ri = &axp_regulator_info[i];
+		if (ri->desc.id == id)
+			return ri;
+	}
+	return NULL;
