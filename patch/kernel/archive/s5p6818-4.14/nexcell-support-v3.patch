+	ME_SEARCH_RAGME_1,	/* Horizontal( -64 ~  63), Vertical(-32 ~ 32) */
+	ME_SEARCH_RAGME_2,	/* Horizontal( -32 ~  31), Vertical(-16 ~ 15) */
+	ME_SEARCH_RAGME_3,	/* Horizontal( -16 ~  15), Vertical(-16 ~ 15) */
+};
+
+/* Frame Buffer Format for JPEG */
+enum {
+	IMG_FORMAT_420 = 0,
+	IMG_FORMAT_422 = 1,
+	IMG_FORMAT_224 = 2,
+	IMG_FORMAT_444 = 3,
+	IMG_FORMAT_400 = 4
+};
+
+/* JPEG Mirror Direction */
+enum {
+	MIRDIR_NONE,
+	MIRDIR_VER,
+	MIRDIR_HOR,
+	MIRDIR_HOR_VER,
+};
+
+/*/////////////////////////////////////////////////////////////////////////// */
+
