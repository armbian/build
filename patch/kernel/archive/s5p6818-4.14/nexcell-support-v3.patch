+	pregister = __g_module_variables[module_index].pregister;
+	switch (layer_name) {
+	case topmlc:
+		control_reg_value = readl(&pregister->mlccontrolt);
+		writel((u32) (control_reg_value | (sram_mode << 10)),
+		       &pregister->mlccontrolt);
