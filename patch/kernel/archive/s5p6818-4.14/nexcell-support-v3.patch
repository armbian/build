+	.init		= es8316_dai_init,
+};
+
+static struct snd_soc_card es8316_card = {
+	.name			= "I2S-ES8316",	/* proc/asound/cards */
+	.owner			= THIS_MODULE,
+	.dai_link		= &es8316_dai_link,
