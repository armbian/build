+static ssize_t axp22_pekdelay_store(struct device *dev,
+				    struct device_attribute *attr,
+				    const char *buf, size_t count)
+{
+	unsigned long tmp;
+	uint8_t val;
+	int err;
+
+	err = kstrtoul(buf, 10, &tmp);
+	if (err)
+		return err;
+
+	if (tmp <= 8)
+		tmp = 0;
+	else
+		tmp = 1;
+	axp_read(dev, AXP22_POK_SET, &val);
+	val &= 0xfb;
+	val |= tmp << 2;
+	axp_write(dev, AXP22_POK_SET, val);
+	return count;
+}
