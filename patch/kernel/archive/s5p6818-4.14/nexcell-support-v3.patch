+static int nxp_cpufreq_verify_speed(struct cpufreq_policy *policy)
+{
+	struct cpufreq_dvfs_info *dvfs = get_dvfs_ptr();
+	struct cpufreq_frequency_table *freq_table = dvfs->freq_table;
