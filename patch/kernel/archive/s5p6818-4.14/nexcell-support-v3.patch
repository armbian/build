--- a/drivers/soc/nexell/s5pxx18/tieoff_init.c	1970-01-01 01:00:00.000000000 +0100
+++ b/drivers/soc/nexell/s5pxx18/tieoff_init.c	2018-05-06 08:49:51.094773166 +0200
@@ -0,0 +1,163 @@
+/*
