+	.buf_prepare            = nx_vpu_buf_prepare,
+	.start_streaming        = nx_vpu_enc_start_streaming,
+	.stop_streaming         = nx_vpu_enc_stop_streaming,
+	.buf_queue              = nx_vpu_enc_buf_queue,
+};
