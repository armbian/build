+static struct notifier_block cpufreq_min_qos_notifier = {
+	.notifier_call = cpufreq_min_qos_handler,
+};
+
+static struct notifier_block cpufreq_max_qos_notifier = {
+	.notifier_call = cpufreq_max_qos_handler,
+};
