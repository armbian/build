+#define V4L2_CID_MPEG_VIDEO_FORCE_I_FRAME	(V4L2_CID_NXP_VPU_BASE + 0x9)
+#define V4L2_CID_MPEG_VIDEO_FORCE_SKIP_FRAME	(V4L2_CID_NXP_VPU_BASE + 0xA)
