+	unsigned int bit = PAD_GET_BITNO(io);
+	int mod = -1;
+	int det = 0;
+
+	pr_debug("%s (%d.%02d)\n", __func__, grp, bit);
+
+	switch (io & ~(32 - 1)) {
+	case PAD_GPIO_A:
+	case PAD_GPIO_B:
+	case PAD_GPIO_C:
+	case PAD_GPIO_D:
+	case PAD_GPIO_E:
+		IO_LOCK(grp);
+		mod = nx_gpio_get_interrupt_mode(grp, bit);
+		IO_UNLOCK(grp);
+		break;
+	case PAD_GPIO_ALV:
+		IO_LOCK(grp);
+		for (det = 0; 6 > det; det++) {
+			if (nx_alive_get_detect_mode(det, bit)) {
+				mod = det;
+				break;
+			}
+		}
+		IO_UNLOCK(grp);
+		break;
+	default:
+		pr_err("fail, soc gpio io:%d, group:%d (%s)\n", io, grp,
+		       __func__);
+		break;
+	};
+	return mod;
+}
