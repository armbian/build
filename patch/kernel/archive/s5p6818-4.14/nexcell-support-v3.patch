+}
+
+void nx_mipi_dsi_set_escape_lp(u32 module_index,
+				enum nx_mipi_dsi_lpmode cmdin_lp,
+				enum nx_mipi_dsi_lpmode txinlp)
+{
+	register struct nx_mipi_register_set *pregister;
