From dc4ead1d3e57d5939062e0e22c5707cc8a94aa9f Mon Sep 17 00:00:00 2001
From: retro98boy <retro98boy@qq.com>
Date: Sun, 23 Aug 2026 15:40:29 +0800
Subject: [PATCH 11/18] drm/rockchip: add RK3562 MIPI DSI support

Add RK3562 chip data for the Rockchip DesignWare MIPI DSI bridge.

The RK3562 uses an external Innosilicon D-PHY, so select the Rockchip BSP transition timing values instead of the Synopsys internal-PHY timing table. Configure the RK3562 system GRF lane-control register to clear force-TX-stop, force-RX, and turn-disable controls, and describe the four-lane capability.

Match the new RK3562 device-tree compatible while leaving the existing timing and chip-data paths unchanged for other SoCs.
---
 .../gpu/drm/rockchip/dw-mipi-dsi-rockchip.c   | 40 +++++++++++++++++++
 1 file changed, 40 insertions(+)

diff --git a/drivers/gpu/drm/rockchip/dw-mipi-dsi-rockchip.c b/drivers/gpu/drm/rockchip/dw-mipi-dsi-rockchip.c
index 3547d91b2..0c33bf605 100644
--- a/drivers/gpu/drm/rockchip/dw-mipi-dsi-rockchip.c
+++ b/drivers/gpu/drm/rockchip/dw-mipi-dsi-rockchip.c
@@ -203,6 +203,11 @@
 #define RK3506_DSI_TURNDISABLE		BIT(2)
 #define RK3506_DSI_FORCERXMODE		BIT(0)
 
+#define RK3562_SYS_GRF_VO_CON1		0x05d4
+#define RK3562_DSI_FORCETXSTOPMODE	(0xf << 4)
+#define RK3562_DSI_TURNDISABLE		BIT(2)
+#define RK3562_DSI_FORCERXMODE		BIT(0)
+
 /*
  * Note these registers do not appear in the datasheet, they are
  * however present in the BSP driver which is where these values
@@ -268,6 +273,7 @@ struct rockchip_dw_dsi_chip_data {
 
 	unsigned int flags;
 	unsigned int max_data_lanes;
+	bool external_dphy_hstt;
 };
 
 struct dw_mipi_dsi_rockchip {
@@ -718,12 +724,30 @@ static struct hstt hstt_table[] = {
 	HSTT(1500, 181, 66, 153, 50)
 };
 
+/*
+ * The external Innosilicon D-PHY used by RK3562 uses the Rockchip
+ * transition timing values rather than the Synopsys internal-PHY table.
+ * This matches the Rockchip BSP driver.
+ */
+static const struct dw_mipi_dsi_dphy_timing external_dphy_hstt = {
+	.clk_lp2hs = 0x40,
+	.clk_hs2lp = 0x40,
+	.data_lp2hs = 0x10,
+	.data_hs2lp = 0x14,
+};
+
 static int
 dw_mipi_dsi_phy_get_timing(void *priv_data, unsigned int lane_mbps,
 			   struct dw_mipi_dsi_dphy_timing *timing)
 {
+	struct dw_mipi_dsi_rockchip *dsi = priv_data;
 	int i;
 
+	if (dsi->cdata->external_dphy_hstt) {
+		*timing = external_dphy_hstt;
+		return 0;
+	}
+
 	for (i = 0; i < ARRAY_SIZE(hstt_table); i++)
 		if (lane_mbps < hstt_table[i].maxfreq)
 			break;
@@ -1678,6 +1702,19 @@ static const struct rockchip_dw_dsi_chip_data rk3506_chip_data[] = {
 	{ /* sentinel */ }
 };
 
+static const struct rockchip_dw_dsi_chip_data rk3562_chip_data[] = {
+	{
+		.reg = 0xffb10000,
+		.lanecfg1_grf_reg = RK3562_SYS_GRF_VO_CON1,
+		.lanecfg1 = (FIELD_PREP_WM16_CONST(RK3562_DSI_TURNDISABLE, 0) |
+			     FIELD_PREP_WM16_CONST(RK3562_DSI_FORCERXMODE, 0) |
+			     FIELD_PREP_WM16_CONST(RK3562_DSI_FORCETXSTOPMODE, 0)),
+		.max_data_lanes = 4,
+		.external_dphy_hstt = true,
+	},
+	{ /* sentinel */ }
+};
+
 static const struct rockchip_dw_dsi_chip_data rk3568_chip_data[] = {
 	{
 		.reg = 0xfe060000,
@@ -1731,6 +1768,9 @@ static const struct of_device_id dw_mipi_dsi_rockchip_dt_ids[] = {
 	}, {
 	 .compatible = "rockchip,rk3506-mipi-dsi",
 	 .data = &rk3506_chip_data,
+	}, {
+	 .compatible = "rockchip,rk3562-mipi-dsi",
+	 .data = &rk3562_chip_data,
 	}, {
 	 .compatible = "rockchip,rk3568-mipi-dsi",
 	 .data = &rk3568_chip_data,
-- 
