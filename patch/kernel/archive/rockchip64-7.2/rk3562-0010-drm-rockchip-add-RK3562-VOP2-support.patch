+/* RK3562-specific interface, overlay and timing configuration. */
+static unsigned long rk3562_set_intf_mux(struct vop2_video_port *vp, int id, u32 polflags)
+{
+	struct vop2 *vop2 = vp->vop2;
+	struct drm_crtc *crtc = &vp->crtc;
+	u32 die, dip;
+
+	die = vop2_readl(vop2, RK3568_DSP_IF_EN);
+	dip = vop2_readl(vop2, RK3568_DSP_IF_POL);
+
+	switch (id) {
+	case ROCKCHIP_VOP2_EP_RGB0:
+		die &= ~RK3568_SYS_DSP_INFACE_EN_RGB_MUX;
+		die |= RK3568_SYS_DSP_INFACE_EN_RGB |
+			   FIELD_PREP(RK3568_SYS_DSP_INFACE_EN_RGB_MUX, vp->id);
+		dip &= ~RK3562_DSP_IF_POL__RGB_LVDS_PIN_POL;
+		dip |= FIELD_PREP(RK3562_DSP_IF_POL__RGB_LVDS_PIN_POL, polflags);
+		if (polflags & POLFLAG_DCLK_INV)
+			regmap_write(vop2->sys_grf, RK3562_GRF_IOC_VO_IO_CON,
+				     BIT(3 + 16) | BIT(3));
+		else
+			regmap_write(vop2->sys_grf, RK3562_GRF_IOC_VO_IO_CON,
+				     BIT(3 + 16));
+		break;
+	case ROCKCHIP_VOP2_EP_MIPI0:
+		die &= ~RK3568_SYS_DSP_INFACE_EN_MIPI0_MUX;
+		die |= RK3568_SYS_DSP_INFACE_EN_MIPI0 |
+			   FIELD_PREP(RK3568_SYS_DSP_INFACE_EN_MIPI0_MUX, vp->id);
+		dip &= ~(RK3562_DSP_IF_POL__MIPI_PIN_POL |
+			  RK3562_DSP_IF_POL__MIPI_DCLK_POL);
+		dip |= FIELD_PREP(RK3562_DSP_IF_POL__MIPI_PIN_POL, polflags);
+		if (polflags & POLFLAG_DCLK_INV)
+			dip |= RK3562_DSP_IF_POL__MIPI_DCLK_POL;
+		break;
+	case ROCKCHIP_VOP2_EP_LVDS0:
+		die &= ~RK3568_SYS_DSP_INFACE_EN_LVDS0_MUX;
+		die |= RK3568_SYS_DSP_INFACE_EN_LVDS0 |
+			   FIELD_PREP(RK3568_SYS_DSP_INFACE_EN_LVDS0_MUX, vp->id);
+		dip &= ~(RK3562_DSP_IF_POL__RGB_LVDS_PIN_POL |
+			  RK3562_DSP_IF_POL__LVDS_DCLK_POL);
+		dip |= FIELD_PREP(RK3562_DSP_IF_POL__RGB_LVDS_PIN_POL, polflags);
+		if (polflags & POLFLAG_DCLK_INV)
+			dip |= RK3562_DSP_IF_POL__LVDS_DCLK_POL;
+		break;
+	default:
+		drm_err(vop2->drm, "Invalid interface id %d on vp%d\n", id, vp->id);
+		return 0;
+	}
+
+	dip |= RK3568_DSP_IF_POL__CFG_DONE_IMD;
+
+	vop2_writel(vop2, RK3568_DSP_IF_EN, die);
+	vop2_writel(vop2, RK3568_DSP_IF_POL, dip);
+
+	return crtc->state->adjusted_mode.crtc_clock * 1000LL;
+}
+
+static void rk3562_vop2_setup_dly_for_windows(struct vop2_video_port *vp)
+{
+	struct vop2 *vop2 = vp->vop2;
+	struct vop2_win *win;
+	int i;
+
+	for (i = 0; i < vop2->data->win_size; i++) {
+		win = &vop2->win[i];
+
+		switch (win->data->phys_id) {
+		case ROCKCHIP_VOP2_ESMART0:
+			regmap_update_bits(vop2->map, RK3562_OVL_SYS_ESMART0_CTRL,
+					   0xff, win->delay);
+			break;
+		case ROCKCHIP_VOP2_ESMART1:
+			regmap_update_bits(vop2->map, RK3562_OVL_SYS_ESMART1_CTRL,
+					   0xff, win->delay);
+			break;
+		case ROCKCHIP_VOP2_ESMART2:
+			regmap_update_bits(vop2->map, RK3562_OVL_SYS_ESMART2_CTRL,
+					   0xff, win->delay);
+			break;
+		case ROCKCHIP_VOP2_ESMART3:
+			regmap_update_bits(vop2->map, RK3562_OVL_SYS_ESMART3_CTRL,
+					   0xff, win->delay);
+			break;
+		default:
+			break;
+		}
+	}
+}
+
+static void rk3562_vop2_setup_layer_mixer(struct vop2_video_port *vp)
+{
+	struct vop2 *vop2 = vp->vop2;
+	struct drm_plane *plane;
+	u32 layer_sel = 0;
+	u32 port_sel = 0;
+
+	mutex_lock(&vop2->ovl_lock);
+
+	drm_atomic_crtc_for_each_plane(plane, &vp->crtc) {
+		struct vop2_win *win = to_vop2_win(plane);
+		u8 layer_id = plane->state->normalized_zpos;
+		u32 sel_mask, sel_shift;
+
+		switch (win->data->phys_id) {
+		case ROCKCHIP_VOP2_ESMART0:
+			sel_mask = GENMASK(17, 16);
+			sel_shift = 16;
+			break;
+		case ROCKCHIP_VOP2_ESMART1:
+			sel_mask = GENMASK(21, 20);
+			sel_shift = 20;
+			break;
+		case ROCKCHIP_VOP2_ESMART2:
+			sel_mask = GENMASK(25, 24);
+			sel_shift = 24;
+			break;
+		case ROCKCHIP_VOP2_ESMART3:
+			sel_mask = GENMASK(29, 28);
+			sel_shift = 28;
+			break;
+		default:
+			continue;
+		}
+
+		port_sel &= ~sel_mask;
+		port_sel |= (u32)(vp->id << sel_shift) & sel_mask;
+		layer_sel &= ~(0xf << (layer_id * 4));
+		layer_sel |= (u32)(win->data->layer_sel_id[vp->id] << (layer_id * 4));
+	}
+
+	vop2_writel(vop2, RK3562_OVL_SYS_PORT_SEL_IMD, port_sel);
+	vop2_writel(vop2, RK3562_OVL_PORT0_LAYER_SEL, layer_sel);
+
+	mutex_unlock(&vop2->ovl_lock);
+}
+
+static void rk3562_vop2_setup_overlay(struct vop2_video_port *vp)
+{
+	struct vop2 *vop2 = vp->vop2;
+	struct rockchip_crtc_state *vcstate = to_rockchip_crtc_state(vp->crtc.state);
+	struct drm_crtc *crtc = &vp->crtc;
+	struct drm_plane *plane;
+	u32 ovl_ctrl;
+
+	mutex_lock(&vop2->ovl_lock);
+	ovl_ctrl = vop2_readl(vop2, RK3562_OVL_PORT0_CTRL);
+	if (vcstate->yuv_overlay)
+		ovl_ctrl |= RK3562_OVL_PORT0_CTRL__OVERLAY_MODE;
+	else
+		ovl_ctrl &= ~RK3562_OVL_PORT0_CTRL__OVERLAY_MODE;
+	vop2_writel(vop2, RK3562_OVL_PORT0_CTRL, ovl_ctrl);
+	mutex_unlock(&vop2->ovl_lock);
+
+	vp->win_mask = 0;
+
+	drm_atomic_crtc_for_each_plane(plane, crtc) {
+		struct vop2_win *win = to_vop2_win(plane);
+
+		win->delay = win->data->dly[VOP2_DLY_MODE_DEFAULT];
+		vp->win_mask |= BIT(win->data->phys_id);
+	}
+
+	if (!vp->win_mask)
+		return;
+
+	rk3562_vop2_setup_layer_mixer(vp);
+	vop2_setup_alpha(vp);
+	rk3562_vop2_setup_dly_for_windows(vp);
+}
+
+static void rk3562_vop2_setup_bg_dly(struct vop2_video_port *vp)
+{
+	struct drm_crtc *crtc = &vp->crtc;
+	struct drm_display_mode *mode = &crtc->state->adjusted_mode;
+	u16 hdisplay = mode->crtc_hdisplay;
+	u16 hsync_len = mode->crtc_hsync_end - mode->crtc_hsync_start;
+	u32 bg_dly;
+	u32 pre_scan_dly;
+
+	bg_dly = vp->data->pre_scan_max_dly[3];
