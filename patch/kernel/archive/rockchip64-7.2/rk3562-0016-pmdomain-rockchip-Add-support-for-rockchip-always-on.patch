From 62e44517f8fcd0f2b2770132ebe88c67e5b35cd8 Mon Sep 17 00:00:00 2001
From: retro98boy <retro98boy@qq.com>
Date: Sun, 16 Aug 2026 14:43:13 +0800
Subject: [PATCH 16/18] pmdomain: rockchip: Add support for rockchip,always-on
 power domains

---
 drivers/pmdomain/rockchip/pm-domains.c | 24 ++++++++++++++++++++++++
 1 file changed, 24 insertions(+)

diff --git a/drivers/pmdomain/rockchip/pm-domains.c b/drivers/pmdomain/rockchip/pm-domains.c
index 490bbb1d1..cd1908288 100644
--- a/drivers/pmdomain/rockchip/pm-domains.c
+++ b/drivers/pmdomain/rockchip/pm-domains.c
@@ -729,6 +729,25 @@ static int rockchip_pd_power_off(struct generic_pm_domain *domain)
 	return ret;
 }
 
+static int rockchip_pd_set_always_on(struct rockchip_pm_domain *pd)
+{
+	int ret;
+
+	pd->genpd.flags |= GENPD_FLAG_ALWAYS_ON;
+
+	if (rockchip_pmu_domain_is_on(pd))
+		return 0;
+
+	ret = rockchip_pd_power(pd, true);
+	if (ret) {
+		pd->genpd.flags &= ~GENPD_FLAG_ALWAYS_ON;
+		dev_err(pd->pmu->dev, "failed to power on always-on domain '%s': %d\n",
+			pd->genpd.name, ret);
+	}
+
+	return ret;
+}
+
 static int rockchip_pd_attach_dev(struct generic_pm_domain *genpd,
 				  struct device *dev)
 {
@@ -895,6 +914,11 @@ static int rockchip_pm_add_one_domain(struct rockchip_pmu *pmu,
 	pd->genpd.flags = GENPD_FLAG_PM_CLK | GENPD_FLAG_NO_STAY_ON;
 	if (pd_info->active_wakeup)
 		pd->genpd.flags |= GENPD_FLAG_ACTIVE_WAKEUP;
+	if (of_property_read_bool(node, "rockchip,always-on")) {
+		error = rockchip_pd_set_always_on(pd);
+		if (error)
+			goto err_unprepare_clocks;
+	}
 	pm_genpd_init(&pd->genpd, NULL,
 		      !rockchip_pmu_domain_is_on(pd) ||
 		      (pd->info->mem_status_mask && !rockchip_pmu_domain_is_mem_on(pd)));
-- 
2.55.0

