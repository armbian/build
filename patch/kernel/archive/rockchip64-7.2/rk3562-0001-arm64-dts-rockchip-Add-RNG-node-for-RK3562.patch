From 042e37846137c592058ac9c865c0481e6ac9d05a Mon Sep 17 00:00:00 2001
From: retro98boy <retro98boy@qq.com>
Date: Sat, 29 Aug 2026 18:42:45 +0800
Subject: [PATCH 01/18] arm64: dts: rockchip: Add RNG node for RK3562

---
 arch/arm64/boot/dts/rockchip/rk3562.dtsi | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/arch/arm64/boot/dts/rockchip/rk3562.dtsi b/arch/arm64/boot/dts/rockchip/rk3562.dtsi
index e4816aa3d..21f604579 100644
--- a/arch/arm64/boot/dts/rockchip/rk3562.dtsi
+++ b/arch/arm64/boot/dts/rockchip/rk3562.dtsi
@@ -1093,6 +1093,14 @@ sdmmc1: mmc@ff890000 {
 			status = "disabled";
 		};
 
+		rng: rng@ff8e0000 {
+			compatible = "rockchip,rk3576-rng";
+			reg = <0x0 0xff8e0000 0x0 0x200>;
+			clocks = <&scmi_clk HCLK_RK_RNG_NS>;
+			interrupts = <GIC_SPI 93 IRQ_TYPE_LEVEL_HIGH>;
+			resets = <&cru SRST_H_RK_RNG_NS>;
+		};
+
 		otp: efuse@ff930000 {
 			compatible = "rockchip,rk3562-otp";
 			reg = <0x0 0xff930000 0x0 0x4000>;
-- 
2.55.0

