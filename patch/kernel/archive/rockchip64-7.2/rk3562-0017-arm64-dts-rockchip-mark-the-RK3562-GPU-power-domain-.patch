From 3177cbb61041d67802a8bb8f25d09de0e3589fb8 Mon Sep 17 00:00:00 2001
From: retro98boy <retro98boy@qq.com>
Date: Sun, 16 Aug 2026 14:59:07 +0800
Subject: [PATCH 17/18] arm64: dts: rockchip: mark the RK3562 GPU power domain
 as always-on

---
 arch/arm64/boot/dts/rockchip/rk3562.dtsi | 1 +
 1 file changed, 1 insertion(+)

diff --git a/arch/arm64/boot/dts/rockchip/rk3562.dtsi b/arch/arm64/boot/dts/rockchip/rk3562.dtsi
index 164a48ad6..22081c026 100644
--- a/arch/arm64/boot/dts/rockchip/rk3562.dtsi
+++ b/arch/arm64/boot/dts/rockchip/rk3562.dtsi
@@ -747,6 +747,7 @@ power: power-controller {
 				#size-cells = <0>;
 
 				power-domain@RK3562_PD_GPU {
+					rockchip,always-on;
 					reg = <RK3562_PD_GPU>;
 					pm_qos = <&qos_gpu>;
 					#power-domain-cells = <0>;
-- 
2.55.0

