From: Igor Pecovnik <igor@armbian.com>
Subject: [PATCH] arm64: dts: rockchip: rock-2: enable USB

Enable the USB 2.0 PHY and the host controllers, as upstream does from
7.0. The ROCK 2F has no Ethernet, so without USB it has no network.

Assisted-by: Claude Opus 5.5
Signed-off-by: Igor Pecovnik <igor@armbian.com>
---
diff -ruN a/arch/arm64/boot/dts/rockchip/rk3528-rock-2.dtsi b/arch/arm64/boot/dts/rockchip/rk3528-rock-2.dtsi
--- a/arch/arm64/boot/dts/rockchip/rk3528-rock-2.dtsi	2026-10-23 05:39:45.253295135 +0000
+++ b/arch/arm64/boot/dts/rockchip/rk3528-rock-2.dtsi	2026-10-23 05:39:45.261295209 +0000
@@ -291,3 +291,20 @@
 	pinctrl-0 = <&uart0m0_xfer>;
 	status = "okay";
 };
+
+&u2phy {
+	status = "okay";
+};
+
+&u2phy_host {
+	phy-supply = <&vcc5v0_usb20>;
+	status = "okay";
+};
+
+&usb_host0_ehci {
+	status = "okay";
+};
+
+&usb_host0_ohci {
+	status = "okay";
+};
diff -ruN a/arch/arm64/boot/dts/rockchip/rk3528-rock-2f.dts b/arch/arm64/boot/dts/rockchip/rk3528-rock-2f.dts
--- a/arch/arm64/boot/dts/rockchip/rk3528-rock-2f.dts	2026-10-23 05:39:45.257295172 +0000
+++ b/arch/arm64/boot/dts/rockchip/rk3528-rock-2f.dts	2026-10-23 05:39:45.265295248 +0000
@@ -8,3 +8,15 @@
 	model = "Radxa ROCK 2F";
 	compatible = "radxa,rock-2f", "rockchip,rk3528";
 };
+
+&u2phy_otg {
+	status = "okay";
+};
+
+&usb_host0_xhci {
+	extcon = <&u2phy>;
+	maximum-speed = "high-speed";
+	phys = <&u2phy_otg>;
+	phy-names = "usb2-phy";
+	status = "okay";
+};
