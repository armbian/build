From: Igor Pecovnik <igor@armbian.com>
Subject: [PATCH] arm64: dts: rockchip: rock-2a: enable the USB 3.0 port

Enable the XHCI controller with the USB 2.0 OTG PHY and the combo PHY,
as upstream does from 7.0. Without this patch the USB 3.0 port is dead.

Assisted-by: Claude Opus 5.5
Signed-off-by: Igor Pecovnik <igor@armbian.com>
---
diff -ruN a/arch/arm64/boot/dts/rockchip/rk3528-rock-2a.dts b/arch/arm64/boot/dts/rockchip/rk3528-rock-2a.dts
--- a/arch/arm64/boot/dts/rockchip/rk3528-rock-2a.dts	2026-10-23 08:36:05.128428906 +0000
+++ b/arch/arm64/boot/dts/rockchip/rk3528-rock-2a.dts	2026-10-23 08:36:05.132428945 +0000
@@ -80,3 +80,20 @@
 		};
 	};
 };
+
+&combphy {
+	status = "okay";
+};
+
+&u2phy_otg {
+	phy-supply = <&vcc5v0_usb30_otg>;
+	status = "okay";
+};
+
+&usb_host0_xhci {
+	dr_mode = "host";
+	extcon = <&u2phy>;
+	phys = <&u2phy_otg>, <&combphy PHY_TYPE_USB3>;
+	phy-names = "usb2-phy", "usb3-phy";
+	status = "okay";
+};
