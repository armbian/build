From 2457374cc07f2f8695d29b4dd5d73e63db08506e Mon Sep 17 00:00:00 2001
From: Sergey Braumann <ripetitor@proton.me>
Date: Sat, 12 Sep 2026 18:04:52 +0500
Subject: [PATCH 2/2] dt-bindings: arm: rockchip: add ELTAY RM66

Document the generic ELTAY RM66 compatible and the ELTAY BB CM4
carrier composition. Both use the Rockchip RK3566 SoC.

Signed-off-by: Sergey Braumann <ripetitor@proton.me>
---
 Documentation/devicetree/bindings/arm/rockchip.yaml | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/Documentation/devicetree/bindings/arm/rockchip.yaml b/Documentation/devicetree/bindings/arm/rockchip.yaml
index 6aceaa8ac..c2e6b901b 100644
--- a/Documentation/devicetree/bindings/arm/rockchip.yaml
+++ b/Documentation/devicetree/bindings/arm/rockchip.yaml
@@ -160,6 +160,17 @@ properties:
           - const: elgin,rv1108-r1
           - const: rockchip,rv1108
 
+      - description: ELTAY RM66
+        items:
+          - const: elron,eltay-rm66
+          - const: rockchip,rk3566
+
+      - description: ELTAY RM66 on ELTAY BB CM4 carrier board
+        items:
+          - const: elron,eltay-rm66-bb-cm4
+          - const: elron,eltay-rm66
+          - const: rockchip,rk3566
+
       - description: EmbedFire LubanCat 1
         items:
           - const: embedfire,lubancat-1
