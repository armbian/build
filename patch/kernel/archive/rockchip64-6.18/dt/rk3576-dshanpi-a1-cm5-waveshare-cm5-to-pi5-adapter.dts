// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
/*
 * Copyright (c) 2026 sckiyo <sckiyo@outlook.com>
 *
 * 100ASK DshanPi A1 CM5 on the Waveshare CM5-to-Pi5-Adapter.
 * The DshanPi A1 CM5 is the core module. The Waveshare board is the carrier.
 * The module exposes three connectors, each numbered from 1.
 * CN1 and CN2 present the Raspberry Pi CM5 socket, positions 1-200.
 * CN1 holds positions 1-100. CN2 holds positions 101-200.
 * CN3 is a private module connector.
 * Some pins on CN1 and CN2 carry module lines that differ from the Raspberry Pi spec.
 *
 * The Type-C port has no PD controller and no CC pull-downs.
 * A C-to-C USB cable does not power the board.
 * Use a C-to-A USB cable or the 5 V pins on the 40-pin header.
 * The PSW button connects to CN1 pin 92.
 * The Raspberry Pi spec names pin 92 PWR_Button.
 * The module wires its reset input to that pin. The button resets the board.
 * PWRON_L is the power key line. PWRON_L sits on CN1 pin 99.
 * The Raspberry Pi spec puts PMIC_Enable on pin 99.
 * This carrier leaves pin 99 open, so the board has no power key.
 * The BOOT button pulls CN1 pin 93 low.
 * The Raspberry Pi spec names pin 93 nRPIBOOT, which is active low.
 * The module wires its active-high MASKROM input to that pin.
 * The BOOT button has no effect.
 * To enter Maskrom, run "systemctl reboot --reboot-argument=maskrom".
 * BootROM also enters Maskrom when it finds no valid boot media.
 * The carrier TF slot uses the module SDMMC0_PWREN line.
 * The RJ45 uses the on-module YT8521S PHY.
 * A CH334F USB 2.0 hub sits on the Raspberry Pi USB3-1 D+/D- pins.
 * The CH334F reset pin is not a SoC GPIO.
 * The hub feeds the lower USB 3.0 port, both USB 2.0 ports, and the audio codec.
 * The lower USB 3.0 port also uses the USB3-1 SuperSpeed pins.
 * The upper USB 3.0 port uses all the Raspberry Pi USB3-0 pins.
 * The module routes no USB to the USB3-0 pins, so the upper port stays dead.
 * GPIO1_C1 enables VBUS for the USB ports.
 * The module drives one HDMI port, on the Raspberry Pi HDMI0 pins.
 * The HDMI1 connector on this carrier has no HDMI signal.
 * The two 22-pin MIPI connectors carry the module CSI3 and DSI lanes.
 * The lanes align with the Raspberry Pi spec positions.
 * Camera and DSI support is untested, so this DT ships no nodes for them.
 * The headphone jack uses a USB audio codec on the hub.
 * This carrier wires no codec to the module audio pins.
 * The fan header PWM line is on CN1 pin 19.
 * The fan header tachometer line is on CN1 pin 16.
 * The module leaves pin 16 open.
 * A PCIe 2.0 connector uses PCIE0.
 * The activity LED is GPIO4_C7 on CN1 pin 21.
 */

/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/pinctrl/rockchip.h>
#include "rk3576-dshanpi-a1-cm5.dtsi"

/ {
	model = "100ASK DshanPi A1 CM5 on Waveshare CM5-to-Pi5-Adapter";
	compatible = "waveshare,cm5-to-pi5-adapter",
		     "100ask,dshanpi-a1-cm5", "rockchip,rk3576";

	chosen {
		stdout-path = "serial0:1500000n8";
	};

	/* Micro HDMI on this carrier. Type "d" is the micro plug. */
	hdmi-con {
		compatible = "hdmi-connector";
		type = "d";

		port {
			hdmi_con_in: endpoint {
				remote-endpoint = <&hdmi_out_con>;
			};
		};
	};

	vcc3v3_sd_s0: regulator-vcc3v3-sd-s0 {
		compatible = "regulator-fixed";
		enable-active-high;
		gpio = <&gpio0 RK_PB6 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&sdmmc_pwr_en>;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-name = "vcc3v3_sd_s0";
		vin-supply = <&vcc_3v3_s0>;
	};

	/*
	 * 4-pin fan on this carrier.
	 * PWM is CN1 pin 19, PWM1_CH0_M0 on GPIO0_B4.
	 * The carrier wires the line straight through. Use active-high PWM.
	 * Period is 40000 ns, so the PWM frequency is 25 kHz.
	 * Tachometer is CN1 pin 16. The module leaves that pin open, so Linux reads no fan speed.
	 */
	fan: pwm-fan {
		compatible = "pwm-fan";
		#cooling-cells = <2>;
		pwms = <&pwm1_6ch_0 0 40000 0>;
		cooling-levels = <0 100 150 200 255>;
	};

	/*
	 * Activity LED on CN1 pin 21, GPIO4_C7.
	 * A SN74LVC1G07 buffer follows the GPIO.
	 * A high GPIO turns the LED on.
	 */
	leds {
		compatible = "gpio-leds";
		pinctrl-names = "default";
		pinctrl-0 = <&act_led>;

		act {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_ACTIVITY;
			gpios = <&gpio4 RK_PC7 GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "heartbeat";
		};
	};

	/*
	 * USB VBUS load switches U5 and U6. GPIO1_C1 enables both, active high.
	 * The module net name is TYPEC5V_PWREN_H.
	 * This carrier calls the same pin VBUS_EN.
	 * U5 and U6 feed VBUS on all four USB-A ports.
	 * Type-C VBUS ties directly to 5 V.
	 * Keep the regulator always on. Do not use it as a PHY supply.
	 * A PHY supply would switch all four ports together.
	 */
	vbus_5v: regulator-vbus-5v {
		compatible = "regulator-fixed";
		enable-active-high;
		gpio = <&gpio1 RK_PC1 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&usb_vbus_en>;
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		regulator-name = "vbus_5v";
		vin-supply = <&vcc5v0_sys>;
	};
};

&hdmi_out {
	hdmi_out_con: endpoint {
		remote-endpoint = <&hdmi_con_in>;
	};
};

&pinctrl {
	sdmmc {
		sdmmc_pwr_en: sdmmc-pwr-en {
			rockchip,pins = <0 RK_PB6 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	leds {
		act_led: act-led {
			rockchip,pins = <4 RK_PC7 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	usb {
		usb_vbus_en: usb-vbus-en {
			rockchip,pins = <1 RK_PC1 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	pcie {
		pcie0_perstn: pcie0-perstn {
			rockchip,pins = <1 RK_PB7 RK_FUNC_GPIO &pcfg_pull_up>;
		};

		/* WAKE# is open-drain. Hold it high. */
		pcie0_wake: pcie0-wake {
			rockchip,pins = <0 RK_PC3 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};
};

/*
 * CN1 pin 76 carries the module line SDMMC0_DET_H.
 * R143 (100K) on the module pulls pin 76 down.
 * Q11 on the module inverts pin 76 onto SDMMC0_DET_L, GPIO0_A7.
 * A high pin 76 drives the SoC pin low.
 * A low SoC pin selects SDMMC. A high SoC pin selects JTAG.
 * BootROM tries eMMC, then SDMMC0, then USB.
 * With pin 76 low, the BootROM skips the TF slot.
 * U-Boot and Linux see no card either.
 * An eMMC loader can still start.
 * TF boot needs pin 76 high. eMMC-only boot needs no change.
 * This carrier wires pin 76 only to the RTC battery pad.
 * Fit one source on that pad.
 * Use the RTC battery, a 10K pull-up to 3.3 V, or an external 3.3 V supply.
 * BootROM then uses the TF card when eMMC is absent or has no loader.
 * U-Boot then tries the TF card before eMMC.
 * A fitted source keeps pin 76 high.
 * An empty slot still looks present, and TF init then times out.
 * The timeout costs a short delay. Boot continues normally.
 * Nothing on the carrier or module charges the RTC battery.
 */
&sdmmc {
	bus-width = <4>;
	cap-sd-highspeed;
	disable-wp;
	max-frequency = <200000000>;
	no-mmc;
	no-sdio;
	sd-uhs-sdr104;
	pinctrl-0 = <&sdmmc0_clk &sdmmc0_cmd &sdmmc0_det &sdmmc0_bus4>;
	vmmc-supply = <&vcc3v3_sd_s0>;
	vqmmc-supply = <&vccio_sd_s0>;
	status = "okay";
};

/* PWM1 channel 0 drives GPIO0_B4 through the pwm1m0_ch0 pin group. */
&pwm1_6ch_0 {
	status = "okay";
};

/*
 * Raise the fan as the package warms.
 * Level 0 is off. Level 4 is full speed.
 */
&package_thermal {
	polling-delay = <1000>;

	trips {
		package_fan0: package-fan0 {
			temperature = <40000>;
			hysteresis = <2000>;
			type = "active";
		};

		package_fan1: package-fan1 {
			temperature = <55000>;
			hysteresis = <2000>;
			type = "active";
		};

		package_fan2: package-fan2 {
			temperature = <60000>;
			hysteresis = <2000>;
			type = "active";
		};

		package_fan3: package-fan3 {
			temperature = <65000>;
			hysteresis = <2000>;
			type = "active";
		};
	};

	cooling-maps {
		map-fan0 {
			trip = <&package_fan0>;
			cooling-device = <&fan 1 1>;
		};

		map-fan1 {
			trip = <&package_fan1>;
			cooling-device = <&fan 2 2>;
		};

		map-fan2 {
			trip = <&package_fan2>;
			cooling-device = <&fan 3 3>;
		};

		map-fan3 {
			trip = <&package_fan3>;
			cooling-device = <&fan 4 4>;
		};
	};
};

/*
 * PCIe 2.0 connector on this carrier.
 * CLKREQ is GPIO1_B6, pcie0m1. PERST is GPIO1_B7, active low.
 * WAKE is GPIO0_C3 and stays a pull-up.
 * The module ties PCIE_PWR_EN high, so slot power stays on.
 */
&combphy0_ps {
	status = "okay";
};

&pcie0 {
	pinctrl-names = "default";
	pinctrl-0 = <&pcie0m1_pins &pcie0_perstn &pcie0_wake>;
	reset-gpios = <&gpio1 RK_PB7 GPIO_ACTIVE_LOW>;
	status = "okay";
};
