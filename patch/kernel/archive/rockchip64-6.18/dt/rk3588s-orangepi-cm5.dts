// SPDX-License-Identifier: (GPL-2.0+ OR MIT)

/*
 * Carrier board device tree for the Orange Pi CM5.
 * IO include:
 * 1x GbE "wan": RGMII via gmac1 + YT8531C PHY (phy-mode="rgmii-rxid" + MAC-side tx_delay) - not routed through PCIe/USB.
 * 2x 2.5GbE "lan1"/"lan2": each via its own single-lane PCIe combo-PHY (pcie2x1l1, pcie2x1l2) hosting an RTL8125 over standard PCI enumeration - enabled as PCIe NICs, not as USB3-to-Ethernet adapters.
 * USB-C / USB3 port: usb_host0_xhci forced to dr_mode = "host" - fixed host-only, not OTG/device mode (OTG + extcon was tried, didn't work on real hardware).
 * USB2-only host ports: usb_host0_ehci/ohci (via u2phy2) + usb_host1_ehci/ohci (via u2phy3) - both enabled as plain USB2 hosts, not USB3, not device mode.
 * HDMI output (1x): vp0 -> hdmi0 + hdptxphy0, standard onboard HDMI-out via the display pipeline - not DP-altmode over the USB-C port, no HDMI-in.
 * SD card slot: dedicated sdmmc controller, 4-bit bus, SD-only (no-mmc, no-sdio) - a separate controller from eMMC/SDIO, not a shared/muxed one.
 * WiFi/Bluetooth (SDIO): not enabled anywhere in this file - the module's SDIO controller stays disabled, so no wireless.
 * Camera (4x MIPI-CSI): only GPIO reset pins reserved (cam1_reset_pin...cam4_reset_pin) under &pinctrl - no sensor/CSI-host node wired up, so effectively unimplemented here.
 * RTC: I2C-attached HYM8563 chip on &i2c1, with its own interrupt/wake GPIO - not the SoC's internal-only RTC.
 * Status LEDs (lan1/lan2/wan/power): implemented as plain gpio-leds (raw GPIO on/off) - not pwm-leds (not sure about this ability).
 * Fan: implemented via pwm13 + pwm-fan driver with a temp-trip duty curve - not a fixed-speed always-on fan, not GPIO on/off (need to add way to disable if needed).
 * User button: gpio-keys, reported as generic BTN_MISC - not a dedicated/custom keycode.
 * Audio: HDMI audio only, via i2s5_8ch + hdmi0_sound - no separate onboard codec (unlike Orange Pi 5's ES8388).
 * Serial console: UART2 at 1,500,000 baud - the debug console, not USB-serial.
 */

/dts-v1/; // marks this as a version-1 flattened device tree source file (required boilerplate)

#include <dt-bindings/gpio/gpio.h> // GPIO_ACTIVE_HIGH / GPIO_ACTIVE_LOW constants used below
#include <dt-bindings/input/input.h> // BTN_MISC input-event constant used by the gpio-keys button
#include <dt-bindings/interrupt-controller/irq.h> // IRQ_TYPE_LEVEL_LOW etc. used by the RTC interrupt
#include <dt-bindings/leds/common.h> // LED_FUNCTION_*/LED_COLOR_ID_* constants (kept for reference; unused now that LEDs are plain gpio-leds, not pwm-leds)
#include <dt-bindings/pinctrl/rockchip.h> // RK_PA0..RK_PD7 pin-name macros and RK_FUNC_GPIO used throughout &pinctrl below
#include <dt-bindings/pwm/pwm.h> // PWM_POLARITY_INVERTED etc. (kept for reference; unused now that LEDs are plain gpio-leds, not pwm-leds)
#include <dt-bindings/soc/rockchip,vop2.h> // ROCKCHIP_VOP2_EP_HDMI0 endpoint-index constant used by &vp0 below

#include "rk3588s-orangepi-cm5.dtsi" // module-level tree: CPU/GPU/NPU regulators, PMIC -- untouched, upstream, describes the CM5 module itself, independent of carrier

/ { // open root-node overlay; every property/node below merges into the tree pulled in by the #include above
	model = "Xunlong Orange Pi CM5"; // board name in /proc/device-tree/model; changed from upstream's "Xunlong Orange Pi CM5 Base" since this isn't necessarily that exact revision
	compatible = "xunlong,orangepi-cm5-carrier", "xunlong,orangepi-cm5", "rockchip,rk3588s"; // board-match string, most specific first; "-carrier" (not upstream's "-base") so this dtb is never mistaken for that exact board

	aliases {
		ethernet0 = &gmac1; // names the RGMII controller as network device alias 0, for predictable /dev and udev naming
		mmc1 = &sdmmc; // names the SD-card controller mmc1 (the .dtsi include already names the eMMC controller mmc0)
	};

	chosen {
		stdout-path = "serial2:1500000n8"; // debug/serial console is UART2 at 1,500,000 baud, 8N1
	};

	gpio-keys {
		compatible = "gpio-keys"; // standard Linux gpio-keys input driver
		pinctrl-names = "default";
		pinctrl-0 = <&key1_pin>; // use the pin-mux group defined under &pinctrl / gpio-key below

		button { // single physical button; unchanged from upstream, matched the vendor dtb exactly (same GPIO3/pin22)
			debounce-interval = <50>; // 50ms software debounce
			gpios = <&gpio3 RK_PC6 GPIO_ACTIVE_LOW>; // GPIO3 pin C6 (=22), active-low
			label = "USERKEY";
			linux,code = <BTN_MISC>; // reported as a generic BTN_MISC input event
			wakeup-source; // this button can wake the system from suspend
		};
	};

	/* Real GPIO-driven status LEDs, replacing upstream's pwm-leds block entirely -- the vendor
	 * dtb dump showed the actual hardware drives these as plain GPIO outputs, not PWM channels.
	 * default-state for lan1/lan2/wan is "off" here (the vendor dtb itself defaults them "on" at
	 * boot); nothing in this tree ties any of them to real link state either way, so leaving them
	 * off avoids falsely claiming a connection that isn't there. */
	gpio-leds {
		compatible = "gpio-leds";
		pinctrl-names = "default";
		pinctrl-0 = <&leds_pin>; // use the 4-pin mux group defined under &pinctrl / leds below

		led-lan1 { // one of the two 2.5GbE PCIe ports
			gpios = <&gpio0 RK_PC6 GPIO_ACTIVE_LOW>; // GPIO0 pin C6 (=22), active-low
			label = "lan1";
			default-state = "off";
		};

		led-lan2 {
			gpios = <&gpio0 RK_PC7 GPIO_ACTIVE_HIGH>; // GPIO0 pin C7 (=23), active-HIGH -- opposite polarity from lan1/wan, taken from the vendor dtb as-is, not a typo
			label = "lan2";
			default-state = "off";
		};

		led-wan { // the RGMII gmac1 port
			gpios = <&gpio0 RK_PC5 GPIO_ACTIVE_LOW>; // GPIO0 pin C5 (=21), active-low
			label = "wan";
			default-state = "off";
		};

		led-power {
			gpios = <&gpio0 RK_PC4 GPIO_ACTIVE_HIGH>; // GPIO0 pin C4 (=20), active-high
			label = "power";
			default-state = "off"; // matches the vendor dtb as-is; only this one was already off there
		};
	};

	/* New node, absent from upstream entirely. Ported straight from the vendor dtb: PWM channel
	 * 13, 20ms period (50Hz), driving a 6-step duty-cycle curve as the SoC crosses each temperature
	 * trip point. Needs the matching `&pwm13 { status = "okay"; };` override further down. */
	pwm-fan {
		compatible = "pwm-fan";
		#cooling-cells = <2>;
		pwms = <&pwm13 0 20000000 0>; // channel 0 on &pwm13, 20,000,000ns (20ms = 50Hz) period, no extra flags
		cooling-levels = <0 50 100 150 200 255>; // 6 duty-cycle steps, out of a max of 255
		rockchip,temp-trips = <50000 1 // >= 50.000 degC -> cooling-levels index 1 (duty 50)
					55000 2 // >= 55.000 degC -> index 2 (duty 100)
					60000 3 // >= 60.000 degC -> index 3 (duty 150)
					65000 4 // >= 65.000 degC -> index 4 (duty 200)
					70000 5>; // >= 70.000 degC -> index 5 (duty 255, full speed)
	};

	hdmi0-con { // physical HDMI type-A connector; unchanged from upstream.
		compatible = "hdmi-connector";
		type = "a";

		port {
			hdmi0_con_in: endpoint {
				remote-endpoint = <&hdmi0_out_con>; // wired to the SoC's HDMI0 output endpoint, see &hdmi0_out below
			};
		};
	};

	vbus_5v0: regulator-vbus-5v0 { // fixed 5V rail, GPIO-switched, feeding USB VBUS on the u2phyN_*/usb_hostN_* nodes below
		compatible = "regulator-fixed";
		enable-active-high;
		gpio = <&gpio0 RK_PD3 GPIO_ACTIVE_HIGH>; // GPIO0 pin D3 turns this rail on/off
		pinctrl-names = "default";
		pinctrl-0 = <&vbus_5v0_en_pin>;
		regulator-name = "vbus_5v0";
		regulator-min-microvolt = <5000000>; // 5.000000V
		regulator-max-microvolt = <5000000>; // fixed regulator: min == max maybe have some tolerance?
		vin-supply = <&vcc5v0_sys>; // fed from the always-on 5V system rail below
	};

	vcc_3v3: regulator-vcc-3v3 { // fixed 3.3V rail, GPIO-switched, feeding the Ethernet PHY and both PCIe 2.5GbE slots
		compatible = "regulator-fixed";
		enable-active-high;
		gpio = <&gpio4 RK_PA3 GPIO_ACTIVE_HIGH>; // GPIO4 pin A3 turns this rail on/off
		pinctrl-names = "default";
		pinctrl-0 = <&vcc_3v3_en_pin>;
		regulator-name = "vcc_3v3";
		regulator-min-microvolt = <3300000>; // 3.300000V
		regulator-max-microvolt = <3300000>; // same here, not user if no tolerance is a good idea but on short term it works
		startup-delay-us = <50000>; // wait 50ms after enabling before treating the rail as stable
		vin-supply = <&vcc5v0_sys>;
	};

	vcc5v0_sys: regulator-vcc-5v0 { // the board's main always-on 5V rail; no GPIO switch, just a fixed-voltage marker node
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_sys";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
	};
}; // end of root-node overlay opened above

&combphy0_ps { // shared PCIe/USB/SATA combo-PHY block used by the PCIe 2.5GbE slots
	status = "okay";
};

&combphy2_psu { // second combo-PHY block, used by the second USB3 controller's lane
	status = "okay";
};

/* Ethernet fix: phy-mode changed from upstream's "rgmii-id" to "rgmii-rxid" (PHY applies only its
 * own RX delay; the MAC's own delay-line register supplies TX delay instead), plus the new
 * tx_delay line setting that MAC-side register -- both values read directly off the vendor dtb
 * dump. Getting phy-mode/tx_delay wrong typically shows up as "link comes up but no/garbled
 * traffic," matching the original complaint. */
&gmac1 {
	clock_in_out = "output";
	phy-handle = <&rgmii_phy>; // points at the PHY declared under &mdio1 below
	phy-mode = "rgmii-rxid"; // changed from upstream's "rgmii-id" -- see block comment above
	phy-supply = <&vcc_3v3>;
	tx_delay = <0x42>; // new line, absent from upstream -- MAC-side TX delay-line register value, taken from the vendor dtb
	pinctrl-names = "default";
	pinctrl-0 = <&gmac1_miim // MDIO pin mux (fixed SoC function, board-independent)
		     &gmac1_rx_bus2 // RX data-bus pin mux
		     &gmac1_tx_bus2 // TX data-bus pin mux
		     &gmac1_rgmii_clk // RGMII clock pin mux
		     &gmac1_rgmii_bus>; // remaining RGMII control-signal pin mux
	status = "okay";
};

&hdmi0 { // HDMI0 output; unchanged from upstream, matched the vendor dtb
	frl-enable-gpios = <&gpio4 RK_PB5 GPIO_ACTIVE_LOW>; // Fixed Rate Link enable GPIO
	pinctrl-0 = <&hdmim0_tx0_cec // CEC pin mux
		     &hdmim0_tx0_hpd // hot-plug-detect pin mux
		     &hdmim0_tx0_scl &hdmim0_tx0_sda // DDC/EDID I2C pin mux
		     &hdmi0_tx_on_h>; // board-specific TX-enable GPIO pin mux, declared under &pinctrl / hdmi below
	pinctrl-names = "default";
	status = "okay";
};

&hdmi0_in {
	hdmi0_in_vp0: endpoint {
		remote-endpoint = <&vp0_out_hdmi0>; // wired to display-pipeline video-port 0's HDMI0 output, see &vp0 at the end of this file
	};
};

&hdmi0_out {
	hdmi0_out_con: endpoint {
		remote-endpoint = <&hdmi0_con_in>; // wired to the physical HDMI connector node declared above
	};
};

&hdmi0_sound {
	status = "okay"; // enables the ALSA sound card carrying HDMI audio
};

&hdptxphy0 {
	status = "okay"; // HDMI PHY
};

&i2c1 { // I2C bus 1; unchanged from upstream, matched the vendor dtb's RTC wiring exactly
	pinctrl-0 = <&i2c1m2_xfer>; // muxed to pin group "m2"
	pinctrl-names = "default";
	status = "okay";

	rtc@51 {
		compatible = "haoyu,hym8563"; // Haoyu HYM8563 real-time-clock chip
		reg = <0x51>; // I2C address 0x51
		#clock-cells = <0>;
		clock-output-names = "hym8563";
		interrupt-parent = <&gpio0>;
		interrupts = <RK_PB0 IRQ_TYPE_LEVEL_LOW>; // interrupt line on GPIO0 pin B0
		pinctrl-names = "default";
		pinctrl-0 = <&rtc_int_pin>;
		wakeup-source; // this RTC can wake the system from suspend
	};
};

&i2s5_8ch {
	status = "okay"; // enables the I2S bus that carries HDMI audio
};

/* Other half of the Ethernet fix: reset-gpios changed from upstream's <&gpio1 RK_PC1 ...> to
 * <&gpio3 RK_PB2 ...> -- a different physical reset pin on this carrier than the upstream "-base"
 * board assumes, per the vendor dtb dump. Getting a PHY's hardware reset line wrong typically means
 * it never comes out of reset properly, or resets at the wrong moment relative to MAC init --
 * another plausible contributor to the original "Ethernet doesn't work" symptom. */
&mdio1 {
	rgmii_phy: ethernet-phy@1 {
		compatible = "ethernet-phy-ieee802.3-c22"; // Motorcomm YT8531C
		reg = <0x1>; // PHY address 1 on the MDIO bus
		pinctrl-names = "default";
		pinctrl-0 = <&rgmii_phy_pin>;
		reset-assert-us = <20000>; // hold reset low for 20ms
		reset-deassert-us = <100000>; // wait 100ms after releasing reset before using the PHY
		reset-gpios = <&gpio3 RK_PB2 GPIO_ACTIVE_LOW>; // changed from upstream's <&gpio1 RK_PC1 ...> -- see block comment above
	};
};

&pcie2x1l1 { // one of the two single-lane PCIe combo-PHY instances hosting the RTL8125 2.5GbE NICs (lan1); NIC itself needs no DT node, PCI enumeration handles it
	reset-gpios = <&gpio4 RK_PA2 GPIO_ACTIVE_HIGH>; // unchanged from upstream -- matched the vendor dtb exactly
	vpcie3v3-supply = <&vcc_3v3>;
	status = "okay";
};

&pcie2x1l2 { // the other PCIe 2.5GbE slot (lan2)
	reset-gpios = <&gpio3 RK_PD1 GPIO_ACTIVE_HIGH>; // unchanged from upstream -- matched the vendor dtb exactly
	vpcie3v3-supply = <&vcc_3v3>;
	status = "okay";
};

&pinctrl {
	camera { // 4x MIPI-CSI camera reset pins; unchanged from upstream, declared but not wired to any camera sensor node (out of scope here)
		cam1_reset_pin: cam1-reset-pin {
			rockchip,pins = <1 RK_PD0 RK_FUNC_GPIO &pcfg_pull_none>; // GPIO1 pin D0 as plain GPIO, no pull
		};
		cam2_reset_pin: cam2-reset-pin {
			rockchip,pins = <1 RK_PD1 RK_FUNC_GPIO &pcfg_pull_none>; // GPIO1 pin D1
		};
		cam3_reset_pin: cam3-reset-pin {
			rockchip,pins = <1 RK_PD2 RK_FUNC_GPIO &pcfg_pull_none>; // GPIO1 pin D2
		};
		cam4_reset_pin: cam4-reset-pin {
			rockchip,pins = <1 RK_PD3 RK_FUNC_GPIO &pcfg_pull_none>; // GPIO1 pin D3
		};
	};

	ethernet {
		rgmii_phy_pin: rgmii-phy-pin {
			rockchip,pins = <3 RK_PB2 RK_FUNC_GPIO &pcfg_pull_none>; // changed from upstream's <1 RK_PC1 ...> -- same Ethernet reset-pin fix as &mdio1 above, declared here as a named pinctrl group
		};
	};

	gpio-key {
		key1_pin: key1-pin {
			rockchip,pins = <3 RK_PC6 RK_FUNC_GPIO &pcfg_pull_up>; // backs the USERKEY button above; unchanged from upstream
		};
	};

	hdmi {
		hdmi0_tx_on_h: hdmi0-tx-on-h {
			rockchip,pins = <4 RK_PB5 RK_FUNC_GPIO &pcfg_pull_none>; // backs &hdmi0's frl-enable-gpios above; unchanged from upstream
		};
	};

	/* New group, absent from upstream (which has no plain-GPIO leds pin group at all, since it
	 * drives its LEDs via PWM channels instead). Declares GPIO0 pins C4-C7 as plain GPIO outputs,
	 * backing the four gpio-leds nodes declared under / above. */
	leds {
		leds_pin: leds-pin {
			rockchip,pins = <0 RK_PC4 RK_FUNC_GPIO &pcfg_pull_none>, // power LED pin
					 <0 RK_PC5 RK_FUNC_GPIO &pcfg_pull_none>, // wan LED pin
					 <0 RK_PC6 RK_FUNC_GPIO &pcfg_pull_none>, // lan1 LED pin
					 <0 RK_PC7 RK_FUNC_GPIO &pcfg_pull_none>; // lan2 LED pin
		};
	};

	power {
		vcc_3v3_en_pin: vcc-3v3-en-pin {
			rockchip,pins = <4 RK_PA3 RK_FUNC_GPIO &pcfg_pull_down>; // backs the vcc_3v3 regulator's enable GPIO above; unchanged from upstream
		};
	};

	rtc {
		rtc_int_pin: rtc-int-pin {
			rockchip,pins = <0 RK_PB0 RK_FUNC_GPIO &pcfg_pull_none>; // backs the RTC interrupt line above; unchanged from upstream
		};
	};

	usb {
		vbus_5v0_en_pin: vbus-5v0-en-pin {
			rockchip,pins = <0 RK_PD3 RK_FUNC_GPIO &pcfg_pull_none>; // backs the vbus_5v0 regulator's enable GPIO above; unchanged from upstream
		};
	};
};

&pwm13 { // new node, absent from upstream -- enables the PWM channel the pwm-fan node above drives
	status = "okay";
};

&sdmmc { // physical SD-card slot controller; unchanged from upstream and matched the vendor dtb exactly -- needed no fix at all, the SD card just needed the right dtb loaded in the first place
	bus-width = <4>; // 4-bit bus
	cap-sd-highspeed;
	disable-wp; // ignore the write-protect detect pin
	max-frequency = <150000000>; // up to 150MHz
	no-mmc; // this controller is SD-card only
	no-sdio;
	sd-uhs-sdr104; // UHS-I SDR104 capable
	vmmc-supply = <&vcc_3v3_s3>; // card power rail (declared in the shared module .dtsi)
	vqmmc-supply = <&vccio_sd_s0>; // card I/O signalling rail (declared in the shared module .dtsi)
	status = "okay";
};

&u2phy0 { // USB2 PHY 0, backing the USB-C/USB3 port
	status = "okay";
};

&u2phy0_otg {
	phy-supply = <&vbus_5v0>;
	status = "okay";
};

&u2phy2 { // USB2 PHY 2, backing the first USB2-only host controller pair
	status = "okay";
};

&u2phy2_host {
	phy-supply = <&vbus_5v0>;
	status = "okay";
};

/* New block, absent from upstream. Backs the *second* USB2 host controller pair (usb_host1_ehci/
 * usb_host1_ohci below), which the vendor dtb dump showed enabled on real hardware -- the upstream
 * "-base" board leaves this whole PHY/port pair disabled. */
&u2phy3 {
	status = "okay";
};

&u2phy3_host {
	phy-supply = <&vbus_5v0>;
	status = "okay";
};

&uart2 { // debug/serial console UART named in "chosen" above
	pinctrl-0 = <&uart2m0_xfer>;
	pinctrl-names = "default";
	status = "okay";
};

&usb_host0_ehci { // first USB2 host controller pair (EHCI+OHCI), backed by u2phy2/u2phy2_host above; unchanged from upstream
	status = "okay";
};

&usb_host0_ohci {
	status = "okay";
};

&usb_host0_xhci {
	dr_mode = "host"; /* forced host: "otg" (matching the vendor dtb, incl. its extcon = <&u2phy0>) was tried first but the port never came up on real hardware, not even at USB2 speed */
	status = "okay";
};

/* New block, absent from upstream -- see the block comment above &u2phy3. */
&usb_host1_ehci {
	status = "okay";
};

&usb_host1_ohci {
	status = "okay";
};

&usbdp_phy0 { // combined USB3/DisplayPort-alt-mode PHY backing the USB-C port's SuperSpeed lanes
	status = "okay";
};

&vop { // display controller ("Video Output Processor")
	status = "okay";
};

&vop_mmu { // VOP's IOMMU
	status = "okay";
};

&vp0 {
	vp0_out_hdmi0: endpoint@ROCKCHIP_VOP2_EP_HDMI0 {
		reg = <ROCKCHIP_VOP2_EP_HDMI0>;
		remote-endpoint = <&hdmi0_in_vp0>; // wires display-pipeline video-port 0's HDMI0 output to the HDMI PHY input declared above
	};
};
