From 74ae18da184fb8afad2a663d1e14ecc2d6c0393f Mon Sep 17 00:00:00 2001
From: Patrick Yavitz <pyavitz@gmail.com>
Date: Sat, 10 Oct 2026 03:30:41 -0400
Subject: [PATCH] SpacemiT: K1-X: Forward port the 6.6.y dtsi

Add r_uart0 node
Fixup node status

Signed-off-by: Patrick Yavitz <pyavitz@gmail.com>
---
 arch/riscv/boot/dts/spacemit/k1-x.dtsi | 103 ++++++++++++++++++++-----
 1 file changed, 85 insertions(+), 18 deletions(-)

diff --git a/arch/riscv/boot/dts/spacemit/k1-x.dtsi b/arch/riscv/boot/dts/spacemit/k1-x.dtsi
index 8f411e7f0..e5293f27f 100644
--- a/arch/riscv/boot/dts/spacemit/k1-x.dtsi
+++ b/arch/riscv/boot/dts/spacemit/k1-x.dtsi
@@ -430,7 +430,7 @@ rcpu_mem_0: mem@c0800000 {
 		};
 
 		/* rcpu's heap */
-		rcpu_mem_1: mem@30000000 {
+		rcpu_mem_heap: rcpu_mem_heap@30000000 {
 			reg = <0x0 0x30000000 0x0 0x200000>;
 			no-map;
 		};
@@ -465,6 +465,12 @@ rcpu_mem_snapshots: rcpu_mem_snapshots@30300000 {
 			reg = <0x0 0x30300000 0x0 0x40000>;
 			no-map;
 		};
+
+		/* the dtb file of rcpu */
+		rcpu_mem_dtb: rcpu_mem_dtb@30300000 {
+			reg = <0x0 0x30340000 0x0 0x40000>;
+			no-map;
+		};
 	};
 
 	soc: soc {
@@ -495,13 +501,13 @@ dram_range1: dram_range@1 {
 			status = "okay";
 		};
 
-		/* dram mapping for pcie for ex. */
+		/* dram mapping for pcie0 for ex. */
 		dram_range2: dram_range@2 {
 			compatible = "spacemit-dram-bus";
 			#address-cells = <2>;
 			#size-cells = <2>;
 			dma-ranges = <0x0 0x00000000 0x0 0x00000000 0x0 0x80000000>,
-				     <0x0 0xb8000000 0x1 0x38000000 0x3 0x48000000>;
+				     <0x0 0x90000000 0x1 0x10000000 0x3 0x70000000>;
 			#interconnect-cells = <0>;
 			status = "okay";
 		};
@@ -539,6 +545,30 @@ dram_range5: dram_range@5 {
 			status = "okay";
 		};
 
+		/* dram mapping for pcie1 for ex. */
+		dram_range6: dram_range@6 {
+			compatible = "spacemit-dram-bus";
+			#address-cells = <2>;
+			#size-cells = <2>;
+			dma-ranges = <0x0 0x00000000 0x0 0x00000000 0x0 0x80000000>,
+				     <0x0 0x80000000 0x1 0x00000000 0x0 0x10000000>,
+				     <0x0 0xa0000000 0x1 0x20000000 0x3 0x60000000>;
+			#interconnect-cells = <0>;
+			status = "okay";
+		};
+
+		/* dram mapping for pcie2 for ex. */
+		dram_range7: dram_range@7 {
+			compatible = "spacemit-dram-bus";
+			#address-cells = <2>;
+			#size-cells = <2>;
+			dma-ranges = <0x0 0x00000000 0x0 0x00000000 0x0 0x80000000>,
+				     <0x0 0x80000000 0x1 0x00000000 0x0 0x20000000>,
+				     <0x0 0xb8000000 0x1 0x38000000 0x3 0x48000000>;
+			#interconnect-cells = <0>;
+			status = "okay";
+		};
+
 		clint0: clint@e4000000 {
 			compatible = "riscv,clint0";
 			interrupts-extended = <
@@ -615,7 +645,8 @@ &cpu7_intc 11 &cpu7_intc 9
 		pinctrl: pinctrl@d401e000 {
 			compatible = "pinconf-single-aib";
 			reg = <0x0 0xd401e000 0x0 0x250>,
-				<0x0 0xd4019800 0x0 0x10>;
+				<0x0 0xd4019800 0x0 0x10>,
+				<0x0 0xd4019000 0x0 0x800>;
 			#address-cells = <1>;
 			#size-cells = <1>;
 			#pinctrl-cells = <2>;
@@ -792,7 +823,7 @@ uart0: serial@d4017000 {
 			interconnect-names = "dma-mem";
 			reg-shift = <2>;
 			reg-io-width = <4>;
-			status = "ok";
+			status = "okay";
 		};
 
 		uart2: uart@d4017100 {
@@ -931,6 +962,23 @@ uart9: uart@d4017800 {
 			status = "disabled";
 		};
 
+		r_uart0: r_uart0@c0881000 {
+			compatible = "spacemit,rcpu-pxa-uart0";
+			reg = <0x0 0xc0881000 0x0 0x100>;
+			clocks = <&ccu CLK_RCPU_UART0>, <&ccu CLK_SLOW_UART>;
+			clock-names = "func", "gate";
+			resets = <&reset RESET_RCPU_UART0>;
+			power-domains = <&power K1X_PMU_BUS_PWR_DOMAIN>;
+			clk,pm-runtime,no-sleep;
+			cpuidle,pm-runtime,sleep;
+			rcpu-uart;
+			interconnects = <&dram_range4>;
+			interconnect-names = "dma-mem";
+			reg-shift = <2>;
+			reg-io-width = <4>;
+			status = "disabled";
+		};
+
 		r_uart1: r_uart1@c088d000 {
 			compatible = "spacemit,rcpu-pxa-uart";
 			reg = <0x0 0xc088d000 0x0 0x100>;
@@ -945,7 +993,7 @@ r_uart1: r_uart1@c088d000 {
 			interconnect-names = "dma-mem";
 			reg-shift = <2>;
 			reg-io-width = <4>;
-			status = "ok";
+			status = "okay";
 		};
 
 		mailbox: mailbox@d4013400 {
@@ -993,7 +1041,7 @@ pdma0: pdma@d4000000 {
 			cpuidle,pm-runtime,sleep;
 			interconnects = <&dram_range4>;
 			interconnect-names = "dma-mem";
-			status = "ok";
+			status = "okay";
 		};
 
 		hdmi_adma: adma@C0883800 {
@@ -1004,7 +1052,7 @@ hdmi_adma: adma@C0883800 {
 			reg-names = "adma_reg", "ctrl_reg", "buf_addr";
 			#dma-cells = <0>;
 			hdmi-sample;
-			status = "ok";
+			status = "okay";
 		};
 
 		spi0: spi@d4026000 {
@@ -1398,8 +1446,8 @@ ri2c0: ri2c@c0887000 {
 			spacemit,i2c-wcr = <0x142a>;
 			/* apb clock: 26MHz or 52MHz */
 			spacemit,apb_clock = <52000000>;
-                        power-domains = <&power K1X_PMU_BUS_PWR_DOMAIN>;
-                        cpuidle,pm-runtime,sleep;
+			power-domains = <&power K1X_PMU_BUS_PWR_DOMAIN>;
+			cpuidle,pm-runtime,sleep;
 			interconnects = <&dram_range4>;
 			interconnect-names = "dma-mem";
 			status = "okay";
@@ -1739,7 +1787,7 @@ r_ircrx: irc-rx@c088e000 {
 		ddraxi_mon: ddraxi_mon@c0058500 {
 			compatible = "spacemit,ddraxi-mon";
 			reg = <0 0xc0058500 0 0x80>;
-			status = "ok";
+			status = "okay";
 		};
 
 		timer0: timer@d4014000 {
@@ -1751,7 +1799,7 @@ timer0: timer@d4014000 {
 			spacemit,timer-frequency = <12800000>;
 			clocks = <&ccu CLK_TIMERS1>;
 			resets = <&reset RESET_TIMERS1>;
-			status = "ok";
+			status = "okay";
 
 			counter0 {
 				compatible = "spacemit,timer-match";
@@ -1759,7 +1807,7 @@ counter0 {
 				interrupt-parent = <&intc>;
 				spacemit,timer-broadcast;
 				spacemit,timer-counter-id = <0>;
-				status = "ok";
+				status = "okay";
 			};
 		};
 
@@ -1798,7 +1846,7 @@ watchdog: watchdog@d4080000 {
 		reboot: handler@d4282f90 {
 			compatible = "spacemit,k1x-reboot";
 			reg = <0x0 0xd4282f90 0x0 0x4>;
-			status = "ok";
+			status = "okay";
 		};
 
 		rtc: rtc@d4010000 {
@@ -1865,6 +1913,17 @@ gcb3: gpio3 {
 			};
 		};
 
+		ec_master: ethercat_master {
+			compatible = "igh,k1x-ec-master";
+			run-on-cpu = <1>;
+			debug-level = <0>;
+			master-count = <1>;
+			ec-devices = <&eth0>,<&eth1>;
+			master-indexes = <0>,<0>;
+			modes = "ec_main","ec_backup";
+			status = "disable";
+		};
+
 		eth0: ethernet@cac80000 {
 			compatible = "spacemit,k1x-emac";
 			reg = <0x00000000 0xCAC80000 0x00000000 0x00000420>;
@@ -2239,7 +2298,7 @@ pcie1_rc: pcie@ca400000 {
 			#size-cells = <2>;
 			ranges = <0x01000000 0x0 0x9f002000 0 0x9f002000 0x0 0x100000>,
 				 <0x02000000 0x0 0x90000000 0 0x90000000 0x0 0x0f000000>;
-			interconnects = <&dram_range2>;
+			interconnects = <&dram_range6>;
 			interconnect-names = "dma-mem";
 
 			interrupts = <142>, <146>;
@@ -2289,7 +2348,7 @@ pcie2_rc: pcie@ca800000 {
 			ranges = <0x01000000 0x0 0xb7002000 0 0xb7002000 0x0 0x100000>,
 				 <0x42000000 0x0 0xa0000000 0 0xa0000000 0x0 0x10000000>,
 				 <0x02000000 0x0 0xb0000000 0 0xb0000000 0x0 0x7000000>;
-			interconnects = <&dram_range2>;
+			interconnects = <&dram_range7>;
 			interconnect-names = "dma-mem";
 
 			interrupts = <143>, <147>;
@@ -2422,7 +2481,7 @@ v2d@c0100000 {
 			interrupts = <86>;
 			interconnects = <&dram_range3>;
 			interconnect-names = "dma-mem";
-			status = "ok";
+			status = "okay";
 		};
 		jpu@c02f8000 {
 			compatible = "chip-media, jpu";
@@ -2470,7 +2529,7 @@ imggpu: imggpu@cac00000 {
 			power-domains = <&power K1X_PMU_GPU_PWR_DOMAIN>;
 			interconnects = <&dram_range1>;
 			interconnect-names = "dma-mem";
-			status = "ok";
+			status = "okay";
 		};
 
 		spacemit_crypto_engine@d8600000 {
@@ -2486,6 +2545,14 @@ spacemit_crypto_engine@d8600000 {
 			status = "okay";
 		};
 
+		crng: crng@f0703800 {
+			compatible = "spacemit,hw_crng";
+			reg = <0x0 0xf0703800 0x0 0x100>;
+			clocks = <&ccu CLK_AES>;
+			resets = <&reset RESET_AES>;
+			status = "okay";
+		};
+
 		efuse: fuse@f0702800 {
 			compatible = "simple-mfd";
 			#address-cells = <1>;
-- 
2.53.0

