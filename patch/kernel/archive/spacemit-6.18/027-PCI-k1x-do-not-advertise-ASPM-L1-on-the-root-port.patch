From: Frédéric Mahé <frederic.mahe@cirad.fr>
Date: Mon, 16 Nov 2026 22:00:00 +0100
Subject: [PATCH] PCI: k1x: do not advertise ASPM L1 on the root port

With ASPM L1 enabled (the default on DT platforms since 6.18), NVMe
drives on the BPI-F3 M.2 slot drop off the bus at idle or under load:
"AER: Uncorrectable (Fatal)", Surprise Down, then
"controller is down; will reset: CSTS=0xffffffff". Clear L1 from the
root port's Link Capabilities, as mainline pcie-spacemit-k1 does
(k1_pcie_disable_aspm_l1). This should also cover the Samsung PM9B1 case of
patch 014, and boots that lack pcie_aspm=off (26.8.x extlinux images).

Tested on BPI-F3 with an SK hynix BC511: 3/3 failures before, none
after (fio verify, burst/idle cycles, 1 h soak) without pcie_aspm=off.
Written with help from Claude (Anthropic).

Signed-off-by: Frédéric Mahé <frederic.mahe@cirad.fr>
---
diff --git a/drivers/pci/controller/dwc/pcie-k1x.c b/drivers/pci/controller/dwc/pcie-k1x.c
--- a/drivers/pci/controller/dwc/pcie-k1x.c
+++ b/drivers/pci/controller/dwc/pcie-k1x.c
@@ -977,12 +977,30 @@
 	return 0;
 }
 
+/*
+ * ASPM L1 makes the link drop on K1 with some NVMe drives (AER fatal,
+ * Surprise Down, CSTS=0xffffffff).  Do not advertise L1 on the root
+ * port, as mainline pcie-spacemit-k1 does.
+ */
+static void k1x_pcie_disable_aspm_l1(struct dw_pcie *pci)
+{
+	u32 reg;
+
+	dw_pcie_dbi_ro_wr_en(pci);
+	reg = dw_pcie_readl_dbi(pci, EXP_CAP_ID_OFFSET + PCI_EXP_LNKCAP);
+	reg &= ~PCI_EXP_LNKCAP_ASPM_L1;
+	dw_pcie_writel_dbi(pci, EXP_CAP_ID_OFFSET + PCI_EXP_LNKCAP, reg);
+	dw_pcie_dbi_ro_wr_dis(pci);
+}
+
 static int k1x_pcie_host_init(struct dw_pcie_rp *pp)
 {
 	struct dw_pcie *pci = to_dw_pcie_from_pp(pp);
 	struct k1x_pcie *k1x = to_k1x_pcie(pci);
 	u32 reg;
 
+	k1x_pcie_disable_aspm_l1(pci);
+
 	mdelay(100);
 	/* set Perst# gpio high state*/
 	reg = k1x_pcie_readl(k1x, PCIECTRL_K1X_CONF_DEVICE_CMD);
