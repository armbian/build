From: SuperKali <hello@superkali.me>
Date: Mon, 24 Aug 2026 12:08:25 +0200
Subject: drm/img-rogue: pick the GPU clock from the DT OPP table

The DDK pins the core at a hardcoded 614 MHz while the K1 rates the
BXE-2-32 at 819 MHz. Read the highest OPP the device tree advertises
instead, so the frequency is described by the hardware description and
not by a constant. Boards shipping no table keep the vendor default.

Signed-off-by: SuperKali <hello@superkali.me>
---
 drivers/gpu/drm/img-rogue/spacemit/spacemit_init.c | 20 +++++++++-
 1 file changed, 19 insertions(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/img-rogue/spacemit/spacemit_init.c b/drivers/gpu/drm/img-rogue/spacemit/spacemit_init.c
index 111111111111..222222222222 100644
--- a/drivers/gpu/drm/img-rogue/spacemit/spacemit_init.c
+++ b/drivers/gpu/drm/img-rogue/spacemit/spacemit_init.c
@@ -26,6 +26,24 @@
 
 static struct st_context *g_platform = NULL;
 
+/* highest frequency the DT advertises for this GPU, vendor default when it says nothing */
+static unsigned long spacemit_gpu_max_rate(struct device *dev)
+{
+	struct dev_pm_opp *opp;
+	unsigned long rate = ULONG_MAX;
+
+	if (devm_pm_opp_of_add_table(dev))
+		return RGX_ST_CORE_CLOCK_SPEED;
+
+	opp = dev_pm_opp_find_freq_floor(dev, &rate);
+	if (IS_ERR(opp))
+		return RGX_ST_CORE_CLOCK_SPEED;
+
+	dev_pm_opp_put(opp);
+
+	return rate;
+}
+
 #if defined(SUPPORT_LINUX_DVFS) && !defined(NO_HARDWARE)
 void stSetFrequency(IMG_HANDLE hSysData, IMG_UINT32 ui32Frequency)
 {
@@ -342,7 +360,7 @@ struct st_context *RgxStInit(PVRSRV_DEVICE_CONFIG* psDevConfig)
 	reset_control_deassert(platform->gpu_reset);
 
 	clk_prepare_enable(platform->gpu_clk);
-	clk_set_rate(platform->gpu_clk, RGX_ST_CORE_CLOCK_SPEED);
+	clk_set_rate(platform->gpu_clk, spacemit_gpu_max_rate(dev));
 
 	if (psRGXData && psRGXData->psRGXTimingInfo)
 	{
-- 
