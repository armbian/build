From 03442a05f7a16c8ef312c49444b2a8d6c3077420 Mon Sep 17 00:00:00 2001
From: Patrick Yavitz <pyavitz@gmail.com>
Date: Sun, 8 Nov 2026 09:29:51 -0500
Subject: [PATCH] media: spacemit: jpu: Fix module compilation and export
 missing symbols

Fix modpost missing MODULE_LICENSE/DESCRIPTION and unexported symbol
linking errors when building the SpacemiT JPU driver as a dynamic module.
Import missing DMA_BUF namespace macros to resolve linking dependencies.

Signed-off-by: Patrick Yavitz <pyavitz@gmail.com>
---
 drivers/soc/spacemit/jpu/jpu.c        | 1 +
 drivers/soc/spacemit/jpu/jpu_export.c | 7 +++++++
 2 files changed, 8 insertions(+)

diff --git a/drivers/soc/spacemit/jpu/jpu.c b/drivers/soc/spacemit/jpu/jpu.c
index 44a7c54d7..ba9b46f34 100644
--- a/drivers/soc/spacemit/jpu/jpu.c
+++ b/drivers/soc/spacemit/jpu/jpu.c
@@ -1799,6 +1799,7 @@ static void __exit jpu_exit(void)
 MODULE_AUTHOR("SPACEMIT Limited, Inc.");
 MODULE_DESCRIPTION("JPU linux driver");
 MODULE_LICENSE("GPL v2");
+MODULE_IMPORT_NS("DMA_BUF");
 
 module_init(jpu_init);
 module_exit(jpu_exit);
diff --git a/drivers/soc/spacemit/jpu/jpu_export.c b/drivers/soc/spacemit/jpu/jpu_export.c
index 641ee2ae2..99ef5d61a 100644
--- a/drivers/soc/spacemit/jpu/jpu_export.c
+++ b/drivers/soc/spacemit/jpu/jpu_export.c
@@ -300,3 +300,10 @@ void jpu_exp_exit(void)
 {
 	misc_deregister(&jpu_exp);
 }
+
+EXPORT_SYMBOL(jpu_exp_init);
+EXPORT_SYMBOL(jpu_exp_exit);
+
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("SpacemiT JPU Export Driver");
+MODULE_IMPORT_NS("DMA_BUF");
-- 
2.53.0

