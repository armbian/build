/* Definition for SPI2 Spidev
 * spi port for Tinker Board
 */

/dts-v1/;
/plugin/;

/ {
	compatible = "rockchip,rk3288";
};

&spi2 {
	#address-cells = <1>;
	#size-cells = <0>;

	spidev@0 {
		compatible = "rockchip,spi_tinker";
		reg = <0>;
		spi-max-frequency = <50000000>;
		spi-cpha = <1>;
		status = "okay";
	};

	spidev@1 {
		compatible = "rockchip,spi_tinker";
		reg = <1>;
		spi-max-frequency = <50000000>;
		spi-cpha = <1>;
		status = "okay";
	};
};
