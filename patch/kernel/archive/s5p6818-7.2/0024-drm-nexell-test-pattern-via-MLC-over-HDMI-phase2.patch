From cbab7fbe862b1ca4dd9d4198f1217b6fe8290ce7 Mon Sep 17 00:00:00 2001
From: Igor Pecovnik <igor@armbian.com>
Date: Thu, 10 Sep 2026 17:40:00 +0200
Subject: [PATCH] drm: nexell: put up a test pattern via MLC over HDMI (phase
 2)

Phase 1 proved the HDMI block comes alive; this puts a real, stable picture
on the screen. The FriendlyARM u-boot already programs the full display
pipeline (HDMI PHY/Link + DPC video timing) at 1280x720 for its boot logo,
so the driver piggy-backs on that running output and only needs to point an
MLC layer at its own framebuffer:

  - allocate a 720p XRGB8888 CMA framebuffer, paint colour bars;
  - disable the layer u-boot left running (it scans out now-reused kernel
    RAM = on-screen noise);
  - program MLC.0 RGB layer 0 over the framebuffer and enable it.

Adds the self-contained vendor MLC register layer (soc/s5pxx18_soc_mlc.c,
DRM-free, ported as-is) for the layer programming.

HW-verified on a NanoPi Fire3 + HDMI monitor: eight stable colour bars.
First HDMI output from this SoC on a mainline kernel. Next: program the DPC
timing + HDMI PHY preset ourselves (drop the u-boot dependency), then wrap
in atomic KMS.

Signed-off-by: Igor Pecovnik <igor@armbian.com>
---
 drivers/gpu/drm/nexell/Makefile              |    7 +-
 drivers/gpu/drm/nexell/nx_display_drv.c      |  114 +-
 drivers/gpu/drm/nexell/soc/s5pxx18_soc_mlc.c | 1871 ++++++++++++++++++
 drivers/gpu/drm/nexell/soc/s5pxx18_soc_mlc.h |  439 ++++
 4 files changed, 2412 insertions(+), 19 deletions(-)
 create mode 100644 drivers/gpu/drm/nexell/soc/s5pxx18_soc_mlc.c
 create mode 100644 drivers/gpu/drm/nexell/soc/s5pxx18_soc_mlc.h

diff --git a/drivers/gpu/drm/nexell/Makefile b/drivers/gpu/drm/nexell/Makefile
index 002da94..e888051 100644
--- a/drivers/gpu/drm/nexell/Makefile
+++ b/drivers/gpu/drm/nexell/Makefile
@@ -1,9 +1,6 @@
 # SPDX-License-Identifier: GPL-2.0
 #
-# Phase 1: self-contained bring-up driver only. The vendor SoC layer
-# (soc/s5pxx18_*.o) is added back incrementally as the DPC/HDMI programming
-# path is written (some of those objects still reference the not-yet-ported
-# soc_dp control layer, so linking them into the module now would fail).
-nexell-drm-y := nx_display_drv.o
+# Phase 2: bring-up driver + the self-contained MLC register layer.
+nexell-drm-y := nx_display_drv.o soc/s5pxx18_soc_mlc.o
 
 obj-$(CONFIG_DRM_NEXELL) += nexell-drm.o
diff --git a/drivers/gpu/drm/nexell/nx_display_drv.c b/drivers/gpu/drm/nexell/nx_display_drv.c
index af63b0b..7bfa302 100644
--- a/drivers/gpu/drm/nexell/nx_display_drv.c
+++ b/drivers/gpu/drm/nexell/nx_display_drv.c
@@ -1,26 +1,36 @@
 // SPDX-License-Identifier: GPL-2.0
 /*
- * Nexell S5P6818 display bring-up driver (WIP, phase 1).
+ * Nexell S5P6818 display bring-up driver (WIP, phase 2).
  *
- * For now this only does the "foundation" step proven on hardware: ungate the
- * HDMI display clocks (the two DISPLAYTOP clkgen modules) and report the HDMI
- * hotplug (HPD) state. The display/HDMI resets are already released by the boot
- * chain, so the disptop clock-gate is the only thing standing between a dead
- * (all-zero) HDMI register block and a live one.
+ * Phase 1 proved the HDMI block comes alive once the two DISPLAYTOP clkgen
+ * modules are ungated (resets are already released by the boot chain). This
+ * phase puts a real, stable picture up by piggy-backing on the display
+ * pipeline the FriendlyARM u-boot already programmed for its boot logo: the
+ * HDMI PHY/Link and the DPC video timing are running at 1280x720, so we only
+ * need to point an MLC RGB layer at our own framebuffer.
  *
- * Next phases extend probe() to program the DPC video timing, the HDMI PHY
- * preset + Link/Core, and an MLC plane over a CMA framebuffer for real output.
+ * probe():
+ *   - ungate the HDMI clocks, report HPD (phase 1);
+ *   - allocate a 720p XRGB8888 framebuffer, paint colour bars;
+ *   - disable the u-boot layer (it scans out now-reused kernel RAM = noise);
+ *   - program MLC RGB layer 0 over our framebuffer and enable it.
+ *
+ * Next phases replace the u-boot dependency by programming the DPC timing and
+ * the HDMI PHY preset ourselves, and wrap all this in a proper atomic-KMS
+ * driver.
  */
 
 #include <linux/module.h>
 #include <linux/platform_device.h>
 #include <linux/of.h>
 #include <linux/io.h>
+#include <linux/dma-mapping.h>
+
+#include "soc/s5pxx18_soc_mlc.h"
 
 /* DISPLAYTOP clkgen modules feeding HDMI: spdif = module 2, vclk = module 4. */
 #define NX_DISPTOP_CLKGEN_HDMI_SPDIF	0xc0105000
 #define NX_DISPTOP_CLKGEN_HDMI_VCLK	0xc0109000
-/* clkenb: bits[1:0] bclk-mode (3 = always), bit2 clkgen-enable, bit3 pclk-mode */
 #define NX_CLKGEN_ON			0x0000000f
 
 /* HDMI LINK/CTRL block. */
@@ -29,13 +39,47 @@
 #define NX_HDMI_HPD_STATUS		0x000c
 #define NX_HDMI_HPD			0x0044
 
+/* MLC.0 (multi-layer controller feeding DPC.0). */
+#define NX_MLC0_BASE			0xc0102000
+#define NX_MLC0_SIZE			0x1000
+
+/* Fixed mode = what u-boot set (read back from MLC screensize = 0x02cf04ff). */
+#define FB_W				1280
+#define FB_H				720
+#define FB_BPP				4
+#define FB_STRIDE			(FB_W * FB_BPP)
+#define FB_SIZE				(FB_STRIDE * FB_H)
+
 struct nx_display {
 	struct device *dev;
 	void __iomem *clk_spdif;
 	void __iomem *clk_vclk;
 	void __iomem *hdmi_ctrl;
+	void __iomem *mlc;
+	void *fb_cpu;
+	dma_addr_t fb_dma;
 };
 
+/* Eight vertical colour bars (SMPTE-ish), XRGB8888 (0x00RRGGBB). */
+static void nx_fill_bars(u32 *fb)
+{
+	static const u32 bars[8] = {
+		0x00ffffff, /* white   */
+		0x00ffff00, /* yellow  */
+		0x0000ffff, /* cyan    */
+		0x0000ff00, /* green   */
+		0x00ff00ff, /* magenta */
+		0x00ff0000, /* red     */
+		0x000000ff, /* blue    */
+		0x00000000, /* black   */
+	};
+	int x, y;
+
+	for (y = 0; y < FB_H; y++)
+		for (x = 0; x < FB_W; x++)
+			fb[y * FB_W + x] = bars[(x * 8) / FB_W];
+}
+
 static int nx_display_probe(struct platform_device *pdev)
 {
 	struct device *dev = &pdev->dev;
@@ -50,28 +94,70 @@ static int nx_display_probe(struct platform_device *pdev)
 	nx->clk_spdif = devm_ioremap(dev, NX_DISPTOP_CLKGEN_HDMI_SPDIF, 0x100);
 	nx->clk_vclk  = devm_ioremap(dev, NX_DISPTOP_CLKGEN_HDMI_VCLK, 0x100);
 	nx->hdmi_ctrl = devm_ioremap(dev, NX_HDMI_CTRL_BASE, NX_HDMI_CTRL_SIZE);
-	if (!nx->clk_spdif || !nx->clk_vclk || !nx->hdmi_ctrl)
+	nx->mlc       = devm_ioremap(dev, NX_MLC0_BASE, NX_MLC0_SIZE);
+	if (!nx->clk_spdif || !nx->clk_vclk || !nx->hdmi_ctrl || !nx->mlc)
 		return -ENOMEM;
 
-	/* Ungate the HDMI display clocks (proven on HW). */
+	/* Ungate the HDMI display clocks (phase 1). */
 	writel(NX_CLKGEN_ON, nx->clk_spdif);
 	writel(NX_CLKGEN_ON, nx->clk_vclk);
 
-	/* Now the HDMI register block is alive - read hotplug state. */
 	hpd_status = readl(nx->hdmi_ctrl + NX_HDMI_HPD_STATUS);
 	hpd	   = readl(nx->hdmi_ctrl + NX_HDMI_HPD);
-
 	dev_info(dev,
-		 "S5P6818 display: HDMI clocks enabled; HPD_STATUS=0x%08x HPD=0x%08x -> monitor %s\n",
+		 "HDMI clocks enabled; HPD_STATUS=0x%08x HPD=0x%08x -> monitor %s\n",
 		 hpd_status, hpd,
 		 (hpd_status & 1) ? "CONNECTED" : "not detected");
 
+	/* Framebuffer for the test pattern. */
+	if (dma_set_mask_and_coherent(dev, DMA_BIT_MASK(32))) {
+		dev_err(dev, "no 32-bit DMA\n");
+		return -ENODEV;
+	}
+	nx->fb_cpu = dma_alloc_coherent(dev, FB_SIZE, &nx->fb_dma, GFP_KERNEL);
+	if (!nx->fb_cpu) {
+		dev_err(dev, "framebuffer alloc (%d bytes) failed\n", FB_SIZE);
+		return -ENOMEM;
+	}
+	nx_fill_bars(nx->fb_cpu);
+	dev_info(dev, "framebuffer %dx%d @ dma 0x%08x (%d bytes)\n",
+		 FB_W, FB_H, (u32)nx->fb_dma, FB_SIZE);
+
+	/* Drive MLC.0 RGB layer 0 over our framebuffer. */
+	nx_mlc_set_base_address(0, nx->mlc);
+
+	/* Turn off whatever layer u-boot left running (it now shows stale RAM). */
+	nx_mlc_set_layer_enable(0, 1, 0);
+	nx_mlc_set_dirty_flag(0, 1);
+
+	nx_mlc_set_screen_size(0, FB_W, FB_H);
+	nx_mlc_set_layer_priority(0, nx_mlc_priority_videofirst);
+
+	nx_mlc_set_lock_size(0, 0, 16);
+	nx_mlc_set_alpha_blending(0, 0, 0, 0);
+	nx_mlc_set_color_inversion(0, 0, 0, 0);
+	nx_mlc_set_format_rgb(0, 0, nx_mlc_rgbfmt_x8r8g8b8);
+	nx_mlc_set_position(0, 0, 0, 0, FB_W - 1, FB_H - 1);
+	nx_mlc_set_rgblayer_invalid_position(0, 0, 0, 0, 0, 0, 0, 0);
+	nx_mlc_set_rgblayer_invalid_position(0, 0, 1, 0, 0, 0, 0, 0);
+	nx_mlc_set_rgblayer_stride(0, 0, FB_BPP, FB_STRIDE);
+	nx_mlc_set_rgblayer_address(0, 0, (u32)nx->fb_dma);
+	nx_mlc_set_layer_enable(0, 0, 1);
+	nx_mlc_set_dirty_flag(0, 0);
+	nx_mlc_set_top_dirty_flag(0);
+
+	dev_info(dev, "MLC RGB layer 0 enabled with colour-bar test pattern\n");
+
 	platform_set_drvdata(pdev, nx);
 	return 0;
 }
 
 static void nx_display_remove(struct platform_device *pdev)
 {
+	struct nx_display *nx = platform_get_drvdata(pdev);
+
+	if (nx && nx->fb_cpu)
+		dma_free_coherent(nx->dev, FB_SIZE, nx->fb_cpu, nx->fb_dma);
 }
 
 static const struct of_device_id nx_display_of_match[] = {
diff --git a/drivers/gpu/drm/nexell/soc/s5pxx18_soc_mlc.c b/drivers/gpu/drm/nexell/soc/s5pxx18_soc_mlc.c
new file mode 100644
index 0000000..433c5ff
--- /dev/null
+++ b/drivers/gpu/drm/nexell/soc/s5pxx18_soc_mlc.c
@@ -0,0 +1,1871 @@
+/*
+ * Copyright (C) 2016  Nexell Co., Ltd.
+ * Author: junghyun, kim <jhkim@nexell.co.kr>
+ *
+ * This program is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU General Public License
+ * as published by the Free Software Foundation; either version 2
+ * of the License, or (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <http://www.gnu.org/licenses/>.
+ */
+#include <linux/types.h>
+#include <linux/io.h>
+
+#include "s5pxx18_soc_mlc.h"
+
+static struct {
+	struct nx_mlc_register_set *pregister;
+} __g_module_variables[NUMBER_OF_MLC_MODULE] = { { NULL, },};
+
+int nx_mlc_initialize(void)
+{
+	static int binit;
+	u32 i;
+
+	if (0 == binit) {
+		for (i = 0; i < NUMBER_OF_MLC_MODULE; i++)
+			__g_module_variables[i].pregister = NULL;
+		binit = 1;
+	}
+	return 1;
+}
+
+u32 nx_mlc_get_physical_address(u32 module_index)
+{
+	const u32 physical_addr[] = PHY_BASEADDR_MLC_LIST;
+
+	return physical_addr[module_index];
+}
+
+void nx_mlc_set_base_address(u32 module_index, void *base_address)
+{
+	__g_module_variables[module_index].pregister =
+	    (struct nx_mlc_register_set *)base_address;
+}
+
+void *nx_mlc_get_base_address(u32 module_index)
+{
+	return (void *)__g_module_variables[module_index].pregister;
+}
+
+void nx_mlc_set_clock_pclk_mode(u32 module_index, enum nx_pclkmode mode)
+{
+	const u32 pclkmode_pos = 3;
+	u32 clkmode = 0;
+
+	register u32 regvalue;
+	register struct nx_mlc_register_set *pregister;
+
+	pregister = __g_module_variables[module_index].pregister;
+	switch (mode) {
+	case nx_pclkmode_dynamic:
+		clkmode = 0;
+		break;
+	case nx_pclkmode_always:
+		clkmode = 1;
+		break;
+	default:
+		break;
+	}
+	regvalue = pregister->mlcclkenb;
+	regvalue &= ~(1ul << pclkmode_pos);
+	regvalue |= (clkmode & 0x01) << pclkmode_pos;
+
+	writel(regvalue, &pregister->mlcclkenb);
+}
+
+enum nx_pclkmode nx_mlc_get_clock_pclk_mode(u32 module_index)
+{
+	const u32 pclkmode_pos = 3;
+
+	if (__g_module_variables[module_index].pregister->mlcclkenb &
+	    (1ul << pclkmode_pos)) {
+		return nx_pclkmode_always;
+	}
+	return nx_pclkmode_dynamic;
+}
+
+void nx_mlc_set_clock_bclk_mode(u32 module_index, enum nx_bclkmode mode)
+{
+	register u32 regvalue;
+	register struct nx_mlc_register_set *pregister;
+	u32 clkmode = 0;
+
+	pregister = __g_module_variables[module_index].pregister;
+	switch (mode) {
+	case nx_bclkmode_disable:
+		clkmode = 0;
+		break;
+	case nx_bclkmode_dynamic:
+		clkmode = 2;
+		break;
+	case nx_bclkmode_always:
+		clkmode = 3;
+		break;
+	default:
+		break;
+	}
+	regvalue = pregister->mlcclkenb;
+	regvalue &= ~(0x3);
+	regvalue |= clkmode & 0x3;
+
+	writel(regvalue, &pregister->mlcclkenb);
+}
+
+enum nx_bclkmode nx_mlc_get_clock_bclk_mode(u32 module_index)
+{
+	const u32 bclkmode = 3ul << 0;
+
+	switch (__g_module_variables[module_index].pregister->mlcclkenb &
+		bclkmode) {
+	case 0:
+		return nx_bclkmode_disable;
+	case 2:
+		return nx_bclkmode_dynamic;
+	case 3:
+		return nx_bclkmode_always;
+	}
+	return nx_bclkmode_disable;
+}
+
+void nx_mlc_set_top_power_mode(u32 module_index, int bpower)
+{
+	const u32 pixelbuffer_pwd_pos = 11;
+	const u32 pixelbuffer_pwd_mask = 1ul << pixelbuffer_pwd_pos;
+	const u32 dittyflag_mask = 1ul << 3;
+	register struct nx_mlc_register_set *pregister;
+	register u32 regvalue;
+
+	pregister = __g_module_variables[module_index].pregister;
+	regvalue = pregister->mlccontrolt;
+	regvalue &= ~(pixelbuffer_pwd_mask | dittyflag_mask);
+	regvalue |= (bpower << pixelbuffer_pwd_pos);
+
+	writel(regvalue, &pregister->mlccontrolt);
+}
+
+int nx_mlc_get_top_power_mode(u32 module_index)
+{
+	const u32 pixelbuffer_pwd_pos = 11;
+	const u32 pixelbuffer_pwd_mask = 1ul << pixelbuffer_pwd_pos;
+
+	return (int)((__g_module_variables[module_index].pregister->
+		      mlccontrolt & pixelbuffer_pwd_mask) >>
+		     pixelbuffer_pwd_pos);
+}
+
+void nx_mlc_set_top_sleep_mode(u32 module_index, int bsleep)
+{
+	const u32 pixelbuffer_sld_pos = 10;
+	const u32 pixelbuffer_sld_mask = 1ul << pixelbuffer_sld_pos;
+	const u32 dittyflag_mask = 1ul << 3;
+	register struct nx_mlc_register_set *pregister;
+	register u32 regvalue;
+
+	bsleep = (int)((u32) bsleep ^ 1);
+	pregister = __g_module_variables[module_index].pregister;
+	regvalue = pregister->mlccontrolt;
+	regvalue &= ~(pixelbuffer_sld_mask | dittyflag_mask);
+	regvalue |= (bsleep << pixelbuffer_sld_pos);
+
+	writel(regvalue, &pregister->mlccontrolt);
+}
+
+int nx_mlc_get_top_sleep_mode(u32 module_index)
+{
+	const u32 pixelbuffer_sld_pos = 11;
+	const u32 pixelbuffer_sld_mask = 1ul << pixelbuffer_sld_pos;
+
+	return (int)(((__g_module_variables[module_index].pregister->
+		       mlccontrolt & pixelbuffer_sld_mask) >>
+		      pixelbuffer_sld_pos) ^ 0x01);
+}
+
+void nx_mlc_set_top_dirty_flag(u32 module_index)
+{
+	const u32 dirtyflag = 1ul << 3;
+	register struct nx_mlc_register_set *pregister;
+	register u32 regvalue;
+
+	pregister = __g_module_variables[module_index].pregister;
+	regvalue = pregister->mlccontrolt;
+	regvalue |= dirtyflag;
+
+	writel(regvalue, &pregister->mlccontrolt);
+}
+
+int nx_mlc_get_top_dirty_flag(u32 module_index)
+{
+	const u32 dirtyflag_pos = 3;
+	const u32 dirtyflag_mask = 1ul << dirtyflag_pos;
+
+	return (int)((readl(&__g_module_variables[module_index]
+			    .pregister->mlccontrolt) &
+		      dirtyflag_mask) >> dirtyflag_pos);
+}
+
+void nx_mlc_set_mlc_enable(u32 module_index, int benb)
+{
+	const u32 mlcenb_pos = 1;
+	const u32 mlcenb_mask = 1ul << mlcenb_pos;
+	const u32 dirtyflag_pos = 3;
+	const u32 dirtyflag_mask = 1ul << dirtyflag_pos;
+	register u32 regvalue;
+	register struct nx_mlc_register_set *pregister;
+
+	pregister = __g_module_variables[module_index].pregister;
+	regvalue = pregister->mlccontrolt;
+	regvalue &= ~(mlcenb_mask | dirtyflag_mask);
+	regvalue |= (benb << mlcenb_pos);
+
+	writel(regvalue, &pregister->mlccontrolt);
+}
+
+int nx_mlc_get_mlc_enable(u32 module_index)
+{
+	const u32 mlcenb_pos = 1;
+	const u32 mlcenb_mask = 1ul << mlcenb_pos;
+
+	return (int)((__g_module_variables[module_index].pregister->
+		      mlccontrolt & mlcenb_mask) >> mlcenb_pos);
+}
+
+void nx_mlc_set_field_enable(u32 module_index, int benb)
+{
+	const u32 fieldenb_pos = 0;
+	const u32 fieldenb_mask = 1ul << fieldenb_pos;
+	const u32 dirtyflag_pos = 3;
+	const u32 dirtyflag_mask = 1ul << dirtyflag_pos;
+	register u32 regvalue;
+	register struct nx_mlc_register_set *pregister;
+
+	pregister = __g_module_variables[module_index].pregister;
+	regvalue = pregister->mlccontrolt;
+	regvalue &= ~(fieldenb_mask | dirtyflag_mask);
+	regvalue |= (benb << fieldenb_pos);
+
+	writel(regvalue, &pregister->mlccontrolt);
+}
+
+int nx_mlc_get_field_enable(u32 module_index)
+{
+	const u32 fieldenb_pos = 0;
+	const u32 fieldenb_mask = 1ul << fieldenb_pos;
+
+	return (int)(__g_module_variables[module_index].pregister->mlccontrolt &
+		     fieldenb_mask);
+}
+
+void nx_mlc_set_layer_priority(u32 module_index, enum nx_mlc_priority priority)
+{
+	const u32 priority_pos = 8;
+	const u32 priority_mask = 0x03 << priority_pos;
+	const u32 dirtyflag_pos = 3;
+	const u32 dirtyflag_mask = 1ul << dirtyflag_pos;
+	register struct nx_mlc_register_set *pregister;
+	register u32 regvalue;
+
+	pregister = __g_module_variables[module_index].pregister;
+	regvalue = pregister->mlccontrolt;
+	regvalue &= ~(priority_mask | dirtyflag_mask);
+	regvalue |= (priority << priority_pos);
+
+	writel(regvalue, &pregister->mlccontrolt);
+}
+
+void nx_mlc_set_screen_size(u32 module_index, u32 width, u32 height)
+{
+	register struct nx_mlc_register_set *pregister;
+	register u32 regvalue;
+
+	pregister = __g_module_variables[module_index].pregister;
+	regvalue = ((height - 1) << 16) | (width - 1);
+
+	writel(regvalue, &pregister->mlcscreensize);
+}
+
+void nx_mlc_get_screen_size(u32 module_index, u32 *pwidth, u32 *pheight)
+{
+	register struct nx_mlc_register_set *pregister;
+
+	pregister = __g_module_variables[module_index].pregister;
+
+	if (NULL != pwidth)
+		*pwidth = (pregister->mlcscreensize & 0x0fff) + 1;
+
+	if (NULL != pheight)
+		*pheight = ((pregister->mlcscreensize >> 16) & 0x0fff) + 1;
+}
+
+void nx_mlc_set_background(u32 module_index, u32 color)
+{
+	register struct nx_mlc_register_set *pregister;
+
+	pregister = __g_module_variables[module_index].pregister;
+	writel(color, &pregister->mlcbgcolor);
+}
+
+void nx_mlc_set_dirty_flag(u32 module_index, u32 layer)
+{
+	register struct nx_mlc_register_set *pregister;
+	register u32 regvalue;
+	const u32 dirtyflg_mask = 1ul << 4;
+
+	pregister = __g_module_variables[module_index].pregister;
+	if (0 == layer || 1 == layer) {
+		regvalue = pregister->mlcrgblayer[layer].mlccontrol;
+		regvalue |= dirtyflg_mask;
+
+		writel(regvalue, &pregister->mlcrgblayer[layer].mlccontrol);
+	} else if (3 == layer) {
+		regvalue = pregister->mlcvideolayer.mlccontrol;
+		regvalue |= dirtyflg_mask;
+
+		writel(regvalue, &pregister->mlcvideolayer.mlccontrol);
+	}
+}
+
+int nx_mlc_get_dirty_flag(u32 module_index, u32 layer)
+{
+	const u32 dirtyflg_pos = 4;
