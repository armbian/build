 sound/soc/nexell/Kconfig      |  16 +
 sound/soc/nexell/Makefile     |   4 +
 sound/soc/nexell/nexell-i2s.c | 566 ++++++++++++++++++++++++++++++++++
 5 files changed, 588 insertions(+)
 create mode 100644 sound/soc/nexell/Kconfig
