From e70f293777664f75abf80d5cb4d3b0e11fda0b24 Mon Sep 17 00:00:00 2001
From: Igor Pecovnik <igor@armbian.com>
Date: Wed, 9 Sep 2026 15:02:20 +0200
Subject: [PATCH 10/12] pwm: samsung: add nexell,s5p6818-pwm

S5P6818 PWM output block (@0xc0018000, separate from the clocksource timer) is
samsung-compatible (s5pc100 variant). Validated: PWM output on pwmchip1.

Signed-off-by: Igor Pecovnik <igor@armbian.com>
---
 drivers/pwm/pwm-samsung.c | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/drivers/pwm/pwm-samsung.c b/drivers/pwm/pwm-samsung.c
index 951b38ff5..4bb5b9050 100644
--- a/drivers/pwm/pwm-samsung.c
+++ b/drivers/pwm/pwm-samsung.c
@@ -501,6 +501,8 @@ static const struct of_device_id samsung_pwm_matches[] = {
 	{ .compatible = "samsung,s5p6440-pwm", .data = &s5p64x0_variant },
 	{ .compatible = "samsung,s5pc100-pwm", .data = &s5pc100_variant },
 	{ .compatible = "samsung,exynos4210-pwm", .data = &s5p64x0_variant },
+	{ .compatible = "nexell,s5p6818-pwm", .data = &s5pc100_variant },
+	{ .compatible = "nexell,s5p4418-pwm", .data = &s5pc100_variant },
 	{},
 };
 MODULE_DEVICE_TABLE(of, samsung_pwm_matches);
-- 
