From 601792830a942711ce44506de78413448bc2cdb6 Mon Sep 17 00:00:00 2001
From: Igor Pecovnik <igor@armbian.com>
Date: Wed, 9 Sep 2026 15:02:19 +0200
Subject: [PATCH 08/12] i2c: s3c2410: add nexell,s5p6818-i2c

S5P6818 I2C is S3C2440-compatible (QUIRK_S3C2440 | QUIRK_NO_GPIO) plus a
reset-before-enable via the reset controller. Validated: 3 buses at 97 KHz.

Signed-off-by: Igor Pecovnik <igor@armbian.com>
---
 drivers/i2c/busses/i2c-s3c2410.c | 18 ++++++++++++++++++
 1 file changed, 18 insertions(+)

diff --git a/drivers/i2c/busses/i2c-s3c2410.c b/drivers/i2c/busses/i2c-s3c2410.c
index 15e14a6fe..0b0a63406 100644
--- a/drivers/i2c/busses/i2c-s3c2410.c
+++ b/drivers/i2c/busses/i2c-s3c2410.c
@@ -20,6 +20,7 @@
 #include <linux/platform_device.h>
 #include <linux/pm_runtime.h>
 #include <linux/clk.h>
+#include <linux/reset.h>
 #include <linux/cpufreq.h>
 #include <linux/slab.h>
 #include <linux/io.h>
@@ -143,6 +144,8 @@ static const struct of_device_id s3c24xx_i2c_match[] = {
 	  .data = (void *)(QUIRK_S3C2440 | QUIRK_HDMIPHY | QUIRK_NO_GPIO) },
 	{ .compatible = "samsung,exynos5-sata-phy-i2c",
 	  .data = (void *)(QUIRK_S3C2440 | QUIRK_POLL | QUIRK_NO_GPIO) },
+	{ .compatible = "nexell,s5p6818-i2c",
+	  .data = (void *)(QUIRK_S3C2440 | QUIRK_NO_GPIO) },
 	{},
 };
 MODULE_DEVICE_TABLE(of, s3c24xx_i2c_match);
@@ -1073,6 +1076,25 @@ static int s3c24xx_i2c_probe(struct platform_device *pdev)
 	else if (IS_ERR(i2c->pctrl) && s3c24xx_i2c_parse_dt_gpio(i2c))
 		return -EINVAL;
 
+	/*
+	 * The S5P6818 I2C block must be pulsed through its reset line before it
+	 * is enabled, otherwise the controller wedges. Mirrors the vendor BSP.
+	 */
+	if (IS_ENABLED(CONFIG_RESET_CONTROLLER) &&
+	    of_device_is_compatible(pdev->dev.of_node, "nexell,s5p6818-i2c")) {
+		struct reset_control *rst =
+			devm_reset_control_get(&pdev->dev, "i2c-reset");
+		if (IS_ERR(rst)) {
+			dev_err(&pdev->dev, "failed to get i2c reset control\n");
+			return PTR_ERR(rst);
+		}
+		ret = reset_control_reset(rst);
+		if (ret) {
+			dev_err(&pdev->dev, "i2c reset failed: %d\n", ret);
+			return ret;
+		}
+	}
+
 	/* initialise the i2c controller */
 	ret = clk_prepare_enable(i2c->clk);
 	if (ret) {
-- 
2.53.0

