+# SPDX-License-Identifier: GPL-2.0
+config DRM_NEXELL
+	bool "Nexell S5P6818/S5P4418 display bring-up (WIP)"
+	depends on ARCH_NEXELL || COMPILE_TEST
+	help
+	  Bring-up driver for the Nexell S5Pxx18 display controller (DPC/MLC)
+	  and HDMI output. Work in progress: phase 1 only ungates the HDMI
+	  clocks and reports hotplug; it will grow into a full DRM/KMS driver
