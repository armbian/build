From 6baef850d98cb6eae5a6139ebbd75c6897f40089 Mon Sep 17 00:00:00 2001
From: Igor Pecovnik <igor@armbian.com>
Date: Thu, 10 Sep 2026 10:45:00 +0200
Subject: [PATCH] arm64: dts: s5p6818: split board DT into common dtsi +
 per-board files

The single s5p6818-nanopi-m3.dts served the whole FriendlyElec S5P6818
family, but the boards are not identical: the NanoPi Fire3 has no on-board
eMMC, no SDIO WiFi/Bluetooth and no audio codec, so on it the ES8316, the
simple-audio-card, the SDIO host and the BT serdev all fail to probe and
spam the log.

Split the tree so each board only describes what it has:

  s5p6818-nanopi3-common.dtsi - the peripherals shared by every board
      (debug UART, micro-SD, gigabit PHY, I2C buses, PWMs, status LED);
      the board-specific blocks stay disabled (their SoC-dtsi default).
  s5p6818-nanopi-m3.dts       - the full boards (NanoPi M3, NanoPC-T3/T3+):
      includes common and enables eMMC, SDIO WiFi, Bluetooth and ES8316
      audio.
  s5p6818-nanopi-fire3.dts    - the Fire3: includes common and adds nothing,
      so no phantom audio/WiFi/BT/eMMC nodes and a clean boot.

The board .conf files select the matching dtb via BOOT_FDT_FILE, which the
build writes into armbianEnv.txt for boot-s5p6818.cmd.

Signed-off-by: Igor Pecovnik <igor@armbian.com>
---
 arch/arm64/boot/dts/nexell/Makefile           |  1 +
 .../boot/dts/nexell/s5p6818-nanopi-fire3.dts  | 16 +++
 .../boot/dts/nexell/s5p6818-nanopi-m3.dts     | 98 +++----------------
 .../dts/nexell/s5p6818-nanopi3-common.dtsi    | 93 ++++++++++++++++++
 4 files changed, 121 insertions(+), 87 deletions(-)
 create mode 100644 arch/arm64/boot/dts/nexell/s5p6818-nanopi-fire3.dts
 create mode 100644 arch/arm64/boot/dts/nexell/s5p6818-nanopi3-common.dtsi

diff --git a/arch/arm64/boot/dts/nexell/Makefile b/arch/arm64/boot/dts/nexell/Makefile
index cc919ea..9390773 100644
--- a/arch/arm64/boot/dts/nexell/Makefile
+++ b/arch/arm64/boot/dts/nexell/Makefile
@@ -1,2 +1,3 @@
 # SPDX-License-Identifier: GPL-2.0
 dtb-$(CONFIG_ARCH_NEXELL) += s5p6818-nanopi-m3.dtb
+dtb-$(CONFIG_ARCH_NEXELL) += s5p6818-nanopi-fire3.dtb
diff --git a/arch/arm64/boot/dts/nexell/s5p6818-nanopi-fire3.dts b/arch/arm64/boot/dts/nexell/s5p6818-nanopi-fire3.dts
new file mode 100644
index 0000000..ebcf592
--- /dev/null
+++ b/arch/arm64/boot/dts/nexell/s5p6818-nanopi-fire3.dts
@@ -0,0 +1,16 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * FriendlyElec NanoPi Fire3 (octa-core S5P6818, 1 GiB).
+ * The stripped-down board: micro-SD only, no on-board eMMC, no SDIO WiFi /
+ * Bluetooth and no audio codec. It carries just the peripherals shared by the
+ * whole family - see s5p6818-nanopi3-common.dtsi - so there is nothing to add
+ * here beyond the board identity.
+ */
+
+/dts-v1/;
+#include "s5p6818-nanopi3-common.dtsi"
+
+/ {
+	model = "FriendlyElec NanoPi Fire3";
+	compatible = "friendlyarm,nanopi-fire3", "nexell,s5p6818";
+};
diff --git a/arch/arm64/boot/dts/nexell/s5p6818-nanopi-m3.dts b/arch/arm64/boot/dts/nexell/s5p6818-nanopi-m3.dts
index 0fe93f0..5f20ade 100644
--- a/arch/arm64/boot/dts/nexell/s5p6818-nanopi-m3.dts
+++ b/arch/arm64/boot/dts/nexell/s5p6818-nanopi-m3.dts
@@ -1,56 +1,19 @@
 // SPDX-License-Identifier: GPL-2.0
 /*
- * FriendlyARM S5P6818 boards. One device tree serves the whole octa-core
- * S5P6818 family - NanoPi M3, NanoPi Fire3 and NanoPC-T3/T3+ - because they
- * share the SoC and the on-board peripheral wiring (GbE PHY, USB, MMC, I2C,
- * PWM, the status LED). The only per-board difference is RAM size, which the
- * bootloader fills into the /memory node below (u-boot ft_board_setup), so the
- * value here is only a fallback. See s5p6818.dtsi for the SoC nodes.
+ * FriendlyElec NanoPi M3 / NanoPC-T3 / NanoPC-T3+ (octa-core S5P6818).
+ * The full-featured boards: on-board eMMC, SDIO WiFi + Bluetooth (AP6212 /
+ * BCM43430) and an ES8316 analog audio codec on the 3.5 mm jack, on top of the
+ * peripherals shared by the whole family (see s5p6818-nanopi3-common.dtsi).
+ * The 2 GiB T3+ uses this same tree; u-boot fills in the real RAM size.
  */
 
 /dts-v1/;
-#include "s5p6818.dtsi"
-#include <dt-bindings/gpio/gpio.h>
+#include "s5p6818-nanopi3-common.dtsi"
 
 / {
-	model = "FriendlyARM S5P6818 (NanoPi M3/Fire3, NanoPC-T3+)";
-	compatible = "friendlyarm,nanopi-m3", "friendlyarm,nanopi-fire3",
-		     "friendlyarm,nanopc-t3", "nexell,s5p6818";
-
-	aliases {
-		serial0 = &uart0;
-		/*
-		 * Pin the mmc host numbering so mmcblkN is stable: without this
-		 * the non-removable eMMC races the polled SD for mmcblk0 and
-		 * root=/dev/mmcblk0p1 becomes unreliable. SD=0, WiFi(SDIO)=1,
-		 * eMMC=2 -> SD is mmcblk0, eMMC is mmcblk2.
-		 */
-		mmc0 = &mmc0;	/* SD card   (c0062000) */
-		mmc1 = &mmc1;	/* SDIO WiFi (c0068000) */
-		mmc2 = &mmc2;	/* eMMC      (c0069000) */
-	};
-
-	chosen {
-		stdout-path = "serial0:115200n8";
-	};
-
-	/* Placeholder - the real size (1 GiB on M3/Fire3, 2 GiB on T3+) is
-	 * written here by u-boot per board. */
-	memory@40000000 {
-		device_type = "memory";
-		reg = <0x0 0x40000000 0x0 0x40000000>;	/* 1 GiB fallback */
-	};
-
-	/* On-board green status LED (active low). Heartbeat by default. */
-	leds {
-		compatible = "gpio-leds";
-
-		green_led: led-green {
-			label = "green:status";
-			gpios = <&gpio_b 12 GPIO_ACTIVE_LOW>;
-			linux,default-trigger = "heartbeat";
-		};
-	};
+	model = "FriendlyElec NanoPi M3 / NanoPC-T3 / NanoPC-T3+";
+	compatible = "friendlyarm,nanopi-m3", "friendlyarm,nanopc-t3",
+		     "nexell,s5p6818";
 
 	/*
 	 * Analog audio on the 3.5 mm jack: SoC I2S0 (master) -> ES8316 codec.
@@ -74,19 +37,11 @@
 	};
 };
 
-&uart0 {
-	status = "okay";
-};
-
-&mmc0 {
+&mmc2 {		/* on-board eMMC */
 	status = "okay";
 };
 
-&mmc2 {	/* on-board eMMC */
-	status = "okay";
-};
-
-&mmc1 {	/* SDIO WiFi */
+&mmc1 {		/* SDIO WiFi */
 	status = "okay";
 };
 
@@ -100,24 +55,7 @@
 	};
 };
 
-&gmac0 {
-	status = "okay";
-	phy-handle = <&rtl_phy>;
-	/* RTL8211E hardware reset on gpioe-22 (active low). */
-	snps,reset-gpio = <&gpio_e 22 GPIO_ACTIVE_LOW>;
-	snps,reset-active-low;
-	snps,reset-delays-us = <0 10000 30000>;
-};
-
-&mdio0 {
-	rtl_phy: ethernet-phy@7 {	/* RTL8211E, id 0x001cc915 */
-		reg = <7>;
-	};
-};
-
 &i2c_0 {
-	status = "okay";
-
 	es8316: audio-codec@11 {
 		compatible = "everest,es8316";
 		reg = <0x11>;
@@ -128,17 +66,3 @@
 &i2s0 {
 	status = "okay";
 };
-
-&i2c_1 {
-	status = "okay";
-};
-
-&i2c_2 {
-	status = "okay";
-};
-
-&pwm {
-	pinctrl-names = "default";
-	pinctrl-0 = <&pwm0_pins &pwm1_pins &pwm2_pins &pwm3_pins>;
-	status = "okay";
-};
diff --git a/arch/arm64/boot/dts/nexell/s5p6818-nanopi3-common.dtsi b/arch/arm64/boot/dts/nexell/s5p6818-nanopi3-common.dtsi
new file mode 100644
index 0000000..8afc108
--- /dev/null
+++ b/arch/arm64/boot/dts/nexell/s5p6818-nanopi3-common.dtsi
@@ -0,0 +1,93 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Shared board definition for the FriendlyElec octa-core S5P6818 boards
+ * (NanoPi M3, NanoPi Fire3, NanoPC-T3 and NanoPC-T3+). It enables only the
+ * peripherals every one of them carries: the debug UART, the micro-SD slot,
+ * the gigabit PHY, the I2C buses, the PWMs and the green status LED. The
+ * board-specific blocks (on-board eMMC, SDIO WiFi, Bluetooth and the ES8316
+ * audio codec) stay disabled here and are enabled by the per-board .dts of the
+ * board that actually has them. RAM size is written into /memory by u-boot
+ * (ft_board_setup), so the value here is only a fallback. See s5p6818.dtsi for
+ * the SoC nodes.
+ */
+
+#include "s5p6818.dtsi"
+#include <dt-bindings/gpio/gpio.h>
+
+/ {
+	aliases {
+		serial0 = &uart0;
+		/*
+		 * Pin the mmc host numbering so mmcblkN is stable: without this
+		 * the non-removable eMMC races the polled SD for mmcblk0 and
+		 * root=/dev/mmcblk0p1 becomes unreliable. SD=0, WiFi(SDIO)=1,
+		 * eMMC=2 -> SD is mmcblk0, eMMC is mmcblk2.
+		 */
+		mmc0 = &mmc0;	/* SD card   (c0062000) */
+		mmc1 = &mmc1;	/* SDIO WiFi (c0068000) */
+		mmc2 = &mmc2;	/* eMMC      (c0069000) */
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+	};
+
+	/* Placeholder - the real size (1 GiB on Fire3/M3/T3, 2 GiB on T3+) is
+	 * written here by u-boot per board. */
+	memory@40000000 {
+		device_type = "memory";
+		reg = <0x0 0x40000000 0x0 0x40000000>;	/* 1 GiB fallback */
+	};
+
+	/* On-board green status LED (active low). Heartbeat by default. */
+	leds {
+		compatible = "gpio-leds";
+
+		green_led: led-green {
+			label = "green:status";
+			gpios = <&gpio_b 12 GPIO_ACTIVE_LOW>;
+			linux,default-trigger = "heartbeat";
+		};
+	};
+};
+
+&uart0 {
+	status = "okay";
+};
+
+&mmc0 {		/* micro-SD slot */
+	status = "okay";
+};
+
+&gmac0 {
+	status = "okay";
+	phy-handle = <&rtl_phy>;
+	/* RTL8211E hardware reset on gpioe-22 (active low). */
+	snps,reset-gpio = <&gpio_e 22 GPIO_ACTIVE_LOW>;
+	snps,reset-active-low;
+	snps,reset-delays-us = <0 10000 30000>;
+};
+
+&mdio0 {
+	rtl_phy: ethernet-phy@7 {	/* RTL8211E, id 0x001cc915 */
+		reg = <7>;
+	};
+};
+
+&i2c_0 {
+	status = "okay";
+};
+
+&i2c_1 {
+	status = "okay";
+};
+
+&i2c_2 {
+	status = "okay";
+};
+
+&pwm {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pwm0_pins &pwm1_pins &pwm2_pins &pwm3_pins>;
+	status = "okay";
+};
