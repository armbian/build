From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Igor Pecovnik <igor@armbian.com>
Date: Wed, 9 Sep 2026 21:52:24 +0200
Subject: [PATCH] arm64: dts: s5p6818: add on-board eMMC (SDMMC2)

Add the dw_mmc controller on SDMMC2 (@0xc0069000) for the on-board eMMC:
non-removable, 4-bit (u-boot muxes DAT0-3 only), fixed 100 MHz like mmc0.
HW-verified: enumerates a 14.6 GiB eMMC (mmcblk1 + boot0/boot1) at 52 MHz.

Signed-off-by: Igor Pecovnik <igor@armbian.com>
---
 .../boot/dts/nexell/s5p6818-nanopi-m3.dts     |  4 ++++
 arch/arm64/boot/dts/nexell/s5p6818.dtsi       | 22 +++++++++++++++++++
 2 files changed, 26 insertions(+)

diff --git a/arch/arm64/boot/dts/nexell/s5p6818-nanopi-m3.dts b/arch/arm64/boot/dts/nexell/s5p6818-nanopi-m3.dts
index 8d6d833dd..7570375f4 100644
--- a/arch/arm64/boot/dts/nexell/s5p6818-nanopi-m3.dts
+++ b/arch/arm64/boot/dts/nexell/s5p6818-nanopi-m3.dts
@@ -73,6 +73,10 @@ &mmc0 {
 	status = "okay";
 };
 
+&mmc2 {	/* on-board eMMC */
+	status = "okay";
+};
+
 &gmac0 {
 	status = "okay";
 	phy-handle = <&rtl_phy>;
diff --git a/arch/arm64/boot/dts/nexell/s5p6818.dtsi b/arch/arm64/boot/dts/nexell/s5p6818.dtsi
index c9126ac33..42da6b32f 100644
--- a/arch/arm64/boot/dts/nexell/s5p6818.dtsi
+++ b/arch/arm64/boot/dts/nexell/s5p6818.dtsi
@@ -380,6 +380,28 @@ mmc0: mmc@c0062000 {
 			status = "disabled";
 		};
 
+		/*
+		 * On-board eMMC on SDMMC2 (@0xc0069000). Non-removable, 4-bit.
+		 * Pins/clock are left as u-boot configured (it boots from here),
+		 * mirroring mmc0's fixed-clock, pinctrl-less setup.
+		 */
+		mmc2: mmc@c0069000 {
+			compatible = "snps,dw-mshc";
+			reg = <0xc0069000 0x1000>;
+			interrupts = <GIC_SPI 45 IRQ_TYPE_LEVEL_HIGH>;
+			#address-cells = <1>;
+			#size-cells = <0>;
+			clocks = <&mmc_clk>, <&mmc_clk>;
+			clock-names = "biu", "ciu";
+			fifo-depth = <0x20>;
+			clock-frequency = <100000000>;
+			bus-width = <4>;	/* u-boot muxes DAT0-3 only */
+			cap-mmc-highspeed;
+			non-removable;
+			disable-wp;
+			status = "disabled";
+		};
+
 		/*
 		 * Nexell PLL provider (CLKPWR block @0xc0010000). Registers the
 		 * core PLLs as global clkdev names "pll0".."pll3" (+ sys clocks),
