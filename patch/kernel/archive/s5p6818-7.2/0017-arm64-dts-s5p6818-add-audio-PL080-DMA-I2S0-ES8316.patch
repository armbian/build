From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Igor Pecovnik <igor@armbian.com>
Date: Wed, 9 Sep 2026 21:44:31 +0200
Subject: [PATCH 17/17] arm64: dts: s5p6818: add audio (PL080 DMA, I2S0,
 ES8316)

Add the two ARM PL080 DMA controllers (mainline amba-pl08x, periphid
0x00041080), the I2S0 controller (@0xc0055000, DMA req 12/13, reset 23),
its clk-gen clock (cell-id 15, PLL-sourced) and bus pins (gpiod-9..13),
plus a fixed apb_pclk for the DMA. The board dts adds the ES8316 codec
(i2c_0 @0x11) and a simple-audio-card linking I2S0 (master) to the codec
for analog audio on the 3.5 mm jack.

Signed-off-by: Igor Pecovnik <igor@armbian.com>
---
 .../boot/dts/nexell/s5p6818-nanopi-m3.dts     |  31 +++++
 arch/arm64/boot/dts/nexell/s5p6818.dtsi       | 110 ++++++++++++++++++
 2 files changed, 141 insertions(+)

diff --git a/arch/arm64/boot/dts/nexell/s5p6818-nanopi-m3.dts b/arch/arm64/boot/dts/nexell/s5p6818-nanopi-m3.dts
index 9639a34f4..8d6d833dd 100644
--- a/arch/arm64/boot/dts/nexell/s5p6818-nanopi-m3.dts
+++ b/arch/arm64/boot/dts/nexell/s5p6818-nanopi-m3.dts
@@ -42,6 +42,27 @@ green_led: led-green {
 			linux,default-trigger = "heartbeat";
 		};
 	};
+
+	/*
+	 * Analog audio on the 3.5 mm jack: SoC I2S0 (master) -> ES8316 codec.
+	 * HDMI audio (SPDIF) is not wired (no display support).
+	 */
+	sound {
+		compatible = "simple-audio-card";
+		simple-audio-card,name = "S5P6818-Audio";
+		simple-audio-card,format = "i2s";
+		simple-audio-card,mclk-fs = <256>;
+		simple-audio-card,bitclock-master = <&sndcpu>;
+		simple-audio-card,frame-master = <&sndcpu>;
+
+		sndcpu: simple-audio-card,cpu {
+			sound-dai = <&i2s0 0>;
+		};
+
+		simple-audio-card,codec {
+			sound-dai = <&es8316>;
+		};
+	};
 };
 
 &uart0 {
@@ -69,6 +90,16 @@ rtl_phy: ethernet-phy@7 {	/* RTL8211E, id 0x001cc915 */
 
 &i2c_0 {
 	status = "okay";
+
+	es8316: audio-codec@11 {
+		compatible = "everest,es8316";
+		reg = <0x11>;
+		#sound-dai-cells = <0>;
+	};
+};
+
+&i2s0 {
+	status = "okay";
 };
 
 &i2c_1 {
diff --git a/arch/arm64/boot/dts/nexell/s5p6818.dtsi b/arch/arm64/boot/dts/nexell/s5p6818.dtsi
index 8d7f2150a..c9126ac33 100644
--- a/arch/arm64/boot/dts/nexell/s5p6818.dtsi
+++ b/arch/arm64/boot/dts/nexell/s5p6818.dtsi
@@ -311,6 +311,15 @@ pwm3_pins: pwm3-pins {
 				nexell,pin-pull = <0>;
 				nexell,pin-strength = <0>;
 			};
+
+			/* I2S0 bus: MCLK/BCLK/LRCK/SDO/SDI (bank D, function 1). */
+			i2s0_bus: i2s0-bus {
+				nexell,pins = "gpiod-9", "gpiod-10", "gpiod-11",
+					      "gpiod-12", "gpiod-13";
+				nexell,pin-function = <1>;
+				nexell,pin-pull = <0>;
+				nexell,pin-strength = <0>;
+			};
 		};
 
 		gic: interrupt-controller@c0009000 {
@@ -469,6 +478,24 @@ i2c2_clk: i2c2-clk@c00b0000 {
 				clk-input = <0x1000>;
 				#clock-cells = <0>;
 			};
+
+			/*
+			 * I2S0 module clock (clk-gen @0xc00b2000, cell-id 15 =
+			 * CLK_ID_I2S_0). Two-stage divider (clk-step 2) sourced from a
+			 * PLL (clk-input 0xf = PLL0..3 only; no external audio xtal on
+			 * these boards) to derive the I2S master clock (256/384 fs).
+			 * The i2s driver enables/sets the rate itself, so no
+			 * clk-critical here.
+			 */
+			i2s0_clk: i2s0-clk@c00b2000 {
+				reg = <0xc00b2000 0x100>;
+				clock-output-names = "i2s0";
+				cell-id = <15>;
+				clk-step = <2>;
+				clk-input = <0xf>;
+				clk-input1 = <0>;
+				#clock-cells = <0>;
+			};
 		};
 
 		/*
@@ -482,6 +509,17 @@ gmac_pclk: gmac-pclk {
 			clock-output-names = "gmac_pclk";
 		};
 
+		/*
+		 * PL080 DMA APB register clock ("apb_pclk"). Mandatory for the
+		 * primecell probe; left running by u-boot, modelled as fixed.
+		 */
+		dma_pclk: dma-pclk {
+			compatible = "fixed-clock";
+			#clock-cells = <0>;
+			clock-frequency = <200000000>;
+			clock-output-names = "dma_pclk";
+		};
+
 		/* PWM block bus clock ("timers"); the PWM base clock. */
 		pwm_pclk: pwm-pclk {
 			compatible = "fixed-clock";
@@ -655,6 +693,78 @@ i2c_2: i2c@c00a6000 {
 			status = "disabled";
 		};
 
+			/*
+			 * DMA: two ARM PL080 controllers. periphid 0x00041080 selects
+			 * the mainline amba-pl08x plain-PL080 path. I2S0 uses DMA0
+			 * request lines 12 (tx) / 13 (rx). apb_pclk is the (fixed,
+			 * u-boot-left) bus clock; the block is enabled at reset.
+			 */
+			amba {
+				compatible = "simple-bus";
+				#address-cells = <1>;
+				#size-cells = <1>;
+				ranges;
+
+				dma0: dma@c0000000 {
+					compatible = "arm,pl080", "arm,primecell";
+					arm,primecell-periphid = <0x00041080>;
+					reg = <0xc0000000 0x1000>;
+					interrupts = <GIC_SPI 1 IRQ_TYPE_LEVEL_HIGH>;
+					#dma-cells = <2>;
+					dma-channels = <8>;
+					dma-requests = <16>;
+					lli-bus-interface-ahb1;
+					mem-bus-interface-ahb1;
+					memcpy-burst-size = <256>;
+					memcpy-bus-width = <32>;
+					clocks = <&dma_pclk>;
+					clock-names = "apb_pclk";
+				};
+
+				dma1: dma@c0001000 {
+					compatible = "arm,pl080", "arm,primecell";
+					arm,primecell-periphid = <0x00041080>;
+					reg = <0xc0001000 0x1000>;
+					interrupts = <GIC_SPI 2 IRQ_TYPE_LEVEL_HIGH>;
+					#dma-cells = <2>;
+					dma-channels = <8>;
+					dma-requests = <16>;
+					lli-bus-interface-ahb1;
+					mem-bus-interface-ahb1;
+					memcpy-burst-size = <256>;
+					memcpy-bus-width = <32>;
+					clocks = <&dma_pclk>;
+					clock-names = "apb_pclk";
+				};
+			};
+
+			/*
+			 * I2S0 controller (@0xc0055000, nexell,nexell-i2s). Master
+			 * mode, MCLK out to the codec. TX/RX FIFOs drained by PL080
+			 * DMA0 (req 12 tx / 13 rx). Board dts enables it and wires the
+			 * codec + simple-audio-card.
+			 */
+			i2s0: i2s@c0055000 {
+				compatible = "nexell,nexell-i2s";
+				reg = <0xc0055000 0x1000>;
+				#sound-dai-cells = <1>;
+				dmas = <&dma0 12 0>, <&dma0 13 0>;
+				dma-names = "tx", "rx";
+				clocks = <&i2s0_clk>;
+				clock-names = "i2s0";
+				resets = <&nexell_reset 23>;
+				reset-names = "i2s-reset";
+				pinctrl-names = "default";
+				pinctrl-0 = <&i2s0_bus>;
+				master-mode = <1>;
+				mclk-in = <0>;
+				trans-mode = <0>;
+				frame-bit = <32>;
+				sample-rate = <48000>;
+				pre-supply-mclk = <1>;
+				status = "disabled";
+			};
+
 		/*
 		 * PWM block (@0xc0018000) - separate from the clocksource timer
 		 * @c0017000. Samsung-compatible (pwm-samsung, s5pc100 variant),
