From 5f724b89b123ba228d23e1f5f46a755a5d83594a Mon Sep 17 00:00:00 2001
From: Igor Pecovnik <igor@armbian.com>
Date: Thu, 10 Sep 2026 19:20:00 +0200
Subject: [PATCH] arm64: dts: s5p6818: add Mali-400 GPU (Lima) + VR clock

Add the ARM Mali-400 MP4 GPU node (gpu@c0070000, arm,mali-400 / arm,mali-
utgard) for the Lima driver, and the BCLK-gated VR clock (cell-id 21,
0xc00c3000) that feeds it. The S5P6818 muxes all GPU sub-block interrupts onto
one line (SPI 40); reset id 65.

HW-verified on a NanoPi Fire3: lima probes the GP + 4 PPs + L2 cache, and
/dev/dri/renderD128 appears - GLES2 hardware acceleration via Mesa lima,
PRIME-shared to the nexell KMS display.

Signed-off-by: Igor Pecovnik <igor@armbian.com>
---
 arch/arm64/boot/dts/nexell/s5p6818.dtsi | 39 +++++++++++++++++++++++++
 1 file changed, 39 insertions(+)

diff --git a/arch/arm64/boot/dts/nexell/s5p6818.dtsi b/arch/arm64/boot/dts/nexell/s5p6818.dtsi
index 78d65e4..4dcee43 100644
--- a/arch/arm64/boot/dts/nexell/s5p6818.dtsi
+++ b/arch/arm64/boot/dts/nexell/s5p6818.dtsi
@@ -217,6 +217,35 @@
 			status = "disabled";
 		};
 
+		/*
+		 * ARM Mali-400 MP4 GPU (Utgard) for the Lima driver. One shared
+		 * GPU interrupt (SPI 40) is muxed to all sub-blocks. Clock is the
+		 * BCLK-gated VR clock; reset id 65.
+		 */
+		gpu: gpu@c0070000 {
+			compatible = "arm,mali-400", "arm,mali-utgard";
+			reg = <0xc0070000 0x10000>;
+			interrupts = <GIC_SPI 40 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 40 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 40 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 40 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 40 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 40 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 40 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 40 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 40 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 40 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 40 IRQ_TYPE_LEVEL_HIGH>;
+			interrupt-names = "gp", "gpmmu",
+					  "pp0", "ppmmu0", "pp1", "ppmmu1",
+					  "pp2", "ppmmu2", "pp3", "ppmmu3",
+					  "pmu";
+			clocks = <&vr_clk>, <&vr_clk>;
+			clock-names = "bus", "core";
+			resets = <&nexell_reset 65>;
+			status = "okay";
+		};
+
 		/*
 		 * Nexell pin controller + GPIO banks (A-E + ALIVE). Provides pin
 		 * muxing (nexell,pin-function) and the GPIO banks used e.g. for the
@@ -612,6 +641,16 @@
 				clk-input = <0x1000>;
 				#clock-cells = <0>;
 			};
+
+			/* Mali-400 GPU clock (VR): BCLK-gated, cell-id 21. */
+			vr_clk: vr-clk@c00c3000 {
+				reg = <0xc00c3000 0x100>;
+				clock-output-names = "vr";
+				cell-id = <21>;
+				clk-step = <1>;
+				clk-input = <0x2000>;	/* I_GATE_BCLK */
+				#clock-cells = <0>;
+			};
 			i2c1_clk: i2c1-clk@c00af000 {
 				reg = <0xc00af000 0x100>;
 				clock-output-names = "i2c1";
-- 
2.53.0

