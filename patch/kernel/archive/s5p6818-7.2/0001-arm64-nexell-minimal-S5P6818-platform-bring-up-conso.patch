 	tristate "Samsung SoC serial support"
-	depends on PLAT_SAMSUNG || ARCH_S5PV210 || ARCH_EXYNOS || ARCH_APPLE || ARCH_ARTPEC || COMPILE_TEST
+	depends on PLAT_SAMSUNG || ARCH_S5PV210 || ARCH_EXYNOS || ARCH_APPLE || ARCH_ARTPEC || ARCH_NEXELL || COMPILE_TEST
 	select SERIAL_CORE
 	help
 	  Support for the on-chip UARTs on the Samsung
diff --git a/drivers/tty/serial/samsung_tty.c b/drivers/tty/serial/samsung_tty.c
index 63d0232df..177d40b29 100644
--- a/drivers/tty/serial/samsung_tty.c
+++ b/drivers/tty/serial/samsung_tty.c
@@ -2416,7 +2416,13 @@ static const struct s3c24xx_serial_drv_data s3c6400_serial_drv_data = {
 #define S3C6400_SERIAL_DRV_DATA NULL
 #endif
 
-#ifdef CONFIG_CPU_S5PV210
+/*
+ * The Nexell S5P6818 UART is register-compatible with the S5PV210 UART, so it
