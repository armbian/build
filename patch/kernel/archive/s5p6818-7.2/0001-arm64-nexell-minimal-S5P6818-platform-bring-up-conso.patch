diff --git a/arch/arm64/boot/dts/nexell/s5p6818-nanopi-m3.dts b/arch/arm64/boot/dts/nexell/s5p6818-nanopi-m3.dts
new file mode 100644
index 000000000..0c567100b
--- /dev/null
+++ b/arch/arm64/boot/dts/nexell/s5p6818-nanopi-m3.dts
@@ -0,0 +1,34 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * FriendlyARM S5P6818 board (NanoPi M3 / NanoPC-T3 / NanoPC-T3+).
+ * Minimal mainline bring-up device tree - see s5p6818.dtsi.
+ */
+
+/dts-v1/;
+#include "s5p6818.dtsi"
+
+/ {
+	model = "FriendlyARM NanoPC-T3+ (S5P6818)";
+	compatible = "friendlyarm,nanopc-t3", "nexell,s5p6818";
+
+	aliases {
+		serial0 = &uart0;
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+	};
+
+	memory@40000000 {
+		device_type = "memory";
+		reg = <0x0 0x40000000 0x0 0x80000000>;	/* 2 GiB */
+	};
+};
+
+&uart0 {
+	status = "okay";
+};
+
+&mmc0 {
+	status = "okay";
+};
diff --git a/arch/arm64/boot/dts/nexell/s5p6818.dtsi b/arch/arm64/boot/dts/nexell/s5p6818.dtsi
new file mode 100644
index 000000000..975b5665d
--- /dev/null
+++ b/arch/arm64/boot/dts/nexell/s5p6818.dtsi
@@ -0,0 +1,102 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Minimal mainline device tree for the Nexell S5P6818 (octa Cortex-A53).
+ *
+ * v1 bring-up: console + SD/eMMC using only generic drivers. The SoC PLLs are
+ * left as configured by u-boot and modelled here as fixed-rate clocks; pin
+ * muxing is inherited from u-boot. The SoC-specific nexell clk/pinctrl/reset
+ * drivers are added in later stages. Addresses/IRQs taken from the running
+ * 4.14 BSP device tree of a NanoPC-T3+.
+ */
+
+#include <dt-bindings/interrupt-controller/arm-gic.h>
+
+/ {
+	compatible = "nexell,s5p6818";
+	interrupt-parent = <&gic>;
+	#address-cells = <2>;
+	#size-cells = <2>;
+
+	cpus {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		/* v1 boots a single core; secondaries need PSCI/SMP glue (later). */
+		cpu0: cpu@0 {
+			device_type = "cpu";
+			compatible = "arm,cortex-a53";
+			reg = <0x0>;
+		};
+	};
+
+	/* ARM architected timer. CNTFRQ is programmed by u-boot; clock-frequency
+	 * is a fallback in case firmware left it unset. */
+	timer {
+		compatible = "arm,armv8-timer";
+		interrupts = <GIC_PPI 13 IRQ_TYPE_LEVEL_LOW>,
+			     <GIC_PPI 14 IRQ_TYPE_LEVEL_LOW>,
+			     <GIC_PPI 11 IRQ_TYPE_LEVEL_LOW>,
+			     <GIC_PPI 10 IRQ_TYPE_LEVEL_LOW>;
+		clock-frequency = <200000000>;
+	};
+
+	/* UART baud/pclk source (nexell PLL output, fixed from Linux' view). */
+	uart_clk: uart-clk {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <153598500>;
+		clock-output-names = "uart";
+	};
+
+	/* SD/MMC controller clock (ciu/biu), 100 MHz on the SD port. */
+	mmc_clk: mmc-clk {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <100000000>;
+		clock-output-names = "mmc";
+	};
+
+	soc {
+		compatible = "simple-bus";
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges = <0xc0000000 0x0 0xc0000000 0x10000000>;
+
+		gic: interrupt-controller@c0009000 {
+			compatible = "arm,gic-400";
+			#interrupt-cells = <3>;
+			#address-cells = <0>;
+			interrupt-controller;
+			reg = <0xc0009000 0x1000>,	/* GICD */
+			      <0xc000a000 0x2000>;	/* GICC */
+			interrupts = <GIC_PPI 9 IRQ_TYPE_LEVEL_HIGH>;
+		};
+
+		uart0: serial@c00a1000 {
+			compatible = "samsung,s5pv210-uart";
+			reg = <0xc00a1000 0x1000>;
+			interrupts = <GIC_SPI 7 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&uart_clk>, <&uart_clk>;
+			clock-names = "uart", "clk_uart_baud0";
+			samsung,uart-fifosize = <256>;
+			status = "disabled";
+		};
+
+		mmc0: mmc@c0062000 {
+			compatible = "snps,dw-mshc";
+			reg = <0xc0062000 0x1000>;
+			interrupts = <GIC_SPI 43 IRQ_TYPE_LEVEL_HIGH>;
+			#address-cells = <1>;
+			#size-cells = <0>;
+			clocks = <&mmc_clk>, <&mmc_clk>;
+			clock-names = "biu", "ciu";
+			fifo-depth = <0x20>;
+			clock-frequency = <100000000>;
+			bus-width = <4>;
+			cap-sd-highspeed;
+			broken-cd;
+			disable-wp;
+			status = "disabled";
+		};
+	};
+};
