From 9a13223a09d9a33bd78372604e1d0fb0d1a7d4ab Mon Sep 17 00:00:00 2001
From: Igor Pecovnik <igor@armbian.com>
Date: Thu, 10 Sep 2026 18:40:00 +0200
Subject: [PATCH] drm: nexell: atomic KMS driver - /dev/dri/card0 on HDMI
 (phase 4)

Turn the bring-up driver into a real atomic-KMS driver using
drm_simple_display_pipe + drm_gem_dma: one fixed-mode CRTC/plane (MLC.0 RGB
layer 0) and an HDMI connector, exposing /dev/dri/card0 and a DRM fbdev
console. It still reuses the 1280x720 HDMI pipeline the FriendlyARM u-boot
programmes (the pipe .enable/.update only drive the MLC layer from the DRM
framebuffer); DPC-timing/HDMI-PHY programming and EDID come next.

Kconfig becomes tristate depends on DRM (+ select DRM_CLIENT_SELECTION /
DRM_GEM_DMA_HELPER / DRM_KMS_HELPER). The DRM stack is built in via the board
config so the console is available early.

HW-verified on a NanoPi Fire3: /dev/dri/card0 present, [drm] Initialized
nexell, fbcon on HDMI. (Note: the simple-pipe helper calls .update before
.enable on the first modeset, so the MLC register base is registered at
probe time, not in .enable.)

Signed-off-by: Igor Pecovnik <igor@armbian.com>
---
 drivers/gpu/drm/nexell/Kconfig          |  15 +-
 drivers/gpu/drm/nexell/nx_display_drv.c | 348 +++++++++++++-----------
 2 files changed, 200 insertions(+), 163 deletions(-)

diff --git a/drivers/gpu/drm/nexell/Kconfig b/drivers/gpu/drm/nexell/Kconfig
index aedeccd..1dbb0ef 100644
--- a/drivers/gpu/drm/nexell/Kconfig
+++ b/drivers/gpu/drm/nexell/Kconfig
@@ -1,9 +1,12 @@
 # SPDX-License-Identifier: GPL-2.0
 config DRM_NEXELL
-	bool "Nexell S5P6818/S5P4418 display bring-up (WIP)"
-	depends on ARCH_NEXELL || COMPILE_TEST
+	tristate "DRM support for Nexell S5P6818/S5P4418 SoCs (WIP)"
+	depends on DRM && OF
+	select DRM_CLIENT_SELECTION
+	select DRM_GEM_DMA_HELPER
+	select DRM_KMS_HELPER
 	help
-	  Bring-up driver for the Nexell S5Pxx18 display controller (DPC/MLC)
-	  and HDMI output. Work in progress: phase 1 only ungates the HDMI
-	  clocks and reports hotplug; it will grow into a full DRM/KMS driver
-	  (at which point this becomes tristate and depends on DRM again).
+	  Atomic-KMS driver for the Nexell S5Pxx18 display controller (DPC/MLC)
+	  and HDMI output. Work in progress: a single fixed-mode CRTC/plane that
+	  reuses the pipeline the bootloader programmed. Provides /dev/dri/card0
+	  and a framebuffer console on HDMI.
diff --git a/drivers/gpu/drm/nexell/nx_display_drv.c b/drivers/gpu/drm/nexell/nx_display_drv.c
index aab6bef..3226446 100644
--- a/drivers/gpu/drm/nexell/nx_display_drv.c
+++ b/drivers/gpu/drm/nexell/nx_display_drv.c
@@ -1,25 +1,38 @@
 // SPDX-License-Identifier: GPL-2.0
 /*
- * Nexell S5P6818 display bring-up driver (WIP, phase 3).
+ * Nexell S5P6818 display driver - atomic KMS (WIP, phase 4).
  *
- * Builds on:
- *   phase 1 - ungate the HDMI clocks, report HPD;
- *   phase 2 - piggy-back on the 1280x720 pipeline the FriendlyARM u-boot
- *             already runs (HDMI PHY/Link + DPC timing) and point an MLC RGB
- *             layer at our own framebuffer;
- *   phase 3 - register that framebuffer as an fbdev so the framebuffer console
- *             (and a getty login) appear on the HDMI monitor.
+ * A minimal single-CRTC / single-plane atomic-KMS driver built on
+ * drm_simple_display_pipe + drm_gem_dma, exposing /dev/dri/card0 and a DRM
+ * fbdev console on HDMI. It reuses the 1280x720 pipeline the FriendlyARM
+ * u-boot already programmes for its boot logo (HDMI PHY/Link + DPC video
+ * timing), so the driver only:
+ *   - ungates the HDMI display clocks (the two DISPLAYTOP clkgen modules);
+ *   - drives MLC.0 RGB layer 0 (the plane) from the DRM framebuffer.
  *
- * Next: program the DPC timing + HDMI PHY preset ourselves (drop the u-boot
- * dependency, gain mode-setting) and wrap it all in atomic KMS.
+ * Next: programme the DPC timing + HDMI PHY preset here (drop the u-boot
+ * dependency) and add EDID / multiple modes.
  */
 
+#include <drm/clients/drm_client_setup.h>
+#include <drm/drm_atomic_helper.h>
+#include <drm/drm_drv.h>
+#include <drm/drm_edid.h>
+#include <drm/drm_fb_dma_helper.h>
+#include <drm/drm_fbdev_dma.h>
+#include <drm/drm_fourcc.h>
+#include <drm/drm_framebuffer.h>
+#include <drm/drm_gem_dma_helper.h>
+#include <drm/drm_gem_framebuffer_helper.h>
+#include <drm/drm_managed.h>
+#include <drm/drm_probe_helper.h>
+#include <drm/drm_simple_kms_helper.h>
+
+#include <linux/dma-mapping.h>
+#include <linux/io.h>
 #include <linux/module.h>
-#include <linux/platform_device.h>
 #include <linux/of.h>
-#include <linux/io.h>
-#include <linux/dma-mapping.h>
-#include <linux/fb.h>
+#include <linux/platform_device.h>
 
 #include "soc/s5pxx18_soc_mlc.h"
 
@@ -32,7 +45,6 @@
 #define NX_HDMI_CTRL_BASE		0xc0200000
 #define NX_HDMI_CTRL_SIZE		0x1000
 #define NX_HDMI_HPD_STATUS		0x000c
-#define NX_HDMI_HPD			0x0044
 
 /* MLC.0 (multi-layer controller feeding DPC.0). */
 #define NX_MLC0_BASE			0xc0102000
@@ -41,148 +53,61 @@
 /* Fixed mode = what u-boot set (MLC screensize reg reads 0x02cf04ff). */
 #define FB_W				1280
 #define FB_H				720
-#define FB_BPP				4
-#define FB_STRIDE			(FB_W * FB_BPP)
-#define FB_SIZE				(FB_STRIDE * FB_H)
 
-struct nx_display {
-	struct device *dev;
+struct nx_drm {
+	struct drm_device drm;
 	void __iomem *clk_spdif;
 	void __iomem *clk_vclk;
 	void __iomem *hdmi_ctrl;
 	void __iomem *mlc;
-	void *fb_cpu;
-	dma_addr_t fb_dma;
-	struct fb_info *fb_info;
+	struct drm_simple_display_pipe pipe;
+	struct drm_connector conn;
 };
 
-/* Eight vertical colour bars (SMPTE-ish), XRGB8888 (0x00RRGGBB). */
-static void nx_fill_bars(u32 *fb)
-{
-	static const u32 bars[8] = {
-		0x00ffffff, 0x00ffff00, 0x0000ffff, 0x0000ff00,
-		0x00ff00ff, 0x00ff0000, 0x000000ff, 0x00000000,
-	};
-	int x, y;
-
-	for (y = 0; y < FB_H; y++)
-		for (x = 0; x < FB_W; x++)
-			fb[y * FB_W + x] = bars[(x * 8) / FB_W];
-}
-
-static int nx_fb_setcolreg(unsigned int regno, unsigned int red,
-			   unsigned int green, unsigned int blue,
-			   unsigned int transp, struct fb_info *info)
-{
-	u32 *pal = info->pseudo_palette;
-
-	if (regno >= 16)
-		return -EINVAL;
-	/* 16-bit components -> X8R8G8B8 */
-	pal[regno] = ((red   >> 8) << 16) |
-		     ((green >> 8) <<  8) |
-		     ((blue  >> 8));
-	return 0;
-}
+#define pipe_to_nx(p)	container_of(p, struct nx_drm, pipe)
 
-static const struct fb_ops nx_fb_ops = {
-	.owner		= THIS_MODULE,
-	.fb_setcolreg	= nx_fb_setcolreg,
-	.fb_fillrect	= cfb_fillrect,
-	.fb_copyarea	= cfb_copyarea,
-	.fb_imageblit	= cfb_imageblit,
-};
+/* ---- connector: fixed 720p HDMI (u-boot's mode) ---- */
 
-static int nx_register_fb(struct nx_display *nx)
+static int nx_conn_get_modes(struct drm_connector *conn)
 {
-	struct fb_info *info;
-	int ret;
-
-	info = framebuffer_alloc(16 * sizeof(u32), nx->dev);
-	if (!info)
-		return -ENOMEM;
+	int n = drm_add_modes_noedid(conn, FB_W, FB_H);
 
-	nx->fb_info = info;
-	info->pseudo_palette = info->par;
-	info->screen_base = nx->fb_cpu;
-	info->screen_size = FB_SIZE;
-	info->fbops = &nx_fb_ops;
-
-	strscpy(info->fix.id, "nexell", sizeof(info->fix.id));
-	info->fix.type = FB_TYPE_PACKED_PIXELS;
-	info->fix.visual = FB_VISUAL_TRUECOLOR;
-	info->fix.smem_start = nx->fb_dma;
-	info->fix.smem_len = FB_SIZE;
-	info->fix.line_length = FB_STRIDE;
-
-	info->var.xres = FB_W;
-	info->var.yres = FB_H;
-	info->var.xres_virtual = FB_W;
-	info->var.yres_virtual = FB_H;
-	info->var.bits_per_pixel = 32;
-	info->var.activate = FB_ACTIVATE_NOW;
-	info->var.red   = (struct fb_bitfield){ 16, 8, 0 };
-	info->var.green = (struct fb_bitfield){  8, 8, 0 };
-	info->var.blue  = (struct fb_bitfield){  0, 8, 0 };
-	info->var.transp = (struct fb_bitfield){ 0, 0, 0 };
-
-	ret = register_framebuffer(info);
-	if (ret) {
-		framebuffer_release(info);
-		nx->fb_info = NULL;
-		return ret;
-	}
-	return 0;
+	drm_set_preferred_mode(conn, FB_W, FB_H);
+	return n;
 }
 
-static int nx_display_probe(struct platform_device *pdev)
-{
-	struct device *dev = &pdev->dev;
-	struct nx_display *nx;
-	u32 hpd_status, hpd;
-	int ret;
-
-	nx = devm_kzalloc(dev, sizeof(*nx), GFP_KERNEL);
-	if (!nx)
-		return -ENOMEM;
-	nx->dev = dev;
+static const struct drm_connector_helper_funcs nx_conn_helper_funcs = {
+	.get_modes = nx_conn_get_modes,
+};
 
-	nx->clk_spdif = devm_ioremap(dev, NX_DISPTOP_CLKGEN_HDMI_SPDIF, 0x100);
-	nx->clk_vclk  = devm_ioremap(dev, NX_DISPTOP_CLKGEN_HDMI_VCLK, 0x100);
-	nx->hdmi_ctrl = devm_ioremap(dev, NX_HDMI_CTRL_BASE, NX_HDMI_CTRL_SIZE);
-	nx->mlc       = devm_ioremap(dev, NX_MLC0_BASE, NX_MLC0_SIZE);
-	if (!nx->clk_spdif || !nx->clk_vclk || !nx->hdmi_ctrl || !nx->mlc)
-		return -ENOMEM;
+static const struct drm_connector_funcs nx_conn_funcs = {
+	.reset = drm_atomic_helper_connector_reset,
+	.fill_modes = drm_helper_probe_single_connector_modes,
+	.destroy = drm_connector_cleanup,
+	.atomic_duplicate_state = drm_atomic_helper_connector_duplicate_state,
+	.atomic_destroy_state = drm_atomic_helper_connector_destroy_state,
+};
 
-	/* Ungate the HDMI display clocks (phase 1). */
-	writel(NX_CLKGEN_ON, nx->clk_spdif);
-	writel(NX_CLKGEN_ON, nx->clk_vclk);
+/* ---- plane/CRTC = MLC.0 RGB layer 0 ---- */
 
-	hpd_status = readl(nx->hdmi_ctrl + NX_HDMI_HPD_STATUS);
-	hpd	   = readl(nx->hdmi_ctrl + NX_HDMI_HPD);
-	dev_info(dev,
-		 "HDMI clocks enabled; HPD_STATUS=0x%08x HPD=0x%08x -> monitor %s\n",
-		 hpd_status, hpd,
-		 (hpd_status & 1) ? "CONNECTED" : "not detected");
+static void nx_pipe_enable(struct drm_simple_display_pipe *pipe,
+			   struct drm_crtc_state *crtc_state,
+			   struct drm_plane_state *plane_state)
+{
+	struct nx_drm *nx = pipe_to_nx(pipe);
+	struct drm_gem_dma_object *gem;
+	u32 addr = 0;
 
-	/* Framebuffer. */
-	if (dma_set_mask_and_coherent(dev, DMA_BIT_MASK(32))) {
-		dev_err(dev, "no 32-bit DMA\n");
-		return -ENODEV;
+	if (plane_state->fb) {
+		gem = drm_fb_dma_get_gem_obj(plane_state->fb, 0);
+		addr = (u32)gem->dma_addr;
 	}
-	nx->fb_cpu = dma_alloc_coherent(dev, FB_SIZE, &nx->fb_dma, GFP_KERNEL);
-	if (!nx->fb_cpu) {
-		dev_err(dev, "framebuffer alloc (%d bytes) failed\n", FB_SIZE);
-		return -ENOMEM;
-	}
-	nx_fill_bars(nx->fb_cpu);
-	dev_info(dev, "framebuffer %dx%d @ dma 0x%08x (%d bytes)\n",
-		 FB_W, FB_H, (u32)nx->fb_dma, FB_SIZE);
 
-	/* Drive MLC.0 RGB layer 0 over our framebuffer (phase 2). */
 	nx_mlc_set_base_address(0, nx->mlc);
-	nx_mlc_set_layer_enable(0, 1, 0);	/* kill the u-boot layer */
+	/* turn off whatever layer u-boot left running (stale RAM = noise) */
+	nx_mlc_set_layer_enable(0, 1, 0);
 	nx_mlc_set_dirty_flag(0, 1);
+
 	nx_mlc_set_screen_size(0, FB_W, FB_H);
 	nx_mlc_set_layer_priority(0, nx_mlc_priority_videofirst);
 	nx_mlc_set_lock_size(0, 0, 16);
@@ -192,38 +117,147 @@ static int nx_display_probe(struct platform_device *pdev)
 	nx_mlc_set_position(0, 0, 0, 0, FB_W - 1, FB_H - 1);
 	nx_mlc_set_rgblayer_invalid_position(0, 0, 0, 0, 0, 0, 0, 0);
 	nx_mlc_set_rgblayer_invalid_position(0, 0, 1, 0, 0, 0, 0, 0);
-	nx_mlc_set_rgblayer_stride(0, 0, FB_BPP, FB_STRIDE);
-	nx_mlc_set_rgblayer_address(0, 0, (u32)nx->fb_dma);
+	nx_mlc_set_rgblayer_stride(0, 0, 4, FB_W * 4);
+	nx_mlc_set_rgblayer_address(0, 0, addr);
 	nx_mlc_set_layer_enable(0, 0, 1);
 	nx_mlc_set_dirty_flag(0, 0);
 	nx_mlc_set_top_dirty_flag(0);
+}
+
+static void nx_pipe_disable(struct drm_simple_display_pipe *pipe)
+{
+	nx_mlc_set_layer_enable(0, 0, 0);
+	nx_mlc_set_dirty_flag(0, 0);
+	nx_mlc_set_top_dirty_flag(0);
+}
+
+static void nx_pipe_update(struct drm_simple_display_pipe *pipe,
+			   struct drm_plane_state *old_state)
+{
+	struct drm_framebuffer *fb = pipe->plane.state->fb;
+	struct drm_gem_dma_object *gem;
+
+	if (!fb)
+		return;
+	gem = drm_fb_dma_get_gem_obj(fb, 0);
+	nx_mlc_set_rgblayer_address(0, 0, (u32)gem->dma_addr);
+	nx_mlc_set_dirty_flag(0, 0);
+	nx_mlc_set_top_dirty_flag(0);
+}
+
+static const struct drm_simple_display_pipe_funcs nx_pipe_funcs = {
+	.enable = nx_pipe_enable,
+	.disable = nx_pipe_disable,
+	.update = nx_pipe_update,
+};
+
+static const uint32_t nx_formats[] = {
+	DRM_FORMAT_XRGB8888,
+};
+
+static const struct drm_mode_config_funcs nx_modecfg_funcs = {
+	.fb_create = drm_gem_fb_create,
+	.atomic_check = drm_atomic_helper_check,
+	.atomic_commit = drm_atomic_helper_commit,
+};
+
+DEFINE_DRM_GEM_DMA_FOPS(nx_drm_fops);
+
+static const struct drm_driver nx_drm_driver = {
+	.driver_features = DRIVER_MODESET | DRIVER_GEM | DRIVER_ATOMIC,
+	.name = "nexell",
+	.desc = "Nexell S5P6818 display",
+	.major = 1,
+	.minor = 0,
+	.fops = &nx_drm_fops,
+	DRM_GEM_DMA_DRIVER_OPS,
+	DRM_FBDEV_DMA_DRIVER_OPS,
+};
+
+static int nx_load(struct nx_drm *nx)
+{
+	struct drm_device *drm = &nx->drm;
+	u32 hpd;
+	int ret;
+
+	nx->clk_spdif = devm_ioremap(drm->dev, NX_DISPTOP_CLKGEN_HDMI_SPDIF, 0x100);
+	nx->clk_vclk  = devm_ioremap(drm->dev, NX_DISPTOP_CLKGEN_HDMI_VCLK, 0x100);
+	nx->hdmi_ctrl = devm_ioremap(drm->dev, NX_HDMI_CTRL_BASE, NX_HDMI_CTRL_SIZE);
+	nx->mlc       = devm_ioremap(drm->dev, NX_MLC0_BASE, NX_MLC0_SIZE);
+	if (!nx->clk_spdif || !nx->clk_vclk || !nx->hdmi_ctrl || !nx->mlc)
+		return -ENOMEM;
+
+	/*
+	 * Register the MLC base with the soc layer now: the simple-pipe helper
+	 * can call .update (which touches MLC) before .enable on the first
+	 * modeset, so the base must be live before any pipe callback runs.
+	 */
+	nx_mlc_set_base_address(0, nx->mlc);
+
+	/* Ungate the HDMI display clocks. */
+	writel(NX_CLKGEN_ON, nx->clk_spdif);
+	writel(NX_CLKGEN_ON, nx->clk_vclk);
+	hpd = readl(nx->hdmi_ctrl + NX_HDMI_HPD_STATUS);
+	dev_info(drm->dev, "HDMI clocks enabled; monitor %s\n",
+		 (hpd & 1) ? "CONNECTED" : "not detected");
+
+	if (dma_set_mask_and_coherent(drm->dev, DMA_BIT_MASK(32)))
+		return -ENODEV;
 
-	/* Expose it as an fbdev so the console (and a getty login) appear. */
-	ret = nx_register_fb(nx);
-	if (ret) {
-		dev_err(dev, "register_framebuffer failed (%d)\n", ret);
-		dma_free_coherent(dev, FB_SIZE, nx->fb_cpu, nx->fb_dma);
+	ret = drmm_mode_config_init(drm);
+	if (ret)
 		return ret;
-	}
-	dev_info(dev, "fb%d registered: %dx%d-32 framebuffer console on HDMI\n",
-		 nx->fb_info->node, FB_W, FB_H);
+	drm->mode_config.min_width = 0;
+	drm->mode_config.min_height = 0;
+	drm->mode_config.max_width = FB_W;
+	drm->mode_config.max_height = FB_H;
+	drm->mode_config.funcs = &nx_modecfg_funcs;
+
+	drm_connector_helper_add(&nx->conn, &nx_conn_helper_funcs);
+	ret = drm_connector_init(drm, &nx->conn, &nx_conn_funcs,
+				 DRM_MODE_CONNECTOR_HDMIA);
+	if (ret)
+		return ret;
+
+	ret = drm_simple_display_pipe_init(drm, &nx->pipe, &nx_pipe_funcs,
+					   nx_formats, ARRAY_SIZE(nx_formats),
+					   NULL, &nx->conn);
+	if (ret)
+		return ret;
+
+	drm_mode_config_reset(drm);
+	drm_kms_helper_poll_init(drm);
+	return 0;
+}
 
-	platform_set_drvdata(pdev, nx);
+static int nx_display_probe(struct platform_device *pdev)
+{
+	struct nx_drm *nx;
+	int ret;
+
+	nx = devm_drm_dev_alloc(&pdev->dev, &nx_drm_driver, struct nx_drm, drm);
+	if (IS_ERR(nx))
+		return PTR_ERR(nx);
+
+	ret = nx_load(nx);
+	if (ret)
+		return ret;
+
+	ret = drm_dev_register(&nx->drm, 0);
+	if (ret)
+		return ret;
+
+	drm_client_setup_with_fourcc(&nx->drm, DRM_FORMAT_XRGB8888);
+	platform_set_drvdata(pdev, &nx->drm);
 	return 0;
 }
 
 static void nx_display_remove(struct platform_device *pdev)
 {
-	struct nx_display *nx = platform_get_drvdata(pdev);
+	struct drm_device *drm = platform_get_drvdata(pdev);
 
-	if (!nx)
-		return;
-	if (nx->fb_info) {
-		unregister_framebuffer(nx->fb_info);
-		framebuffer_release(nx->fb_info);
-	}
-	if (nx->fb_cpu)
-		dma_free_coherent(nx->dev, FB_SIZE, nx->fb_cpu, nx->fb_dma);
+	drm_dev_unregister(drm);
+	drm_atomic_helper_shutdown(drm);
 }
 
 static const struct of_device_id nx_display_of_match[] = {
@@ -242,5 +276,5 @@ static struct platform_driver nx_display_driver = {
 };
 module_platform_driver(nx_display_driver);
 
-MODULE_DESCRIPTION("Nexell S5P6818 display/HDMI bring-up driver");
+MODULE_DESCRIPTION("Nexell S5P6818 display/HDMI atomic-KMS driver");
