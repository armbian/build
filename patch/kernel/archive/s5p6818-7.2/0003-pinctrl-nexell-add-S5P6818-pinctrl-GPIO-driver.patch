+#define IO_LOCK_INIT(x) spin_lock_init(&lock[x])
+#define IO_LOCK(x) spin_lock_irqsave(&lock[x], lock_flags[x])
+#define IO_UNLOCK(x) spin_unlock_irqrestore(&lock[x], lock_flags[x])
