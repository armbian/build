 #define pipe_to_nx(p)	container_of(p, struct nx_drm, pipe)
@@ -106,6 +114,103 @@ static const struct drm_connector_funcs nx_conn_funcs = {
 	.atomic_destroy_state = drm_atomic_helper_connector_destroy_state,
 };
 
+/* ---- SoC HDMI/DPC self-programming ---- */
+
+/* DISPLAYTOP clkgen module physical bases (index 0..4). */
+static const u32 nx_clkgen_phys[5] = {
+	0xc0106000, 0xc0107000, 0xc0105000, 0xc0108000, 0xc0109000,
+};
+
+/* One-time SoC-layer base + reset + dp_output setup. */
+static int nx_hdmi_setup(struct nx_drm *nx)
+{
+	struct device *dev = nx->drm.dev;
+	struct dp_control_dev *dpc = &nx->nxdev.ctrl.dpc;
+	void __iomem *base;
+	int i;
+
+	nx->nxdev.dev = dev;
+
+	/* DISPLAYTOP + DPC.0 register bases (MLC.0 base set in probe). */
+	base = devm_ioremap(dev, 0xc0100000, 0x1000);
+	if (!base)
+		return -ENOMEM;
+	nx_soc_dp_cont_top_base(0, base);
+
+	base = devm_ioremap(dev, 0xc0102800, 0x1000);	/* DPC.0 */
+	if (!base)
+		return -ENOMEM;
+	nx_soc_dp_cont_dpc_base(0, base);
+
+	nx_soc_dp_cont_mlc_base(0, nx->mlc);
+
+	/* DISPLAYTOP clkgen module bases. */
+	for (i = 0; i < 5; i++) {
+		base = devm_ioremap(dev, nx_clkgen_phys[i], 0x100);
+		if (!base)
+			return -ENOMEM;
+		nx_soc_dp_cont_top_clk_base(i, base);
+	}
+
+	/* HDMI register window (macros add 0x200000/0x210000/0xf0000). */
+	nx->nxdev.res.dev_bases[0] = devm_ioremap(dev, 0xc0000000, 0x300000);
+	if (!nx->nxdev.res.dev_bases[0])
+		return -ENOMEM;
+	nx->nxdev.res.num_devs = 1;
+
+	/* HDMI resets: hdmi, video, spdif, tmds, phy (phy last, skipped by
+	 * hdmi_reset and pulsed by the PHY programming). */
+	for (i = 0; i < 5; i++) {
+		struct reset_control *rc =
+			devm_reset_control_get_exclusive_by_index(dev, i);
+		if (IS_ERR(rc))
+			return PTR_ERR(rc);
+		nx->nxdev.res.dev_resets[i] = rc;
+	}
+	nx->nxdev.res.num_dev_resets = 5;
+
+	dpc->module = 0;
+	if (nx_dp_device_hdmi_register(dev, NULL, dpc))
+		return -ENOMEM;
+
+	/* Latch the HDMI register base + enable HPD interrupt. */
+	dpc->ops->set_base(dpc, nx->nxdev.res.dev_bases,
+			   nx->nxdev.res.num_devs);
+	return 0;
+}
+
+/* Program the DPC timing + HDMI PHY/Link for a mode (independent of u-boot). */
+static void nx_hdmi_set_mode(struct nx_drm *nx,
+			     const struct drm_display_mode *in)
+{
+	struct dp_control_dev *dpc = &nx->nxdev.ctrl.dpc;
+	struct dp_sync_info *sync = &dpc->sync;
+	struct drm_display_mode mode = *in;	/* mode_set mutates it */
+
+	/* Pick + program the HDMI preset (also fills dpc->ctrl). */
+	if (nx_dp_hdmi_mode_set(&nx->nxdev, &mode, false, 0))
+		return;
+
+	/* Fill the DPC sync from the (now preset) timing. */
+	sync->h_active_len  = mode.hdisplay;
+	sync->h_sync_width  = mode.hsync_end - mode.hsync_start;
+	sync->h_back_porch  = mode.htotal - mode.hsync_end;
+	sync->h_front_porch = mode.hsync_start - mode.hdisplay;
+	sync->h_sync_invert = !(mode.flags & DRM_MODE_FLAG_PHSYNC);
+	sync->v_active_len  = mode.vdisplay;
+	sync->v_sync_width  = mode.vsync_end - mode.vsync_start;
+	sync->v_back_porch  = mode.vtotal - mode.vsync_end;
+	sync->v_front_porch = mode.vsync_start - mode.vdisplay;
+	sync->v_sync_invert = !(mode.flags & DRM_MODE_FLAG_PVSYNC);
+	sync->pixel_clock_hz = mode.clock * 1000;
+	sync->interlace = 0;
+
+	nx_soc_dp_cont_prepare(dpc);		/* DPC timing */
+	nx_dp_hdmi_mode_commit(&nx->nxdev, 0);	/* HDMI PHY + Link */
+	nx_soc_dp_cont_power_on(dpc, true);	/* DPC enable */
+	nx_dp_hdmi_power(&nx->nxdev, true);	/* HDMI enable */
+}
+
 /* ---- plane/CRTC = MLC.0 RGB layer 0 ---- */
 
 static void nx_pipe_enable(struct drm_simple_display_pipe *pipe,
@@ -121,6 +226,10 @@ static void nx_pipe_enable(struct drm_simple_display_pipe *pipe,
 		addr = (u32)gem->dma_addr;
 	}
 
+	/* Programme the DPC timing + HDMI PHY for this mode ourselves. */
+	if (nx->hdmi_ready)
+		nx_hdmi_set_mode(nx, &crtc_state->adjusted_mode);
+
 	nx_mlc_set_base_address(0, nx->mlc);
 	/* turn off whatever layer u-boot left running (stale RAM = noise) */
 	nx_mlc_set_layer_enable(0, 1, 0);
@@ -167,12 +276,13 @@ static enum drm_mode_status
 nx_pipe_mode_valid(struct drm_simple_display_pipe *pipe,
 		   const struct drm_display_mode *mode)
 {
-	/*
-	 * Output currently rides on the fixed 1280x720 pipeline the bootloader
-	 * programmed (HDMI PHY + DPC). Until the driver programmes the DPC
-	 * timing and HDMI PHY preset itself, only that mode actually works, so
-	 * reject everything else even though EDID may advertise more.
-	 */
+	struct nx_drm *nx = pipe_to_nx(pipe);
+
+	/* With self-programming, accept any mode the HDMI presets support. */
+	if (nx->hdmi_ready)
+		return nx_dp_hdmi_mode_valid(mode) ? MODE_OK : MODE_BAD;
+
+	/* Otherwise only the bootloader-programmed fixed mode works. */
 	if (mode->hdisplay == FB_W && mode->vdisplay == FB_H)
 		return MODE_OK;
 	return MODE_BAD;
@@ -239,6 +349,14 @@ static int nx_load(struct nx_drm *nx)
 	if (dma_set_mask_and_coherent(drm->dev, DMA_BIT_MASK(32)))
 		return -ENODEV;
 
+	/* Set up the SoC HDMI/DPC layer so we can programme modes ourselves.
+	 * Non-fatal: on failure we keep riding the bootloader-programmed mode. */
+	if (nx_hdmi_setup(nx) == 0)
+		nx->hdmi_ready = true;
+	else
+		dev_warn(drm->dev,
+			 "HDMI self-programming unavailable; using bootloader mode\n");
+
 	ret = drmm_mode_config_init(drm);
 	if (ret)
 		return ret;
