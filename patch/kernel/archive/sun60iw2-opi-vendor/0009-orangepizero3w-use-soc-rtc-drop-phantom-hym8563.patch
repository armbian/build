From f73bf448485333b006666938d97d9c9118e151c0 Mon Sep 17 00:00:00 2001
From: Periqles <periqlesfpv@gmail.com>
Date: Mon, 31 Aug 2026 10:31:26 +0000
Subject: [PATCH] arm64: dts: orangepizero3w: use the SoC RTC, drop the phantom
 hym8563

The board device tree enables an external hym8563 RTC on s_twi2 that is
not populated on the Orange Pi Zero 3W (the schematic has no external
RTC; only the SoC's VCC-RTC domain), while the SoC's own working RTC
(allwinner,rtc-v201 at 0x7090000, driver already built in as
CONFIG_AW_RTC) is explicitly disabled.

Every boot therefore starts with 1970 plus a probe error:
  rtc-hym8563 15-0051: could not init device, -22
and the system clock is wrong until NTP syncs, which among other things
breaks apt ('Release file ... not valid yet') on freshly booted boards.

Swap the two: enable the SoC RTC, disable the phantom external one.

Verified on Orange Pi Zero 3W: /dev/rtc0 registers (sunxi-rtc), time
set before a reboot is correctly held and advanced across the reboot,
and the hym8563 probe error is gone.

Signed-off-by: Periqles <periqlesfpv@gmail.com>
---
 .../boot/dts/allwinner/sun60i-a733-orangepi-zero3w.dts     | 7 +++----
 1 file changed, 3 insertions(+), 4 deletions(-)

diff --git a/arch/arm64/boot/dts/allwinner/sun60i-a733-orangepi-zero3w.dts b/arch/arm64/boot/dts/allwinner/sun60i-a733-orangepi-zero3w.dts
index 258878289..94a895518 100644
--- a/arch/arm64/boot/dts/allwinner/sun60i-a733-orangepi-zero3w.dts
+++ b/arch/arm64/boot/dts/allwinner/sun60i-a733-orangepi-zero3w.dts
@@ -2561,9 +2561,9 @@ virtual-dc1sw2 {
 	};
 };
 
-/*Disable soc rtc*/
+/* SoC RTC (rtc-v201): the working on-die RTC for this board */
 &rtc {
-	status = "disabled";
+	status = "okay";
 };
 
 &s_twi1 {
@@ -2674,7 +2674,7 @@ rtc@51 {
  		clock-output-names = "xin32k";
  		//interrupt-parent = <&pio>;
  		//interrupts = <PD 6 IRQ_TYPE_NONE>;
-		status = "okay";
+		status = "disabled";
  	};
 
 	ac101: ac101@1a {
@@ -4097,4 +4097,3 @@ &ufs {
 	vccq2-supply = <&reg_dcdc8>;
 	status = "okay";
 };
-
