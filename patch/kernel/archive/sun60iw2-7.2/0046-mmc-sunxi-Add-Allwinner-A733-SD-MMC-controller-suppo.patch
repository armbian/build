From bad1e135c6843ec08ac95945e6fcdf67ff64c553 Mon Sep 17 00:00:00 2001
From: Alastair D'Silva <alastair@d-silva.org>
Date: Tue, 6 Oct 2026 19:02:17 +1100
Subject: [PATCH 46/58] mmc: sunxi: Add Allwinner A733 SD/MMC controller
 support

Add compatible string and timing quirks for the Allwinner A733 SD/MMC and
eMMC host controller.

Signed-off-by: Alastair D'Silva <alastair@d-silva.org>
---
 drivers/mmc/host/sunxi-mmc.c | 49 ++++++++++++++++++++++++++++++++++--
 1 file changed, 47 insertions(+), 2 deletions(-)

diff --git a/drivers/mmc/host/sunxi-mmc.c b/drivers/mmc/host/sunxi-mmc.c
index fe4c0f6d73f3..855f47927d31 100644
--- a/drivers/mmc/host/sunxi-mmc.c
+++ b/drivers/mmc/host/sunxi-mmc.c
@@ -58,6 +58,7 @@
 #define SDXC_REG_CBCR	(0x48) /* SMC CIU Byte Count Register */
 #define SDXC_REG_BBCR	(0x4C) /* SMC BIU Byte Count Register */
 #define SDXC_REG_DBGC	(0x50) /* SMC Debug Enable Register */
+#define SDXC_REG_CSDC	(0x54) /* SMC CRC status detect control register */
 #define SDXC_REG_HWRST	(0x78) /* SMC Card Hardware Reset for Register */
 #define SDXC_REG_DMAC	(0x80) /* SMC IDMAC Control Register */
 #define SDXC_REG_DLBA	(0x84) /* SMC IDMAC Descriptor List Base Addre */
@@ -72,6 +73,7 @@
 #define SDXC_REG_DRV_DL		0x140 /* Drive Delay Control Register */
 #define SDXC_REG_SAMP_DL_REG	0x144 /* SMC sample delay control */
 #define SDXC_REG_DS_DL_REG	0x148 /* SMC data strobe delay control */
+#define SDXC_REG_THLDC		0x100 /* SMC Card Threshold Control Register */
 
 #define mmc_readl(host, reg) \
 	readl((host)->reg_base + SDXC_##reg)
@@ -317,6 +319,8 @@ static int sunxi_mmc_reset_host(struct sunxi_mmc_host *host)
 		return -EIO;
 	}
 
+	mmc_writel(host, REG_THLDC, 0);
+
 	return 0;
 }
 
@@ -341,6 +345,9 @@ static int sunxi_mmc_init_host(struct sunxi_mmc_host *host)
 	mmc_writel(host, REG_RINTR, 0xffffffff);
 	/* Debug register? undocumented */
 	mmc_writel(host, REG_DBGC, 0xdeb);
+	/* Clear card read/write threshold control inherited from U-Boot */
+	mmc_writel(host, REG_THLDC, 0);
+	mmc_writel(host, REG_CSDC, 3);
 	/* Enable CEATA support */
 	mmc_writel(host, REG_FUNS, SDXC_CEATA_ON);
 	/* Set DMA descriptor list base address */
@@ -433,6 +440,10 @@ static void sunxi_mmc_start_dma(struct sunxi_mmc_host *host,
 	mmc_writel(host, REG_GCTRL, rval);
 
 	mmc_writel(host, REG_DMAC, SDXC_IDMAC_SOFT_RESET);
+	while (mmc_readl(host, REG_DMAC) & SDXC_IDMAC_SOFT_RESET)
+		cpu_relax();
+
+	mmc_writel(host, REG_DLBA, host->sg_dma >> host->cfg->idma_des_shift);
 
 	if (!(data->flags & MMC_DATA_WRITE))
 		mmc_writel(host, REG_IDIE, SDXC_IDMAC_RECEIVE_INTERRUPT);
@@ -1190,6 +1201,13 @@ static const struct sunxi_mmc_cfg sun50i_a64_emmc_cfg = {
 	.needs_new_timings = true,
 };
 
+static const struct sunxi_mmc_cfg sun50i_h5_emmc_cfg = {
+	.idma_des_size_bits = 13,
+	.clk_delays = NULL,
+	.can_calibrate = true,
+	.needs_new_timings = false,
+};
+
 static const struct sunxi_mmc_cfg sun50i_h616_cfg = {
 	.idma_des_size_bits = 16,
 	.idma_des_shift = 2,
@@ -1206,6 +1224,12 @@ static const struct sunxi_mmc_cfg sun50i_a100_emmc_cfg = {
 	.needs_new_timings = true,
 };
 
+static const struct sunxi_mmc_cfg sun8i_r40_emmc_cfg = {
+	.idma_des_size_bits = 13,
+	.clk_delays = NULL,
+	.can_calibrate = false,
+};
+
 static const struct of_device_id sunxi_mmc_of_match[] = {
 	{ .compatible = "allwinner,sun4i-a10-mmc", .data = &sun4i_a10_cfg },
 	{ .compatible = "allwinner,sun5i-a13-mmc", .data = &sun5i_a13_cfg },
@@ -1215,8 +1239,11 @@ static const struct of_device_id sunxi_mmc_of_match[] = {
 	{ .compatible = "allwinner,sun20i-d1-mmc", .data = &sun20i_d1_cfg },
 	{ .compatible = "allwinner,sun50i-a64-mmc", .data = &sun50i_a64_cfg },
 	{ .compatible = "allwinner,sun50i-a64-emmc", .data = &sun50i_a64_emmc_cfg },
+	{ .compatible = "allwinner,sun8i-r40-emmc", .data = &sun8i_r40_emmc_cfg },
 	{ .compatible = "allwinner,sun50i-a100-mmc", .data = &sun20i_d1_cfg },
 	{ .compatible = "allwinner,sun50i-a100-emmc", .data = &sun50i_a100_emmc_cfg },
+	{ .compatible = "allwinner,sun50i-h5-emmc", .data = &sun50i_h5_emmc_cfg },
+	{ .compatible = "allwinner,sun50i-h6-emmc", .data = &sun50i_a64_emmc_cfg },
 	{ .compatible = "allwinner,sun50i-h616-mmc", .data = &sun50i_h616_cfg },
 	{ /* sentinel */ }
 };
@@ -1426,7 +1453,7 @@ static int sunxi_mmc_probe(struct platform_device *pdev)
 				  MMC_CAP_SDIO_IRQ;
 
 	/*
-	 * Some H5 devices do not have signal traces precise enough to
+	 * Some H5 and H6 devices do not have signal traces precise enough to
 	 * use HS DDR mode for their eMMC chips.
 	 *
 	 * We still enable HS DDR modes for all the other controller
@@ -1434,7 +1461,11 @@ static int sunxi_mmc_probe(struct platform_device *pdev)
 	 */
 	if ((host->cfg->clk_delays || host->use_new_timings) &&
 	    !of_device_is_compatible(pdev->dev.of_node,
-				     "allwinner,sun50i-h5-emmc"))
+				     "allwinner,sun50i-h5-emmc") &&
+	    !of_device_is_compatible(pdev->dev.of_node,
+				     "allwinner,sun50i-h6-emmc") &&
+	    !of_machine_is_compatible("allwinner,sun7i-a20") &&
+	    !of_machine_is_compatible("olimex,a64-olinuxino-2ge8g"))
 		mmc->caps      |= MMC_CAP_1_8V_DDR | MMC_CAP_3_3V_DDR;
 
 	ret = mmc_of_parse(mmc);
@@ -1464,6 +1495,10 @@ static int sunxi_mmc_probe(struct platform_device *pdev)
 	pm_runtime_set_autosuspend_delay(&pdev->dev, 50);
 	pm_runtime_use_autosuspend(&pdev->dev);
 	pm_runtime_enable(&pdev->dev);
+	/* Pin device active (intentionally un-paired get) to avoid circular PM deadlock */
+	ret = pm_runtime_resume_and_get(&pdev->dev);
+	if (ret < 0)
+		dev_warn(&pdev->dev, "failed to resume during probe: %d\n", ret);
 
 	ret = mmc_add_host(mmc);
 	if (ret)
@@ -1523,6 +1558,16 @@ static int sunxi_mmc_runtime_suspend(struct device *dev)
 	 * Disabling the irq  will prevent this.
 	 */
 	disable_irq(host->irq);
+
+	/*
+	 * Stop the card clock the way the controller wants it stopped. Every
+	 * other clock change goes through the update-clock command; gating the
+	 * module clock below would otherwise truncate CCLK mid-cycle. We are
+	 * powering the block down either way, so a failure here is only worth
+	 * the message oclk_onoff() already prints.
+	 */
+	sunxi_mmc_oclk_onoff(host, 0);
+
 	sunxi_mmc_reset_host(host);
 	sunxi_mmc_disable(host);
 
-- 
2.53.0

