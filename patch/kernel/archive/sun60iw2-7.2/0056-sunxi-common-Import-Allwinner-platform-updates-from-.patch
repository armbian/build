 	}
 
 	ret = sun6i_csi_bridge_setup(csi_dev);
@@ -357,6 +1112,10 @@ static int sun6i_csi_probe(struct platform_device *platform_dev)
 		ret = sun6i_csi_capture_setup(csi_dev);
 		if (ret)
 			goto error_bridge;
+
+		ret = sun6i_csi_pattern_complete(csi_dev);
