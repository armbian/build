+		.left = GC2145_ACTIVE_LEFT,
+		.top = GC2145_ACTIVE_TOP,
+		.width = GC2145_SENSOR_WIDTH_MAX,
+		.height = GC2145_SENSOR_HEIGHT_MAX,
