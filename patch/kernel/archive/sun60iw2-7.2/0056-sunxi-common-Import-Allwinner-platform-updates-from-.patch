+	0x21, 0x01, 0x00,
+	0x30, 0x01, 0x08,
+	0x31, 0x01, 0x03,
+	0x33, 0x04, 0x04, 0x03, 0x02, 0x01,
+	0x54, 0x01, 0x06,
+	0x50, 0x01, 0x02,
+	0x5B, 0x01, 0x00,
+	0x60, 0x01, 0x0E,
+	0x80, 0x01, 0x01,
+	0x81, 0x01, 0x01,
+	0x82, 0x01, 0x0E,
+	0x18, 0x01, 0x01,
+};
+
+/* NXP_NFC_PROFILE_EXTN - CORE_SET_CONFIG payload: select NFC Forum profile */
+static const __u8 nxp_nci_nfc_profile_extn[] = {
+	0x01,
+	0xA0, 0x44, 0x01, 0x00,
+};
