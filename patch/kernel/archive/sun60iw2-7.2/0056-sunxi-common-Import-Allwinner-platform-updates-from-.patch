+static ssize_t sun55i_iommu_map_show(struct device *dev,
+                       struct device_attribute *attr, char *buf)
+{
+    struct sunxi_iommu_dev *iommu = dev_get_drvdata(dev);
+    
+    if (!iommu)
+        return -ENODEV;
+
+    return sun55i_iommu_dump_pgtable(iommu, buf, PAGE_SIZE, true);
