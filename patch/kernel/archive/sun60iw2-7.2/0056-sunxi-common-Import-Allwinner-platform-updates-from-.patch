+	unsigned int num_sel;
+
+	struct rkisp1_buffer *curr;
+	struct rkisp1_addata_hdr *curr_hdr;
+	u8 *curr_data;
+	u32 curr_len;
+	u32 curr_flags;
+	u32 curr_dropped;
