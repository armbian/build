+
+       regmap_update_bits(regmap, SUNXI_AHUB_I2S_CLKD(tdm_num),
+                          0xf << I2S_CLKD_BCLKDIV,
+                          bclk_ratio << I2S_CLKD_BCLKDIV);
+
+       return 0;
