+
+static int ac100_codec_analog_cmpnt_probe(struct snd_soc_component *component)
+{
+	int ret;
+
+	/*
+	 * The internal oscillator clocks the charge pump and the jack
+	 * detection circuit when no audio clock is running; without it
+	 * the HMIC ADC never samples on an idle system.
+	 */
+	ret = snd_soc_component_update_bits(component, AC100_ADDA_TUNE3,
+					    AC100_ADDA_TUNE3_OSC_EN_MASK,
+					    AC100_ADDA_TUNE3_OSC_EN_ENABLED);
+	if (ret < 0)
+		return ret;
+
+	/*
+	 * The jack and button detection thresholds are proportional to
+	 * the headset bias voltage; the values used by the digital side
+	 * were validated at 2.5V, so that is the default. The "Mic2 Bias
+	 * Voltage" control can still lower it, at the cost of detection
+	 * accuracy.
+	 */
+	ret = snd_soc_component_update_bits(component, AC100_OUT_MXR_SRC_BST,
+					    AC100_OUT_MXR_SRC_BST_HMICBIAS_VOLTAGE_MASK,
+					    AC100_OUT_MXR_SRC_BST_HMICBIAS_VOLTAGE_2_50V);
+	if (ret < 0)
+		return ret;
+
+	/*
+	 * The headset bias and its current sense ADC are the jack
+	 * detection sensor, so they are armed here, statically, and not
+	 * from DAPM: a register-backed widget would be cleared by the
+	 * initial DAPM sync and every time the last microphone route
+	 * goes away, blinding detection. In the load-controlled mode
+	 * (HBIAS_MODE = 0, the reset default) the bias only really
+	 * powers up when an accessory draws from it, so this costs
+	 * nothing with an empty jack.
+	 */
+	ret = snd_soc_component_update_bits(component, AC100_ADC_APC_CTRL,
+					    AC100_ADC_APC_CTRL_HBIAS_EN_MASK |
+					    AC100_ADC_APC_CTRL_HBIAS_ADC_EN_MASK,
+					    AC100_ADC_APC_CTRL_HBIAS_EN_ENABLED |
+					    AC100_ADC_APC_CTRL_HBIAS_ADC_EN_ENABLED);
+	return ret < 0 ? ret : 0;
+}
+
+static const struct snd_soc_component_driver ac100_codec_analog_cmpnt_drv = {
+	.probe			= ac100_codec_analog_cmpnt_probe,
+	.controls		= ac100_codec_controls,
+	.num_controls		= ARRAY_SIZE(ac100_codec_controls),
+	.dapm_widgets		= ac100_codec_widgets,
+	.num_dapm_widgets	= ARRAY_SIZE(ac100_codec_widgets),
+	.dapm_routes		= ac100_codec_routes,
+	.num_dapm_routes	= ARRAY_SIZE(ac100_codec_routes),
+};
+
+static int ac100_codec_probe(struct platform_device *pdev)
+{
+	struct ac100_dev *ac100 = dev_get_drvdata(pdev->dev.parent);
+	struct ac100_codec *codec;
+	int ret = 0;
+
+	codec = devm_kzalloc(&pdev->dev, sizeof(*codec), GFP_KERNEL);
+	if (!codec)
+		return -ENOMEM;
+
+	codec->dev = &pdev->dev;
+	platform_set_drvdata(pdev, codec);
+
+	snd_soc_component_init_regmap(&codec->component, ac100->regmap);
+
+	ret = snd_soc_component_initialize(&codec->component,
+					   &ac100_codec_analog_cmpnt_drv,
+					   &pdev->dev);
+	if (ret < 0)
+		return ret;
+
+	ret = snd_soc_add_component(&codec->component, NULL, 0);
+	if (ret) {
+		dev_err(&pdev->dev,
+			"Failed to register codec component (%d)\n", ret);
+		return ret;
+	}
+
+	return ret;
+}
+
+static void ac100_codec_remove(struct platform_device *pdev)
+{
+	snd_soc_unregister_component(&pdev->dev);
+
+	/*
+	 * We do not call snd_soc_component_exit_regmap, because regmap
+	 * is still owned by the mfd device.
+	 */
+}
+
+static const struct of_device_id ac100_codec_of_match[] = {
+	{ .compatible = "x-powers,ac100-codec-analog" },
+	{}
+};
+MODULE_DEVICE_TABLE(of, ac100_codec_of_match);
+
+static struct platform_driver ac100_codec_driver = {
+	.driver = {
+		.name = "ac100-codec-analog",
+		.of_match_table = ac100_codec_of_match,
+	},
+	.probe = ac100_codec_probe,
+	.remove = ac100_codec_remove,
+};
+module_platform_driver(ac100_codec_driver);
+
+MODULE_DESCRIPTION("X-Powers AC100 codec driver");
+MODULE_AUTHOR("Ondrej Jirman <megi@xff.cz>");
+MODULE_LICENSE("GPL");
+MODULE_ALIAS("platform:ac100-codec");
