+static int sunxi_ahub_dai_set_bclk_ratio(struct snd_soc_dai *dai, unsigned int ratio)
+{
+       struct sunxi_ahub_info *ahub_info = snd_soc_dai_get_drvdata(dai);
+       struct regmap *regmap = NULL;
