+		compatible = "regulator-fixed";
+		regulator-always-on;
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+		regulator-name = "vcc-5v";
+	};
+
+	reg_vcc3v3: regulator-vcc3v3 {
+		/* Fixed 3.3V for internal modules */
+		compatible = "regulator-fixed";
+		regulator-always-on;
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		regulator-name = "vcc-3v3";
+		vin-supply = <&reg_vcc5v>;
+	};
+
+	reg_vcc1v8: regulator-vcc1v8 {
+		/* Fixed 1.8V for internal modules */
+		compatible = "regulator-fixed";
+		regulator-always-on;
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <1800000>;
+		regulator-name = "vcc-1v8";
+		vin-supply = <&reg_vcc3v3>;
+	};
+
+	reg_vcc33_wifi: regulator-vcc33-wifi {
+		compatible = "regulator-fixed";
+		regulator-always-on;
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		regulator-name = "vcc33-wifi";
+		vin-supply = <&reg_vcc5v>;
+	};
+
+	reg_vcc_wifi_io: regulator-vcc-wifi-io {
+		compatible = "regulator-fixed";
+		regulator-always-on;
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <1800000>;
+		regulator-name = "vcc-wifi-io";
+		vin-supply = <&reg_vcc33_wifi>;
+	};
+
+	ac300_pwm_reg: ac300-pwm-regulator {
+		compatible = "regulator-fixed-clock";
+		regulator-always-on;
+		regulator-name = "ac300-pwm-reg";
+		clocks = <&ac300_pwm_clk>;
+	};
+
+	wifi_pwrseq: wifi-pwrseq {
+		compatible = "mmc-pwrseq-simple";
+		clocks = <&rtc CLK_OSC32K_FANOUT>;
+		clock-names = "ext_clock";
+		pinctrl-0 = <&x32clk_fanout_pin>;
+		pinctrl-names = "default";
+		post-power-on-delay-ms = <200>;
+		reset-gpios = <&pio 6 18 GPIO_ACTIVE_LOW>; /* PG18 */
+	};
+
+	ac300_pwm_clk: ac300-clk {
+		compatible = "pwm-clock";
+		#clock-cells = <0>;
+		pwms = <&pwm 5 500 0>; /* 500ns period -> 2MHz */
+		clock-frequency = <2000000>;
+	};
+
+	leds {
+		compatible = "gpio-leds";
+
+		led-0 {
