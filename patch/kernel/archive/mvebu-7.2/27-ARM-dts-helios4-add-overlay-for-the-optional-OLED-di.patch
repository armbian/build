From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Rosen Penev <rosenp@gmail.com>
Date: Wed, 14 Oct 2026 14:46:55 -0700
Subject: ARM: dts: helios4: add overlays for the optional OLED display

Helios4 kits could ship with a 128x64 OLED module on the external I2C
header (i2c1, address 0x3c). Modules use an SH1106 or an SSD1306
controller. The two need different init sequences: with the SH1106
compatible, the ssd130x driver turns off the SSD1306 charge pump and
the panel stays dark.

Add one overlay per controller. Both are opt-in, so the i2c-dev users
(sys-oled, luma.oled) keep access to 0x3c by default.

The SH1106 has 132 columns of display RAM and the panel shows the
middle 128, so set a column offset of 2. Set page-offset to 0 on both:
the binding default of 1 shifts a 64-row panel down by one page.
Set com-invdir to match the luma.oled init sequence.

Assisted-by: LLM
Signed-off-by: Rosen Penev <rosenp@gmail.com>
---
 arch/arm/boot/dts/marvell/Makefile                            |  6 ++++
 arch/arm/boot/dts/marvell/armada-388-helios4-oled-sh1106.dtso  | 24 ++++++++++
 arch/arm/boot/dts/marvell/armada-388-helios4-oled-ssd1306.dtso | 22 ++++++++++
 3 files changed, 52 insertions(+)

diff --git a/arch/arm/boot/dts/marvell/Makefile b/arch/arm/boot/dts/marvell/Makefile
index 111111111111..222222222222 100644
--- a/arch/arm/boot/dts/marvell/Makefile
+++ b/arch/arm/boot/dts/marvell/Makefile
@@ -51,7 +51,13 @@ dtb-$(CONFIG_MACH_ARMADA_38X) += \
 	armada-388-db.dtb \
 	armada-388-gp.dtb \
 	armada-388-helios4.dtb \
+	armada-388-helios4-oled-sh1106.dtb \
+	armada-388-helios4-oled-sh1106.dtbo \
+	armada-388-helios4-oled-ssd1306.dtb \
+	armada-388-helios4-oled-ssd1306.dtbo \
 	armada-388-rd.dtb
+armada-388-helios4-oled-sh1106-dtbs := armada-388-helios4.dtb armada-388-helios4-oled-sh1106.dtbo
+armada-388-helios4-oled-ssd1306-dtbs := armada-388-helios4.dtb armada-388-helios4-oled-ssd1306.dtbo
 dtb-$(CONFIG_MACH_ARMADA_39X) += \
 	armada-390-db.dtb \
 	armada-395-gp.dtb \
diff --git a/arch/arm/boot/dts/marvell/armada-388-helios4-oled-sh1106.dtso b/arch/arm/boot/dts/marvell/armada-388-helios4-oled-sh1106.dtso
new file mode 100644
index 000000000000..111111111111
--- /dev/null
+++ b/arch/arm/boot/dts/marvell/armada-388-helios4-oled-sh1106.dtso
@@ -0,0 +1,24 @@
+// SPDX-License-Identifier: (GPL-2.0 OR MIT)
+/*
+ * Devicetree overlay for a 128x64 SH1106 OLED module on the Helios4
+ * external I2C header (i2c1). The panel shows the middle 128 of the
+ * 132 SH1106 RAM columns.
+ */
+
+/dts-v1/;
+/plugin/;
+
+&i2c1 {
+	#address-cells = <1>;
+	#size-cells = <0>;
+
+	oled@3c {
+		compatible = "sinowealth,sh1106";
+		reg = <0x3c>;
+		solomon,width = <128>;
+		solomon,height = <64>;
+		solomon,col-offset = <2>;
+		solomon,page-offset = <0>;
+		solomon,com-invdir;
+	};
+};
diff --git a/arch/arm/boot/dts/marvell/armada-388-helios4-oled-ssd1306.dtso b/arch/arm/boot/dts/marvell/armada-388-helios4-oled-ssd1306.dtso
new file mode 100644
index 000000000000..111111111111
--- /dev/null
+++ b/arch/arm/boot/dts/marvell/armada-388-helios4-oled-ssd1306.dtso
@@ -0,0 +1,22 @@
+// SPDX-License-Identifier: (GPL-2.0 OR MIT)
+/*
+ * Devicetree overlay for a 128x64 SSD1306 OLED module on the Helios4
+ * external I2C header (i2c1).
+ */
+
+/dts-v1/;
+/plugin/;
+
+&i2c1 {
+	#address-cells = <1>;
+	#size-cells = <0>;
+
+	oled@3c {
+		compatible = "solomon,ssd1306";
+		reg = <0x3c>;
+		solomon,width = <128>;
+		solomon,height = <64>;
+		solomon,page-offset = <0>;
+		solomon,com-invdir;
+	};
+};
