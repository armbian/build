From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Igor Pecovnik <igor@armbian.com>
Date: Fri, 6 Nov 2026 08:30:00 +0100
Subject: [PATCH] clk: sunxi-ng: a31: gate then ungate PLL CPU after rate change

cpufreq changes of the PLL CPU rate hang the A31s within seconds.
A33 and A64 fix the same problem with the PLL notifier. Use it on A31.

Signed-off-by: Igor Pecovnik <igor@armbian.com>
Assisted-by: Claude Opus 5.5
---
 drivers/clk/sunxi-ng/ccu-sun6i-a31.c | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/drivers/clk/sunxi-ng/ccu-sun6i-a31.c b/drivers/clk/sunxi-ng/ccu-sun6i-a31.c
--- a/drivers/clk/sunxi-ng/ccu-sun6i-a31.c
+++ b/drivers/clk/sunxi-ng/ccu-sun6i-a31.c
@@ -1220,6 +1220,13 @@
 	.num_resets	= ARRAY_SIZE(sun6i_a31_ccu_resets),
 };
 
+static struct ccu_pll_nb sun6i_a31_pll_cpu_nb = {
+	.common	= &pll_cpu_clk.common,
+	/* copy from pll_cpu_clk */
+	.enable	= BIT(31),
+	.lock	= BIT(28),
+};
+
 static struct ccu_mux_nb sun6i_a31_cpu_nb = {
 	.common		= &cpu_clk.common,
 	.cm		= &cpu_clk.mux,
@@ -1261,6 +1268,10 @@
 	if (ret)
 		return ret;
 
+	/* Gate then ungate PLL CPU after any rate changes */
+	ccu_pll_notifier_register(&sun6i_a31_pll_cpu_nb);
+
+	/* Reparent CPU during PLL CPU rate changes */
 	ccu_mux_notifier_register(pll_cpu_clk.common.hw.clk,
 				  &sun6i_a31_cpu_nb);
 
-- 
