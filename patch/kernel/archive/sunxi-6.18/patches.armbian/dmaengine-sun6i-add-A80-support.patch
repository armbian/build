From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Igor Pecovnik <igor@armbian.com>
Date: Mon, 19 Oct 2026 19:10:56 +0200
Subject: dmaengine: sun6i: add A80 support

The A80 DMA controller has 16 channels, the H3 gate register and the A31
burst and DRQ fields. It ends a descriptor list with 0x1ffff800, as the
vendor driver does, so make the last-item marker a per-SoC value.

Signed-off-by: Igor Pecovnik <igor@armbian.com>
Assisted-by: Claude Opus 5.5
---
 drivers/dma/sun6i-dma.c | 50 ++++++++--
 1 file changed, 42 insertions(+), 8 deletions(-)

diff --git a/drivers/dma/sun6i-dma.c b/drivers/dma/sun6i-dma.c
index 111111111111..222222222222 100644
--- a/drivers/dma/sun6i-dma.c
+++ b/drivers/dma/sun6i-dma.c
@@ -144,6 +144,8 @@ struct sun6i_dma_config {
 	u32 dst_addr_widths;
 	bool has_high_addr;
 	bool has_mbus_clk;
+	/* Next-LLI value that ends a list, if not LLI_LAST_ITEM */
+	u32 lli_last_item;
 };
 
 /*
@@ -347,7 +349,13 @@ static void sun6i_set_mode_h6(u32 *p_cfg, s8 src_mode, s8 dst_mode)
 		  DMA_CHAN_CFG_DST_MODE_H6(dst_mode);
 }
 
-static size_t sun6i_get_chan_size(struct sun6i_pchan *pchan)
+static u32 sun6i_lli_last_item(struct sun6i_dma_dev *sdev)
+{
+	return sdev->cfg->lli_last_item ?: LLI_LAST_ITEM;
+}
+
+static size_t sun6i_get_chan_size(struct sun6i_dma_dev *sdev,
+				  struct sun6i_pchan *pchan)
 {
 	struct sun6i_desc *txd = pchan->desc;
 	struct sun6i_dma_lli *lli;
@@ -359,7 +367,7 @@ static size_t sun6i_get_chan_size(struct sun6i_pchan *pchan)
 		bytes = readl(pchan->base + DMA_CHAN_CUR_CNT);
 	} while (pos != readl(pchan->base + DMA_CHAN_LLI_ADDR));
 
-	if (pos == LLI_LAST_ITEM)
+	if (pos == sun6i_lli_last_item(sdev))
 		return bytes;
 
 	for (lli = txd->v_lli; lli; lli = lli->v_lli_next) {
@@ -373,7 +381,8 @@ static size_t sun6i_get_chan_size(struct sun6i_pchan *pchan)
 	return bytes;
 }
 
-static void *sun6i_dma_lli_add(struct sun6i_dma_lli *prev,
+static void *sun6i_dma_lli_add(struct sun6i_dma_dev *sdev,
+			       struct sun6i_dma_lli *prev,
 			       struct sun6i_dma_lli *next,
 			       dma_addr_t next_phy,
 			       struct sun6i_desc *txd)
@@ -389,7 +398,7 @@ static void *sun6i_dma_lli_add(struct sun6i_dma_lli *prev,
 		prev->v_lli_next = next;
 	}
 
-	next->p_lli_next = LLI_LAST_ITEM;
+	next->p_lli_next = sun6i_lli_last_item(sdev);
 	next->v_lli_next = NULL;
 
 	return next;
@@ -703,7 +712,7 @@ static struct dma_async_tx_descriptor *sun6i_dma_prep_dma_memcpy(
 	sdev->cfg->set_drq(&v_lli->cfg, DRQ_SDRAM, DRQ_SDRAM);
 	sdev->cfg->set_mode(&v_lli->cfg, LINEAR_MODE, LINEAR_MODE);
 
-	sun6i_dma_lli_add(NULL, v_lli, p_lli, txd);
+	sun6i_dma_lli_add(sdev, NULL, v_lli, p_lli, txd);
 
 	sun6i_dma_dump_lli(vchan, v_lli, p_lli);
 
@@ -779,7 +788,7 @@ static struct dma_async_tx_descriptor *sun6i_dma_prep_slave_sg(
 				sg_dma_len(sg), flags);
 		}
 
-		prev = sun6i_dma_lli_add(prev, v_lli, p_lli, txd);
+		prev = sun6i_dma_lli_add(sdev, prev, v_lli, p_lli, txd);
 	}
 
 	dev_dbg(chan2dev(chan), "First: %pad\n", &txd->p_lli);
@@ -851,7 +860,7 @@ static struct dma_async_tx_descriptor *sun6i_dma_prep_dma_cyclic(
 			sdev->cfg->set_mode(&v_lli->cfg, IO_MODE, LINEAR_MODE);
 		}
 
-		prev = sun6i_dma_lli_add(prev, v_lli, p_lli, txd);
+		prev = sun6i_dma_lli_add(sdev, prev, v_lli, p_lli, txd);
 	}
 
 	prev->p_lli_next = txd->p_lli;		/* cyclic list */
@@ -967,6 +976,7 @@ static enum dma_status sun6i_dma_tx_status(struct dma_chan *chan,
 					   dma_cookie_t cookie,
 					   struct dma_tx_state *state)
 {
+	struct sun6i_dma_dev *sdev = to_sun6i_dma_dev(chan->device);
 	struct sun6i_vchan *vchan = to_sun6i_vchan(chan);
 	struct sun6i_pchan *pchan = vchan->phy;
 	struct sun6i_dma_lli *lli;
@@ -990,7 +1000,7 @@ static enum dma_status sun6i_dma_tx_status(struct dma_chan *chan,
 	} else if (!pchan || !pchan->desc) {
 		bytes = 0;
 	} else {
-		bytes = sun6i_get_chan_size(pchan);
+		bytes = sun6i_get_chan_size(sdev, pchan);
 	}
 
 	spin_unlock_irqrestore(&vchan->vc.lock, flags);
@@ -1170,6 +1180,29 @@ static struct sun6i_dma_config sun8i_a83t_dma_cfg = {
  * and the burst length fields have different offsets.
  */
 
+/*
+ * The A80 has the H3 gate register and the A31 burst and DRQ fields. Its
+ * last-item marker is 0x1ffff800, as in the vendor driver.
+ */
+static struct sun6i_dma_config sun9i_a80_dma_cfg = {
+	.nr_max_channels = 16,
+	.nr_max_requests = 30,
+	.nr_max_vchans   = 37,
+	.clock_autogate_enable = sun6i_enable_clock_autogate_h3,
+	.set_burst_length = sun6i_set_burst_length_a31,
+	.set_drq          = sun6i_set_drq_a31,
+	.set_mode         = sun6i_set_mode_a31,
+	.src_burst_lengths = BIT(1) | BIT(4) | BIT(8) | BIT(16),
+	.dst_burst_lengths = BIT(1) | BIT(4) | BIT(8) | BIT(16),
+	.src_addr_widths   = BIT(DMA_SLAVE_BUSWIDTH_1_BYTE) |
+			     BIT(DMA_SLAVE_BUSWIDTH_2_BYTES) |
+			     BIT(DMA_SLAVE_BUSWIDTH_4_BYTES),
+	.dst_addr_widths   = BIT(DMA_SLAVE_BUSWIDTH_1_BYTE) |
+			     BIT(DMA_SLAVE_BUSWIDTH_2_BYTES) |
+			     BIT(DMA_SLAVE_BUSWIDTH_4_BYTES),
+	.lli_last_item   = 0x1ffff800,
+};
+
 static struct sun6i_dma_config sun8i_h3_dma_cfg = {
 	.nr_max_channels = 12,
 	.nr_max_requests = 27,
@@ -1306,6 +1339,7 @@ static const struct of_device_id sun6i_dma_match[] = {
 	{ .compatible = "allwinner,sun8i-a23-dma", .data = &sun8i_a23_dma_cfg },
 	{ .compatible = "allwinner,sun8i-a83t-dma", .data = &sun8i_a83t_dma_cfg },
 	{ .compatible = "allwinner,sun8i-h3-dma", .data = &sun8i_h3_dma_cfg },
+	{ .compatible = "allwinner,sun9i-a80-dma", .data = &sun9i_a80_dma_cfg },
 	{ .compatible = "allwinner,sun8i-v3s-dma", .data = &sun8i_v3s_dma_cfg },
 	{ .compatible = "allwinner,sun20i-d1-dma", .data = &sun50i_a100_dma_cfg },
 	{ .compatible = "allwinner,sun50i-a64-dma", .data = &sun50i_a64_dma_cfg },
-- 
Armbian

