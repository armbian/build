From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Juan Sanchez <juanesf91@gmail.com>
Date: Sat, 10 Oct 2026 22:47:54 -0300
Subject: dt-bindings: display: dw-hdmi: add sun55i A523 compatible and #sound-dai-cells

The A523 DW-HDMI is compatible with the H6 encoder. Add the
allwinner,sun55i-a523-dw-hdmi / allwinner,sun50i-h6-dw-hdmi pair and
declare #sound-dai-cells, so the HDMI node can be referenced as a codec
DAI by the sndhdmi simple-audio-card.

The A523 lacks the H6 HDCP clocks and reset: it has four clocks and one
reset. Keep the H6 six-clock, two-reset requirements off the A523 pair
and state the A523 requirements explicitly.

Signed-off-by: Juan Sanchez <juanesf91@gmail.com>
Assisted-by: opencode:big-pickle
---
 Documentation/devicetree/bindings/display/allwinner,sun8i-a83t-dw-hdmi.yaml | 80 ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++--------------------
 1 file changed, 60 insertions(+), 20 deletions(-)

diff --git a/Documentation/devicetree/bindings/display/allwinner,sun8i-a83t-dw-hdmi.yaml b/Documentation/devicetree/bindings/display/allwinner,sun8i-a83t-dw-hdmi.yaml
index 111111111111..222222222222 100644
--- a/Documentation/devicetree/bindings/display/allwinner,sun8i-a83t-dw-hdmi.yaml
+++ b/Documentation/devicetree/bindings/display/allwinner,sun8i-a83t-dw-hdmi.yaml
@@ -27,6 +27,10 @@
     oneOf:
       - const: allwinner,sun8i-a83t-dw-hdmi
       - const: allwinner,sun50i-h6-dw-hdmi
+
+      - items:
+          - const: allwinner,sun55i-a523-dw-hdmi
+          - const: allwinner,sun50i-h6-dw-hdmi
 
       - items:
           - enum:
@@ -83,6 +87,10 @@
 
   phy-names:
     const: phy
+
+  "#sound-dai-cells":
+    const: 0
+    description: For HDMI audio
 
   hvcc-supply:
     description:
@@ -121,27 +129,58 @@
   - phy-names
   - ports
 
-if:
-  properties:
-    compatible:
-      contains:
-        enum:
-          - allwinner,sun50i-h6-dw-hdmi
-
-then:
-  properties:
-    clocks:
-      minItems: 6
-
-    clock-names:
-      minItems: 6
-
-    resets:
-      minItems: 2
-
-    reset-names:
-      minItems: 2
-
+allOf:
+  - if:
+      properties:
+        compatible:
+          contains:
+            enum:
+              - allwinner,sun50i-h6-dw-hdmi
+      not:
+        properties:
+          compatible:
+            contains:
+              enum:
+                - allwinner,sun55i-a523-dw-hdmi
+
+    then:
+      properties:
+        clocks:
+          minItems: 6
+
+        clock-names:
+          minItems: 6
+
+        resets:
+          minItems: 2
+
+        reset-names:
+          minItems: 2
+
+  - if:
+      properties:
+        compatible:
+          contains:
+            enum:
+              - allwinner,sun55i-a523-dw-hdmi
+
+    then:
+      properties:
+        clocks:
+          minItems: 4
+          maxItems: 4
+
+        clock-names:
+          minItems: 4
+          maxItems: 4
+
+        resets:
+          minItems: 1
+          maxItems: 1
+
+        reset-names:
+          minItems: 1
+          maxItems: 1
 
 additionalProperties: false
 
