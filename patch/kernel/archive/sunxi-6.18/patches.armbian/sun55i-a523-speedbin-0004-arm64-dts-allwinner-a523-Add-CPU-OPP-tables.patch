From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: serg987 <50438876+serg987@users.noreply.github.com>
Date: Sat, 7 Nov 2026 20:12:00 -0500
Subject: arm64: dts: allwinner: a523: Add CPU OPP tables

Add the SID cell holding the CPU speed grade, and OPP tables for both
clusters taken from the Allwinner BSP (vf table version V0.71). Boards
include the tables together with their CPU supplies.

Signed-off-by: serg987 <50438876+serg987@users.noreply.github.com>
---
 arch/arm64/boot/dts/allwinner/sun55i-a523-cpu-opp.dtsi | 236 ++++++++++
 arch/arm64/boot/dts/allwinner/sun55i-a523.dtsi         |   4 +
 2 files changed, 240 insertions(+)

diff --git a/arch/arm64/boot/dts/allwinner/sun55i-a523-cpu-opp.dtsi b/arch/arm64/boot/dts/allwinner/sun55i-a523-cpu-opp.dtsi
new file mode 100644
index 000000000000..111111111111
--- /dev/null
+++ b/arch/arm64/boot/dts/allwinner/sun55i-a523-cpu-opp.dtsi
@@ -0,0 +1,236 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * CPU OPP tables for the Allwinner A523/A527/T527 family.
+ *
+ * Frequencies and voltages are taken from the Allwinner BSP
+ * (sun55iw3p1.dtsi, vf table version V0.71). The speed grade is read from
+ * the SID (offset 0x48) by the sun50i-cpufreq-nvmem driver and mapped to
+ * speedN as follows (vendor vf index in brackets):
+ *
+ *   speed0: [0100], [0200], [0201], and unprogrammed fuses
+ *   speed1: [0102]
+ *   speed2: [0300], [0301]
+ *   speed3: [0302]
+ *   speed4: [0400]
+ *   speed5: [0500]
+ *   speed6: [0502]
+ *
+ * Bins with identical CPU voltages are merged.
+ *
+ * The DSU (cluster L3/interconnect) shares the little-cluster rail and is
+ * left at its boot rate (768 MHz) by mainline. The vendor DSU table needs
+ * 920 mV at 792 MHz for speed0 and speed1, so the little-cluster OPPs of
+ * those grades never go below 920 mV.
+ *
+ * Not included: 1992 MHz on the big cluster for [0400], which needs 1.22 V.
+ */
+
+/ {
+	cpu_opp_table_l: opp-table-cpu-l {
+		compatible = "allwinner,sun55i-a523-operating-points";
+		nvmem-cells = <&cpu_speed_grade>;
+		opp-shared;
+
+		opp-408000000 {
+			opp-hz = /bits/ 64 <408000000>;
+			opp-microvolt-speed0 = <920000>;
+			opp-microvolt-speed1 = <920000>;
+			opp-microvolt-speed2 = <900000>;
+			opp-microvolt-speed3 = <900000>;
+			opp-microvolt-speed4 = <900000>;
+			opp-microvolt-speed5 = <900000>;
+			opp-microvolt-speed6 = <900000>;
+			clock-latency-ns = <244144>; /* 8 32k periods */
+			opp-supported-hw = <0x7f>;
+		};
+
+		opp-672000000 {
+			opp-hz = /bits/ 64 <672000000>;
+			opp-microvolt-speed0 = <920000>;
+			opp-microvolt-speed1 = <920000>;
+			opp-microvolt-speed2 = <900000>;
+			opp-microvolt-speed3 = <900000>;
+			opp-microvolt-speed4 = <900000>;
+			opp-microvolt-speed5 = <900000>;
+			opp-microvolt-speed6 = <900000>;
+			clock-latency-ns = <244144>;
+			opp-supported-hw = <0x7f>;
+		};
+
+		opp-792000000 {
+			opp-hz = /bits/ 64 <792000000>;
+			opp-microvolt-speed0 = <920000>;
+			opp-microvolt-speed1 = <920000>;
+			opp-microvolt-speed2 = <900000>;
+			opp-microvolt-speed3 = <900000>;
+			opp-microvolt-speed4 = <900000>;
+			opp-microvolt-speed5 = <900000>;
+			opp-microvolt-speed6 = <900000>;
+			clock-latency-ns = <244144>;
+			opp-supported-hw = <0x7f>;
+		};
+
+		opp-936000000 {
+			opp-hz = /bits/ 64 <936000000>;
+			opp-microvolt-speed0 = <920000>;
+			opp-microvolt-speed1 = <920000>;
+			opp-microvolt-speed2 = <900000>;
+			opp-microvolt-speed3 = <900000>;
+			opp-microvolt-speed4 = <900000>;
+			opp-microvolt-speed5 = <900000>;
+			opp-microvolt-speed6 = <900000>;
+			clock-latency-ns = <244144>;
+			opp-supported-hw = <0x7f>;
+		};
+
+		opp-1008000000 {
+			opp-hz = /bits/ 64 <1008000000>;
+			opp-microvolt-speed0 = <960000>;
+			opp-microvolt-speed1 = <960000>;
+			opp-microvolt-speed2 = <920000>;
+			opp-microvolt-speed3 = <920000>;
+			opp-microvolt-speed5 = <920000>;
+			opp-microvolt-speed6 = <920000>;
+			clock-latency-ns = <244144>;
+			opp-supported-hw = <0x6f>;
+		};
+
+		opp-1032000000 {
+			opp-hz = /bits/ 64 <1032000000>;
+			opp-microvolt-speed4 = <920000>;
+			clock-latency-ns = <244144>;
+			opp-supported-hw = <0x10>;
+		};
+
+		opp-1104000000 {
+			opp-hz = /bits/ 64 <1104000000>;
+			opp-microvolt-speed0 = <1000000>;
+			opp-microvolt-speed2 = <960000>;
+			opp-microvolt-speed5 = <960000>;
+			clock-latency-ns = <244144>;
+			opp-supported-hw = <0x25>;
+		};
+
+		opp-1128000000 {
+			opp-hz = /bits/ 64 <1128000000>;
+			opp-microvolt-speed4 = <960000>;
+			clock-latency-ns = <244144>;
+			opp-supported-hw = <0x10>;
+		};
+
+		opp-1224000000 {
+			opp-hz = /bits/ 64 <1224000000>;
+			opp-microvolt-speed0 = <1050000>;
+			opp-microvolt-speed2 = <1000000>;
+			opp-microvolt-speed4 = <1000000>;
+			opp-microvolt-speed5 = <1000000>;
+			clock-latency-ns = <244144>;
+			opp-supported-hw = <0x35>;
+		};
+
+		opp-1320000000 {
+			opp-hz = /bits/ 64 <1320000000>;
+			opp-microvolt-speed0 = <1120000>;
+			opp-microvolt-speed2 = <1050000>;
+			opp-microvolt-speed4 = <1050000>;
+			opp-microvolt-speed5 = <1050000>;
+			clock-latency-ns = <244144>;
+			opp-supported-hw = <0x35>;
+		};
+
+		opp-1416000000 {
+			opp-hz = /bits/ 64 <1416000000>;
+			opp-microvolt-speed0 = <1150000>;
+			opp-microvolt-speed2 = <1100000>;
+			opp-microvolt-speed4 = <1100000>;
+			opp-microvolt-speed5 = <1100000>;
+			clock-latency-ns = <244144>;
+			opp-supported-hw = <0x35>;
+		};
+	};
+
+	cpu_opp_table_b: opp-table-cpu-b {
+		compatible = "allwinner,sun55i-a523-operating-points";
+		nvmem-cells = <&cpu_speed_grade>;
+		opp-shared;
+
+		opp-408000000 {
+			opp-hz = /bits/ 64 <408000000>;
+			opp-microvolt = <900000>;
+			clock-latency-ns = <244144>;
+			opp-supported-hw = <0x7f>;
+		};
+
+		opp-672000000 {
+			opp-hz = /bits/ 64 <672000000>;
+			opp-microvolt = <900000>;
+			clock-latency-ns = <244144>;
+			opp-supported-hw = <0x7f>;
+		};
+
+		opp-840000000 {
+			opp-hz = /bits/ 64 <840000000>;
+			opp-microvolt = <900000>;
+			clock-latency-ns = <244144>;
+			opp-supported-hw = <0x7f>;
+		};
+
+		opp-1008000000 {
+			opp-hz = /bits/ 64 <1008000000>;
+			opp-microvolt = <900000>;
+			clock-latency-ns = <244144>;
+			opp-supported-hw = <0x7f>;
+		};
+
+		opp-1200000000 {
+			opp-hz = /bits/ 64 <1200000000>;
+			opp-microvolt = <920000>;
+			clock-latency-ns = <244144>;
+			opp-supported-hw = <0x7f>;
+		};
+
+		opp-1344000000 {
+			opp-hz = /bits/ 64 <1344000000>;
+			opp-microvolt = <960000>;
+			clock-latency-ns = <244144>;
+			opp-supported-hw = <0x7f>;
+		};
+
+		opp-1488000000 {
+			opp-hz = /bits/ 64 <1488000000>;
+			opp-microvolt = <1000000>;
+			clock-latency-ns = <244144>;
+			opp-supported-hw = <0x7f>;
+		};
+
+		opp-1584000000 {
+			opp-hz = /bits/ 64 <1584000000>;
+			opp-microvolt = <1050000>;
+			clock-latency-ns = <244144>;
+			opp-supported-hw = <0x7f>;
+		};
+
+		opp-1680000000 {
+			opp-hz = /bits/ 64 <1680000000>;
+			opp-microvolt = <1100000>;
+			clock-latency-ns = <244144>;
+			opp-supported-hw = <0x1f>;
+		};
+
+		opp-1800000000 {
+			opp-hz = /bits/ 64 <1800000000>;
+			opp-microvolt = <1150000>;
+			clock-latency-ns = <244144>;
+			opp-supported-hw = <0x1f>;
+		};
+	};
+};
+
+&cpu0 { operating-points-v2 = <&cpu_opp_table_l>; };
+&cpu1 { operating-points-v2 = <&cpu_opp_table_l>; };
+&cpu2 { operating-points-v2 = <&cpu_opp_table_l>; };
+&cpu3 { operating-points-v2 = <&cpu_opp_table_l>; };
+&cpu4 { operating-points-v2 = <&cpu_opp_table_b>; };
+&cpu5 { operating-points-v2 = <&cpu_opp_table_b>; };
+&cpu6 { operating-points-v2 = <&cpu_opp_table_b>; };
+&cpu7 { operating-points-v2 = <&cpu_opp_table_b>; };
diff --git a/arch/arm64/boot/dts/allwinner/sun55i-a523.dtsi b/arch/arm64/boot/dts/allwinner/sun55i-a523.dtsi
index 111111111111..222222222222 100644
--- a/arch/arm64/boot/dts/allwinner/sun55i-a523.dtsi
+++ b/arch/arm64/boot/dts/allwinner/sun55i-a523.dtsi
@@ -833,6 +833,10 @@ ths_calibration0: ths-calibration0@38 {
 			ths_calibration1: ths-calibration1@44 {
 				reg = <0x44 0x8>;
 			};
+
+			cpu_speed_grade: cpu-speed-grade@48 {
+				reg = <0x48 0x4>;
+			};
 		};
 
