From a2496fd643b7c179bb32e7cb7592b05de1217f15 Mon Sep 17 00:00:00 2001
From: Andre Przywara <andre.przywara@arm.com>
Date: Sat, 7 Nov 2026 09:40:16 -0500
Subject: [PATCH] arm64: dts: allwinner: a523: add CPU clocks

Backport of [PATCH v3 4/4] from Andre Przywara's series
"arm64: allwinner: a523: Enable CPU clocks" (v3, 2026-09-26, based on v7.3-rc1),
Link: https://lore.kernel.org/all/20260925225112.14081-1-andre.przywara@arm.com/
Not merged upstream yet; carried in Armbian until it lands.

Rebased onto the Armbian 6.18 dtsi (CPU nodes carry #cooling-cells).

---
 .../arm64/boot/dts/allwinner/sun55i-a523.dtsi | 21 +++++++++++++++++++
 1 file changed, 21 insertions(+)

diff --git a/arch/arm64/boot/dts/allwinner/sun55i-a523.dtsi b/arch/arm64/boot/dts/allwinner/sun55i-a523.dtsi
index 43af87f..f8d75e0 100644
--- a/arch/arm64/boot/dts/allwinner/sun55i-a523.dtsi
+++ b/arch/arm64/boot/dts/allwinner/sun55i-a523.dtsi
@@ -9,6 +9,7 @@
 #include <dt-bindings/clock/sun55i-a523-ccu.h>
 #include <dt-bindings/clock/sun55i-a523-mcu-ccu.h>
 #include <dt-bindings/clock/sun55i-a523-r-ccu.h>
+#include <dt-bindings/clock/sun55i-a523-cpu-ccu.h>
 #include <dt-bindings/reset/sun55i-a523-ccu.h>
 #include <dt-bindings/reset/sun55i-a523-mcu-ccu.h>
 #include <dt-bindings/reset/sun55i-a523-r-ccu.h>
@@ -36,6 +37,7 @@
 			compatible = "arm,cortex-a55";
 			device_type = "cpu";
 			reg = <0x000>;
+			clocks = <&cpu_ccu CLK_CPU_L>;
 			enable-method = "psci";
 			#cooling-cells = <2>;
 		};
@@ -44,6 +46,7 @@
 			compatible = "arm,cortex-a55";
 			device_type = "cpu";
 			reg = <0x100>;
+			clocks = <&cpu_ccu CLK_CPU_L>;
 			enable-method = "psci";
 			#cooling-cells = <2>;
 		};
@@ -52,6 +55,7 @@
 			compatible = "arm,cortex-a55";
 			device_type = "cpu";
 			reg = <0x200>;
+			clocks = <&cpu_ccu CLK_CPU_L>;
 			enable-method = "psci";
 			#cooling-cells = <2>;
 		};
@@ -60,6 +64,7 @@
 			compatible = "arm,cortex-a55";
 			device_type = "cpu";
 			reg = <0x300>;
+			clocks = <&cpu_ccu CLK_CPU_L>;
 			enable-method = "psci";
 			#cooling-cells = <2>;
 		};
@@ -68,6 +73,7 @@
 			compatible = "arm,cortex-a55";
 			device_type = "cpu";
 			reg = <0x400>;
+			clocks = <&cpu_ccu CLK_CPU_B>;
 			enable-method = "psci";
 			#cooling-cells = <2>;
 		};
@@ -76,6 +82,7 @@
 			compatible = "arm,cortex-a55";
 			device_type = "cpu";
 			reg = <0x500>;
+			clocks = <&cpu_ccu CLK_CPU_B>;
 			enable-method = "psci";
 			#cooling-cells = <2>;
 		};
@@ -84,6 +91,7 @@
 			compatible = "arm,cortex-a55";
 			device_type = "cpu";
 			reg = <0x600>;
+			clocks = <&cpu_ccu CLK_CPU_B>;
 			enable-method = "psci";
 			#cooling-cells = <2>;
 		};
@@ -92,6 +100,7 @@
 			compatible = "arm,cortex-a55";
 			device_type = "cpu";
 			reg = <0x700>;
+			clocks = <&cpu_ccu CLK_CPU_B>;
 			enable-method = "psci";
 			#cooling-cells = <2>;
 		};
@@ -1465,6 +1474,18 @@ pcie: pcie@4800000 {
 			mbox-names = "kick";
 			status = "disabled";
 		};
+
+		cpu_ccu: clock-controller@8817000 {
+			compatible = "allwinner,sun55i-a523-cpu-ccu";
+			reg = <0x08817000 0x80>;
+			clocks = <&osc24M>, <&rtc CLK_OSC32K>,
+				 <&rtc CLK_IOSC>, <&ccu CLK_PLL_PERIPH0_2X>,
+				 <&ccu CLK_PLL_PERIPH0_600M>;
+			clock-names = "hosc", "losc",
+				      "iosc", "pll-periph0-2x",
+				      "pll-periph0-600m";
+			#clock-cells = <1>;
+		};
 	};
 
 	thermal-zones {
-- 
2.34.1

