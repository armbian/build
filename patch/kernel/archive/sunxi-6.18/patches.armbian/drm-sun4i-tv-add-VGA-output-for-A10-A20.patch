 sun4i_tv_find_tv_by_mode(unsigned int mode)
 {
@@ -283,7 +298,35 @@ static void sun4i_tv_disable(struct drm_encoder *encoder,
 			   SUN4I_TVE_EN_ENABLE,
 			   0);
 
-	sunxi_engine_disable_color_correction(crtc->engine);
+	if (tv->vga)
