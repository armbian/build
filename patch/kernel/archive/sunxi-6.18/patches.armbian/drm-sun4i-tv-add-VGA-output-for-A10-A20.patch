+
+/*
+ * VGA: the backend's RGB goes straight to DACs 0-2, which the vendor driver
+ * sets up as G, B and R (sources 4, 5 and 6, the Cubietruck's TVOUT0-2);
+ * the TCON drives HSYNC/VSYNC. The values are those of the vendor 3.4
+ * driver (TVE_set_vga_mode), checked against a running Cubietruck.
+ */
+static void sun4i_tv_vga_enable(struct sun4i_tv *tv)
+{
+	regmap_write(tv->regs, SUN4I_TVE_EN_REG,
+		     SUN4I_TVE_EN_DAC_MAP(0, 1) |
+		     SUN4I_TVE_EN_DAC_MAP(1, 2) |
+		     SUN4I_TVE_EN_DAC_MAP(2, 3));
+	regmap_write(tv->regs, SUN4I_TVE_CFG0_REG, SUN4I_TVE_CFG0_VGA);
+	/*
+	 * DACs 0-2 enabled with sources 4/5/6, luma/chroma gains as for
+	 * TV; bit 30 and the internal DAC setting 2 are copied as is.
+	 */
+	regmap_write(tv->regs, SUN4I_TVE_DAC0_REG, 0x403e1ac7);
+	regmap_update_bits(tv->regs, SUN4I_TVE_DAC1_REG, GENMASK(23, 0), 0);
+
+	regmap_update_bits(tv->regs, SUN4I_TVE_EN_REG,
+			   SUN4I_TVE_EN_ENABLE,
+			   SUN4I_TVE_EN_ENABLE);
 }
 
 static void sun4i_tv_enable(struct drm_encoder *encoder,
@@ -297,8 +340,16 @@ static void sun4i_tv_enable(struct drm_encoder *encoder,
 	struct drm_connector *connector = &tv->connector;
 	struct drm_connector_state *conn_state =
 		drm_atomic_get_new_connector_state(state, connector);
-	const struct tv_mode *tv_mode =
-		sun4i_tv_find_tv_by_mode(conn_state->tv.mode);
+	const struct tv_mode *tv_mode;
+
+	if (tv->vga) {
+		DRM_DEBUG_DRIVER("Enabling the VGA output\n");
+		sun4i_tv_vga_enable(tv);
+		sun4i_tcon_set_vga_sync(crtc->tcon, true);
+		return;
+	}
+
+	tv_mode = sun4i_tv_find_tv_by_mode(conn_state->tv.mode);
 
 	DRM_DEBUG_DRIVER("Enabling the TV Output\n");
 
@@ -412,6 +463,130 @@ static const struct drm_connector_helper_funcs sun4i_tv_comp_connector_helper_fu
 	.get_modes	= drm_connector_helper_tv_get_modes,
 };
 
+/*
+ * The DDC bus is looked up on every use rather than at probe time, so that
+ * the display pipeline never waits for (or fails on) an I2C controller, and
+ * no reference to it is held between uses.
+ */
+static struct i2c_adapter *sun4i_tv_vga_get_ddc(struct sun4i_tv *tv)
+{
+	return tv->ddc_node ? of_get_i2c_adapter_by_node(tv->ddc_node) : NULL;
+}
+
+static int sun4i_tv_vga_get_modes(struct drm_connector *connector)
+{
+	struct sun4i_tv *tv = drm_connector_to_sun4i_tv(connector);
+	struct i2c_adapter *ddc = sun4i_tv_vga_get_ddc(tv);
+	const struct drm_edid *drm_edid;
+	int count;
+
+	if (!ddc) {
+		/* the probe helper applies an EDID override or adds safe modes */
+		drm_edid_connector_update(connector, NULL);
+		return 0;
+	}
+
+	drm_edid = drm_edid_read_ddc(connector, ddc);
+	i2c_put_adapter(ddc);
+	drm_edid_connector_update(connector, drm_edid);
+	count = drm_edid_connector_add_modes(connector);
+	drm_edid_free(drm_edid);
+
+	/* drm_edid_read_ddc() skips the EDID override when the DDC probe fails */
+	if (!count)
+		count = drm_edid_override_connector_update(connector);
+
+	if (!count) {
+		count = drm_add_modes_noedid(connector, 1920, 1200);
+		drm_set_preferred_mode(connector, 1024, 768);
+	}
+
+	return count;
+}
+
+static enum drm_mode_status
+sun4i_tv_vga_mode_valid(struct drm_connector *connector,
+			const struct drm_display_mode *mode)
+{
+	if (mode->flags & DRM_MODE_FLAG_INTERLACE)
+		return MODE_NO_INTERLACE;
+
+	/* the vendor driver's fastest VGA mode, 1680x1050, needs 146.25 MHz */
+	if (mode->clock > 150000)
+		return MODE_CLOCK_HIGH;
+
+	return MODE_OK;
+}
+
+static enum drm_connector_status
+sun4i_tv_vga_detect(struct drm_connector *connector, bool force)
+{
+	struct i2c_adapter *ddc = sun4i_tv_vga_get_ddc(drm_connector_to_sun4i_tv(connector));
+	bool present;
+
+	if (!ddc)
+		return connector_status_unknown;
+
+	present = drm_probe_ddc(ddc);
+	i2c_put_adapter(ddc);
+
+	return present ? connector_status_connected : connector_status_disconnected;
+}
+
+static const struct drm_connector_helper_funcs sun4i_tv_vga_connector_helper_funcs = {
+	.get_modes	= sun4i_tv_vga_get_modes,
+	.mode_valid	= sun4i_tv_vga_mode_valid,
+};
+
+static const struct drm_connector_funcs sun4i_tv_vga_connector_funcs = {
+	.detect			= sun4i_tv_vga_detect,
+	.fill_modes		= drm_helper_probe_single_connector_modes,
+	.destroy		= drm_connector_cleanup,
+	.reset			= drm_atomic_helper_connector_reset,
+	.atomic_duplicate_state	= drm_atomic_helper_connector_duplicate_state,
+	.atomic_destroy_state	= drm_atomic_helper_connector_destroy_state,
+};
+
+/*
+ * A10/A20 boards such as the Cubietruck wire TV encoder 0 to a VGA connector
+ * (RGB on the DACs, sync from the TCON). The device tree says so by linking
+ * the encoder's output port to a "vga-connector" node.
+ */
+static void sun4i_tv_vga_probe(struct device *dev, struct sun4i_tv *tv)
+{
+	struct device_node *remote;
+
+	remote = of_graph_get_remote_node(dev->of_node, 1, -1);
+	if (!remote)
+		return;
+
+	if (of_device_is_compatible(remote, "vga-connector")) {
+		tv->vga = true;
+		tv->ddc_node = of_parse_phandle(remote, "ddc-i2c-bus", 0);
+	}
+	of_node_put(remote);
+}
+
+static int sun4i_tv_vga_connector_init(struct drm_device *drm,
+				       struct sun4i_tv *tv)
+{
+	int ret;
+
+	drm_connector_helper_add(&tv->connector,
+				 &sun4i_tv_vga_connector_helper_funcs);
+	ret = drm_connector_init(drm, &tv->connector,
+				 &sun4i_tv_vga_connector_funcs,
+				 DRM_MODE_CONNECTOR_VGA);
+	if (ret)
+		return ret;
+
+	if (tv->ddc_node)
+		tv->connector.polled = DRM_CONNECTOR_POLL_CONNECT |
+				       DRM_CONNECTOR_POLL_DISCONNECT;
+
+	return drm_connector_attach_encoder(&tv->connector, &tv->encoder);
+}
+
 static void sun4i_tv_connector_reset(struct drm_connector *connector)
 {
 	drm_atomic_helper_connector_reset(connector);
@@ -437,42 +612,18 @@ static const struct regmap_config sun4i_tv_regmap_config = {
 static int sun4i_tv_bind(struct device *dev, struct device *master,
 			 void *data)
 {
-	struct platform_device *pdev = to_platform_device(dev);
 	struct drm_device *drm = data;
 	struct sun4i_drv *drv = drm->dev_private;
 	const struct sun4i_tv_quirks *quirks;
 	struct sun4i_tv *tv;
-	void __iomem *regs;
 	int ret;
 
 	quirks = of_device_get_match_data(dev);
 	if (!quirks)
 		return -EINVAL;
 
-	tv = devm_kzalloc(dev, sizeof(*tv), GFP_KERNEL);
-	if (!tv)
-		return -ENOMEM;
+	tv = dev_get_drvdata(dev);
 	tv->drv = drv;
-	dev_set_drvdata(dev, tv);
-
-	regs = devm_platform_ioremap_resource(pdev, 0);
-	if (IS_ERR(regs)) {
-		dev_err(dev, "Couldn't map the TV encoder registers\n");
-		return PTR_ERR(regs);
-	}
-
-	tv->regs = devm_regmap_init_mmio(dev, regs,
-					 &sun4i_tv_regmap_config);
-	if (IS_ERR(tv->regs)) {
-		dev_err(dev, "Couldn't create the TV encoder regmap\n");
-		return PTR_ERR(tv->regs);
-	}
-
-	tv->reset = devm_reset_control_get(dev, NULL);
-	if (IS_ERR(tv->reset)) {
-		dev_err(dev, "Couldn't get our reset line\n");
-		return PTR_ERR(tv->reset);
-	}
 
 	ret = reset_control_deassert(tv->reset);
 	if (ret) {
@@ -480,12 +631,6 @@ static int sun4i_tv_bind(struct device *dev, struct device *master,
 		return ret;
 	}
 
-	tv->clk = devm_clk_get(dev, NULL);
-	if (IS_ERR(tv->clk)) {
-		dev_err(dev, "Couldn't get the TV encoder clock\n");
-		ret = PTR_ERR(tv->clk);
-		goto err_assert_reset;
-	}
 	clk_prepare_enable(tv->clk);
 
 	if (quirks->calibration)
@@ -496,7 +641,8 @@ static int sun4i_tv_bind(struct device *dev, struct device *master,
 	drm_encoder_helper_add(&tv->encoder,
 			       &sun4i_tv_helper_funcs);
 	ret = drm_simple_encoder_init(drm, &tv->encoder,
-				      DRM_MODE_ENCODER_TVDAC);
+				      tv->vga ? DRM_MODE_ENCODER_DAC :
+						DRM_MODE_ENCODER_TVDAC);
 	if (ret) {
 		dev_err(dev, "Couldn't initialise the TV encoder\n");
 		goto err_disable_clk;
@@ -506,7 +652,17 @@ static int sun4i_tv_bind(struct device *dev, struct device *master,
 								dev->of_node);
 	if (!tv->encoder.possible_crtcs) {
 		ret = -EPROBE_DEFER;
-		goto err_disable_clk;
+		goto err_cleanup_encoder;
+	}
+
+	if (tv->vga) {
+		ret = sun4i_tv_vga_connector_init(drm, tv);
+		if (ret) {
+			dev_err(dev, "Couldn't initialise the VGA connector\n");
+			goto err_cleanup_encoder;
+		}
+
+		return 0;
 	}
 
 	drm_connector_helper_add(&tv->connector,
@@ -541,7 +697,6 @@ err_cleanup_encoder:
 	drm_encoder_cleanup(&tv->encoder);
 err_disable_clk:
 	clk_disable_unprepare(tv->clk);
-err_assert_reset:
 	reset_control_assert(tv->reset);
 	return ret;
 }
@@ -560,14 +715,77 @@ static const struct component_ops sun4i_tv_ops = {
 	.unbind	= sun4i_tv_unbind,
 };
 
+/*
+ * Resources are taken here, not in bind: devm resources live until the
+ * device goes away, so taking them in bind would fail on a second bind.
+ */
 static int sun4i_tv_probe(struct platform_device *pdev)
 {
-	return component_add(&pdev->dev, &sun4i_tv_ops);
+	struct device *dev = &pdev->dev;
+	struct sun4i_tv *tv;
+	void __iomem *regs;
+	int ret;
+
+	tv = devm_kzalloc(dev, sizeof(*tv), GFP_KERNEL);
+	if (!tv)
+		return -ENOMEM;
+	platform_set_drvdata(pdev, tv);
+
+	sun4i_tv_vga_probe(dev, tv);
+
+	regs = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(regs)) {
+		dev_err(dev, "Couldn't map the TV encoder registers\n");
+		ret = PTR_ERR(regs);
+		goto err_put_ddc_node;
+	}
+
+	tv->regs = devm_regmap_init_mmio(dev, regs, &sun4i_tv_regmap_config);
+	if (IS_ERR(tv->regs)) {
+		dev_err(dev, "Couldn't create the TV encoder regmap\n");
+		ret = PTR_ERR(tv->regs);
+		goto err_put_ddc_node;
+	}
+
+	/*
+	 * A20 VGA works with the TV encoder's reset bit (CCU LCD CH0 bit 29)
+	 * untouched, as with the vendor driver: the VGA path does not require
+	 * a reset line in the device tree; composite TV still does.
+	 */
+	if (tv->vga)
+		tv->reset = devm_reset_control_get_optional(dev, NULL);
+	else
+		tv->reset = devm_reset_control_get(dev, NULL);
+	if (IS_ERR(tv->reset)) {
+		dev_err(dev, "Couldn't get our reset line\n");
+		ret = PTR_ERR(tv->reset);
+		goto err_put_ddc_node;
+	}
+
+	tv->clk = devm_clk_get(dev, NULL);
+	if (IS_ERR(tv->clk)) {
+		dev_err(dev, "Couldn't get the TV encoder clock\n");
+		ret = PTR_ERR(tv->clk);
+		goto err_put_ddc_node;
+	}
+
+	ret = component_add(dev, &sun4i_tv_ops);
+	if (ret)
+		goto err_put_ddc_node;
+
+	return 0;
+
+err_put_ddc_node:
+	of_node_put(tv->ddc_node);
+	return ret;
 }
 
 static void sun4i_tv_remove(struct platform_device *pdev)
 {
+	struct sun4i_tv *tv = platform_get_drvdata(pdev);
+
 	component_del(&pdev->dev, &sun4i_tv_ops);
+	of_node_put(tv->ddc_node);
 }
 
