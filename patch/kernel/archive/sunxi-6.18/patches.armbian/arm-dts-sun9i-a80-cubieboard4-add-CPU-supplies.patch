From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Igor Pecovnik <igor@armbian.com>
Date: Mon, 19 Oct 2026 16:31:41 +0200
Subject: ARM: dts: sun9i: a80-cubieboard4: add CPU supplies

Cluster 0 runs from the AXP809 DCDC3, cluster 1 from the AXP806 DCDCA.
cpufreq-dt needs them to scale the voltage. Raise the DCDCA limit to
1.16 V for the 1.8 GHz boost step.

Wait for the voltage to settle before the clock goes up. The axp20x
driver does not support regulator-ramp-delay on these PMICs: the
property fails the regulator probe. Use a fixed settling time.

Signed-off-by: Igor Pecovnik <igor@armbian.com>
Assisted-by: Claude Opus 5.5
---
 arch/arm/boot/dts/allwinner/sun9i-a80-cubieboard4.dts | 38 +++++++++-
 1 file changed, 37 insertions(+), 1 deletion(-)

diff --git a/arch/arm/boot/dts/allwinner/sun9i-a80-cubieboard4.dts b/arch/arm/boot/dts/allwinner/sun9i-a80-cubieboard4.dts
index 111111111111..222222222222 100644
--- a/arch/arm/boot/dts/allwinner/sun9i-a80-cubieboard4.dts
+++ b/arch/arm/boot/dts/allwinner/sun9i-a80-cubieboard4.dts
@@ -121,6 +121,38 @@ wifi_pwrseq: wifi-pwrseq {
 	};
 };
 
+&cpu0 {
+	cpu-supply = <&reg_dcdc3>;
+};
+
+&cpu1 {
+	cpu-supply = <&reg_dcdc3>;
+};
+
+&cpu2 {
+	cpu-supply = <&reg_dcdc3>;
+};
+
+&cpu3 {
+	cpu-supply = <&reg_dcdc3>;
+};
+
+&cpu4 {
+	cpu-supply = <&reg_dcdca>;
+};
+
+&cpu5 {
+	cpu-supply = <&reg_dcdca>;
+};
+
+&cpu6 {
+	cpu-supply = <&reg_dcdca>;
+};
+
+&cpu7 {
+	cpu-supply = <&reg_dcdca>;
+};
+
 &de {
 	status = "okay";
 };
@@ -269,6 +301,8 @@ reg_dcdc3: dcdc3 {
 				regulator-min-microvolt = <800000>;
 				regulator-max-microvolt = <1100000>;
 				regulator-name = "vdd-cpua";
+				/* slowest DVM ramp, 10 mV per 15.625 us: 0.84 V to 1.1 V */
+				regulator-settling-time-up-us = <500>;
 			};
 
 			reg_dcdc4: dcdc4 {
@@ -435,8 +469,10 @@ reg_cldo3: cldo3 {
 			reg_dcdca: dcdca {
 				regulator-always-on;
 				regulator-min-microvolt = <800000>;
-				regulator-max-microvolt = <1100000>;
+				regulator-max-microvolt = <1160000>;
 				regulator-name = "vdd-cpub";
+				/* slowest DVM ramp, 10 mV per 15.625 us: 0.84 V to 1.1 V */
+				regulator-settling-time-up-us = <500>;
 			};
 
 			reg_dcdcd: dcdcd {
-- 
