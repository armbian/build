From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: SuperKali <hello@superkali.me>
Date: Fri, 20 Nov 2026 16:00:00 +0100
Subject: [PATCH] arm64: dts: allwinner: cubie-a5e: let the SPI NOR be probed
 by JEDEC ID

The board ships with a W25Q128FW (JEDEC ef6018), the 1.8 V part, and the
schematic footprint is a 25Q64DW, so the flash model is not fixed. With
"winbond,w25q128" the core warns that it found a different chip. Use the
generic compatible and let the JEDEC ID pick the part.

Signed-off-by: SuperKali <hello@superkali.me>
---
 arch/arm64/boot/dts/allwinner/sun55i-a527-cubie-a5e.dts | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/allwinner/sun55i-a527-cubie-a5e.dts b/arch/arm64/boot/dts/allwinner/sun55i-a527-cubie-a5e.dts
index 64dd959..0e529e9 100644
--- a/arch/arm64/boot/dts/allwinner/sun55i-a527-cubie-a5e.dts
+++ b/arch/arm64/boot/dts/allwinner/sun55i-a527-cubie-a5e.dts
@@ -567,7 +567,7 @@
 	status = "okay";
 
 	flash@0 {
-		compatible = "winbond,w25q128", "jedec,spi-nor";
+		compatible = "jedec,spi-nor";
 		reg = <0>;
 		spi-max-frequency = <40000000>;
 		vcc-supply = <&reg_cldo1>;
