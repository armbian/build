From: serg987 <50438876+serg987@users.noreply.github.com>
Date: Sat, 7 Nov 2026 20:12:00 -0500
Subject: cpufreq: sun50i: Add A523 support

Read the A523 speed grade code from the SID and map it to the speed
grades of the A523 OPP tables, following the decoding of the vendor
BSP (sun50i-cpufreq-nvmem.c, sun55iw3_nvmem_xlate).

Signed-off-by: serg987 <50438876+serg987@users.noreply.github.com>
---
 drivers/cpufreq/sun50i-cpufreq-nvmem.c | 53 ++++++++++
 1 file changed, 53 insertions(+)

diff --git a/drivers/cpufreq/sun50i-cpufreq-nvmem.c b/drivers/cpufreq/sun50i-cpufreq-nvmem.c
index 111111111111..222222222222 100644
--- a/drivers/cpufreq/sun50i-cpufreq-nvmem.c
+++ b/drivers/cpufreq/sun50i-cpufreq-nvmem.c
@@ -124,6 +124,49 @@ static u32 sun50i_h616_efuse_xlate(u32 speedbin)
 	return value;
 }
 
+/*
+ * The A523 family stores a DVFS code in the SID at offset 0x48. Bits
+ * [19:12] hold a replacement code, which takes precedence over the
+ * original code in bits [11:4] when non-zero. The vendor BSP maps the
+ * code to one of its vf tables (vf-version V0.71). Bins with identical
+ * CPU voltages are merged here, see sun55i-a523-cpu-opp.dtsi.
+ *
+ * For an unprogrammed code (0) the BSP picks vf0100 or vf0201 based on
+ * other fuses. Both have the same CPU voltages as speed0.
+ */
+static u32 sun55i_a523_efuse_xlate(u32 speedbin)
+{
+	u32 code = (speedbin >> 12) & 0xff;
+
+	if (!code)
+		code = (speedbin >> 4) & 0xff;
+
+	switch (code) {
+	case 0x00:
+	case 0x01:	/* vf0100 */
+	case 0x02:	/* vf0200 */
+	case 0x12:	/* vf0201 */
+		return 0;
+	case 0x21:	/* vf0102 */
+		return 1;
+	case 0x04:	/* vf0300 */
+	case 0x14:	/* vf0301 */
+		return 2;
+	case 0x24:	/* vf0302 */
+		return 3;
+	case 0x05:	/* vf0400 */
+		return 4;
+	case 0x06:	/* vf0500 */
+		return 5;
+	case 0x26:	/* vf0502 */
+		return 6;
+	default:
+		pr_warn("unknown A523 speed grade code 0x%x, using speed0\n",
+			code);
+		return 0;
+	}
+}
+
 static struct sunxi_cpufreq_data sun50i_h6_cpufreq_data = {
 	.efuse_xlate = sun50i_h6_efuse_xlate,
 };
@@ -136,6 +179,10 @@ static struct sunxi_cpufreq_data sun50i_h616_cpufreq_data = {
 	.efuse_xlate = sun50i_h616_efuse_xlate,
 };
 
+static struct sunxi_cpufreq_data sun55i_a523_cpufreq_data = {
+	.efuse_xlate = sun55i_a523_efuse_xlate,
+};
+
 static const struct of_device_id cpu_opp_match_list[] = {
 	{ .compatible = "allwinner,sun50i-h6-operating-points",
 	  .data = &sun50i_h6_cpufreq_data,
@@ -146,6 +193,9 @@ static const struct of_device_id cpu_opp_match_list[] = {
 	{ .compatible = "allwinner,sun50i-h616-operating-points",
 	  .data = &sun50i_h616_cpufreq_data,
 	},
+	{ .compatible = "allwinner,sun55i-a523-operating-points",
+	  .data = &sun55i_a523_cpufreq_data,
+	},
 	{}
 };
 
@@ -330,6 +380,9 @@ static const struct of_device_id sun50i_cpufreq_match_list[] = {
 	{ .compatible = "allwinner,sun50i-h616" },
 	{ .compatible = "allwinner,sun50i-h618" },
 	{ .compatible = "allwinner,sun50i-h700" },
+	{ .compatible = "allwinner,sun55i-a523" },
+	{ .compatible = "allwinner,sun55i-a527" },
+	{ .compatible = "allwinner,sun55i-t527" },
 	{}
 };
 MODULE_DEVICE_TABLE(of, sun50i_cpufreq_match_list);
-- 
