From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Juan Sanchez <juanesf91@gmail.com>
Date: Sat, 10 Oct 2026 22:47:54 -0300
Subject: dt-bindings: sound: simple-card: add playback-only and capture-only

simple-card parses root-level playback-only and capture-only flags in
graph_util_parse_link_direction(). Document both in the binding.

Signed-off-by: Juan Sanchez <juanesf91@gmail.com>
Assisted-by: opencode:big-pickle
---
 Documentation/devicetree/bindings/sound/simple-card.yaml | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/Documentation/devicetree/bindings/sound/simple-card.yaml b/Documentation/devicetree/bindings/sound/simple-card.yaml
index 111111111111..222222222222 100644
--- a/Documentation/devicetree/bindings/sound/simple-card.yaml
+++ b/Documentation/devicetree/bindings/sound/simple-card.yaml
@@ -217,6 +217,16 @@ properties:
   simple-audio-card,mic-det-gpios:
     maxItems: 1
 
+  playback-only:
+    description: |
+      The sound card is for playback only.
+    $ref: /schemas/types.yaml#/definitions/flag
+
+  capture-only:
+    description: |
+      The sound card is for capture only.
+    $ref: /schemas/types.yaml#/definitions/flag
+
 patternProperties:
   "^simple-audio-card,cpu(@[0-9a-f]+)?$":
     $ref: "#/definitions/dai"
-- 
Armbian

