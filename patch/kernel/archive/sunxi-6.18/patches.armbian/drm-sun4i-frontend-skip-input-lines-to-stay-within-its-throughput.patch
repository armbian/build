 drivers/gpu/drm/sun4i/sun4i_backend.c  |   9 +-
 drivers/gpu/drm/sun4i/sun4i_frontend.c | 145 +++++++++++++++++++++++--
 drivers/gpu/drm/sun4i/sun4i_frontend.h |  13 +++
 3 files changed, 154 insertions(+), 13 deletions(-)

