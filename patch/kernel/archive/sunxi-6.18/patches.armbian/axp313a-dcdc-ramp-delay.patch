From: serg987 <50438876+serg987@users.noreply.github.com>
Date: Sun, 8 Nov 2026 11:36:38 -0500
Subject: regulator: axp20x: Add ramp delay for AXP313A/AXP323 DCDCs

The AXP313A family DCDC regulators had no ramp delay, so the regulator
core returned from a voltage increase immediately. A cpufreq driver then
raises the CPU clock before the rail has settled. On the AXP323 that
supplies the big cluster of the Allwinner A523 this happens on every
upward frequency change.

Use the slew rate the Allwinner BSP assumes for these PMICs: 25 us per
10 mV step, i.e. 400 uV/us.

Signed-off-by: serg987 <50438876+serg987@users.noreply.github.com>
---
 drivers/regulator/axp20x-regulator.c | 22 +++++++---
 1 file changed, 16 insertions(+), 6 deletions(-)

diff --git a/drivers/regulator/axp20x-regulator.c b/drivers/regulator/axp20x-regulator.c
index 111111111111..222222222222 100644
--- a/drivers/regulator/axp20x-regulator.c
+++ b/drivers/regulator/axp20x-regulator.c
@@ -745,19 +745,29 @@ static const struct linear_range axp313a_dcdc3_ranges[] = {
 	REGULATOR_LINEAR_RANGE(1220000, 71, 102, 20000),
 };
 
+/*
+ * The DCDC outputs slew at about one 10 mV step per 25 us. This is the
+ * value the Allwinner BSP uses for the AXP1530/AXP323 (regulator-step-delay-us
+ * = <25>), so wait accordingly before relying on a raised voltage.
+ */
+#define AXP313A_DCDC_RAMP_DELAY		400	/* uV/us */
+
 static const struct regulator_desc axp313a_regulators[] = {
-	AXP_DESC_RANGES(AXP313A, DCDC1, "dcdc1", "vin1",
+	AXP_DESC_RANGES_DELAY(AXP313A, DCDC1, "dcdc1", "vin1",
 			axp313a_dcdc1_ranges, AXP313A_DCDC1_NUM_VOLTAGES,
 			AXP313A_DCDC1_CONTROL, AXP313A_DCDC_V_OUT_MASK,
-			AXP313A_OUTPUT_CONTROL, BIT(0)),
-	AXP_DESC_RANGES(AXP313A, DCDC2, "dcdc2", "vin2",
+			AXP313A_OUTPUT_CONTROL, BIT(0),
+			AXP313A_DCDC_RAMP_DELAY),
+	AXP_DESC_RANGES_DELAY(AXP313A, DCDC2, "dcdc2", "vin2",
 			axp313a_dcdc2_ranges, AXP313A_DCDC23_NUM_VOLTAGES,
 			AXP313A_DCDC2_CONTROL, AXP313A_DCDC_V_OUT_MASK,
-			AXP313A_OUTPUT_CONTROL, BIT(1)),
-	AXP_DESC_RANGES(AXP313A, DCDC3, "dcdc3", "vin3",
+			AXP313A_OUTPUT_CONTROL, BIT(1),
+			AXP313A_DCDC_RAMP_DELAY),
+	AXP_DESC_RANGES_DELAY(AXP313A, DCDC3, "dcdc3", "vin3",
 			axp313a_dcdc3_ranges, AXP313A_DCDC23_NUM_VOLTAGES,
 			AXP313A_DCDC3_CONTROL, AXP313A_DCDC_V_OUT_MASK,
-			AXP313A_OUTPUT_CONTROL, BIT(2)),
+			AXP313A_OUTPUT_CONTROL, BIT(2),
+			AXP313A_DCDC_RAMP_DELAY),
 	AXP_DESC(AXP313A, ALDO1, "aldo1", "vin1", 500, 3500, 100,
 		 AXP313A_ALDO1_CONTROL, AXP313A_LDO_V_OUT_MASK,
 		 AXP313A_OUTPUT_CONTROL, BIT(3)),
