/dts-v1/;
/plugin/;

/*
 * LeMaker 7" LVDS LCD (1024x600) with FT5x06 touch on the LCD connector
 * of the LeMaker Banana Pro. Parameters taken from the vendor fex file
 * (banana_pro_7lcd.fex).
 *
 * 55 MHz pixel clock, about 64 Hz. With an HDMI monitor connected use
 * lemaker-lcd7-hdmi instead: LCD and HDMI share PLL3 and the LCD flickers.
 */

/ {
	compatible = "allwinner,sun7i-a20";

	fragment@0 {
		target-path = "/";
		__overlay__ {
			/* Panel power, PH12 */
			lemaker_lcd_power: lemaker-lcd-power {
				compatible = "regulator-fixed";
				regulator-name = "lemaker-lcd-power";
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				gpio = <&pio 7 12 0>; /* PH12, active high */
				enable-active-high;
			};

			/* Backlight: PWM0 on PB2, enable on PH8 */
			lemaker_lcd_backlight: lemaker-lcd-backlight {
				compatible = "pwm-backlight";
				pwms = <&pwm 0 50000 0>;
				brightness-levels = <0 255>;
				num-interpolated-steps = <255>;
				default-brightness-level = <200>;
				enable-gpios = <&pio 7 8 0>; /* PH8, active high */
			};

			/*
			 * The A20 TCON switches to LVDS output only for a
			 * "panel-lvds" panel, any other panel gets parallel RGB.
			 */
			lemaker-lcd-panel {
				compatible = "panel-lvds";
				width-mm = <154>;
				height-mm = <86>;
				data-mapping = "vesa-24";
				power-supply = <&lemaker_lcd_power>;
				backlight = <&lemaker_lcd_backlight>;

				panel-timing {
					clock-frequency = <55000000>;
					hactive = <1024>;
					vactive = <600>;
					hfront-porch = <170>;
					hback-porch = <100>;
					hsync-len = <50>;
					vfront-porch = <15>;
					vback-porch = <10>;
					vsync-len = <10>;
				};

				port {
					lemaker_lcd_panel_in: endpoint {
						remote-endpoint = <&tcon0_out_lemaker_lcd>;
					};
				};
			};
		};
	};

	fragment@1 {
		target = <&tcon0>;
		__overlay__ {
			pinctrl-names = "default";
			pinctrl-0 = <&lcd_lvds0_pins>;
		};
	};

	/* endpoint@1 of tcon0_out is already used by HDMI */
	fragment@2 {
		target = <&tcon0_out>;
		__overlay__ {
			#address-cells = <1>;
			#size-cells = <0>;

			tcon0_out_lemaker_lcd: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&lemaker_lcd_panel_in>;
			};
		};
	};

	fragment@3 {
		target = <&pwm>;
		__overlay__ {
			pinctrl-names = "default";
			pinctrl-0 = <&pwm0_pin>;
			status = "okay";
		};
	};

	/* Touch: FT5x06 on I2C3 (PI0/PI1), IRQ on PH9, reset on PH7 */
	fragment@4 {
		target = <&i2c3>;
		__overlay__ {
			pinctrl-names = "default";
			pinctrl-0 = <&i2c3_pins>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "okay";

			touchscreen@38 {
				compatible = "edt,edt-ft5406";
				reg = <0x38>;
				/*
				 * The controller is powered from the panel line PH12. Without this
				 * the panel driver switches PH12 off on DPMS off and touch cannot
				 * wake the screen.
				 */
				vcc-supply = <&lemaker_lcd_power>;
				interrupt-parent = <&pio>;
				interrupts = <7 9 2>; /* PH9, IRQ_TYPE_EDGE_FALLING */
				/*
				 * PH7 is the controller reset (ctp_wakeup in fex).
				 * As reset-gpios the driver waits 300 ms after
				 * reset, as wake-gpios only 5 ms, too short.
				 */
				reset-gpios = <&pio 7 7 1>; /* PH7, active low */
				touchscreen-size-x = <1024>;
				touchscreen-size-y = <600>;
			};
		};
	};
};
