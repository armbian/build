diff --git a/arch/arm64/boot/dts/allwinner/sun50i-h5-pbstvstick.dts b/arch/arm64/boot/dts/allwinner/sun50i-h5-pbstvstick.dts
new file mode 100644
--- /dev/null
+++ b/arch/arm64/boot/dts/allwinner/sun50i-h5-pbstvstick.dts
@@ -0,0 +1,40 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * Copyright (C) 2026
+ */
+
+#include "sun50i-h5-orangepi-prime.dts"
+
+/ {
+	model = "PBS TV Stick";
+	compatible = "xunlong,pbstvstick", "allwinner,sun50i-h5";
+
+	leds {
+		led-0 {
+			gpios = <&pio 0 15 GPIO_ACTIVE_HIGH>;
+			default-state = "on";
+		};
+	};
+};
+
+&mmc0 {
+	vmmc-supply = <&reg_vcc3v3>;
+	bus-width = <4>;
+	/delete-property/ cd-gpios;
+	broken-cd;
+	disable-wp;
+	no-1-8-v;
+	status = "okay";
+};
+
+&mmc2 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&mmc2_8bit_pins>;
+	vmmc-supply = <&reg_vcc3v3>;
+	vqmmc-supply = <&reg_vcc3v3>;
+	bus-width = <8>;
+	no-1-8-v;
+	non-removable;
+	cap-mmc-hw-reset;
+	status = "okay";
+};
