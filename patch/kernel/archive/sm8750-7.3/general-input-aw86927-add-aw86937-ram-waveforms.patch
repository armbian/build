 	if (IS_ERR(haptics->reset_gpio))
 		return dev_err_probe(haptics->dev, PTR_ERR(haptics->reset_gpio),
 				     "Failed to get reset gpio\n");
 
+	err = devm_add_action_or_reset(haptics->dev, aw86927_reset, haptics);
