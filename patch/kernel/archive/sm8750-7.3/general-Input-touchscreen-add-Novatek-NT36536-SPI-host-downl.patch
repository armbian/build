diff --git a/drivers/input/touchscreen/nt36536/nt36xxx_fw_update.c b/drivers/input/touchscreen/nt36536/nt36xxx_fw_update.c
new file mode 100644
index 000000000..535ddba6c
--- /dev/null
+++ b/drivers/input/touchscreen/nt36536/nt36xxx_fw_update.c
@@ -0,0 +1,901 @@
+/*
+ * Copyright (C) 2010 - 2022 Novatek, Inc.
+ *
+ * $Revision: 77624 $
+ * $Date: 2021-02-05 10:03:05 +0800 (週五, 05 二月 2021) $
