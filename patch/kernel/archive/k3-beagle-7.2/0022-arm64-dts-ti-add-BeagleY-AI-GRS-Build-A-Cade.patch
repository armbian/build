From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Andrei Aldea <andrei1998@gmail.com>
Date: Thu, 6 Aug 2026 11:00:00 -0500
Subject: [PATCH] arm64: dts: ti: build BeagleY-AI accessory overlays

Build independent BeagleY-AI overlays for the GRS Build-A-Cade GPIO control
harness, the Waveshare 4.3-inch DSI panel, and the four-pin PWM fan.  Also
provide an optional composed DTB for systems that prefer a single board
device tree.

Signed-off-by: Andrei Aldea <andrei1998@gmail.com>
---
 arch/arm64/boot/dts/ti/Makefile | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/arch/arm64/boot/dts/ti/Makefile b/arch/arm64/boot/dts/ti/Makefile
--- a/arch/arm64/boot/dts/ti/Makefile
+++ b/arch/arm64/boot/dts/ti/Makefile
@@ -188,5 +188,14 @@ dtb-$(CONFIG_ARCH_K3) += k3-am67a-beagley-ai.dtb
 dtb-$(CONFIG_ARCH_K3) += k3-am67a-beagley-ai-csi0-imx219.dtbo
 dtb-$(CONFIG_ARCH_K3) += k3-am67a-beagley-ai-edgeai-apps.dtbo
+dtb-$(CONFIG_ARCH_K3) += k3-am67a-beagley-ai-grs-build-a-cade-buttons.dtbo
+dtb-$(CONFIG_ARCH_K3) += k3-am67a-beagley-ai-pwm-fan.dtbo
+dtb-$(CONFIG_ARCH_K3) += k3-am67a-beagley-ai-waveshare-4-3-inch-dsi.dtbo
+k3-am67a-beagley-ai-grs-build-a-cade-dtbs := \
+	k3-am67a-beagley-ai.dtb \
+	k3-am67a-beagley-ai-waveshare-4-3-inch-dsi.dtbo \
+	k3-am67a-beagley-ai-grs-build-a-cade-buttons.dtbo \
+	k3-am67a-beagley-ai-pwm-fan.dtbo
+dtb-$(CONFIG_ARCH_K3) += k3-am67a-beagley-ai-grs-build-a-cade.dtb
 k3-am67a-beagley-ai-edgeai-dtbs := k3-am67a-beagley-ai.dtb \
 	 k3-am67a-beagley-ai-edgeai-apps.dtbo
 dtb-$(CONFIG_ARCH_K3) += k3-am67a-beagley-ai-edgeai.dtb
-- 
