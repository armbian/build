From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Andrei Aldea <andrei1998@gmail.com>
Date: Thu, 6 Aug 2026 11:30:00 -0500
Subject: [PATCH] drm/panel: simple: add GRS Waveshare 4.3-inch DSI panel

The 4.3-inch display shipped with the GRS Build-A-Cade is compatible with
the Waveshare 800x480 DSI panel.  It uses one RGB888 data lane and differs
from the Raspberry Pi 7-inch display primarily in its horizontal blanking
and 27.777 MHz pixel clock.

Add a dedicated panel-simple descriptor so mainline kernels can use the
hardware without Raspberry Pi's downstream generic panel-dsi binding.

Signed-off-by: Andrei Aldea <andrei1998@gmail.com>
---
 drivers/gpu/drm/panel/panel-simple.c | 27 +++++++++++++++++++++++++++
 1 file changed, 27 insertions(+)

diff --git a/drivers/gpu/drm/panel/panel-simple.c b/drivers/gpu/drm/panel/panel-simple.c
--- a/drivers/gpu/drm/panel/panel-simple.c
+++ b/drivers/gpu/drm/panel/panel-simple.c
@@ -6472,6 +6472,30 @@ static const struct panel_desc_dsi tsd_tst070wsbe_196c = {
 	.lanes = 4,
 };
 
+static const struct display_timing waveshare_4_3_inch_dsi_timing = {
+	.pixelclock = { 27777000, 27777000, 27777000 },
+	.hactive = { 800, 800, 800 },
+	.hfront_porch = { 59, 59, 59 },
+	.hsync_len = { 2, 2, 2 },
+	.hback_porch = { 45, 45, 45 },
+	.vactive = { 480, 480, 480 },
+	.vfront_porch = { 7, 7, 7 },
+	.vsync_len = { 2, 2, 2 },
+	.vback_porch = { 22, 22, 22 },
+};
+
+static const struct panel_desc_dsi waveshare_4_3_inch_dsi = {
+	.desc = {
+		.timings = &waveshare_4_3_inch_dsi_timing,
+		.num_timings = 1,
+		.bpc = 8,
+		.connector_type = DRM_MODE_CONNECTOR_DSI,
+	},
+	.flags = MIPI_DSI_MODE_VIDEO,
+	.format = MIPI_DSI_FMT_RGB888,
+	.lanes = 1,
+};
+
 static const struct of_device_id dsi_of_match[] = {
 	{
 		.compatible = "auo,b080uan01",
@@ -6494,6 +6518,9 @@ static const struct of_device_id dsi_of_match[] = {
 	}, {
 		.compatible = "team-source-display,tst070wsbe-196c",
 		.data = &tsd_tst070wsbe_196c
+	}, {
+		.compatible = "waveshare,4-3-inch-dsi",
+		.data = &waveshare_4_3_inch_dsi
 	}, {
 		/* sentinel */
 	}
-- 
2.50.1
