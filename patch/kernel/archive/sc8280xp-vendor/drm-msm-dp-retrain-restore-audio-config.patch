From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: SuperKali <hello@superkali.me>
Date: Wed, 5 Aug 2026 20:44:39 +0200
Subject: drm/msm/dp: restore the audio config after an in-place retrain

Link maintenance retrains the link under an active stream but leaves
the audio side alone. The SDP and ACR registers keep the values of the
previous link parameters, so a retrain that settles on a different rate
brings the video back with the audio muted.

Reprogram the audio from the current link parameters after a recovery
retrain and after a link maintenance triggered by a sink request, when
audio was playing.

Signed-off-by: SuperKali <hello@superkali.me>
---
 drivers/gpu/drm/msm/dp/dp_audio.c   | 17 ++++++++++
 drivers/gpu/drm/msm/dp/dp_audio.h   |  2 ++
 drivers/gpu/drm/msm/dp/dp_display.c | 17 ++++++++++
 3 files changed, 36 insertions(+)

diff --git a/drivers/gpu/drm/msm/dp/dp_audio.c b/drivers/gpu/drm/msm/dp/dp_audio.c
index 111111111111..222222222222 100644
--- a/drivers/gpu/drm/msm/dp/dp_audio.c
+++ b/drivers/gpu/drm/msm/dp/dp_audio.c
@@ -333,6 +333,23 @@ void msm_dp_audio_shutdown(struct drm_bridge *bridge,
 	msm_dp_display_signal_audio_complete(msm_dp_display);
 }
 
+void msm_dp_audio_restore(struct msm_dp *msm_dp_display)
+{
+	struct msm_dp_audio_private *audio;
+
+	if (!msm_dp_display->power_on || !msm_dp_display->audio_enabled)
+		return;
+
+	audio = msm_dp_audio_get_data(msm_dp_display);
+	if (IS_ERR(audio))
+		return;
+
+	msm_dp_audio_setup_sdp(audio);
+	msm_dp_audio_setup_acr(audio);
+	msm_dp_audio_safe_to_exit_level(audio);
+	msm_dp_audio_enable(audio, true);
+}
+
 struct msm_dp_audio *msm_dp_audio_get(struct platform_device *pdev,
 			      void __iomem *link_base)
 {
diff --git a/drivers/gpu/drm/msm/dp/dp_audio.h b/drivers/gpu/drm/msm/dp/dp_audio.h
index 111111111111..222222222222 100644
--- a/drivers/gpu/drm/msm/dp/dp_audio.h
+++ b/drivers/gpu/drm/msm/dp/dp_audio.h
@@ -11,6 +11,7 @@
 #include <sound/hdmi-codec.h>
 
 struct drm_bridge;
+struct msm_dp;
 
 /**
  * struct msm_dp_audio
@@ -51,6 +52,7 @@ int msm_dp_audio_prepare(struct drm_bridge *bridge,
 			 struct hdmi_codec_params *params);
 void msm_dp_audio_shutdown(struct drm_bridge *bridge,
 			   struct drm_connector *connector);
+void msm_dp_audio_restore(struct msm_dp *msm_dp_display);
 
 #endif /* _DP_AUDIO_H_ */
 
diff --git a/drivers/gpu/drm/msm/dp/dp_display.c b/drivers/gpu/drm/msm/dp/dp_display.c
index 111111111111..222222222222 100644
--- a/drivers/gpu/drm/msm/dp/dp_display.c
+++ b/drivers/gpu/drm/msm/dp/dp_display.c
@@ -401,6 +401,16 @@ static int msm_dp_display_handle_irq_hpd(struct msm_dp_display_private *dp)
 static void msm_dp_display_handle_plugged_change(struct msm_dp *msm_dp_display,
 		bool plugged);
 
+static void msm_dp_display_audio_restore(struct msm_dp_display_private *dp)
+{
+	if (!dp->audio_supported)
+		return;
+
+	dp->audio->bw_code = drm_dp_link_rate_to_bw_code(dp->link->link_params.rate);
+	dp->audio->lane_count = dp->link->link_params.num_lanes;
+	msm_dp_audio_restore(&dp->msm_dp_display);
+}
+
 static void msm_dp_edid_recheck_work(struct work_struct *work)
 {
 	struct delayed_work *dw = to_delayed_work(work);
@@ -487,6 +497,10 @@ static void msm_dp_hpd_recovery_work(struct work_struct *work)
 	}
 
 	dp->hpd_recovery_tries = 0;
+
+	/* the retrain may have landed on new link parameters */
+	msm_dp_display_audio_restore(dp);
+
 	drm_connector_set_link_status_property(dp->msm_dp_display.connector,
 					       DRM_MODE_LINK_STATUS_GOOD);
 }
@@ -645,6 +659,9 @@ static int msm_dp_irq_hpd_handle(struct msm_dp_display_private *dp)
 	}
 	drm_dp_cec_irq(dp->aux);
 
+	/* link maintenance from a sink request leaves the audio SDPs off */
+	msm_dp_display_audio_restore(dp);
+
 	/* branch devices refresh their EDID cache after raising the irq */
 	if (dp->plugged && drm_dp_is_branch(dp->panel->dpcd)) {
 		dp->edid_recheck_left = EDID_RECHECK_TRIES;
-- 
