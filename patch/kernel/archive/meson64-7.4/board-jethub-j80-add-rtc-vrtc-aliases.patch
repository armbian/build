From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Viacheslav Bocharov <v@baodeep.com>
Date: Tue, 24 Nov 2026 12:00:00 +0300
Subject: arm64: dts: meson: jethub-j80: add rtc/vrtc aliases

The vrtc and the pcf8563 probe in a random order. Add aliases so the
battery-backed pcf8563 is always /dev/rtc0 and the vrtc is /dev/rtc1.

Signed-off-by: Viacheslav Bocharov <v@baodeep.com>
---
 arch/arm64/boot/dts/amlogic/meson-gxl-s905w-jethome-jethub-j80.dts | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/arch/arm64/boot/dts/amlogic/meson-gxl-s905w-jethome-jethub-j80.dts b/arch/arm64/boot/dts/amlogic/meson-gxl-s905w-jethome-jethub-j80.dts
index 111111111111..222222222222 100644
--- a/arch/arm64/boot/dts/amlogic/meson-gxl-s905w-jethome-jethub-j80.dts
+++ b/arch/arm64/boot/dts/amlogic/meson-gxl-s905w-jethome-jethub-j80.dts
@@ -31,6 +31,8 @@
 		serial2 = &uart_AO_B; /* Wireless module 1 */
 		serial3 = &uart_C;    /* Wireless module 2 */
 		ethernet0 = &ethmac;
+		rtc0 = &pcf8563;
+		rtc1 = &vrtc;
 	};
 
 	chosen {
-- 
Armbian

