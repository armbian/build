From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Josema <jomadeto@gmail.com>
Date: Mon, 28 Sep 2026 15:49:31 +0000
Subject: general: aml-c400-plus: pin runtime-PM on panfrost probe and reset
 Documentation/devicetree/bindings/gpu/arm,mali-midgard.yaml
 drivers/gpu/drm/panfrost/panfrost_device.c

Signed-off-by: Josema <jomadeto@gmail.com>
---
 Documentation/devicetree/bindings/gpu/arm,mali-midgard.yaml |  5 +++
 drivers/gpu/drm/panfrost/panfrost_device.c                  | 16 +++++++++-
 2 files changed, 20 insertions(+), 1 deletion(-)

diff --git a/Documentation/devicetree/bindings/gpu/arm,mali-midgard.yaml b/Documentation/devicetree/bindings/gpu/arm,mali-midgard.yaml
index 111111111111..222222222222 100644
--- a/Documentation/devicetree/bindings/gpu/arm,mali-midgard.yaml
+++ b/Documentation/devicetree/bindings/gpu/arm,mali-midgard.yaml
@@ -118,6 +118,11 @@ properties:
 
       where voltage is in V, frequency is in MHz.
 
+  linux,pin-runtime-pm-probe:
+    type: boolean
+    description:
+      Forces the driver to pin runtime-PM resources during the initialization probe sequence.
+
 required:
   - compatible
   - reg
diff --git a/drivers/gpu/drm/panfrost/panfrost_device.c b/drivers/gpu/drm/panfrost/panfrost_device.c
index 111111111111..222222222222 100644
--- a/drivers/gpu/drm/panfrost/panfrost_device.c
+++ b/drivers/gpu/drm/panfrost/panfrost_device.c
@@ -4,6 +4,7 @@
 
 #include <linux/debugfs.h>
 #include <linux/clk.h>
+#include <linux/of.h>
 #include <linux/reset.h>
 #include <linux/platform_device.h>
 #include <linux/pm_domain.h>
@@ -339,6 +340,14 @@ int panfrost_device_init(struct panfrost_device *pfdev)
 	pm_runtime_set_active(pfdev->base.dev);
 	pm_runtime_mark_last_busy(pfdev->base.dev);
 	pm_runtime_enable(pfdev->base.dev);
+	if (of_property_read_bool(pfdev->base.dev->of_node, "linux,pin-runtime-pm-probe")) {
+		err = pm_runtime_resume_and_get(pfdev->base.dev);
+		if (err < 0) {
+			dev_err(pfdev->base.dev, "Fatal: GPU power interconnect anchor failed: %d\n", err);
+			goto err_disable_rpm;
+		}
+		panfrost_mmu_reset(pfdev);
+	}
 	pm_runtime_set_autosuspend_delay(pfdev->base.dev, 50); /* ~3 frames */
 	pm_runtime_use_autosuspend(pfdev->base.dev);
 
@@ -348,12 +357,15 @@ int panfrost_device_init(struct panfrost_device *pfdev)
 	 */
 	err = drm_dev_register(&pfdev->base, 0);
 	if (err < 0)
-		goto err_disable_rpm;
+		goto err_pm_put;
 
 	pm_runtime_put_autosuspend(pfdev->base.dev);
 
 	return 0;
 
+err_pm_put:
+	if (of_property_read_bool(pfdev->base.dev->of_node, "linux,pin-runtime-pm-probe"))
+		pm_runtime_put_noidle(pfdev->base.dev);
 err_disable_rpm:
 	pm_runtime_dont_use_autosuspend(pfdev->base.dev);
 	pm_runtime_disable(pfdev->base.dev);
@@ -405,6 +417,8 @@ void panfrost_device_fini(struct panfrost_device *pfdev)
 
 	pm_runtime_set_suspended(pfdev->base.dev);
 	pm_runtime_put_noidle(pfdev->base.dev);
+	if (of_property_read_bool(pfdev->base.dev->of_node, "linux,pin-runtime-pm-probe"))
+		pm_runtime_put_noidle(pfdev->base.dev);
 }
 
 #define PANFROST_EXCEPTION(id) \
-- 
Armbian

