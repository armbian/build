From 875ac608b5a228e7d7225e9e00f5e055ff58ff6b Mon Sep 17 00:00:00 2001
From: retro98boy <retro98boy@qq.com>
Date: Thu, 1 Oct 2026 20:02:51 +0800
Subject: [PATCH] mmc: sdhci-msm: force PIO on lenovo elden for reset isolation

---
 drivers/mmc/host/sdhci-msm.c | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/drivers/mmc/host/sdhci-msm.c b/drivers/mmc/host/sdhci-msm.c
index 0882ce74e..9d1f87a95 100644
--- a/drivers/mmc/host/sdhci-msm.c
+++ b/drivers/mmc/host/sdhci-msm.c
@@ -2887,6 +2887,15 @@ static int sdhci_msm_probe(struct platform_device *pdev)
 	host->mmc_host_ops.start_signal_voltage_switch =
 		sdhci_msm_start_signal_voltage_switch;
 	host->mmc_host_ops.execute_tuning = sdhci_msm_execute_tuning;
+	/* Temporary board-local DMA isolation; keep all platform quirks. */
+	if (of_machine_is_compatible("lenovo,elden") &&
+	    of_device_is_compatible(node, "qcom,sm8750-sdhci") &&
+	    of_property_read_bool(node, "no-mmc")) {
+		host->quirks |= SDHCI_QUIRK_BROKEN_DMA |
+				SDHCI_QUIRK_BROKEN_ADMA;
+		dev_warn(&pdev->dev, "lenovo elden: forcing PIO (SDMA/ADMA disabled)\n");
+	}
+
 	if (of_property_read_bool(node, "supports-cqe"))
 		ret = sdhci_msm_cqe_add_host(host, pdev);
 	else
-- 
2.55.0

