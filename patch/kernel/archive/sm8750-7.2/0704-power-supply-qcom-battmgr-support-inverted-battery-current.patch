Subject: [PATCH] power: supply: qcom_battmgr: support inverted battery current

Lenovo Y700 Gen4 firmware reports negative charging current and positive
discharging current. Allow the board to opt into sign inversion so that
userspace does not override Charging with Discharging. Preserve the
default behavior and reject INT_MIN before negation.

Based on the GEEKiDoS-linux Lenovo Y700 Gen4 implementation.

---
--- a/drivers/power/supply/qcom_battmgr.c
+++ b/drivers/power/supply/qcom_battmgr.c
@@ -325,6 +325,7 @@
 	struct completion ack;
 
 	bool service_up;
+	bool current_inverted;
 
 	struct qcom_battmgr_info info;
 	struct qcom_battmgr_status status;
@@ -561,6 +562,12 @@
 		break;
 	case POWER_SUPPLY_PROP_CURRENT_NOW:
 		val->intval = battmgr->status.current_now;
+		/* Some firmware reports charging current with a negative sign. */
+		if (battmgr->current_inverted) {
+			if (val->intval == INT_MIN)
+				return -ERANGE;
+			val->intval = -val->intval;
+		}
 		break;
 	case POWER_SUPPLY_PROP_POWER_NOW:
 		val->intval = battmgr->status.power_now;
@@ -1640,6 +1647,8 @@
 		return -ENOMEM;
 
 	battmgr->dev = dev;
+	battmgr->current_inverted = device_property_read_bool(dev->parent,
+							      "qcom,battery-current-inverted");
 
 	psy_cfg.drv_data = battmgr;
 	psy_cfg.fwnode = dev_fwnode(&adev->dev);
