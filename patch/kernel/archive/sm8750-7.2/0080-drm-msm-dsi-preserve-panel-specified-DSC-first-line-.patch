From 1e3b2c325d2bbba439c62606c805d8ce44bbeaf2 Mon Sep 17 00:00:00 2001
From: retro98boy <retro98boy@qq.com>
Date: Wed, 14 Oct 2026 11:57:26 +0800
Subject: [PATCH 2/2] drm/msm/dsi: preserve panel-specified DSC first-line BPG
 offset

---
 drivers/gpu/drm/msm/dsi/dsi_host.c | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/drivers/gpu/drm/msm/dsi/dsi_host.c b/drivers/gpu/drm/msm/dsi/dsi_host.c
index 63c517b97..aca062599 100644
--- a/drivers/gpu/drm/msm/dsi/dsi_host.c
+++ b/drivers/gpu/drm/msm/dsi/dsi_host.c
@@ -1882,6 +1882,7 @@ static int dsi_host_parse_lane_data(struct msm_dsi_host *msm_host,
 
 static int dsi_populate_dsc_params(struct msm_dsi_host *msm_host, struct drm_dsc_config *dsc)
 {
+	u8 first_line_bpg_offset = dsc->first_line_bpg_offset;
 	int ret;
 
 	if (dsc->bits_per_pixel & 0xf) {
@@ -1945,6 +1946,10 @@ static int dsi_populate_dsc_params(struct msm_dsi_host *msm_host, struct drm_dsc
 		return ret;
 	}
 
+	/* A panel-specified first-line budget takes precedence over the table. */
+	if (first_line_bpg_offset)
+		dsc->first_line_bpg_offset = first_line_bpg_offset;
+
 	dsc->initial_scale_value = drm_dsc_initial_scale_value(dsc);
 	dsc->line_buf_depth = dsc->bits_per_component + 1;
 
-- 
2.56.0

