From: retro98boy <retro98boy@qq.com>
Subject: [PATCH] drm/panel: novatek-nt36536: expose only 120 Hz on Lenovo Elden

Limit the Lenovo Y700 Gen4 connector's advertised modes to 120 Hz so
userspace cannot select the other refresh rates from its mode list.
Keep the full mode list on other machines using this panel driver.

Count the modes actually added and mark the first accepted mode preferred.

---
 drivers/gpu/drm/panel/panel-novatek-nt36536.c | 10 ++++++++--
 1 file changed, 8 insertions(+), 2 deletions(-)

diff --git a/drivers/gpu/drm/panel/panel-novatek-nt36536.c b/drivers/gpu/drm/panel/panel-novatek-nt36536.c
--- a/drivers/gpu/drm/panel/panel-novatek-nt36536.c
+++ b/drivers/gpu/drm/panel/panel-novatek-nt36536.c
@@ -147,12 +147,17 @@ static int novatek_get_modes(struct drm_panel *panel,
 {
 	struct novatek *ctx = to_novatek(panel);
 	const struct panel_desc *desc = ctx->desc;
+	bool only_120hz = of_machine_is_compatible("lenovo,elden");
+	int num_modes = 0;
 	int i;
 
 	for (i = 0; i < desc->num_modes; i++) {
 		const struct drm_display_mode *m = &desc->modes[i];
 		struct drm_display_mode *mode;
 
+		if (only_120hz && drm_mode_vrefresh(m) != 120)
+			continue;
+
 		mode = drm_mode_duplicate(connector->dev, m);
 		if (!mode) {
 			dev_err(panel->dev, "failed to add mode %ux%u@%u\n",
@@ -161,18 +166,19 @@ static int novatek_get_modes(struct drm_panel *panel,
 		}
 
 		mode->type = DRM_MODE_TYPE_DRIVER;
-		if (i == 0)
+		if (num_modes == 0)
 			mode->type |= DRM_MODE_TYPE_PREFERRED;
 
 		drm_mode_set_name(mode);
 		drm_mode_probed_add(connector, mode);
+		num_modes++;
 	}
 
 	connector->display_info.width_mm = desc->width_mm;
 	connector->display_info.height_mm = desc->height_mm;
 	connector->display_info.bpc = desc->bpc;
 
-	return desc->num_modes;
+	return num_modes;
 }
 
 static const struct drm_panel_funcs novatek_panel_funcs = {
