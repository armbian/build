From 073a233e6e5ad635eeb6be000c8710a879020e4c Mon Sep 17 00:00:00 2001
From: Anze <aanzdev@gmail.com>
Date: Mon, 27 Jul 2026 18:00:00 +0200
Subject: [PATCH] usb: typec: mux: initialize duplicate-filter arrays

The switch and mux match callbacks scan every slot in the output arrays
to skip duplicates. fwnode_connection_find_matches() populates those arrays
incrementally without clearing them first, so a valid device can be
discarded by a comparison against an uninitialized stack value.

Zero-initialize both arrays before passing them to the lookup helper.
Linux 7.2.6 already defers probing when either provider is not registered.

Signed-off-by: Anze <aanzdev@gmail.com>
---
 drivers/usb/typec/mux.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/drivers/usb/typec/mux.c b/drivers/usb/typec/mux.c
index afa6fc181397..37f87d3d6b92 100644
--- a/drivers/usb/typec/mux.c
+++ b/drivers/usb/typec/mux.c
@@ -81,7 +81,7 @@ static void *typec_switch_match(const struct fwnode_handle *fwnode,
  */
 struct typec_switch *fwnode_typec_switch_get(struct fwnode_handle *fwnode)
 {
-	struct typec_switch_dev *sw_devs[TYPEC_MUX_MAX_DEVS];
+	struct typec_switch_dev *sw_devs[TYPEC_MUX_MAX_DEVS] = {};
 	struct typec_switch *sw;
 	int count;
 	int err;
@@ -319,7 +319,7 @@ static void *typec_mux_match(const struct fwnode_handle *fwnode,
  */
 struct typec_mux *fwnode_typec_mux_get(struct fwnode_handle *fwnode)
 {
-	struct typec_mux_dev *mux_devs[TYPEC_MUX_MAX_DEVS];
+	struct typec_mux_dev *mux_devs[TYPEC_MUX_MAX_DEVS] = {};
 	struct typec_mux *mux;
 	int count;
 	int err;
-- 
2.56.0

