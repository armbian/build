From 023af7b3773add2f47a261fb7e88acc92822b3e2 Mon Sep 17 00:00:00 2001
From: GEEKiDoS <geek_ds@foxmail.com>
Date: Sun, 27 Sep 2026 17:05:28 +0800
Subject: [PATCH] ASoC: codecs: add AW88461 speaker amplifier support

from https://github.com/GEEKiDoS/linux/blob/ba28ec16f01f59ba8f5099e8af9e95b061fc5c78/sound/soc/codecs/aw88461.c

Retain the validated tuning section to recover from a latched fault on a
subsequent playback attempt. Replay the muted profile and cached I2S format
before normal startup checks; any recovery failure keeps reset asserted.
Do not retry continuously or bypass PLL and amplifier fault checks.
---
 sound/soc/codecs/Kconfig   |  13 +
 sound/soc/codecs/Makefile  |   2 +
 sound/soc/codecs/aw88461.c | 610 +++++++++++++++++++++++++++++++++++++
 3 files changed, 625 insertions(+)
 create mode 100644 sound/soc/codecs/aw88461.c

diff --git a/sound/soc/codecs/Kconfig b/sound/soc/codecs/Kconfig
index 269c31ce0..7a333a49d 100644
--- a/sound/soc/codecs/Kconfig
+++ b/sound/soc/codecs/Kconfig
@@ -658,6 +658,19 @@ config SND_SOC_AW8738
 	  SND_SOC_SIMPLE_AMPLIFIER, but additionally allows setting the
 	  operation mode using the Awinic-specific one-wire pulse control.
 
+config SND_SOC_AW88461
+	tristate "Awinic AW88461 I2S amplifier"
+	depends on I2C
+	select REGMAP_I2C
+	select GPIOLIB
+	select FW_LOADER
+	select SND_SOC_AW88395_LIB
+	help
+	  Enable playback through the Awinic AW88461 amplifier, using the
+	  speaker tuning image named in devicetree.
+	  To compile this driver as a module, choose M here: the module
+	  will be called snd-soc-aw88461.
+
 config SND_SOC_AW88395_LIB
 	select CRC8
 	tristate
