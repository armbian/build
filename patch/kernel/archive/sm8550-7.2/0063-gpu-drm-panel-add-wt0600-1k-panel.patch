From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ROCKNIX <dev@rocknix.org>
Date: Fri, 15 May 2026 11:16:53 +0000
Subject: [PATCH] gpu: drm: panel: add wt0600 1080p single-DSI panel

The Ayaneo Pocket S 1K uses a WT0600 panel driven by a single DSI host at
1080x1920, while the Pocket S 2K variant uses a dual-DSI 1440x2560 panel.

Add a separate driver rather than extending panel-wt0600-2k.c, so the
already shipping dual-DSI panel keeps its validated power sequence and
init path untouched.

Signed-off-by: ROCKNIX <dev@rocknix.org>
---
diff --git a/drivers/gpu/drm/panel/Kconfig b/drivers/gpu/drm/panel/Kconfig
index 3bea8d9..0b97fe6 100644
--- a/drivers/gpu/drm/panel/Kconfig
+++ b/drivers/gpu/drm/panel/Kconfig
@@ -1381,6 +1381,18 @@ config DRM_PANEL_AYANEO_WT0600_2K
 
 	  To compile this driver as a module, choose M here.
 
+config DRM_PANEL_AYANEO_WT0600_1K
+	tristate "Ayaneo WT0600 1080p single-DSI video mode panel"
+	depends on OF
+	depends on DRM_MIPI_DSI
+	depends on BACKLIGHT_CLASS_DEVICE
+	help
+	  Say Y here if you want to enable support for the Ayaneo WT0600
+	  1080x1920 60Hz single-DSI video mode display panel. This panel is
+	  used in the Ayaneo Pocket S 1K handheld gaming device.
+
+	  To compile this driver as a module, choose M here.
+
 config DRM_PANEL_XINPENG_XPP055C272
 	tristate "Xinpeng XPP055C272 panel driver"
 	depends on OF
diff --git a/drivers/gpu/drm/panel/Makefile b/drivers/gpu/drm/panel/Makefile
index 3670d6b..7809502 100644
--- a/drivers/gpu/drm/panel/Makefile
+++ b/drivers/gpu/drm/panel/Makefile
@@ -136,4 +136,5 @@ obj-$(CONFIG_DRM_PANEL_VISIONOX_VTDR6130_COG) += panel-visionox-vtdr6130-cog.o
 obj-$(CONFIG_DRM_PANEL_VISIONOX_R66451) += panel-visionox-r66451.o
 obj-$(CONFIG_DRM_PANEL_WIDECHIPS_WS2401) += panel-widechips-ws2401.o
 obj-$(CONFIG_DRM_PANEL_AYANEO_WT0600_2K) += panel-wt0600-2k.o
+obj-$(CONFIG_DRM_PANEL_AYANEO_WT0600_1K) += panel-wt0600-1k.o
 obj-$(CONFIG_DRM_PANEL_XINPENG_XPP055C272) += panel-xinpeng-xpp055c272.o
diff --git a/drivers/gpu/drm/panel/panel-wt0600-1k.c b/drivers/gpu/drm/panel/panel-wt0600-1k.c
new file mode 100644
index 0000000..fbf3446
--- /dev/null
+++ b/drivers/gpu/drm/panel/panel-wt0600-1k.c
@@ -0,0 +1,275 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * DRM driver for wt0600 1080p single-DSI video mode panel
+ *
+ * Copyright (c) 2026, ROCKNIX <dev@rocknix.org>
+ *
+ * Based on panel-wt0600-2k.c
+ * Copyright (c) 2025, Kancy Joe <kancy2333@outlook.com>
+ */
+
+#include <linux/backlight.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/regulator/consumer.h>
+
+#include <video/mipi_display.h>
+
+#include <drm/drm_connector.h>
+#include <drm/drm_mipi_dsi.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_panel.h>
+#include <drm/drm_probe_helper.h>
+
+struct wt0600_1k_panel {
+	struct drm_panel panel;
+	struct mipi_dsi_device *dsi;
+	const struct panel_desc *desc;
+
+	struct gpio_desc *reset_gpio;
+	struct regulator_bulk_data *supplies;
+	enum drm_panel_orientation orientation;
+};
+
+static const struct regulator_bulk_data panel_supplies[] = {
+	{ .supply = "avdd" },
+	{ .supply = "avee" },
+};
+
+struct panel_desc {
+	const struct drm_display_mode *mode;
+	unsigned int lanes;
+	unsigned long mode_flags;
+	enum mipi_dsi_pixel_format format;
+	uint16_t height_mm;
+	uint16_t width_mm;
+};
+
+static const struct drm_display_mode wt0600_1k_mode = {
+	.clock = (1080 + 66 + 8 + 22) * (1920 + 9 + 2 + 14) * 60 / 1000,
+	.hdisplay = 1080,
+	.hsync_start = 1080 + 66,
+	.hsync_end = 1080 + 66 + 8,
+	.htotal = 1080 + 66 + 8 + 22,
+	.vdisplay = 1920,
+	.vsync_start = 1920 + 9,
+	.vsync_end = 1920 + 9 + 2,
+	.vtotal = 1920 + 9 + 2 + 14,
+	.type = DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED,
+};
+
+static const struct panel_desc wt0600_1k_desc = {
+	.lanes = 4,
+	.width_mm = 74,
+	.height_mm = 131,
+	.mode = &wt0600_1k_mode,
+	.mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_BURST |
+		      MIPI_DSI_CLOCK_NON_CONTINUOUS | MIPI_DSI_MODE_LPM,
+	.format = MIPI_DSI_FMT_RGB888,
+};
+
+static inline struct wt0600_1k_panel *to_wt0600_1k_panel(struct drm_panel *panel)
+{
+	return container_of(panel, struct wt0600_1k_panel, panel);
+}
+
+static void wt0600_1k_reset(struct wt0600_1k_panel *ctx)
+{
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	usleep_range(10000, 11000);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	usleep_range(10000, 11000);
+	msleep(55);
+}
+
+static int wt0600_1k_on(struct wt0600_1k_panel *ctx)
+{
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+
+	mipi_dsi_dcs_exit_sleep_mode_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 50);
+
+	mipi_dsi_dcs_set_display_on_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 150);
+
+	return dsi_ctx.accum_err;
+}
+
+static int wt0600_1k_disable(struct drm_panel *panel)
+{
+	struct wt0600_1k_panel *ctx = to_wt0600_1k_panel(panel);
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+
+	mipi_dsi_dcs_set_display_off_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 50);
+
+	mipi_dsi_dcs_enter_sleep_mode_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 120);
+
+	return dsi_ctx.accum_err;
+}
+
+static int wt0600_1k_prepare(struct drm_panel *panel)
+{
+	struct wt0600_1k_panel *ctx = to_wt0600_1k_panel(panel);
+	int ret;
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(panel_supplies), ctx->supplies);
+	if (ret < 0)
+		return ret;
+
+	wt0600_1k_reset(ctx);
+
+	ret = wt0600_1k_on(ctx);
+	if (ret < 0) {
+		dev_err(panel->dev, "Failed to initialize panel: %d\n", ret);
+		gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+		regulator_bulk_disable(ARRAY_SIZE(panel_supplies), ctx->supplies);
+		return ret;
+	}
+
+	return 0;
+}
+
+static int wt0600_1k_unprepare(struct drm_panel *panel)
+{
+	struct wt0600_1k_panel *ctx = to_wt0600_1k_panel(panel);
+
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+
+	regulator_bulk_disable(ARRAY_SIZE(panel_supplies), ctx->supplies);
+
+	return 0;
+}
+
+static int wt0600_1k_get_modes(struct drm_panel *panel,
+			       struct drm_connector *connector)
+{
+	struct drm_display_mode *mode;
+	struct wt0600_1k_panel *ctx = to_wt0600_1k_panel(panel);
+
+	mode = drm_mode_duplicate(connector->dev, ctx->desc->mode);
+	if (!mode)
+		return -ENOMEM;
+
+	/* Update panel size */
+	mode->width_mm = ctx->desc->width_mm;
+	mode->height_mm = ctx->desc->height_mm;
+
+	drm_mode_set_name(mode);
+	connector->display_info.width_mm = mode->width_mm;
+	connector->display_info.height_mm = mode->height_mm;
+	drm_mode_probed_add(connector, mode);
+
+	return 1;
+}
+
+static enum drm_panel_orientation
+wt0600_1k_get_orientation(struct drm_panel *panel)
+{
+	struct wt0600_1k_panel *ctx = to_wt0600_1k_panel(panel);
+
+	return ctx->orientation;
+}
+
+static const struct drm_panel_funcs wt0600_1k_panel_funcs = {
+	.disable = wt0600_1k_disable,
+	.prepare = wt0600_1k_prepare,
+	.unprepare = wt0600_1k_unprepare,
+	.get_modes = wt0600_1k_get_modes,
+	.get_orientation = wt0600_1k_get_orientation,
+};
+
+static int wt0600_1k_probe(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	struct wt0600_1k_panel *ctx;
+	int ret;
+
+	ctx = devm_drm_panel_alloc(dev, struct wt0600_1k_panel, panel,
+				   &wt0600_1k_panel_funcs, DRM_MODE_CONNECTOR_DSI);
+	if (IS_ERR(ctx))
+		return PTR_ERR(ctx);
+
+	ctx->desc = of_device_get_match_data(dev);
+	if (!ctx->desc)
+		return dev_err_probe(dev, -ENODEV,
+				     "Failed to get panel description\n");
+
+	/*
+	 * The panel rails come from an SGM3804: avdd is its positive output,
+	 * avee its negative one. Both must be up before the init sequence.
+	 */
+	ret = devm_regulator_bulk_get_const(dev, ARRAY_SIZE(panel_supplies),
+					    panel_supplies, &ctx->supplies);
+	if (ret < 0)
+		return dev_err_probe(dev, ret, "Failed to get panel regulators\n");
+
+	ctx->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(ctx->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(ctx->reset_gpio),
+				     "Failed to get reset gpio\n");
+
+	/* Get panel orientation */
+	ret = of_drm_get_panel_orientation(dev->of_node, &ctx->orientation);
+	if (ret < 0 && ret != -ENODEV)
+		return dev_err_probe(dev, ret,
+				     "Failed to get panel orientation\n");
+
+	ctx->dsi = dsi;
+	mipi_dsi_set_drvdata(dsi, ctx);
+
+	ctx->panel.prepare_prev_first = true;
+
+	ret = drm_panel_of_backlight(&ctx->panel);
+	if (ret)
+		return dev_err_probe(dev, ret, "Failed to get backlight\n");
+
+	drm_panel_add(&ctx->panel);
+
+	dsi->lanes = ctx->desc->lanes;
+	dsi->format = ctx->desc->format;
+	dsi->mode_flags = ctx->desc->mode_flags;
+
+	ret = mipi_dsi_attach(dsi);
+	if (ret < 0) {
+		drm_panel_remove(&ctx->panel);
+		return dev_err_probe(dev, ret, "Failed to attach DSI device\n");
+	}
+
+	return 0;
+}
+
+static void wt0600_1k_remove(struct mipi_dsi_device *dsi)
+{
+	struct wt0600_1k_panel *ctx = mipi_dsi_get_drvdata(dsi);
+
+	mipi_dsi_detach(ctx->dsi);
+
+	drm_panel_remove(&ctx->panel);
+}
+
+static const struct of_device_id wt0600_1k_of_match[] = {
+	{
+		.compatible = "ayaneo,wt0600-1080p-60hz",
+		.data = &wt0600_1k_desc,
+	},
+	{}
+};
+MODULE_DEVICE_TABLE(of, wt0600_1k_of_match);
+
+static struct mipi_dsi_driver wt0600_1k_driver = {
+	.probe = wt0600_1k_probe,
+	.remove = wt0600_1k_remove,
+	.driver = {
+		.name = "panel-wt0600-1k",
+		.of_match_table = wt0600_1k_of_match,
+	},
+};
+module_mipi_dsi_driver(wt0600_1k_driver);
+
+MODULE_AUTHOR("ROCKNIX <dev@rocknix.org>");
+MODULE_DESCRIPTION("DRM driver for wt0600 1080p single-dsi video mode panel");
+MODULE_LICENSE("GPL");
-- 
2.53.0
