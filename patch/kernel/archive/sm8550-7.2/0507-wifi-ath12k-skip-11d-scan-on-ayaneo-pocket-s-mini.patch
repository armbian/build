From 6f5f1aa6cc762e28c2602fb2d64d87ce89627153 Mon Sep 17 00:00:00 2001
From: danyi <mydanyi@users.noreply.github.com>
Date: Wed, 12 Aug 2026 20:25:00 +0800
Subject: [PATCH] wifi: ath12k: allow disabling 11d scan from device tree

The WCN7850 firmware on some platforms can leave its scan engine unable to
start normal scans after the driver's 11d offload is started and then
stopped during association. Once this happens, every later request gets
WMI_SCAN_EVENT_START_FAILED and 5 GHz networks disappear until the device
is power-cycled.

Add a qcom,skip-11d-scan-offload device tree property so affected
platforms can skip the optional 11d offload while leaving it enabled for
unaffected devices.

Signed-off-by: danyi <mydanyi@users.noreply.github.com>
---
 .../bindings/net/wireless/qcom,ath12k.yaml    | 5 +++++
 drivers/net/wireless/ath/ath12k/mac.c         | 7 +++++++
 2 files changed, 12 insertions(+)

diff --git a/Documentation/devicetree/bindings/net/wireless/qcom,ath12k.yaml b/Documentation/devicetree/bindings/net/wireless/qcom,ath12k.yaml
index dc68dd59988f..3de37a4b577e 100644
--- a/Documentation/devicetree/bindings/net/wireless/qcom,ath12k.yaml
+++ b/Documentation/devicetree/bindings/net/wireless/qcom,ath12k.yaml
@@ -27,6 +27,11 @@ properties:
       If present, a board or platform specific string used to lookup
       usecase-specific firmware files for the device.

+  qcom,skip-11d-scan-offload:
+    type: boolean
+    description:
+      Disable the firmware 11d scan offload on affected platforms.
+
   vddaon-supply:
     description: VDD_AON supply regulator handle

diff --git a/drivers/net/wireless/ath/ath12k/mac.c b/drivers/net/wireless/ath/ath12k/mac.c
index 830976ad5f00..051c23038241 100644
--- a/drivers/net/wireless/ath/ath12k/mac.c
+++ b/drivers/net/wireless/ath/ath12k/mac.c
@@ -6,6 +6,7 @@
 #include <net/mac80211.h>
 #include <net/cfg80211.h>
 #include <linux/etherdevice.h>
+#include <linux/of.h>
 
 #include "mac.h"
 #include "core.h"
@@ -10181,6 +10182,12 @@ void ath12k_mac_11d_scan_start(struct ath12k *ar, u32 vdev_id)
 
 	lockdep_assert_wiphy(ath12k_ar_to_hw(ar)->wiphy);
 
+	if (of_property_read_bool(dev_of_node(ar->ab->dev),
+				  "qcom,skip-11d-scan-offload")) {
+		ath12k_info(ar->ab, "skipping 11d scan offload\n");
+		goto fin;
+	}
+
 	if (ar->regdom_set_by_user)
 		goto fin;
 
-- 
2.43.0
