+
+static int ar16_4inch_off(struct ar16_4inch *ctx)
+{
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+
+	ctx->dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x28, 0x00);
+	mipi_dsi_msleep(&dsi_ctx, 120);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x10, 0x00);
+	mipi_dsi_msleep(&dsi_ctx, 10);
+
+	return dsi_ctx.accum_err;
+}
+
+static int ar16_4inch_prepare(struct drm_panel *panel)
+{
+	struct ar16_4inch *ctx = to_ar16_4inch(panel);
+	int ret;
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(ar16_4inch_supplies),
+				    ctx->supplies);
+	if (ret < 0)
+		return ret;
+
+	msleep(20);
+	ar16_4inch_reset(ctx);
+
+	ret = ar16_4inch_on(ctx);
+	if (ret < 0) {
+		dev_err(panel->dev, "failed to initialize panel: %d\n", ret);
+		gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+		regulator_bulk_disable(ARRAY_SIZE(ar16_4inch_supplies),
+				       ctx->supplies);
+	}
+
+	return ret;
+}
+
+static int ar16_4inch_unprepare(struct drm_panel *panel)
+{
+	struct ar16_4inch *ctx = to_ar16_4inch(panel);
+	int ret;
+
+	ret = ar16_4inch_off(ctx);
+	if (ret < 0)
+		dev_err(panel->dev, "failed to uninitialize panel: %d\n", ret);
+
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	regulator_bulk_disable(ARRAY_SIZE(ar16_4inch_supplies), ctx->supplies);
+
+	return 0;
+}
+
