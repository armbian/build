From 894e7c87039d9eacc00188250aa6454907b91874 Mon Sep 17 00:00:00 2001
From: danyi <mydanyi@users.noreply.github.com>
Date: Mon, 10 Aug 2026 05:24:58 +0800
Subject: [PATCH] drm/panel: add AYANEO Pocket S Mini AR16 panel

Add support for the 1280x960 AR16 video-mode panel used by the AYANEO
Pocket S Mini. The driver manages the three panel supplies, reset GPIO,
backlight, orientation, and the stock four-lane MIPI DSI command sequence.

The initialization data was recovered from the shipping device tree; no
panel firmware is embedded or updated.

Signed-off-by: danyi <mydanyi@users.noreply.github.com>
---
 drivers/gpu/drm/panel/Kconfig            |  14 +
 drivers/gpu/drm/panel/Makefile           |   1 +
 drivers/gpu/drm/panel/panel-ar16-4inch.c | 401 +++++++++++++++++++++++
 3 files changed, 416 insertions(+)
 create mode 100644 drivers/gpu/drm/panel/panel-ar16-4inch.c

diff --git a/drivers/gpu/drm/panel/Kconfig b/drivers/gpu/drm/panel/Kconfig
index 2365617..5d27a91 100644
--- a/drivers/gpu/drm/panel/Kconfig
+++ b/drivers/gpu/drm/panel/Kconfig
@@ -1312,6 +1312,20 @@ config DRM_PANEL_AYANEO_WT0600_1K
 
 	  To compile this driver as a module, choose M here.
 
+config DRM_PANEL_AYANEO_AR16_4INCH
+	tristate "AYANEO AR16 4-inch video mode panel"
+	depends on OF
+	depends on DRM_MIPI_DSI
+	depends on BACKLIGHT_CLASS_DEVICE
+	select DRM_DISPLAY_HELPER
+	help
+	  Say Y here if you want to enable support for the 1280x960 60 Hz
+	  AR16 4-inch video mode panel used by the AYANEO Pocket S Mini.
+	  The driver controls the panel reset, supply rails and backlight, and
+	  sends the stock initialization sequence over a four-lane DSI link.
+
+	  To compile this driver as a module, choose M here.
+
 config DRM_PANEL_XINPENG_XPP055C272
 	tristate "Xinpeng XPP055C272 panel driver"
 	depends on OF
