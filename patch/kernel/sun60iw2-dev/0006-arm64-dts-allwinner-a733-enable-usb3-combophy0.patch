From: Juan Sanchez <juanesf91@gmail.com>
Subject: [PATCH] arm64: dts: allwinner: a733: enable USB 3.x via combophy0

Enable USB 3.x on the blue USB-A port. Without a usb3-phy, DWC3 has no
SuperSpeed lane and the UHS-II card reader falls back to 480 Mbps on
ehci-platform:

  - Add the combophy0 node (0x06c01000 / 0x06c80000 / 0x06c06000) and
    wire it to dwc3 as usb3-phy with super-speed-plus.
  - Disable U1, U2 and U3 link states. Link training does not complete
    reliably with these low-power states enabled on A733.
  - Drop CLK_SERDES_USB3_PIPE from assigned-clocks. combophy0 clears
    USB3P1_ONLY_PIPE_CLK_SEL and drives PIPE from its own PLL, so the
    USB2-side PIPE parent from 0001 must be removed.

Signed-off-by: Juan Sanchez <juanesf91@gmail.com>
Assisted-by: OpenCode (Big Pickle) <noreply@opencode.ai>
---
--- a/arch/arm64/boot/dts/allwinner/sun60i-a733.dtsi
+++ b/arch/arm64/boot/dts/allwinner/sun60i-a733.dtsi
@@ -921,13 +921,16 @@
 				compatible = "snps,dwc3";
 				reg = <0x06a00000 0x100000>;
 				interrupts = <GIC_SPI 155 IRQ_TYPE_LEVEL_HIGH>;
-				phys = <&usbphy 2>;
-				phy-names = "usb2-phy";
+				phys = <&usbphy 2>, <&combophy0>;
+				phy-names = "usb2-phy", "usb3-phy";
 				phy_type = "utmi";
 				dr_mode = "host";
-				maximum-speed = "high-speed";
+				maximum-speed = "super-speed-plus";
+				snps,dis_u3_susphy_quirk;
 				snps,dis_u2_susphy_quirk;
 				snps,dis_enblslpm_quirk;
+				snps,dis-u1-entry-quirk;
+				snps,dis-u2-entry-quirk;
 				/* VBUS is provided by an always-on switch (PM5); the
 				 * xHCI here never re-asserts PP after its reset, so
 				 * skip dwc3_power_off_all_roothub_ports(). */
@@ -999,6 +1002,20 @@
 			#reset-cells = <1>;
 		};
 
+		combophy0: phy@6c01000 {
+			compatible = "allwinner,sun60i-a733-usb3-phy";
+			reg = <0x06c01000 0xa00>,
+			      <0x06c80000 0x20000>,
+			      <0x06c06000 0x2000>;
+			reg-names = "top", "phy", "pipe";
+			clocks = <&ccu CLK_SERDES_PHY>, <&rtc CLK_HOSC_SERDES0>;
+			clock-names = "cfg", "ref";
+			allwinner,serdes = <&serdes_ccu>;
+			power-domains = <&pck600 PD_PCIE>;
+			#phy-cells = <0>;
+			status = "disabled";
+		};
+
 		combophy1: phy@6c02000 {
 			compatible = "allwinner,sun60i-a733-combophy";
 			reg = <0x06c02000 0xa00>,
--- a/arch/arm64/boot/dts/allwinner/sun60i-a733-cubie-a7a.dts
+++ b/arch/arm64/boot/dts/allwinner/sun60i-a733-cubie-a7a.dts
@@ -248,6 +248,10 @@
 	status = "okay";
 };
 
+&combophy0 {
+	status = "okay";
+};
+
 &combophy1 {
 	status = "okay";
 };
@@ -622,19 +626,17 @@
 	 * dwc3-of-simple enables it before the child dwc3 probes. */
 	vbus-supply = <&reg_usb_host_en>;
 	/* No combo PHY in use, take the PIPE clock from the USB2 side */
-	assigned-clocks = <&serdes_ccu CLK_SERDES_USB3_PIPE>,
-			  <&serdes_ccu CLK_SERDES_USB3_UTMI>,
+	assigned-clocks = <&serdes_ccu CLK_SERDES_USB3_UTMI>,
 			  <&ccu CLK_USB2_SUSPEND>,
 			  <&ccu CLK_USB2_U2_REF>,
 			  <&ccu CLK_USB2_MF>,
 			  <&ccu CLK_USB2_U3_UTMI>,
 			  <&ccu CLK_USB2_U2_PIPE>;
-	assigned-clock-parents = <&ccu CLK_USB2_U2_PIPE>,
-				 <&ccu CLK_USB2_U2_REF>,
+	assigned-clock-parents = <&ccu CLK_USB2_U2_REF>,
 				 <&ccu CLK_SYS_24M>,
 				 <&ccu CLK_SYS_24M>,
 				 <&ccu CLK_SYS_24M>;
-	assigned-clock-rates = <0>, <0>, <0>, <0>, <0>, <300000000>, <480000000>;
+	assigned-clock-rates = <0>, <0>, <0>, <0>, <300000000>, <480000000>;
 	status = "okay";
 };
 
