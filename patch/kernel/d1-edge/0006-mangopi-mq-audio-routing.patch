From: khaliforce <kforce@gmail.com>
Subject: [PATCH] riscv: dts: allwinner: describe MQ Pro analog output

Connect the headphone outputs to the board audio pads.
Source: https://mangopi.org/_media/mq-prov14-sch.pdf

---
 arch/riscv/boot/dts/allwinner/sun20i-d1-mangopi-mq-pro.dts | 7 +++++++
 1 file changed, 7 insertions(+)

--- a/arch/riscv/boot/dts/allwinner/sun20i-d1-mangopi-mq-pro.dts
+++ b/arch/riscv/boot/dts/allwinner/sun20i-d1-mangopi-mq-pro.dts
@@ -77,6 +77,13 @@
 
 &cpu0 {
 	cpu-supply = <&reg_vdd_cpu>;
+};
+
+&codec {
+	routing = "Audio Out", "HPOUTL",
+		  "Audio Out", "HPOUTR";
+	widgets = "Headphone", "Audio Out";
+	status = "okay";
 };
 
 &de {
