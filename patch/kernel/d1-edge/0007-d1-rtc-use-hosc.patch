From: khaliforce <kforce@gmail.com>
Subject: [PATCH] clk: sunxi-ng: use HOSC for D1 RTCs without an external clock

The D1 RTC drifts with its uncalibrated internal oscillator.
Use the crystal-derived clock when no external 32 kHz input is described.

---
 drivers/clk/sunxi-ng/ccu-sun6i-rtc.c | 13 ++++++++++++-
 1 file changed, 12 insertions(+), 1 deletion(-)

--- a/drivers/clk/sunxi-ng/ccu-sun6i-rtc.c
+++ b/drivers/clk/sunxi-ng/ccu-sun6i-rtc.c
@@ -339,6 +339,7 @@
 {
 	const struct sun6i_rtc_match_data *data;
 	struct clk *ext_osc32k_clk = NULL;
+	int ret;
 	const struct of_device_id *match;
 
 	/* This driver is only used for newer variants of the hardware. */
@@ -375,7 +376,17 @@
 	osc32k_fanout_init_data.parent_data = data->osc32k_fanout_parents;
 	osc32k_fanout_init_data.num_parents = data->osc32k_fanout_nparents;
 
-	return devm_sunxi_ccu_probe(dev, reg, &sun6i_rtc_ccu_desc);
+	ret = devm_sunxi_ccu_probe(dev, reg, &sun6i_rtc_ccu_desc);
+	if (ret)
+		return ret;
+
+	/* Use HOSC when the board does not describe an external 32 kHz input. */
+	if (of_device_is_compatible(dev->of_node, "allwinner,sun20i-d1-rtc") &&
+	    !ext_osc32k_clk)
+		return clk_set_parent(rtc_32k_clk.common.hw.clk,
+				      osc24M_32k_clk.common.hw.clk);
+
+	return 0;
 }
 
 MODULE_IMPORT_NS(SUNXI_CCU);
