From: Juan Sanchez <juanesf91@gmail.com>
Subject: [PATCH] phy: sun60i-a733-combophy: add USB 3.1 mode for combophy0

Add USB 3.1 host initialization for the first Cadence combo PHY
(combophy0 at 0x06c01000 / 0x06c80000) using the vendor register
tables and reset sequence:

  - Match "allwinner,sun60i-a733-usb3-phy" in sun60i_combophy_of_match.
  - Clear USB3P1_ONLY_PIPE_CLK_SEL (bit 20 of SERDES_USB3_BGR) so
    DWC3 uses the combo PHY PIPE clock.
  - Map the shared 0x06c06000 pipe region with devm_ioremap() so
    combophy0 and combophy1 (PCIe) do not collide on request_mem_region.

Signed-off-by: Juan Sanchez <juanesf91@gmail.com>
Assisted-by: OpenCode (Big Pickle) <noreply@opencode.ai>
---
diff --git a/drivers/phy/allwinner/phy-sun60i-a733-combophy.c b/drivers/phy/allwinner/phy-sun60i-a733-combophy.c
index fbbfbb9e052c..3edfbc5c4d93 100644
--- a/drivers/phy/allwinner/phy-sun60i-a733-combophy.c
+++ b/drivers/phy/allwinner/phy-sun60i-a733-combophy.c
@@ -35,9 +35,37 @@
 #define PIPE_TXDATA_MAP_CTRL		0xc44
 #define   PIPE_TXDATA_MAP_PCIE		0x1
 
-/* SerDes subsystem debug control register */
+/* USB3 wrapper registers for combo PHY0 */
+#define LINK_CTRL2			0x008
+#define   PHY0_IDDQ_EN_SEL		BIT(1)
+#define   PHY0_IDDQ_EN_SOFT		BIT(0)
+#define LINK_CTRL3			0x00c
+#define   PHY0_PMA_XCVR_POWER_STATE_REQ_MASK GENMASK(9, 4)
+#define   PHY0_PMA_XCVR_POWER_STATE_REQ_A0 BIT(4)
+#define   PHY0_PMA_XCVR_PLLCLK_EN_LN	BIT(0)
+#define   PHY0_DP_LINK_RESET_N_SOFT	BIT(8)
+#define   PHY0_PIPE_LINK_RESET_N_SOFT	BIT(4)
+#define   PHY0_PMA_CMN_PLL1_REFCLK_SEL	BIT(24)
+#define   PHY0_PMA_CMN_PLL0_REFCLK_SEL	BIT(20)
+#define   PHY0_PMA_CMN_REFCLK_DIG_SEL	BIT(0)
+#define   PHY0_TYPEC_CONN_DIR		BIT(12)
+
+/* SerDes subsystem registers */
+#define SERDES_USB3_BGR_REG		0x08
+#define   USB3P1_ONLY_PIPE_CLK_SEL	BIT(20)
 #define SERDES_DBG_CTL			0x0f0
 #define   COMBO1_AUTOGATING_DISABLE	BIT(29)
+#define DP_RAWS_TXDW_CONV_CTRL		0x004
+#define   DP_PHY_CFG_DATA_EN		BIT(0)
+#define   DP_PHY_CFG_LN_EN_MASK		GENMASK(7, 4)
+#define   DP_PHY_CFG_LN_RSTN_MASK	GENMASK(11, 8)
+#define USB3P1_PIPE_CLK_MAP_CTRL	0x100
+#define USB3P1_PIPE_RXD_MAP_CTRL	0x104
+
+enum sun60i_combophy_mode {
+	SUN60I_COMBOPHY_PCIE = 0,
+	SUN60I_COMBOPHY_USB3,
+};
 
 struct sun60i_combophy {
 	struct device *dev;
@@ -47,6 +75,7 @@ struct sun60i_combophy {
 	struct regmap *serdes;
 	struct clk *cfg_clk;
 	struct clk *ref_clk;
+	enum sun60i_combophy_mode mode;
 };
 
 struct sun60i_combophy_reg {
@@ -186,6 +215,201 @@ static int sun60i_combophy_pcie_exit(struct phy *phy)
 	return 0;
 }
 
+
