# DO NOT EDIT THIS FILE
#
# Please edit /boot/armbianEnv.txt to set supported parameters
#

# Works with the stock U-Boot of Turris OS and the Armbian U-Boot. Both set the
# load addresses, and bootz writes their MAC addresses to the device tree.

setenv load_addr "0x800000"
setenv verbosity "1"
setenv l_rootflags
# An earlier boot script can leave these
setenv rootdev
setenv rootfstype
setenv extraargs
setenv extraboardargs
setenv usbstoragequirks

# A medkit of the Turris rescue system is in the btrfs subvolume @, with /boot.scr
# linked to @/boot/boot.scr. Never set prefix, distro boot uses it.
setenv l_bootdir "${prefix}"
if test -e ${devtype} ${devnum}:${distro_bootpart} /@/boot/zImage; then
	setenv l_bootdir "/@/boot/"
fi

if test -e ${devtype} ${devnum}:${distro_bootpart} ${l_bootdir}armbianEnv.txt; then
	load ${devtype} ${devnum}:${distro_bootpart} ${load_addr} ${l_bootdir}armbianEnv.txt
	env import -t ${load_addr} ${filesize}
fi

# Without rootdev, the root is this partition
setenv l_partuuid
part uuid ${devtype} ${devnum}:${distro_bootpart} l_partuuid
if test -z "${rootdev}"; then
	if test -z "${l_partuuid}"; then
		echo "No partition UUID for ${devtype} ${devnum}:${distro_bootpart}, set rootdev in armbianEnv.txt"
		exit
	fi
	setenv rootdev "PARTUUID=${l_partuuid}"
fi

# Is the root on this partition? armbian-install can move it.
setenv l_rootpart
setenv l_fsuuid
fsuuid ${devtype} ${devnum}:${distro_bootpart} l_fsuuid
if test "${rootdev}" = "PARTUUID=${l_partuuid}" -o "${rootdev}" = "UUID=${l_fsuuid}"; then
	setenv l_rootpart "yes"
fi
# A device path set by hand. Linux numbers the eMMC as U-Boot does.
if test "${devtype}" = "mmc" -a "${rootdev}" = "/dev/mmcblk${devnum}p${distro_bootpart}"; then
	setenv l_rootpart "yes"
fi

if test -n "${l_rootpart}" -a "${l_bootdir}" = "/@/boot/"; then
	setenv l_rootflags "rootflags=subvol=@"
fi

# Without rootfstype in armbianEnv.txt, a root on this partition has its type, any other ext4
if test -z "${rootfstype}"; then
	setenv rootfstype "ext4"
	if test -n "${l_rootpart}"; then
		fstype ${devtype} ${devnum}:${distro_bootpart} rootfstype
	fi
fi

setenv bootargs "console=ttyS0,115200 root=${rootdev} rootwait rootfstype=${rootfstype} ${l_rootflags} rw loglevel=${verbosity} usb-storage.quirks=${usbstoragequirks} ${extraboardargs} ${extraargs}"

# On a missing file, exit and let distro boot try the next device
echo "Booting ${l_bootdir}zImage with root=${rootdev} ${l_rootflags}"
load ${devtype} ${devnum}:${distro_bootpart} ${kernel_addr_r} ${l_bootdir}zImage || exit
load ${devtype} ${devnum}:${distro_bootpart} ${fdt_addr_r} ${l_bootdir}dtb/${fdtfile} || exit
load ${devtype} ${devnum}:${distro_bootpart} ${ramdisk_addr_r} ${l_bootdir}uInitrd || exit

# No U-Boot adapts the device tree to an SFP module. A module pulls gpio@71_4
# low, and "gpio input" returns the pin value. Reboot after a module change.
if gpio input gpio@71_4; then
	fdt addr ${fdt_addr_r}
	if fdt resize 0x1000 && fdt set /sfp status "okay" && fdt rm /soc/internal-regs/ethernet@34000 phy-handle && fdt set /soc/internal-regs/ethernet@34000 managed "in-band-status"; then
		echo "SFP module found, the WAN port uses the SFP cage"
	else
		echo "SFP module found, but the device tree change failed"
		load ${devtype} ${devnum}:${distro_bootpart} ${fdt_addr_r} ${l_bootdir}dtb/${fdtfile} || exit
	fi
fi

bootz ${kernel_addr_r} ${ramdisk_addr_r} ${fdt_addr_r}

# Recompile with:
# mkimage -C none -A arm -T script -d /boot/boot.cmd /boot/boot.scr
