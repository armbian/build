# DO NOT EDIT THIS FILE
#
# Please edit /boot/armbianEnv.txt to set supported parameters
#

setenv load_addr "0x43e00000"

setenv verbosity "1"
setenv console "both"
setenv rootfstype "ext4"
setenv consoleargs ""

if test -z "${devtype}"; then setenv devtype "mmc"; fi
if test -z "${devnum}"; then setenv devnum 0; fi
if test -z "${distro_bootpart}"; then setenv distro_bootpart 1; fi

part uuid ${devtype} ${devnum}:${distro_bootpart} partuuid
if test -n "${partuuid}"; then
    setenv rootdev "PARTUUID=${partuuid}"
else
    if test "${devtype}" = "mmc"; then
        setenv rootdev "/dev/mmcblk${devnum}p${distro_bootpart}"
    fi
fi

if test -e ${devtype} ${devnum}:${distro_bootpart} ${prefix}armbianEnv.txt; then
    load ${devtype} ${devnum}:${distro_bootpart} ${load_addr} ${prefix}armbianEnv.txt
    env import -t ${load_addr} ${filesize}
fi

if test "${console}" = "display" || test "${console}" = "both"; then setenv consoleargs "console=tty1"; fi
if test "${console}" = "serial" || test "${console}" = "both"; then setenv consoleargs "${consoleargs} console=ttySAC1,115200n8"; fi

setenv bootargs "${consoleargs} root=${rootdev} rootwait rootfstype=${rootfstype} rw loglevel=${verbosity} ${extraboardargs} ${extraargs}"

# U-Boot sets fdtfile from the detected board type, but it cannot tell the
# ODROID-U2 and ODROID-U3 apart, so fdtfile from armbianEnv.txt selects the
# device tree of the board

# The U-Boot shell does not support negating a command with "!"
if load ${devtype} ${devnum}:${distro_bootpart} ${kernel_addr_r} ${prefix}zImage; then
    echo "Loaded ${prefix}zImage"
else
    echo "ERROR: Failed to load ${prefix}zImage!"
    exit
fi

setenv fdt_loaded 0
if test -e ${devtype} ${devnum}:${distro_bootpart} ${prefix}dtb/${fdtfile}; then
    if load ${devtype} ${devnum}:${distro_bootpart} ${fdt_addr_r} ${prefix}dtb/${fdtfile}; then
        setenv fdt_loaded 1
    fi
elif test -e ${devtype} ${devnum}:${distro_bootpart} ${prefix}dtb/samsung/${fdtfile}; then
    if load ${devtype} ${devnum}:${distro_bootpart} ${fdt_addr_r} ${prefix}dtb/samsung/${fdtfile}; then
        setenv fdt_loaded 1
    fi
fi

if test "${fdt_loaded}" = "0"; then
    echo "ERROR: Failed to load Device Tree Blob ${fdtfile}!"
    exit
fi

if test -e ${devtype} ${devnum}:${distro_bootpart} ${prefix}uInitrd; then
    if load ${devtype} ${devnum}:${distro_bootpart} ${ramdisk_addr_r} ${prefix}uInitrd; then
        bootz ${kernel_addr_r} ${ramdisk_addr_r} ${fdt_addr_r}
    else
        echo "WARNING: Failed to load ${prefix}uInitrd, attempting boot without initramfs..."
        bootz ${kernel_addr_r} - ${fdt_addr_r}
    fi
else
    bootz ${kernel_addr_r} - ${fdt_addr_r}
fi
