# Raspberry Pi 3 Model B (BCM2837, quad-core Cortex-A53, running in 32-bit
# ARMv7 mode)
#
# Reference board definition -- not upstream yet (this PR). Sibling of
# rpi2b.conf (armbian/build#10355), paired with the new
# config/sources/families/bcm2837.conf. Carries the same dma-ranges fix as
# bcm2836 (real hardware almost certainly doesn't need it -- Raspberry
# Pi's own firmware patches the same fix in at boot, confirmed by dumping
# /proc/device-tree/soc/dma-ranges on real Pi 3B hardware -- but it's a
# harmless no-op if firmware's own value already covers it) and the same
# bcm2835 MMC NULL-deref guard, both confirmed necessary the same way:
# built, booted, and traced live.
#
# Unlike rpi2b, this one has booted on real hardware, not just QEMU: a
# physical Pi 3 Model B, confirmed clean via dmesg (bcm2835-dma init,
# mmc0 SD card detect, no warnings/errors) and a stable root shell over
# SSH. Kept as .wip (per config/boards/README.md) purely because it
# hasn't gone through upstream board-maintainer review yet, not because
# anything about it is unverified.

declare -g BOARD_NAME="Raspberry Pi 3 Model B"
declare -g BOARD_VENDOR="rpi-foundation"
declare -g BOARDFAMILY="bcm2837"
declare -g BOARD_MAINTAINER=""
declare -g INTRODUCED="2016"
declare -g KERNEL_TARGET="current"
declare -g KERNEL_TEST_TARGET="current"
declare -g MODULES="i2c_dev"
