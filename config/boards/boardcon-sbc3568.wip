# Rockchip RK3568 Quad core LPDDR4X 8GB-64GB eMMC Ethernet HDMI USB3 CAN RS485 SATA WiFi/BT M.2
BOARD_NAME="SBC3568"
BOARD_VENDOR="boardcon"
BOARDFAMILY="rk35xx"
BOARD_MAINTAINER="boardcon-arm"
INTRODUCED="2026"
BOOTCONFIG="boardcon-sbc-rk3568_defconfig"
BOOT_SOC="rk3568"
KERNEL_TARGET="vendor"
KERNEL_TEST_TARGET="vendor"
FULL_DESKTOP="yes"
BOOT_LOGO="desktop"
IMAGE_PARTITION_TABLE="gpt"
BOOT_FDT_FILE="rockchip/rk3568-boardcon-sbc-v4.dtb"
BOOT_SCENARIO="spl-blobs"
BOOTPATCHDIR="legacy/u-boot-radxa-rk35xx/board_${BOARD}"

