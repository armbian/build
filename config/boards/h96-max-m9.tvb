# Rockchip RK3576 octa core TV box 8GB RAM eMMC GbE USB3 HDMI WiFi BT
BOARD_NAME="H96 Max M9"
BOARD_VENDOR="rockchip"
BOARDFAMILY="rk35xx"
BOARD_MAINTAINER=""
INTRODUCED="2026"
BOOTCONFIG="generic-rk3576_defconfig"
KERNEL_TARGET="edge"
KERNEL_TEST_TARGET="edge"
BOOT_FDT_FILE="rockchip/rk3576-h96-max-m9.dtb"
BOOT_SCENARIO="binman"
IMAGE_PARTITION_TABLE="gpt"
SERIALCON="ttyS0"

# Validated on this board. The family defaults are older.
DDR_BLOB="rk35/rk3576_ddr_lp4_2112MHz_lp5_2736MHz_v1.12.bin"
BL31_BLOB="rk35/rk3576_bl31_v1.24.elf"

# AIC8800D80: Wi-Fi on SDIO, Bluetooth on ttyS4
AIC8800_TYPE="sdio"
enable_extension "radxa-aic8800"
PACKAGE_LIST_BOARD="rfkill bluetooth bluez bluez-tools"

function post_family_config__h96_max_m9_use_mainline_uboot() {
	display_alert "$BOARD" "mainline U-Boot v2026.10 (generic-rk3576) for $BOARD / $BRANCH" "info"

	declare -g BOOTDELAY=1
	declare -g BOOTSOURCE="https://github.com/u-boot/u-boot.git"
	declare -g BOOTBRANCH="tag:v2026.10"
	declare -g BOOTPATCHDIR="v2026.10"
	declare -g BOOTDIR="u-boot-${BOARD}"
	declare -g UBOOT_TARGET_MAP="BL31=${RKBIN_DIR}/${BL31_BLOB} ROCKCHIP_TPL=${RKBIN_DIR}/${DDR_BLOB};;u-boot-rockchip.bin"

	unset uboot_custom_postprocess write_uboot_platform write_uboot_platform_mtd

	function write_uboot_platform() {
		dd "if=$1/u-boot-rockchip.bin" "of=$2" bs=32k seek=1 conv=notrunc status=none
	}
}

function post_family_tweaks_bsp__h96_max_m9_aic8800() {
	display_alert "$BOARD" "Installing AIC8800 tweaks" "info"
	mkdir -p "${destination}"/etc/modprobe.d "${destination}"/etc/modules-load.d
	cat > "${destination}"/etc/modprobe.d/aic8800-wireless.conf <<- EOT
		options aic8800_fdrv_sdio aicwf_dbg_level=0 custregd=0 ps_on=0
	EOT
	# bluetooth.service needs /sys/class/bluetooth before aic-bluetooth runs
	cat > "${destination}"/etc/modules-load.d/aic8800-btlpm.conf <<- EOT
		hidp
		rfcomm
		bnep
		aic8800_btlpm_sdio
	EOT
	install -d -m 0755 "${destination}/usr/bin" "${destination}/usr/lib/systemd/system"
	install -m 0755 "$SRC/packages/bsp/aic8800/aic-bluetooth" "${destination}/usr/bin/aic-bluetooth"
	sed -i "s|/dev/ttyS1|/dev/ttyS4|g" "${destination}/usr/bin/aic-bluetooth"
	install -m 0644 "$SRC/packages/bsp/aic8800/aic-bluetooth.service" "${destination}/usr/lib/systemd/system/aic-bluetooth.service"
}

function post_family_tweaks__h96_max_m9_enable_aic8800_bluetooth() {
	display_alert "$BOARD" "Enabling AIC8800 Bluetooth service" "info"
	chroot_sdcard systemctl --no-reload enable aic-bluetooth.service
}
