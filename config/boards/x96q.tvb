# Allwinner H313 quad core 1/1.5/2GB RAM 8/16GB eMMC 100M Ethernet WiFi TV box
BOARD_NAME="X96Q TV Box"
BOARD_VENDOR="allwinner"
BOARDFAMILY="sun50iw9"
BOARD_MAINTAINER="sicXnull"
INTRODUCED="2020"
BOOTCONFIG="x96q_lpddr3_defconfig"
BOOT_LOGO="desktop"
KERNEL_TARGET="current"
KERNEL_TEST_TARGET="current"
FORCE_BOOTSCRIPT_UPDATE="yes"
OVERLAY_PREFIX="sun50i-h616"
enable_extension "uwe5622-allwinner"

# Optional U-Boot variants for X96Q clones. All unset = the default build.
#   X96Q_DRAM_PROFILE=ba301-627  Stock DRAM parameters of the BA301_627 board
#                                (SK hynix H9TQ64AAETACURKUM, 1.5 GiB LPDDR3):
#                                648 MHz, 1200 mV, 1.5 GiB support, "mtest".
#   X96Q_DRAM_VOLTAGE=<mV>       DRAM supply (AXP313 DCDC3) in the SPL, 1100-1200,
#                                in 10 mV steps.
#                                Linux sets 1200 mV after boot (kernel DT).
#   X96Q_RAM_SHRINK=yes|no       Dual-rank 3/4-size (1.5 GiB) support.
# Boxes with the secure-boot eFuse burned: ENABLE_EXTENSIONS=uboot-sunxi-toc0.
# Example: ./compile.sh uboot BOARD=x96q BRANCH=current X96Q_DRAM_PROFILE=ba301-627 ENABLE_EXTENSIONS=uboot-sunxi-toc0 TOC0_ROOT_KEY=generate
# TOC0_ROOT_KEY=generate works only while the ROTPK hash eFuse is not programmed.
# With a programmed hash, use the matching key: TOC0_ROOT_KEY=/path/to/key.pem.

# The hooks run after user config, so they see its values too.
function extension_prepare_config__x96q_variant() {
	[[ -n "${X96Q_DRAM_PROFILE}${X96Q_DRAM_VOLTAGE}${X96Q_RAM_SHRINK}" ]] || return 0
	if [[ -n "${X96Q_DRAM_VOLTAGE}" ]]; then
		# U-Boot sets DCDC3 in 10 mV steps.
		[[ "${X96Q_DRAM_VOLTAGE}" =~ ^[0-9]+0$ && "${X96Q_DRAM_VOLTAGE}" -ge 1100 && "${X96Q_DRAM_VOLTAGE}" -le 1200 ]] ||
			exit_with_error "${BOARD}: X96Q_DRAM_VOLTAGE must be 1100-1200 mV, in 10 mV steps" "${X96Q_DRAM_VOLTAGE}"
	fi
	declare -g UBOOT_HASH_EXTRA="${UBOOT_HASH_EXTRA:+${UBOOT_HASH_EXTRA}:}x96q:dram=${X96Q_DRAM_PROFILE}:mv=${X96Q_DRAM_VOLTAGE}:shrink=${X96Q_RAM_SHRINK}"
	# The variables hash in the artifact version is short: name the variant in full.
	declare -g UBOOT_ARTIFACT_VERSION_SUFFIX="${UBOOT_ARTIFACT_VERSION_SUFFIX:+${UBOOT_ARTIFACT_VERSION_SUFFIX}-}x96q.${X96Q_DRAM_PROFILE:-none}.${X96Q_DRAM_VOLTAGE:-default}.${X96Q_RAM_SHRINK:-default}"
}

function post_config_uboot_target__x96q_variant() {
	case "${X96Q_DRAM_PROFILE}" in
		"") ;;
		ba301-627)
			display_alert "${BOARD}: DRAM profile" "${X96Q_DRAM_PROFILE}: vendor dram_para, 648 MHz, 1200 mV, 1.5 GiB" "info"
			run_host_command_logged scripts/config --set-val CONFIG_DRAM_CLK 648 \
				--set-val CONFIG_DRAM_SUNXI_CA_DRI 0x1919 \
				--set-val CONFIG_DRAM_SUNXI_ODT_EN 0x9988eeee \
				--set-val CONFIG_DRAM_SUNXI_TPR6 0x2fc08080 \
				--set-val CONFIG_DRAM_SUNXI_TPR10 0x402f3379 \
				--set-val CONFIG_DRAM_SUNXI_TPR11 0x0d100b0f \
				--set-val CONFIG_DRAM_SUNXI_TPR12 0x11131113 \
				--set-val CONFIG_AXP_DCDC3_VOLT 1200 \
				--enable CONFIG_DRAM_SUN50I_H616_SHRINK \
				--enable CONFIG_CMD_MEMTEST
			;;
		*) exit_with_error "${BOARD}: unknown X96Q_DRAM_PROFILE" "${X96Q_DRAM_PROFILE} (known: ba301-627)" ;;
	esac

	if [[ -n "${X96Q_DRAM_VOLTAGE}" ]]; then
		display_alert "${BOARD}: DRAM voltage" "${X96Q_DRAM_VOLTAGE} mV" "info"
		run_host_command_logged scripts/config --set-val CONFIG_AXP_DCDC3_VOLT "${X96Q_DRAM_VOLTAGE}"
	fi

	case "${X96Q_RAM_SHRINK}" in
		"") ;;
		yes) run_host_command_logged scripts/config --enable CONFIG_DRAM_SUN50I_H616_SHRINK ;;
		no) run_host_command_logged scripts/config --disable CONFIG_DRAM_SUN50I_H616_SHRINK ;;
		*) exit_with_error "${BOARD}: X96Q_RAM_SHRINK must be yes or no" "${X96Q_RAM_SHRINK}" ;;
	esac
}
