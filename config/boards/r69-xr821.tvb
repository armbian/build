# Rockchip RK3518 quad core 2GB SoC 16GB eMMC SD 1x100MBe WiFi/BT USB2/3 HDMI
BOARD_NAME="R69 XR821"
BOARD_VENDOR="rockchip"
BOARDFAMILY="rk35xx"
BOARD_MAINTAINER="sormy"
INTRODUCED="2026"
BOOTCONFIG="hinlink_rk3528_defconfig"
BOOT_FDT_FILE="rockchip/rk3518-r69-xr821.dtb"
BOOT_SCENARIO="spl-blobs"
DDR_BLOB="rk35/rk3528_ddr_1056MHz_v1.13.bin"
BL31_BLOB="rk35/rk3528_bl31_v1.21.elf"
KERNEL_TARGET="vendor"
KERNEL_TEST_TARGET="vendor"
IMAGE_PARTITION_TABLE="gpt"
POWER_MANAGEMENT_FEATURES="yes"
# The DTB disables fiq-debugger to free UART0; ttyS2, the family default, is the BT UART.
SERIALCON="ttyS0:1500000"

# BOOTENV_FILE is reassigned by the family config, which is sourced later.
function post_family_config__r69_xr821_bootenv() {
	declare -g BOOTENV_FILE="r69-xr821.txt"
}

function post_family_tweaks_bsp__r69_xr821() {
	display_alert "Installing R69 BSP" "power-state LEDs, VPU permissions, power key, BT rfkill" "info"

	install -m 755 -D "${SRC}/packages/bsp/rk35xx/power-state-leds" \
		"${destination}/usr/lib/systemd/system-shutdown/power-state-leds"
	install -m 755 -D "${SRC}/packages/bsp/rk35xx/power-state-leds" \
		"${destination}/usr/lib/systemd/system-sleep/power-state-leds"
	install -m 644 -D "${SRC}/packages/bsp/rk35xx/vpu.rules" \
		"${destination}/etc/udev/rules.d/99-rockchip-vpu.rules"
	install -m 644 -D "${SRC}/packages/bsp/rk35xx/powerkey.conf" \
		"${destination}/etc/systemd/logind.conf.d/10-powerkey.conf"
	install -m 644 -D "${SRC}/packages/bsp/rk35xx/input-names.rules" \
		"${destination}/etc/udev/rules.d/60-input-names.rules"
	install -m 644 -D "${SRC}/packages/bsp/rk35xx/rfkill-bt.rules" \
		"${destination}/etc/udev/rules.d/60-rfkill-bt.rules"

	return 0
}
