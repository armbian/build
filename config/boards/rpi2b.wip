# Raspberry Pi 2 Model B (BCM2836, quad-core Cortex-A7, 32-bit ARMv7)
#
# Reference board definition -- not upstream yet (this PR). Exists for QEMU
# boot validation in CI, not for real-hardware deployment. Modeled on
# upstream's rpi4b.conf, paired with the new
# config/sources/families/bcm2836.conf (see that file for why this needed a
# whole new family rather than reusing bcm2711.conf).
#
# Builds and boots clean under QEMU (kernel, packaging, root-fs mount,
# init -- see scripts/run-qemu-rpi2.sh and the dma-ranges patch's commit
# message for the root-cause writeup on the fix that was needed to get
# there). Kept as .wip (per config/boards/README.md) since it's
# QEMU-verified only, not yet confirmed on real Pi 2 hardware.

declare -g BOARD_NAME="Raspberry Pi 2 Model B"
declare -g BOARD_VENDOR="rpi-foundation"
declare -g BOARDFAMILY="bcm2836"
declare -g BOARD_MAINTAINER=""
declare -g INTRODUCED="2015"
declare -g KERNEL_TARGET="current"
declare -g KERNEL_TEST_TARGET="current"
declare -g MODULES="i2c_dev"
