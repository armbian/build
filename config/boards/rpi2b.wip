# Raspberry Pi 2 Model B (BCM2836, quad-core Cortex-A7, 32-bit ARMv7)
#
# Reference board definition — not upstream, not a real Armbian board yet.
# Exists for QEMU boot validation in CI (mirrors yocto-generic's
# raspberrypi2/rpi2-qemu targets), not for real-hardware deployment.
# Modeled on upstream's rpi4b.conf, paired with the new
# families/bcm2836.conf (see that file for why this needed a whole new
# family rather than reusing bcm2711.conf).
#
# Kept as .wip (per config/boards/README.md upstream) until it actually
# builds and boots — see VERSIONS.md for the known kernel-config gap.

declare -g BOARD_NAME="Raspberry Pi 2 Model B"
declare -g BOARD_VENDOR="rpi-foundation"
declare -g BOARDFAMILY="bcm2836"
declare -g BOARD_MAINTAINER=""
declare -g INTRODUCED="2015"
declare -g KERNEL_TARGET="current"
declare -g MODULES="i2c_dev"
