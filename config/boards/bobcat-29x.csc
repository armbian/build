# Rockchip RK3566 quad core 2GB RAM eMMC 100M Ethernet WiFi/BT (ex-Helium miner)
BOARD_NAME="29X"
BOARD_VENDOR="bobcat"
BOARDFAMILY="rk35xx"
BOARD_MAINTAINER=""
INTRODUCED="2021"
HAS_VIDEO_OUTPUT="no"
BOOTCONFIG="rock-3c-rk3566_defconfig"
KERNEL_TARGET="current,edge"
KERNEL_TEST_TARGET="current"
BOOT_FDT_FILE="rockchip/rk3566-bobcat-29x.dtb"
IMAGE_PARTITION_TABLE="gpt"
BOOT_SCENARIO="spl-blobs"
BOOTFS_TYPE="fat"
enable_extension "radxa-aic8800"
AIC8800_TYPE="sdio"
