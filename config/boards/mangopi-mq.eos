# Allwinner D1 single core (C906) 512MB/1GB RAM WiFi/BT HDMI
BOARD_NAME="Mangopi-MQ"
BOARD_VENDOR="mangopi"
BOARDFAMILY="d1"
BOARD_MAINTAINER=""
INTRODUCED="2021"
KERNEL_TARGET="edge"
BOOT_FDT_FILE="allwinner/sun20i-d1-nezha.dtb"
SRC_EXTLINUX="yes"
SRC_CMDLINE="console=ttyS0,115200n8 console=tty0 earlycon=sbi cma=96M rootflags=data=writeback stmmaceth=chain_mode:1 rw"
BOOTCONFIG="nezha_defconfig"

function pre_prepare_partitions() {
	# Disable 4 modern ext4 features for maximum stability on D1 U-Boot
	mkopts[ext4]="-q -m 2 -O ^64bit,^metadata_csum,^metadata_csum_seed,^orphan_file"
}

function post_family_config() {
	# Downgrade OpenSBI to fix hardware freezes
	ATFBRANCH="commit:8153b2622b08802cc542f30a1fcba407a5667ab9"
}
