# Rockchip RK3399T hexa core 1-4GB SoC GBe eMMC USB3 WiFi/BT PoE
BOARD_NAME="Rock 4SE"
BOARD_VENDOR="radxa"
BOARDFAMILY="rockchip64"
BOARD_MAINTAINER=""
INTRODUCED="2021"
BOOTCONFIG="rock-4se-rk3399_defconfig"
KERNEL_TARGET="current,edge"
KERNEL_TEST_TARGET="current"
FULL_DESKTOP="yes"
BOOT_LOGO="desktop"
BOOT_FDT_FILE="rockchip/rk3399-rock-4se.dtb"
BOOT_SUPPORT_SPI="yes"
source "${SRC}/config/sources/vendors/radxa/rk3399-uboot.conf.sh"
