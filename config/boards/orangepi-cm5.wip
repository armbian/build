# Rockchip RK3588S octa core 4/8/16GB RAM SoC compute module (3-port carrier: 1x GbE "wan", 2x 2.5GbE "lan1/lan2", 2x USB2 host, USB3/USB-C OTG, HDMI, SD, fan)
BOARD_NAME="Orange Pi CM5" # display name: welcome text, hostname generation, output image filename
BOARD_VENDOR="xunlong" # vendor tag (Xunlong manufactures Orange Pi); metadata only
BOARDFAMILY="rockchip-rk3588" # pulls in config/sources/families/rockchip-rk3588.conf (DDR/BL31 blobs, boot scenario, current/edge kernel branch versions)
# no named maintainer yet; allowed for .wip, but needed before this could move to .csc/.conf
BOARD_MAINTAINER=""
INTRODUCED="2024" # year the CM5 module was announced; cosmetic metadata only
BOOTCONFIG="orangepi-5-rk3588s_defconfig" # CM5 has no dedicated mainline U-Boot defconfig; it's the same RK3588S SoC/DDR as the Orange Pi 5, whose defconfig is known to boot the CM5 fine
BOOT_SOC="rk3588" # pin the SoC variant explicitly for DDR/BL31 blob selection, instead of relying on regex-parsing it out of BOOTCONFIG
KERNEL_TARGET="current,edge" # the CM5 device tree (backported into patch/kernel/archive/rockchip64-{6.18,7.2}/dt/) is only wired up for these two mainline-derived branches; the vendor/legacy BSP kernels don't carry it
KERNEL_TEST_TARGET="current,edge" # same set; tells Armbian's CI/test-matrix generator which branches to test (internal switch only)
FULL_DESKTOP="yes" # install the full desktop app stack (office, etc.) on desktop image builds, matching the sibling Orange Pi 5-family boards
BOOT_LOGO="desktop" # show the Armbian boot splash only on desktop image builds, not server/CLI
BOOT_FDT_FILE="rockchip/rk3588s-orangepi-cm5.dtb" # our own carrier dts (see patch/kernel/archive/.../dt/rk3588s-orangepi-cm5.dts), corrected against a dtb dumped off the reporter's actual booted vendor image; NOT the upstream "-base" board (rk3588s-orangepi-cm5-base.dtb), whose Ethernet PHY reset GPIO/timing and USB host wiring don't match this carrier
BOOT_SCENARIO="spl-blobs" # boot-chain composition: proprietary Rockchip DDR-init blob + proprietary ATF (BL31), mainline U-Boot SPL instead of the Rockchip miniloader
IMAGE_PARTITION_TABLE="gpt" # GPT (not msdos) partition table, matching the RK3588 family's SPI/GPT boot layout convention

# The CM5 module is the same RK3588S silicon/DDR as the Orange Pi 5, so reuse its known-working
# mainline U-Boot build (proven to boot the CM5 already, per user testing with the orangepi5 image).
# Only the kernel device tree (BOOT_FDT_FILE above) differs, since the CM5 Base Board carrier wires
# up different Ethernet PHYs (1x GbE + 2x PCIe 2.5GbE) than the Orange Pi 5 board.
function post_family_config__orangepicm5_use_mainline_uboot() { # "post_family_config__*" hooks run right after the family config is sourced, letting a board override its defaults
	display_alert "$BOARD" "Mainline U-Boot overrides for $BOARD - $BRANCH" "info" # log line so a build log clearly shows this override firing, and for which $BRANCH

	declare -g BOOTCONFIG="orangepi-5-rk3588s_defconfig" # re-declared as global; redundant with the top-level BOOTCONFIG= above but needed to escape this function's scope
	declare -g BOOTDELAY=1 # U-Boot autoboot delay in seconds, baked into the built U-Boot's .config, so the boot menu is interruptible
	declare -g BOOTSOURCE="https://github.com/u-boot/u-boot.git" # switch from the family default (Radxa's U-Boot fork) to mainline U-Boot upstream
	declare -g BOOTBRANCH="tag:v2026.04" # pin the exact U-Boot release to build; orangepi-5-rk3588s_defconfig is confirmed present in mainline U-Boot at this tag
	declare -g BOOTPATCHDIR="v2026.04" # apply any Armbian-carried patches from patch/u-boot/v2026.04/ on top of that tag (shared with other RK3588 boards on the same tag)
	declare -g BOOTDIR="u-boot-${BOARD}" # dedicated git-worktree/build directory (u-boot-orangepi-cm5), so it doesn't collide with orangepi5's own cached worktree
	# NOTE: $BOOTCONFIG must NOT appear in the make-target part of UBOOT_TARGET_MAP below --
	# any goal ending in "_defconfig" matches U-Boot's generic Kbuild "%config" rule, which makes
	# the whole invocation regenerate .config ONLY and skip the real (binman) build entirely,
	# silently producing no u-boot-rockchip.bin. Configuring already happens separately, earlier,
	# via $BOOTCONFIG itself (see compile_uboot in lib/functions/compilation/uboot.sh).
	declare -g UBOOT_TARGET_MAP="BL31=${RKBIN_DIR}/${BL31_BLOB} ROCKCHIP_TPL=${RKBIN_DIR}/${DDR_BLOB};;u-boot-rockchip.bin u-boot-rockchip-spi.bin" # make vars (ATF + DDR-init blob paths) and no goal name, so `make` runs its default "all" goal, which binman turns into u-boot-rockchip.bin + the SPI variant
	unset uboot_custom_postprocess # disable the family's default mkimage-based post-build step; binman above already produces the final u-boot-rockchip.bin directly
}

function post_family_tweaks__orangepicm5_naming_audios() { # "post_family_tweaks__*" hooks run late, inside the target rootfs, for small polish tweaks
	display_alert "$BOARD" "Renaming orangepi-cm5 audios" "info" # log line for this hook firing

	mkdir -p $SDCARD/etc/udev/rules.d/ # ensure the udev rules dir exists inside the image being built ($SDCARD = the mounted target rootfs)
	echo 'SUBSYSTEM=="sound", ENV{ID_PATH}=="platform-hdmi0-sound", ENV{SOUND_DESCRIPTION}="HDMI0 Audio"' > $SDCARD/etc/udev/rules.d/90-naming-audios.rules # give the single HDMI audio device a human-readable name in PulseAudio/PipeWire instead of the raw platform-hdmi0-sound device name

	return 0 # explicit success so the hook-calling machinery doesn't mistake an earlier command's exit status for this hook's own result
}
