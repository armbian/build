# Rockchip RK3588S octa core 4/8/16GB RAM SoC compute module
BOARD_NAME="OrangePi CM5"
BOARD_VENDOR="xunlong"
BOARDFAMILY="rockchip-rk3588" # pulls in config/sources/families/rockchip-rk3588.conf
BOARD_MAINTAINER="ECO1AI"
INTRODUCED="2024"
BOOTCONFIG="orangepi-5-rk3588s_defconfig" # CM5 has no dedicated mainline U-Boot defconfig; it's the same RK3588S SoC/DDR as the Orange Pi 5, whose defconfig works with CM5
BOOT_SOC="rk3588" # pin the SoC variant explicitly for DDR/BL31 blob selection, instead of relying on regex-parsing it out of BOOTCONFIG
KERNEL_TARGET="current,edge"
KERNEL_TEST_TARGET="current,edge"
FULL_DESKTOP="yes" # desktop works just fine
BOOT_LOGO="desktop"
BOOT_FDT_FILE="rockchip/rk3588s-orangepi-cm5.dtb" # our own carrier dts (see patch/kernel/archive/.../dt/rk3588s-orangepi-cm5.dts), corrected against a dtb dumped off vendors ubuntu image. (3-port carrier: 1x GbE "wan", 2x 2.5GbE "lan1/lan2", 2x USB2 host, USB3/USB-C OTG, HDMI, SD, fan)
BOOT_SCENARIO="spl-blobs" # boot-chain composition: proprietary Rockchip DDR-init blob + proprietary ATF (BL31), mainline U-Boot SPL instead of the Rockchip miniloader
IMAGE_PARTITION_TABLE="gpt" # GPT (not msdos) partition table, matching the RK3588 family's SPI/GPT boot layout convention (just an FYI)

# The CM5 module is the same RK3588S silicon/DDR as the Orange Pi 5, so will reuse its known-working
# mainline U-Boot build (it works, so why rebuilding from scratch?).
# Only the kernel device tree (BOOT_FDT_FILE above) differs, since the CM5 Base Board carrier wires
# up different IOs.
function post_family_config__orangepicm5_use_mainline_uboot() { # "post_family_config__*" hooks run right after the family config is sourced, letting a board override its defaults
	display_alert "$BOARD" "Mainline U-Boot overrides for $BOARD - $BRANCH" "info" # log line so a build log clearly shows this override firing, and for which $BRANCH (for debugging)

	declare -g BOOTCONFIG="orangepi-5-rk3588s_defconfig" # re-declared as global; redundant with the top-level BOOTCONFIG= above but needed to escape this function's scope
	declare -g BOOTDELAY=1 # U-Boot autoboot delay in seconds, baked into the built U-Boot's .config, so the boot menu is interruptible
	declare -g BOOTSOURCE="https://github.com/u-boot/u-boot.git" # switch from the family default (Radxa's U-Boot fork) to mainline U-Boot upstream
	declare -g BOOTBRANCH="tag:v2026.04" # pin the exact U-Boot release to build; orangepi-5-rk3588s_defconfig is confirmed present in mainline U-Boot at this tag
	declare -g BOOTPATCHDIR="v2026.04" # apply any Armbian-carried patches from patch/u-boot/v2026.04/ on top of that tag (shared with other RK3588 boards on the same tag)
	declare -g BOOTDIR="u-boot-${BOARD}" # dedicated git-worktree/build directory (u-boot-orangepi-cm5), so it doesn't collide with orangepi5's own cached worktree
	declare -g UBOOT_TARGET_MAP="BL31=${RKBIN_DIR}/${BL31_BLOB} ROCKCHIP_TPL=${RKBIN_DIR}/${DDR_BLOB};;u-boot-rockchip.bin u-boot-rockchip-spi.bin" # make vars (ATF + DDR-init blob paths) and no goal name, so `make` runs its default "all" goal, which binman turns into u-boot-rockchip.bin + the SPI variant
	unset uboot_custom_postprocess # disable the family's default mkimage-based post-build step; binman above already produces the final u-boot-rockchip.bin directly
}

function post_family_tweaks__orangepicm5_naming_audios() { # "post_family_tweaks__*" hooks run late, inside the target rootfs, for small polish tweaks
	display_alert "$BOARD" "Renaming orangepi-cm5 audios" "info" # log line for this hook firing

	mkdir -p $SDCARD/etc/udev/rules.d/ # ensure the udev rules dir exists inside the image being built ($SDCARD = the mounted target rootfs)
	echo 'SUBSYSTEM=="sound", ENV{ID_PATH}=="platform-hdmi0-sound", ENV{SOUND_DESCRIPTION}="HDMI0 Audio"' > $SDCARD/etc/udev/rules.d/90-naming-audios.rules # give the single HDMI audio device a human-readable name in PulseAudio/PipeWire instead of the raw platform-hdmi0-sound device name

	return 0 # explicit success so the hook-calling machinery doesn't mistake an earlier command's exit status for this hook's own result
}
