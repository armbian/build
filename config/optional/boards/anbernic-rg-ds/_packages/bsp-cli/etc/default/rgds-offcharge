# RK817 ON_SOURCE (reg 0xf5) bit meaning, measured on hardware:
#   0x80 = power button, 0x40 = charger plug-in, 0x02 = reboot
CHARGER_MASK=0x40
# Seconds until the charge screen turns its backlight off (short POWER press
# re-lights it); hold POWER for BOOT_HOLD seconds to boot.
SCREEN_TIMEOUT=10
BOOT_HOLD=2
# DISABLE=1
