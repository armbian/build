[Unit]
Description=RG Rotate: spend the DSP's lost playback start
# Needs a running PipeWire graph to issue the start through; see the script for
# why doing this outside PipeWire does not help.
After=pipewire.service wireplumber.service
Wants=pipewire.service wireplumber.service

[Service]
Type=oneshot
ExecStart=/usr/bin/rotate-audio-prime
# The script bounds itself, but default.target waits for this unit, so do not
# let a wedge anywhere in it hold up the session.
TimeoutStartSec=20

[Install]
WantedBy=default.target
