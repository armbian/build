#!/bin/sh
# Keep the WCN (Marlin3 Lite / SC2355) CP2 out of deep sleep.
#
# NOT ENABLED BY DEFAULT - see below for why. To use it:
#
#   systemctl enable --now rotate-wcn-nosleep.service
#
# What it fixes: after an idle period, the first 1-2 s of outbound traffic is
# lost or delayed (ping: seq 1 gone, seq 2 at 1.2-2.2 s RTT, then normal).
# With CP2 sleep disabled that hole is gone.
#
# What it does NOT fix, despite looking identical from another machine: the
# board becoming unreachable from the LAN a few minutes after going idle.
# That was the firmware never being told the interface's IPv4 address, so it
# delivered no broadcast to the host at all and a peer's ARP request was never
# answered. It is fixed in the kernel, in
# general-sc23xx-wlan-notify-the-firmware-of-the-ipv4-address.patch, and this
# service is not what makes inbound traffic work.
#
# What it costs: CP2 stays clocked while idle. Measured on hardware with the
# backlight off, associated and silent, three runs of two minutes per state,
# interleaved 1/0/1 so baseline drift cancels - about 10 mA on top of a
# ~114 mA idle draw. On this board's 1900 mAh battery that is standby down
# from 16.6 h to 15.3 h, roughly 8%, to remove a 1-2 s delay. Hence off by
# default.
#
# The knob is the sprdwcn sysfs attribute below, which sends "at+debug=1"
# to the CP2 firmware. CP2 has to be powered for that (it is: the BT core
# holds it up from boot), and the setting does not survive a CP2 reboot, so
# this runs at boot, on wlan0 (re)appearing, and after system resume.
#
# The wake-path bug this papers over is in the vendor sleep manager / sdiohal
# pub_int handshake; this is the workaround until that is understood.
set -u
KNOB=/sys/class/misc/wcn/devices/sleep_state

i=0
while [ ! -w "$KNOB" ]; do
	i=$((i + 1))
	if [ "$i" -gt 60 ]; then
		echo "rotate-wcn-nosleep: $KNOB never appeared" >&2
		exit 1
	fi
	sleep 1
done

if echo 1 > "$KNOB"; then
	echo "rotate-wcn-nosleep: CP2 sleep disabled"
else
	echo "rotate-wcn-nosleep: write to $KNOB failed" >&2
	exit 1
fi
