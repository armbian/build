# Re-apply the CP2 no-sleep setting whenever wlan0 (re)appears: a WCN power cycle
# (rfkill, driver reload) reboots CP2 and loses "at+debug=1". try-restart, not
# restart, because the unit ships disabled - this must not turn it on for someone
# who never asked for it.
SUBSYSTEM=="net", ACTION=="add", KERNEL=="wlan0", RUN+="/bin/systemctl --no-block try-restart rotate-wcn-nosleep.service"
