# Apply the routing when the card appears.
#
# rotate-audio.service is also wanted by multi-user.target, but the card is not
# necessarily there yet at that point: registration waits on the AGDSP coming up
# and on deferred probe. The unit's ConditionPathExists then skips it - a failed
# condition is never retried - and the routing is never applied at all.
#
# RUN, not ENV{SYSTEMD_WANTS}: systemd only acts on SYSTEMD_WANTS for devices it
# has tagged, and its 78-sound-card.rules tags card* on change, not controlC* on
# add. rotate-audio-setup is mixer writes only - a few hundred amixer calls that
# return immediately - so running it here does not hold the udev worker for long.
SUBSYSTEM=="sound", ACTION=="add", KERNEL=="controlC0", RUN+="/usr/bin/rotate-audio-setup"
