[Unit]
Description=RG Rotate speaker routing and DSP prime
# alsa-restore replays the controls alsactl can read; this runs after it
# and sets the ones it cannot.
After=alsa-restore.service sound.target
Wants=sound.target
# Skipped, not failed, when the card is not there. That is on purpose:
# 80-rotate-audio.rules pulls this unit in again from the card's own uevent, so
# a card that registers after multi-user.target is reached is still covered.
ConditionPathExists=/dev/snd/controlC0

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/rotate-audio-setup

[Install]
WantedBy=multi-user.target
