[Unit]
Description=RG Rotate: keep the Wi-Fi/BT CP2 out of deep sleep
# The knob is on the sprdwcn misc device, which exists from early boot; the
# script itself waits for the attribute and for CP2 to be up.
After=NetworkManager.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/rotate-wcn-nosleep

[Install]
WantedBy=multi-user.target
