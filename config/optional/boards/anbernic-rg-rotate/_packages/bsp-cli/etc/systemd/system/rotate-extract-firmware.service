[Unit]
Description=RG Rotate: take the sprd firmware off the eMMC
Documentation=file:///boot/README.flash-bootloader-first.txt
# Before the WCN core is asked for it. The driver retries on the next
# start_marlin() anyway, so losing the race only costs the first attempt.
Before=network-pre.target bluetooth.target
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/rotate-extract-firmware

[Install]
WantedBy=multi-user.target
