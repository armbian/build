label Armbian-unofficial
  kernel /Image
  initrd /uInitrd
  fdt /dtb/amlogic/meson-gxm-c400-plus.dtb


  append root=UUID=<root partition uuid> rootflags=data=writeback console=ttyAML0,115200n8 console=tty0 rw no_console_suspend consoleblank=0 fsck.fix=yes fsck.repair=yes net.ifnames=0 splash plymouth.ignore-serial-cons