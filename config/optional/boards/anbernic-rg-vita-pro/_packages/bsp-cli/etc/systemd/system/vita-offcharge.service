[Unit]
Description=Off-charge mode: battery screen on plug-in boot (RG Vita Pro)
DefaultDependencies=no
After=local-fs.target systemd-udevd.service
# logind acts on the power key itself (HandlePowerKey=poweroff), so keep it
# from starting until the charge screen has handed over
Before=systemd-logind.service display-manager.service getty@tty1.service graphical.target multi-user.target

[Service]
Type=oneshot
ExecStart=/usr/bin/vita-offcharge
TimeoutStartSec=infinity

[Install]
WantedBy=multi-user.target
