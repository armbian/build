CONFIG_CORESIGHT_SINK_TPIU=m
CONFIG_CORESIGHT_SINK_ETBV10=m
CONFIG_CORESIGHT_STM=m
CONFIG_CORESIGHT_CPU_DEBUG=m
CONFIG_CORESIGHT_CTI=m
CONFIG_MEMTEST=y

# Suspend diagnostics: no UART on this board, so pm_test / pm_print_times and the
# wakeup_sources accounting are how a suspend blocker gets found in the field.
CONFIG_PM_DEBUG=y
CONFIG_PM_SLEEP_DEBUG=y

# The vendor defconfig picks no cpuidle governor, so CPU_IDLE auto-selects menu.
CONFIG_CPU_IDLE_GOV_TEO=y

# USB HID gadget, next to the serial/NCM/mass-storage functions already built.
CONFIG_USB_CONFIGFS_F_HID=y

# External controllers over Bluetooth and OTG host, plus USB-C audio dongles.
CONFIG_INPUT_JOYSTICK=y
CONFIG_JOYSTICK_XPAD=m
CONFIG_HID_SONY=m
CONFIG_HID_PLAYSTATION=m
CONFIG_HID_NINTENDO=m
CONFIG_SND_USB_AUDIO=m

# The vendor defconfig only builds the NEON bit-sliced AES, so dm-crypt and
# fscrypt fall back to the slow path and burn battery.
CONFIG_CRYPTO_AES_ARM64_CE_BLK=y

# Without FIB_RULES "ip rule add" fails with EOPNOTSUPP, which kills wg-quick,
# NetworkManager's VPN plugins and Tailscale even though the tunnels are there.
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_WIREGUARD=m

# The vendor defconfig leaves the default qdisc at pfifo_fast, and sc23xx is a
# fullmac driver that gets no mac80211 per-station fq_codel either.
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_SCH_CAKE=m
# NET_SCH_DEFAULT gates the "Default queuing discipline" choice; without it the
# choice is unreachable and the default stays pfifo_fast whatever else is set.
CONFIG_NET_SCH_DEFAULT=y
CONFIG_DEFAULT_FQ_CODEL=y

# USB tethering; Android still offers RNDIS on many devices.
CONFIG_USB_NET_RNDIS_HOST=m

CONFIG_SYN_COOKIES=y
# TCP_CONG_ADVANCED gates every optional congestion control; without it only
# cubic and reno exist and TCP_CONG_BBR is silently dropped.
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=m
