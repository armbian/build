# The on-board ethernet is a USB NIC (RTL8153) described in the device tree
# with an ethernet0 alias, so udev offers the stable onboard name end0. Debian's
# 73-usb-net-by-mac.link would otherwise force the MAC-based enx<MAC> name on
# every USB NIC; take precedence only for NICs that have an onboard name.
[Match]
Path=*-usb-*
Property=ID_NET_NAME_ONBOARD=*

[Link]
NamePolicy=keep kernel database onboard slot path mac
AlternativeNamesPolicy=database onboard slot path mac
MACAddressPolicy=persistent
