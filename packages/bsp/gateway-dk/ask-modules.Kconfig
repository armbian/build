# NXP ASK module menu — parent Kconfig for Armbian's IN-TREE module build.
#
# Armbian builds the ASK modules in-tree (copied into the kernel tree and built
# with `make modules`, so the SDK source they #include is present); ASK's other
# integrations build them out-of-tree against their full kernel build dir. Armbian owns
# the parent Kconfig here; the per-module Kbuild gates on CONFIG_ASK_CDX.
#
# As of ASK 1.1.0 the data plane is one consolidated cdx/ dir whose Kbuild emits
# both cdx.ko and ask_flowtable.ko from a single CONFIG_ASK_CDX; the former
# separate FCI and auto-bridge modules are gone. The board-specific LED/SFP
# drivers also live under this menu.
menuconfig NXP_ASK
	bool "NXP ASK hardware offloading modules"
	depends on FSL_SDK_DPAA_ETH
	help
	  NXP Application Solutions Kit (ASK) kernel modules for
	  data-plane acceleration on LS1046A and similar DPAA1 SoCs.

if NXP_ASK

config ASK_CDX
	tristate "CDX data-plane acceleration + flowtable adapter"
	depends on FSL_SDK_FMAN
	help
	  Core CDX/FMan hardware-offload backend and the nftables flowtable
	  adapter. Builds cdx.ko (hardware backend) and ask_flowtable.ko
	  (Linux flowtable offload adapter) from the ASK repo's cdx/ dir.

config ASK_SFP_LED
	tristate "SFP port LED driver (Mono Gateway DK)"
	depends on LEDS_CLASS && I2C
	help
	  GPIO-based SFP port link/activity LED control for Mono Gateway DK.

config ASK_LEDS_LP5812
	tristate "TI LP5812 LED matrix driver (Mono Gateway DK)"
	depends on LEDS_CLASS && I2C
	help
	  TI LP5812 4x3 LED matrix controller driver.

endif # NXP_ASK
