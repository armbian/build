# Goodix GXTP5100 haptic touchpad, ThinkPad X9-15 Gen 1.
# Without it, every touch counts as a palm.
# Only for libinput 1.23 - 1.30.0 (noble, trixie): newer libinput reads
# INPUT_PROP_PRESSUREPAD from the kernel, older cannot parse this key.
[Goodix Haptic Touchpad (27C6:01EA)]
MatchBus=i2c
MatchVendor=0x27C6
MatchProduct=0x01EA
MatchUdevType=touchpad
ModelPressurePad=1
