#!/bin/sh
# First boot: make the initramfs again for this machine only (MODULES=dep).
# The image ships an initramfs with most drivers, so it boots on any machine.
# Wait for package jobs: a kernel upgrade also runs update-initramfs.
while pgrep -x 'dpkg|apt|apt-get|unattended-upgr' > /dev/null; do
	sleep 10
done
update-initramfs -u -k all && systemctl disable armbian-initramfs-dep.service
