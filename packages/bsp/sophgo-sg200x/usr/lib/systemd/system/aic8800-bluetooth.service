[Unit]
Description=AIC8800 Bluetooth (attach HCI H4 on the Bluetooth UART)
Documentation=man:hciattach(1)
# aic8800_bsp uploads the Bluetooth patch as part of chip init; until it has run
# the UART is silent. modules-load.d brings it in.
After=systemd-modules-load.service
Before=bluetooth.service
Wants=bluetooth.service
# The script exits non-zero on faults that do not heal - no tty behind the
# configured hardware address, or another process holding the port - so cap the
# retries instead of respawning every RestartSec forever. Five tries is enough for
# the one transient case (the uart still probing).
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
# hciattach owns the HCI device for as long as it runs, so the script execs it in
# the foreground and systemd supervises it directly rather than watching a helper
# that forks and exits. A restart only reattaches the H4 ldisc: the firmware went
# in over SDIO at chip init and survives.
Type=simple
Restart=on-failure
RestartSec=2
# Which uart carries the controller is board-specific; the script matches this
# against the hardware address in /sys rather than trusting a ttySN number.
# 41c0000.serial is the SG200x uart4 (Milk-V Duo S).
Environment=AIC8800_BT_UART=41c0000.serial
ExecStart=/usr/bin/aic8800-bluetooth

[Install]
WantedBy=multi-user.target
