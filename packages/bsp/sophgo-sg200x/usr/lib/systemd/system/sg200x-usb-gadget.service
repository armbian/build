[Unit]
Description=Sophgo SG200x USB CDC-NCM gadget
Documentation=file:/usr/sbin/sg200x-usb-gadget

# configfs is where a gadget is described, and systemd mounts it on demand.
After=sys-kernel-config.mount
Requires=sys-kernel-config.mount

# Deliberately not ordered against the network stack. The gadget's interface is
# a hotplugged one either way - the computer at the other end of the cable has
# to enumerate it first - and both networkd and NetworkManager pick it up
# whenever it turns up. Ordering before network-pre.target would only buy an
# ordering cycle with sysinit.
[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/sg200x-usb-gadget start
ExecStop=/usr/sbin/sg200x-usb-gadget stop

[Install]
WantedBy=multi-user.target
