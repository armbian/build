# The NetworkManager half of the CDC-NCM gadget's addressing; the systemd-networkd
# half is /etc/systemd/network/70-sg200x-usb0.network. Which of the two is live
# depends on NETWORKING_STACK, and each stack ignores the other's files, so both
# are installed unconditionally.
#
# This file has to be mode 0600 and owned by root or NetworkManager refuses to
# read it at all.
#
# ipv4.method=shared is the only way NetworkManager will hand the computer at the
# other end of the cable an address, and it does rather more than the networkd
# side does: it runs a dnsmasq for DHCP and DNS, turns on IPv4 forwarding, and
# masquerades onto whatever uplink the board has. That is the behaviour the name
# promises, and it is useful - a machine plugged into the board gets internet
# through it - but it is a real difference from the networkd file, which only
# leases an address. Change this to "manual" to have neither.
#
# The address is 192.168.42.1, as on the Milk-V and queenkjuul images, so that
# "ssh root@192.168.42.1" means the same thing here. The computer's own address
# comes from dnsmasq and is not pinned the way the networkd pool pins it.

[connection]
id=sg200x-usb0
uuid=975f8c3d-069e-40f2-b754-b5f37e95a933
type=ethernet
interface-name=usb0
autoconnect=true

[ethernet]

[ipv4]
method=shared
address1=192.168.42.1/24

[ipv6]
method=link-local

[proxy]
