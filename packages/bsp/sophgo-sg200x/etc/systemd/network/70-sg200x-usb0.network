# Address the CDC-NCM gadget interface, and hand the computer at the other end
# of the cable an address too - otherwise it has no way to learn one, falls back
# to a 169.254.x link-local address after a timeout, and the board is reachable
# only by someone who already knows to configure it by hand.
#
# Only in effect when NETWORKING_STACK is systemd-networkd, which is what
# BUILD_MINIMAL images get. The NetworkManager equivalent is
# /etc/NetworkManager/system-connections/sg200x-usb0.nmconnection; each stack
# ignores the other's files, so both ship and whichever one is running wins.
#
# 192.168.42.1 is the address the Milk-V and queenkjuul images use, so anything
# written about those - including "ssh root@192.168.42.1" - holds here too.

[Match]
# usb0 is the name u_ether gives the interface and the name it keeps: udev's
# net_id builtin produces no ID_NET_NAME_* for a device hanging off a bare
# devicetree platform node, so none of systemd's renaming policies has anything
# to rename it to. The same reasoning is in /lib/udev/sg200x-stable-mac, for the
# same reason, about the ethernet.
Name=usb0

[Network]
Address=192.168.42.1/24
DHCPServer=yes

# So that ssh over fe80::...%usb0 works even before the lease arrives.
LinkLocalAddressing=ipv6

[DHCPServer]
# One address, always the same one: .137. A single-lease pool means the computer
# gets the same address every time it is plugged in, which is what makes it worth
# writing down.
PoolOffset=136
PoolSize=1

# The board is not a router and does not pretend to be one. Emitting either of
# these would point the computer's default route and DNS at a board that has no
# forwarding turned on, and break its existing internet connection to do it.
# Turn both on, and add IPMasquerade=ipv4 above, to share the board's connection.
EmitRouter=no
EmitDNS=no
