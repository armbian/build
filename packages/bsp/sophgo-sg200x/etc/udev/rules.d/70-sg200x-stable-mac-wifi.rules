# The AIC8800D80 on the Milk-V Duo S has nothing in its own efuse, so
# aic8800_fdrv falls back to a compiled-in 88:00:33:77 with two random bytes on
# the end, once per module load. Pin it; see /lib/udev/sg200x-stable-mac.
#
# The match is deliberately loose - any wlan* - with the precision in the third
# argument instead: the helper only touches an interface whose address is
# currently the driver's own default. That way a wifi device that does have a real
# MAC address is left alone without this rule having to know how to recognise one,
# and an AIC8800 that turns out to have a programmed efuse keeps its own address.
ACTION=="add", SUBSYSTEM=="net", KERNEL=="wlan*", \
	RUN+="sg200x-stable-mac %k wifi 88:00:33:77"
