# The SG200x DWMAC has no MAC address anywhere - not in the device tree, not in
# its own address filter - so the kernel invents a random one on every boot. Give
# it one derived from the chip's serial number instead; see
# /lib/udev/sg200x-stable-mac for the why and the how.
#
# Matched on the hardware address rather than the interface name, because which
# ethN it lands on is not ours to rely on. RUN+= resolves relative names against
# /lib/udev, as packages/bsp/rockpis does for the same job.
ACTION=="add", SUBSYSTEM=="net", DEVPATH=="*/4070000.ethernet/net/*", \
	RUN+="sg200x-stable-mac %k ethernet"
