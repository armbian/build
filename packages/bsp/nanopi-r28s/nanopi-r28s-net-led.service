[Unit]
Description=Enable network activity LEDs on NanoPi R28S
After=network-pre.target
Wants=network-pre.target

[Service]
Type=oneshot
ExecStart=bash -c 'echo netdev > /sys/class/leds/led1/trigger'
ExecStart=bash -c 'echo end0 > /sys/class/leds/led1/device_name'
ExecStart=bash -c 'echo 1 > /sys/class/leds/led1/link'
ExecStart=bash -c 'echo 1 > /sys/class/leds/led1/rx'
ExecStart=bash -c 'echo 1 > /sys/class/leds/led1/tx'
ExecStart=bash -c 'echo netdev > /sys/class/leds/led2/trigger'
ExecStart=bash -c 'echo end1 > /sys/class/leds/led2/device_name'
ExecStart=bash -c 'echo 1 > /sys/class/leds/led2/link'
ExecStart=bash -c 'echo 1 > /sys/class/leds/led2/rx'
ExecStart=bash -c 'echo 1 > /sys/class/leds/led2/tx'

[Install]
WantedBy=multi-user.target
