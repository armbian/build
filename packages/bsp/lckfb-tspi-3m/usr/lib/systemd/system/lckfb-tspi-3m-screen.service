[Unit]
Description=Detect the LCKFB TaishanPi 3M MIPI screen and enable its overlay
DefaultDependencies=no
After=local-fs.target systemd-modules-load.service
Before=display-manager.service getty@tty1.service armbian-firstlogin.service
ConditionPathExists=/boot/armbianEnv.txt

[Service]
Type=oneshot
ExecStart=/usr/libexec/lckfb-tspi-3m-screen

[Install]
WantedBy=sysinit.target
