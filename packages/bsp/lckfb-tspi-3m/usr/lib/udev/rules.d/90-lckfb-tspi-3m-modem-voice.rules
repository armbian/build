# Quectel EC20/EC25 (2c7c:0125): phone call audio over USB audio.
# Interface 02 is the AT port ModemManager uses; prepare the module on it
# before ModemManager starts. Interface 03 is a second AT port: keep
# ModemManager off it and use it to select the voice path once registered.
ACTION=="add", SUBSYSTEM=="tty", ENV{ID_VENDOR_ID}=="2c7c", ENV{ID_MODEL_ID}=="0125", ENV{ID_USB_INTERFACE_NUM}=="02", RUN+="/usr/libexec/lckfb-tspi-3m-modem-voice early /dev/%k"
SUBSYSTEM=="tty", ENV{ID_VENDOR_ID}=="2c7c", ENV{ID_MODEL_ID}=="0125", ENV{ID_USB_INTERFACE_NUM}=="03", ENV{ID_MM_PORT_IGNORE}="1", TAG+="systemd", ENV{SYSTEMD_WANTS}+="lckfb-tspi-3m-modem-voice@%k.service"
