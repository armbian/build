#!/bin/sh
# Restore the console log level from the kernel command line.
# procps sets kernel.printk = 4 4 1 7 and overrides loglevel=.
# Then loglevel=3 (quiet desktop boot) still shows error messages.
level=
set -f # cmdline words like i915.force_probe=* must not glob
# shellcheck disable=SC2013 # split into words, not lines
for arg in $(cat /proc/cmdline); do
	case "$arg" in
		loglevel=[0-9] | loglevel=1[0-5]) level="${arg#loglevel=}" ;;
	esac
done
[ -n "$level" ] || exit 0
# One number sets only the console log level.
echo "$level" > /proc/sys/kernel/printk
