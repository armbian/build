# Console autologin helper for serial-getty@.service.
#
# USB gadget serial ports have no reader until a host opens the ACM device;
# wait for CR before autologin emits anything, so first-login output is not
# buffered and replayed as garbage on the first connection. A preset-driven
# first login has nobody at the console and must stay unattended.

port=${1:?"missing tty"}
term=${2:-linux}
marker=/root/.not_logged_in_yet

set -- --noissue --autologin root "$port" "$term"

case "$port" in
ttyGS*)
	# Same test as armbian-firstlogin: source the file, empty values are no preset
	# shellcheck disable=SC1090
	if ! (. "$marker" && [ -n "${PRESET_ROOT_PASSWORD}${PRESET_USER_NAME}${PRESET_CONFIGURATION}" ]) 2>/dev/null; then
		set -- -w "$@"
	fi
	;;
esac

exec /sbin/agetty "$@"
