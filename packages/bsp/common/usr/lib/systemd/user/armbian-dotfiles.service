# Commit the changes of ~/.armbian-dotfiles at logout or shutdown, and push them
# when the account allows it (armbian-dotfiles auth). A push that fails waits
# for the next login.
[Unit]
Description=Armbian: keep armbian-dotfiles up to date
ConditionPathIsDirectory=%h/.armbian-dotfiles/.git

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/armbian-dotfiles sync
ExecStop=/usr/bin/armbian-dotfiles sync
TimeoutStartSec=60
TimeoutStopSec=45

[Install]
WantedBy=default.target
