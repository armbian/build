# Armbian LUKS re-key service
# Gives an autounlock image its own LUKS keyfile and volume key.
# armbian-config starts and enables it. Enabled, a reboot continues the job.
# The resize waits while this runs, and this unit starts it when done.
# Type=exec: the boot does not wait for the re-encryption, which can take
# hours. The unit is active only while the script runs. It disables itself
# when done.

[Unit]
Description=Armbian LUKS re-key of the root
DefaultDependencies=no
After=local-fs.target
Before=armbian-resize-filesystem.service shutdown.target
Conflicts=shutdown.target
ConditionPathExists=/etc/rootfs.key

[Service]
Type=exec
# The resize waits while this file exists.
ExecStartPre=/bin/touch /run/armbian-luks-rekey.running
ExecStart=/usr/lib/armbian/armbian-luks-rekey start
# Also after a failure or a stop. Then start the resize, not at shutdown.
# restart, not start: a start can merge into a resize job that is still
# running, and that job skips while the file exists.
ExecStopPost=/bin/rm -f /run/armbian-luks-rekey.running
ExecStopPost=-/bin/sh -c '[ "$(systemctl is-system-running)" = stopping ] || ! systemctl -q is-enabled armbian-resize-filesystem || systemctl restart --no-block armbian-resize-filesystem'

[Install]
WantedBy=multi-user.target
