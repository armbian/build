# Armbian LUKS re-key service
# Gives an autounlock image its own LUKS keyfile and volume key on first boot.
# Runs before the root partition grows, so it re-encrypts less data.
# It does not hold up the rest of the boot. It disables itself when done.

[Unit]
Description=Armbian LUKS re-key of the root
DefaultDependencies=no
After=local-fs.target
Before=armbian-resize-filesystem.service shutdown.target
Conflicts=shutdown.target
ConditionPathExists=/etc/rootfs.key

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/armbian/armbian-luks-rekey start
TimeoutStartSec=infinity

[Install]
WantedBy=multi-user.target
