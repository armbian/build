# Restore the console log level from loglevel= after systemd-sysctl.

[Unit]
Description=Armbian console log level from kernel command line
DefaultDependencies=no
After=systemd-sysctl.service
Before=sysinit.target shutdown.target
Conflicts=shutdown.target
ConditionKernelCommandLine=loglevel

[Service]
Type=oneshot
RemainAfterExit=true
ExecStart=/usr/lib/armbian/armbian-console-loglevel

[Install]
WantedBy=sysinit.target
