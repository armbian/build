[Unit]
Description=Orange Pi 5 Max Bluetooth (AP6611S on UART7)
After=systemd-modules-load.service systemd-rfkill.service
Before=bluetooth.service
ConditionPathExists=/sys/firmware/devicetree/base/serial@feba0000/bluetooth

[Service]
Type=oneshot
ExecStart=/usr/libexec/orangepi5max-bluetooth-init
RemainAfterExit=yes
TimeoutStartSec=35

[Install]
WantedBy=multi-user.target
