#!/bin/sh

# MODE: 0 - application, 1 - bootloader
# RESET: 1 - held in reset
echo "${0}: Set UXM modules to application mode, reset them ..."
if gpioset --toggle 0 UXM1_MODE=0 UXM2_MODE=0 UXM3_MODE=0 UXM4_MODE=0; then
    gpioset --toggle 500ms,0 UXM1_RESET=1 UXM2_RESET=1 UXM3_RESET=1 UXM4_RESET=1 ||
        echo "${0}: *** Error: UXM reset pulse failed"
else
    echo "${0}: *** Error: Failed to set UXM modules to application mode, reset skipped"
fi

echo "${0}: Initialization done"
