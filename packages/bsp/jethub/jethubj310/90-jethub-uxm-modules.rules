# Naming for JetHome UXM modules on J310.

ACTION=="remove", GOTO="jethub_uxm_end"

SUBSYSTEM=="usb", ATTR{idVendor}=="10c4", ATTR{idProduct}=="ea60", \
	ATTR{manufacturer}=="*JetHome*", ENV{ID_MM_DEVICE_IGNORE}="1"

SUBSYSTEM!="tty", GOTO="jethub_uxm_end"
KERNEL!="ttyUSB[0-9]*", GOTO="jethub_uxm_end"

ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", ATTRS{manufacturer}=="JetHome", \
	ENV{JETHUB_UXM}="1"
ENV{JETHUB_UXM}!="1", GOTO="jethub_uxm_end"

ENV{ID_MM_PORT_IGNORE}="1"
GROUP="dialout", MODE="0660"

# Slot number from the USB topology
IMPORT{builtin}="path_id"
ENV{ID_PATH}=="", GOTO="jethub_uxm_end"

ENV{ID_PATH}=="*-usb-0:1.1.1:1.0", ENV{JETHUB_UXM_SLOT}="1"
ENV{ID_PATH}=="*-usb-0:1.1.2:1.0", ENV{JETHUB_UXM_SLOT}="2"
ENV{ID_PATH}=="*-usb-0:1.1.3:1.0", ENV{JETHUB_UXM_SLOT}="3"
ENV{ID_PATH}=="*-usb-0:1.1.4:1.0", ENV{JETHUB_UXM_SLOT}="4"
ENV{JETHUB_UXM_SLOT}=="", GOTO="jethub_uxm_end"

# Module type from the product string
ATTRS{product}=="JetHome Zigbee*", ENV{JETHUB_MODULE}="ttyZigbee"
ATTRS{product}=="JetHome RS-485*", ENV{JETHUB_MODULE}="ttyRS485"

ENV{JETHUB_MODULE}!="", SYMLINK+="jethub/slot$env{JETHUB_UXM_SLOT}/$env{JETHUB_MODULE}"

LABEL="jethub_uxm_end"
