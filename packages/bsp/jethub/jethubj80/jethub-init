#!/bin/sh

echo "${0}: Configure LEDs ..."
# The DT does not name the LED line
gpioset --toggle 0 -c gpiochip1 73=0 ||
    echo "${0}: *** Error: Failed to configure LEDs"

# BOOT (GPIOAO_9): 1 - application, 0 - bootloader
echo "${0}: Set Zigbee module to application mode ..."
gpioset --toggle 0 -c gpiochip0 9=1 ||
    echo "${0}: *** Error: Failed to set Zigbee module to application mode"

echo "${0}: Configure Ethernet leds ..."
/usr/sbin/jethub_set-eth_leds || echo "${0}: *** Error: jethub_set-eth_leds failed"

echo "${0}: Initialization done"
