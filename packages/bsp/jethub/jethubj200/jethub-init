#!/bin/sh

modprobe gpio-pca953x || echo "${0}: *** Error: Failed to load gpio-pca953x kernel module"

# BOOT: 1 - application, 0 - bootloader
echo "${0}: Set UXM modules to application mode, reset them ..."
if gpioset --toggle 0 UXM1_BOOT=1 UXM2_BOOT=1; then
    gpioset --toggle 500ms,0 UXM1_RESET=1 UXM2_RESET=1 ||
        echo "${0}: *** Error: UXM reset pulse failed"
else
    echo "${0}: *** Error: Failed to set UXM modules to application mode, reset skipped"
fi

echo "${0}: Configure 1-Wire ..."
modprobe ds2482 || echo "${0}: *** Error: Failed to load DS2482 kernel module"

echo "${0}: Initialization done"
