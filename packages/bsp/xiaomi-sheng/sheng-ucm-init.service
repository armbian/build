[Unit]
Description=Xiaomi Pad 6S Pro ALSA UCM initialization
DefaultDependencies=no
After=local-fs.target
Before=systemd-user-sessions.service pipewire.service wireplumber.service
Wants=sound.target
After=sound.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/sheng-ucm-init.sh
RemainAfterExit=yes

[Install]
WantedBy=sysinit.target