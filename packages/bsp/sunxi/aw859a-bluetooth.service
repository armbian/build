[Unit]
Description=Bluetooth AW859A
# The BT core shares the WCN firmware with WLAN: bring WLAN up first so the
# firmware is already running (and sunxi_addr is loaded) when we attach.
Requires=aw859a-wifi.service
After=aw859a-wifi.service bluetooth.service
# Let Restart= retry for a while on slow boots (firmware not ready yet).
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
ExecStartPre=/sbin/modprobe sunxi_addr
ExecStartPre=/sbin/modprobe sprdbt_tty
# /dev/ttyBT0 is created by sprdbt_tty via udev; give it a moment to appear.
ExecStartPre=/usr/bin/timeout 30 /bin/sh -c 'until [ -c /dev/ttyBT0 ]; do sleep 1; done'
ExecStartPre=/usr/sbin/rfkill unblock all
# -n: stay in the foreground so systemd supervises the process and can
# restart it when the HCI init fails (e.g. firmware not booted yet) or
# when the controller goes away.
ExecStart=/usr/bin/hciattach_opi -n -s 1500000 /dev/ttyBT0 sprd
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
