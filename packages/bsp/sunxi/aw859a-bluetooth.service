[Unit]
Description=Bluetooth AW859A
# The BT core shares the WCN firmware with WLAN: bring WLAN up first so the
# firmware is already running (and sunxi_addr is loaded) when we attach.
Requires=aw859a-wifi.service
After=aw859a-wifi.service bluetooth.service
# Let Restart= retry for a while on slow boots (firmware not ready yet).
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
ExecStartPre=/sbin/modprobe sunxi_addr
ExecStartPre=/sbin/modprobe sprdbt_tty
# /dev/ttyBT0 is created by sprdbt_tty via udev; give it a moment to appear.
ExecStartPre=/usr/bin/timeout 30 /bin/sh -c 'until [ -c /dev/ttyBT0 ]; do sleep 1; done'
# aw859a-bt-attach: rfkill unblock (powers the core; with sprdbt_tty
# vendor_init=1, the default, the driver also sends PSKEY/RF/enable and leaves
# the switch blocked on failure, which the helper turns into exit 1 so we
# retry), then btattach (stock BlueZ) or, with vendor_init=0, hciattach_opi -n.
# Either stays in the foreground so systemd supervises it and restarts it
# when the HCI init fails or the controller goes away.
ExecStart=/usr/sbin/aw859a-bt-attach
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
