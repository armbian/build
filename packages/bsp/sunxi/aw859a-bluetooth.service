[Unit]
Description=Bluetooth AW859A
# Bluetooth shares the WCN firmware with WLAN. Start it after WLAN.
Requires=aw859a-wifi.service
After=aw859a-wifi.service bluetooth.service
# Retry while the firmware boots.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
ExecStartPre=/sbin/modprobe sunxi_addr
ExecStartPre=/sbin/modprobe sprdbt_tty
ExecStartPre=/usr/bin/timeout 30 /bin/sh -c 'until [ -c /dev/ttyBT0 ]; do sleep 1; done'
ExecStart=/usr/sbin/aw859a-bt-attach
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
