[Unit]
Description=WIFI AW859A
# Loads the Unisoc UWE5622 (AW859A) WLAN driver. The module pulls in
# uwe5622_bsp_sdio (WCN core, firmware download) and sunxi_addr (MAC address).

[Service]
# modprobe is not a forking daemon: it returns once the module is loaded.
# oneshot + RemainAfterExit keeps the unit "active" so that others can order
# on it (aw859a-bluetooth.service does).
Type=oneshot
RemainAfterExit=yes
ExecStart=/sbin/modprobe sprdwl_ng
# The firmware download runs inside modprobe and cannot be interrupted.
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
