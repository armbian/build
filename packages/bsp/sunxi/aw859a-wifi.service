[Unit]
Description=WIFI AW859A

[Service]
# modprobe does not fork. RemainAfterExit lets aw859a-bluetooth.service order after this unit.
Type=oneshot
RemainAfterExit=yes
ExecStart=/sbin/modprobe sprdwl_ng
# The firmware download runs inside modprobe.
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
