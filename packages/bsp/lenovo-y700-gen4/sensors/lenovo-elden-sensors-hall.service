[Unit]
ConditionPathExists=/usr/share/lenovo-elden-sensors/bin/ssc-input
Description=Lenovo Elden Hall sensor
Requires=lenovo-elden-sensors-rpc.service
PartOf=lenovo-elden-sensors-rpc.service
After=lenovo-elden-sensors-rpc.service
After=systemd-logind.service
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/bin/systemd-inhibit --what=handle-lid-switch --mode=block --who="Lenovo Y700 Gen4 sensors" --why="Lid policy is not enabled" /usr/share/lenovo-elden-sensors/bin/ssc-input hall
Environment=LD_LIBRARY_PATH=/usr/share/lenovo-elden-sensors/lib
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
