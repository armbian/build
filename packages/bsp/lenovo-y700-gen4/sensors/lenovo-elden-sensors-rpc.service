[Unit]
ConditionPathExists=/usr/share/lenovo-elden-sensors/bin/hexagonrpcd
Description=Lenovo Elden sensor DSP file service
BindsTo=dev-fastrpc\x2dadsp\x2dsecure.device
After=dev-fastrpc\x2dadsp\x2dsecure.device
Requires=lenovo-elden-sensors-init.service
After=lenovo-elden-sensors-init.service
Before=iio-sensor-proxy.service
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=exec
Environment=LD_LIBRARY_PATH=/usr/share/lenovo-elden-sensors/lib
ExecStart=/usr/share/lenovo-elden-sensors/bin/hexagonrpcd -f /dev/fastrpc-adsp-secure -d adsp -s -R /var/lib/hexagonrpc
Restart=always
RestartSec=3
UMask=0077

[Install]
WantedBy=multi-user.target
