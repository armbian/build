# A single bridge owns acceleration and gyro. The proxy reads its input device.
ACTION=="add|change", SUBSYSTEM=="misc", KERNEL=="fastrpc-adsp-secure", ENV{IIO_SENSOR_PROXY_TYPE}="ssc-light ssc-proximity ssc-compass", TAG+="systemd", ENV{SYSTEMD_WANTS}+="iio-sensor-proxy.service lenovo-elden-sensors-motion.service lenovo-elden-sensors-hall.service"
ACTION=="add|change", SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="Lenovo Y700 Gen4 Motion", ENV{IIO_SENSOR_PROXY_TYPE}="input-accel", ENV{ACCEL_MOUNT_MATRIX}="-1, 0, 0; 0, -1, 0; 0, 0, 1", SYMLINK+="input/lenovo-y700-gen4-motion", TAG+="systemd", ENV{SYSTEMD_WANTS}+="iio-sensor-proxy.service"
# Expose lid events without enabling desktop or logind lid actions.
ACTION=="add|change", SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="Lenovo Y700 Gen4 Hall", ENV{LIBINPUT_IGNORE_DEVICE}="1", TAG-="power-switch", SYMLINK+="input/lenovo-y700-gen4-hall"
