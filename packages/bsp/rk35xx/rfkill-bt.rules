# Rockchip's rfkill-bt registers the radio soft-blocked (BT_BLOCKED is hardcoded
# true), which is Android's model. On a Linux image that leaves bluetoothctl
# looking at a dead adapter until something unblocks it.
# Only on add: a change event is the user blocking the radio, and clearing that
# would make bluetooth impossible to turn off.
SUBSYSTEM=="rfkill", ACTION=="add", ATTR{type}=="bluetooth", ATTR{soft}="0"
