[Unit]
Description=Quiesce Torder R10D Bluetooth during system sleep
Before=sleep.target
StopWhenUnneeded=yes

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/torder-r10d-bluetooth-sleep pre
ExecStop=/usr/bin/torder-r10d-bluetooth-sleep post
TimeoutStartSec=20
TimeoutStopSec=20

[Install]
WantedBy=sleep.target
