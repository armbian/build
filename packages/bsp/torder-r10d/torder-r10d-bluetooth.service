[Unit]
Description=Torder R10D Bluetooth
After=systemd-modules-load.service
Before=bluetooth.service
ConditionPathExists=/proc/device-tree/uwe-bsp

[Service]
Type=simple
PrivateMounts=yes
BindReadOnlyPaths=/lib/firmware/uwe5621ds/bt_configure_rf_marlin3e_3.ini:/lib/firmware/bt_configure_rf.ini
BindReadOnlyPaths=/lib/firmware/uwe5621ds/bt_configure_pskey.ini:/lib/firmware/bt_configure_pskey.ini
ExecStart=/usr/bin/torder-r10d-bluetooth
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
