[Unit]
Description=AIC8800 Bluetooth (attach HCI H4 on the Bluetooth UART)
Documentation=man:hciattach(1)
# aic8800_bsp uploads the Bluetooth patch as part of chip init; until it has run
# the UART is silent. modules-load.d brings it in.
After=systemd-modules-load.service
Before=bluetooth.service
Wants=bluetooth.service

[Service]
Type=oneshot
RemainAfterExit=yes
# Which uart carries the controller is board-specific; the script matches this
# against the hardware address in /sys rather than trusting a ttySN number.
# 41c0000.serial is the SG200x uart4 (Milk-V Duo S).
Environment=AIC8800_BT_UART=41c0000.serial
ExecStart=/usr/bin/aic8800-bluetooth

[Install]
WantedBy=multi-user.target
