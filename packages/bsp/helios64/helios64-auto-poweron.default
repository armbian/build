# Helios64 auto power-on: whether the board powers itself up when mains
# returns. U-Boot arms it at every boot; disable_auto_poweron in
# /lib/systemd/system-shutdown/ arms or disarms it as AUTO_POWERON says:
#
#   on-power-loss  power up when mains returns, unless the board was shut
#                  down while on mains (default)
#   always         power up whenever mains returns, even after poweroff
#   never          never power up by itself; needs helios64-auto-poweron.service
#                  enabled (`systemctl enable helios64-auto-poweron`)
#
# A change takes effect at the next shutdown; never also at the next boot.
AUTO_POWERON=on-power-loss
