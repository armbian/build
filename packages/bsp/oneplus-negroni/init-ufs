#!/negroni/busybox sh
set -eu

# The vendor ramdisk leaves a populated /lib directory. Linux cannot
# replace it with the merged-/usr symlink from Debian's ramdisk.
if [ -d /lib ] && [ ! -L /lib ]; then
	/negroni/busybox mv /lib /negroni/vendor-lib
	/negroni/busybox ln -s usr/lib /lib
fi

exec /negroni/initramfs-init "$@"
