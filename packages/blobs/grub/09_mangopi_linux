#!/bin/sh
set -eu
set -f
. /etc/armbian-grub-with-dtb
config=$(mktemp)
trap 'rm -f "$config"' EXIT HUP INT TERM
sh /etc/grub.d/10_linux > "$config"
while IFS= read -r line; do
    printf '%s\n' "$line"
    set -- $line
    [ "${1:-}" = linux ] || continue
    kernel=${2##*/}
    version=${kernel#vmlinuz-}
    version=${version#vmlinux-}
    version=${version%.efi.signed}
    version=${version%.old}
    dtb="/boot/armbian-dtb-${version}"
    if [ ! -f "$dtb" ]; then
        echo "Missing DTB: $dtb" >&2
        exit 1
    fi
    printf '\tdevicetree %s\n' "$dtb"
done < "$config"
